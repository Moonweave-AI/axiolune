{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiolune.ai/schemas/finance/market-data/calculation-run-evidence-v1",
  "title": "Axiolune Market Data CalculationRunEvidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactTypeIri",
    "capabilityIris",
    "calculationRunIri",
    "schemaIri",
    "schemaDigest",
    "version",
    "priceKind",
    "calculationDefinitionRef",
    "calculationDefinitionDigest",
    "outputObservationVersionIri",
    "window",
    "selection",
    "pitSelection",
    "inputObservationVersionIris",
    "calculationInputSetDigest",
    "closureAssertionSetDigest",
    "computedOutput",
    "recalculationPolicy"
  ],
  "properties": {
    "artifactTypeIri": {
      "const": "https://axiolune.ai/ontology/finance/market-data/artifact-types/CalculationRunEvidence"
    },
    "capabilityIris": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "enum": [
          "https://axiolune.ai/ontology/finance/market-data/capabilities/vwap-calculation-run",
          "https://axiolune.ai/ontology/finance/market-data/capabilities/twap-calculation-run"
        ]
      }
    },
    "calculationRunIri": {"type": "string", "format": "uri"},
    "schemaIri": {"const": "https://axiolune.ai/schemas/finance/market-data/calculation-run-evidence-v1"},
    "schemaDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"const": "1.0.0"},
    "priceKind": {"enum": ["vwap", "twap"]},
    "calculationDefinitionRef": {"type": "string", "format": "uri"},
    "calculationDefinitionDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outputObservationVersionIri": {"type": "string", "format": "uri"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startInclusive", "endExclusive"],
      "properties": {
        "startInclusive": {"type": "string", "format": "date-time"},
        "endExclusive": {"type": "string", "format": "date-time"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputType",
        "inputStreamVersionIri",
        "instrumentVersionIri",
        "contextVersionIri",
        "quotationVersionIri",
        "priceKind",
        "revisionSelection",
        "windowPredicate"
      ],
      "properties": {
        "inputType": {"enum": ["TradeObservation", "PriceObservation"]},
        "inputStreamVersionIri": {"type": "string", "format": "uri"},
        "instrumentVersionIri": {"type": "string", "format": "uri"},
        "contextVersionIri": {"type": "string", "format": "uri"},
        "quotationVersionIri": {"type": "string", "format": "uri"},
        "priceKind": {"const": "last"},
        "revisionSelection": {"const": "exact-version-iri"},
        "windowPredicate": {
          "enum": [
            "observedAt-in-half-open-interval",
            "observedAt-step-function-partitions-half-open-window"
          ]
        }
      }
    },
    "pitSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asOfValid", "asOfKnowledge", "asOfAvailable", "referenceTime"],
      "properties": {
        "asOfValid": {"type": "string", "format": "date-time"},
        "asOfKnowledge": {"type": "string", "format": "date-time"},
        "asOfAvailable": {"type": "string", "format": "date-time"},
        "referenceTime": {"type": "string", "format": "date-time"}
      }
    },
    "inputObservationVersionIris": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "calculationInputSetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "closureAssertionSetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "computedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "recalculationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invalidatedBy",
        "outputMutationPolicy",
        "overwriteAllowed",
        "recalculationRequiredWhenInvalidated"
      ],
      "properties": {
        "invalidatedBy": {
          "const": [
            "calculation-definition-digest-change",
            "selected-input-fact-version-set-change",
            "selected-input-fact-payload-change",
            "selection-window-or-condition-change",
            "pit-selection-or-closure-assertion-set-change"
          ]
        },
        "outputMutationPolicy": {"const": "append-new-revision"},
        "overwriteAllowed": {"const": false},
        "recalculationRequiredWhenInvalidated": {"const": true}
      }
    }
  }
}
