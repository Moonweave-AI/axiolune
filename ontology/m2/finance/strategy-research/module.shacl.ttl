@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-strategy: <https://axiolune.ai/ontology/finance/strategy-research/>.

fin-strategy:SignalDirectionShape a sh:PropertyShape;
    sh:path fin-strategy:SignalDirection;
    sh:hasValue fin-strategy:SignalDirection_Long, fin-strategy:SignalDirection_Short, fin-strategy:SignalDirection_Neutral, fin-strategy:SignalDirection_Exit;
    sh:name "Signal Direction".
fin-strategy:FactorCategoryShape a sh:PropertyShape;
    sh:path fin-strategy:FactorCategory;
    sh:hasValue fin-strategy:FactorCategory_Fundamental, fin-strategy:FactorCategory_Technical, fin-strategy:FactorCategory_Alternative, fin-strategy:FactorCategory_Macro, fin-strategy:FactorCategory_Statistical, fin-strategy:FactorCategory_Sentiment;
    sh:name "Factor Category".
fin-strategy:BacktestStatusShape a sh:PropertyShape;
    sh:path fin-strategy:BacktestStatus;
    sh:hasValue fin-strategy:BacktestStatus_Pending, fin-strategy:BacktestStatus_Running, fin-strategy:BacktestStatus_Completed, fin-strategy:BacktestStatus_Failed, fin-strategy:BacktestStatus_Canceled;
    sh:name "Backtest Status".
fin-strategy:FactorDefinitionShape a sh:NodeShape;
    sh:targetClass fin-strategy:FactorDefinition;
    sh:name "Factor Definition";
    sh:description "specification of a quantitative factor including its calculation logic, input requirements, universe scope, and validity conditions".
fin-strategy:StrategyDefinitionShape a sh:NodeShape;
    sh:targetClass fin-strategy:StrategyDefinition;
    sh:name "Strategy Definition";
    sh:description "specification of a trading strategy including its logic, parameters, universe, risk controls, and execution rules".
fin-strategy:SignalShape a sh:NodeShape;
    sh:targetClass fin-strategy:Signal;
    sh:name "Signal";
    sh:description "point-in-time trading signal generated by a factor or strategy for a specific instrument with directional bias, strength, and validity period".
fin-strategy:BacktestRunShape a sh:NodeShape;
    sh:targetClass fin-strategy:BacktestRun;
    sh:name "Backtest Run";
    sh:description "execution of a strategy definition over historical data with specified parameters, date range, initial capital, and resulting performance metrics".
fin-strategy:PerformanceObservationShape a sh:NodeShape;
    sh:targetClass fin-strategy:PerformanceObservation;
    sh:name "Performance Observation";
    sh:description "point-in-time or period-aggregate performance metrics for a backtest run or live strategy including returns, drawdown, Sharpe ratio, and other statistics".
fin-strategy:hasFactorNameShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasFactorName;
    sh:name "has factor name";
    sh:description "human-readable name of the factor".
fin-strategy:hasFactorCategoryShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasFactorCategory;
    sh:name "has factor category";
    sh:description "category classification of the factor (fundamental, technical, etc.)".
fin-strategy:hasFactorFormulaShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasFactorFormula;
    sh:name "has factor formula";
    sh:description "textual or symbolic representation of the factor calculation logic".
fin-strategy:hasStrategyNameShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasStrategyName;
    sh:name "has strategy name";
    sh:description "human-readable name of the strategy".
fin-strategy:hasStrategyDescriptionShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasStrategyDescription;
    sh:name "has strategy description";
    sh:description "textual description of the strategy logic and objectives".
fin-strategy:hasSignalDirectionShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasSignalDirection;
    sh:name "has signal direction";
    sh:description "directional bias of the signal (long, short, neutral, exit)".
fin-strategy:hasSignalStrengthShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasSignalStrength;
    sh:name "has signal strength";
    sh:description "numerical measure of signal confidence or magnitude, typically normalized [-1, 1] or [0, 1]".
fin-strategy:hasBacktestStatusShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasBacktestStatus;
    sh:name "has backtest status";
    sh:description "execution state of the backtest run".
fin-strategy:hasStartDateShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasStartDate;
    sh:name "has start date";
    sh:description "start date of the backtest simulation period".
fin-strategy:hasEndDateShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasEndDate;
    sh:name "has end date";
    sh:description "end date of the backtest simulation period".
fin-strategy:hasInitialCapitalShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasInitialCapital;
    sh:name "has initial capital";
    sh:description "starting capital amount for the backtest run".
fin-strategy:hasCumulativeReturnShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasCumulativeReturn;
    sh:name "has cumulative return";
    sh:description "cumulative return percentage at the observation point".
fin-strategy:hasMaxDrawdownShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasMaxDrawdown;
    sh:name "has max drawdown";
    sh:description "maximum peak-to-trough decline as percentage".
fin-strategy:hasSharpeRatioShape a sh:NodeShape;
    sh:targetClass fin-strategy:hasSharpeRatio;
    sh:name "has Sharpe ratio";
    sh:description "risk-adjusted return metric (mean excess return divided by standard deviation of returns)".
