@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-risk: <https://axiolune.ai/ontology/finance/risk/>.

fin-risk:RiskMeasureTypeShape a sh:PropertyShape;
    sh:path fin-risk:RiskMeasureType;
    sh:hasValue fin-risk:RiskMeasureType_VaR, fin-risk:RiskMeasureType_CVaR, fin-risk:RiskMeasureType_Volatility, fin-risk:RiskMeasureType_Exposure, fin-risk:RiskMeasureType_Concentration, fin-risk:RiskMeasureType_Beta, fin-risk:RiskMeasureType_Greeks;
    sh:name "Risk Measure Type".
fin-risk:LimitBreachSeverityShape a sh:PropertyShape;
    sh:path fin-risk:LimitBreachSeverity;
    sh:hasValue fin-risk:LimitBreachSeverity_Warning, fin-risk:LimitBreachSeverity_Breach, fin-risk:LimitBreachSeverity_Critical;
    sh:name "Limit Breach Severity".
fin-risk:RiskMeasureDefinitionShape a sh:NodeShape;
    sh:targetClass fin-risk:RiskMeasureDefinition;
    sh:name "Risk Measure Definition";
    sh:description "specification of a risk metric including calculation method, parameters, time horizon, and confidence level".
fin-risk:RiskLimitShape a sh:NodeShape;
    sh:targetClass fin-risk:RiskLimit;
    sh:name "Risk Limit";
    sh:description "authorized maximum or threshold for a risk measure applicable to a portfolio, account, or instrument with defined scope and validity".
fin-risk:ExposureObservationShape a sh:NodeShape;
    sh:targetClass fin-risk:ExposureObservation;
    sh:name "Exposure Observation";
    sh:description "point-in-time observation of a risk measure value for a portfolio, account, or instrument with calculation timestamp and contributing factors".
fin-risk:LimitBreachShape a sh:NodeShape;
    sh:targetClass fin-risk:LimitBreach;
    sh:name "Limit Breach";
    sh:description "detected violation of a risk limit with breach severity, exposure observation, and applicable limit".
fin-risk:hasMeasureNameShape a sh:NodeShape;
    sh:targetClass fin-risk:hasMeasureName;
    sh:name "has measure name";
    sh:description "human-readable name of the risk measure".
fin-risk:hasMeasureTypeShape a sh:NodeShape;
    sh:targetClass fin-risk:hasMeasureType;
    sh:name "has measure type";
    sh:description "category of the risk measure".
fin-risk:hasTimeHorizonShape a sh:NodeShape;
    sh:targetClass fin-risk:hasTimeHorizon;
    sh:name "has time horizon";
    sh:description "time horizon for risk calculation in days (e.g., 1 for 1-day VaR)".
fin-risk:hasConfidenceLevelShape a sh:NodeShape;
    sh:targetClass fin-risk:hasConfidenceLevel;
    sh:name "has confidence level";
    sh:description "confidence level for statistical risk measures (e.g., 0.99 for 99% VaR)".
fin-risk:hasLimitValueShape a sh:NodeShape;
    sh:targetClass fin-risk:hasLimitValue;
    sh:name "has limit value";
    sh:description "maximum allowed value for the risk measure".
fin-risk:hasWarningThresholdShape a sh:NodeShape;
    sh:targetClass fin-risk:hasWarningThreshold;
    sh:name "has warning threshold";
    sh:description "threshold value that triggers a warning before breach".
fin-risk:hasExposureValueShape a sh:NodeShape;
    sh:targetClass fin-risk:hasExposureValue;
    sh:name "has exposure value";
    sh:description "observed value of the risk measure".
fin-risk:hasBreachSeverityShape a sh:NodeShape;
    sh:targetClass fin-risk:hasBreachSeverity;
    sh:name "has breach severity";
    sh:description "severity level of the limit violation".
