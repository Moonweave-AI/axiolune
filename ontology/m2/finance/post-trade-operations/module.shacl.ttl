@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-post-trade: <https://axiolune.ai/ontology/finance/post-trade-operations/>.

fin-post-trade:CorporateActionTypeShape a sh:PropertyShape;
    sh:path fin-post-trade:CorporateActionType;
    sh:hasValue fin-post-trade:CorporateActionType_Dividend, fin-post-trade:CorporateActionType_Split, fin-post-trade:CorporateActionType_Merger, fin-post-trade:CorporateActionType_Spinoff, fin-post-trade:CorporateActionType_RightsIssue, fin-post-trade:CorporateActionType_Delisting;
    sh:name "Corporate Action Type".
fin-post-trade:SettlementStatusShape a sh:PropertyShape;
    sh:path fin-post-trade:SettlementStatus;
    sh:hasValue fin-post-trade:SettlementStatus_Pending, fin-post-trade:SettlementStatus_Settled, fin-post-trade:SettlementStatus_Failed, fin-post-trade:SettlementStatus_Canceled;
    sh:name "Settlement Status".
fin-post-trade:ReconciliationStatusShape a sh:PropertyShape;
    sh:path fin-post-trade:ReconciliationStatus;
    sh:hasValue fin-post-trade:ReconciliationStatus_Matched, fin-post-trade:ReconciliationStatus_Break, fin-post-trade:ReconciliationStatus_Investigating, fin-post-trade:ReconciliationStatus_Resolved;
    sh:name "Reconciliation Status".
fin-post-trade:CorporateActionEventShape a sh:NodeShape;
    sh:targetClass fin-post-trade:CorporateActionEvent;
    sh:name "Corporate Action Event";
    sh:description "scheduled or announced corporate action affecting instrument holders with ex-date, record date, payment date, and impact details".
fin-post-trade:SettlementInstructionShape a sh:NodeShape;
    sh:targetClass fin-post-trade:SettlementInstruction;
    sh:name "Settlement Instruction";
    sh:description "instruction to settle a trade execution with settlement date, status, counterparty, and clearing details".
fin-post-trade:ReconciliationBreakShape a sh:NodeShape;
    sh:targetClass fin-post-trade:ReconciliationBreak;
    sh:name "Reconciliation Break";
    sh:description "detected discrepancy between internal records and external source (broker, custodian, counterparty) with break details and resolution status".
fin-post-trade:hasActionTypeShape a sh:NodeShape;
    sh:targetClass fin-post-trade:hasActionType;
    sh:name "has action type";
    sh:description "category of the corporate action".
fin-post-trade:hasExDateShape a sh:NodeShape;
    sh:targetClass fin-post-trade:hasExDate;
    sh:name "has ex-date";
    sh:description "ex-dividend or ex-rights date after which new buyers do not receive the action benefit".
fin-post-trade:hasPaymentDateShape a sh:NodeShape;
    sh:targetClass fin-post-trade:hasPaymentDate;
    sh:name "has payment date";
    sh:description "date when dividend or other corporate action payment is made".
fin-post-trade:hasSettlementDateShape a sh:NodeShape;
    sh:targetClass fin-post-trade:hasSettlementDate;
    sh:name "has settlement date";
    sh:description "date when trade settlement occurs (T+N from trade date)".
fin-post-trade:hasSettlementStatusShape a sh:NodeShape;
    sh:targetClass fin-post-trade:hasSettlementStatus;
    sh:name "has settlement status";
    sh:description "current state of the settlement process".
fin-post-trade:hasReconciliationStatusShape a sh:NodeShape;
    sh:targetClass fin-post-trade:hasReconciliationStatus;
    sh:name "has reconciliation status";
    sh:description "current state of the reconciliation investigation".
fin-post-trade:hasBreakAmountShape a sh:NodeShape;
    sh:targetClass fin-post-trade:hasBreakAmount;
    sh:name "has break amount";
    sh:description "monetary value of the discrepancy".
