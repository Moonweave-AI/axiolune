fin-orders:OrderIntentShape_intentsInstrument a sh:PropertyShape;
    sh:path fin-orders:intentsInstrument;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-orders:OrderIntentShape sh:property fin-orders:OrderIntentShape_intentsListing.
fin-orders:OrderIntentShape_intentsListing a sh:PropertyShape;
    sh:path fin-orders:intentsListing;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/InstrumentListing>.
fin-orders:OrderIntentShape sh:property fin-orders:OrderIntentShape_pat_source.
fin-orders:OrderIntentShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
fin-orders:OrderLifecycleEventShape a sh:NodeShape;
    sh:targetClass fin-orders:OrderLifecycleEvent;
    sh:name "Order Lifecycle Event";
    sh:description "immutable state transition fact recording a change in order status, with previous state, resulting state, timestamp, reason, and external identifiers, forming an event-sourced audit trail";
    sh:property fin-orders:OrderLifecycleEventShape_hasLifecycleState.
fin-orders:OrderLifecycleEventShape_hasLifecycleState a sh:PropertyShape;
    sh:path fin-orders:hasLifecycleState;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Initialized" "Denied" "Emulated" "Released" "Submitted" "Accepted" "Rejected" "PendingUpdate" "PendingCancel" "PartiallyFilled" "Filled" "Canceled" "Expired" "Triggered").
fin-orders:OrderLifecycleEventShape sh:property fin-orders:OrderLifecycleEventShape_hasEventKind.
fin-orders:OrderLifecycleEventShape_hasEventKind a sh:PropertyShape;
    sh:path fin-orders:hasEventKind;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Initialized" "Denied" "Submitted" "Accepted" "Rejected" "PendingUpdate" "PendingCancel" "Updated" "ModifyRejected" "CancelRejected" "PartiallyFilled" "Filled" "Canceled" "Expired" "Triggered").
fin-orders:OrderLifecycleEventShape sh:property fin-orders:OrderLifecycleEventShape_hasPreviousState.
fin-orders:OrderLifecycleEventShape_hasPreviousState a sh:PropertyShape;
    sh:path fin-orders:hasPreviousState;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Initialized" "Denied" "Emulated" "Released" "Submitted" "Accepted" "Rejected" "PendingUpdate" "PendingCancel" "PartiallyFilled" "Filled" "Canceled" "Expired" "Triggered").
