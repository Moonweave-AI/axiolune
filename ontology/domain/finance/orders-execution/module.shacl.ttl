fin-orders:OrderLifecycleEventShape_transitionsOrder a sh:PropertyShape;
    sh:path fin-orders:transitionsOrder;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class fin-orders:OrderIntent.
fin-orders:OrderLifecycleEventShape sh:property fin-orders:OrderLifecycleEventShape_occurredAtVenue.
fin-orders:OrderLifecycleEventShape_occurredAtVenue a sh:PropertyShape;
    sh:path fin-orders:occurredAtVenue;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/market-structure/TradingVenue>.
fin-orders:OrderLifecycleEventShape sh:property fin-orders:OrderLifecycleEventShape_pat_validFrom.
fin-orders:OrderLifecycleEventShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-orders:OrderLifecycleEventShape sh:property fin-orders:OrderLifecycleEventShape_pat_knowledgeFrom.
fin-orders:OrderLifecycleEventShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-orders:OrderLifecycleEventShape sh:property fin-orders:OrderLifecycleEventShape_pat_availableFrom.
fin-orders:OrderLifecycleEventShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-orders:OrderLifecycleEventShape sh:property fin-orders:OrderLifecycleEventShape_pat_validTo.
fin-orders:OrderLifecycleEventShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-orders:OrderLifecycleEventShape sh:property fin-orders:OrderLifecycleEventShape_pat_knowledgeTo.
fin-orders:OrderLifecycleEventShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-orders:OrderLifecycleEventShape sh:property fin-orders:OrderLifecycleEventShape_pat_availableTo.
fin-orders:OrderLifecycleEventShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-orders:OrderLifecycleEventShape sh:sparql _:sparql_valid_OrderLifecycleEvent.
_:sparql_valid_OrderLifecycleEvent sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-orders:OrderLifecycleEventShape sh:sparql _:sparql_knowledge_OrderLifecycleEvent.
_:sparql_knowledge_OrderLifecycleEvent sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-orders:OrderLifecycleEventShape sh:sparql _:sparql_available_OrderLifecycleEvent.
_:sparql_available_OrderLifecycleEvent sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
