@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-orders: <https://axiolune.ai/ontology/finance/orders-execution/>.

fin-orders:OrderSideShape a sh:NodeShape;
    sh:targetClass fin-orders:OrderSide;
    sh:in ("Buy" "Sell");
    sh:name "Order Side".
fin-orders:OrderTypeShape a sh:NodeShape;
    sh:targetClass fin-orders:OrderType;
    sh:in ("Market" "Limit" "Stop" "StopLimit" "MarketIfTouched" "LimitIfTouched");
    sh:name "Order Type".
fin-orders:TimeInForceShape a sh:NodeShape;
    sh:targetClass fin-orders:TimeInForce;
    sh:in ("GTC" "IOC" "FOK" "DAY" "GTD" "AtTheOpen" "AtTheClose");
    sh:name "Time In Force".
fin-orders:OrderLifecycleStateShape a sh:NodeShape;
    sh:targetClass fin-orders:OrderLifecycleState;
    sh:in ("Initialized" "Denied" "Emulated" "Released" "Submitted" "Accepted" "Rejected" "PendingUpdate" "PendingCancel" "PartiallyFilled" "Filled" "Canceled" "Expired" "Triggered");
    sh:name "Order Lifecycle State".
fin-orders:OrderEventKindShape a sh:NodeShape;
    sh:targetClass fin-orders:OrderEventKind;
    sh:in ("Initialized" "Denied" "Submitted" "Accepted" "Rejected" "PendingUpdate" "PendingCancel" "Updated" "ModifyRejected" "CancelRejected" "PartiallyFilled" "Filled" "Canceled" "Expired" "Triggered");
    sh:name "Order Event Kind".
fin-orders:LiquiditySideShape a sh:NodeShape;
    sh:targetClass fin-orders:LiquiditySide;
    sh:in ("Maker" "Taker" "NoLiquiditySide");
    sh:name "Liquidity Side".
fin-orders:OrderIntentShape a sh:NodeShape;
    sh:targetClass fin-orders:OrderIntent;
    sh:name "Order Intent";
    sh:description "trader or strategy desired trade instruction specifying instrument, side, quantity, type, time-in-force, and price constraints, representing the business intent before venue submission";
    sh:property fin-orders:OrderIntentShape_hasOrderSide.
fin-orders:OrderIntentShape_hasOrderSide a sh:PropertyShape;
    sh:path fin-orders:hasOrderSide;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Buy" "Sell").
fin-orders:OrderIntentShape sh:property fin-orders:OrderIntentShape_hasOrderType.
fin-orders:OrderIntentShape_hasOrderType a sh:PropertyShape;
    sh:path fin-orders:hasOrderType;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Market" "Limit" "Stop" "StopLimit" "MarketIfTouched" "LimitIfTouched").
fin-orders:OrderIntentShape sh:property fin-orders:OrderIntentShape_hasTimeInForce.
fin-orders:OrderIntentShape_hasTimeInForce a sh:PropertyShape;
    sh:path fin-orders:hasTimeInForce;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("GTC" "IOC" "FOK" "DAY" "GTD" "AtTheOpen" "AtTheClose").
fin-orders:OrderIntentShape sh:property fin-orders:OrderIntentShape_hasOrderQuantity.
fin-orders:OrderIntentShape_hasOrderQuantity a sh:PropertyShape;
    sh:path fin-orders:hasOrderQuantity;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-orders:OrderIntentShape sh:property fin-orders:OrderIntentShape_hasLimitPrice.
fin-orders:OrderIntentShape_hasLimitPrice a sh:PropertyShape;
    sh:path fin-orders:hasLimitPrice;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-orders:OrderIntentShape sh:property fin-orders:OrderIntentShape_hasStopPrice.
fin-orders:OrderIntentShape_hasStopPrice a sh:PropertyShape;
    sh:path fin-orders:hasStopPrice;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
