<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/clearingMember> a owl:ObjectProperty;
    rdfs:comment "optional logical clearing member party";
    rdfs:domain fin-orders:Execution;
    rdfs:label "clearing member";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/clientBeneficialOwner> a owl:ObjectProperty;
    rdfs:comment "optional logical party that is the beneficial owner on whose behalf the execution is made";
    rdfs:domain fin-orders:Execution;
    rdfs:label "client beneficial owner";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/contraAccount> a owl:ObjectProperty;
    rdfs:comment "optional logical FinancialAccount occupying the counterparty-side account role; absent when the execution is an anonymous order-book fill or a client-side report without bilateral evidence";
    rdfs:domain fin-orders:Execution;
    rdfs:label "contra account";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/FinancialAccount/LogicalIdentity>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/contraParty> a owl:ObjectProperty;
    rdfs:comment "optional logical Party occupying the counterparty role; absent when no bilateral evidence is available, independently of any executing broker; a \"unknown Party\" placeholder is forbidden";
    rdfs:domain fin-orders:Execution;
    rdfs:label "contra party";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executingAlgorithm> a owl:ObjectProperty;
    rdfs:comment "optional logical party representing the algorithm that generated or routed the order";
    rdfs:domain fin-orders:Execution;
    rdfs:label "executing algorithm";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executingBroker> a owl:ObjectProperty;
    rdfs:comment "optional logical party that executed or reported the fill";
    rdfs:domain fin-orders:Execution;
    rdfs:label "executing broker";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executingFirm> a owl:ObjectProperty;
    rdfs:comment "optional logical firm that executed the order";
    rdfs:domain fin-orders:Execution;
    rdfs:label "executing firm";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionAccount> a owl:ObjectProperty;
    rdfs:comment "logical financial account whose order perspective is represented";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution account";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/FinancialAccount/LogicalIdentity>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionDecisionMaker> a owl:ObjectProperty;
    rdfs:comment "optional logical party responsible for the execution decision";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution decision maker";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionExternalOrder> a owl:ObjectProperty;
    rdfs:comment "exact external order version filled by the execution";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution external order";
    rdfs:range fin-orders:ExternalOrder.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionInstrument> a owl:ObjectProperty;
    rdfs:comment "logical financial instrument that was bought or sold";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution instrument";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument/LogicalIdentity>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionListing> a owl:ObjectProperty;
    rdfs:comment "optional exact PIT-eligible listing version for a listed execution";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution listing";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/InstrumentListing>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionOrderIntent> a owl:ObjectProperty;
    rdfs:comment "exact originating order intent version";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution order intent";
    rdfs:range fin-orders:OrderIntent.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionOtcContext> a owl:ObjectProperty;
    rdfs:comment "optional exact OTC context; required only when no listing is supplied (deprecated with OTCTradingContext per ADR-024; to be migrated to NonVenueMarketContext via a cross-module follow-up)";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution OTC context";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionParty> a owl:ObjectProperty;
