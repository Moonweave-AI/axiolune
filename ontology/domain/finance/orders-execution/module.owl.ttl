fin-orders:Execution a owl:Class;
    rdfs:comment "An Execution is an immutable provider fill or fill-report fact that occurs in one exact event stream, used for recording the real economic content of a trade through explicit execution-side and contra-side accounts, party roles, instrument, quantity, price, and the matching quotation contract.";
    rdfs:label "Execution";
