<https://axiolune.ai/ontology/finance/orders-execution> a owl:Ontology;
    rdfs:comment "The Orders and Execution module is a domain module that defines the trade lifecycle from order intent through routing and external order to execution and allocation, used for providing state-machine and audit-backed definitions for the order-to-fill process. The domain facts (intent, route, external order, lifecycle event, execution, fee, allocation) are separated from provider raw-code mapping/adapter implementation and from runtime/validation/quality findings, which are evidence of an interpretation or check rather than existence conditions of an order fact. v1.1.0 covers single-instrument, direct-unit-quotation orders; multi-leg and non-direct-unit quotation are scaffolded as extension points and completed via a cross-module follow-up gated on the instruments QuotationConvention (ADR-021).";
    rdfs:label "Orders and Execution";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/instruments>, <https://axiolune.ai/ontology/finance/market-rules>, <https://axiolune.ai/ontology/finance/market-structure>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/orders-execution/1.1.0>.
fin-orders:AllocationLine a owl:Class;
    rdfs:comment "An Allocation Line is an immutable allocation target line expressing one account's share of a source execution, used to model post-execution allocation, average-price allocation, and bunched-order back-allocation together with an ExecutionAllocation, while detailed allocation and clearing semantics remain in post-trade-operations.";
    rdfs:label "Allocation Line";
    rdfs:subClassOf _:r_022a2055affa0b1f5e2be112, _:r_0433b7e85c4cee3ce33769b4, _:r_10a77ac55e6eba33bc92e499, _:r_20eb8320015b4f269d5b64ff, _:r_28a8ade24f055528a86dd7bd, _:r_74349928152a13d1ca0d9703, _:r_81454d6dad5ab5cd156b5cc8, _:r_bbaa4bffe00aedeacd38d8e1, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
