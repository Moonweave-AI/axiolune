    rdfs:comment "midpoint of the reviewed eligible bid and ask";
    skos:inScheme <https://axiolune.ai/ontology/finance/orders-execution/TriggerPriceBasis/scheme>;
    skos:notation "midPoint";
    skos:prefLabel "midpoint";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/orders-execution/TriggerPriceBasis/value/venueDefault> a owl:NamedIndividual, skos:Concept, fin-orders:TriggerPriceBasis;
    rdfs:comment "trigger basis selected by the reviewed venue or adapter contract";
    skos:inScheme <https://axiolune.ai/ontology/finance/orders-execution/TriggerPriceBasis/scheme>;
    skos:notation "venueDefault";
    skos:prefLabel "venue default";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-orders:acceptableVenueSet a owl:ObjectProperty;
    rdfs:comment "relationship from a venue-neutral OrderIntent to one or more logical TradingFacility venues acceptable for its execution, used as the venue-neutral alternative to a single listing or OTC context binding";
    rdfs:domain fin-orders:OrderIntent;
    rdfs:label "acceptable venue set";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingFacility/LogicalIdentity>.
fin-orders:affectedKeyDigest a owl:DatatypeProperty;
    rdfs:comment "kind-discriminated digest value of the strict OrderFindingSubject object, used for digesting and distinguishing finding subjects by defect kind";
    rdfs:label "affected key digest";
    rdfs:range xsd:string.
fin-orders:allocationQuantity a owl:ObjectProperty;
    rdfs:comment "strictly positive absolute Quantity allocated to one AllocationLine target account, used to partition a source execution quantity with conservation";
    rdfs:label "allocation quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-orders:allocationStatus a owl:ObjectProperty;
    rdfs:comment "closed allocation-status classification attribute of an ExecutionAllocation or AllocationLine, used to express the state of an allocation (e.g. proposed, accepted, rejected, cancelled, corrected)";
    rdfs:label "allocation status";
    rdfs:range fin-orders:AllocationStatus.
fin-orders:allocationTargetAccount a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an AllocationLine to the logical FinancialAccount that is the allocation target, used to express post-execution allocation across multiple final accounts";
    rdfs:domain fin-orders:AllocationLine;
    rdfs:label "allocation target account";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/FinancialAccount/LogicalIdentity>.
fin-orders:appliedStatusMapping a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an OrderLifecycleEvent to the exact ExternalOrderStatusMapping version applied to translate its raw provider status code into a canonical lifecycle state, used to make the state machine auditable";
    rdfs:domain fin-orders:OrderLifecycleEvent;
    rdfs:label "applied status mapping";
    rdfs:range fin-orders:ExternalOrderStatusMapping.
fin-orders:appliedTransitionProfile a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an OrderLifecycleEvent to the exact OrderTransitionProfile version whose transition table governed the event's state transition, used to make the transition auditable";
    rdfs:domain fin-orders:OrderLifecycleEvent;
    rdfs:label "applied transition profile";
    rdfs:range fin-orders:OrderTransitionProfile.
fin-orders:averagePrice a owl:ObjectProperty;
    rdfs:comment "volume-weighted average execution Money price recorded in a FillSnapshot, interpreted through the exact direct-unit quotation contract";
    rdfs:label "average price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-orders:cancelledQty a owl:ObjectProperty;
    rdfs:comment "cancelled Quantity recorded in a FillSnapshot, used to express the quantity removed from the order by cancellation";
    rdfs:label "cancelled quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-orders:canonicalLifecycleState a owl:ObjectProperty;
    rdfs:comment "exactly one canonical target state selected by a status mapping, used for normalizing a provider raw code into a canonical state";
    rdfs:label "canonical lifecycle state";
    rdfs:range fin-orders:OrderLifecycleState.
fin-orders:clientIntentId a owl:DatatypeProperty;
    rdfs:comment "authority-scoped stable string identifier of a client trade intent, used for providing the logical identity primary key of an OrderIntent";
    rdfs:label "client intent identifier";
    rdfs:range xsd:string.
fin-orders:cumQty a owl:ObjectProperty;
    rdfs:comment "cumulative filled Quantity recorded in a FillSnapshot, used to audit Filled and PartiallyFilled states against the effective net quantity";
    rdfs:label "cumulative quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-orders:disclosureStatus a owl:ObjectProperty;
    rdfs:comment "closed disclosure classification attribute of an Execution or MatchedTrade, used to express whether the counterparty is disclosed, anonymous, or partially disclosed";
    rdfs:label "disclosure status";
    rdfs:range fin-orders:DisclosureStatus.
fin-orders:eventReason a owl:DatatypeProperty;
    rdfs:comment "provider reason text or normalized reason identifier for an event, used for explaining the cause of the event";
    rdfs:label "event reason";
    rdfs:range xsd:string.
fin-orders:executedAt a owl:DatatypeProperty;
    rdfs:comment "optional inclusive UTC instant at which the trade represented by an execution actually occurred, distinct from the provider-reporteded and observed timestamps";
    rdfs:label "executed at";
    rdfs:range xsd:dateTimeStamp.
fin-orders:executionPrice a owl:ObjectProperty;
    rdfs:comment "Money price attribute interpreted only through the exact direct-unit quotation contract, used for expressing the trade price of the execution";
    rdfs:label "execution price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-orders:executionQuantity a owl:ObjectProperty;
    rdfs:comment "strictly positive absolute Quantity attribute filled by an Execution, used for expressing the amount of the instrument traded in that execution";
    rdfs:label "execution quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-orders:executionQuotationConvention a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an Execution to its quotation convention, used as the hook to be broadened from DirectUnitPriceQuotationContract to the abstract QuotationConvention (ADR-021) in a cross-module follow-up; in v1.1.0 it references the retained DirectUnitPriceQuotationContract";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution quotation convention";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/DirectUnitPriceQuotationContract>.
fin-orders:executionVenue a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an Execution to the logical TradingFacility where the execution occurred, used to distinguish the actual execution venue from the execution listing";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution venue";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingFacility/LogicalIdentity>.
fin-orders:expectedAfterSourceOrderKey a owl:DatatypeProperty;
    rdfs:comment "source order key after which an acknowledgement was required, used for judging whether an acknowledgement is missing";
    rdfs:label "expected after source order key";
    rdfs:range xsd:integer.
fin-orders:externalOrderId a owl:DatatypeProperty;
    rdfs:comment "provider-scoped immutable string identifier of an external order, used for providing the logical identity primary key of an ExternalOrder";
    rdfs:label "external order identifier";
    rdfs:range xsd:string.
fin-orders:externalOrderOriginatingIntent a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an ExternalOrder to its exact originating OrderIntent version, used for anchoring the external order to its unique client trade intent";
    rdfs:domain fin-orders:ExternalOrder;
    rdfs:label "external order originating intent";
    rdfs:range fin-orders:OrderIntent.
fin-orders:externalOrderProvider a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an ExternalOrder to the logical provider Party, used for identifying the execution service provider that accepted or holds the external order";
    rdfs:domain fin-orders:ExternalOrder;
    rdfs:label "external order provider";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-orders:feeAmount a owl:ObjectProperty;
    rdfs:comment "strictly positive Money magnitude attribute, used for expressing the magnitude of the fee, whose sign is never overloaded with fee-effect semantics";
    rdfs:label "fee amount";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-orders:feeBasis a owl:DatatypeProperty;
    rdfs:comment "optional string describing the basis on which a fee was calculated (e.g. per-share, notional, bps), used to explain the fee amount";
    rdfs:label "fee basis";
    rdfs:range xsd:string.
fin-orders:feeEffect a owl:ObjectProperty;
    rdfs:comment "charge-or-rebate arithmetic direction attribute for a positive fee magnitude, used for independently determining the direction in which the fee affects cost or proceeds";
    rdfs:label "fee effect";
    rdfs:range fin-orders:FeeEffect.
fin-orders:feeId a owl:DatatypeProperty;
    rdfs:comment "source-scoped immutable string identifier of one fee fact, used for providing the logical identity primary key of a fee fact";
    rdfs:label "fee identifier";
    rdfs:range xsd:string.
fin-orders:feeKind a owl:ObjectProperty;
    rdfs:comment "closed classification member identifying the economic or regulatory kind of an execution Fee, used for distinguishing commission, exchange fee, clearing fee, and other fee natures";
    rdfs:label "fee kind";
    rdfs:range fin-orders:FeeKind.
fin-orders:feePayee a owl:DatatypeProperty;
    rdfs:comment "relationship from a Fee to the logical Party that receives the fee, used to fix the fee effect relative to an explicit payee or assessor";
    rdfs:label "fee payee";
    rdfs:range xsd:string.
fin-orders:feePayer a owl:DatatypeProperty;
    rdfs:comment "relationship from a Fee to the logical Party that pays the fee, used to fix the fee effect relative to an explicit payer";
    rdfs:label "fee payer";
    rdfs:range xsd:string.
fin-orders:feeTaxJurisdiction a owl:DatatypeProperty;
    rdfs:comment "optional logical Jurisdiction under whose tax authority a fee falls, used for tax-jurisdiction-scoped fees";
    rdfs:label "fee tax jurisdiction";
    rdfs:range xsd:string.
fin-orders:fieldAbsenceProbeDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest value of the completed field-absence probe record, used for verifying the content integrity of the probe record";
    rdfs:label "field absence probe digest";
    rdfs:range xsd:string.
fin-orders:fieldAbsenceProbeRef a owl:DatatypeProperty;
    rdfs:comment "immutable URI reference to the completed source-record field-absence probe, used for locating the probe record that proves the absence of a field";
    rdfs:label "field absence probe reference";
    rdfs:range xsd:anyURI.
fin-orders:findingProviderEventId a owl:DatatypeProperty;
    rdfs:comment "provider event identifier in a duplicateConflict finding subject, used for indicating which event identifier is in conflict";
    rdfs:label "finding provider event identifier";
    rdfs:range xsd:string.
fin-orders:implementationDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest value over the canonical executable implementation bytes, used for locking the implementation content of the transition evaluator";
    rdfs:label "implementation digest";
    rdfs:range xsd:string.
fin-orders:inputContractDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest value of the evaluator input contract, used for locking the input contract of the evaluator";
    rdfs:label "input contract digest";
    rdfs:range xsd:string.
fin-orders:intentAccount a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an OrderIntent to its logical FinancialAccount, used for identifying the account principal of the trade at the intent level";
    rdfs:domain fin-orders:OrderIntent;
    rdfs:label "intent account";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/FinancialAccount/LogicalIdentity>.
fin-orders:intentIdentifierAuthority a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an OrderIntent to the logical IdentifierAuthority that scopes its clientIntentId, used to establish the two-component logical key (authority, clientIntentId) so that two different authorities using the same clientIntentId remain distinct";
    rdfs:domain fin-orders:OrderIntent;
    rdfs:label "intent identifier authority";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/IdentifierAuthority/LogicalIdentity>.
fin-orders:intentInstrument a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an OrderIntent to its logical FinancialInstrument, used for identifying the instrument to be bought or sold by the trade intent";
    rdfs:domain fin-orders:OrderIntent;
    rdfs:label "intent instrument";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument/LogicalIdentity>.
fin-orders:intentIssuer a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an OrderIntent to the logical Party that issued the intent, used to identify the client, strategy, or authorized routing process that originated the trade intent independently of the account";
    rdfs:domain fin-orders:OrderIntent;
    rdfs:label "intent issuer";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-orders:intentListing a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an OrderIntent to its optional exact listed trading context, used for binding the listed trading context of the intent when trading on an exchange";
    rdfs:domain fin-orders:OrderIntent;
    rdfs:label "intent listing";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/InstrumentListing>.
fin-orders:intentOtcContext a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an OrderIntent to its optional exact OTC trading context, used for binding the OTC trading context of the intent when trading over the counter";
    rdfs:domain fin-orders:OrderIntent;
    rdfs:label "intent OTC context";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext>.
fin-orders:lastQty a owl:ObjectProperty;
    rdfs:comment "strictly positive absolute Quantity filled by the last execution recorded in a FillSnapshot, used to express the incremental fill quantity of the event";
    rdfs:label "last quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-orders:leavesQty a owl:ObjectProperty;
    rdfs:comment "remaining (open) Quantity recorded in a FillSnapshot, used to express the quantity still eligible for filling";
    rdfs:label "leaves quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-orders:lifecycleState a owl:ObjectProperty;
    rdfs:comment "resulting canonical lifecycle state attribute stored on an immutable event, used for expressing the canonical state of an order after an event has occurred";
    rdfs:label "lifecycle state";
    rdfs:range fin-orders:OrderLifecycleState.
fin-orders:limitPrice a owl:ObjectProperty;
    rdfs:comment "Money price limit required only when the executable profile of the order type demands one, used for constraining the executable price of a limit-type order";
    rdfs:label "limit price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-orders:liquidityDeterminationResult a owl:ObjectProperty;
    rdfs:comment "classified-or-unavailable branch discriminator attribute, used for expressing whether the determination yields a role or declares unavailability";
    rdfs:label "liquidity determination result";
    rdfs:range fin-orders:LiquidityDeterminationResult.
fin-orders:liquidityMappingId a owl:DatatypeProperty;
    rdfs:comment "stable string identifier of a source liquidity-role mapping, used for providing the logical identity primary key of a liquidity mapping";
    rdfs:label "liquidity mapping identifier";
    rdfs:range xsd:string.
fin-orders:liquidityPerspective a owl:ObjectProperty;
    rdfs:comment "fixed execution-account-order perspective attribute of a liquidity determination, used for specifying the perspective on which the determination result is based";
    rdfs:label "liquidity perspective";
    rdfs:range fin-orders:LiquidityPerspective.
fin-orders:liquidityRole a owl:ObjectProperty;
    rdfs:comment "maker, taker, or contract-defined auction-undefined result attribute, used for expressing the role of the execution order in providing liquidity";
    rdfs:label "liquidity role";
    rdfs:range fin-orders:LiquidityRole.
fin-orders:liquidityRoleCapability a owl:ObjectProperty;
    rdfs:comment "closed source-contract capability attribute governing liquidity classification, used for declaring whether an event stream requires, optionally supports, or does not support liquidity role classification";
    rdfs:label "liquidity role capability";
    rdfs:range fin-orders:LiquidityRoleCapability.
fin-orders:liquidityUnavailableReason a owl:ObjectProperty;
    rdfs:comment "contractUnsupported or providerNotSpecified evidence branch reason attribute, used for explaining why a liquidity role cannot be classified";
    rdfs:label "liquidity unavailable reason";
    rdfs:range fin-orders:LiquidityUnavailableReason.
fin-orders:mappingDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest value of the canonical raw-value mapping table, used for verifying the content integrity of the mapping table";
    rdfs:label "mapping digest";
    rdfs:range xsd:string.
fin-orders:matchId a owl:DatatypeProperty;
    rdfs:comment "optional match identifier string for the matched trade, distinct from the venue trade identifier and the provider report identifier";
    rdfs:label "match identifier";
    rdfs:range xsd:string.
fin-orders:missingKeyFrom a owl:DatatypeProperty;
    rdfs:comment "inclusive start of a sequence-gap half-open interval, used for bounding the lower end of the missing key interval";
    rdfs:label "missing key from";
    rdfs:range xsd:integer.
fin-orders:missingKeyTo a owl:DatatypeProperty;
    rdfs:comment "exclusive end of a sequence-gap half-open interval, used for bounding the upper end of the missing key interval";
    rdfs:label "missing key to";
    rdfs:range xsd:integer.
fin-orders:observedSourceOrderKey a owl:DatatypeProperty;
    rdfs:comment "observed source order key in an outOfOrder finding subject, used for recording the actual arrival order of events";
    rdfs:label "observed source order key";
    rdfs:range xsd:integer.
fin-orders:orderCapacity a owl:ObjectProperty;
    rdfs:comment "closed capacity classification attribute, used to express agency, principal, and riskless-principal capacity separate from the order side and position effect";
    rdfs:label "order capacity";
    rdfs:range fin-orders:OrderCapacity.
fin-orders:orderEventKind a owl:ObjectProperty;
    rdfs:comment "immutable event-log kind attribute distinct from the resulting state, used for expressing the type of the event itself rather than the state it causes";
    rdfs:label "order event kind";
    rdfs:range fin-orders:OrderEventKind.
fin-orders:orderIntegrityKind a owl:ObjectProperty;
    rdfs:comment "closed kind attribute of order event stream defect, used for distinguishing different defect types such as duplicate conflict and sequence gap";
    rdfs:label "order integrity kind";
    rdfs:range fin-orders:OrderIntegrityKind.
fin-orders:orderLineageKeyDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest computed over the lineage kind and the two exact endpoint-set digests under domain separation by the axiolune-order-intent-lineage-key-v1 contract, used for providing the unique logical key of a lineage fact.";
    rdfs:label "order lineage key digest";
    rdfs:range xsd:string.
fin-orders:orderLineageKind a owl:ObjectProperty;
    rdfs:comment "split-or-aggregation branch attribute selected by an immutable OrderIntentLineage fact, used for distinguishing the two routing types of a lineage transformation";
    rdfs:label "order lineage kind";
    rdfs:range fin-orders:OrderLineageKind.
fin-orders:orderQuantity a owl:ObjectProperty;
    rdfs:comment "strictly positive absolute Quantity attribute requested by an OrderIntent, used for expressing the amount of the instrument the intent wishes to trade";
    rdfs:label "order quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-orders:orderSide a owl:ObjectProperty;
    rdfs:comment "independent buy-or-sell direction attribute of an intent or execution, used for expressing whether the trade increases or decreases position exposure";
    rdfs:label "order side";
    rdfs:range fin-orders:OrderSide.
fin-orders:orderType a owl:ObjectProperty;
    rdfs:comment "reviewed execution instruction kind attribute of an OrderIntent, used for distinguishing order types such as market, limit, and stop by their price and trigger semantics";
    rdfs:label "order type";
    rdfs:range fin-orders:OrderType.
fin-orders:orderValidUntil a owl:DatatypeProperty;
    rdfs:comment "exclusive expiry instant required when the validity instruction has an explicit end, used for limiting the last moment at which the order remains valid";
    rdfs:label "order valid until";
    rdfs:range xsd:dateTimeStamp.
fin-orders:outputContractDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest value of the evaluator output contract, used for locking the output contract of the evaluator";
    rdfs:label "output contract digest";
    rdfs:range xsd:string.
fin-orders:perspectiveInversion a owl:DatatypeProperty;
    rdfs:comment "boolean attribute indicating whether a reviewed mapping inverts a contra-perspective source value, used for handling liquidity values that originate from the counterparty side";
    rdfs:label "perspective inversion";
    rdfs:range xsd:boolean.
fin-orders:positionEffect a owl:ObjectProperty;
    rdfs:comment "closed position-effect classification attribute separate from order side, used to express open, close, roll, and similar position effects";
    rdfs:label "position effect";
    rdfs:range fin-orders:PositionEffect.
fin-orders:priorityPreserved a owl:DatatypeProperty;
    rdfs:comment "boolean attribute indicating whether a replace or cancel-replace revision preserves the original order priority in the book";
    rdfs:label "priority preserved";
    rdfs:range xsd:boolean.
fin-orders:providerApiIdentifier a owl:DatatypeProperty;
    rdfs:comment "canonical string identifier of the provider API or protocol surface, used for distinguishing different execution service interfaces";
    rdfs:label "provider API identifier";
    rdfs:range xsd:string.
fin-orders:providerEventId a owl:DatatypeProperty;
    rdfs:comment "immutable event identifier string unique within one OrderEventStream, used for providing the provider-side event primary key of a lifecycle event";
    rdfs:label "provider event identifier";
    rdfs:range xsd:string.
fin-orders:providerExecutionId a owl:DatatypeProperty;
    rdfs:comment "immutable trade or execution identifier string unique within one OrderEventStream, used for providing the provider-side execution primary key of an execution fact";
    rdfs:label "provider execution identifier";
    rdfs:range xsd:string.
fin-orders:providerReportId a owl:DatatypeProperty;
    rdfs:comment "optional provider report identifier string for the execution report, distinct from the venue trade identifier and the match identifier";
    rdfs:label "provider report identifier";
    rdfs:range xsd:string.
fin-orders:providerReportedAt a owl:DatatypeProperty;
    rdfs:comment "optional inclusive UTC instant at which the provider reported the execution, distinct from the actual execution and system observation timestamps";
    rdfs:label "provider reported at";
    rdfs:range xsd:dateTimeStamp.
fin-orders:providerSchemaVersion a owl:DatatypeProperty;
    rdfs:comment "immutable provider-declared string version of the API or protocol, used for fixing the provider version on which a fact relies";
    rdfs:label "provider schema version";
    rdfs:range xsd:string.
fin-orders:providerStreamId a owl:DatatypeProperty;
    rdfs:comment "provider-scoped string identifier of one order event stream, used for providing the provider-side stream identifier of an event stream";
    rdfs:label "provider stream identifier";
    rdfs:range xsd:string.
fin-orders:rawFieldLocator a owl:DatatypeProperty;
    rdfs:comment "canonical source-schema field locator string for a liquidity value, used for locating the field in the source record that carries the liquidity value";
    rdfs:label "raw field locator";
    rdfs:range xsd:string.
fin-orders:rawLexicalValue a owl:DatatypeProperty;
    rdfs:comment "exact source lexical value used by a classified liquidity mapping, used for recording the raw field value on which the mapping was based";
    rdfs:label "raw lexical value";
    rdfs:range xsd:string.
fin-orders:rawPerspective a owl:DatatypeProperty;
    rdfs:comment "source-contract perspective from which a raw liquidity value is expressed, used for identifying which side perspective the value is given from";
    rdfs:label "raw perspective";
    rdfs:range xsd:string.
fin-orders:rawProviderStatusCode a owl:DatatypeProperty;
    rdfs:comment "exact provider lexical status code carried by an external lifecycle event before canonical mapping, used to make the applied status mapping auditable on the event itself";
    rdfs:label "raw provider status code";
    rdfs:range xsd:string.
fin-orders:rawStatusCode a owl:DatatypeProperty;
    rdfs:comment "exact provider lexical status code string before canonical mapping, used for recording the provider raw value that is mapped to a canonical state";
    rdfs:label "raw status code";
    rdfs:range xsd:string.
fin-orders:relatedVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "digest value of the sorted unique exact versions cited by an integrity finding, used for verifying the integrity and consistency of the version set involved in the finding";
    rdfs:label "related version set digest";
    rdfs:range xsd:string.
fin-orders:replacedTerms a owl:DatatypeProperty;
    rdfs:comment "optional string describing the terms that replace the previous order terms in a replace or cancel-replace revision";
    rdfs:label "replaced terms";
    rdfs:range xsd:string.
fin-orders:reportsExecution a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from a fill-kind OrderLifecycleEvent to the exact Execution version it records, used to close the event—execution—cumulative-quantity—state loop";
    rdfs:domain fin-orders:OrderLifecycleEvent;
    rdfs:label "reports execution";
    rdfs:range fin-orders:Execution.
fin-orders:requiredPredecessorSourceOrderKey a owl:DatatypeProperty;
    rdfs:comment "predecessor key required before an outOfOrder event, used for judging whether the event violates the order constraint";
    rdfs:label "required predecessor source order key";
    rdfs:range xsd:integer.
fin-orders:resultIntentCount a owl:DatatypeProperty;
    rdfs:comment "exact number of result OrderIntent versions in the lineage output closure, used for verifying the closure of the lineage endpoints together with the set digest";
    rdfs:label "result intent count";
    rdfs:range xsd:integer.
fin-orders:resultIntentVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "section-5.8 framed IRI-set digest over the sorted unique exact result OrderIntent versions, used for verifying the integrity and consistency of the lineage result endpoint set";
    rdfs:label "result intent version-set digest";
    rdfs:range xsd:string.
fin-orders:reviewDecisionDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest value of the canonical mapping review record, used for verifying the content integrity of the review decision record";
    rdfs:label "review decision digest";
    rdfs:range xsd:string.
fin-orders:reviewDecisionRef a owl:DatatypeProperty;
    rdfs:comment "immutable URI reference to the human-reviewed semantic mapping decision, used for locating the review record of that mapping decision";
    rdfs:label "review decision reference";
    rdfs:range xsd:anyURI.
fin-orders:revisionKind a owl:ObjectProperty;
    rdfs:comment "closed classification attribute of an OrderRevision, used to distinguish replace, cancel, and cancel-replace revision kinds";
    rdfs:label "revision kind";
    rdfs:range fin-orders:RevisionKind.
fin-orders:revisionRequestId a owl:DatatypeProperty;
    rdfs:comment "immutable string identifier of a cancel/replace revision request, used to provide the logical identity primary key of an OrderRevision";
    rdfs:label "revision request identifier";
    rdfs:range xsd:string.
fin-orders:routeReason a owl:DatatypeProperty;
    rdfs:comment "optional reason text or normalized identifier explaining why a route was made or changed, used to explain routing decisions";
    rdfs:label "route reason";
    rdfs:range xsd:string.
fin-orders:routeStatus a owl:ObjectProperty;
    rdfs:comment "closed route-status classification attribute of an OrderRoute, used to express the state of a route (e.g. routed, accepted, rejected, cancelled)";
    rdfs:label "route status";
    rdfs:range fin-orders:RouteStatus.
fin-orders:routeTime a owl:DatatypeProperty;
    rdfs:comment "inclusive UTC instant at which an OrderRoute was made, used to order routes within a parent intent";
    rdfs:label "route time";
    rdfs:range xsd:dateTimeStamp.
fin-orders:routedQuantity a owl:ObjectProperty;
    rdfs:comment "strictly positive absolute Quantity routed by an OrderRoute, used to express the quantity delegated to a child order or destination";
    rdfs:label "routed quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-orders:routingPolicy a owl:DatatypeProperty;
    rdfs:comment "optional string describing the routing policy governing a venue-neutral OrderIntent (e.g. best-execution, SOR), used when no single listing or OTC context is bound";
    rdfs:label "routing policy";
    rdfs:range xsd:string.
fin-orders:runtimeDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest value of the evaluator runtime environment, used for locking the content of the evaluator runtime environment";
    rdfs:label "runtime digest";
    rdfs:range xsd:string.
fin-orders:shortSaleIndicator a owl:ObjectProperty;
    rdfs:comment "closed short-sale indicator classification attribute, used to express long, short, and short-exempt markers required by short-sale regulation (e.g. SEC Regulation SHO)";
    rdfs:label "short sale indicator";
    rdfs:range fin-orders:ShortSaleIndicator.
fin-orders:sourceContractDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest value over the canonical source contract bytes, used for verifying the content integrity of the referenced contract";
    rdfs:label "source contract digest";
    rdfs:range xsd:string.
fin-orders:sourceContractRef a owl:DatatypeProperty;
    rdfs:comment "immutable URI reference to the source schema, mapping, and capability contract, used for locating the source contract on which a fact was generated";
    rdfs:label "source contract reference";
    rdfs:range xsd:anyURI.
fin-orders:sourceIntentCount a owl:DatatypeProperty;
    rdfs:comment "exact number of source OrderIntent versions in the lineage input closure, used for verifying the closure of the lineage endpoints together with the set digest";
    rdfs:label "source intent count";
    rdfs:range xsd:integer.
fin-orders:sourceIntentVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "section-5.8 framed IRI-set digest over the sorted unique exact source OrderIntent versions, used for verifying the integrity and consistency of the lineage source endpoint set";
    rdfs:label "source intent version-set digest";
    rdfs:range xsd:string.
fin-orders:sourceOrderKey a owl:DatatypeProperty;
    rdfs:comment "non-negative normalized provider ordering key unique within one event stream, used for determining the occurrence order of events within that stream";
    rdfs:label "source order key";
    rdfs:range xsd:integer.
fin-orders:sourceRecordDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest value of the exact canonical provider record bytes, used for verifying the content integrity of the evaluated record";
    rdfs:label "source record digest";
    rdfs:range xsd:string.
fin-orders:sourceRecordRef a owl:DatatypeProperty;
    rdfs:comment "immutable URI reference to the exact provider record evaluated, used for locating the original record that was determined";
    rdfs:label "source record reference";
    rdfs:range xsd:anyURI.
fin-orders:statusMappingVersion a owl:DatatypeProperty;
    rdfs:comment "immutable semantic version string of one provider status mapping, used for fixing the version of a mapping decision";
    rdfs:label "status mapping version";
    rdfs:range xsd:string.
fin-orders:statusVocabularyId a owl:DatatypeProperty;
    rdfs:comment "provider-scoped stable string identifier of an external status vocabulary, used for providing the logical identity primary key of a status vocabulary";
    rdfs:label "status vocabulary identifier";
    rdfs:range xsd:string.
fin-orders:statusVocabularyProvider a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an external status vocabulary to its logical publishing Party, used for identifying the provider that publishes the raw status-code vocabulary";
    rdfs:domain fin-orders:ExternalOrderStatusVocabulary;
    rdfs:label "status vocabulary provider";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-orders:streamExternalOrder a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an OrderEventStream to its one ExternalOrder logical identity, used for locking the event stream to the single external order it carries";
    rdfs:domain fin-orders:OrderEventStream;
    rdfs:label "stream external order";
    rdfs:range <https://axiolune.ai/ontology/finance/orders-execution/ExternalOrder/LogicalIdentity>.
fin-orders:streamProvider a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from an OrderEventStream to its logical provider Party, used for identifying the execution service provider that supplies the event stream data";
    rdfs:domain fin-orders:OrderEventStream;
    rdfs:label "stream provider";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-orders:timeInForce a owl:ObjectProperty;
    rdfs:comment "reviewed validity duration instruction attribute of an OrderIntent, used for expressing how long the order remains effective in the market";
    rdfs:label "time in force";
    rdfs:range fin-orders:TimeInForce.
fin-orders:toolLockDigest a owl:DatatypeProperty;
    rdfs:comment "SHA-256 digest value of the exact evaluator tool lock bytes, used for verifying the content integrity of the tool lock record";
    rdfs:label "tool lock digest";
    rdfs:range xsd:string.
fin-orders:toolLockRef a owl:DatatypeProperty;
    rdfs:comment "immutable URI reference to the exact evaluator tool lock, used for locating the tool lock record of the evaluation tool in use";
    rdfs:label "tool lock reference";
    rdfs:range xsd:anyURI.
fin-orders:tradeDate a owl:DatatypeProperty;
    rdfs:comment "optional business trade date to which an execution belongs, used for trade-date attribution that may differ from the execution and observation dates";
    rdfs:label "trade date";
    rdfs:range xsd:date.
fin-orders:transitionProfileId a owl:DatatypeProperty;
    rdfs:comment "stable string identifier of a provider lifecycle transition profile, used for providing the logical identity primary key of a transition profile";
    rdfs:label "transition profile identifier";
    rdfs:range xsd:string.
fin-orders:transitionProfileProvider a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relationship from a transition profile to the logical provider whose lifecycle it evaluates, used for identifying the provider whose lifecycle the profile evaluates";
    rdfs:domain fin-orders:OrderTransitionProfile;
    rdfs:label "transition profile provider";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-orders:transitionTable a owl:DatatypeProperty;
    rdfs:comment "declarative fromState × eventKind → toState + condition transition table carried by an OrderTransitionProfile, used to make the profile reviewable without executing the digest-locked evaluator";
    rdfs:label "transition table";
    rdfs:range xsd:string.
fin-orders:triggerPrice a owl:ObjectProperty;
    rdfs:comment "Money trigger required only when the executable profile of the order type demands one, used for setting the activation price condition of a conditional order";
    rdfs:label "trigger price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-orders:triggerPriceBasis a owl:ObjectProperty;
    rdfs:comment "Reviewed internal semantic basis attribute used to observe and evaluate an order trigger, present only when a trigger price is in use, used for specifying which market quote serves as the trigger evaluation basis.";
    rdfs:label "trigger price basis";
    rdfs:range fin-orders:TriggerPriceBasis.
fin-orders:venueTradeId a owl:DatatypeProperty;
    rdfs:comment "optional venue-side trade identifier string assigned by the execution venue, distinct from the provider execution identifier and the match identifier";
    rdfs:label "venue trade identifier";
    rdfs:range xsd:string.
