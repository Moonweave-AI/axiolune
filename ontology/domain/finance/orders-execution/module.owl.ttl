fin-orders:OrderLeg a owl:Class;
    rdfs:comment "An Order Leg is an optional single-leg component of a multi-leg order intent, used as an extension point for multi-leg instruments (FX swap, strategies) whose full multi-leg semantics are completed via a cross-module follow-up gated on the instruments QuotationConvention (ADR-021). In v1.1.0 a single-instrument order carries no OrderLeg and remains described directly on the OrderIntent.";
    rdfs:label "Order Leg";
    rdfs:subClassOf _:r_1571eb9c243a6053db23a7c8, _:r_680ce4bd29939a79e0b5b6dc, _:r_8182c28eb8931d777ba49712, _:r_818c208e317782adde620209, _:r_be58d0e47082c4c5553a393f, _:r_d61a4209fd37aa03bac860ef, _:r_d7df869547d85d5e33ad3a3f, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
