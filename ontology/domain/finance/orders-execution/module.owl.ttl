fin-orders:OrderIntentLifecycleEvent a owl:Class;
    rdfs:comment "An Order Intent Lifecycle Event is an immutable internal lifecycle event bound to an exact OrderIntent version but not to any ExternalOrder or OrderEventStream, used to record pre-submission internal transitions such as intent initialization, pre-submission denial, internal emulation, and emulated-order release before a provider order exists. It shares the OrderEventKind and OrderLifecycleState vocabularies with the external OrderLifecycleEvent but does not carry provider event identifiers, source order keys, raw provider status codes, or applied provider mappings.";
    rdfs:label "Order Intent Lifecycle Event";
    rdfs:subClassOf _:r_030032bedbb3f0ecc493936f, _:r_31ea4e288cbbe25fd0d67012, _:r_42ab567e19088d1bd8371860, _:r_4c4ff06c1cf6873a653c4bbf, _:r_537adce6848642a4a4d23535, _:r_5930f7629a325eeed2113b11, _:r_67369c5c1081bd75808441a5, _:r_81c8ee8a801bc417f8189d53, _:r_be3e10a97323d5a74971721f, _:r_cfa0c195ecc5df37340cabe2, _:r_d063470dd0ab109328af944c, _:r_e6c21c5c8e7daba82a6bbd52, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
