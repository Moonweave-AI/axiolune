    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-orders:OrderLifecycleEvent a owl:Class;
    rdfs:comment "An External Order Lifecycle Event is an immutable provider event that occurs in one exact event stream version and is bound to an exact ExternalOrder, used for determining its identity and occurrence order from the provider event identifier and source order key, recording the resulting canonical lifecycle state, and tracing the raw provider status code and the exact applied status mapping and transition profile versions. Pre-submission internal lifecycle events (Initialized, Denied, Emulated, Released) that have no provider order or stream are modeled by OrderIntentLifecycleEvent, not by this external event type.";
    rdfs:label "External Order Lifecycle Event";
