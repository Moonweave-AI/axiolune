@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-foundation: <https://axiolune.ai/ontology/finance/foundation/>.

fin-foundation:MonetaryAmountShape a sh:NodeShape;
    sh:targetClass fin-foundation:MonetaryAmount;
    sh:name "Monetary Amount";
    sh:description "structured monetary amount with numeric magnitude, ISO 4217 currency code, and optional scale; financial amounts MUST NOT use bare decimal literals";
    sh:property fin-foundation:MonetaryAmountShape_hasNumericAmount.
fin-foundation:MonetaryAmountShape_hasNumericAmount a sh:PropertyShape;
    sh:path fin-foundation:hasNumericAmount;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:decimal.
fin-foundation:MonetaryAmountShape sh:property fin-foundation:MonetaryAmountShape_hasCurrencyCode.
fin-foundation:MonetaryAmountShape_hasCurrencyCode a sh:PropertyShape;
    sh:path fin-foundation:hasCurrencyCode;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{3}$".
fin-foundation:MonetaryAmountShape sh:property fin-foundation:MonetaryAmountShape_hasScale.
fin-foundation:MonetaryAmountShape_hasScale a sh:PropertyShape;
    sh:path fin-foundation:hasScale;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:integer.
fin-foundation:QuantityValueShape a sh:NodeShape;
    sh:targetClass fin-foundation:QuantityValue;
    sh:name "Quantity Value";
    sh:description "structured measurement with numeric magnitude and unit code; quantities MUST NOT use bare decimal";
    sh:property fin-foundation:QuantityValueShape_hasNumericAmount.
fin-foundation:QuantityValueShape_hasNumericAmount a sh:PropertyShape;
    sh:path fin-foundation:hasNumericAmount;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:decimal.
fin-foundation:QuantityValueShape sh:property fin-foundation:QuantityValueShape_hasUnitCode.
fin-foundation:QuantityValueShape_hasUnitCode a sh:PropertyShape;
    sh:path fin-foundation:hasUnitCode;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-foundation:QuantityValueShape sh:property fin-foundation:QuantityValueShape_hasScale.
fin-foundation:QuantityValueShape_hasScale a sh:PropertyShape;
    sh:path fin-foundation:hasScale;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:integer.
fin-foundation:FinancialIdentifierAssignmentShape a sh:NodeShape;
    sh:targetClass fin-foundation:FinancialIdentifierAssignment;
    sh:name "Financial Identifier Assignment";
    sh:description "association binding an identifier value of a declared identifier type to a party or instrument under an issuing authority and effective interval";
    sh:property fin-foundation:FinancialIdentifierAssignmentShape_hasPrimaryIdentifier.
fin-foundation:FinancialIdentifierAssignmentShape_hasPrimaryIdentifier a sh:PropertyShape;
    sh:path fin-foundation:hasPrimaryIdentifier;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_assignsIdentifier.
fin-foundation:FinancialIdentifierAssignmentShape_assignsIdentifier a sh:PropertyShape;
    sh:path fin-foundation:assignsIdentifier;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-foundation:Party.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_identifiesSubject.
fin-foundation:FinancialIdentifierAssignmentShape_identifiesSubject a sh:PropertyShape;
    sh:path fin-foundation:identifiesSubject;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-foundation:Party.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_validFrom.
fin-foundation:FinancialIdentifierAssignmentShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_knowledgeFrom.
fin-foundation:FinancialIdentifierAssignmentShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_availableFrom.
fin-foundation:FinancialIdentifierAssignmentShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_validTo.
fin-foundation:FinancialIdentifierAssignmentShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_knowledgeTo.
fin-foundation:FinancialIdentifierAssignmentShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_availableTo.
fin-foundation:FinancialIdentifierAssignmentShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:sparql _:sparql_valid_FinancialIdentifierAssignment.
_:sparql_valid_FinancialIdentifierAssignment sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-foundation:FinancialIdentifierAssignmentShape sh:sparql _:sparql_knowledge_FinancialIdentifierAssignment.
_:sparql_knowledge_FinancialIdentifierAssignment sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-foundation:FinancialIdentifierAssignmentShape sh:sparql _:sparql_available_FinancialIdentifierAssignment.
_:sparql_available_FinancialIdentifierAssignment sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_source.
fin-foundation:FinancialIdentifierAssignmentShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
fin-foundation:hasCurrencyCodeShape a sh:PropertyShape;
    sh:path fin-foundation:hasCurrencyCode;
    sh:pattern "^[A-Z]{3}$";
    sh:datatype xsd:string;
    sh:name "Has Currency Code".
fin-foundation:PartyShape a sh:NodeShape;
    sh:targetClass fin-foundation:Party;
    sh:name "Party";
    sh:description "autonomous agent that can participate in legal or financial relationships, including natural persons and legal entities".
fin-foundation:LegalEntityShape a sh:NodeShape;
    sh:targetClass fin-foundation:LegalEntity;
    sh:name "Legal Entity";
    sh:description "organization that is legally or financially responsible for the performance of financial transactions and is capable of accruing liability on its own part, excluding natural persons but including governments and supranational entities";
    sh:property fin-foundation:LegalEntityShape_hasLegalName.
fin-foundation:LegalEntityShape_hasLegalName a sh:PropertyShape;
    sh:path fin-foundation:hasLegalName;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-foundation:CurrencyShape a sh:NodeShape;
    sh:targetClass fin-foundation:Currency;
    sh:name "Currency";
    sh:description "medium of exchange value defined by reference to the geographical location of the monetary authorities responsible for it, as specified in ISO 4217";
    sh:property fin-foundation:CurrencyShape_hasCurrencyCode.
fin-foundation:CurrencyShape_hasCurrencyCode a sh:PropertyShape;
    sh:path fin-foundation:hasCurrencyCode;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{3}$".
fin-foundation:JurisdictionShape a sh:NodeShape;
    sh:targetClass fin-foundation:Jurisdiction;
    sh:name "Jurisdiction";
    sh:description "legal authority that has the power to make and enforce rules of conduct within a defined geographical or functional scope".
fin-foundation:ISINPatternShape a sh:NodeShape;
    sh:targetClass fin-foundation:ISIN;
    sh:property fin-foundation:ISINPatternShape_value.
fin-foundation:ISINPatternShape_value a sh:PropertyShape;
    sh:path fin-foundation:ISIN;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{2}[A-Z0-9]{9}[0-9]$";
    sh:name "International Securities Identification Number".
fin-foundation:LEIPatternShape a sh:NodeShape;
    sh:targetClass fin-foundation:LEI;
    sh:property fin-foundation:LEIPatternShape_value.
fin-foundation:LEIPatternShape_value a sh:PropertyShape;
    sh:path fin-foundation:LEI;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z0-9]{18}[0-9]{2}$";
    sh:name "Legal Entity Identifier".
fin-foundation:MICPatternShape a sh:NodeShape;
    sh:targetClass fin-foundation:MIC;
    sh:property fin-foundation:MICPatternShape_value.
fin-foundation:MICPatternShape_value a sh:PropertyShape;
    sh:path fin-foundation:MIC;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{4}([A-Z]{4})?$";
    sh:name "Market Identifier Code".
