fin-foundation:FinancialAccountPartyRoleShape a sh:NodeShape;
    sh:description "temporal and provenanced sole truth that assigns one reviewed account role to a Party for a FinancialAccount. Logical identity is exactly (account logical IRI, party logical IRI, role member). It is the only stored account/party truth; direct hasAccountHolder, hasBeneficialOwner, authorizedOperator, or custodian edges are derived views and are prohibited as independent facts.";
    sh:name "Financial Account Party Role";
    sh:property <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/attribute/a9ccf7187fcf01fea467c37b>, <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/participant-role-roleAccount/97d85a8fed9277dea24b6d82>, <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/participant-role-roleParty/9726db863c7019a424555619>, <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/foundation/FinancialAccountPartyRole/shape/temporal/f0f2f601393d100a35dc2429>;
