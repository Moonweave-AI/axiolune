fin-foundation:FinancialIdentifierAssignmentShape a sh:NodeShape;
    sh:description "authority-scoped temporal fact assigning exactly one governed IdentifierValue version to exactly one subject version. Logical identity is (assigning-authority logical IRI, assignmentId); the standard version key is (validFrom, knowledgeFrom, availableFrom, revision). The exact scheme version is evidence, not an independent scheme truth: its versionOf must equal the IdentifierValue's scheme logical IRI and be PIT-eligible. An active assigningAuthority authorization must cover the assignment valid interval. hasPrimaryIdentifier is prohibited; convenience identifier properties are derived views only.";
    sh:name "Financial Identifier Assignment";
    sh:property <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/attribute/fc93fc4c0ea3c192fc119bdd>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/participant-role-assigningAuthorityVersion/02c2929fe8540bd1dfeb46c7>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/participant-role-identifiedSubjectVersion/b14a18c9e0368060ea8336f0>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/participant-role-identifierSchemeVersion/d9e597fdca668a72917e5b94>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/participant-role-identifierValueVersion/90c1c3bcb21ef3805a00fa40>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/foundation/FinancialIdentifierAssignment/shape/temporal/f0f2f601393d100a35dc2429>;
