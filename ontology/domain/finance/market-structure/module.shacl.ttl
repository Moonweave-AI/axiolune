fin-market-structure:MarketSegmentShape a sh:NodeShape;
    sh:description "Market Segment, is a section or component of an operating market infrastructure entity (a trading venue or a trade reporting facility), modeled as a TradingFacility subtype for shared reference range but carrying its part-of semantics through the componentOf relation, used to characterize a subdomain divided by instrument type, regulation, or reporting section within the parent entity. The MarketSegment is a section, not an independent facility; it belongs to exactly one operating entity identified by the segment's marketSegmentVenue or componentOf relation.";
    sh:name "Market Segment";
    sh:property <https://axiolune.ai/ontology/finance/market-structure/MarketSegment/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-structure/MarketSegment/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-structure/MarketSegment/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/market-structure/MarketSegment/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/market-structure/MarketSegment/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/market-structure/MarketSegment/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/market-structure/MarketSegment/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/market-structure/MarketSegment/shape/temporal/f0f2f601393d100a35dc2429>;
