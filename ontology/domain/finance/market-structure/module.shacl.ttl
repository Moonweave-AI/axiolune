fin-market-structure:TradingVenueShape a sh:NodeShape;
    sh:description "Trading Venue, is a trading facility that constitutes, maintains, or provides a market system on which financial instruments may be admitted to trading, used to identify a market system or venue (a regulated market, multilateral trading facility, organized trading facility, or comparable trading platform) distinct from the legal entity that operates it. The operator and the regulatory category of the venue are modeled separately as temporal, evidenced facts via VenueOperation rather than as part of the venue identity.";
    sh:name "Trading Venue";
    sh:property <https://axiolune.ai/ontology/finance/market-structure/TradingVenue/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-structure/TradingVenue/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-structure/TradingVenue/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/market-structure/TradingVenue/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/market-structure/TradingVenue/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/market-structure/TradingVenue/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/market-structure/TradingVenue/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/market-structure/TradingVenue/shape/temporal/f0f2f601393d100a35dc2429>;
