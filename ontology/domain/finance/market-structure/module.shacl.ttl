fin-market-structure:MICRegistryEntryShape a sh:NodeShape;
    sh:description "MIC Registry Entry, is a timestamped minimal MIC identity slice that binds a four-character MIC value and its entry kind to the exact market infrastructure version identified by that registry record, used to anchor the registration record to the underlying facility version. The entry carries optional ISO 10383 lifecycle fields (operational status, effective/expiry dates, replacement, market category) when available; it is an identity anchor, not a full ISO 10383 registry mirror.";
    sh:name "MIC Registry Entry";
    sh:property <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/attribute/008edbca89eeb9ebb7814d75>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/attribute/06fb2952ab03ce2940e32f13>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/attribute/4069bf26382f6217fa1dc156>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/attribute/5024f065b827449a7e663951>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/attribute/f94e305424b7f7b1678dc085>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/market-structure/MICRegistryEntry/shape/temporal/f0f2f601393d100a35dc2429>;
