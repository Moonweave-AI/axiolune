<https://axiolune.ai/ontology/finance/market-structure/OTCTradingContextContract/shape> a sh:NodeShape;
    sh:message "OTC counterparties must be absent together or present as two distinct exact-version IRIs in lexical order";
    sh:severity sh:Violation;
    sh:sparql <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContextContract/shape/sparql>;
    sh:targetClass fin-market-structure:OTCTradingContext.
<https://axiolune.ai/ontology/finance/market-structure/OTCTradingContextContract/shape/sparql> a sh:SPARQLConstraint;
    sh:message "OTC counterparties must be absent together or present as two distinct exact-version IRIs in lexical order";
    sh:select "SELECT $this ?path\nWHERE {\n  OPTIONAL { $this <https://axiolune.ai/ontology/finance/market-structure/otcCounterpartyA> ?counterpartyA . }\n  OPTIONAL { $this <https://axiolune.ai/ontology/finance/market-structure/otcCounterpartyB> ?counterpartyB . }\n  BIND(<https://axiolune.ai/ontology/finance/market-structure/otcCounterpartyA> AS ?path)\n  FILTER (\n    (BOUND(?counterpartyA) && !BOUND(?counterpartyB))\n    || (!BOUND(?counterpartyA) && BOUND(?counterpartyB))\n    || (BOUND(?counterpartyA) && BOUND(?counterpartyB)\n        && STR(?counterpartyA) >= STR(?counterpartyB))\n  )\n}".
fin-market-structure:OTCTradingContextShape a sh:NodeShape;
    sh:description "OTC Trading Context, is a non-listing trading context whose logical identity is determined by the source-provider logical IRI, the immutable source-contract IRI, and a provider-scoped context identifier, used to characterize the market-convention environment for over-the-counter quotes and executions. This type is deprecated as of v1.1.0 because it mixes provider source contract, quote/settlement currency, reporting facility, concrete counterparty pair, and execution semantics that are not stable market structure; it is replaced by NonVenueMarketContext for the stable non-venue structure, while the provider contract moves to Layer 4, currencies/convention to instruments, and counterparty/execution/reporting to orders-execution or post-trade-operations. The type is retained for IRI stability because market-data, instruments, and orders-execution reference it as an association range; its cross-module migration is deferred to a follow-up ADR.";
    sh:name "OTC Trading Context";
    sh:property <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/attribute/2758bd88143fc161619a5a74>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/attribute/371f3ba2f418261b740db700>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/attribute/cec2d8d16062f3122b7679aa>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/attribute/e0647b14d1492dfbb6521d9c>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext/shape/temporal/f0f2f601393d100a35dc2429>;
