fin-market-structure:VenueOperationShape a sh:NodeShape;
    sh:description "Venue Operation, is a temporal provenance-bearing association that records one logical Party operating one logical TradingVenue over a validity interval together with an optional regulatory venue category, used to separate the market system/venue from the legal entity that operates it and to model operator history without conflating venue identity with its operator.";
    sh:name "Venue Operation";
    sh:property <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/attribute/244cc834c9cfda45f70eda06>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/attribute/724191dc4daf9f928492a9f6>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/attribute/7f1cdb2c3ae72bcf072ae5e8>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/participant-role-operatedVenue/3a52187eb4e4247fa90c8804>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/participant-role-operatingParty/72618c640f15727e5bacc122>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/market-structure/VenueOperation/shape/temporal/f0f2f601393d100a35dc2429>;
