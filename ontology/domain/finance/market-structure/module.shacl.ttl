fin-market-structure:NonVenueMarketContextShape a sh:NodeShape;
    sh:description "Non-Venue Market Context, is a stable non-venue market context that characterizes the market-convention orientation of over-the-counter quoting without carrying provider source contracts, concrete currencies, counterparty pairs, or execution/reporting semantics, used to express only the stable structure that belongs in market-structure. Its logical identity is determined by the non-venue context identity and its market-convention orientation; provider attribution is a logical reference to a Party. Provider contract and source mapping belong to Layer 4, currencies and quotation convention to instruments, and counterparty/execution/reporting to orders-execution or post-trade-operations.";
    sh:name "Non-Venue Market Context";
    sh:property <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/attribute/371f3ba2f418261b740db700>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/attribute/cec2d8d16062f3122b7679aa>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/shape/temporal/f0f2f601393d100a35dc2429>;
