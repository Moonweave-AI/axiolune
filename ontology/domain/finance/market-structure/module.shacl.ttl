fin-market-structure:TradingSessionOccurrenceShape a sh:NodeShape;
    sh:description "Trading Session Occurrence, is a dated scheduled session window materialized from one exact session template and calendar version for one exact facility version and represented as a UTC half-open interval, used to denote a concrete scheduled time window. Whether the window is effectively tradable is a derived result expressed by the optional effectiveSessionStartUtc and effectiveSessionEndUtc attributes after applying any TradingScheduleOverrideNotice facts; a window removed by a holiday or closure has no effective tradable interval rather than losing its scheduled identity.";
    sh:name "Trading Session Occurrence";
    sh:property <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/attribute/32a5bdde575980ff20870924>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/attribute/40cc3ef216e97241b1225771>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/attribute/8fd539a12925bc301ec457cc>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/attribute/a32c5f1de3e7c18e29838076>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/attribute/b6208d1c15681d18f5661933>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence/shape/temporal/f0f2f601393d100a35dc2429>;
