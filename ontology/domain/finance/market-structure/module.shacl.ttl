fin-market-structure:TradingCalendarShape a sh:NodeShape;
    sh:description "Trading Calendar, is an immutable calendar version maintained by an authority for one trading facility, jurisdiction, and IANA time zone, used to characterize the trading-day and non-trading-day arrangements of that facility under a specific time zone. It is the concrete specialization of the foundation BusinessCalendar interface for a trading facility and pins an optional IANA tzdb release together with a DST overlap policy for deterministic local-to-UTC materialization.";
    sh:name "Trading Calendar";
    sh:property <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/attribute/4bc1663f96034b9b26b79e9a>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/attribute/5049d22fe71fcf345d148706>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/attribute/53cd4b5696b4401c84d9092a>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/attribute/91a1566cba40709f52ecdb74>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar/shape/temporal/f0f2f601393d100a35dc2429>;
