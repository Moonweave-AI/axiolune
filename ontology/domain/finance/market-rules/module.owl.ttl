    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-rules/SelectionOutcomeKind/value/noApplicableRule> a owl:NamedIndividual, skos:Concept, fin-market-rules:SelectionOutcomeKind;
