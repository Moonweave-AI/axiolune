    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-rules/ScopeExpressionForm/value/conjunction> a owl:NamedIndividual, skos:Concept, fin-market-rules:ScopeExpressionForm;
    rdfs:comment "all scope terms must match";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-rules/ScopeExpressionForm/scheme>;
    skos:notation "conjunction";
    skos:prefLabel "Conjunction";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-rules/ScopeExpressionForm/value/disjunction> a owl:NamedIndividual, skos:Concept, fin-market-rules:ScopeExpressionForm;
    rdfs:comment "at least one scope term must match";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-rules/ScopeExpressionForm/scheme>;
    skos:notation "disjunction";
