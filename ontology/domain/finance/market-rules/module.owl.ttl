    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-market-rules:SettlementCycleClause a owl:Class;
    rdfs:comment "Settlement Cycle Clause, is a rule clause that carries a non-negative business-day quantity from the trade date to the contractual settlement date, used for specifying the settlement cycle and distinct from any resale restriction.";
    rdfs:label "Settlement Cycle Clause";
    rdfs:subClassOf _:r_15b36d2298d8ebd05aaa144c, _:r_7005fbfcf7be9167d5d2cc63, _:r_a045247b3bce9ab60577a357, _:r_a41b21aa98ddc818ca6922bd, _:r_fa25a1b9dd19dc57e651b5b5, fin-market-rules:RuleClause, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-rules/SettlementCycleClause/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Settlement Cycle Clause versions.";
    rdfs:label "Settlement Cycle Clause logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-rules:SettlementCycleRule a owl:Class;
    rdfs:comment "Settlement Cycle Rule, is a market rule whose executable settlement clauses are exclusively settlement-cycle clauses, used for determining the business-day offset from trade date to contractual settlement date.";
    rdfs:label "Settlement Cycle Rule";
    rdfs:subClassOf _:r_18db97cb45312ed555872f68, _:r_bddbedfcf1f7d1d8b2741424, fin-market-rules:MarketRule, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-rules/SettlementCycleRule/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Settlement Cycle Rule versions.";
    rdfs:label "Settlement Cycle Rule logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-rules:TickScheduleRule a owl:Class;
    rdfs:comment "Tick Schedule Rule, is a market rule whose ordered non-overlapping clauses are exclusively tick-size clauses, used for arranging minimum quoting steps by price range.";
    rdfs:label "Tick Schedule Rule";
    rdfs:subClassOf _:r_33bc432a10dc112ed3cb38bc, _:r_69fd326baa455add09137e8c, fin-market-rules:MarketRule, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-rules/TickScheduleRule/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Tick Schedule Rule versions.";
    rdfs:label "Tick Schedule Rule logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-rules:TickSizeClause a owl:Class;
    rdfs:comment "Tick Size Clause, is an ordered rule clause that supplies a single positive price-increment quantity, used for specifying the minimum quoting step within a non-overlapping quoting range.";
    rdfs:label "Tick Size Clause";
    rdfs:subClassOf _:r_078c8a9a8457e097ffd516cf, _:r_4900692ec2e239728a5f6827, _:r_a8f8e9c28086b730a99edf2a, fin-market-rules:RuleClause, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-rules/TickSizeClause/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Tick Size Clause versions.";
    rdfs:label "Tick Size Clause logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-rules:TriggerClause a owl:Class;
    rdfs:comment "TriggerClause, is a rule clause that carries a trigger condition and an effect rather than an input range, used for clauses such as circuit breakers where a monitored value crossing a threshold produces a market effect. Trigger clauses do not require range bounds or endpoint inclusivity.";
    rdfs:label "Trigger Clause";
    rdfs:subClassOf _:r_4fbb4682892a8f9b5844ae96, _:r_a57aa45dd0f44997df5a7218, fin-market-rules:RuleClause, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-rules/TriggerClause/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Trigger Clause versions.";
    rdfs:label "Trigger Clause logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-rules:UnsupportedSelection a owl:Class;
    rdfs:comment "Unsupported Selection, is a rule selection outcome emitted when the request targets a rule kind or clause shape the executable profile does not support, used for distinguishing an unsupported request from a coverage gap or a conflict.";
    rdfs:label "Unsupported Selection";
    rdfs:subClassOf _:r_2152d6eb8d33c35d75ecfb2d, _:r_4fafb01bf1b1d64f176c1ebe, _:r_5f3e52a1e4650bcea1b251ef, fin-market-rules:RuleSelectionOutcome, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-rules/UnsupportedSelection/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Unsupported Selection versions.";
    rdfs:label "Unsupported Selection logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-rules:applicabilityAccountType a owl:ObjectProperty;
    rdfs:comment "Applicability Account Type, is the optional foundation account-type member explicitly scoped by a rule applicability, used for restricting a rule's applicability scope to a specific account type.";
    rdfs:label "Applicability Account Type";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/AccountType>.
fin-market-rules:applicabilityInvestorCategory a owl:ObjectProperty;
    rdfs:comment "Applicability Investor Category, is the optional investor-category member explicitly scoped by a rule applicability, used for restricting a rule's applicability scope to a specific investor category distinct from account type.";
    rdfs:label "Applicability Investor Category";
    rdfs:range fin-market-rules:InvestorCategory.
fin-market-rules:applicabilityMarketModel a owl:ObjectProperty;
    rdfs:comment "Applicability Market Model, is the optional market-model member explicitly scoped by a rule applicability, used for restricting a rule's applicability scope to a specific market model (continuous, auction, dark).";
    rdfs:label "Applicability Market Model";
    rdfs:range fin-market-rules:MarketModel.
fin-market-rules:applicabilityOrderSide a owl:ObjectProperty;
    rdfs:comment "Applicability Order Side, is the optional order-side member explicitly scoped by a rule applicability, used for restricting a rule's applicability scope to buy, sell, or both.";
    rdfs:label "Applicability Order Side";
    rdfs:range fin-market-rules:OrderSide.
fin-market-rules:applicabilityOrderType a owl:ObjectProperty;
    rdfs:comment "Applicability Order Type, is the optional order-type member explicitly scoped by a rule applicability, used for restricting a rule's applicability scope to a specific order type.";
    rdfs:label "Applicability Order Type";
    rdfs:range fin-market-rules:OrderType.
fin-market-rules:applicabilityPriority a owl:DatatypeProperty;
    rdfs:comment "Applicability Priority, is a numeric priority comparable only within one rule-set version, authoritative source, and byte-identical normalized scope, used for ranking comparable candidates and not substituting for cross-authority precedence.";
    rdfs:label "Applicability Priority";
    rdfs:range xsd:integer.
fin-market-rules:asOfAvailable a owl:DatatypeProperty;
    rdfs:comment "As-of Availability Time, is the explicit availability-time point-in-time pivot of a rule-evaluation request, used for specifying the point at which data reachability is interpreted by availability time.";
    rdfs:label "As-of Availability Time";
    rdfs:range xsd:dateTimeStamp.
fin-market-rules:asOfKnowledge a owl:DatatypeProperty;
    rdfs:comment "As-of Knowledge Time, is the explicit knowledge-time point-in-time pivot of a rule-evaluation request, used for specifying the point at which available knowledge is interpreted by knowledge time.";
    rdfs:label "As-of Knowledge Time";
    rdfs:range xsd:dateTimeStamp.
fin-market-rules:asOfValid a owl:DatatypeProperty;
    rdfs:comment "As-of Valid Time, is the explicit valid-time point-in-time pivot of a rule-evaluation request, used for specifying the point at which rules and scope are interpreted by valid time.";
    rdfs:label "As-of Valid Time";
    rdfs:range xsd:dateTimeStamp.
fin-market-rules:candidateApplicabilitySetDigest a owl:DatatypeProperty;
    rdfs:comment "Candidate Applicability Set Digest, is the framed digest of the ordered exact applicability-version IRI set that forms a rule-conflict identity, used for locking the candidate set involved in the conflict.";
    rdfs:label "Candidate Applicability Set Digest";
    rdfs:range xsd:string.
fin-market-rules:circuitBreakerDirection a owl:ObjectProperty;
    rdfs:comment "Circuit Breaker Direction, is the reviewed direction member stating whether the breaker triggers on a downward move, an upward move, or either, used for distinguishing downside halts from upside halts.";
    rdfs:label "Circuit Breaker Direction";
    rdfs:range fin-market-rules:CircuitBreakerDirection.
fin-market-rules:circuitBreakerHaltDuration a owl:ObjectProperty;
    rdfs:comment "Circuit Breaker Halt Duration, is the non-negative duration quantity applied after a circuit-breaker threshold is met, used for specifying the duration of the market halt.";
    rdfs:label "Circuit Breaker Halt Duration";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:circuitBreakerMonitor a owl:ObjectProperty;
    rdfs:comment "Circuit Breaker Monitor, is the reviewed monitor member identifying the observed value that triggers the breaker (index level, single-security price, percentage move), used for making the trigger object explicit.";
    rdfs:label "Circuit Breaker Monitor";
    rdfs:range fin-market-rules:CircuitBreakerMonitor.
fin-market-rules:circuitBreakerReferencePrice a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Circuit Breaker Reference Price, is the direct reference from a circuit-breaker rule to its exact ReferencePriceSpecification fact version, used for making the breaker threshold computable relative to a reference price.";
    rdfs:domain fin-market-rules:CircuitBreakerRule;
    rdfs:label "Circuit Breaker Reference Price";
    rdfs:range fin-market-rules:ReferencePriceSpecification.
fin-market-rules:circuitBreakerResumeMechanism a owl:ObjectProperty;
    rdfs:comment "Circuit Breaker Resume Mechanism, is the reviewed resume member identifying how trading resumes after a halt (manual, timed, opening auction, price-band), used for making resume behavior explicit.";
    rdfs:label "Circuit Breaker Resume Mechanism";
    rdfs:range fin-market-rules:CircuitBreakerResumeMechanism.
fin-market-rules:circuitBreakerThreshold a owl:ObjectProperty;
    rdfs:comment "Circuit Breaker Threshold, is the positive dimensionless trigger-threshold quantity in a circuit-breaker clause that triggers a temporary market halt, used for specifying the volatility magnitude that triggers the breaker.";
    rdfs:label "Circuit Breaker Threshold";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:circuitBreakerTier a owl:DatatypeProperty;
    rdfs:comment "Circuit Breaker Tier, is the optional non-negative tier number for multi-level breakers, used for arranging tiered halts such as 7/13/20 percent market-wide circuit breakers.";
    rdfs:label "Circuit Breaker Tier";
    rdfs:range xsd:integer.
fin-market-rules:circuitBreakerTriggerCount a owl:DatatypeProperty;
    rdfs:comment "Circuit Breaker Trigger Count, is the optional non-negative number of threshold touches required before the halt is applied, used for breakers that require repeated touches rather than a single crossing.";
    rdfs:label "Circuit Breaker Trigger Count";
    rdfs:range xsd:integer.
fin-market-rules:clauseLowerBound a owl:ObjectProperty;
    rdfs:comment "Clause Lower Bound, is the optional typed quantity lower bound of a clause's ordered input range, used for marking the start of the clause's effective range.";
    rdfs:label "Clause Lower Bound";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:clauseLowerInclusive a owl:DatatypeProperty;
    rdfs:comment "Clause Lower Inclusive, is a Boolean value stating whether a given lower bound belongs to the clause's half-open or closed input range, used for precisely defining the endpoint inclusion of the range.";
    rdfs:label "Clause Lower Inclusive";
    rdfs:range xsd:boolean.
fin-market-rules:clauseOwnerRule a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Clause Owner Rule, is the functional inverse of ruleHasClause that binds each rule clause to its exact one owning market-rule version, used for enforcing that a clause has exactly one owner rule and is never shared across rules.";
    rdfs:domain fin-market-rules:RuleClause;
    rdfs:label "Clause Owner Rule";
    rdfs:range fin-market-rules:MarketRule.
fin-market-rules:clauseSequence a owl:DatatypeProperty;
    rdfs:comment "Clause Sequence, is the zero-based non-negative ordering number of a rule clause within one rule version, used for establishing the ordered execution order of clauses.";
    rdfs:label "Clause Sequence";
    rdfs:range xsd:integer.
fin-market-rules:clauseUpperBound a owl:ObjectProperty;
    rdfs:comment "Clause Upper Bound, is the optional typed quantity upper bound of a clause's ordered input range, used for marking the end of the clause's effective range.";
    rdfs:label "Clause Upper Bound";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:clauseUpperInclusive a owl:DatatypeProperty;
    rdfs:comment "Clause Upper Inclusive, is a Boolean value stating whether a given upper bound belongs to the clause's open or closed input range, used for precisely defining the endpoint inclusion of the range.";
    rdfs:label "Clause Upper Inclusive";
    rdfs:range xsd:boolean.
fin-market-rules:corporateActionDistributionAssessmentMethod a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Corporate Action Distribution Assessment Method Relation, is an exact reviewed method version bound if and only if a corporate-action schedule rule authors a percentage interval, used for locking the distribution-percentage calculation method for a candidate schedule.";
    rdfs:domain fin-market-rules:CorporateActionScheduleRule;
    rdfs:label "Corporate Action Distribution Assessment Method";
    rdfs:range fin-market-rules:CorporateActionDistributionAssessmentMethod.
fin-market-rules:corporateActionEntitlementMode a owl:ObjectProperty;
    rdfs:comment "Corporate Action Entitlement Mode, is the exact entitlement mode selected by a schedule rule's sole entitlement clause, used for deciding whether entitlement ownership is computed by ordinary record position or due-bill adjustment.";
    rdfs:label "Corporate Action Entitlement Mode";
    rdfs:range fin-market-rules:CorporateActionEntitlementMode.
fin-market-rules:corporateActionKind a owl:ObjectProperty;
    rdfs:comment "Corporate Action Kind, is the reviewed corporate-action kind member selected by a corporate-action schedule rule, used for distinguishing the class of corporate action the schedule targets.";
    rdfs:label "Corporate Action Kind";
    rdfs:range fin-market-rules:CorporateActionKind.
fin-market-rules:cumEntitlementTradeEndOffset a owl:ObjectProperty;
    rdfs:comment "Cum-entitlement Trade End Offset, is the signed business-day quantity used in due-bill mode to resolve the exclusive end of the cum-entitlement trade interval, used for determining the end time of cum-entitlement trading.";
    rdfs:label "Cum-entitlement Trade End Offset";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:cumEntitlementTradeStartOffset a owl:ObjectProperty;
    rdfs:comment "Cum-entitlement Trade Start Offset, is the signed business-day quantity used in due-bill mode to resolve the inclusive start of the cum-entitlement trade interval, used for determining the start time of cum-entitlement trading.";
    rdfs:label "Cum-entitlement Trade Start Offset";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:dateBusinessDayAdjustment a owl:ObjectProperty;
    rdfs:comment "Corporate Action Date Business-day Adjustment, is the explicit adjustment rule applied when the offset result is not a business day, used for normalizing a candidate date onto a valid business day.";
    rdfs:label "Corporate Action Date Business-day Adjustment";
    rdfs:range fin-market-rules:CorporateActionBusinessDayAdjustment.
fin-market-rules:dateOrderingOperator a owl:ObjectProperty;
    rdfs:comment "Corporate Action Date Ordering Operator, is the exact ordering relation applied between two resolved date roles, used for expressing the before/after constraint between dates within a schedule.";
    rdfs:label "Corporate Action Date Ordering Operator";
    rdfs:range fin-market-rules:CorporateActionDateOrderingOperator.
fin-market-rules:dateResolutionOffset a owl:ObjectProperty;
    rdfs:comment "Corporate Action Date Resolution Offset, is the signed business-day quantity applied before the explicit adjustment convention, used for computing an event date into a candidate resolved date.";
    rdfs:label "Corporate Action Date Resolution Offset";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:distributionAssessmentFormulaDigest a owl:DatatypeProperty;
    rdfs:comment "Distribution Assessment Formula Digest, is the SHA-256 digest of the exact canonical calculation formula, used for freezing the method's calculation formula for audit.";
    rdfs:label "Distribution Assessment Formula Digest";
    rdfs:range xsd:string.
fin-market-rules:distributionAssessmentImplementationDigest a owl:DatatypeProperty;
    rdfs:comment "Distribution Assessment Implementation Digest, is the SHA-256 digest of the exact executable method implementation, used for freezing the method's implementation for audit.";
    rdfs:label "Distribution Assessment Implementation Digest";
    rdfs:range xsd:string.
fin-market-rules:distributionAssessmentInputKind a owl:ObjectProperty;
    rdfs:comment "Distribution Assessment Input Kind, is the exact calculation or official-authority input branch accepted by this reviewed method, used for locking the input source of the distribution-percentage calculation.";
    rdfs:label "Distribution Assessment Input Kind";
    rdfs:range fin-market-rules:CorporateActionDistributionAssessmentInputKind.
fin-market-rules:distributionAssessmentMethodAuthority a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Distribution Assessment Method Authority, is a reference to the exact party fact version that maintains one reviewed distribution-assessment method version, used for declaring the publishing authority and accountability of the method.";
    rdfs:domain fin-market-rules:CorporateActionDistributionAssessmentMethod;
    rdfs:label "Distribution Assessment Method Authority";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
fin-market-rules:distributionAssessmentMethodId a owl:DatatypeProperty;
    rdfs:comment "Distribution Assessment Method Identifier, is the non-empty method identifier unique within the logical method-authority scope, used for identifying one assessment method.";
    rdfs:label "Distribution Assessment Method Identifier";
    rdfs:range xsd:string.
fin-market-rules:distributionAssessmentPrecision a owl:DatatypeProperty;
    rdfs:comment "Distribution Assessment Precision, is the non-negative decimal precision used by the reviewed percentage calculation, used for specifying the number of decimal places in the calculation result.";
    rdfs:label "Distribution Assessment Precision";
    rdfs:range xsd:integer.
fin-market-rules:distributionAssessmentPriceSelection a owl:ObjectProperty;
    rdfs:comment "Distribution Assessment Price Selection, is the exact price-selection function frozen by this reviewed method, used for specifying how to select a reference price and required to be marked notApplicable when market price is not consumed.";
    rdfs:label "Distribution Assessment Price Selection";
    rdfs:range fin-market-rules:CorporateActionPriceSelectionFunction.
fin-market-rules:distributionAssessmentRequiredPriceKindIri a owl:DatatypeProperty;
    rdfs:comment "Distribution Assessment Required Price Kind IRI, is the absolute IRI of the market-data price-kind member required when market price is consumed, used for referencing a price type without importing the downstream module.";
    rdfs:label "Distribution Assessment Required Price Kind IRI";
    rdfs:range xsd:string.
fin-market-rules:distributionAssessmentRequiresMarketPrice a owl:DatatypeProperty;
    rdfs:comment "Distribution Assessment Requires Market Price, is the explicit Boolean that decides whether one point-in-time-eligible affected-security price observation is required, used for declaring whether the method consumes market price.";
    rdfs:label "Distribution Assessment Requires Market Price";
    rdfs:range xsd:boolean.
fin-market-rules:distributionAssessmentRoundingMode a owl:DatatypeProperty;
    rdfs:comment "Distribution Assessment Rounding Mode, is the reviewed rounding-mode identifier used after formula evaluation, used for locking the rounding behavior of the calculation result.";
    rdfs:label "Distribution Assessment Rounding Mode";
    rdfs:range xsd:string.
fin-market-rules:distributionPercentageLowerBound a owl:ObjectProperty;
    rdfs:comment "Distribution Percentage Lower Bound, is the optional dimensionless lower bound of the candidate applicability percentage interval, used for limiting the minimum acceptable distribution percentage.";
    rdfs:label "Distribution Percentage Lower Bound";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:distributionPercentageLowerInclusive a owl:DatatypeProperty;
    rdfs:comment "Distribution Percentage Lower Inclusive, is the Boolean value that, given a lower bound, states whether that endpoint is included, used for precisely defining the lower-end membership of the percentage interval.";
    rdfs:label "Distribution Percentage Lower Inclusive";
    rdfs:range xsd:boolean.
fin-market-rules:distributionPercentageUpperBound a owl:ObjectProperty;
    rdfs:comment "Distribution Percentage Upper Bound, is the optional dimensionless upper bound of the candidate applicability percentage interval, used for limiting the maximum acceptable distribution percentage.";
    rdfs:label "Distribution Percentage Upper Bound";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:distributionPercentageUpperInclusive a owl:DatatypeProperty;
    rdfs:comment "Distribution Percentage Upper Inclusive, is the Boolean value that, given an upper bound, states whether that endpoint is included, used for precisely defining the upper-end membership of the percentage interval.";
    rdfs:label "Distribution Percentage Upper Inclusive";
    rdfs:range xsd:boolean.
fin-market-rules:dueBillSettlementQualification a owl:ObjectProperty;
    rdfs:comment "Due-bill Settlement Qualification, is the exact evidence mode required for a trade to qualify for due-bill processing, used for specifying the eligibility conditions for due-bill settlement.";
    rdfs:label "Due-bill Settlement Qualification";
    rdfs:range fin-market-rules:CorporateActionSettlementQualification.
fin-market-rules:entitlementPivotDateField a owl:ObjectProperty;
    rdfs:comment "Entitlement Pivot Date Field, is the exact corporate-action event date-field role from which the entitlement pivot is deterministically resolved, used for locking the time anchor of entitlement ownership.";
    rdfs:label "Entitlement Pivot Date Field";
    rdfs:range fin-market-rules:CorporateActionEventDateField.
fin-market-rules:hasRuleType a owl:ObjectProperty;
    rdfs:comment "Has Rule Type, is the reviewed rule-type member required on every market-rule fact version, used for classifying a rule's executable specialization.";
    rdfs:label "Has Rule Type";
    rdfs:range fin-market-rules:RuleType.
fin-market-rules:indeterminacyReason a owl:DatatypeProperty;
    rdfs:comment "Indeterminacy Reason, is the non-empty explanation recorded when evaluation cannot complete due to missing inputs or an unresolved reference, used for distinguishing indeterminacy from a definitive conflict.";
    rdfs:label "Indeterminacy Reason";
    rdfs:range xsd:string.
fin-market-rules:lotSize a owl:ObjectProperty;
    rdfs:comment "Lot Size, is the positive canonical quantity representing the order-quantity increment in a lot-size clause, used for specifying the minimum order unit within that range.";
    rdfs:label "Lot Size";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:marketRuleSet a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Market Rule Set Relation, is a direct reference from a market-rule version to its exact containing rule-set version, used for establishing the rule's ownership and the comparison boundary of its priority.";
    rdfs:domain fin-market-rules:MarketRule;
    rdfs:label "Market Rule Set";
    rdfs:range fin-market-rules:MarketRuleSet.
fin-market-rules:minimumResaleHoldingPeriod a owl:ObjectProperty;
    rdfs:comment "Minimum Resale Holding Period, is the optional non-negative duration quantity required to be held before resale when same-day resale is prohibited, used for constraining the minimum holding time before resale.";
    rdfs:label "Minimum Resale Holding Period";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:noMatchReason a owl:DatatypeProperty;
    rdfs:comment "No Match Reason, is the non-empty explanation recorded when no surviving applicability matches the request, used for distinguishing a genuine coverage gap from an error.";
    rdfs:label "No Match Reason";
    rdfs:range xsd:string.
fin-market-rules:nonTransferableDirectSubscription a owl:DatatypeProperty;
    rdfs:comment "Non-transferable Direct Subscription, is a Boolean attribute used only for rights issues, used for requiring the non-transferable direct-subscription profile and rejecting transferable-right models.";
    rdfs:label "Non-transferable Direct Subscription";
    rdfs:range xsd:boolean.
fin-market-rules:normativeSourceForRule a owl:ObjectProperty;
    rdfs:comment "Normative Source For Rule, is a direct reference from a market-rule version to one of its normative source fact versions, used for recording the main text, amendments, notices, interpretations, and effective notices that evidence the rule. A rule may have multiple normative sources.";
    rdfs:domain fin-market-rules:MarketRule;
    rdfs:label "Normative Source For Rule";
    rdfs:range fin-market-rules:NormativeSource.
fin-market-rules:normativeSourceForRuleSet a owl:ObjectProperty;
    rdfs:comment "Normative Source For Rule Set, is a direct reference from a market-rule-set version to one of its normative source fact versions, used for recording the authority texts that evidence the rule set as a whole.";
    rdfs:domain fin-market-rules:MarketRuleSet;
    rdfs:label "Normative Source For Rule Set";
    rdfs:range fin-market-rules:NormativeSource.
fin-market-rules:normativeSourceLocator a owl:DatatypeProperty;
    rdfs:comment "Normative Source Locator, is the non-empty document locator of a normative source, used for locating the authoritative text that evidences a rule or rule set.";
    rdfs:label "Normative Source Locator";
    rdfs:range xsd:string.
fin-market-rules:normativeSourceRole a owl:ObjectProperty;
    rdfs:comment "Normative Source Role, is the reviewed role member identifying the function of a normative source (main text, amendment, notice, interpretation, effective notice), used for recording the multiple evidence roles a rule may have.";
    rdfs:label "Normative Source Role";
    rdfs:range fin-market-rules:NormativeSourceRole.
fin-market-rules:normativeSourceSection a owl:DatatypeProperty;
    rdfs:comment "Normative Source Section, is the optional section reference within the located document, used for pinpointing the clause that evidences a rule.";
    rdfs:label "Normative Source Section";
    rdfs:range xsd:string.
fin-market-rules:orderingLeftDateRole a owl:ObjectProperty;
    rdfs:comment "Corporate Action Ordering Left Date Role, is the first of two distinct resolved date roles in one executable ordering comparison, used for participating in the before/after comparison of two dates within a schedule.";
    rdfs:label "Corporate Action Ordering Left Date Role";
    rdfs:range fin-market-rules:CorporateActionResolvedDateRole.
fin-market-rules:orderingRightDateRole a owl:ObjectProperty;
    rdfs:comment "Corporate Action Ordering Right Date Role, is the second of two distinct resolved date roles in one executable ordering comparison, used for participating in the before/after comparison of two dates within a schedule.";
    rdfs:label "Corporate Action Ordering Right Date Role";
    rdfs:range fin-market-rules:CorporateActionResolvedDateRole.
fin-market-rules:outcomeForRequest a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Outcome For Request, is the direct reference from a rule selection outcome to the exact evaluation request fact version it resolves, used for binding every outcome (resolved, no-applicable-rule, conflict, unsupported, indeterminate) to its request.";
    rdfs:domain fin-market-rules:RuleSelectionOutcome;
    rdfs:label "Outcome For Request";
    rdfs:range fin-market-rules:RuleEvaluationRequest.
fin-market-rules:parameterClauseReference a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Parameter Clause Reference, is a mutually exclusive choose-one branch from a rule-parameter version to one exact referenced clause version, used for establishing a precise reference when the parameter value is itself another clause.";
    rdfs:domain fin-market-rules:RuleParameter;
    rdfs:label "Parameter Clause Reference";
    rdfs:range fin-market-rules:RuleClause.
fin-market-rules:parameterForClause a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Parameter For Clause, is a direct ownership reference from a rule-parameter version to its exact containing clause version, used for binding a typed parameter to its execution context.";
    rdfs:domain fin-market-rules:RuleParameter;
    rdfs:label "Parameter For Clause";
    rdfs:range fin-market-rules:RuleClause.
fin-market-rules:precedenceReason a owl:DatatypeProperty;
    rdfs:comment "Precedence Reason, is the non-empty reviewed explanation supporting one explicit rule-precedence edge, used for recording the basis of a cross-authority rule-priority decision.";
    rdfs:label "Precedence Reason";
    rdfs:range xsd:string.
fin-market-rules:priceBandSide a owl:ObjectProperty;
    rdfs:comment "Price Band Side, is the reviewed side member stating whether a price-limit clause sets the upper limit, lower limit, or both, used for distinguishing limit up from limit down.";
    rdfs:label "Price Band Side";
    rdfs:range fin-market-rules:PriceBandSide.
fin-market-rules:priceLimitAmount a owl:ObjectProperty;
    rdfs:comment "Price Limit Amount, is the optional money branch of a price-limit-clause boundary, used for setting the price boundary as an absolute monetary amount.";
    rdfs:label "Price Limit Amount";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-rules:priceLimitPercentage a owl:ObjectProperty;
    rdfs:comment "Price Limit Percentage, is the optional dimensionless percentage branch of a price-limit-clause boundary, used for setting the up/down limit relative to a reference price as a percentage.";
    rdfs:label "Price Limit Percentage";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:priceLimitReferencePrice a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Price Limit Reference Price, is the direct reference from a price-limit rule to its exact ReferencePriceSpecification fact version, used for making the price band computable from a reference price rather than carrying only a bare percentage or amount.";
    rdfs:domain fin-market-rules:PriceLimitRule;
    rdfs:label "Price Limit Reference Price";
    rdfs:range fin-market-rules:ReferencePriceSpecification.
fin-market-rules:referencePriceCurrency a owl:DatatypeProperty;
    rdfs:comment "Reference Price Currency, is the optional currency in which the reference price and the resulting band are quoted, used for ensuring the band is computed in the correct quote currency.";
    rdfs:label "Reference Price Currency";
    rdfs:range xsd:string.
fin-market-rules:referencePriceMissingPolicy a owl:ObjectProperty;
    rdfs:comment "Reference Price Missing Policy, is the reviewed policy applied when the reference price is unavailable at the evaluation point (reject, fall back to a prior observation, suspend), used for making missing-reference behavior explicit rather than silent.";
    rdfs:label "Reference Price Missing Policy";
    rdfs:range fin-market-rules:ReferencePriceMissingPolicy.
fin-market-rules:referencePriceRounding a owl:ObjectProperty;
    rdfs:comment "Reference Price Rounding, is the optional rounding convention applied to the computed band (round to nearest tick, floor, ceiling), used for making the limit up/down a valid quotable price.";
    rdfs:label "Reference Price Rounding";
    rdfs:range fin-market-rules:ReferencePriceRounding.
fin-market-rules:referencePriceSource a owl:ObjectProperty;
    rdfs:comment "Reference Price Source, is the reviewed price-source member identifying where the reference price is drawn from (previous close, opening auction, fixed price), used for making the price limit computable.";
    rdfs:label "Reference Price Source";
    rdfs:range fin-market-rules:ReferencePriceSource.
fin-market-rules:referencePriceWindow a owl:DatatypeProperty;
    rdfs:comment "Reference Price Window, is the optional observation window over which the reference price is selected, used for pinning the price selection to a point or interval.";
    rdfs:label "Reference Price Window";
    rdfs:range xsd:string.
fin-market-rules:requestAccountType a owl:ObjectProperty;
    rdfs:comment "Request Account Type, is the optional foundation account-type member supplied as an exact rule-evaluation scope, used for restricting the account dimension in an evaluation request.";
    rdfs:label "Request Account Type";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/AccountType>.
fin-market-rules:requestAuthority a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Request Authority, is a direct reference from a rule-evaluation request to the exact party fact version that issued it, used for declaring the publishing authority of the evaluation request.";
    rdfs:domain fin-market-rules:RuleEvaluationRequest;
    rdfs:label "Request Authority";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
fin-market-rules:requestInstrumentScope a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Request Instrument Scope, is the exact financial-instrument fact version bound by a rule-evaluation request, used for restricting the evaluation scope to a specific instrument.";
    rdfs:domain fin-market-rules:RuleEvaluationRequest;
    rdfs:label "Request Instrument Scope";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-market-rules:requestJurisdictionScope a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Request Jurisdiction Scope, is the exact jurisdiction fact version bound by a rule-evaluation request, used for restricting the evaluation scope to a specific jurisdiction.";
    rdfs:domain fin-market-rules:RuleEvaluationRequest;
    rdfs:label "Request Jurisdiction Scope";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Jurisdiction>.
fin-market-rules:requestListingScope a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Request Listing Scope, is the exact instrument-listing fact version bound by a rule-evaluation request, used for restricting the evaluation scope to a specific listing.";
    rdfs:domain fin-market-rules:RuleEvaluationRequest;
    rdfs:label "Request Listing Scope";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/InstrumentListing>.
fin-market-rules:requestSegmentScope a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Request Segment Scope, is the exact market-segment fact version bound by a rule-evaluation request, used for restricting the evaluation scope to a specific market segment.";
    rdfs:domain fin-market-rules:RuleEvaluationRequest;
    rdfs:label "Request Segment Scope";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/MarketSegment>.
fin-market-rules:requestTradingPhaseScope a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Request Trading Phase Scope, is the exact trading-session occurrence fact version bound by a rule-evaluation request, used for restricting the evaluation scope to a specific concrete session occurrence or phase.";
    rdfs:domain fin-market-rules:RuleEvaluationRequest;
    rdfs:label "Request Trading Phase Scope";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingSessionOccurrence>.
fin-market-rules:requestTradingSessionScope a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Request Trading Session Scope, is the exact trading-session template fact version bound by a rule-evaluation request, used for restricting the evaluation scope to a specific recurring trading session.";
    rdfs:domain fin-market-rules:RuleEvaluationRequest;
    rdfs:label "Request Trading Session Scope";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingSessionTemplate>.
fin-market-rules:requestVenueScope a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Request Venue Scope, is the exact trading-facility fact version bound by a rule-evaluation request, used for restricting the evaluation scope to a specific trading venue.";
    rdfs:domain fin-market-rules:RuleEvaluationRequest;
    rdfs:label "Request Venue Scope";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingFacility>.
fin-market-rules:requestedCorporateActionKind a owl:ObjectProperty;
    rdfs:comment "Requested Corporate Action Kind, is the optional exact corporate-action-kind typed parameter required for a corporate-action schedule evaluation, used for restricting the schedule category in an evaluation request.";
    rdfs:label "Requested Corporate Action Kind";
    rdfs:range fin-market-rules:CorporateActionKind.
fin-market-rules:resolvedApplicability a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Resolved Applicability, is the direct reference from a resolved selection to the single surviving RuleApplicability fact version that won, used for making the normal-hit winner fully traceable.";
    rdfs:domain fin-market-rules:ResolvedSelection;
    rdfs:label "Resolved Applicability";
    rdfs:range fin-market-rules:RuleApplicability.
fin-market-rules:resolvedClause a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Resolved Clause, is the direct reference from a resolved selection to the exact RuleClause fact version that produced the effect, used for recording the selected clause in the outcome.";
    rdfs:domain fin-market-rules:ResolvedSelection;
    rdfs:label "Resolved Clause";
    rdfs:range fin-market-rules:RuleClause.
fin-market-rules:resolvedDateRole a owl:ObjectProperty;
    rdfs:comment "Resolved Corporate Action Date Role, is the exact schedule-resolution output date role produced by a date-resolution clause, used for identifying the purpose of a determined output date in a schedule.";
    rdfs:label "Resolved Corporate Action Date Role";
    rdfs:range fin-market-rules:CorporateActionResolvedDateRole.
fin-market-rules:resolvedRule a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Resolved Rule, is the direct reference from a resolved selection to the exact MarketRule fact version whose applicability won, used for recording the selected rule in the outcome.";
    rdfs:domain fin-market-rules:ResolvedSelection;
    rdfs:label "Resolved Rule";
    rdfs:range fin-market-rules:MarketRule.
fin-market-rules:resolvedSpecificityVector a owl:DatatypeProperty;
    rdfs:comment "Resolved Specificity Vector, is the platform-derived specificity vector computed from the authored scope dimensions of the winning applicability, used for ranking comparable candidates without accepting a caller-authored specificity value.";
    rdfs:label "Resolved Specificity Vector";
    rdfs:range xsd:string.
fin-market-rules:ruleClauseId a owl:DatatypeProperty;
    rdfs:comment "Rule Clause Identifier, is the non-empty normalized identifier of a rule clause within its exact owning rule version, used for uniquely identifying an executable clause within the rule.";
    rdfs:label "Rule Clause Identifier";
    rdfs:range xsd:string.
fin-market-rules:ruleCodeParameterValue a owl:ObjectProperty;
    rdfs:comment "Rule Code Parameter Value, is the optional reviewed code-member branch of a rule parameter's mutually exclusive choose-one, used for filling the parameter value as a controlled code.";
    rdfs:label "Rule Code Parameter Value";
    rdfs:range fin-market-rules:RuleParameterCode.
fin-market-rules:ruleConflictKind a owl:ObjectProperty;
    rdfs:comment "Rule Conflict Kind, is the reviewed conflict-kind member explaining why no silent winner was produced, used for classifying the cause of an unresolvable rule-evaluation conflict.";
    rdfs:label "Rule Conflict Kind";
    rdfs:range fin-market-rules:RuleConflictKind.
fin-market-rules:ruleEvaluationRequestId a owl:DatatypeProperty;
    rdfs:comment "Rule Evaluation Request Identifier, is the non-empty normalized identifier unique within the logical request-authority scope, used for identifying one rule-evaluation request.";
    rdfs:label "Rule Evaluation Request Identifier";
    rdfs:range xsd:string.
fin-market-rules:ruleGapPolicy a owl:ObjectProperty;
    rdfs:comment "Rule Gap Policy, is the reviewed rule-level decision of whether uncovered ranges between ordered clauses are rejected or allowed, used for explicitly managing coverage gaps between clauses.";
    rdfs:label "Rule Gap Policy";
    rdfs:range fin-market-rules:ClauseGapPolicy.
fin-market-rules:ruleHasClause a owl:ObjectProperty;
    rdfs:comment "Rule Has Clause, is a direct reference from a market-rule version to one exact executable clause version, used for decomposing the rule's executable semantics into ordered typed clauses.";
    rdfs:domain fin-market-rules:MarketRule;
    rdfs:label "Rule Has Clause";
    rdfs:range fin-market-rules:RuleClause.
fin-market-rules:ruleId a owl:DatatypeProperty;
    rdfs:comment "Rule Identifier, is the non-empty normalized identifier of a market rule within its exact containing rule set, used for uniquely identifying a rule within the rule set.";
    rdfs:label "Rule Identifier";
    rdfs:range xsd:string.
fin-market-rules:ruleMoneyParameterValue a owl:ObjectProperty;
    rdfs:comment "Rule Money Parameter Value, is the optional money branch of a rule parameter's mutually exclusive choose-one, used for filling the parameter value as a monetary amount.";
    rdfs:label "Rule Money Parameter Value";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-rules:ruleParameterId a owl:DatatypeProperty;
    rdfs:comment "Rule Parameter Identifier, is the non-empty normalized identifier of a typed rule parameter within its exact owning clause version, used for uniquely identifying a parameter within the clause.";
    rdfs:label "Rule Parameter Identifier";
    rdfs:range xsd:string.
fin-market-rules:ruleQuantityParameterValue a owl:ObjectProperty;
    rdfs:comment "Rule Quantity Parameter Value, is the optional quantity branch of a rule parameter's mutually exclusive choose-one, used for filling the parameter value as a measured quantity.";
    rdfs:label "Rule Quantity Parameter Value";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:ruleSetAuthority a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Rule Set Authority, is a direct reference from a market-rule-set version to its exact maintaining party fact version, used for declaring the publishing and maintenance authority of the rule set.";
    rdfs:domain fin-market-rules:MarketRuleSet;
    rdfs:label "Rule Set Authority";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
fin-market-rules:ruleSetId a owl:DatatypeProperty;
    rdfs:comment "Rule Set Identifier, is the non-empty normalized identifier of a market-rule-set logical identity within an authority scope, used for uniquely identifying a rule set maintained by one authority.";
    rdfs:label "Rule Set Identifier";
    rdfs:range xsd:string.
fin-market-rules:sameDayResaleAllowed a owl:DatatypeProperty;
    rdfs:comment "Same-day Resale Allowed, is the explicit Boolean outcome of a resale-restriction clause, used for declaring whether same-day resale is permitted and distinct from settlement-cycle semantics.";
    rdfs:label "Same-day Resale Allowed";
    rdfs:range xsd:boolean.
fin-market-rules:scheduleCalendar a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Schedule Calendar, is the direct reference from a corporate-action schedule rule to the exact TradingCalendar fact version used to resolve business-day offsets and cutoffs, used for backing the schedule's calendar semantics with a real calendar rather than only a contract digest.";
    rdfs:domain fin-market-rules:CorporateActionScheduleRule;
    rdfs:label "Schedule Calendar";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar>.
fin-market-rules:scheduleCalendarCutoffContractDigest a owl:DatatypeProperty;
    rdfs:comment "Schedule Calendar and Cutoff Contract Digest, is the SHA-256 digest of the exact calendar, timezone, and cutoff normalization contract, used for freezing the schedule's calendar and cutoff rules for audit.";
    rdfs:label "Schedule Calendar and Cutoff Contract Digest";
    rdfs:range xsd:string.
fin-market-rules:scheduleDateOrderingContractDigest a owl:DatatypeProperty;
    rdfs:comment "Schedule Date Ordering Contract Digest, is the SHA-256 digest of the jurisdiction- or profile-specific legal date-ordering contract, used for freezing the before/after relations among dates within a schedule for audit.";
    rdfs:label "Schedule Date Ordering Contract Digest";
    rdfs:range xsd:string.
fin-market-rules:scheduleDateResolutionContractDigest a owl:DatatypeProperty;
    rdfs:comment "Schedule Date Resolution Contract Digest, is the SHA-256 digest of the exact event-date-to-resolved-date selection contract, used for freezing the schedule's date-resolution rule for audit.";
    rdfs:label "Schedule Date Resolution Contract Digest";
    rdfs:range xsd:string.
fin-market-rules:scopeExpressionForm a owl:ObjectProperty;
    rdfs:comment "Scope Expression Form, is the reviewed boolean form of a scope expression (conjunction, disjunction, exception), used for declaring how the constituent scope terms are combined.";
    rdfs:label "Scope Expression Form";
    rdfs:range fin-market-rules:ScopeExpressionForm.
fin-market-rules:scopeExpressionTerm a owl:ObjectProperty;
    rdfs:comment "Scope Expression Term, is a direct reference from a scope expression to its constituent scope-term fact versions, used for composing multiple scope dimensions with conjunction, disjunction, and exception.";
    rdfs:domain fin-market-rules:ScopeExpression;
    rdfs:label "Scope Expression Term";
    rdfs:range fin-market-rules:ScopeTerm.
fin-market-rules:scopeTermDimension a owl:ObjectProperty;
    rdfs:comment "Scope Term Dimension, is the reviewed scope-dimension member identifying which dimension a scope term binds (trading session, trading phase, instrument classification, investor category, order type, order side, market model, or any of the legacy dimensions), used for typing the atomic unit of a scope expression.";
    rdfs:label "Scope Term Dimension";
    rdfs:range fin-market-rules:ScopeDimension.
fin-market-rules:scopeTermPolarity a owl:DatatypeProperty;
    rdfs:comment "Scope Term Polarity, is the Boolean stating whether a scope term is a positive include or a negative exception, used for supporting exception branches in a scope expression.";
    rdfs:label "Scope Term Polarity";
    rdfs:range xsd:boolean.
fin-market-rules:selectionBasis a owl:ObjectProperty;
    rdfs:comment "Selection Basis, is the reviewed basis member explaining how the resolved selection was chosen among comparable candidates, used for recording whether resolution used numeric priority, explicit precedence, or specificity.";
    rdfs:label "Selection Basis";
    rdfs:range fin-market-rules:PrecedenceBasis.
fin-market-rules:selectionOutcomeKind a owl:ObjectProperty;
    rdfs:comment "Selection Outcome Kind, is the reviewed outcome-kind member carried by every rule selection outcome, used for classifying the result as resolved, no-applicable-rule, conflict, unsupported, or indeterminate.";
    rdfs:label "Selection Outcome Kind";
    rdfs:range fin-market-rules:SelectionOutcomeKind.
fin-market-rules:settlementCycle a owl:ObjectProperty;
    rdfs:comment "Settlement Cycle, is the non-negative business-day quantity between the trade date and the contractual settlement date, used for specifying the number of business days required for settlement.";
    rdfs:label "Settlement Cycle";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:settlementCycleCalendar a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Settlement Cycle Calendar, is the direct reference from a settlement-cycle clause to the exact TradingCalendar fact version used to count business days from the trade date, used for replacing the bare business-day count with a calendar-backed computation.";
    rdfs:domain fin-market-rules:SettlementCycleClause;
    rdfs:label "Settlement Cycle Calendar";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar>.
fin-market-rules:sourceEventDateField a owl:ObjectProperty;
    rdfs:comment "Source Corporate Action Event Date Field, is the exact published event date-field role consumed by a date-resolution clause, used for locking the input date source for schedule resolution.";
    rdfs:label "Source Corporate Action Event Date Field";
    rdfs:range fin-market-rules:CorporateActionEventDateField.
fin-market-rules:tickSize a owl:ObjectProperty;
    rdfs:comment "Tick Size, is the positive canonical quantity representing the minimum quoting step in a tick-size clause, used for specifying the price-increment unit within that range.";
    rdfs:label "Tick Size";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-rules:unsupportedReason a owl:DatatypeProperty;
    rdfs:comment "Unsupported Reason, is the non-empty explanation recorded when the request targets an unsupported rule kind or clause shape, used for distinguishing an unsupported request from a coverage gap or conflict.";
    rdfs:label "Unsupported Reason";
    rdfs:range xsd:string.
