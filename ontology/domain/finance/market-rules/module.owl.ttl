    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-rules/ScopeExpressionForm/value/exception> a owl:NamedIndividual, skos:Concept, fin-market-rules:ScopeExpressionForm;
    rdfs:comment "the positive terms match except the negative terms";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-rules/ScopeExpressionForm/scheme>;
    skos:notation "exception";
    skos:prefLabel "Exception";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-market-rules:ScopeTerm a owl:Class;
    rdfs:comment "ScopeTerm, is a single dimension value participating in a scope expression, used for binding one scope dimension (trading session, trading phase, instrument classification, investor category, order type, order side, market model, or the existing listing/instrument/segment/venue/jurisdiction/account-type dimensions) to an exact versioned fact. A scope term is the atomic unit composed by a scope expression.";
    rdfs:label "Scope Term";
    rdfs:subClassOf _:r_207aadf9b4106709300f3e38, _:r_4f6dcd2eddca487af2dc6edd, _:r_9d648adf0fcd58964d8df58b, _:r_bc85231181f6b2df7fc91240, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-rules/ScopeTerm/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Scope Term versions.";
    rdfs:label "Scope Term logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-rules:SelectionOutcomeKind a owl:Class;
    rdfs:comment "Selection Outcome Kind, is a closed classification of rule selection outcomes, used for classifying each evaluation result as a resolved selection, no-applicable-rule, conflict, unsupported, or indeterminate.";
    rdfs:label "Selection Outcome Kind";
    owl:oneOf _:l_8a9a70717907777f11c502cd_0.
