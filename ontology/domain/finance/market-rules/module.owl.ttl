    skos:inScheme <https://axiolune.ai/ontology/finance/market-rules/SelectionOutcomeKind/scheme>;
    skos:notation "noApplicableRule";
    skos:prefLabel "No applicable rule";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-rules/SelectionOutcomeKind/value/resolvedSelection> a owl:NamedIndividual, skos:Concept, fin-market-rules:SelectionOutcomeKind;
