    rdfs:domain fin-market-rules:RuleConflict;
    rdfs:label "candidate applicability version";
    rdfs:range fin-market-rules:RuleApplicability.
<https://axiolune.ai/ontology/finance/market-rules/RuleConflict/role/evaluationRequestVersion> a owl:ObjectProperty;
