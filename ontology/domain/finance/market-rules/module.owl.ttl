<https://axiolune.ai/ontology/finance/market-rules> a owl:Ontology;
    rdfs:comment "Market Rules, is a domain module that defines trading rules, price limits, circuit breakers, settlement conventions, corporate-action schedule rules, and rule selection semantics in ontology engineering, used for providing formalizable and verifiable rule definitions for the operating rules of trading venues. The module carries the executable rule catalog and applicability scope; rule selection outcomes (resolved selection, no-applicable-rule, conflict) are modeled as first-class facts so that evaluation is auditable rather than silently resolved.";
    rdfs:label "Market Rules";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/instruments>, <https://axiolune.ai/ontology/finance/market-structure>, <https://axiolune.ai/ontology/meta>;
