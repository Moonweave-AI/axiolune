fin-market-rules:RuleApplicabilityShape a sh:NodeShape;
    sh:description "Rule Applicability, is a temporal and provenanced fact that binds one exact rule version to at least one explicit scope among listing, instrument, segment, venue, account type, jurisdiction, trading session, trading phase, instrument classification, investor category, order type, order side, or market model, used for declaring a rule's applicability scope without ever implying global scope from absence. A complex scope may be carried by an optional scope expression that composes scope terms with conjunction, disjunction, and exception.";
    sh:name "Rule Applicability";
    sh:property <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/attribute/1d7916c010c12349dece0d35>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/attribute/3ceea1819f8701dfd8f2cc3e>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/attribute/3d72b0c5ea823b66f74dc6a8>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/attribute/955205e7a6fb384044c5dd26>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/attribute/a87197c0483d69e853301973>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/attribute/c7a57e4fd63b027d410e7fdb>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/participant-role-applicableRuleVersion/2b43749d881a8a87bb7a6850>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/participant-role-scopeExpressionVersion/0bbebc6dd57fd31059ab53d2>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/participant-role-scopeInstrumentClassificationVersion/8850111a20c7a017fb6b253d>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/participant-role-scopeInstrumentVersion/f10fb7a4f4d10b8bf67e5388>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/participant-role-scopeJurisdictionVersion/7b6eafbd5f62302f18d0a5d1>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/participant-role-scopeListingVersion/371661ed8c9a6fcf48b5fe45>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/shape/participant-role-scopeSegmentVersion/f3f1df18cfa80becd7bb0466>, <https://axiolune.ai/ontology/finance/market-rules/RuleApplicability/