fin-market-rules:ReferencePriceSpecificationShape a sh:NodeShape;
    sh:description "ReferencePriceSpecification, is a versioned provenanced specification of the reference price used by a price-limit or circuit-breaker rule, used for making the price limit computable. It carries the price source, the observation window, the missing-value policy, the quote currency, and the rounding convention applied to the reference price before the band is computed, so that a limit up/down can be derived as reference price times the band ratio rounded to the tick without ambiguity.";
    sh:name "Reference Price Specification";
    sh:property <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/attribute/4116fb8bed7cdd94a6dbe35b>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/attribute/6534e515057d24411f1a4afb>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/attribute/c88dcab4309e94cdaed5deb5>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/attribute/e0185fadee8ff673d943c212>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/attribute/f34dfde1e74404f477f4979f>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/market-rules/ReferencePriceSpecification/shape/temporal/f0f2f601393d100a35dc2429>;
