@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix ext-fibo: <https://axiolune.ai/ontology/finance/ext-fibo-release-local/>.

ext-fibo:FiboEvidenceBundleShape a sh:NodeShape;
    sh:targetClass ext-fibo:FiboEvidenceBundle;
    sh:name "FIBO Evidence Bundle";
    sh:description "documentation object recording the locked local FIBO evidence files and import policy for Axiolune alignments".
