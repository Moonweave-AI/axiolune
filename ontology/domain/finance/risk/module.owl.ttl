fin-risk:RiskReport a owl:Class;
    rdfs:comment "A Risk Report, is a report view over risk results — report as-of, audience, and sections — used to express the aggregation and reporting dimension that BCBS 239 emphasizes, distinct from the underlying computed results. Full BCBS 239 aggregation infrastructure is out of scope; this is a lightweight report-view hook.";
    rdfs:label "Risk Report";
    rdfs:subClassOf _:r_02593a9295217566f8641e32, _:r_32bc52978e26f20a75e77ad7, _:r_ad6e9d36afc6448f8d4da6bf, _:r_c2f03879949c25392d523887, _:r_cf8f69ca036a943df6d0d54e, _:r_d37e3d621eb8020ad5fbdba8, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
