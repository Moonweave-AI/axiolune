<https://axiolune.ai/ontology/finance/risk> a owl:Ontology;
    rdfs:comment "The Risk module, is a finance domain module that provides a generic semantic core for risk management concerns — risk categories, sources, factors, exposures, scope, appetite and tolerance; risk measure specification, calculation profile and implementation version; risk measurement observations and validated reproducible measurements; risk limit rules with comparison policy and governance lifecycle; limit evaluation, breach facts and breach-case governance; and stress scenarios with shocks and application evidence. It is used to give typed definitions for risk calculation, monitoring, limit checking, breach governance, and stress testing. The audit-grade reproducibility model (digest-pinned implementation, frozen input context, complete bucket closure, deterministic evaluation) is an optional high-assurance profile rather than a universal precondition, so that preliminary, data-quality-limited, revised, and non-closure results are expressible. Market, credit, liquidity, operational, concentration, and model risk are extensible risk categories; full regulatory frameworks (FRTB, BCBS 239 aggregation, model-risk governance) are explicitly out of scope and exposed only as terminology-calibration alignments, not hardcoded rules.";
    rdfs:label "Risk";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/market-data>, <https://axiolune.ai/ontology/finance/portfolio-positions>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/risk/1.1.0>.
fin-risk:BreachAcknowledgement a owl:Class;
    rdfs:comment "A Breach Acknowledgement, is the acknowledgement of a RiskLimitBreachCase by a Party, used to record that a breach was seen and accepted into governance rather than remaining an unattended computed fact.";
    rdfs:label "Breach Acknowledgement";
    rdfs:subClassOf _:r_0133933dd1b5fc7526073f13, _:r_1a04855782e11706110e1580, _:r_3c8ef56ab23aa76f1d453cdc, _:r_ded4f9128ab8038ab06b7bfb, _:r_e784d2a0b5da9ddb7bcf2b07, _:r_ff8d72911e618c09241cf681, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/BreachAcknowledgement/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Breach Acknowledgement versions.";
    rdfs:label "Breach Acknowledgement logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/risk/BreachAcknowledgement/role/acknowledgedCase> a owl:ObjectProperty;
    rdfs:comment "exact RiskLimitBreachCase acknowledged";
    rdfs:domain fin-risk:BreachAcknowledgement;
    rdfs:label "acknowledged case";
    rdfs:range fin-risk:RiskLimitBreachCase.
<https://axiolune.ai/ontology/finance/risk/BreachAcknowledgement/role/acknowledgingParty> a owl:ObjectProperty;
    rdfs:comment "Party acknowledging the breach case";
    rdfs:domain fin-risk:BreachAcknowledgement;
    rdfs:label "acknowledging party";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
