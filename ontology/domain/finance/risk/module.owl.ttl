    rdfs:comment "Stable FactIdentity companion for immutable Risk Measure Specification versions.";
    rdfs:label "Risk Measure Specification logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:RiskMeasurement a owl:Class;
    rdfs:comment "A Risk Measurement, is a point-in-time result for one exact risk-measure definition and at least one explicit portfolio, account, position, or RiskScopeSnapshot scope that carries exactly one Money, Quantity, or RiskBucketSet representation, used to record a computed risk number. A measurementStatus distinguishes preliminary, incomplete, revised, failed, estimated, and validated results, so non-audit-grade numbers are expressible; the strictly-prior input-context evidence (inputContextRef, inputContextRecordDigest, inputContextCompleted) is mandatory only when the ValidatedReproducibleRiskMeasurement profile is active. Optional roles link the result to its RiskMeasureSpecification, RiskInputSet, RiskCalculationContext, RiskScopeSnapshot, driving RiskFactor(s), and RiskExposure(s), so that \"what drove the result\" is queryable rather than hidden in a digest.";
    rdfs:label "Risk Measurement";
    rdfs:subClassOf _:r_01e78bd95f50ff751bf2eae2, _:r_101dfb273d3f24659f8290ab, _:r_16a88317c209d1355dd5a80e, _:r_185a68df5ce4affe4e601aa4, _:r_1cc0e5c1d6421ce796f6f09a, _:r_27dac671f569a3eb192ff5a2, _:r_29fca77e46a18d1ddc8e9956, _:r_2f14a613632594e7876a7264, _:r_3025f70b0178f0c3b6a7b1a9, _:r_37ddaef4e7fb9299a106b737, _:r_38fecfa50ba6cd46e97cfdf9, _:r_443397c0ab591f612bd68d6b, _:r_45b35c91138c37eed78f3477, _:r_470f1ebc94e5d39f0f9a9b32, _:r_5275a6a0779d37f832406b5e, _:r_58f759dea78558e9a6df073f, _:r_669bf890b2b2f590a27956aa, _:r_66d8a9fc95831b1cbcfbdd0a, _:r_7364dd9c9d55a269bd2aa61d, _:r_79d5e66062bb31e4ca360848, _:r_87bd302e815351070ee4e19f, _:r_8e52c24ce239f529ca26430d, _:r_8eb23c4e2cb4cbcd98505abe, _:r_9307f6996a0e22fc4454ed01, _:r_94d7b09dd8e7d4dcbf3f6b40, _:r_95e55ee690708a2a1b9eb2e2, _:r_a2fbfb241e4583d9fcd00ba3, _:r_a33277909e8c278a00e66c88, _:r_a54822b43d12b32ef751e50a, _:r_ab47490b1297cb55fc809587, _:r_b1a5613bff105a053de473ce, _:r_b890bf3ff555d0d15fde9010, _:r_c2dd544d293d58d1c12252f5, _:r_c36aa906fca2d55a84e48d83, _:r_c3842bc2078ff7b94eec4b57, _:r_c93133bfe46450ea6f7451b8, _:r_cb4a932b02695ea7e07ba113, _:r_eba0d15e1ac70370898d498a, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
