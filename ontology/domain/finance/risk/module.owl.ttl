fin-risk:StressTestRun a owl:Class;
    rdfs:comment "A Stress Test Run, is a completed stress test that applies one exact ScenarioDefinition version to a portfolio scope and records the output RiskMeasurement version produced by the run, used to bind the scenario, the shocked holdings, and the output result in a replayable way. It carries a run authority in its logical key, an exact RiskScopeSnapshot or RiskInputSet whose members were shocked, an optional baseline measurement, one or more stressed measurements, and a ScenarioApplicationEvidence role proving the output's input context was actually shocked by the scenario. The run's contract requires the output's generating context to equal the run's, the output's scope to match the stress scope, and the measure definition's scenarioRef to equal the run's exact ScenarioDefinition.";
    rdfs:label "Stress Test Run";
    rdfs:subClassOf _:r_19c30d2bae5869ad5f774008, _:r_41af6c17d8f9724f32c356cb, _:r_58a25cdaed6d209d43b8f614, _:r_868917e595c2752b733e3511, _:r_8c7c298c1413e16402a737ef, _:r_8fb81f1dc57a8cda568816b5, _:r_910dfda9971573bcd58c10ee, _:r_a48283072c23199265c477b5, _:r_beee15d372dd36f6a48bea61, _:r_c056d2c0a21a6d2e6e7501fa, _:r_c850380a400e8f1825a9717e, _:r_d62f6385d5693ff0fd09f200, _:r_d748ddbb473157be97a8a104, _:r_e21d7eae7692689477ca7e19, _:r_f04a6594d32c3350a4d39649, _:r_f1499d8b555c2bd736c39559, _:r_f9560d2b0dafdcf6068fabce, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/StressTestRun/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Stress Test Run versions.";
    rdfs:label "Stress Test Run logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/risk/StressTestRun/role/stressRunApplicationEvidence> a owl:ObjectProperty;
    rdfs:comment "optional ScenarioApplicationEvidence proving the output input context was shocked by the scenario";
    rdfs:domain fin-risk:StressTestRun;
    rdfs:label "stress run application evidence";
    rdfs:range fin-risk:ScenarioApplicationEvidence.
<https://axiolune.ai/ontology/finance/risk/StressTestRun/role/stressRunBaseline> a owl:ObjectProperty;
    rdfs:comment "optional exact baseline RiskMeasurement before the shock";
    rdfs:domain fin-risk:StressTestRun;
    rdfs:label "stress run baseline";
    rdfs:range fin-risk:RiskMeasurement.
<https://axiolune.ai/ontology/finance/risk/StressTestRun/role/stressRunInputSet> a owl:ObjectProperty;
    rdfs:comment "optional exact RiskInputSet carrying the shocked positions and market data";
    rdfs:domain fin-risk:StressTestRun;
    rdfs:label "stress run input set";
    rdfs:range fin-risk:RiskInputSet.
<https://axiolune.ai/ontology/finance/risk/StressTestRun/role/stressRunOutput> a owl:ObjectProperty;
    rdfs:comment "exact stressed RiskMeasurement version produced by the stress run";
    rdfs:domain fin-risk:StressTestRun;
    rdfs:label "stress run output";
    rdfs:range fin-risk:RiskMeasurement.
<https://axiolune.ai/ontology/finance/risk/StressTestRun/role/stressRunPortfolio> a owl:ObjectProperty;
    rdfs:comment "logical Portfolio identity whose holdings were shocked";
    rdfs:domain fin-risk:StressTestRun;
    rdfs:label "stress run portfolio";
    rdfs:range <https://axiolune.ai/ontology/finance/portfolio-positions/Portfolio/LogicalIdentity>.
<https://axiolune.ai/ontology/finance/risk/StressTestRun/role/stressRunScenario> a owl:ObjectProperty;
