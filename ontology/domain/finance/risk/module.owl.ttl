    rdfs:comment "optional exact RiskInputSet that was shocked";
    rdfs:domain fin-risk:ScenarioApplicationEvidence;
    rdfs:label "application input set";
    rdfs:range fin-risk:RiskInputSet.
<https://axiolune.ai/ontology/finance/risk/ScenarioApplicationEvidence/role/applicationOutput> a owl:ObjectProperty;
    rdfs:comment "optional exact RiskMeasurement produced under the shock";
    rdfs:domain fin-risk:ScenarioApplicationEvidence;
    rdfs:label "application output";
    rdfs:range fin-risk:RiskMeasurement.
<https://axiolune.ai/ontology/finance/risk/ScenarioApplicationEvidence/role/applicationScenario> a owl:ObjectProperty;
    rdfs:comment "exact ScenarioDefinition applied";
    rdfs:domain fin-risk:ScenarioApplicationEvidence;
    rdfs:label "application scenario";
    rdfs:range fin-risk:ScenarioDefinition.
fin-risk:ScenarioDefinition a owl:Class;
    rdfs:comment "A Scenario Definition, is a versioned specification of a stress or what-if scenario that fixes its shock parameters independently of any stress-test run or resulting measurement, used to make a scenario reusable and reproducible across multiple runs. It carries typed ScenarioShock members (shock type, target, magnitude, unit, propagation), a scenario category, a baseline-state reference, and a narrative, so that the scenario states what it shocks and how — not only that it has a digest. The shockParameterDigest is the digest of the canonical shock-parameter payload; the sourceArtifactDigest is the digest of the original source document, linked by an explicit extraction/canonicalization relation rather than a vague \"matches\" claim.";
    rdfs:label "Scenario Definition";
    rdfs:subClassOf _:r_00326256e6f6fc1a055af272, _:r_28843b704312fd0adae7598c, _:r_28b1ef42d91c506a3c28561e, _:r_29d0c010d1a7b92d8354080a, _:r_32afa3110595613fe671afc5, _:r_465bd090fcd85f8ec7aa8f5f, _:r_5148378de23701b1c4a803b8, _:r_56f672d04da9e9f023fa954a, _:r_5be0f201d38e87153eb08df8, _:r_61cd2103731c5dddcd27ba1c, _:r_6db170f775566268c4de20a1, _:r_6f801c6cfd61991af2ca042f, _:r_95cc7622d4e79d0e64e98cc5, _:r_9fe5d29395492b23d9954e5b, _:r_a2f7a082c16d517c0575bcde, _:r_a377d2dacc3c14d5fabfafa1, _:r_a49c667d75e5fcf6198da0fa, _:r_a7e833418cf24d608ea42c4f, _:r_ca5270a863d31069d0e342d3, _:r_cafa6b8bdb265e2d5b9f0f62, _:r_d2718e626f9e8670489bad15, _:r_e740a13c8dbe53d8c1e66e19, _:r_ef5172f89b35ebeeeeddee02, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Scenario Definition versions.";
    rdfs:label "Scenario Definition logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:ScenarioShock a owl:Class;
    rdfs:comment "A Scenario Shock, is a typed shock applied to a shock target within a stress scenario, used to decompress the opaque shockParameterDigest into queryable shock parameters — shock type, target, magnitude, unit, and propagation rule — so that a scenario states what it shocks and how, not only that it has a digest.";
    rdfs:label "Scenario Shock";
    rdfs:subClassOf _:r_0c3dc2f1b78d2bc2b38becfa, _:r_606ee43c60483417c7bd2860, _:r_63bcce567ab83e0027daf43c, _:r_772f5b79e2778168442449e7, _:r_85f50c6150075d89d4e3643d, _:r_89bbd986010d7e6cb0022772, _:r_8c5342b98bd358413bbc4d00, _:r_91cc6bf44ffd3f5420cc91fe, _:r_978a98496f7d0fe7d4df9b94, _:r_beec7afa82c1562726677b81, _:r_c22728158b213cf5f5014ec7, _:r_fa935584ee90dc0c4b9bd4ba, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
