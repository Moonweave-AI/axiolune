    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:RiskScopeDefinition a owl:Class;
    rdfs:comment "A Risk Scope Definition, is a policy or business scope (desk, strategy, legal entity, fund, counterparty, netting set, asset class, or combination) that a risk limit is anchored to, used to express scope as a stable governance object rather than as an ad-hoc per-measurement tuple. It is distinct from a RiskScopeSnapshot, which freezes the concrete members at an as-of.";
    rdfs:label "Risk Scope Definition";
    rdfs:subClassOf _:r_34d1a48e98861ff8872e1485, _:r_5f1f9b71a454e792c0f3193d, _:r_8f3bccddd65c542740ee5901, _:r_8feb905b8a8470daf3d10360, _:r_e6af7fa1f35269405d2cf51f, _:r_f24ce90270606d87e6a95ba0, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Risk Scope Definition versions.";
    rdfs:label "Risk Scope Definition logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:RiskScopeSnapshot a owl:Class;
    rdfs:comment "A Risk Scope Snapshot, is the frozen concrete members of a RiskScopeDefinition at an as-of together with the selection rules that produced them, used to bind a measurement to the exact scope version evaluated rather than a free-floating policy scope.";
    rdfs:label "Risk Scope Snapshot";
    rdfs:subClassOf _:r_070803a3b6b316c3d1abe5aa, _:r_1dd3d118a63e801d0fe8bb6d, _:r_5b718512be2dc9eac8cf0564, _:r_8b082125613a4c75b836b22f, _:r_911a3dc475de3d8800fbe928, _:r_a0519d05ea3a1d3f462ee64b, _:r_c39e313793c5ce497b5e206c, _:r_cae0d630c29b40addb80d30b, _:r_f04cb5930e0b7f964be52219, _:r_f493d1adff22ac0c5602d8ac, _:r_f6a9331a760fe21200deb6e3, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/RiskScopeSnapshot/LogicalIdentity> a owl:Class;
