fin-risk:RiskMeasureSpecification a owl:Class;
    rdfs:comment "A Risk Measure Specification, is the business semantics of a risk measure — its measure kind (VaR, ES, sensitivity, PFE, liquidity gap, concentration, probability, ratio, capital requirement, other), model purpose, loss convention, aggregation method, risk-factor universe, and valuation method — used to anchor limits to a stable business concept so that a code upgrade does not implicitly force every business limit to be re-approved. It is distinct from CalculationProfile (the method/parameters) and ImplementationVersion (the executable + digest).";
    rdfs:label "Risk Measure Specification";
    rdfs:subClassOf _:r_033506667212ea565ceb5fba, _:r_08c4fb7cd5dfd65ec9492767, _:r_0fcceac14f537f6a584ad206, _:r_2b4862635633a462a2478f46, _:r_3e928ca80547b7b96a4e098f, _:r_4c424b247919a2ec8f5b7b35, _:r_67362a9e89dbee5c740b7ecc, _:r_71aca775889f47d10271aa5f, _:r_74a15475fed8615e5f3f5f5b, _:r_846bf6af19999dd9659a054b, _:r_940020d82571f6fd5094460e, _:r_94ecd59eea145881da3e2cde, _:r_a422033dc6d518914c49d1ad, _:r_b8972669eda00ccfb8c80954, _:r_c7b68552a5d97e99e90d4a09, _:r_cf8131581ffd773a94e583bf, _:r_e9a011639dc800821dcb9164, _:r_f2df0404361f16a2937613b4, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
