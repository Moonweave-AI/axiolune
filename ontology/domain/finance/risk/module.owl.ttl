    rdfs:label "Risk Calculation Context logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/risk/RiskCalculationContext/role/calcContextInputSet> a owl:ObjectProperty;
    rdfs:comment "exact RiskInputSet bound to the run";
    rdfs:domain fin-risk:RiskCalculationContext;
    rdfs:label "calc context input set";
    rdfs:range fin-risk:RiskInputSet.
<https://axiolune.ai/ontology/finance/risk/RiskCalculationContext/role/calcContextRun> a owl:ObjectProperty;
    rdfs:comment "optional RiskCalculationRun the input set is bound to";
    rdfs:domain fin-risk:RiskCalculationContext;
    rdfs:label "calc context run";
    rdfs:range fin-risk:RiskCalculationRun.
fin-risk:RiskCalculationRun a owl:Class;
    rdfs:comment "A Risk Calculation Run, is the execution of a CalculationProfile/ImplementationVersion over a RiskInputSet that produces a RiskMeasurement, used to record \"this run, these inputs, this output\" so that a measurement is traceable to the run that produced it rather than only to a definition.";
    rdfs:label "Risk Calculation Run";
    rdfs:subClassOf _:r_087e9c13711c46318c7dfc24, _:r_179fa72b2d067cea40d2561f, _:r_256a449325611b296c76683b, _:r_2f0e60cc6ecf00662566019e, _:r_4b2ae8590e7613028f4f44b9, _:r_5e719dd5d25c5ae6fe7a195c, _:r_6b0525d3b3fc55c232e1c972, _:r_76751bf0fb743b7975933653, _:r_b96882d4256d03dea9f2460c, _:r_df9a1f9de3a99a9839ec5f82, _:r_f02e73f37c07bdbd01759a36, _:r_f7a5c9538f1047d7e1b6c1e6, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
