    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/risk/RiskCalculationRun/role/calcRunImplementation> a owl:ObjectProperty;
    rdfs:comment "optional exact ImplementationVersion executed";
    rdfs:domain fin-risk:RiskCalculationRun;
    rdfs:label "calc run implementation";
    rdfs:range fin-risk:ImplementationVersion.
<https://axiolune.ai/ontology/finance/risk/RiskCalculationRun/role/calcRunInputSet> a owl:ObjectProperty;
    rdfs:comment "optional exact RiskInputSet consumed";
    rdfs:domain fin-risk:RiskCalculationRun;
    rdfs:label "calc run input set";
    rdfs:range fin-risk:RiskInputSet.
<https://axiolune.ai/ontology/finance/risk/RiskCalculationRun/role/calcRunOutput> a owl:ObjectProperty;
    rdfs:comment "optional exact RiskMeasurement produced";
    rdfs:domain fin-risk:RiskCalculationRun;
