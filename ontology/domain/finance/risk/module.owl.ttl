    skos:notation "other";
    skos:prefLabel "Other";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-risk:RiskDimension a owl:Class;
    rdfs:comment "A Risk Dimension, is an interpretable dimension along which a bucketed risk result is sliced, used to upgrade a free-text bucketKey and a bare bucketDimensionRef into a typed, queryable object so that bucket alignment and comparison across measurements and limits are well-defined.";
    rdfs:label "Risk Dimension";
    rdfs:subClassOf _:r_002e11b70983a0ce9969dec5, _:r_2b5c5ad6f67c58d06243e634, _:r_62c4e7d801b5e0fcf631c07e, _:r_64355afdc74c784ed439916e, _:r_6bdcb029314079b225b0e032, _:r_d3a9bda311c8b139d5af0f18, _:r_fbf1b6d1836d44dada226fff, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/RiskDimension/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Risk Dimension versions.";
    rdfs:label "Risk Dimension logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:RiskExposure a owl:Class;
    rdfs:comment "A Risk Exposure, is the risk an institution bears at a scope to a risk factor or category with a magnitude kind, used to state \"what risk is borne, driven by what, at which scope\" independently of a single computed number, so that exposure is a first-class concept rather than an implicit by-product of a measurement.";
    rdfs:label "Risk Exposure";
    rdfs:subClassOf _:r_0706cfd10f72536318129491, _:r_0b6c281448d49b4783db80f7, _:r_1015aa0b61ce83d36fa3dd19, _:r_4f6063de1dfa0a46e3236947, _:r_6426d9209ad533e085943d2a, _:r_b83be8b3f4bba02dc03f71d4, _:r_b86af3d8f673fbf34c0b2924, _:r_c67da491fed6bbba43ff47e1, _:r_d6cec640429ed7d305763132, _:r_d86d9d58c18e2320967dadc3, _:r_edda46da4c126226f44df22f, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/RiskExposure/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Risk Exposure versions.";
    rdfs:label "Risk Exposure logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/risk/RiskExposure/role/exposureCategory> a owl:ObjectProperty;
    rdfs:comment "optional RiskCategory classifying the exposure";
    rdfs:domain fin-risk:RiskExposure;
    rdfs:label "exposure category";
    rdfs:range fin-risk:RiskCategory.
<https://axiolune.ai/ontology/finance/risk/RiskExposure/role/exposureFactor> a owl:ObjectProperty;
    rdfs:comment "optional RiskFactor driving the exposure";
    rdfs:domain fin-risk:RiskExposure;
    rdfs:label "exposure factor";
    rdfs:range fin-risk:RiskFactor.
<https://axiolune.ai/ontology/finance/risk/RiskExposure/role/exposureScope> a owl:ObjectProperty;
    rdfs:comment "optional RiskScopeSnapshot at which the exposure is borne";
    rdfs:domain fin-risk:RiskExposure;
    rdfs:label "exposure scope";
    rdfs:range fin-risk:RiskScopeSnapshot.
fin-risk:RiskFactor a owl:Class;
    rdfs:comment "A Risk Factor, is an identifiable risk driver that a risk measure is sensitive to, used to state which factor universe moves a result independently of a single computed number. It is distinct from the strategy-research FactorDefinition (a research signal generator); a RiskFactor is a risk-management concept and references a research factor only optionally via riskFactorResearchRef.";
    rdfs:label "Risk Factor";
    rdfs:subClassOf _:r_1f94d97746d0cdc14d631d9e, _:r_30a95e527b812a15a2b36cf0, _:r_5090f51a38ef5dc5de1f535f, _:r_650f65fcadc2e7d3ca04cf2c, _:r_77121fe9c265eaf78467f564, _:r_a13ff29b3091cdd2ca79204f, _:r_ae0d4a59252bf3caed658ad7, _:r_ddfe761e8b4229d4fb920115, _:r_ecff1011910fb59045345fab, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
