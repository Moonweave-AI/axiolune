    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:RiskMeasureDefinition a owl:Class;
    rdfs:comment "A Risk Measure Definition, is the retained compatibility binding of a RiskMeasureSpecification to a CalculationProfile and an ImplementationVersion that fixes the calculation method, parameterization, input and output contracts, and exactly one Money, Quantity, or bucket-schema result dimension independently of any computed result, used to bind a risk metric to a stable, reproducible recipe. Its IRI is retained for compatibility; the audit-grade digest/contract requirements (methodDigest, implementationDigest, inputContractDigest, outputContractDigest, source-artifact evidence) are mandatory only when the ValidatedReproducibleRiskMeasurement profile is active and are otherwise optional evidence, so that preliminary and data-quality-limited definitions remain expressible. New definitions should anchor business semantics on RiskMeasureSpecification and computation on CalculationProfile/ImplementationVersion.";
    rdfs:label "Risk Measure Definition";
    rdfs:subClassOf _:r_015c5499563ae12b2891e042, _:r_04363ad390bbbe887e09897c, _:r_086f14df5867e7b6fc062653, _:r_0b3715dc3abd23a40df2f62c, _:r_17cff313f2a8d3a1e626871f, _:r_1aacfc85813faf39d80475ab, _:r_1ad1342e783f083641a23007, _:r_1bd16efcf26388a095f4195a, _:r_1f280bb827a2ac3fdaeacb43, _:r_20e76c0cdd4c3bbe0ce91bc4, _:r_318b526969526eb5f7a02a8a, _:r_388a99205500462a62d17bb0, _:r_45647fd5a161935873fb081f, _:r_481f69155678db31f60337e3, _:r_4ac3d5c591c311de5d2b244b, _:r_5a8bbb3106fb6d137941904e, _:r_676ee2d0a39dfc4dc82e8b89, _:r_6b89b4353e5230e119ead1c2, _:r_6becffe0165de89e0bcbdb0d, _:r_6c44dd2ec3dc4b293e14f003, _:r_6f2d6dbf9162d124472a6f92, _:r_6f57f207baa6a44ba2c050c3, _:r_72ce7ad4e632dfe6dd1baa91, _:r_74087375b1aa1d836a13771f, _:r_7d287fae518ef8fbfcbb09f9, _:r_834f2ead8765e1ee438d9575, _:r_835cd6b050d8f7c88f6236a4, _:r_84d657aee76b84aa1e9092d1, _:r_89133b8b9d9d8355a4ac890f, _:r_8b19005fc14a35fb4550d54f, _:r_9728a2efd1a37226b3b377eb, _:r_ae529d601490ee8fc05fff2b, _:r_af61878025803b4779e348e2, _:r_b89826a904ce0ee51cda3c8a, _:r_c1bb280c92a51b6829557c12, _:r_c347523f058e4b55166d9558, _:r_c3dab9a5dbc58b4b913f2a83, _:r_c76fd040906b8afa8cce5324, _:r_c8204900b258ec83d827762f, _:r_e45d36815673eb3a489deaf8, _:r_e55dbc8004ad35bb98b0f3aa, _:r_ec5769da56a9c219849febed, _:r_ec614dbb1af8d9934eaf9fac, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
