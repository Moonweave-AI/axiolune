    rdfs:domain fin-risk:RiskScopeSnapshot;
    rdfs:label "snapshot scope portfolio";
    rdfs:range <https://axiolune.ai/ontology/finance/portfolio-positions/Portfolio/LogicalIdentity>.
fin-risk:RiskSource a owl:Class;
    rdfs:comment "A Risk Source, is an identifiable origin or driver of risk that belongs to one Risk Category, used to state what gives rise to a risk independently of how it is measured, so that risk can be attributed to its cause rather than only to its numeric result.";
    rdfs:label "Risk Source";
    rdfs:subClassOf _:r_138f87ce3780497268122723, _:r_3304e9ce5e54a379ef215950, _:r_46638edc363f74f40f57fd0e, _:r_9dbe7e87b166651ec0006109, _:r_f59ef4403bb019c6fcba7233, _:r_f9fd6b4afc6316b0a21d7179, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
