    skos:prefLabel "Concentration Risk";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/risk/RiskCategoryValue/value/credit> a owl:NamedIndividual, skos:Concept, fin-risk:RiskCategoryValue;
    rdfs:comment "risk of loss from a counterparty or obligor failure to perform";
    skos:inScheme <https://axiolune.ai/ontology/finance/risk/RiskCategoryValue/scheme>;
    skos:notation "credit";
    skos:prefLabel "Credit Risk";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/risk/RiskCategoryValue/value/liquidity> a owl:NamedIndividual, skos:Concept, fin-risk:RiskCategoryValue;
    rdfs:comment "risk of being unable to meet obligations as they fall due";
    skos:inScheme <https://axiolune.ai/ontology/finance/risk/RiskCategoryValue/scheme>;
    skos:notation "liquidity";
    skos:prefLabel "Liquidity Risk";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/risk/RiskCategoryValue/value/market> a owl:NamedIndividual, skos:Concept, fin-risk:RiskCategoryValue;
    rdfs:comment "risk arising from movements in market prices";
    skos:inScheme <https://axiolune.ai/ontology/finance/risk/RiskCategoryValue/scheme>;
    skos:notation "market";
    skos:prefLabel "Market Risk";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/risk/RiskCategoryValue/value/model> a owl:NamedIndividual, skos:Concept, fin-risk:RiskCategoryValue;
