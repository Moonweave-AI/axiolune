fin-risk:acknowledgedAt a owl:DatatypeProperty;
    rdfs:comment "The Acknowledged At, is the instant at which a breach case was acknowledged.";
    rdfs:label "Acknowledged At";
    rdfs:range xsd:dateTimeStamp.
fin-risk:acknowledgementId a owl:DatatypeProperty;
    rdfs:comment "The Acknowledgement ID, is a stable lexical identifier of a BreachAcknowledgement.";
    rdfs:label "Acknowledgement ID";
    rdfs:range xsd:string.
fin-risk:aggregationMethod a owl:DatatypeProperty;
    rdfs:comment "The Aggregation Method, is how risk is aggregated from position to portfolio/desk/entity/group (sum, variance-covariance, historical simulation, Monte Carlo, other).";
    rdfs:label "Aggregation Method";
    rdfs:range xsd:string.
fin-risk:applicationEvidenceId a owl:DatatypeProperty;
    rdfs:comment "The Application Evidence ID, is a stable lexical identifier of a ScenarioApplicationEvidence.";
    rdfs:label "Application Evidence ID";
    rdfs:range xsd:string.
fin-risk:applicationProofDigest a owl:DatatypeProperty;
    rdfs:comment "The Application Proof Digest, is an optional SHA-256 digest of the proof that the scenario was applied to the input context.";
    rdfs:label "Application Proof Digest";
    rdfs:range xsd:string.
fin-risk:approvalDecisionDigest a owl:DatatypeProperty;
    rdfs:comment "The Approval Decision Digest, is the SHA-256 digest of the exact limit-approval decision record, used to fix the true content of an approval decision by content fingerprint to support audit traceability";
    rdfs:label "Approval Decision Digest";
    rdfs:range xsd:string.
fin-risk:approvalDecisionRef a owl:DatatypeProperty;
    rdfs:comment "The Approval Decision Reference, is an absolute immutable reference to the human or governed limit-approval decision, used to bind a risk limit to the formal approval record it came from";
    rdfs:label "Approval Decision Reference";
    rdfs:range xsd:anyURI.
fin-risk:approvedAt a owl:DatatypeProperty;
    rdfs:comment "The Approved At, is an explicit-timezone instant at which the limit version was approved, used to record the approval point in time at which a risk limit takes effect with a deterministic timestamp";
    rdfs:label "Approved At";
    rdfs:range xsd:dateTimeStamp.
fin-risk:approvedBy a owl:DatatypeProperty;
    rdfs:comment "The Approved By, is an absolute principal IRI that approved the limit version, used to identify the governance entity accountable for approving the risk threshold";
    rdfs:label "Approved By";
    rdfs:range xsd:anyURI.
fin-risk:baselineStateRef a owl:DatatypeProperty;
    rdfs:comment "The Baseline State Reference, is an optional reference to the baseline state a scenario shocks.";
    rdfs:label "Baseline State Reference";
    rdfs:range xsd:anyURI.
fin-risk:benchmarkRef a owl:DatatypeProperty;
    rdfs:comment "The Benchmark Reference, is an optional absolute reference to the benchmark version used by the measure, used to bind a risk measure to the benchmark it is measured against";
    rdfs:label "Benchmark Reference";
    rdfs:range xsd:anyURI.
fin-risk:breachCaseId a owl:DatatypeProperty;
    rdfs:comment "The Breach Case ID, is a stable lexical identifier of a RiskLimitBreachCase.";
    rdfs:label "Breach Case ID";
    rdfs:range xsd:string.
fin-risk:breachCaseStatus a owl:ObjectProperty;
    rdfs:comment "The Breach Case Status, is the workflow status of a RiskLimitBreachCase (open, acknowledged, remediated, waived, escalated, closed, reopened).";
    rdfs:label "Breach Case Status";
    rdfs:range fin-risk:BreachCaseStatus.
fin-risk:breachDuration a owl:ObjectProperty;
    rdfs:comment "The Breach Duration, is the duration for which the breach persisted.";
    rdfs:label "Breach Duration";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:breachMagnitude a owl:ObjectProperty;
    rdfs:comment "The Breach Magnitude, is the magnitude by which the limit was breached.";
    rdfs:label "Breach Magnitude";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:bucketComparisonMode a owl:ObjectProperty;
    rdfs:comment "The Bucket Comparison Mode, is how a bucket measurement is compared to a bucket limit (perBucket, aggregate, perBucketAndAggregate, anyBucket, allBuckets).";
    rdfs:label "Bucket Comparison Mode";
    rdfs:range fin-risk:BucketComparisonMode.
fin-risk:bucketDefinitionId a owl:DatatypeProperty;
    rdfs:comment "The Bucket Definition ID, is a stable lexical identifier of a BucketDefinition.";
    rdfs:label "Bucket Definition ID";
    rdfs:range xsd:string.
fin-risk:bucketDefinitionKey a owl:DatatypeProperty;
    rdfs:comment "The Bucket Definition Key, is the canonical non-blank key identifying a bucket within a schema.";
    rdfs:label "Bucket Definition Key";
    rdfs:range xsd:string.
fin-risk:bucketDefinitionLabel a owl:DatatypeProperty;
    rdfs:comment "The Bucket Definition Label, is an optional human-readable label of a BucketDefinition.";
    rdfs:label "Bucket Definition Label";
    rdfs:range xsd:string.
fin-risk:bucketDimensionRef a owl:DatatypeProperty;
    rdfs:comment "The Bucket Dimension Reference, is an absolute reference that identifies the dimension partitioned by the bucket schema, used to state which risk dimension a bucketed result is sliced along";
    rdfs:label "Bucket Dimension Reference";
    rdfs:range xsd:anyURI.
fin-risk:bucketKey a owl:DatatypeProperty;
    rdfs:comment "The Bucket Key, is a canonical non-blank key that identifies one member within a bucket schema, used to distinguish the measurement value of different buckets within a bucket set";
    rdfs:label "Bucket Key";
    rdfs:range xsd:string.
fin-risk:bucketKeyContractDigest a owl:DatatypeProperty;
    rdfs:comment "The Bucket Key Contract Digest, is the SHA-256 digest of the canonical bucket-key set and ordering contract, used to fix the admissible set and order of bucket keys by content fingerprint";
    rdfs:label "Bucket Key Contract Digest";
    rdfs:range xsd:string.
fin-risk:bucketQuantity a owl:ObjectProperty;
    rdfs:comment "The Bucket Quantity, is a required structured Quantity scalar for one risk bucket, used to carry that bucket's measured value along the bucket dimension";
    rdfs:label "Bucket Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:bucketSchemaBucketDefinition a owl:ObjectProperty;
    rdfs:comment "The Bucket Schema Bucket Definition, is a typed BucketDefinition admitted by a RiskBucketSchema, used to upgrade free-text bucket keys into typed, interpretable bucket objects.";
    rdfs:domain fin-risk:RiskBucketSchema;
    rdfs:label "Bucket Schema Bucket Definition";
    rdfs:range <https://axiolune.ai/ontology/finance/risk/BucketDefinition/LogicalIdentity>.
fin-risk:bucketSchemaDimension a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "The Bucket Schema Dimension, is the typed RiskDimension that a RiskBucketSchema slices along, used to upgrade the bare bucketDimensionRef into a typed, queryable dimension.";
    rdfs:domain fin-risk:RiskBucketSchema;
    rdfs:label "Bucket Schema Dimension";
    rdfs:range <https://axiolune.ai/ontology/finance/risk/RiskDimension/LogicalIdentity>.
fin-risk:bucketSchemaId a owl:DatatypeProperty;
    rdfs:comment "The Bucket Schema ID, is a stable lexical identifier of a risk bucket schema, used to index one bucket-structure specification uniquely while its schema version stays immutable";
    rdfs:label "Bucket Schema ID";
    rdfs:range xsd:string.
fin-risk:bucketSetId a owl:DatatypeProperty;
    rdfs:comment "The Bucket Set ID, is a generating-context-scoped stable lexical identifier of a bucket set, used to index one complete bucketed result uniquely once the set is closed";
    rdfs:label "Bucket Set ID";
    rdfs:range xsd:string.
fin-risk:bucketSetPurpose a owl:ObjectProperty;
    rdfs:comment "The Bucket Set Purpose, distinguishes a measurement-side bucket result set from a limit-side bucket schedule, used so the same structure is not silently reused as both a value and a threshold.";
    rdfs:label "Bucket Set Purpose";
    rdfs:range fin-risk:BucketSetPurpose.
fin-risk:bucketSetSchema a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "The Bucket Set Schema, is the exact RiskBucketSchema version that governs one complete RiskBucketSet version, used to ensure that every bucket value in the set shares the same dimension, key contract, and unit";
    rdfs:domain fin-risk:RiskBucketSet;
    rdfs:label "Bucket Set Schema";
    rdfs:range fin-risk:RiskBucketSchema.
fin-risk:bucketUnit a owl:DatatypeProperty;
    rdfs:comment "The Bucket Unit, is a Quantity unit IRI that is shared by every scalar value governed by the bucket schema, used to ensure all buckets in one bucket set are measured in a consistent unit";
    rdfs:label "Bucket Unit";
    rdfs:range xsd:anyURI.
fin-risk:bucketValueCount a owl:DatatypeProperty;
    rdfs:comment "The Bucket Value Count, is the exact count of current RiskBucketValue versions in the completed closure, used to prove a bucket set contains every current bucket value without omission";
    rdfs:label "Bucket Value Count";
    rdfs:range xsd:integer.
fin-risk:bucketValueDimensionRef a owl:DatatypeProperty;
    rdfs:comment "The Bucket Value Dimension Reference, is a dimension reference copied from the exact governing RiskBucketSchema version, used to keep a bucket value dimensionally consistent with its schema at the value level";
    rdfs:label "Bucket Value Dimension Reference";
    rdfs:range xsd:anyURI.
fin-risk:bucketValueSetDigest a owl:DatatypeProperty;
    rdfs:comment "The Bucket Value Set Digest, is the SHA-256 digest of the canonical ordered set of current bucket-value version IRIs, used to fix the reproducible snapshot of set membership by content fingerprint";
    rdfs:label "Bucket Value Set Digest";
    rdfs:range xsd:string.
fin-risk:calcContextId a owl:DatatypeProperty;
    rdfs:comment "The Calculation Context ID, is a stable lexical identifier of a RiskCalculationContext.";
    rdfs:label "Calculation Context ID";
    rdfs:range xsd:string.
fin-risk:calcRunId a owl:DatatypeProperty;
    rdfs:comment "The Calculation Run ID, is a stable lexical identifier of a RiskCalculationRun.";
    rdfs:label "Calculation Run ID";
    rdfs:range xsd:string.
fin-risk:calculationProfileId a owl:DatatypeProperty;
    rdfs:comment "The Calculation Profile ID, is a stable lexical identifier of a CalculationProfile.";
    rdfs:label "Calculation Profile ID";
    rdfs:range xsd:string.
fin-risk:calculationProfileImplementation a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "The Calculation Profile Implementation, is the ImplementationVersion bound to a CalculationProfile, used to bind a method profile to the exact executable implementation that realizes it.";
    rdfs:domain fin-risk:CalculationProfile;
    rdfs:label "Calculation Profile Implementation";
    rdfs:range fin-risk:ImplementationVersion.
fin-risk:calculationProfileName a owl:DatatypeProperty;
    rdfs:comment "The Calculation Profile Name, is an optional human-readable name of a CalculationProfile.";
    rdfs:label "Calculation Profile Name";
    rdfs:range xsd:string.
fin-risk:closureCompleted a owl:DatatypeProperty;
    rdfs:comment "The Closure Completed flag, is a boolean that is true only when the exact bucket-membership closure probe completed successfully, used to declare explicitly that a bucket set's membership has been verified as closed";
    rdfs:label "Closure Completed";
    rdfs:range xsd:boolean.
fin-risk:closureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "The Closure Probe Digest, is the SHA-256 digest of the executable closure probe and its frozen parameters, used to fix the true identity of the completeness probe by content fingerprint";
    rdfs:label "Closure Probe Digest";
    rdfs:range xsd:string.
fin-risk:closureProbeRef a owl:DatatypeProperty;
    rdfs:comment "The Closure Probe Reference, is an absolute reference to the executable completeness probe invocation, used to point at the execution record that proves a bucket set's membership is complete";
    rdfs:label "Closure Probe Reference";
    rdfs:range xsd:anyURI.
fin-risk:comparisonBasis a owl:DatatypeProperty;
    rdfs:comment "The Comparison Basis, is the basis on which a RiskLimitRule compares (net exposure, gross exposure, utilization, concentration ratio, absolute value).";
    rdfs:label "Comparison Basis";
    rdfs:range xsd:string.
fin-risk:comparisonOperator a owl:ObjectProperty;
    rdfs:comment "The Comparison Operator, is the operator a RiskLimitRule applies (le, ge, lt, gt, withinBand, outsideBand, absoluteValueLe, absoluteValueGe).";
    rdfs:label "Comparison Operator";
    rdfs:range fin-risk:ComparisonOperator.
fin-risk:comparisonPolicyId a owl:DatatypeProperty;
    rdfs:comment "The Comparison Policy ID, is a stable lexical identifier of a RiskLimitComparisonPolicy.";
    rdfs:label "Comparison Policy ID";
    rdfs:range xsd:string.
fin-risk:comparisonTolerance a owl:ObjectProperty;
    rdfs:comment "The Comparison Tolerance, is the tolerance applied in a limit comparison.";
    rdfs:label "Comparison Tolerance";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:confidenceLevel a owl:ObjectProperty;
    rdfs:comment "The Confidence Level, is an optional dimensionless Quantity confidence level that is required by a statistical risk measure, used to express the probability that a result falls within a stated interval";
    rdfs:label "Confidence Level";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:definitionAuthority a owl:DatatypeProperty;
    rdfs:comment "The Definition Authority, is the authority that scopes a RiskMeasureDefinition's identity, used to prevent identifier collisions across institutions.";
    rdfs:label "Definition Authority";
    rdfs:range xsd:anyURI.
fin-risk:definitionBucketSchema a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "The Definition Bucket Schema, is an optional bucket-branch RiskBucketSchema version that is fixed by a RiskMeasureDefinition, used to bind a bucketed risk result to the bucket structure it must conform to";
    rdfs:domain fin-risk:RiskMeasureDefinition;
    rdfs:label "Definition Bucket Schema";
    rdfs:range fin-risk:RiskBucketSchema.
fin-risk:definitionCurrency a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "The Definition Currency, is an optional Money-branch Currency logical identity that is fixed by a RiskMeasureDefinition version, used to specify the currency in which a money-valued risk result is denominated";
    rdfs:domain fin-risk:RiskMeasureDefinition;
    rdfs:label "Definition Currency";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Currency/LogicalIdentity>.
fin-risk:definitionUnit a owl:DatatypeProperty;
    rdfs:comment "The Definition Unit, is an optional Quantity-branch unit IRI that is fixed by a RiskMeasureDefinition version, used to specify the unit of measure for a quantity-valued risk result";
    rdfs:label "Definition Unit";
    rdfs:range xsd:anyURI.
fin-risk:effectiveAt a owl:DatatypeProperty;
    rdfs:comment "The Effective At, is the instant at which a RiskLimit actually takes effect, distinct from approvedAt.";
    rdfs:label "Effective At";
    rdfs:range xsd:dateTimeStamp.
fin-risk:escalatedAt a owl:DatatypeProperty;
    rdfs:comment "The Escalated At, is the instant at which an EscalationEvent occurred.";
    rdfs:label "Escalated At";
    rdfs:range xsd:dateTimeStamp.
fin-risk:escalationId a owl:DatatypeProperty;
    rdfs:comment "The Escalation ID, is a stable lexical identifier of an EscalationEvent.";
    rdfs:label "Escalation ID";
    rdfs:range xsd:string.
fin-risk:escalationLevel a owl:DatatypeProperty;
    rdfs:comment "The Escalation Level, is the governance level an EscalationEvent escalates to.";
    rdfs:label "Escalation Level";
    rdfs:range xsd:string.
fin-risk:escalationTarget a owl:DatatypeProperty;
    rdfs:comment "The Escalation Target, is the optional target entity of an EscalationEvent.";
    rdfs:label "Escalation Target";
    rdfs:range xsd:anyURI.
fin-risk:evaluationReason a owl:DatatypeProperty;
    rdfs:comment "The Evaluation Reason, is an optional deterministic reason that explains an indeterminate evaluation, used to state why the evidence was insufficient to reach a withinLimit or breach conclusion";
    rdfs:label "Evaluation Reason";
    rdfs:range xsd:string.
fin-risk:evaluationResult a owl:ObjectProperty;
    rdfs:comment "The Evaluation Result, is a required closed result code of a risk-limit evaluation, used to express a withinLimit, breach, or indeterminate conclusion as a definite code value rather than as an absence";
    rdfs:label "Evaluation Result";
    rdfs:range fin-risk:RiskLimitEvaluationResult.
fin-risk:evaluatorDigest a owl:DatatypeProperty;
    rdfs:comment "The Evaluator Digest, is the SHA-256 digest of the executable comparison implementation, used to fix the true identity of the measurement-to-limit comparison algorithm by content fingerprint";
    rdfs:label "Evaluator Digest";
    rdfs:range xsd:string.
fin-risk:exposureMagnitudeKind a owl:DatatypeProperty;
    rdfs:comment "The Exposure Magnitude Kind, is the kind of magnitude a RiskExposure carries (notional, market value, delta, present value, other).";
    rdfs:label "Exposure Magnitude Kind";
    rdfs:range xsd:string.
fin-risk:fxPolicyRef a owl:DatatypeProperty;
    rdfs:comment "The FX Policy Reference, is an optional reference to the FX conversion policy applied to inputs.";
    rdfs:label "FX Policy Reference";
    rdfs:range xsd:anyURI.
fin-risk:implementationAuthority a owl:DatatypeProperty;
    rdfs:comment "The Implementation Authority, is the authority that scopes an ImplementationVersion's identity.";
    rdfs:label "Implementation Authority";
    rdfs:range xsd:anyURI.
fin-risk:implementationDigest a owl:DatatypeProperty;
    rdfs:comment "The Implementation Digest, is the SHA-256 digest of the executable implementation selected by the definition, used to fix the true identity of the algorithm implementation by content fingerprint to support point-in-time reproducibility";
    rdfs:label "Implementation Digest";
    rdfs:range xsd:string.
fin-risk:implementationVersionId a owl:DatatypeProperty;
    rdfs:comment "The Implementation Version ID, is a stable lexical identifier of an ImplementationVersion.";
    rdfs:label "Implementation Version ID";
    rdfs:range xsd:string.
fin-risk:implementationVersionLabel a owl:DatatypeProperty;
    rdfs:comment "The Implementation Version Label, is the immutable version label of an ImplementationVersion.";
    rdfs:label "Implementation Version Label";
    rdfs:range xsd:string.
fin-risk:inputContextCompleted a owl:DatatypeProperty;
    rdfs:comment "The Input Context Completed flag, is a boolean that is true only when the strictly prior input-context record is complete and immutable, used to declare explicitly that a measurement's inputs are frozen and reproducible";
    rdfs:label "Input Context Completed";
    rdfs:range xsd:boolean.
fin-risk:inputContractDigest a owl:DatatypeProperty;
    rdfs:comment "The Input Contract Digest, is the SHA-256 digest of the canonical risk-model input contract, used to fix the input data structure a measure definition declares by content fingerprint";
    rdfs:label "Input Contract Digest";
    rdfs:range xsd:string.
fin-risk:inputDataQualityStatus a owl:DatatypeProperty;
    rdfs:comment "The Input Data Quality Status, is the data-quality status of a RiskInputSet (complete, partial, stale, missing, uncertain).";
    rdfs:label "Input Data Quality Status";
    rdfs:range xsd:string.
fin-risk:inputParameterSetRef a owl:DatatypeProperty;
    rdfs:comment "The Input Parameter Set Reference, is an optional reference to the parameter set used.";
    rdfs:label "Input Parameter Set Reference";
    rdfs:range xsd:anyURI.
fin-risk:inputValuationAsOf a owl:DatatypeProperty;
    rdfs:comment "The Input Valuation As Of, is the valuation as-of time of the inputs in a RiskInputSet.";
    rdfs:label "Input Valuation As Of";
    rdfs:range xsd:dateTimeStamp.
fin-risk:limitId a owl:DatatypeProperty;
    rdfs:comment "The Limit ID, is an owner-scoped stable lexical identifier of a risk limit, used to index one limit-threshold fact uniquely after the limit version is approved";
    rdfs:label "Limit ID";
    rdfs:range xsd:string.
fin-risk:limitMoney a owl:ObjectProperty;
    rdfs:comment "The Limit Money, is an optional canonical Money threshold that is selected by the limit value xone, used to carry the monetary upper bound of a risk limit on the money threshold branch";
    rdfs:label "Limit Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-risk:limitQuantity a owl:ObjectProperty;
    rdfs:comment "The Limit Quantity, is an optional canonical Quantity threshold that is selected by the limit value xone, used to carry the non-monetary upper bound of a risk limit on the quantity threshold branch";
    rdfs:label "Limit Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:limitSeverity a owl:ObjectProperty;
    rdfs:comment "The Limit Severity, is the severity of a RiskLimitRule (warning, soft, hard).";
    rdfs:label "Limit Severity";
    rdfs:range fin-risk:LimitSeverity.
fin-risk:lossConvention a owl:DatatypeProperty;
    rdfs:comment "The Loss Convention, is how the result expresses loss (loss-as-positive, gain-as-positive, absolute value, net exposure, probability, ratio).";
    rdfs:label "Loss Convention";
    rdfs:range xsd:string.
fin-risk:lowerThresholdMoney a owl:ObjectProperty;
    rdfs:comment "The Lower Threshold Money, is an optional Money lower bound of a RiskLimitRule.";
    rdfs:label "Lower Threshold Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-risk:lowerThresholdQuantity a owl:ObjectProperty;
    rdfs:comment "The Lower Threshold Quantity, is an optional Quantity lower bound of a RiskLimitRule.";
    rdfs:label "Lower Threshold Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:measureSpecificationAuthority a owl:DatatypeProperty;
    rdfs:comment "The Measure Specification Authority, is the authority that scopes a RiskMeasureSpecification's identity, used to prevent identifier collisions across institutions.";
    rdfs:label "Measure Specification Authority";
    rdfs:range xsd:anyURI.
fin-risk:measureSpecificationProfile a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "The Measure Specification Profile, is the CalculationProfile bound to a RiskMeasureSpecification, used to bind business semantics to a concrete calculation method profile.";
    rdfs:domain fin-risk:RiskMeasureSpecification;
    rdfs:label "Measure Specification Profile";
    rdfs:range fin-risk:CalculationProfile.
fin-risk:measuredMoney a owl:ObjectProperty;
    rdfs:comment "The Measured Money, is an optional canonical Money result that is selected by the measurement value xone, used to carry the monetary value of a risk measurement on the money result branch";
    rdfs:label "Measured Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-risk:measuredQuantity a owl:ObjectProperty;
    rdfs:comment "The Measured Quantity, is an optional canonical Quantity result that is selected by the measurement value xone, used to carry the non-monetary value of a risk measurement on the quantity result branch";
    rdfs:label "Measured Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:measurementStatus a owl:ObjectProperty;
    rdfs:comment "The Measurement Status, is the status of a risk measurement (preliminary, incomplete, revised, failed, estimated, validated), used so non-audit-grade results are expressible.";
    rdfs:label "Measurement Status";
    rdfs:range fin-risk:RiskMeasurementStatus.
fin-risk:methodDigest a owl:DatatypeProperty;
    rdfs:comment "The Method Digest, is the SHA-256 digest of the method specification selected by the definition, used to fix the true identity of the algorithm implementation by content fingerprint beyond a version label";
    rdfs:label "Method Digest";
    rdfs:range xsd:string.
fin-risk:methodRef a owl:DatatypeProperty;
    rdfs:comment "The Method Reference, is an absolute reference that identifies the declared calculation method, used to point a risk-measure definition at the algorithmic source it depends on";
    rdfs:label "Method Reference";
    rdfs:range xsd:anyURI.
fin-risk:methodVersion a owl:DatatypeProperty;
    rdfs:comment "The Method Version, is an immutable version label of the declared calculation method, used to pin the exact algorithm version a measure definition references when the method is iterated";
    rdfs:label "Method Version";
    rdfs:range xsd:string.
fin-risk:missingBucketHandling a owl:ObjectProperty;
    rdfs:comment "The Missing Bucket Handling, is how a missing bucket is treated in comparison (failClosed, treatAsZero, ignore, indeterminate).";
    rdfs:label "Missing Bucket Handling";
    rdfs:range fin-risk:MissingBucketHandling.
fin-risk:modelPurpose a owl:DatatypeProperty;
    rdfs:comment "The Model Purpose, is the intended use of the risk model (regulatory capital, internal limit monitoring, economic capital, stress, disclosure).";
    rdfs:label "Model Purpose";
    rdfs:range xsd:string.
fin-risk:observationWindow a owl:ObjectProperty;
    rdfs:comment "The Observation Window, is an optional Quantity-valued historical observation window that is used by the method, used to bound the historical data span on which a risk measure is based";
    rdfs:label "Observation Window";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:outputContractDigest a owl:DatatypeProperty;
    rdfs:comment "The Output Contract Digest, is the SHA-256 digest of the canonical risk-model output contract, used to fix the output result structure a measure definition declares by content fingerprint";
    rdfs:label "Output Contract Digest";
    rdfs:range xsd:string.
fin-risk:remediationEvidence a owl:DatatypeProperty;
    rdfs:comment "The Remediation Evidence, is an optional reference to the evidence of a RemediationAction.";
    rdfs:label "Remediation Evidence";
    rdfs:range xsd:anyURI.
fin-risk:remediationId a owl:DatatypeProperty;
    rdfs:comment "The Remediation ID, is a stable lexical identifier of a RemediationAction.";
    rdfs:label "Remediation ID";
    rdfs:range xsd:string.
fin-risk:remediationKind a owl:ObjectProperty;
    rdfs:comment "The Remediation Kind, is the kind of remediation (exposureReduction, limitAdjustment, dataCorrection, positionCloseout).";
    rdfs:label "Remediation Kind";
    rdfs:range fin-risk:RemediationKind.
fin-risk:reportAsOf a owl:DatatypeProperty;
    rdfs:comment "The Report As Of, is the as-of time of a RiskReport.";
    rdfs:label "Report As Of";
    rdfs:range xsd:dateTimeStamp.
fin-risk:reportAudience a owl:DatatypeProperty;
    rdfs:comment "The Report Audience, is the intended audience of a RiskReport (board, regulator, risk committee, management).";
    rdfs:label "Report Audience";
    rdfs:range xsd:string.
fin-risk:riskAppetiteId a owl:DatatypeProperty;
    rdfs:comment "The Risk Appetite ID, is a stable lexical identifier of a RiskAppetite.";
    rdfs:label "Risk Appetite ID";
    rdfs:range xsd:string.
fin-risk:riskAppetiteQuantitativeRef a owl:DatatypeProperty;
    rdfs:comment "The Risk Appetite Quantitative Reference, is an optional reference to the quantitative limits operationalizing a RiskAppetite.";
    rdfs:label "Risk Appetite Quantitative Reference";
    rdfs:range xsd:anyURI.
fin-risk:riskAppetiteStatement a owl:DatatypeProperty;
    rdfs:comment "The Risk Appetite Statement, is a qualitative statement of the risk an institution is willing to bear.";
    rdfs:label "Risk Appetite Statement";
    rdfs:range xsd:string.
fin-risk:riskCategoryName a owl:DatatypeProperty;
    rdfs:comment "The Risk Category Name, is an optional human-readable name of a RiskCategory.";
    rdfs:label "Risk Category Name";
    rdfs:range xsd:string.
fin-risk:riskCategoryValue a owl:ObjectProperty;
    rdfs:comment "The Risk Category Value, is a closed classification value of the kind of risk, used to categorize measures, limits, exposures, and scenarios.";
    rdfs:label "Risk Category Value";
    rdfs:range fin-risk:RiskCategoryValue.
fin-risk:riskDimensionFactorRef a owl:DatatypeProperty;
    rdfs:comment "The Risk Dimension Factor Reference, is an optional reference to the RiskFactor a dimension partitions, used to tie a bucket dimension to its driving factor.";
    rdfs:label "Risk Dimension Factor Reference";
    rdfs:range xsd:anyURI.
fin-risk:riskDimensionId a owl:DatatypeProperty;
    rdfs:comment "The Risk Dimension ID, is a stable lexical identifier of a RiskDimension.";
    rdfs:label "Risk Dimension ID";
    rdfs:range xsd:string.
fin-risk:riskDimensionName a owl:DatatypeProperty;
    rdfs:comment "The Risk Dimension Name, is an optional human-readable name of a RiskDimension.";
    rdfs:label "Risk Dimension Name";
    rdfs:range xsd:string.
fin-risk:riskExposureId a owl:DatatypeProperty;
    rdfs:comment "The Risk Exposure ID, is a stable lexical identifier of a RiskExposure.";
    rdfs:label "Risk Exposure ID";
    rdfs:range xsd:string.
fin-risk:riskFactorCategory a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "The Risk Factor Category, is the RiskCategory a RiskFactor belongs to, used to classify a factor by the kind of risk it drives.";
    rdfs:domain fin-risk:RiskFactor;
    rdfs:label "Risk Factor Category";
    rdfs:range <https://axiolune.ai/ontology/finance/risk/RiskCategory/LogicalIdentity>.
fin-risk:riskFactorId a owl:DatatypeProperty;
    rdfs:comment "The Risk Factor ID, is a stable lexical identifier of a RiskFactor.";
    rdfs:label "Risk Factor ID";
    rdfs:range xsd:string.
fin-risk:riskFactorName a owl:DatatypeProperty;
    rdfs:comment "The Risk Factor Name, is an optional human-readable name of a RiskFactor.";
    rdfs:label "Risk Factor Name";
    rdfs:range xsd:string.
fin-risk:riskFactorResearchRef a owl:DatatypeProperty;
    rdfs:comment "The Risk Factor Research Reference, is an optional reference to a strategy-research FactorDefinition when a risk factor corresponds to a research signal generator, used to keep risk-management and research factor concepts distinct while allowing cross-linking.";
    rdfs:label "Risk Factor Research Reference";
    rdfs:range xsd:anyURI.
fin-risk:riskHorizon a owl:ObjectProperty;
    rdfs:comment "The Risk Horizon, is an optional duration Quantity over which the risk result is interpreted, used to state the future time length a measurement covers";
    rdfs:label "Risk Horizon";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:riskInputSetId a owl:DatatypeProperty;
    rdfs:comment "The Risk Input Set ID, is a stable lexical identifier of a RiskInputSet.";
    rdfs:label "Risk Input Set ID";
    rdfs:range xsd:string.
fin-risk:riskLimitLifecycleStatus a owl:ObjectProperty;
    rdfs:comment "The Risk Limit Lifecycle Status, is the lifecycle status of a RiskLimitRule (effective, suspended, superseded).";
    rdfs:label "Risk Limit Lifecycle Status";
    rdfs:range fin-risk:RiskLimitLifecycleStatus.
fin-risk:riskLimitRuleId a owl:DatatypeProperty;
    rdfs:comment "The Risk Limit Rule ID, is a stable lexical identifier of a RiskLimitRule.";
    rdfs:label "Risk Limit Rule ID";
    rdfs:range xsd:string.
fin-risk:riskMeasureCategoryRef a owl:DatatypeProperty;
    rdfs:comment "The Risk Measure Category Reference, is an optional reference to the RiskCategory a measure belongs to.";
    rdfs:label "Risk Measure Category Reference";
    rdfs:range xsd:anyURI.
fin-risk:riskMeasureId a owl:DatatypeProperty;
    rdfs:comment "The Risk Measure ID, is an authority-scoped stable lexical identifier of a risk-measure definition, used to index one risk-measure specification uniquely while its definition version stays immutable";
    rdfs:label "Risk Measure ID";
    rdfs:range xsd:string.
fin-risk:riskMeasureKind a owl:ObjectProperty;
    rdfs:comment "The Risk Measure Kind, is the kind of risk measure (VaR, ES, sensitivity, PFE, liquidity gap, concentration, probability, ratio, capital requirement, other), used to make a measure's business kind queryable rather than hidden in a method reference.";
    rdfs:label "Risk Measure Kind";
    rdfs:range fin-risk:RiskMeasureKind.
fin-risk:riskMeasureSpecificationId a owl:DatatypeProperty;
    rdfs:comment "The Risk Measure Specification ID, is a stable lexical identifier of a RiskMeasureSpecification.";
    rdfs:label "Risk Measure Specification ID";
    rdfs:range xsd:string.
fin-risk:riskReportId a owl:DatatypeProperty;
    rdfs:comment "The Risk Report ID, is a stable lexical identifier of a RiskReport.";
    rdfs:label "Risk Report ID";
    rdfs:range xsd:string.
fin-risk:riskScopeDescription a owl:DatatypeProperty;
    rdfs:comment "The Risk Scope Description, is an optional human-readable description of a RiskScopeDefinition.";
    rdfs:label "Risk Scope Description";
    rdfs:range xsd:string.
fin-risk:riskScopeId a owl:DatatypeProperty;
    rdfs:comment "The Risk Scope ID, is a stable lexical identifier of a RiskScopeDefinition.";
    rdfs:label "Risk Scope ID";
    rdfs:range xsd:string.
fin-risk:riskScopeKind a owl:DatatypeProperty;
    rdfs:comment "The Risk Scope Kind, is the kind of business scope (desk, strategy, legal entity, fund, counterparty, netting set, asset class, or combination).";
    rdfs:label "Risk Scope Kind";
    rdfs:range xsd:string.
fin-risk:riskScopeSnapshotId a owl:DatatypeProperty;
    rdfs:comment "The Risk Scope Snapshot ID, is a stable lexical identifier of a RiskScopeSnapshot.";
    rdfs:label "Risk Scope Snapshot ID";
    rdfs:range xsd:string.
fin-risk:riskSourceCategory a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "The Risk Source Category, is the RiskCategory a RiskSource belongs to, used to classify a source by the kind of risk it gives rise to.";
    rdfs:domain fin-risk:RiskSource;
    rdfs:label "Risk Source Category";
    rdfs:range <https://axiolune.ai/ontology/finance/risk/RiskCategory/LogicalIdentity>.
fin-risk:riskSourceId a owl:DatatypeProperty;
    rdfs:comment "The Risk Source ID, is a stable lexical identifier of a RiskSource.";
    rdfs:label "Risk Source ID";
    rdfs:range xsd:string.
fin-risk:riskSourceName a owl:DatatypeProperty;
    rdfs:comment "The Risk Source Name, is an optional human-readable name of a RiskSource.";
    rdfs:label "Risk Source Name";
    rdfs:range xsd:string.
fin-risk:riskToleranceBasis a owl:DatatypeProperty;
    rdfs:comment "The Risk Tolerance Basis, is the basis on which a RiskTolerance is expressed.";
    rdfs:label "Risk Tolerance Basis";
    rdfs:range xsd:string.
fin-risk:riskToleranceId a owl:DatatypeProperty;
    rdfs:comment "The Risk Tolerance ID, is a stable lexical identifier of a RiskTolerance.";
    rdfs:label "Risk Tolerance ID";
    rdfs:range xsd:string.
fin-risk:riskToleranceMagnitude a owl:ObjectProperty;
    rdfs:comment "The Risk Tolerance Magnitude, is the magnitude of tolerable variation around a RiskAppetite.";
    rdfs:label "Risk Tolerance Magnitude";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:roundingPolicy a owl:DatatypeProperty;
    rdfs:comment "The Rounding Policy, is the rounding applied before a limit comparison.";
    rdfs:label "Rounding Policy";
    rdfs:range xsd:string.
fin-risk:runAuthority a owl:DatatypeProperty;
    rdfs:comment "The Run Authority, is the authority that scopes a StressTestRun's identity.";
    rdfs:label "Run Authority";
    rdfs:range xsd:anyURI.
fin-risk:samplingMethodRef a owl:DatatypeProperty;
    rdfs:comment "The Sampling Method Reference, is an optional absolute reference to the sampling or resampling contract, used to point a measure definition at the data-sampling rules it depends on";
    rdfs:label "Sampling Method Reference";
    rdfs:range xsd:anyURI.
fin-risk:scenarioAuthority a owl:DatatypeProperty;
    rdfs:comment "The Scenario Authority, is the authority that scopes a ScenarioDefinition's identity.";
    rdfs:label "Scenario Authority";
    rdfs:range xsd:anyURI.
fin-risk:scenarioCategory a owl:DatatypeProperty;
    rdfs:comment "The Scenario Category, is the category of a scenario (hypothetical, historical, regulatory, reverse stress, whatIf).";
    rdfs:label "Scenario Category";
    rdfs:range xsd:string.
fin-risk:scenarioDefinitionId a owl:DatatypeProperty;
    rdfs:comment "The Scenario Definition ID, is an authority-scoped stable lexical identifier of a stress scenario definition, used to index one scenario specification uniquely while its definition version stays immutable";
    rdfs:label "Scenario Definition ID";
    rdfs:range xsd:string.
fin-risk:scenarioNarrative a owl:DatatypeProperty;
    rdfs:comment "The Scenario Narrative, is the narrative explaining how the scenario captures the risk.";
    rdfs:label "Scenario Narrative";
    rdfs:range xsd:string.
fin-risk:scenarioRef a owl:DatatypeProperty;
    rdfs:comment "The Scenario Reference, is an optional absolute reference to the scenario version used by the measure, used to bind a risk measure to the stress or what-if scenario it is based on";
    rdfs:label "Scenario Reference";
    rdfs:range xsd:anyURI.
fin-risk:scenarioShockId a owl:DatatypeProperty;
    rdfs:comment "The Scenario Shock ID, is a stable lexical identifier of a ScenarioShock.";
    rdfs:label "Scenario Shock ID";
    rdfs:range xsd:string.
fin-risk:scenarioShockMember a owl:ObjectProperty;
    rdfs:comment "The Scenario Shock Member, is a ScenarioShock that belongs to a ScenarioDefinition, used to give a scenario typed, queryable shock members rather than an opaque digest.";
    rdfs:domain fin-risk:ScenarioDefinition;
    rdfs:label "Scenario Shock Member";
    rdfs:range fin-risk:ScenarioShock.
fin-risk:scopeMatchRule a owl:ObjectProperty;
    rdfs:comment "The Scope Match Rule, is the rule by which a measurement scope and a limit scope are deemed compatible in a RiskLimitEvaluation (exactMatch, approvedRollup, contains).";
    rdfs:label "Scope Match Rule";
    rdfs:range fin-risk:ScopeMatchRule.
fin-risk:shockCanonicalizationRef a owl:DatatypeProperty;
    rdfs:comment "The Shock Canonicalization Reference, is an explicit reference to the canonicalization that maps the source document to the shock parameter payload, used to make the shockParameterDigest ↔ sourceArtifactDigest relationship explicit rather than a vague \"matches\".";
    rdfs:label "Shock Canonicalization Reference";
    rdfs:range xsd:anyURI.
fin-risk:shockMagnitude a owl:ObjectProperty;
    rdfs:comment "The Shock Magnitude, is the magnitude of a ScenarioShock.";
    rdfs:label "Shock Magnitude";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:shockParameterDigest a owl:DatatypeProperty;
    rdfs:comment "The Shock Parameter Digest, is the SHA-256 digest of the canonical shock-parameter payload for the scenario, used to fix the true content of a scenario's shock parameters by content fingerprint";
    rdfs:label "Shock Parameter Digest";
    rdfs:range xsd:string.
fin-risk:shockPropagationRule a owl:DatatypeProperty;
    rdfs:comment "The Shock Propagation Rule, is the rule by which a shock propagates to the portfolio.";
    rdfs:label "Shock Propagation Rule";
    rdfs:range xsd:string.
fin-risk:shockTargetFactor a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "The Shock Target Factor, is the RiskFactor targeted by a ScenarioShock, used to state which factor a shock acts on.";
    rdfs:domain fin-risk:ScenarioShock;
    rdfs:label "Shock Target Factor";
    rdfs:range <https://axiolune.ai/ontology/finance/risk/RiskFactor/LogicalIdentity>.
fin-risk:shockType a owl:DatatypeProperty;
    rdfs:comment "The Shock Type, is the type of shock (absolute shift, relative shift, multiplier, curve twist, basis shock, volatility shock, default event).";
    rdfs:label "Shock Type";
    rdfs:range xsd:string.
fin-risk:shockUnit a owl:DatatypeProperty;
    rdfs:comment "The Shock Unit, is the unit of a ScenarioShock magnitude (basis points, percent, absolute, multiplier).";
    rdfs:label "Shock Unit";
    rdfs:range xsd:anyURI.
fin-risk:snapshotAsOf a owl:DatatypeProperty;
    rdfs:comment "The Snapshot As Of, is the as-of time at which a RiskScopeSnapshot freezes the scope members.";
    rdfs:label "Snapshot As Of";
    rdfs:range xsd:dateTimeStamp.
fin-risk:snapshotMemberDigest a owl:DatatypeProperty;
    rdfs:comment "The Snapshot Member Digest, is the SHA-256 digest of the canonical member set of a RiskScopeSnapshot.";
    rdfs:label "Snapshot Member Digest";
    rdfs:range xsd:string.
fin-risk:snapshotSelectionRule a owl:DatatypeProperty;
    rdfs:comment "The Snapshot Selection Rule, is the rule that selected the members of a RiskScopeSnapshot.";
    rdfs:label "Snapshot Selection Rule";
    rdfs:range xsd:string.
fin-risk:stressRunId a owl:DatatypeProperty;
    rdfs:comment "The Stress Run ID, is an authority-scoped stable lexical identifier of one stress test run, used to index one stress-test execution record uniquely once the run completes";
    rdfs:label "Stress Run ID";
    rdfs:range xsd:string.
fin-risk:supersededBy a owl:DatatypeProperty;
    rdfs:comment "The Superseded By, is an optional reference to the RiskLimit version that supersedes this one.";
    rdfs:label "Superseded By";
    rdfs:range xsd:anyURI.
fin-risk:suspendedAt a owl:DatatypeProperty;
    rdfs:comment "The Suspended At, is the instant at which a RiskLimit was suspended.";
    rdfs:label "Suspended At";
    rdfs:range xsd:dateTimeStamp.
fin-risk:unitConversionPolicyRef a owl:DatatypeProperty;
    rdfs:comment "The Unit Conversion Policy Reference, is an optional reference to the unit/currency conversion policy applied before comparison.";
    rdfs:label "Unit Conversion Policy Reference";
    rdfs:range xsd:anyURI.
fin-risk:upperThresholdMoney a owl:ObjectProperty;
    rdfs:comment "The Upper Threshold Money, is an optional Money upper bound of a RiskLimitRule.";
    rdfs:label "Upper Threshold Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-risk:upperThresholdQuantity a owl:ObjectProperty;
    rdfs:comment "The Upper Threshold Quantity, is an optional Quantity upper bound of a RiskLimitRule.";
    rdfs:label "Upper Threshold Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-risk:valuationMethodRef a owl:DatatypeProperty;
    rdfs:comment "The Valuation Method Reference, is an optional reference to the valuation method used by the measure.";
    rdfs:label "Valuation Method Reference";
    rdfs:range xsd:anyURI.
fin-risk:valuationPolicyRef a owl:DatatypeProperty;
    rdfs:comment "The Valuation Policy Reference, is an optional reference to the valuation policy applied to inputs.";
    rdfs:label "Valuation Policy Reference";
    rdfs:range xsd:anyURI.
fin-risk:waiverExpiry a owl:DatatypeProperty;
    rdfs:comment "The Waiver Expiry, is the expiry of a temporary LimitWaiver.";
    rdfs:label "Waiver Expiry";
    rdfs:range xsd:dateTimeStamp.
fin-risk:waiverId a owl:DatatypeProperty;
    rdfs:comment "The Waiver ID, is a stable lexical identifier of a LimitWaiver.";
    rdfs:label "Waiver ID";
    rdfs:range xsd:string.
fin-risk:waiverKind a owl:ObjectProperty;
    rdfs:comment "The Waiver Kind, is the kind of waiver (temporary, permanent, conditional).";
    rdfs:label "Waiver Kind";
    rdfs:range fin-risk:WaiverKind.
fin-risk:waiverRationale a owl:DatatypeProperty;
    rdfs:comment "The Waiver Rationale, is the rationale for a LimitWaiver.";
    rdfs:label "Waiver Rationale";
    rdfs:range xsd:string.
