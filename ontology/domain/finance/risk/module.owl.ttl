fin-risk:RiskLimit a owl:Class;
    rdfs:comment "A Risk Limit, is an approved temporal and provenanced threshold fact that binds one exact RiskMeasureDefinition version, at least one explicit scope (a RiskScopeDefinition and/or legacy Portfolio/Account/Position), an owner, exactly one Money, Quantity, or bucket-set representation, and an optional RiskLimitRule and RiskLimitComparisonPolicy, used to set a governed risk threshold that subsequent measurements are evaluated against. The single-value upper threshold remains the first concrete profile; a RiskLimitRule generalizes to lower/upper bounds, bands, absolute-value, two-sided, utilization, and concentration limits. A lifecycle (effective/suspended/superseded) separates approval from effectiveness, and approvedBy is modeled as a typed Party role consistent with limitOwner rather than a bare uri.";
    rdfs:label "Risk Limit";
    rdfs:subClassOf _:r_0612dc4e023a9e59b3a1d4da, _:r_09323125f1d57123cf1c8e49, _:r_0ce7328c93ef11ee37cd4bff, _:r_1239ee66549014b12b04d532, _:r_131dd81de811d77824e7237e, _:r_19ad7f902b5033dec4b6f91e, _:r_1bc3d1e39f38f0e6bf90c608, _:r_2b7c31fe3b365284f3a89738, _:r_2d909c85d4677483c53357d8, _:r_3d67866eb7f1404c5bbcfe54, _:r_44f9d4b1e0e8291578b82f44, _:r_4644b05fe1ca1585dba43ce7, _:r_4aab56f827ca828c3ee981ef, _:r_4afd7eb6e14ba82ec897452a, _:r_5c0dfabbe134e23b25f60f25, _:r_5e1bb2ebbee57fba61d8e051, _:r_5eefae5b0426bd6fe476c2a4, _:r_6364e63af5d623a5bb296639, _:r_694ab36bc60674cc1bb7ec78, _:r_6b30215f64091ed61a85789d, _:r_77ae8d4ee5b4c4d582adea6e, _:r_79f00b65c4f21dde63848ece, _:r_7bc82491694690acd976d739, _:r_7d78320a6df508dc59067eac, _:r_804b4ee4d7f14ed4acfcb75c, _:r_809d837fa46badacfc6e4574, _:r_831f299eb5976d6db58e4994, _:r_83663577811426059b37a6c4, _:r_8af7622ba9b53f342f18bffc, _:r_91de91ac1fcbd090a5d566e3, _:r_9257722b9ad20deb87544be4, _:r_990268e69c1ba4621a15b64a, _:r_9e887947210b683a03fb4bd1, _:r_a17de86164db1db12daa5162, _:r_a7bdc6db5f81922e291848e2, _:r_ad3f88e313b8187cea621759, _:r_ae0302507358ef3368bae354, _:r_b050ecf7dabb141eafea51a7, _:r_b3de1541ec73b83c28918bef, _:r_bc4e5c8a6892658832ba1a4e, _:r_be6530e019a3353c6ed0424f, _:r_c55d85366f63bdda7d144a85, _:r_c5b35db49086cbd84ea3e793, _:r_c92c9b4c5e542fad63c73d8c, _:r_cc91fbbbecd4083dc464e7d2, _:r_d40880fa2d61d64cc1f9777e, _:r_eaeaa34b25dc87e823c11610, _:r_fc10acb59e85a5269b36df00, _:r_fd4520be66c75f4da827b652, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
