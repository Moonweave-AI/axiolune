    rdfs:comment "Stable FactIdentity companion for immutable Risk Source versions.";
    rdfs:label "Risk Source logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:RiskTolerance a owl:Class;
    rdfs:comment "A Risk Tolerance, is the tolerable variation around a Risk Appetite, used to separate the willingness to bear risk from the tolerable deviation before escalation, so that appetite and tolerance are not conflated into a single threshold.";
    rdfs:label "Risk Tolerance";
    rdfs:subClassOf _:r_239bc373fa200a74754c2448, _:r_2a8f23dce8b4a2d54f9809a6, _:r_54daef10b7e6e8f8ac660724, _:r_5f322ddbe40a38bd73352d9f, _:r_9a18274cbe63d39caa24a64e, _:r_9de7ba1b1fa9e534421b4785, _:r_facf8a4b10630886ad5460db, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/RiskTolerance/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Risk Tolerance versions.";
    rdfs:label "Risk Tolerance logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:ScenarioApplicationEvidence a owl:Class;
    rdfs:comment "A Scenario Application Evidence, is the evidence that a stress-test output's input context was actually shocked by the run's exact ScenarioDefinition — binding the scenario, the input set, and the output — used to prove the scenario was applied rather than merely referenced, so that a stress run demonstrates the scenario acted on the output.";
    rdfs:label "Scenario Application Evidence";
    rdfs:subClassOf _:r_26d3db9ac669ad03c75ac50b, _:r_36d58008007af07092459905, _:r_7baf43951b8e44dc1dc2d135, _:r_7de5fa2f368d2e09a90c851c, _:r_c35ecb477df1102ae95e1877, _:r_c36801920ecf4fcb19274b83, _:r_c4bf1a069803e25dcdfa9047, _:r_cf6ac718c1af271bc18065ce, _:r_f709bc389b89f7780821539d, _:r_f93d3b754170622bbb33dc14, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
