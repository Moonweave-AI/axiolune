fin-risk:RiskLimitComparisonPolicy a owl:Class;
    rdfs:comment "A Risk Limit Comparison Policy, is the policy that governs how a bucketed or scalar measurement is compared against a bucketed or scalar limit — comparison operator, direction, per-bucket vs aggregate, key alignment, missing-bucket handling, tolerance, rounding, and unit/currency conversion — used so that bucket-set vs bucket-set comparison is well-defined rather than collapsing to a scalar value<=threshold rule.";
    rdfs:label "Risk Limit Comparison Policy";
    rdfs:subClassOf _:r_21328f1821fb5bd4ce002f76, _:r_2df22484ce329f9f7eb494a7, _:r_42af6c1d495f4e51e646ba31, _:r_5064c6b10a625721a113ab8f, _:r_54a0e517cf385a17dc76bbac, _:r_899ab0dfb0d8d7a4e2cf5635, _:r_c35e0011d4661b4eccb613a1, _:r_d023fbb79392a9bc3e382140, _:r_dc6454505792830c9943ef67, _:r_e378bf23c68c05d0ebb8541a, _:r_e55d08a184fffbf6cade9984, _:r_ee3fb2c75f55e76de0c22c7a, _:r_f1f78d273b94b8b372e2a32e, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
