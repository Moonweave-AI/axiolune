fin-risk:RiskLimitBreachCase a owl:Class;
    rdfs:comment "A Risk Limit Breach Case, is the governance case opened for a LimitBreach — carrying breach magnitude, duration, responsible party, and a workflow status — used to separate the immutable computational breach fact from its governance disposition, so that a breach has a case, acknowledgements, waivers, remediation, and escalations rather than a single fact.";
    rdfs:label "Risk Limit Breach Case";
    rdfs:subClassOf _:r_02097e36518c8a5c690cc619, _:r_05f74e0bda18056dbe35f612, _:r_227f1ce10727cf71992d2836, _:r_307214731f07ab820701f0f3, _:r_4fff8337d9646c9dd465e9af, _:r_5f80451ccea9ee3a8ff92db0, _:r_947dc75d0874f2442c776e8f, _:r_acb4d0a831c94b09faf3b869, _:r_b9c7fc44fea96bd5d018f523, _:r_c7976926b10a2d1321586e19, _:r_c97cc64f58e8d84c5027cd4f, _:r_d3d9d39f35f67640ceea21bf, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
