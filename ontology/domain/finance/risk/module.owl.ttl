fin-risk:RiskInputSet a owl:Class;
    rdfs:comment "A Risk Input Set, is the collection of inputs a risk calculation used — multiple position snapshots, market-data snapshots, curves, volatility surfaces, FX rates, parameter sets, FX/valuation policy, and data-quality status — used to decompress the opaque inputContextRef/digest so that the actual inputs are queryable, with their valuation as-of, availability, and quality.";
    rdfs:label "Risk Input Set";
    rdfs:subClassOf _:r_03e44276474c0beb92c9d4ec, _:r_0a6ca2604d27b4d96dc3684c, _:r_15b0d0f01b393154052ca9a3, _:r_2f4133f054d42f18582c4108, _:r_324a48349dd6cd00c03cd8d0, _:r_341a4ca898851516550a720e, _:r_3bfa3b204af0ca8c07e9a05d, _:r_3dce50ae143fe1d903f2dcb9, _:r_4e7567e7efa235b474821b53, _:r_5594280e58e417de21f445fb, _:r_5f50b540f58f80e4600e64c9, _:r_7d69e8414c9ff45df3a23d4a, _:r_866be7ce37697d8973b2d124, _:r_9156e57d24f01519bc062d6b, _:r_967f22323f1066ecbf4dc055, _:r_cfa9428765d882a3dc6fa926, _:r_d4f68bf935732f2747837a03, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
