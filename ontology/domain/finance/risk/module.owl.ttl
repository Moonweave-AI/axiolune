    rdfs:domain fin-risk:StressTestRun;
    rdfs:label "stress run scenario";
    rdfs:range fin-risk:ScenarioDefinition.
<https://axiolune.ai/ontology/finance/risk/StressTestRun/role/stressRunScopeSnapshot> a owl:ObjectProperty;
    rdfs:comment "optional exact RiskScopeSnapshot whose frozen members were shocked";
    rdfs:domain fin-risk:StressTestRun;
    rdfs:label "stress run scope snapshot";
    rdfs:range fin-risk:RiskScopeSnapshot.
