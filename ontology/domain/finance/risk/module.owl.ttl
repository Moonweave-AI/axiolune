    skos:inScheme <https://axiolune.ai/ontology/finance/risk/RiskCategoryValue/scheme>;
    skos:notation "model";
    skos:prefLabel "Model Risk";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/risk/RiskCategoryValue/value/operational> a owl:NamedIndividual, skos:Concept, fin-risk:RiskCategoryValue;
