    rdfs:domain fin-risk:RiskCalculationRun;
    rdfs:label "calc run profile";
    rdfs:range fin-risk:CalculationProfile.
fin-risk:RiskCategory a owl:Class;
    rdfs:comment "A Risk Category, is a classification of the kind of risk being managed, used to distinguish market, credit, liquidity, operational, concentration, model, and other extensible risk families so that measures, limits, exposures, and scenarios can be categorized rather than treated as undifferentiated risk. Full regulatory frameworks per category are explicitly out of scope; the category is a typed tag, not a rule set.";
    rdfs:label "Risk Category";
    rdfs:subClassOf _:r_187550492d0b33d7d638c069, _:r_620b5297e086e6cd46ec156f, _:r_a143a6306287610e3c646121, _:r_d706f905c4a21899c4dc0b1a, _:r_e5beb4dc977eb5b15776f893, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/RiskCategory/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Risk Category versions.";
    rdfs:label "Risk Category logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:RiskCategoryValue a owl:Class;
    rdfs:comment "The Risk Category Value, is a closed classification of the kind of risk, used to categorize measures, limits, exposures, factors, and scenarios. The set is extensible via additional code-list values; full regulatory frameworks per category remain out of scope.";
    rdfs:label "Risk Category Value";
    owl:oneOf _:l_16d61b1db15eeebac6d66215_0.
