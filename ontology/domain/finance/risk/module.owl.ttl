    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:RiskLimitEvaluation a owl:Class;
    rdfs:comment "A Risk Limit Evaluation, is an explicit deterministic conclusion for one exact RiskMeasurement version and one compatible exact RiskLimit version that represents withinLimit, breach, or indeterminate as a required code value rather than as an absence, used to make the outcome of comparing a measurement with its limit unambiguous and non-empty. Scope compatibility is defined by an explicit scopeMatchRule (exactMatch / approvedRollup / contains) rather than a vague \"same scope\", and a comparison policy role governs bucket-vs-bucket comparison. For the bucket branch the result is determined per the RiskLimitComparisonPolicy (per-bucket and/or aggregate, with key alignment, missing-bucket handling, tolerance, rounding, and unit/currency conversion) rather than a scalar value<=threshold. evaluatorDigest is mandatory only when the ValidatedReproducibleRiskMeasurement profile is active.";
    rdfs:label "Risk Limit Evaluation";
    rdfs:subClassOf _:r_257b1d80a2099af805227d41, _:r_5427d874cd072b5da07f8691, _:r_7300bd4eeb2b6444b9560e82, _:r_79231b7a01976cdb30bf354d, _:r_83fe92be94a43d2825b4f84b, _:r_877610de85ee1c9eae26db3f, _:r_8aa976f672399332a1791ece, _:r_a3d531b4e3bdf218249c72e8, _:r_a46fa81ba7de122ef3df7e13, _:r_a53fdb5702714a567bfee3f4, _:r_c257b13fe655b8bf5b1d4d94, _:r_d004c629c502a70dbb8c8dc3, _:r_ee84db2780b17746807c7b73, _:r_f3ee4ad68a570601add3d8b3, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
