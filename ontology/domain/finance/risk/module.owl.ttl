    rdfs:comment "Stable FactIdentity companion for immutable Risk Bucket Set versions.";
    rdfs:label "Risk Bucket Set logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-risk:RiskBucketValue a owl:Class;
    rdfs:comment "A Risk Bucket Value, is a temporal and provenanced scalar member of a complete risk bucket set that is identified within that set by an explicit dimension and bucket key, used to carry the measurement value for one bucket in the result";
    rdfs:label "Risk Bucket Value";
    rdfs:subClassOf _:r_77d01ec92a541d63b3c7caee, _:r_99a53940503a00a86002927a, _:r_a692a6290b1b4173a953d278, _:r_bbd017d70f4cdc5480ccb363, _:r_bd245ebf8dec19b7e7bfdc89, _:r_c148c8e39b9925c0cb29398f, _:r_d95a4d850e07db1f9585e45e, _:r_fc33fc8ff7052130afff7617, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/RiskBucketValue/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Risk Bucket Value versions.";
    rdfs:label "Risk Bucket Value logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/risk/RiskBucketValue/role/bucketValueSchema> a owl:ObjectProperty;
    rdfs:comment "exact RiskBucketSchema version copied from the governing set for executable validation";
    rdfs:domain fin-risk:RiskBucketValue;
    rdfs:label "bucket value schema";
    rdfs:range fin-risk:RiskBucketSchema.
<https://axiolune.ai/ontology/finance/risk/RiskBucketValue/role/bucketValueSet> a owl:ObjectProperty;
    rdfs:comment "exact RiskBucketSet version whose closure contains this value version";
    rdfs:domain fin-risk:RiskBucketValue;
    rdfs:label "bucket value set";
    rdfs:range fin-risk:RiskBucketSet.
fin-risk:RiskCalculationContext a owl:Class;
    rdfs:comment "A Risk Calculation Context, is the binding of a RiskInputSet to a RiskCalculationRun, used to record that a particular run consumed a particular frozen input set, so that input-to-run linkage is explicit and queryable.";
    rdfs:label "Risk Calculation Context";
    rdfs:subClassOf _:r_0dddb79ac8e763ee258abeed, _:r_0ef9d07624fc6713c31af589, _:r_3d3a5e41de4bd82e055ec47f, _:r_88833a2cfc3ef660e5b70494, _:r_a901ad64a3da3f5c90e368e8, _:r_b0aefd1612fe4da7a2dc74fc, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/RiskCalculationContext/LogicalIdentity> a owl:Class;
