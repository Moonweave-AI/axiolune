@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-instruments: <https://axiolune.ai/ontology/finance/instruments/>.

fin-instruments:FinancialInstrumentShape a sh:NodeShape;
    sh:targetClass fin-instruments:FinancialInstrument;
    sh:name "Financial Instrument";
    sh:description "written contract that gives rise to both a financial asset of one entity and a financial liability of another entity, as defined in IAS 32";
    sh:property fin-instruments:FinancialInstrumentShape_hasPrimaryIdentifier.
fin-instruments:FinancialInstrumentShape_hasPrimaryIdentifier a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/finance/foundation/hasPrimaryIdentifier>;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-instruments:FinancialInstrumentShape sh:property fin-instruments:FinancialInstrumentShape_hasDenominatedCurrency.
fin-instruments:FinancialInstrumentShape_hasDenominatedCurrency a sh:PropertyShape;
    sh:path fin-instruments:hasDenominatedCurrency;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/Currency>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-instruments:SecurityShape a sh:NodeShape;
    sh:targetClass fin-instruments:Security;
    sh:name "Security";
    sh:description "financial instrument that can be bought or sold, as defined in the Securities Exchange Act 1934".
fin-instruments:EquitySecurityShape a sh:NodeShape;
    sh:targetClass fin-instruments:EquitySecurity;
    sh:name "Equity Security";
    sh:description "security representing an ownership interest in an entity or pool of assets, as defined in ISO 10962".
fin-instruments:SecuritiesOfferingShape a sh:NodeShape;
    sh:targetClass fin-instruments:SecuritiesOffering;
    sh:name "Securities Offering";
    sh:description "offering of a security (or securities) for sale; distinct from the instrument contract and from an exchange listing".
fin-instruments:InstrumentListingShape a sh:NodeShape;
    sh:targetClass fin-instruments:InstrumentListing;
    sh:name "Instrument Listing";
    sh:description "catalog entry for a securities offering managed by an exchange that provides the terms under which that security is made available on that exchange";
    sh:property fin-instruments:InstrumentListingShape_hasTickSize.
fin-instruments:InstrumentListingShape_hasTickSize a sh:PropertyShape;
    sh:path fin-instruments:hasTickSize;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_hasLotSize.
fin-instruments:InstrumentListingShape_hasLotSize a sh:PropertyShape;
    sh:path fin-instruments:hasLotSize;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_hasListingDate.
fin-instruments:InstrumentListingShape_hasListingDate a sh:PropertyShape;
    sh:path fin-instruments:hasListingDate;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:dateTime.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_hasDelistingDate.
fin-instruments:InstrumentListingShape_hasDelistingDate a sh:PropertyShape;
    sh:path fin-instruments:hasDelistingDate;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:dateTime.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_hasDenominatedCurrency.
fin-instruments:InstrumentListingShape_hasDenominatedCurrency a sh:PropertyShape;
    sh:path fin-instruments:hasDenominatedCurrency;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/Currency>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_validFrom.
fin-instruments:InstrumentListingShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_knowledgeFrom.
fin-instruments:InstrumentListingShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_availableFrom.
fin-instruments:InstrumentListingShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_validTo.
fin-instruments:InstrumentListingShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_knowledgeTo.
fin-instruments:InstrumentListingShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_availableTo.
fin-instruments:InstrumentListingShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:sparql _:sparql_valid_InstrumentListing.
_:sparql_valid_InstrumentListing sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-instruments:InstrumentListingShape sh:sparql _:sparql_knowledge_InstrumentListing.
_:sparql_knowledge_InstrumentListing sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-instruments:InstrumentListingShape sh:sparql _:sparql_available_InstrumentListing.
_:sparql_available_InstrumentListing sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-instruments:IssuerShape a sh:NodeShape;
    sh:targetClass fin-instruments:Issuer;
    sh:name "Issuer";
    sh:description "role of a party that issues or proposes to issue in a formal filing one or more financial instruments".
