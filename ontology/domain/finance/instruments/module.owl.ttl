@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.

@prefix fin-instruments: <https://axiolune.ai/ontology/finance/instruments/>.

<https://axiolune.ai/ontology/finance/instruments> a owl:Ontology;
    owl:versionIRI <https://axiolune.ai/ontology/finance/instruments/0.2.0>;
    rdfs:label "Financial Instruments";
    rdfs:comment "financial instruments, securities, equities, listings, and issuers that define what is traded";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/market-structure>.
fin-instruments:hasTickSize a owl:ObjectProperty;
    rdfs:label "Has Tick Size";
    rdfs:comment "relation from an instrument listing to its minimum price increment (tick size) as a monetary amount";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>.
fin-instruments:hasLotSize a owl:ObjectProperty;
    rdfs:label "Has Lot Size";
    rdfs:comment "relation from an instrument listing to its standard board lot size as a quantity";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/QuantityValue>.
fin-instruments:hasListingDate a owl:DatatypeProperty;
    rdfs:label "Has Listing Date";
    rdfs:comment "relation from an instrument listing to the date on which the instrument was first listed on the venue";
    rdfs:range xsd:dateTime.
fin-instruments:hasDelistingDate a owl:DatatypeProperty;
    rdfs:label "Has Delisting Date";
    rdfs:comment "relation from an instrument listing to the date on which the instrument was delisted from the venue, or null if still listed";
    rdfs:range xsd:dateTime.
fin-instruments:isIssuedBy a owl:ObjectProperty;
    rdfs:label "Is Issued By";
    rdfs:comment "binary relation from a financial instrument to the legal entity that issued it";
    rdfs:domain fin-instruments:FinancialInstrument;
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/LegalEntity>.
fin-instruments:isTradedOn a owl:ObjectProperty;
    rdfs:label "Is Traded On";
    rdfs:comment "binary relation from a financial instrument to a trading venue where it is listed for trading";
    rdfs:domain fin-instruments:FinancialInstrument;
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingVenue>.
fin-instruments:isListedOn a owl:ObjectProperty;
    rdfs:label "Is Listed On";
    rdfs:comment "binary relation from an instrument listing to the trading venue on which it is listed";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingVenue>.
fin-instruments:hasDenominatedCurrency a owl:ObjectProperty;
    rdfs:label "Has Denominated Currency";
    rdfs:comment "relation from a financial instrument to the currency in which it is denominated";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Currency>.
fin-instruments:FinancialInstrument a owl:Class;
    rdfs:label "Financial Instrument";
    rdfs:comment "written contract that gives rise to both a financial asset of one entity and a financial liability of another entity, as defined in IAS 32".
fin-instruments:Security a owl:Class;
    rdfs:label "Security";
    rdfs:comment "financial instrument that can be bought or sold, as defined in the Securities Exchange Act 1934";
    rdfs:subClassOf fin-instruments:FinancialInstrument.
fin-instruments:EquitySecurity a owl:Class;
    rdfs:label "Equity Security";
    rdfs:comment "security representing an ownership interest in an entity or pool of assets, as defined in ISO 10962";
    rdfs:subClassOf fin-instruments:Security.
fin-instruments:SecuritiesOffering a owl:Class;
    rdfs:label "Securities Offering";
    rdfs:comment "offering of a security (or securities) for sale; distinct from the instrument contract and from an exchange listing".
fin-instruments:listsOffering a owl:ObjectProperty;
    rdfs:label "Lists Offering";
    rdfs:comment "binary relation from an InstrumentListing to the SecuritiesOffering it catalogs on a venue";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:range fin-instruments:SecuritiesOffering.
fin-instruments:InstrumentListing a owl:Class;
    rdfs:label "Instrument Listing";
    rdfs:comment "catalog entry for a securities offering managed by an exchange that provides the terms under which that security is made available on that exchange".
fin-instruments:Issuer a owl:Class;
    rdfs:label "Issuer";
    rdfs:comment "role of a party that issues or proposes to issue in a formal filing one or more financial instruments".
fin-instruments:isIssuedBy rdfs:subPropertyOf <https://spec.edmcouncil.org/fibo/ontology/FND/Relations/Relations/isIssuedBy>.
fin-instruments:FinancialInstrument rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/FinancialInstrument>.
fin-instruments:Security rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Security>.
fin-instruments:EquitySecurity rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/EquityInstrument>.
fin-instruments:SecuritiesOffering rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/SecuritiesOffering>.
fin-instruments:InstrumentListing rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/Listing>.
fin-instruments:Issuer rdfs:subClassOf <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/Issuer>.
