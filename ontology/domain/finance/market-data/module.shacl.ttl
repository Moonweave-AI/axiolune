@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-market-data: <https://axiolune.ai/ontology/finance/market-data/>.

fin-market-data:PriceKindShape a sh:NodeShape;
    sh:targetClass fin-market-data:PriceKind;
    sh:in ("Last" "Bid" "Ask" "Mid" "Open" "High" "Low" "Close" "Settlement" "VWAP" "TWAP");
    sh:name "Price Kind".
fin-market-data:QuoteSideShape a sh:NodeShape;
    sh:targetClass fin-market-data:QuoteSide;
    sh:in ("Bid" "Ask");
    sh:name "Quote Side".
fin-market-data:BarAggregationShape a sh:NodeShape;
    sh:targetClass fin-market-data:BarAggregation;
    sh:in ("Time" "Tick" "Volume" "Dollar" "Range" "Renko");
    sh:name "Bar Aggregation".
fin-market-data:PriceObservationShape a sh:NodeShape;
    sh:targetClass fin-market-data:PriceObservation;
    sh:name "Price Observation";
    sh:description "time-stamped observation of a price for a financial instrument at a specific venue with a defined price kind, currency, source, and three-axis temporal semantics (valid-time = market event time, knowledge-time = when platform learned, availability-time = when queryable per ADR-012)";
    sh:property fin-market-data:PriceObservationShape_hasPriceValue.
fin-market-data:PriceObservationShape_hasPriceValue a sh:PropertyShape;
    sh:path fin-market-data:hasPriceValue;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_hasPriceKind.
fin-market-data:PriceObservationShape_hasPriceKind a sh:PropertyShape;
    sh:path fin-market-data:hasPriceKind;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Last" "Bid" "Ask" "Mid" "Open" "High" "Low" "Close" "Settlement" "VWAP" "TWAP").
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_hasCurrencyCode.
fin-market-data:PriceObservationShape_hasCurrencyCode a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/finance/foundation/hasCurrencyCode>;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{3}$".
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_observedInstrument.
fin-market-data:PriceObservationShape_observedInstrument a sh:PropertyShape;
    sh:path fin-market-data:observedInstrument;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_observedAtVenue.
fin-market-data:PriceObservationShape_observedAtVenue a sh:PropertyShape;
    sh:path fin-market-data:observedAtVenue;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/market-structure/TradingVenue>.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_validFrom.
fin-market-data:PriceObservationShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_knowledgeFrom.
fin-market-data:PriceObservationShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_availableFrom.
fin-market-data:PriceObservationShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_validTo.
fin-market-data:PriceObservationShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_knowledgeTo.
fin-market-data:PriceObservationShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_availableTo.
fin-market-data:PriceObservationShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:sparql _:sparql_valid_PriceObservation.
_:sparql_valid_PriceObservation sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-market-data:PriceObservationShape sh:sparql _:sparql_knowledge_PriceObservation.
_:sparql_knowledge_PriceObservation sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-market-data:PriceObservationShape sh:sparql _:sparql_available_PriceObservation.
_:sparql_available_PriceObservation sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_source.
fin-market-data:PriceObservationShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
