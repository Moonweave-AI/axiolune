    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-portfolio:PositionLotShape sh:property fin-portfolio:PositionLotShape_pat_knowledgeTo.
fin-portfolio:PositionLotShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-portfolio:PositionLotShape sh:property fin-portfolio:PositionLotShape_pat_availableTo.
fin-portfolio:PositionLotShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
