@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-portfolio: <https://axiolune.ai/ontology/finance/portfolio-positions/>.

fin-portfolio:PositionSideShape a sh:NodeShape;
    sh:targetClass fin-portfolio:PositionSide;
    sh:in ("Long" "Short" "Flat");
    sh:name "Position Side".
fin-portfolio:ValuationMethodShape a sh:NodeShape;
    sh:targetClass fin-portfolio:ValuationMethod;
    sh:in ("MarkToMarket" "MarkToModel" "CostBasis" "LowerOfCostOrMarket");
    sh:name "Valuation Method".
fin-portfolio:AccountTypeShape a sh:NodeShape;
    sh:targetClass fin-portfolio:AccountType;
    sh:in ("Cash" "Margin" "Simulated" "Managed" "Custodial");
    sh:name "Account Type".
fin-portfolio:AccountShape a sh:NodeShape;
    sh:targetClass fin-portfolio:Account;
    sh:name "Account";
    sh:description "financial account that serves as the unit of ownership, authorization, and accounting for trading activities and asset holdings";
    sh:property fin-portfolio:AccountShape_hasAccountIdentifier.
fin-portfolio:AccountShape_hasAccountIdentifier a sh:PropertyShape;
    sh:path fin-portfolio:hasAccountIdentifier;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-portfolio:AccountShape sh:property fin-portfolio:AccountShape_hasAccountType.
fin-portfolio:AccountShape_hasAccountType a sh:PropertyShape;
    sh:path fin-portfolio:hasAccountType;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Cash" "Margin" "Simulated" "Managed" "Custodial").
fin-portfolio:PortfolioShape a sh:NodeShape;
    sh:targetClass fin-portfolio:Portfolio;
    sh:name "Portfolio";
    sh:description "collection of financial instruments and cash positions managed as a unit for investment objectives, performance tracking, or risk management";
    sh:property fin-portfolio:PortfolioShape_hasPortfolioIdentifier.
fin-portfolio:PortfolioShape_hasPortfolioIdentifier a sh:PropertyShape;
    sh:path fin-portfolio:hasPortfolioIdentifier;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-portfolio:PortfolioShape sh:property fin-portfolio:PortfolioShape_hasPortfolioName.
fin-portfolio:PortfolioShape_hasPortfolioName a sh:PropertyShape;
    sh:path fin-portfolio:hasPortfolioName;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-portfolio:HoldingSnapshotShape a sh:NodeShape;
    sh:targetClass fin-portfolio:HoldingSnapshot;
    sh:name "Holding Snapshot";
    sh:description "time-stamped observation of an account or portfolio's holding of a specific financial instrument at a point in time, with three-axis temporal semantics distinguishing the business effective time, knowledge time, and data availability time";
    sh:property fin-portfolio:HoldingSnapshotShape_hasQuantity.
fin-portfolio:HoldingSnapshotShape_hasQuantity a sh:PropertyShape;
    sh:path fin-portfolio:hasQuantity;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_hasPositionSide.
fin-portfolio:HoldingSnapshotShape_hasPositionSide a sh:PropertyShape;
    sh:path fin-portfolio:hasPositionSide;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Long" "Short" "Flat").
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_hasCurrencyCode.
fin-portfolio:HoldingSnapshotShape_hasCurrencyCode a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/finance/foundation/hasCurrencyCode>;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{3}$".
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_heldInAccount.
fin-portfolio:HoldingSnapshotShape_heldInAccount a sh:PropertyShape;
    sh:path fin-portfolio:heldInAccount;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-portfolio:Account.
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_heldInPortfolio.
fin-portfolio:HoldingSnapshotShape_heldInPortfolio a sh:PropertyShape;
    sh:path fin-portfolio:heldInPortfolio;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-portfolio:Portfolio.
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_heldInstrument.
fin-portfolio:HoldingSnapshotShape_heldInstrument a sh:PropertyShape;
    sh:path fin-portfolio:heldInstrument;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_pat_validFrom.
fin-portfolio:HoldingSnapshotShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_pat_knowledgeFrom.
fin-portfolio:HoldingSnapshotShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_pat_availableFrom.
fin-portfolio:HoldingSnapshotShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_pat_validTo.
fin-portfolio:HoldingSnapshotShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_pat_knowledgeTo.
fin-portfolio:HoldingSnapshotShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_pat_availableTo.
fin-portfolio:HoldingSnapshotShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-portfolio:HoldingSnapshotShape sh:sparql _:sparql_valid_HoldingSnapshot.
_:sparql_valid_HoldingSnapshot sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-portfolio:HoldingSnapshotShape sh:sparql _:sparql_knowledge_HoldingSnapshot.
_:sparql_knowledge_HoldingSnapshot sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-portfolio:HoldingSnapshotShape sh:sparql _:sparql_available_HoldingSnapshot.
_:sparql_available_HoldingSnapshot sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-portfolio:HoldingSnapshotShape sh:property fin-portfolio:HoldingSnapshotShape_pat_source.
fin-portfolio:HoldingSnapshotShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
fin-portfolio:PositionValuationShape a sh:NodeShape;
    sh:targetClass fin-portfolio:PositionValuation;
    sh:name "Position Valuation";
    sh:description "time-stamped valuation of a holding that explicitly references the price observation used, the valuation method applied, and the resulting market value, enabling full traceability from price to valuation result";
    sh:property fin-portfolio:PositionValuationShape_hasMarketValue.
fin-portfolio:PositionValuationShape_hasMarketValue a sh:PropertyShape;
    sh:path fin-portfolio:hasMarketValue;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_hasCostBasis.
fin-portfolio:PositionValuationShape_hasCostBasis a sh:PropertyShape;
    sh:path fin-portfolio:hasCostBasis;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_hasUnrealizedPnL.
fin-portfolio:PositionValuationShape_hasUnrealizedPnL a sh:PropertyShape;
    sh:path fin-portfolio:hasUnrealizedPnL;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_hasValuationMethod.
fin-portfolio:PositionValuationShape_hasValuationMethod a sh:PropertyShape;
    sh:path fin-portfolio:hasValuationMethod;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("MarkToMarket" "MarkToModel" "CostBasis" "LowerOfCostOrMarket").
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_hasCurrencyCode.
fin-portfolio:PositionValuationShape_hasCurrencyCode a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/finance/foundation/hasCurrencyCode>;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{3}$".
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_valuedHolding.
fin-portfolio:PositionValuationShape_valuedHolding a sh:PropertyShape;
    sh:path fin-portfolio:valuedHolding;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class fin-portfolio:HoldingSnapshot.
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_usedPriceObservation.
fin-portfolio:PositionValuationShape_usedPriceObservation a sh:PropertyShape;
    sh:path fin-portfolio:usedPriceObservation;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/market-data/PriceObservation>.
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_pat_validFrom.
fin-portfolio:PositionValuationShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_pat_knowledgeFrom.
fin-portfolio:PositionValuationShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_pat_availableFrom.
fin-portfolio:PositionValuationShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_pat_validTo.
fin-portfolio:PositionValuationShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_pat_knowledgeTo.
fin-portfolio:PositionValuationShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_pat_availableTo.
fin-portfolio:PositionValuationShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-portfolio:PositionValuationShape sh:sparql _:sparql_valid_PositionValuation.
_:sparql_valid_PositionValuation sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-portfolio:PositionValuationShape sh:sparql _:sparql_knowledge_PositionValuation.
_:sparql_knowledge_PositionValuation sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-portfolio:PositionValuationShape sh:sparql _:sparql_available_PositionValuation.
_:sparql_available_PositionValuation sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-portfolio:PositionValuationShape sh:property fin-portfolio:PositionValuationShape_pat_source.
fin-portfolio:PositionValuationShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
fin-portfolio:PositionLotShape a sh:NodeShape;
    sh:targetClass fin-portfolio:PositionLot;
    sh:name "Position Lot";
    sh:description "distinct acquisition or disposition of a specific quantity of an instrument, tracked separately for tax basis, holding period, or accounting purposes";
    sh:property fin-portfolio:PositionLotShape_hasQuantity.
fin-portfolio:PositionLotShape_hasQuantity a sh:PropertyShape;
    sh:path fin-portfolio:hasQuantity;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-portfolio:PositionLotShape sh:property fin-portfolio:PositionLotShape_hasCostBasis.
fin-portfolio:PositionLotShape_hasCostBasis a sh:PropertyShape;
    sh:path fin-portfolio:hasCostBasis;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-portfolio:PositionLotShape sh:property fin-portfolio:PositionLotShape_hasPositionSide.
fin-portfolio:PositionLotShape_hasPositionSide a sh:PropertyShape;
    sh:path fin-portfolio:hasPositionSide;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Long" "Short" "Flat").
fin-portfolio:PositionLotShape sh:property fin-portfolio:PositionLotShape_lotForInstrument.
fin-portfolio:PositionLotShape_lotForInstrument a sh:PropertyShape;
    sh:path fin-portfolio:lotForInstrument;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-portfolio:PositionLotShape sh:property fin-portfolio:PositionLotShape_lotInAccount.
fin-portfolio:PositionLotShape_lotInAccount a sh:PropertyShape;
    sh:path fin-portfolio:lotInAccount;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class fin-portfolio:Account.
fin-portfolio:PositionLotShape sh:property fin-portfolio:PositionLotShape_pat_validFrom.
fin-portfolio:PositionLotShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-portfolio:PositionLotShape sh:property fin-portfolio:PositionLotShape_pat_knowledgeFrom.
fin-portfolio:PositionLotShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
