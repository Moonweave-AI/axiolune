fin-portfolio:PortfolioObservationStreamShape a sh:NodeShape;
    sh:description "Portfolio Observation Stream, is a provider-owned versioned data stream whose stable logical identity is the pair (provider, stream identifier); the source, completeness, and pagination contracts are version-locked ingestion semantics that mutate version content but do not change stream identity. Used for scoping the source identifiers, completeness contracts, and pagination contracts of holding, position, and external cost-basis observations. The source/completeness/pagination contracts and source-artifact digests belong to the execution-and-reproducibility profile.";
    sh:name "Portfolio Observation Stream";
