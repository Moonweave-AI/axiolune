# Axiolune Ontology Meta-Model - Layer 4: Data Binding v0.5
# Version: 0.5.0
# Date: 2026-07-29
# Governance: ADR-011 (Canonical Data Binding Truth Source), ADR-012 (Three-Axis Temporal)

module:
  moduleIri: "https://axiolune.ai/ontology/meta/data-binding"
  baseIri: "https://axiolune.ai/ontology/meta/data-binding/"
  preferredPrefix: "ax-binding"
  version: "0.5.0"
  imports:
    - moduleIri: "https://axiolune.ai/ontology/meta/core#sha256:6a3861b3861fc2301deddd55965f23030f9fae653755c0568fa1ea2f4d634592"
      version: "0.4.0"
      artifactDigest: "sha256:6a3861b3861fc2301deddd55965f23030f9fae653755c0568fa1ea2f4d634592"
      importMode: All
    - moduleIri: "https://axiolune.ai/ontology/meta/patterns#sha256:654ecf0d6e55e5a2437da1e8cf1e6732bb19c34cecac470a9c32c357a63c7796"
      version: "0.4.0"
      artifactDigest: "sha256:654ecf0d6e55e5a2437da1e8cf1e6732bb19c34cecac470a9c32c357a63c7796"
      importMode: All
    - moduleIri: "https://axiolune.ai/ontology/meta/behavior#sha256:93e690b6261a52fd42627178114edb94cb7f80f372539f6eed6258233b2d2962"
      version: "0.4.0"
      artifactDigest: "sha256:93e690b6261a52fd42627178114edb94cb7f80f372539f6eed6258233b2d2962"
      importMode: All
  exports: []

DataBinding:
  version: "0.5.0"
  description: "Meta-model for mapping physical data sources to ontology concepts (ADR-011 compliant)"
  layer: 4
  changes:
    - "v0.5.0: BREAKING - Implement ADR-011 single truth source architecture"
    - "v0.5.0: REMOVED Field.semanticMapping and SemanticFieldMapping (violated single truth source)"
    - "v0.5.0: SemanticMappingDefinition is now canonical truth source with complete mapping capabilities"
    - "v0.5.0: Added SourceBinding, RowSetSpec, IdentitySpec for row-level semantics"
    - "v0.5.0: Renamed fieldMappings to slotMappings (supports attributes, roles, relations, pattern fields)"
    - "v0.5.0: Added MaterializationRun for immutable runtime state (separated from static definitions)"
    - "v0.5.0: Implement ADR-012 three-axis temporal model (valid/knowledge/availability)"
    - "v0.5.0: Added TemporalMappingSpec with explicit source bindings for all three time axes"
    - "v0.5.0: REMOVED MaterializationPlanDefinition.watermark (moved to MaterializationRun)"
    - "v0.5.0: All transformations require explicit named inputs, version, digest, test cases"
    - "v0.4.0: Removed Dataset.semanticMappings, Field.semanticMapping as sole truth source (superseded)"

  note: |
    Layer 4 maps PHYSICAL data artifacts to SEMANTIC ontology concepts.
    
    ADR-011 COMPLIANCE:
    - SemanticMappingDefinition is the ONLY structure for semantic mappings
    - Physical structure (FieldDefinition) contains NO semantic annotations
    - All row-level and dataset-level semantics expressible (joins, filters, identity, provenance, temporal)
    - Static definitions (plans) separated from runtime state (runs)
    
    ADR-012 COMPLIANCE:
    - Three-axis temporal model: valid time, knowledge time, availability time
    - All time sources explicitly declared in TemporalMappingSpec
    - No CURRENT_TIMESTAMP or non-reproducible time functions
    - MaterializationRun provides immutable runtime context for reproducible queries

  # ==================== Data Source ====================
  DataSource:
    definition: "a meta-classifier for external or internal data providers with connection and authentication metadata"
    purpose: "Defines where data originates and how to access it"

    requiredFields:
      iri: {type: uri, unique: true}
      namespace: {type: string, required: true}
      localName: {type: string, required: true}
      label: {type: string, required: true}

      definition:
        type: string
        required: true
        example: "Bloomberg market data feed providing real-time and historical price information"

      sourceType:
        type: enum
        required: true
        values:
          - relationalDatabase
          - documentDatabase
          - timeSeriesDatabase
          - objectStorage
          - fileSystem
          - restAPI
          - graphQL
          - grpc
          - streamingKafka
          - streamingKinesis
          - dataWarehouse

      connection:
        type: ConnectionSpec
        description: "connection parameters (sensitive fields should reference secrets manager)"

    optionalFields:
      vendor: {type: string, example: "Bloomberg L.P."}
      version: {type: string, example: "BPIPE v3.14"}
      updateFrequency: {type: enum, values: [realtime, intraday, daily, weekly, monthly, onDemand, static]}
      latency:
        typical: {type: duration, example: "PT0.5S"}
        maximum: {type: duration, example: "PT2S"}
      reliability:
        sla: {type: decimal, description: "uptime SLA as decimal", example: 0.999}
        historicalUptime: {type: decimal}
      costModel: {type: string, description: "pricing structure", example: "per-query with 10k free tier"}
      dataGovernance:
        owner: {type: string}
        classification: {type: enum, values: [public, internal, confidential, restricted]}
        retentionPolicy: {type: uri, description: "PolicyType reference"}
        privacyRegime: {type: "list[enum]", values: [GDPR, CCPA, SOX, MiFID]}
      provenance: {type: "Layer2:ProvenancedFact", description: "source metadata binding"}

    structures:
      ConnectionSpec:
        host: {type: string}
        port: {type: integer}
        database: {type: string}
        schema: {type: string}
        credentialsRef: {type: string, description: "reference to secrets manager entry"}
        ssl: {type: boolean, default: true}
        connectionPoolSize: {type: integer, default: 10}
        timeout: {type: duration, default: "PT30S"}

  # ==================== DatasetDefinition ====================
  DatasetDefinition:
    definition: "a meta-classifier for logical collections of data within a data source"
    purpose: "Represents tables, collections, topics, or files that contain entity data"

    requiredFields:
      iri: {type: uri, unique: true}
      namespace: {type: string, required: true}
      localName: {type: string, required: true}
      label: {type: string, required: true}

      definition:
        type: string
        required: true
        example: "table containing daily end-of-day equity prices from all global exchanges"

      dataSource:
        type: uri
        required: true
        description: "reference to DataSource IRI"

      physicalIdentifier:
        type: string
        required: true
        description: "actual table name, file path, topic, or collection name"
        example: "market_data.equity_prices_eod"

    optionalFields:
      schema: {type: DatasetSchema, description: "physical schema definition"}
      partitioning: {type: PartitioningSpec, description: "how dataset is partitioned"}
      updatePattern: {type: enum, values: [append, upsert, snapshot, cdc, eventSourcing]}
      temporalCoverage:
        startDate: {type: instant, description: "earliest available data"}
        endDate: {type: instant, description: "latest available data; null=ongoing"}
      volumetrics:
        rowCount: {type: integer}
        storageSize: {type: string, example: "1.2 TB"}
        growthRate: {type: string, example: "50 GB/month"}
      qualityMetrics:
        completeness: {type: decimal}
        accuracy: {type: decimal}
        timeliness: {type: duration}

    structures:
      DatasetSchema:
        fields: {type: "list[FieldDefinition]"}
        primaryKey: {type: "list[string]"}
        indexes: {type: "list[IndexDefinition]"}

      PartitioningSpec:
        strategy: {type: enum, values: [range, hash, list, composite]}
        partitionKeys: {type: "list[string]"}

