@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ax: <https://axiolune.ai/ontology/meta/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.

<https://axiolune.ai/ontology/meta/> rdfs:comment "Axiolune meta-model SHACL shapes — Tier 1 (machine-verifiable via rdf-validate-shacl).".
ax:PatternFact a owl:Class.
ax:PatternFactShape a sh:NodeShape;
    sh:targetClass ax:PatternFact.
<https://axiolune.ai/ontology/meta/patterns/PublicationTiming> a owl:Class;
    rdfs:subClassOf ax:PatternFact.
<https://axiolune.ai/ontology/meta/patterns/PublicationTimingShape> a sh:NodeShape;
    sh:targetClass <https://axiolune.ai/ontology/meta/patterns/PublicationTiming>;
    sh:property _:b1.
_:b1 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/publishedAt>;
    sh:datatype xsd:dateTime;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/PublicationTimingShape> sh:property _:b2.
_:b2 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/receivedAt>;
    sh:datatype xsd:dateTime;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/TemporalFact> a owl:Class;
    rdfs:subClassOf ax:PatternFact.
<https://axiolune.ai/ontology/meta/patterns/TemporalFactShape> a sh:NodeShape;
    sh:targetClass <https://axiolune.ai/ontology/meta/patterns/TemporalFact>;
    sh:property _:b3.
_:b3 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/TemporalFactShape> sh:property _:b4.
_:b4 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/TemporalFactShape> sh:property _:b5.
_:b5 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/TemporalFactShape> sh:property _:b6.
_:b6 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/TemporalFactShape> sh:property _:b7.
_:b7 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/observedAt>;
    sh:datatype xsd:dateTime;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/TemporalFactShape> sh:property _:b8.
_:b8 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/TemporalFactShape> sh:property _:b9.
_:b9 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/TemporalObservation> a owl:Class;
    rdfs:subClassOf ax:PatternFact.
<https://axiolune.ai/ontology/meta/patterns/TemporalObservationShape> a sh:NodeShape;
    sh:targetClass <https://axiolune.ai/ontology/meta/patterns/TemporalObservation>;
    sh:property _:b10.
_:b10 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/observedAt>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/TemporalObservationShape> sh:property _:b11.
_:b11 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/recordedAt>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/ProvenancedFact> a owl:Class;
    rdfs:subClassOf ax:PatternFact.
<https://axiolune.ai/ontology/meta/patterns/ProvenancedFactShape> a sh:NodeShape;
    sh:targetClass <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>;
    sh:property _:b12.
_:b12 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:datatype xsd:anyURI;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/ProvenancedFactShape> sh:property _:b13.
_:b13 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/sourceVersion>;
    sh:datatype xsd:string;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/ProvenancedFactShape> sh:property _:b14.
_:b14 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/confidence>;
    sh:datatype xsd:decimal;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/ProvenancedFactShape> sh:property _:b15.
_:b15 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/revision>;
    sh:datatype xsd:integer;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/ProvenancedFactShape> sh:property _:b16.
_:b16 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/derivedFrom>;
    sh:datatype xsd:anyURI;
    sh:minCount 0.
<https://axiolune.ai/ontology/meta/patterns/Evidence> a owl:Class;
    rdfs:subClassOf ax:PatternFact.
<https://axiolune.ai/ontology/meta/patterns/EvidenceShape> a sh:NodeShape;
    sh:targetClass <https://axiolune.ai/ontology/meta/patterns/Evidence>;
    sh:property _:b17.
_:b17 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/evidenceType>;
    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/EvidenceShape> sh:property _:b18.
_:b18 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/evidenceRef>;
    sh:datatype xsd:anyURI;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/EvidenceShape> sh:property _:b19.
_:b19 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/evidenceDigest>;
    sh:datatype xsd:string;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/EvidenceShape> sh:property _:b20.
_:b20 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/evidenceTimestamp>;
    sh:datatype xsd:dateTime;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/EvidenceShape> sh:property _:b21.
_:b21 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/evidenceDescription>;
    sh:datatype xsd:string;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/Lifecycle> a owl:Class;
    rdfs:subClassOf ax:PatternFact.
<https://axiolune.ai/ontology/meta/patterns/LifecycleShape> a sh:NodeShape;
    sh:targetClass <https://axiolune.ai/ontology/meta/patterns/Lifecycle>;
    sh:property _:b22.
_:b22 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/lifecycleState>;
    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/LifecycleShape> sh:property _:b23.
_:b23 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/lifecycleVersion>;
    sh:datatype xsd:integer;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/LifecycleShape> sh:property _:b24.
_:b24 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/createdAt>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/LifecycleShape> sh:property _:b25.
_:b25 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/updatedAt>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/LifecycleShape> sh:property _:b26.
_:b26 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/deprecatedAt>;
    sh:datatype xsd:dateTime;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/Versioning> a owl:Class;
    rdfs:subClassOf ax:PatternFact.
<https://axiolune.ai/ontology/meta/patterns/VersioningShape> a sh:NodeShape;
    sh:targetClass <https://axiolune.ai/ontology/meta/patterns/Versioning>;
    sh:property _:b27.
_:b27 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/semanticVersion>;
    sh:datatype xsd:string;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/VersioningShape> sh:property _:b28.
_:b28 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/versionedIri>;
    sh:datatype xsd:anyURI;
    sh:minCount 1;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/VersioningShape> sh:property _:b29.
_:b29 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/priorVersion>;
    sh:datatype xsd:anyURI;
    sh:minCount 0;
    sh:maxCount 1.
<https://axiolune.ai/ontology/meta/patterns/VersioningShape> sh:property _:b30.
_:b30 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/incompatibleWith>;
    sh:datatype xsd:anyURI;
    sh:minCount 0.
ax:PatternFactShape sh:property _:b31.
_:b31 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/confidence>;
    sh:minInclusive 0.0;
    sh:maxInclusive 1.0;
    sh:message "Confidence must be between 0.0 and 1.0 inclusive";
    sh:severity sh:Violation.
ax:PatternFactShape sh:property _:b32.
_:b32 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/evidenceDigest>;
    sh:pattern "^(sha256|sha512|blake3):[a-f0-9]{64,128}$";
    sh:message "Digest must be in format algorithm:hexdigest (e.g., sha256:abc123...)";
    sh:severity sh:Violation.
ax:PatternFactShape sh:property _:b33.
_:b33 sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/semanticVersion>;
    sh:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+$";
    sh:message "Semantic version must be in format MAJOR.MINOR.PATCH (e.g., 1.2.3)";
    sh:severity sh:Violation.
