{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiolune.ai/ontology/meta/schema/meta-model.schema.json",
  "title": "Axiolune Meta-Model Schema",
  "description": "JSON Schema for validating Axiolune ontology meta-model YAML files with hierarchical structure",
  "type": "object",
  "required": ["module"],
  "additionalProperties": true,
  "properties": {
    "module": {
      "$ref": "#/$defs/ModuleMetadata"
    }
  },
  "patternProperties": {
    "^[A-Z][a-zA-Z0-9]*$": {
      "description": "Top-level sections like MetaModel, CrossDomainPatterns, BehaviorModel, DataBinding",
      "type": "object",
      "properties": {
        "version": {"$ref": "#/$defs/SemanticVersion"},
        "description": {"type": "string"},
        "layer": {"type": "integer", "minimum": 1, "maximum": 4},
        "changes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "note": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "ModuleMetadata": {
      "type": "object",
      "required": ["moduleIri", "baseIri", "preferredPrefix", "version"],
      "additionalProperties": false,
      "properties": {
        "moduleIri": {
          "$ref": "#/$defs/IRI"
        },
        "baseIri": {
          "type": "string",
          "pattern": "^https?://[^\\s]+[/#]$",
          "description": "Base IRI for concept resolution, must end with / or #"
        },
        "preferredPrefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Prefix for compact references"
        },
        "version": {
          "$ref": "#/$defs/SemanticVersion"
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModuleImportDefinition"
          },
          "default": []
        },
        "exports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "ModuleImportDefinition": {
      "type": "object",
      "required": ["moduleIri", "version", "artifactDigest", "importMode"],
      "additionalProperties": false,
      "properties": {
        "moduleIri": {
          "$ref": "#/$defs/IRI"
        },
        "version": {
          "$ref": "#/$defs/SemanticVersion"
        },
        "artifactDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "importMode": {
          "enum": ["All", "Selective"]
        },
        "importedSymbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SymbolImportSpec"
          }
        }
      }
    },
    "SymbolImportSpec": {
      "type": "object",
      "required": ["symbolIri"],
      "additionalProperties": false,
      "properties": {
        "symbolIri": {
          "$ref": "#/$defs/IRI"
        },
        "localAlias": {
          "type": "string",
          "pattern": "^[A-Z][a-zA-Z0-9]*$"
        }
      }
    },
    "OntologyModuleDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "owlProjection": {"$ref": "#/$defs/OWLProjection"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"},
        "note": {"type": "string"}
      }
    },
    "ObjectTypeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "owlProjection": {"$ref": "#/$defs/OWLProjection"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"},
        "examples": {"type": "array"}
      }
    },
    "AttributeTypeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "iri": {"$ref": "#/$defs/IRI"},
        "namespace": {"type": "string"},
        "localName": {"type": "string"},
        "label": {"type": "string"},
        "definition": {"type": "string"},
        "valueType": {"type": "string"},
        "owlProjectionOverride": {
          "enum": ["datatypeProperty", "objectProperty", "annotationProperty"]
        },
        "defaultCardinality": {"type": "object"},
        "pattern": {"type": "string"},
        "note": {"type": "string"},
        "alignments": {"type": "array"}
      }
    },
    "RelationTypeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "iri": {"$ref": "#/$defs/IRI"},
        "namespace": {"type": "string"},
        "localName": {"type": "string"},
        "label": {"type": "string"},
        "definition": {"type": "string"},
        "domain": {"type": "string"},
        "range": {"type": "string"},
        "inverseOf": {"$ref": "#/$defs/IRI"},
        "characteristics": {"type": "array"},
        "alignments": {"type": "array"}
      }
    },
    "AssociationTypeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "iri": {"$ref": "#/$defs/IRI"},
        "definition": {"type": "string"},
        "participantRoles": {"type": "array"},
        "attributeUses": {"type": "array"},
        "patternBindings": {"type": "array"}
      }
    },
    "IdentifierTypeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "owlProjection": {"$ref": "#/$defs/OWLProjection"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"}
      }
    },
    "MoneyTypeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "owlProjection": {"$ref": "#/$defs/OWLProjection"},
        "structure": {"type": "object"},
        "note": {"type": "string"}
      }
    },
    "QuantityTypeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "owlProjection": {"$ref": "#/$defs/OWLProjection"},
        "structure": {"type": "object"},
        "note": {"type": "string"}
      }
    },
    "CodeListTypeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "owlProjection": {"$ref": "#/$defs/OWLProjection"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"}
      }
    },
    "ConstraintDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "owlProjection": {"$ref": "#/$defs/OWLProjection"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"}
      }
    },
    "PatternDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "purpose": {"type": "string"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"}
      }
    },
    "QueryTypeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"},
        "returnShape": {"type": "object"}
      }
    },
    "ActionTypeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"},
        "idempotency": {
          "enum": ["isIdempotent", "conditionallyIdempotent", "nonIdempotent"]
        },
        "retryPolicy": {"type": "object"}
      }
    },
    "ExecutionRecordDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "purpose": {"type": "string"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"}
      }
    },
    "TransformationDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "purpose": {"type": "string"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"},
        "structures": {"type": "object"}
      }
    },
    "DatasetDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "purpose": {"type": "string"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"},
        "structures": {"type": "object"}
      }
    },
    "SemanticMappingDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "purpose": {"type": "string"},
        "note": {"type": "string"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"},
        "structures": {"type": "object"}
      }
    },
    "MaterializationPlanDefinition": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "definition": {"type": "string"},
        "purpose": {"type": "string"},
        "note": {"type": "string"},
        "requiredFields": {"type": "object"},
        "optionalFields": {"type": "object"},
        "structures": {"type": "object"}
      }
    },
    "OWLProjection": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {"type": "string"},
        "rules": {
          "type": "array",
          "items": {"type": "string"}
        },
        "note": {"type": "string"}
      }
    },
    "TypeRef": {
      "type": "string",
      "description": "Type reference: primitive (string, integer, etc), structured (list[T], map[K,V]), or IRI"
    },
    "IRI": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "SemanticVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
