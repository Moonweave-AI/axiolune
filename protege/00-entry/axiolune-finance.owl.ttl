@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://axiolune.ai/ontology/finance> a owl:Ontology ;
    rdfs:label "Axiolune Finance Domain (M2)" ;
    rdfs:comment "Root import ontology for all approved M2 finance modules (v1.0.0). Open this file in Protege with catalog-v001.xml active." ;
    owl:imports <https://axiolune.ai/ontology/finance/foundation> ;
    owl:imports <https://axiolune.ai/ontology/finance/market-structure> ;
    owl:imports <https://axiolune.ai/ontology/finance/instruments> ;
    owl:imports <https://axiolune.ai/ontology/finance/market-data> ;
    owl:imports <https://axiolune.ai/ontology/finance/portfolio-positions> ;
    owl:imports <https://axiolune.ai/ontology/finance/orders-execution> ;
    owl:imports <https://axiolune.ai/ontology/finance/post-trade-operations> ;
    owl:imports <https://axiolune.ai/ontology/finance/market-rules> ;
    owl:imports <https://axiolune.ai/ontology/finance/risk> ;
    owl:imports <https://axiolune.ai/ontology/finance/strategy-research> ;
    owl:versionIRI <https://axiolune.ai/ontology/finance/1.0.0> .
