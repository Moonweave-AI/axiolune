@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://axiolune.ai/ontology/all> a owl:Ontology ;
    rdfs:label "Axiolune Full Ontology" ;
    rdfs:comment "Root import ontology for M3 meta-model plus all M2 finance modules." ;
    owl:imports <https://axiolune.ai/ontology/meta> ;
    owl:imports <https://axiolune.ai/ontology/finance> ;
    owl:versionIRI <https://axiolune.ai/ontology/all/1.0.0> .
