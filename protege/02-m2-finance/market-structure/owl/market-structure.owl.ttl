<https://axiolune.ai/ontology/finance/market-structure> a owl:Ontology;
    rdfs:comment "market-structure vocabulary for versioned trading facilities, MIC registry entries, calendars, session schedules, exceptions, and non-listing trading contexts";
    rdfs:label "Market Structure";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/market-structure/1.0.0>.
fin-market-structure:CalendarExceptionKind a owl:Class;
    rdfs:comment "closed classification of deterministic changes to scheduled session occurrences";
    rdfs:label "Calendar Exception Kind";
    owl:oneOf _:l_27cffa35654b1299995209db_0.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme> a skos:ConceptScheme;
