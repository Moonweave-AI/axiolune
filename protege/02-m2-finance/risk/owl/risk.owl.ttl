<https://axiolune.ai/ontology/finance/risk> a owl:Ontology;
    rdfs:comment "versioned risk-measure specifications, completed measurements, compatible limits, explicit limit evaluations, bucketed results, and breach facts whose values, scopes, model inputs, and run provenance remain point-in-time reproducible";
    rdfs:label "Risk";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/market-data>, <https://axiolune.ai/ontology/finance/portfolio-positions>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/risk/1.0.0>.
fin-risk:LimitBreach a owl:Class;
    rdfs:comment "immutable breach fact that exists only for a breach evaluation and repeats that evaluation's exact measurement, exact limit, and generating context without introducing a second threshold or result truth";
