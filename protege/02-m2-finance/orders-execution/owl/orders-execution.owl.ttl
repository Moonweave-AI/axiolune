<https://axiolune.ai/ontology/finance/orders-execution> a owl:Ontology;
    rdfs:comment "Order intent, immutable split and aggregation lineage, external order, provider event stream, lifecycle event, execution, fee, status adaptation, liquidity determination, and stream integrity semantics with explicit identity and reference-mode contracts.";
    rdfs:label "Orders and Execution";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/instruments>, <https://axiolune.ai/ontology/finance/market-rules>, <https://axiolune.ai/ontology/finance/market-structure>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/orders-execution/1.0.0>.
fin-orders:Execution a owl:Class;
    rdfs:comment "Immutable provider trade or fill fact in one exact event stream with one external order and originating intent, explicit execution-side Party/account and contra-side Party/account roles, instrument, positive absolute quantity, independent side, Money price, listed-or-OTC context, and the exact matching DirectUnitPriceQuotationContract. An optional executing broker is an intermediary role and never substitutes for either bilateral Party/account role.";
    rdfs:label "Execution";
