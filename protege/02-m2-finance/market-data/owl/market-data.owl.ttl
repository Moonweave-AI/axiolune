fin-market-data:calculationDefinitionDigest a owl:DatatypeProperty;
    rdfs:comment "lowercase SHA-256 digest of the exact calculation-definition bytes selected by calculationDefinitionRef";
    rdfs:label "Calculation Definition Digest";
    rdfs:range xsd:string.
fin-market-data:calculationDefinitionRef a owl:DatatypeProperty;
    rdfs:comment "absolute IRI of the exact immutable calculation definition used to derive a VWAP or TWAP observation";
    rdfs:label "Calculation Definition Reference";
    rdfs:range xsd:anyURI.
fin-market-data:calculationInputSetDigest a owl:DatatypeProperty;
    rdfs:comment "lowercase SHA-256 digest of the RFC 8785 canonical, semantically selected input FactVersion snapshots used by the calculation run; any selected identity, payload, temporal-axis, context, or order change changes this digest";
    rdfs:label "Calculation Input Fact Set Digest";
    rdfs:range xsd:string.
fin-market-data:calculationRunDigest a owl:DatatypeProperty;
    rdfs:comment "lowercase SHA-256 digest of the exact calculation-run evidence bytes selected by calculationRunRef";
    rdfs:label "Calculation Run Digest";
    rdfs:range xsd:string.
fin-market-data:calculationRunRef a owl:DatatypeProperty;
    rdfs:comment "absolute IRI of the immutable calculation-run evidence that identifies the exact input FactVersions, selection window, calculation definition, computed output, and append-only recalculation policy for a VWAP or TWAP observation";
    rdfs:label "Calculation Run Reference";
    rdfs:range xsd:anyURI.
fin-market-data:firstContributingEventAt a owl:DatatypeProperty;
    rdfs:comment "UTC occurrence instant of the first source event in a non-time bar";
    rdfs:label "First Contributing Event At";
    rdfs:range xsd:dateTimeStamp.
fin-market-data:fxRate a owl:ObjectProperty;
    rdfs:comment "strictly positive dimensionless Quantity meaning quote-currency units per one base-currency unit";
    rdfs:label "FX Rate";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:intervalEnd a owl:DatatypeProperty;
    rdfs:comment "exclusive UTC instant at which a time bar aggregation window ends";
    rdfs:label "Interval End";
    rdfs:range xsd:dateTimeStamp.
fin-market-data:intervalStart a owl:DatatypeProperty;
    rdfs:comment "inclusive UTC instant at which a time bar aggregation window starts";
    rdfs:label "Interval Start";
    rdfs:range xsd:dateTimeStamp.
fin-market-data:lastAskSize a owl:ObjectProperty;
    rdfs:comment "non-negative representative ask Quantity preserved by a QuoteBar";
    rdfs:label "Last Ask Size";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:lastBidSize a owl:ObjectProperty;
    rdfs:comment "non-negative representative bid Quantity preserved by a QuoteBar";
    rdfs:label "Last Bid Size";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:lastContributingEventAt a owl:DatatypeProperty;
    rdfs:comment "UTC occurrence instant of the last source event in a non-time bar";
    rdfs:label "Last Contributing Event At";
    rdfs:range xsd:dateTimeStamp.
fin-market-data:observationIdFieldLocator a owl:ObjectProperty;
    rdfs:comment "closed SourceLocator selecting the exact raw source field mapped to the observation or event identifier";
    rdfs:label "Observation Identifier Field Locator";
    rdfs:range <https://axiolune.ai/ontology/meta/data-binding/structures/SourceLocator>.
fin-market-data:orderingTransformDigest a owl:DatatypeProperty;
    rdfs:comment "lowercase SHA-256 digest of the exact ordering transformation bytes";
    rdfs:label "Ordering Transformation Digest";
    rdfs:range xsd:string.
fin-market-data:orderingTransformRef a owl:DatatypeProperty;
    rdfs:comment "absolute IRI of the lossless ordering tuple mapping or locked uniqueness-preserving transformation";
    rdfs:label "Ordering Transformation Reference";
    rdfs:range xsd:anyURI.
fin-market-data:priceKind a owl:ObjectProperty;
    rdfs:comment "one compatible PriceKind member; bid and ask are prohibited because they are quote structure";
    rdfs:label "Price Kind";
    rdfs:range fin-market-data:PriceKind.
fin-market-data:priceValue a owl:ObjectProperty;
    rdfs:comment "Money value of one price observation, including the sole quote-currency truth";
    rdfs:label "Price Value";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:providerObservationId a owl:DatatypeProperty;
    rdfs:comment "non-empty raw observation or event identifier selected by the stream source contract";
    rdfs:label "Provider Observation Identifier";
    rdfs:range xsd:string.
fin-market-data:providerStreamId a owl:DatatypeProperty;
    rdfs:comment "non-empty identifier unique for a stream within its provider and source contract";
    rdfs:label "Provider Stream Identifier";
    rdfs:range xsd:string.
fin-market-data:qualityFindingKind a owl:ObjectProperty;
    rdfs:comment "one closed MarketDataQualityFindingKind member whose predicate must hold exactly";
    rdfs:label "Quality Finding Kind";
    rdfs:range fin-market-data:MarketDataQualityFindingKind.
fin-market-data:sourceApiIdentifier a owl:DatatypeProperty;
    rdfs:comment "provider-declared stable identifier for the API or delivery interface";
    rdfs:label "Source API Identifier";
    rdfs:range xsd:string.
fin-market-data:sourceContractDigest a owl:DatatypeProperty;
    rdfs:comment "lowercase SHA-256 digest recomputed from the exact immutable source-contract bytes";
    rdfs:label "Source Contract Digest";
    rdfs:range xsd:string.
fin-market-data:sourceContractRef a owl:DatatypeProperty;
    rdfs:comment "absolute IRI of the immutable provider schema and normalization contract";
    rdfs:label "Source Contract Reference";
    rdfs:range xsd:anyURI.
fin-market-data:sourceOrderKey a owl:DatatypeProperty;
    rdfs:comment "non-negative lossless provider sequence or output of the stream's locked uniqueness-preserving transformation";
    rdfs:label "Source Order Key";
    rdfs:range xsd:integer.
fin-market-data:sourceRecordRevisionMode a owl:ObjectProperty;
    rdfs:comment "closed immutable-record or revisioned-record policy selected by the exact source contract";
    rdfs:label "Source Record Revision Mode";
    rdfs:range fin-market-data:SourceRecordRevisionMode.
fin-market-data:sourceRevisionFieldLocator a owl:ObjectProperty;
    rdfs:comment "closed SourceLocator selecting the raw revision field required only by revisioned-record streams";
    rdfs:label "Source Revision Field Locator";
    rdfs:range <https://axiolune.ai/ontology/meta/data-binding/structures/SourceLocator>.
fin-market-data:sourceRevisionOrder a owl:DatatypeProperty;
    rdfs:comment "non-negative provider revision order required only under revisionedRecord policy";
    rdfs:label "Source Revision Order";
    rdfs:range xsd:integer.
fin-market-data:sourceRevisionToken a owl:DatatypeProperty;
    rdfs:comment "normalized provider revision value required only under revisionedRecord policy";
    rdfs:label "Source Revision Token";
    rdfs:range xsd:string.
fin-market-data:sourceSchemaIdentifier a owl:DatatypeProperty;
    rdfs:comment "provider-declared stable identifier for the source record schema";
    rdfs:label "Source Schema Identifier";
    rdfs:range xsd:string.
fin-market-data:sourceSchemaVersion a owl:DatatypeProperty;
    rdfs:comment "exact provider schema version interpreted by the locked source contract";
    rdfs:label "Source Schema Version";
    rdfs:range xsd:string.
fin-market-data:sourceTradeId a owl:DatatypeProperty;
    rdfs:comment "non-empty provider trade identifier used as the final canonical-order tiebreaker and logical-key component";
    rdfs:label "Source Trade Identifier";
    rdfs:range xsd:string.
fin-market-data:streamProvider a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relates a MarketDataStream version to the logical Party that provides and scopes the stream";
    rdfs:domain fin-market-data:MarketDataStream;
    rdfs:label "Stream Provider";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-market-data:streamPurpose a owl:ObjectProperty;
    rdfs:comment "one closed MarketDataStreamPurpose member limiting record kinds accepted from the stream";
    rdfs:label "Stream Purpose";
    rdfs:range fin-market-data:MarketDataStreamPurpose.
fin-market-data:tradeClosePrice a owl:ObjectProperty;
    rdfs:comment "last trade Money price in a TradeBar aggregation window";
    rdfs:label "Trade Close Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:tradeHighPrice a owl:ObjectProperty;
    rdfs:comment "greatest trade Money price in a TradeBar aggregation window";
    rdfs:label "Trade High Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:tradeLowPrice a owl:ObjectProperty;
    rdfs:comment "least trade Money price in a TradeBar aggregation window";
    rdfs:label "Trade Low Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:tradeOpenPrice a owl:ObjectProperty;
    rdfs:comment "first trade Money price in a TradeBar aggregation window";
    rdfs:label "Trade Open Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:tradePrice a owl:ObjectProperty;
    rdfs:comment "Money execution price reported by one TradeObservation";
    rdfs:label "Trade Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:tradeSize a owl:ObjectProperty;
    rdfs:comment "strictly positive Quantity reported by one TradeObservation";
    rdfs:label "Trade Size";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:tradeVolume a owl:ObjectProperty;
    rdfs:comment "non-negative aggregate Quantity of trades contributing to one TradeBar";
    rdfs:label "Trade Volume";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
