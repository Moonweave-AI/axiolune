fro-usc-t12-ch53:id83a191cc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-2-2-2> ;
  fro-usc:hasContentText "Except as provided in section 5584 of this title , all employees of the Office of Thrift Supervision shall be transferred to the Office of the Comptroller of the Currency or the Corporation for employment in accordance with this section." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a191cc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5584" ;
.
fro-usc-t12-ch53:id83a191cd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-2-2-3> ;
  fro-usc:hasHeading "Allocating employees for transfer to receiving agencies" ;
  fro-usc:hasId "id83a191cd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-5-3-2-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191ce-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191cf-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a191ce-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-2-2-3-3> ;
  fro-usc:hasContentText "jointly determine the number of employees of the Office of Thrift Supervision necessary to perform or support the functions that are transferred to the Office of the Comptroller of the Currency or the Corporation by this title;  1 and" ;
  fro-usc:hasId "id83a191ce-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/a/1/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a191cf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-2-2-3-4> ;
  fro-usc:hasContentText "consistent with the determination under clause (i), jointly identify employees of the Office of Thrift Supervision for transfer to the Office of the Comptroller of the Currency or the Corporation." ;
  fro-usc:hasId "id83a191cf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/a/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a191d0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-2-3> ;
  fro-usc:hasContentText "For purposes of this section, periods of service with a Federal home loan bank, a joint office of Federal home loan banks, or a Federal reserve bank shall be credited as periods of service with a Federal agency." ;
  fro-usc:hasHeading "Employees transferred; service periods credited" ;
  fro-usc:hasId "id83a191d0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a191d1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-2-4> ;
  fro-usc:hasHeading "Appointment authority for excepted service transferred" ;
  fro-usc:hasId "id83a191d1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/a/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191d2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191d3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a191d2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-2-4-2> ;
  fro-usc:hasContentText "Except as provided in subparagraph (B), any appointment authority of the Office of Thrift Supervision under Federal law that relates to the functions transferred under section 5412 of this title , including the regulations of the Office of Personnel Management, for filling the positions of employees in the excepted service shall be transferred to the Comptroller of the Currency or the Chairperson of the Corporation, as appropriate." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a191d2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/a/3/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5412" ;
.
fro-usc-t12-ch53:id83a191d3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-2-4-3> ;
  fro-usc:hasContentText "The Comptroller of the Currency or the Chairperson of the Corporation may decline to accept a transfer of authority under subparagraph (A) (and the employees appointed under that authority) to the extent that such authority relates to positions excepted from the competitive service because of their confidential, policy-making, policy-determining, or policy-advocating character." ;
  fro-usc:hasHeading "Declining transfers allowed" ;
  fro-usc:hasId "id83a191d3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/a/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a191d4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-2-5> ;
  fro-usc:hasContentText "Notwithstanding any other provision of law, the Office of the Comptroller of the Currency and the Corporation may appoint transferred employees to positions in the Office of the Comptroller of the Currency or the Corporation, respectively." ;
  fro-usc:hasHeading "Additional appointment authority" ;
  fro-usc:hasId "id83a191d4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a191d5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191d6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191d7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-3> ;
  fro-usc:hasHeading "Timing of transfers and position assignments" ;
  fro-usc:hasId "id83a191d5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-5-3-3-2> ;
.
fro-usc-t12-ch53:id83a191d6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-3-3> ;
  fro-usc:hasContentText "be transferred not later than 90 days after the transfer date; and" ;
  fro-usc:hasId "id83a191d6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a191d7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-3-4> ;
  fro-usc:hasContentText "receive notice of the position assignment of the employee not later than 120 days after the effective date of the transfer of the employee." ;
  fro-usc:hasId "id83a191d7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a191d8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191d9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191da-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-4> ;
  fro-usc:hasHeading "Transfer of functions" ;
  fro-usc:hasId "id83a191d8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a191d9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-4-2> ;
  fro-usc:hasContentText "Notwithstanding any other provision of law, the transfer of employees under this part shall be deemed a transfer of functions for the purpose of section 3503 of title 5 ." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a191d9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/c/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s3503" ;
.
fro-usc-t12-ch53:id83a191da-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-4-3> ;
  fro-usc:hasContentText "If any provision of this part conflicts with any protection provided to a transferred employee under section 3503 of title 5 , the provisions of this part shall control." ;
  fro-usc:hasHeading "Priority" ;
  fro-usc:hasId "id83a191da-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s3503" ;
.
fro-usc-t12-ch53:id83a191db-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-5> ;
  fro-usc:hasContentText "The transfer of functions and employees under this part, and the abolishment of the Office of Thrift Supervision under section 5413 of this title , shall not affect the status of the transferred employees as employees of an agency of the United States under any provision of law." ;
  fro-usc:hasHeading "Employee status and eligibility" ;
  fro-usc:hasId "id83a191db-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5413" ;
.
fro-usc-t12-ch53:id83a191dc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191dd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191de-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-6> ;
  fro-usc:hasHeading "Equal status and tenure positions" ;
  fro-usc:hasId "id83a191dc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83a191dd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-6-2> ;
  fro-usc:hasContentText "Each transferred employee from the Office of Thrift Supervision shall be placed in a position at the Office of the Comptroller of the Currency or the Corporation with the same status and tenure as the transferred employee held on the day before the date on which the employee was transferred." ;
  fro-usc:hasHeading "Status and tenure" ;
  fro-usc:hasId "id83a191dd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a191de-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-6-3> ;
  fro-usc:hasContentText "To the extent practicable, each transferred employee shall be placed in a position at the Office of the Comptroller of the Currency or the Corporation, as applicable, responsible for the same functions and duties as the transferred employee had on the day before the date on which the employee was transferred, in accordance with the expertise and preferences of the transferred employee." ;
  fro-usc:hasHeading "Functions" ;
  fro-usc:hasId "id83a191de-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a191df-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-7> ;
  fro-usc:hasContentText "An examiner who is a transferred employee shall not be subject to any additional certification requirements before being placed in a comparable position at the Office of the Comptroller of the Currency or the Corporation, if the examiner carries out examinations of the same type of institutions as an employee of the Office of the Comptroller of the Currency or the Corporation as the employee was responsible for carrying out before the date on which the employee was transferred." ;
  fro-usc:hasHeading "No additional certification requirements" ;
  fro-usc:hasId "id83a191df-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83a191e0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191e1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191e6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-8> ;
  fro-usc:hasHeading "Personnel actions limited" ;
  fro-usc:hasId "id83a191e0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id83a191e1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-8-2> ;
  fro-usc:hasHeading "Protection" ;
  fro-usc:hasId "id83a191e1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/g/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191e2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191e3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a191e2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-8-2-2> ;
  fro-usc:hasContentText "Except as provided in paragraph (2), each affected employee shall not, during the 30-month period beginning on the transfer date, be involuntarily separated, or involuntarily reassigned outside his or her locality pay area." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a191e2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/g/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a191e3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-8-2-3> ;
  fro-usc:hasHeading "Affected employees" ;
  fro-usc:hasId "id83a191e3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/g/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-5-3-8-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191e4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191e5-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a191e4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-8-2-3-3> ;
  fro-usc:hasContentText "an employee transferred from the Office of Thrift Supervision holding a permanent position on the day before the transfer date; and" ;
  fro-usc:hasId "id83a191e4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/g/1/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a191e5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-8-2-3-4> ;
  fro-usc:hasContentText "an employee of the Office of the Comptroller of the Currency or the Corporation holding a permanent position on the day before the transfer date." ;
  fro-usc:hasId "id83a191e5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/g/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a191e6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-8-3> ;
  fro-usc:hasHeading "Exceptions" ;
  fro-usc:hasId "id83a191e6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/g/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-5-3-8-3-2> ;
