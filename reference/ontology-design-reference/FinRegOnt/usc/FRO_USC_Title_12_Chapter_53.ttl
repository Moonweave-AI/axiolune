fro-usc-t12-ch53:id839360cb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360cc-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360cd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2> ;
  fro-usc:hasHeading "U.S. nonbank financial companies supervised by the Board of Governors" ;
  fro-usc:hasId "id839360cb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id839360cc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-2> ;
  fro-usc:hasContentText "The Council, on a nondelegable basis and by a vote of not fewer than ⅔ of the voting members then serving, including an affirmative vote by the Chairperson, may determine that a U.S. nonbank financial company shall be supervised by the Board of Governors and shall be subject to prudential standards, in accordance with this subchapter, if the Council determines that material financial distress at the U.S. nonbank financial company, or the nature, scope, size, scale, concentration, interconnectedness, or mix of the activities of the U.S. nonbank financial company, could pose a threat to the financial stability of the United States." ;
  fro-usc:hasHeading "Determination" ;
  fro-usc:hasId "id839360cc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839360cd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
