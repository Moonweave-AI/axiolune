  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25b14-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b15-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b16-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b19-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b1c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b36-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a42e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a42f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b4a43a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3> ;
  fro-usc:hasHeading "Emergency financial stabilization" ;
  fro-usc:hasId "id83b25b14-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612" ;
  fro-usc:hasNumberText "§ 5612." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a438-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25b15-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-2> ;
  fro-usc:hasContentText "Upon the written determination of the Corporation and the Board of Governors under section 5611 of this title , the Corporation shall create a widely available program to guarantee obligations of solvent insured depository institutions or solvent depository institution holding companies (including any affiliates thereof) during times of severe economic distress, except that a guarantee of obligations under this section may not include the provision of equity in any form." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b25b15-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5611" ;
.
fro-usc-t12-ch53:id83b25b16-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b17-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b18-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-3> ;
  fro-usc:hasHeading "Rulemaking and terms and conditions" ;
  fro-usc:hasId "id83b25b16-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83b25b17-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-3-2> ;
  fro-usc:hasContentText "As soon as is practicable after July 21, 2010 , the Corporation shall establish, by regulation, and in consultation with the Secretary, policies and procedures governing the issuance of guarantees authorized by this section. Such policies and procedures may include a requirement of collateral as a condition of any such guarantee." ;
  fro-usc:hasHeading "Policies and procedures" ;
  fro-usc:hasId "id83b25b17-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25b18-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-3-3> ;
  fro-usc:hasContentText "The terms and conditions of any guarantee program shall be established by the Corporation, with the concurrence of the Secretary." ;
  fro-usc:hasHeading "Terms and conditions" ;
  fro-usc:hasId "id83b25b18-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25b19-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b1a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b1b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-4> ;
  fro-usc:hasHeading "Determination of guaranteed amount" ;
  fro-usc:hasId "id83b25b19-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83b25b1a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-4-2> ;
  fro-usc:hasContentText "In connection with any program established pursuant to subsection (a) and subject to paragraph (2) of this subsection, the Secretary (in consultation with the President) shall determine the maximum amount of debt outstanding that the Corporation may guarantee under this section, and the President may transmit to Congress a written report on the plan of the Corporation to exercise the authority under this section to issue guarantees up to that maximum amount and a request for approval of such plan. The Corporation shall exercise the authority under this section to issue guarantees up to that specified maximum amount upon passage of the joint resolution of approval, as provided in subsection (d). Absent such approval, the Corporation shall issue no such guarantees." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b25b1a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25b1b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-4-3> ;
  fro-usc:hasContentText "If the Secretary (in consultation with the President) determines, after a submission to Congress under paragraph (1), that the maximum guarantee amount should be raised, and the Council concurs with that determination, the President may transmit to Congress a written report on the plan of the Corporation to exercise the authority under this section to issue guarantees up to the increased maximum debt guarantee amount. The Corporation shall exercise the authority under this section to issue guarantees up to that specified maximum amount upon passage of the joint resolution of approval, as provided in subsection (d). Absent such approval, the Corporation shall issue no such guarantees." ;
  fro-usc:hasHeading "Additional debt guarantee authority" ;
  fro-usc:hasId "id83b25b1b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25b1c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b1d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b1e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b26-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25b31-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-5> ;
  fro-usc:hasHeading "Resolution of approval" ;
  fro-usc:hasId "id83b25b1c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83b25b1d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-5-2> ;
  fro-usc:hasContentText "A request by the President under this section shall be considered granted by Congress upon adoption of a joint resolution approving such request. Such joint resolution shall be considered in the Senate under expedited procedures." ;
  fro-usc:hasHeading "Additional debt guarantee authority" ;
  fro-usc:hasId "id83b25b1d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25b1e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-5-3> ;
  fro-usc:hasHeading "Fast track consideration in Senate" ;
  fro-usc:hasId "id83b25b1e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/d/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25b1f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25b20-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25b21-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25b1f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-5-3-2> ;
  fro-usc:hasContentText "Upon receipt of a request under subsection (c), if the Senate has adjourned or recessed for more than 2 days, the majority leader of the Senate, after consultation with the minority leader of the Senate, shall notify the Members of the Senate that, pursuant to this section, the Senate shall convene not later than the second calendar day after receipt of such message." ;
  fro-usc:hasHeading "Reconvening" ;
  fro-usc:hasId "id83b25b1f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/d/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83b25b20-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-5-3-3> ;
  fro-usc:hasContentText "Upon introduction in the Senate, the joint resolution shall be placed immediately on the calendar." ;
  fro-usc:hasHeading "Placement on calendar" ;
  fro-usc:hasId "id83b25b20-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/d/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
