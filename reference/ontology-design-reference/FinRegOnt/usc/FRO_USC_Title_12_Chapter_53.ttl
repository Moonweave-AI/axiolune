  fro-usc:hasId "id839360b6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-3-4-2> ;
.
fro-usc-t12-ch53:id839360b7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
