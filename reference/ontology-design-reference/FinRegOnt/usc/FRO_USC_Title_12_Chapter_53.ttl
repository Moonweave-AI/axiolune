fro-usc-t12-ch53:id8390f018-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-2> ;
  fro-usc:hasContentText "any broker or dealer that is registered with the Commission under the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], with respect to the activities of the broker or dealer that require the broker or dealer to be registered under that Act;" ;
  fro-usc:hasId "id8390f018-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
fro-usc-t12-ch53:id8390f019-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-3> ;
  fro-usc:hasContentText "any investment company that is registered with the Commission under the Investment Company Act of 1940 [ 15 U.S.C. 80a–1 et seq.], with respect to the activities of the investment company that require the investment company to be registered under that Act;" ;
  fro-usc:hasId "id8390f019-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–1" ;
.
fro-usc-t12-ch53:id8390f01a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-4> ;
  fro-usc:hasContentText "any investment adviser that is registered with the Commission under the Investment Advisers Act of 1940 [ 15 U.S.C. 80b–1 et seq.], with respect to the investment advisory activities of such company and activities that are incidental to such advisory activities;" ;
  fro-usc:hasId "id8390f01a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–1" ;
.
fro-usc-t12-ch53:id8390f01b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-5> ;
  fro-usc:hasContentText "any clearing agency registered with the Commission under the Securities Exchange Act of 1934, with respect to the activities of the clearing agency that require the agency to be registered under such Act;" ;
  fro-usc:hasId "id8390f01b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id8390f01c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-6> ;
  fro-usc:hasContentText "any nationally recognized statistical rating organization registered with the Commission under the Securities Exchange Act of 1934;" ;
  fro-usc:hasId "id8390f01c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/v" ;
  fro-usc:hasNumberText "(v)" ;
.
fro-usc-t12-ch53:id8390f01d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-7> ;
  fro-usc:hasContentText "any transfer agent registered with the Commission under the Securities Exchange Act of 1934;" ;
  fro-usc:hasId "id8390f01d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/vi" ;
  fro-usc:hasNumberText "(vi)" ;
.
fro-usc-t12-ch53:id8390f01e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-8> ;
  fro-usc:hasContentText "any exchange registered as a national securities exchange with the Commission under the Securities Exchange Act of 1934;" ;
  fro-usc:hasId "id8390f01e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/vii" ;
  fro-usc:hasNumberText "(vii)" ;
.
fro-usc-t12-ch53:id8390f01f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-9> ;
  fro-usc:hasContentText "any national securities association registered with the Commission under the Securities Exchange Act of 1934;" ;
  fro-usc:hasId "id8390f01f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/viii" ;
  fro-usc:hasNumberText "(viii)" ;
.
fro-usc-t12-ch53:id8390f020-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-10> ;
  fro-usc:hasContentText "any securities information processor registered with the Commission under the Securities Exchange Act of 1934;" ;
  fro-usc:hasId "id8390f020-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/ix" ;
  fro-usc:hasNumberText "(ix)" ;
.
fro-usc-t12-ch53:id83936021-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-11> ;
  fro-usc:hasContentText "the Municipal Securities Rulemaking Board established under the Securities Exchange Act of 1934;" ;
  fro-usc:hasId "id83936021-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/x" ;
  fro-usc:hasNumberText "(x)" ;
.
fro-usc-t12-ch53:id83936022-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-12> ;
  fro-usc:hasContentText "the Public Company Accounting Oversight Board established under the Sarbanes-Oxley Act of 2002 ( 15 U.S.C. 7211 et seq.);" ;
  fro-usc:hasId "id83936022-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/xi" ;
  fro-usc:hasNumberText "(xi)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s7211" ;
.
fro-usc-t12-ch53:id83936023-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-13> ;
  fro-usc:hasContentText "the Securities Investor Protection Corporation established under the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.); and" ;
  fro-usc:hasId "id83936023-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/xii" ;
  fro-usc:hasNumberText "(xii)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id83936024-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-4-14> ;
  fro-usc:hasContentText "any security-based swap execution facility, security-based swap data repository, security-based swap dealer or major security-based swap participant registered with the Commission under the Securities Exchange Act of 1934, with respect to the security-based swap activities of the person that require such person to be registered under such Act;" ;
  fro-usc:hasId "id83936024-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/B/xiii" ;
  fro-usc:hasNumberText "(xiii)" ;
.
