  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-3-3-3-4> ;
  fro-usc:hasContentText "to transfer assets and liabilities;" ;
  fro-usc:hasId "id839a8c56-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/b/2/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839a8c57-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-3-3-3-5> ;
  fro-usc:hasContentText "to enforce or repudiate contracts; or" ;
  fro-usc:hasId "id839a8c57-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/b/2/A/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id839a8c58-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-3-3-3-6> ;
  fro-usc:hasContentText "to take any other action relating to such bridge financial company under section 5390 of this title ; or" ;
  fro-usc:hasId "id839a8c58-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/b/2/A/v" ;
  fro-usc:hasNumberText "(v)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390" ;
.
fro-usc-t12-ch53:id839a8c59-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-3-3-4> ;
  fro-usc:hasContentText "determining claims under subsection (e)." ;
  fro-usc:hasId "id839a8c59-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8c5a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-3-4> ;
  fro-usc:hasContentText "SIPC and the Corporation, in consultation with the Commission, shall jointly determine the terms of the protective decree to be filed by SIPC with any court of competent jurisdiction under section 78u or 78aa of title 15, as required by subsection (a)." ;
  fro-usc:hasHeading "Protective decree" ;
  fro-usc:hasId "id839a8c5a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839a8c5b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-3-5> ;
  fro-usc:hasContentText "Notwithstanding any provision of the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa . et seq.) to the contrary (including section 5(b)(2)(C) of that Act ( 15 U.S.C. 78eee(b)(2)(C) )), the rights and obligations of any party to a qualified financial contract (as that term is defined in section 5390(c)(8) of this title ) to which a covered broker or dealer for which the Corporation has been appointed receiver is a party shall be governed exclusively by section 5390 of this title , including the limitations and restrictions contained in section 5390(c)(10)(B) of this title" ;
  fro-usc:hasHeading "Qualified financial contracts" ;
  fro-usc:hasId "id839a8c5b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/b/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/c/10/B" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/c/8" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78eee/b/2/C" ;
.
fro-usc-t12-ch53:id839a8c5c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-4> ;
  fro-usc:hasContentText "Except as otherwise provided in this subchapter, no court may take any action, including any action pursuant to the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.) or the Bankruptcy Code, to restrain or affect the exercise of powers or functions of the Corporation as receiver for a covered broker or dealer and any claims against the Corporation as such receiver shall be determined in accordance with subsection (e) and such claims shall be limited to money damages." ;
  fro-usc:hasHeading "Limitation on court action" ;
  fro-usc:hasId "id839a8c5c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c5d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c5e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c62-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-5> ;
  fro-usc:hasHeading "Actions by Corporation as receiver" ;
  fro-usc:hasId "id839a8c5d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id839a8c5e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-5-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8c5e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/d/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-6-5-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c5f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c60-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c61-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c5f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-5-2-3> ;
  fro-usc:hasContentText "adversely affect the rights of a customer to customer property or customer name securities;" ;
  fro-usc:hasId "id839a8c5f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/d/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839a8c60-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-5-2-4> ;
  fro-usc:hasContentText "diminish the amount or timely payment of net equity claims of customers; or" ;
  fro-usc:hasId "id839a8c60-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/d/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8c61-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-5-2-5> ;
  fro-usc:hasContentText "otherwise impair the recoveries provided to a customer under the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.)." ;
  fro-usc:hasId "id839a8c61-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/d/1/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c62-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-5-3> ;
  fro-usc:hasContentText "The net proceeds from any transfer, sale, or disposition of assets of the covered broker or dealer, or proceeds thereof by the Corporation as receiver for the covered broker or dealer shall be for the benefit of the estate of the covered broker or dealer, as provided in this subchapter." ;
  fro-usc:hasHeading "Net proceeds" ;
  fro-usc:hasId "id839a8c62-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839a8c63-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c64-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c65-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-6> ;
  fro-usc:hasHeading "Claims against the Corporation as receiver" ;
  fro-usc:hasId "id839a8c63-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-6-6-2> ;
.
fro-usc-t12-ch53:id839a8c64-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-6-3> ;
  fro-usc:hasContentText "shall be determined in accordance with section 5390(a)(2) of this title ; and" ;
  fro-usc:hasId "id839a8c64-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/e/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/a/2" ;
.
fro-usc-t12-ch53:id839a8c65-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-6-4> ;
  fro-usc:hasContentText "may be reviewed by the appropriate district or territorial court of the United States in accordance with section 5390(a)(5) of this title ." ;
  fro-usc:hasId "id839a8c65-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/e/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/a/5" ;
.
fro-usc-t12-ch53:id839a8c66-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c67-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c68-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-7> ;
  fro-usc:hasHeading "Satisfaction of customer claims" ;
  fro-usc:hasId "id839a8c66-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id839a8c67-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-7-2> ;
  fro-usc:hasContentText "Notwithstanding any other provision of this subchapter, all obligations of a covered broker or dealer or of any bridge financial company established with respect to such covered broker or dealer to a customer relating to, or net equity claims based upon, customer property or customer name securities shall be promptly discharged by SIPC, the Corporation, or the bridge financial company, as applicable, by the delivery of securities or the making of payments to or for the account of such customer, in a manner and in an amount at least as beneficial to the customer as would have been the case had the actual proceeds realized from the liquidation of the covered broker or dealer under this subchapter been distributed in a proceeding under the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.) without the appointment of the Corporation as receiver and without any transfer of assets or liabilities to a bridge financial company, and with a filing date as of the date on which the Corporation is appointed as receiver." ;
  fro-usc:hasHeading "Obligations to customers" ;
  fro-usc:hasId "id839a8c67-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/f/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c68-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-7-3> ;
  fro-usc:hasContentText "SIPC, as trustee for a covered broker or dealer, shall satisfy customer claims in the manner and amount provided under the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.), as if the appointment of the Corporation as receiver had not occurred, and with a filing date as of the date on which the Corporation is appointed as receiver. The Corporation shall satisfy customer claims, to the extent that a customer would have received more securities or cash with respect to the allocation of customer property had the covered financial company been subject to a proceeding under the Securities Investor Protection Act ( 15 U.S.C. 78aaa et seq.) without the appointment of the Corporation as receiver, and with a filing date as of the date on which the Corporation is appointed as receiver." ;
  fro-usc:hasHeading "Satisfaction of claims by SIPC" ;
  fro-usc:hasId "id839a8c68-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/f/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c69-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c6a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c6b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-8> ;
  fro-usc:hasHeading "Priorities" ;
  fro-usc:hasId "id839a8c69-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id839a8c6a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-8-2> ;
  fro-usc:hasContentText "As trustee for a covered broker or dealer, SIPC shall allocate customer property and deliver customer name securities in accordance with section 8(c) of the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78fff–2(c) )." ;
  fro-usc:hasHeading "Customer property" ;
  fro-usc:hasId "id839a8c6a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/g/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78fff–2/c" ;
.
fro-usc-t12-ch53:id839a8c6b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-8-3> ;
  fro-usc:hasContentText "All claims other than those described in paragraph (1) (including any unpaid claim by a customer for the allowed net equity claim of such customer from customer property) shall be paid in accordance with the priorities in section 5390(b) of this title ." ;
  fro-usc:hasHeading "Other claims" ;
  fro-usc:hasId "id839a8c6b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/g/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/b" ;
.
fro-usc-t12-ch53:id839a8c6c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-9> ;
  fro-usc:hasContentText "The Commission and the Corporation, after consultation with SIPC, shall jointly issue rules to implement this section." ;
  fro-usc:hasHeading "Rulemaking" ;
  fro-usc:hasId "id839a8c6c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/h" ;
  fro-usc:hasNumberText "(h)" ;
.
fro-usc-t12-ch53:id839a8c6d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-usc:hasId "id839a8c6d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/stat/124/1456" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , § 205, July 21, 2010 , 124 Stat. 1456 .)" ;
.
fro-usc-t12-ch53:id839a8c6f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-11-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id839a8c6f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Securities Investor Protection Act of 1970, referred to in text, is Pub. L. 91–598 , Dec. 30, 1970 , 84 Stat. 1636 , which is classified generally to chapter 2B–1 (§ 78aaa et seq.) of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 78aaa of Title 15 and Tables." ;
  fro-usc:hasNoteText "This subchapter, referred to in text, was in the original “this title”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to this subchapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/91/598" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
  fro-usc:hasReferenceText "/us/stat/84/1636" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c70-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c71-1df7-11e6-87ee-8e4a3ab90f2a ;
