  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8> ;
  fro-usc:hasHeading "Limitations on authorities of the Bureau; preservation of authorities" ;
  fro-usc:hasId "id83ab2e2b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517" ;
  fro-usc:hasNumberText "§ 5517." ;
