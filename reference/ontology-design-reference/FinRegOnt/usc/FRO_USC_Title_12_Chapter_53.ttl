  fro-usc:hasContentText "steps that have been taken by the covered person to respond to the complaint or inquiry of the consumer;" ;
  fro-usc:hasId "id83ad77f1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5534/b/1" ;
