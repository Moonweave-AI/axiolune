  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-5-3-3> ;
  fro-usc:hasId "id83981bc0-1df7-11e6-87ee-8e4a3ab90f2a" ;
