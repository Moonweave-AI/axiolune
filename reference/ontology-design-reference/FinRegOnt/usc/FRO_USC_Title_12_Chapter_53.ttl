.
fro-usc-t12-ch53:id83a1912e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-5-2-3> ;
  fro-usc:hasContentText "evaluate the effectiveness of the agency or the Board of Governors in carrying out its supervisory responsibilities with respect to the covered financial company;" ;
  fro-usc:hasId "id83a1912e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/f/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a1912f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-5-2-4> ;
  fro-usc:hasContentText "identify any acts or omissions on the part of agency or Board of Governors officials that contributed to the covered financial company being in default or in danger of default;" ;
  fro-usc:hasId "id83a1912f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/f/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a19130-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-5-2-5> ;
  fro-usc:hasContentText "identify any actions that could have been taken by the agency or the Board of Governors that would have prevented the company from being in default or in danger of default; and" ;
  fro-usc:hasId "id83a19130-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/f/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a19131-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-5-2-6> ;
  fro-usc:hasContentText "recommend appropriate administrative or legislative action." ;
  fro-usc:hasId "id83a19131-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/f/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83a19132-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-5-3> ;
  fro-usc:hasContentText "Not later than 1 year after the date of appointment of the Corporation as receiver under this subchapter, the Inspector General of the Federal primary financial regulatory agency or the Board of Governors shall provide the report required by paragraph (1) to such agency or the Board of Governors, and along with such agency or the Board of Governors, as applicable, shall appear before the appropriate committees of Congress, if requested, to present the report required by paragraph (1). Not later than 90 days after the date of receipt of the report required by paragraph (1), such agency or the Board of Governors, as applicable, shall provide a written report to Congress describing any actions taken in response to the recommendations in the report, and if no such actions were taken, describing the reasons why no actions were taken." ;
  fro-usc:hasHeading "Reports and testimony" ;
  fro-usc:hasId "id83a19132-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/f/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a19133-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "id83a19133-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/stat/124/1514" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , § 211, July 21, 2010 , 124 Stat. 1514 .)" ;
.
fro-usc-t12-ch53:id83a19135-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a19135-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section 5390(n)(14) of this title , referred to in subsec. (d)(1)(C), probably means section 5390(n)(9), because section 5390(n) of this title does not contain a par. (14) and section 5390(n)(9) of this title relates to orderly liquidation plans." ;
  fro-usc:hasNoteText "The Inspector General Act of 1978, referred to in subsecs. (d)(3) and (e)(3), is Pub. L. 95–452 , Oct. 12, 1978 , 92 Stat. 1101 , which is set out in the Appendix to Title 5, Government Organization and Employees." ;
  fro-usc:hasNoteText "This subchapter, referred to in subsecs. (d)(1), (2), (4)(B), (5), (e)(1), (2), and (f)(2), was in the original “this title”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to this subchapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/95/452" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
  fro-usc:hasReferenceText "/us/stat/92/1101" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/n" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/n/14" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/n/9" ;
.
fro-usc-t12-ch53:id83a19136-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-7-1> ;
  fro-usc:hasHeading "Codification" ;
  fro-usc:hasId "id83a19136-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section is comprised of section 211 of Pub. L. 111–203 . Subsecs. (a) to (c) of section 211 of Pub. L. 111–203 amended section 4403 of this title and section 1032 of title 18 , Crimes and Criminal Procedure." ;
  fro-usc:hasNoteTopic "codification" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s211" ;
  fro-usc:hasReferenceText "/us/usc/t12/s4403" ;
  fro-usc:hasReferenceText "/us/usc/t18/s1032" ;
.
fro-usc-t12-ch53:id83a19137-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19138-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19139-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1913a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83a1913d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-13> ;
  fro-usc:hasHeading "Prohibition of circumvention and prevention of conflicts of interest" ;
  fro-usc:hasId "id83a19137-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5392" ;
  fro-usc:hasNumberText "§ 5392." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a1913b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a19138-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-13-2> ;
  fro-usc:hasContentText "Funds for the orderly liquidation of any covered financial company under this subchapter shall only be provided as specified under this subchapter." ;
  fro-usc:hasHeading "No other funding" ;
  fro-usc:hasId "id83a19138-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5392/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a19139-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-13-3> ;
  fro-usc:hasContentText "No governmental entity may take any action to circumvent the purposes of this subchapter." ;
  fro-usc:hasHeading "Limit on governmental actions" ;
  fro-usc:hasId "id83a19139-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5392/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a1913a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-13-4> ;
  fro-usc:hasContentText "In the event that the Corporation is appointed receiver for more than 1 covered financial company or is appointed receiver for a covered financial company and receiver for any insured depository institution that is an affiliate of such covered financial company, the Corporation shall take appropriate action, as necessary to avoid any conflicts of interest that may arise in connection with multiple receiverships." ;
  fro-usc:hasHeading "Conflict of interest" ;
  fro-usc:hasId "id83a1913a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5392/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a1913b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id83a1913b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/stat/124/1516" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , § 212, July 21, 2010 , 124 Stat. 1516 .)" ;
.
fro-usc-t12-ch53:id83a1913d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-13-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a1913d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This subchapter, referred to in subsecs. (a) and (b), was in the original “this title”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to this subchapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
.
