  fro-usc:hasContentText "key findings from the research and analysis of the financial system by the Office." ;
  fro-usc:hasId "id8395ab14-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/d/2/C" ;
