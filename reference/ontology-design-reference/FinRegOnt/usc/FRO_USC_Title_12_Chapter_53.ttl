  fro-usc:hasHeading "Change of Name" ;
  fro-usc:hasId "id83ad780d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Committee on Education and Labor of House of Representatives changed to Committee on Education and the Workforce of House of Representatives by House Resolution No. 5, One Hundred Twelfth Congress, Jan. 5, 2011 ." ;
  fro-usc:hasNoteTopic "changeOfName" ;
.
