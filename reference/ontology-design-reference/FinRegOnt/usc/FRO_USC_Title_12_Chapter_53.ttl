  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-8-2> ;
  fro-usc:hasContentText "The Comptroller General of the United States shall conduct a study regarding the implementation of prompt corrective action by the appropriate Federal banking agencies." ;
  fro-usc:hasHeading "Study" ;
  fro-usc:hasId "id839a8be1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/g/1" ;
