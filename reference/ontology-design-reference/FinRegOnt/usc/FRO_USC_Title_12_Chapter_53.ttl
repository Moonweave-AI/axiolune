  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-6-3-2-4> ;
  fro-usc:hasContentText "to carry out the transfer under this part during such 90-day period." ;
  fro-usc:hasId "id83a4022f-1df7-11e6-87ee-8e4a3ab90f2a" ;
