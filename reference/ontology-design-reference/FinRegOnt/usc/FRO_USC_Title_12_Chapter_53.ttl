  fro-usc:hasContentText "obtaining information about the activities and compliance systems or procedures of such person; and" ;
  fro-usc:hasId "id83ab2db7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/1/B" ;
