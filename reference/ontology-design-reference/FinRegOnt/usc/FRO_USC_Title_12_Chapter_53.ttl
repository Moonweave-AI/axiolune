.
fro-usc-t12-ch53:id83b4a434-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-8-5-3-2> ;
  fro-usc:hasContentText "to sell financial assets without an unusual and significant discount; or" ;
  fro-usc:hasId "id83b4a434-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/g/3/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83b4a435-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-8-5-3-3> ;
  fro-usc:hasContentText "to borrow using financial assets as collateral without an unusual and significant increase in margin; or" ;
  fro-usc:hasId "id83b4a435-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/g/3/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83b4a436-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-8-5-4> ;
  fro-usc:hasContentText "an unusual and significant reduction in the ability of financial market participants to obtain unsecured credit." ;
  fro-usc:hasId "id83b4a436-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/g/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b4a437-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-8-6> ;
  fro-usc:hasContentText "The term “solvent” means that the value of the assets of an entity exceed its obligations to creditors." ;
  fro-usc:hasHeading "Solvent" ;
  fro-usc:hasId "id83b4a437-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5612/g/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83b4a438-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-usc:hasId "id83b4a438-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tXI" ;
  fro-usc:hasReferenceText "/us/stat/124/2121" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title XI , § 1105, July 21, 2010 , 124 Stat. 2121 .)" ;
.
fro-usc-t12-ch53:id83b4a43a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-3-10-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83b4a43a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section 1105 of the Dodd-Frank Wall Street Reform and Consumer Protection Act, referred to in subsec. (d)(4)(C), (D), is section 1105 of Pub. L. 111–203 , which is classified to this section." ;
  fro-usc:hasNoteText "Section 208(n)(5)(E), referred to in subsec. (e)(5), probably means section 210(n)(5)(E) of Pub. L. 111–203 , which is classified to section 5390(n)(5)(E) of this title , because section 208 does not contain a subsec. (n) and section 210(n)(5)(E) relates to treatment of certain purchases and sales of obligations by the Secretary as public debt." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1105" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s210/n/5/E" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/n/5/E" ;
.
fro-usc-t12-ch53:id83b4a43b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a43c-1df7-11e6-87ee-8e4a3ab90f2a ;
