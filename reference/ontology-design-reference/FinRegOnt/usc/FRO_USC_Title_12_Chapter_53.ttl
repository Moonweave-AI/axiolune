  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-6-3-3> ;
  fro-usc:hasContentText "on the appropriate use of designations in the sale of insurance products that, to the extent practicable, conform to the minimum requirements of the National Association of Insurance Commissioners Model Regulation on the Use of Senior-Specific Certifications and Professional Designations in the Sale of Life Insurance and Annuities (or any successor thereto); and" ;
  fro-usc:hasId "id83ad7849-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/e/1/B" ;
