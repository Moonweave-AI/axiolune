  fro-usc:hasReferenceText "/us/stat/124/2130" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title XII , § 1204, July 21, 2010 , 124 Stat. 2130 .)" ;
.
fro-usc-t12-ch53:id83b4a46d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-4-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83b4a46d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This subchapter, referred to in subsec. (b)(1), was in the original “this title”, meaning title XII of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 2129 , known as the Improving Access to Mainstream Financial Institutions Act of 2010, which is classified principally to this subchapter. For complete classification of title XII to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/2129" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a46e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a46f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a470-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-5> ;
  fro-usc:hasHeading "Low-cost alternatives to small dollar loans" ;
  fro-usc:hasId "id83b4a46e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5624" ;
  fro-usc:hasNumberText "§ 5624." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a475-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a46f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-5-2> ;
  fro-usc:hasContentText "The Secretary is authorized to establish multiyear demonstration programs by means of grants, cooperative agreements, financial agency agreements, and similar contracts or undertakings, with eligible entities to provide low-cost, small loans to consumers that will provide alternatives to more costly small dollar loans." ;
  fro-usc:hasHeading "Grants authorized" ;
  fro-usc:hasId "id83b4a46f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5624/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83b4a470-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a471-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a472-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-5-3> ;
  fro-usc:hasHeading "Terms and conditions" ;
  fro-usc:hasId "id83b4a470-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5624/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83b4a471-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-5-3-2> ;
  fro-usc:hasContentText "Loans under this section shall be made on terms and conditions, and pursuant to lending practices, that are reasonable for consumers." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b4a471-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5624/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b4a472-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-5-3-3> ;
  fro-usc:hasHeading "Financial literacy and education opportunities" ;
  fro-usc:hasId "id83b4a472-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5624/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a473-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a474-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a473-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-5-3-3-2> ;
  fro-usc:hasContentText "Each eligible entity awarded a grant under this section shall promote and take appropriate steps to ensure the provision of financial literacy and education opportunities, such as relevant counseling services, educational courses, or wealth building programs, to each consumer provided with a loan pursuant to this section." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b4a473-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5624/b/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83b4a474-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-5-3-3-3> ;
  fro-usc:hasContentText "As part of the grants, agreements, and undertakings established under this section, the Secretary may implement reasonable measures or programs designed to expand access to financial literacy and education opportunities, including relevant counseling services, educational courses, or wealth building programs to be provided to individuals who obtain loans from eligible entities under this section." ;
  fro-usc:hasHeading "Authority to expand access" ;
  fro-usc:hasId "id83b4a474-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5624/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b4a475-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "id83b4a475-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tXII" ;
  fro-usc:hasReferenceText "/us/stat/124/2130" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title XII , § 1205, July 21, 2010 , 124 Stat. 2130 .)" ;
.
fro-usc-t12-ch53:id83b4a476-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b4a479-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-6> ;
  fro-usc:hasContentText "An eligible entity desiring to participate in a program or obtain a grant under this subchapter shall submit an application to the Secretary, in such form and containing such information as the Secretary may require." ;
  fro-usc:hasHeading "Procedural provisions" ;
  fro-usc:hasId "id83b4a476-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5625" ;
  fro-usc:hasNumberText "§ 5625." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a477-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a477-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id83b4a477-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tXII" ;
  fro-usc:hasReferenceText "/us/stat/124/2132" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title XII , § 1207, July 21, 2010 , 124 Stat. 2132 .)" ;
.
fro-usc-t12-ch53:id83b4a479-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-6-4-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83b4a479-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This subchapter, referred to in text, was in the original “this title”, meaning title XII of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 2129 , known as the Improving Access to Mainstream Financial Institutions Act of 2010, which is classified principally to this subchapter. For complete classification of title XII to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/2129" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a47a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a47b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a47c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b4a47f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-7> ;
  fro-usc:hasHeading "Authorization of appropriations" ;
  fro-usc:hasId "id83b4a47a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5626" ;
  fro-usc:hasNumberText "§ 5626." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a47d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a47b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-7-2> ;
  fro-usc:hasContentText "There are authorized to be appropriated to the Secretary, such sums as are necessary to both administer and fund the programs and projects authorized by this subchapter, to remain available until expended." ;
  fro-usc:hasHeading "Authorization to the Secretary" ;
  fro-usc:hasId "id83b4a47b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5626/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83b4a47c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-7-3> ;
  fro-usc:hasContentText "There is authorized to be appropriated to the Fund for each fiscal year beginning in fiscal year 2010, an amount equal to the amount of the administrative costs of the Fund for the operation of the grant program established under this subchapter." ;
  fro-usc:hasHeading "Authorization to the Fund" ;
  fro-usc:hasId "id83b4a47c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5626/b" ;
  fro-usc:hasNumberText "(b)" ;
.
