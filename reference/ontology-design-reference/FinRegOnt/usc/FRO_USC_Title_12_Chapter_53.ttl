  fro-usc:hasReferenceText "/us/usc/t12/s5491" ;
.
fro-usc-t12-ch53:id83b25aa7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-7-3> ;
  fro-usc:hasContentText "The Department of the Treasury may provide administrative services necessary to support the Bureau before the designated transfer date." ;
  fro-usc:hasHeading "Interim administrative services by the Department of the Treasury" ;
