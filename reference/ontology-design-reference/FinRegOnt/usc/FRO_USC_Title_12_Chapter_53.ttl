  lkif-mereo:component fro-usc-t12-ch53:id839360af-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839360aa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-16-2> ;
  fro-usc:hasContentText "the activities of the Council;" ;
  fro-usc:hasId "id839360aa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/N/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839360ab-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-16-3> ;
  fro-usc:hasContentText "significant financial market and regulatory developments, including insurance and accounting regulations and standards, along with an assessment of those developments on the stability of the financial system;" ;
  fro-usc:hasId "id839360ab-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/N/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839360ac-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-16-4> ;
  fro-usc:hasContentText "potential emerging threats to the financial stability of the United States;" ;
  fro-usc:hasId "id839360ac-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/N/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839360ad-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-16-5> ;
  fro-usc:hasContentText "all determinations made under section 5323 of this title or subchapter IV, and the basis for such determinations;" ;
  fro-usc:hasId "id839360ad-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/N/iv" ;
  fro-usc:hasNumberText "(iv)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5323" ;
.
fro-usc-t12-ch53:id839360ae-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
