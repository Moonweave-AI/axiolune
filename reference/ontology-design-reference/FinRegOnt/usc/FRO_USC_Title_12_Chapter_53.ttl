  fro-usc:hasHeading "Treatment of certain companies that cease to be bank holding companies" ;
  fro-usc:hasId "id83936154-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327" ;
