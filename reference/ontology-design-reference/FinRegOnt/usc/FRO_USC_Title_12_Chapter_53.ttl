  fro-usc:hasHeading "Subpoena" ;
  fro-usc:hasId "id8395aae6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/f" ;
  fro-usc:hasNumberText "(f)" ;
.
