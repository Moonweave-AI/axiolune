  fro-usc:hasContentText "the enhanced dental benefits program established under chapter 89A of title 5;" ;
  fro-usc:hasId "id83a191fc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/i/2/B/i" ;
