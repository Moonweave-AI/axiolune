  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-4-3-3-3> ;
  fro-usc:hasContentText "assist in the investigation and prosecution of those using misleading or fraudulent marketing; and" ;
  fro-usc:hasId "id83ad7841-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/c/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
