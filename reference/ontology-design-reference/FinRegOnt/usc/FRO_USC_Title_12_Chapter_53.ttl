  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ad786f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ad7870-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ad7871-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ad7872-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ad7873-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9> ;
  fro-usc:hasHeading "Mortgage loans; rulemaking procedures; enforcement" ;
  fro-usc:hasId "id83ad7857-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538" ;
  fro-usc:hasNumberText "§ 5538." ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad786d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad7858-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7859-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad785a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad785b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-2> ;
  fro-usc:hasId "id83ad7858-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83ad7859-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-2-1> ;
  fro-usc:hasContentText "The Bureau of Consumer Financial Protection shall have authority to prescribe rules with respect to mortgage loans in accordance with section 553 of title 5 . Such rulemaking shall relate to unfair or deceptive acts or practices regarding mortgage loans, which may include unfair or deceptive acts or practices involving loan modification and foreclosure rescue services. Any violation of a rule prescribed under this paragraph shall be treated as a violation of a rule prohibiting unfair, deceptive, or abusive acts or practices under the Consumer Financial Protection Act of 2010 and a violation of a rule under section 18 of the Federal Trade Commission Act ( 15 U.S.C. 57a ) regarding unfair or deceptive acts or practices." ;
  fro-usc:hasId "id83ad7859-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s57a" ;
  fro-usc:hasReferenceText "/us/usc/t5/s553" ;
.
fro-usc-t12-ch53:id83ad785a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-2-2> ;
  fro-usc:hasContentText "The Bureau of Consumer Financial Protection shall enforce the rules issued under paragraph (1) in the same manner, by the same means, and with the same jurisdiction, powers, and duties, as though all applicable terms and provisions of the Consumer Financial Protection Act of 2010 were incorporated into and made part of this subsection." ;
  fro-usc:hasId "id83ad785a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ad785b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-2-3> ;
  fro-usc:hasContentText "Subject to subtitle B of the Consumer Financial Protection Act of 2010 [ 12 U.S.C. 5511 et seq.], the Federal Trade Commission shall enforce the rules issued under paragraph (1), in the same manner, by the same means, and with the same jurisdiction, as though all applicable terms and provisions of the Federal Trade Commission Act [ 15 U.S.C. 41 et seq.] were incorporated into and made part of this section." ;
  fro-usc:hasId "id83ad785b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/a/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5511" ;
  fro-usc:hasReferenceText "/us/usc/t15/s41" ;
.
fro-usc-t12-ch53:id83ad785c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad785d-1df7-11e6-87ee-8e4a3ab90f2a ;
