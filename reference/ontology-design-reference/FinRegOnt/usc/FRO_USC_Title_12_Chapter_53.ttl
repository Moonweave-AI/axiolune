  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83b25ad4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-3-2-4-3> ;
  fro-usc:hasContentText "the total volume of payments made by United States Government agencies to beneficiaries and retirees living abroad;" ;
  fro-usc:hasId "id83b25ad4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/b/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83b25ad5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-3-2-5> ;
  fro-usc:hasContentText "the feasibility of such an expansion; and" ;
  fro-usc:hasId "id83b25ad5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/b/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83b25ad6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-3-2-6> ;
  fro-usc:hasContentText "the ability of the Federal Reserve System to establish payment gateways in different geographic regions and currency zones to receive remittance transfers and route them through the payments systems in the destination countries." ;
  fro-usc:hasId "id83b25ad6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/b/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83b25ad7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-3-3> ;
  fro-usc:hasContentText "Not later than one calendar year after July 21, 2010 , and on April 30 biennially thereafter during the 10-year period beginning on July 21, 2010 , the Board of Governors shall submit a report to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives on the status of the automated clearinghouse system and its progress in complying with the requirements of this subsection. The report shall include an analysis of adoption rates of International ACH Transactions rules and formats, the efficacy of increasing adoption rates, and potential recommendations to increase adoption." ;
  fro-usc:hasHeading "Report to Congress" ;
  fro-usc:hasId "id83b25ad7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25ad8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25ad9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25ada-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-4> ;
  fro-usc:hasHeading "Expansion of financial institution provision of remittance transfers" ;
  fro-usc:hasId "id83b25ad8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83b25ad9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-4-2> ;
  fro-usc:hasContentText "Each of the Federal banking agencies and the National Credit Union Administration shall provide guidelines to financial institutions under the jurisdiction of the agency regarding the offering of low-cost remittance transfers and no-cost or low-cost basic consumer accounts, as well as agency services to remittance transfer providers." ;
  fro-usc:hasHeading "Provision of guidelines to institutions" ;
  fro-usc:hasId "id83b25ad9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25ada-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-4-3> ;
  fro-usc:hasContentText "As part of its  2 duties as members of the Financial Literacy and Education Commission, the Bureau, the Federal banking agencies, and the National Credit Union Administration shall assist the Financial Literacy and Education Commission in executing the Strategy for Assuring Financial Empowerment (or the “SAFE Strategy”), as it relates to remittances." ;
  fro-usc:hasHeading "Assistance to Financial Literacy Commission " ;
  fro-usc:hasId "id83b25ada-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25adb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-5> ;
  fro-usc:hasHeading "Omitted" ;
  fro-usc:hasId "id83b25adb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83b25adc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25add-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25ade-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25adf-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-6> ;
  fro-usc:hasHeading "Report on feasibility of and impediments to use of remittance history in calculation of credit score" ;
  fro-usc:hasId "id83b25adc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-9-2-6-2> ;
.
fro-usc-t12-ch53:id83b25add-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-6-3> ;
  fro-usc:hasContentText "the manner in which the remittance history of a consumer could be used to enhance the credit score of the consumer;" ;
  fro-usc:hasId "id83b25add-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25ade-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-6-4> ;
  fro-usc:hasContentText "the current legal and business model barriers and impediments that impede the use of the remittance history of the consumer to enhance the credit score of the consumer; and" ;
  fro-usc:hasId "id83b25ade-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25adf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-6-5> ;
  fro-usc:hasContentText "recommendations on the manner in which maximum transparency and disclosure to consumers of exchange rates for remittance transfers subject to this title  3 and 1693 o –1(a)(3) of title 15 (as amended by this section). and the amendments made by this title  3 may be accomplished, whether or not such exchange rates are known at the time of origination or payment by the consumer for the remittance transfer, including disclosure to the sender of the actual exchange rate used and the amount of currency that the recipient of the remittance transfer received, using the values of the currency into which the funds were exchanged, as contained in sections 1693 o –1(a)(2)(D)  3" ;
  fro-usc:hasId "id83b25adf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5601/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83b25ae0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-usc:hasId "id83b25ae0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/stat/124/2060" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1073, July 21, 2010 , 124 Stat. 2060 .)" ;
.
fro-usc-t12-ch53:id83b25ae2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-8-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83b25ae2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section 1693 o –1(a)(2) of title 15, referred to in subsec. (e)(3), does not contain a subpar. (D)." ;
  fro-usc:hasNoteText "This title, where footnoted in subsec. (e)(3), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25ae3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-8-1> ;
  fro-usc:hasHeading "Codification" ;
  fro-usc:hasId "id83b25ae3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section is comprised of section 1073 of Pub. L. 111–203 . . Subsecs. (a) and (d) of section 1073 of Pub. L. 111–203 enacted section 1693 o –1 of Title 15, Commerce and Trade, amended section 1757 of this title and sections 1693, 1693b, 1693p, 1693q, and 1693r of Title 15, and amended provisions set out as a note under section 1693 of Title 15" ;
  fro-usc:hasNoteTopic "codification" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1073" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1757" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1693" ;
.
fro-usc-t12-ch53:id83b25ae4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-2-8-2> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83b25ae4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Part effective 1 day after July 21, 2010 , except as otherwise provided, see section 4 of Pub. L. 111–203 , set out as a note under section 5301 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s4" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25ae5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25ae6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25ae7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25aec-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b25aef-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-3> ;
  fro-usc:hasHeading "Reverse mortgage study and regulations" ;
  fro-usc:hasId "id83b25ae5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5602" ;
  fro-usc:hasNumberText "§ 5602." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25aed-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25ae6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-3-2> ;
  fro-usc:hasContentText "Not later than 1 year after the designated transfer date, the Bureau shall conduct a study on reverse mortgage transactions." ;
  fro-usc:hasHeading "Study" ;
  fro-usc:hasId "id83b25ae6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5602/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83b25ae7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25ae8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25ae9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-3-3> ;
  fro-usc:hasHeading "Regulations" ;
  fro-usc:hasId "id83b25ae7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5602/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83b25ae8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-3-3-2> ;
  fro-usc:hasContentText "If the Bureau determines through the study required under subsection (a) that conditions or limitations on reverse mortgage transactions are necessary or appropriate for accomplishing the purposes and objectives of this title, 1 including protecting borrowers with respect to the obtaining of reverse mortgage loans for the purpose of funding investments, annuities, and other investment products and the suitability of a borrower in obtaining a reverse mortgage for such purpose. 2" ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b25ae8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5602/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25ae9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-3-3-3> ;
  fro-usc:hasHeading "Identified practices and integrated disclosures" ;
  fro-usc:hasId "id83b25ae9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5602/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-9-3-3-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25aea-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25aeb-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25aea-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-3-3-3-3> ;
  fro-usc:hasContentText "identify any practice as unfair, deceptive, or abusive in connection with a reverse mortgage transaction; and" ;
  fro-usc:hasId "id83b25aea-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5602/b/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83b25aeb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-3-3-3-4> ;
  fro-usc:hasContentText "provide for an integrated disclosure standard and model disclosures for reverse mortgage transactions, consistent with section 4302(d), that combines the relevant disclosures required under the Truth in Lending Act ( 15 U.S.C. 1601 et seq.) and the Real Estate Settlement Procedures Act [ 12 U.S.C. 2601 et seq.], with the disclosures required to be provided to consumers for Home Equity Conversion Mortgages under section 1715z–20 of this title ." ;
  fro-usc:hasId "id83b25aeb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5602/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1715z–20" ;
  fro-usc:hasReferenceText "/us/usc/t12/s2601" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1601" ;
.
fro-usc-t12-ch53:id83b25aec-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-3-4> ;
  fro-usc:hasContentText "This section shall not be construed as limiting the authority of the Bureau to issue regulations, orders, or guidance that apply to reverse mortgages prior to the completion of the study required under subsection (a)." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83b25aec-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5602/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83b25aed-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id83b25aed-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/stat/124/2075" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1076, July 21, 2010 , 124 Stat. 2075 .)" ;
.
