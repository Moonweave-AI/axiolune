  fro-usc:hasId "id83b25b13-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Subchapter effective 1 day after July 21, 2010 , except as otherwise provided, see section 4 of Pub. L. 111–203 , set out as a note under section 5301 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
