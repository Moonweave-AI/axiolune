.
fro-usc-t12-ch53:id8395aafd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-3-3-2-3> ;
  fro-usc:hasContentText "a financial company reference database;" ;
  fro-usc:hasId "id8395aafd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/b/2/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id8395aafe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-3-3-2-4> ;
  fro-usc:hasContentText "a financial instrument reference database; and" ;
  fro-usc:hasId "id8395aafe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/b/2/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id8395aaff-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-3-3-2-5> ;
  fro-usc:hasContentText "formats and standards for Office data, including standards for reporting financial transaction and position data to the Office." ;
  fro-usc:hasId "id8395aaff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/b/2/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id8395ab00-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-3-3-3> ;
  fro-usc:hasContentText "The Data Center shall not publish any confidential data under subparagraph (A)." ;
  fro-usc:hasHeading "Confidentiality" ;
  fro-usc:hasId "id8395ab00-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8395ab01-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-3-4> ;
  fro-usc:hasContentText "The Director shall ensure that data collected and maintained by the Data Center are kept secure and protected against unauthorized disclosure." ;
  fro-usc:hasHeading "Information security" ;
  fro-usc:hasId "id8395ab01-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id8395ab02-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-3-5> ;
  fro-usc:hasContentText "The Data Center shall maintain a catalog of the financial entities and instruments reported to the Office." ;
  fro-usc:hasHeading "Catalog of financial entities and instruments" ;
  fro-usc:hasId "id8395ab02-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id8395ab03-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-3-6> ;
  fro-usc:hasContentText "The Data Center shall make data collected and maintained by the Data Center available to the Council and member agencies, as necessary to support their regulatory responsibilities." ;
  fro-usc:hasHeading "Availability to the Council and member agencies" ;
  fro-usc:hasId "id8395ab03-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id8395ab04-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-3-7> ;
  fro-usc:hasContentText "The Office shall, after consultation with the member agencies, provide certain data to financial industry participants and to the general public to increase market transparency and facilitate research on the financial system, to the extent that intellectual property rights are not violated, business confidential information is properly protected, and the sharing of such information poses no significant threats to the financial system of the United States." ;
  fro-usc:hasHeading "Other authority" ;
  fro-usc:hasId "id8395ab04-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/b/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id8395ab05-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395ab06-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-4> ;
  fro-usc:hasHeading "Research and Analysis Center" ;
  fro-usc:hasId "id8395ab05-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id8395ab06-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-4-2> ;
  fro-usc:hasHeading "General duties" ;
  fro-usc:hasHeading " " ;
  fro-usc:hasId "id8395ab06-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/c/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-4-5-4-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id8395ab07-1df7-11e6-87ee-8e4a3ab90f2a ;
