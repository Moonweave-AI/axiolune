  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-2-3-4-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e38-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/a/2/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ab2e39-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-2-3-4-3> ;
  fro-usc:hasHeading "Exception" ;
  fro-usc:hasId "id83ab2e39-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/a/2/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-8-2-3-4-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e3a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e3b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e3a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-2-3-4-3-3> ;
  fro-usc:hasContentText "if such merchant, retailer, or seller of nonfinancial goods or services is engaged in a transaction described in subparagraph (B)(i) or (B)(ii); or" ;
  fro-usc:hasId "id83ab2e3a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/a/2/C/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83ab2e3b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-2-3-4-3-4> ;
  fro-usc:hasContentText "to the extent that such merchant, retailer, or seller is subject to any enumerated consumer law or any law for which authorities are transferred under subtitle F or H, but the Bureau may exercise such authority only with respect to that law." ;
  fro-usc:hasId "id83ab2e3b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/a/2/C/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83ab2e3c-1df7-11e6-87ee-8e4a3ab90f2a
