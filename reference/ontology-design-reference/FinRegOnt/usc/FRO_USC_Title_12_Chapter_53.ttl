  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-5-3> ;
  fro-usc:hasHeading "Content" ;
  fro-usc:hasId "id8395ab11-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/d/2" ;
  fro-usc:hasNumberText "(2)" ;
