  fro-usc:hasIdentifierText "/us/usc/t12/s5493/e/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-3-4-6-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bcb7-1df7-11e6-87ee-8e4a3ab90f2a ;
