.
fro-usc-t12-ch53:id839a8c12-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-4-2-3> ;
  fro-usc:hasContentText "setting forth information on the financial condition of the covered financial company as of the date of the appointment, including a description of its assets and liabilities;" ;
  fro-usc:hasId "id839a8c12-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/3/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839a8c13-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-4-2-4> ;
  fro-usc:hasContentText "describing the plan of, and actions taken by, the Corporation to wind down the covered financial company;" ;
  fro-usc:hasId "id839a8c13-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/3/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839a8c14-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-4-2-5> ;
  fro-usc:hasContentText "explaining each instance in which the Corporation waived any applicable requirements of part 366 of title 12, Code of Federal Regulations (or any successor thereto) with respect to conflicts of interest by any person in the private sector who was retained to provide services to the Corporation in connection with such receivership;" ;
  fro-usc:hasId "id839a8c14-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/3/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839a8c15-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-4-2-6> ;
  fro-usc:hasContentText "describing the reasons for the provision of any funding to the receivership out of the Fund;" ;
  fro-usc:hasId "id839a8c15-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/3/A/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id839a8c16-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-4-2-7> ;
  fro-usc:hasContentText "setting forth the expected costs of the orderly liquidation of the covered financial company;" ;
  fro-usc:hasId "id839a8c16-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/3/A/v" ;
  fro-usc:hasNumberText "(v)" ;
.
fro-usc-t12-ch53:id839a8c17-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-4-2-8> ;
  fro-usc:hasContentText "setting forth the identity of any claimant that is treated in a manner different from other similarly situated claimants under subsection (b)(4), (d)(4), or (h)(5)(E), the amount of any additional payment to such claimant under subsection (d)(4), and the reason for any such action; and" ;
  fro-usc:hasId "id839a8c17-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/3/A/vi" ;
  fro-usc:hasNumberText "(vi)" ;
.
fro-usc-t12-ch53:id839a8c18-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-4-2-9> ;
  fro-usc:hasContentText "which report the Corporation shall publish on an online website maintained by the Corporation, subject to maintaining appropriate confidentiality." ;
  fro-usc:hasId "id839a8c18-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/3/A/vii" ;
  fro-usc:hasNumberText "(vii)" ;
.
fro-usc-t12-ch53:id839a8c19-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-4-3> ;
  fro-usc:hasContentText "The Corporation shall, on a timely basis, not less frequently than quarterly, amend or revise and resubmit the reports prepared under this paragraph, as necessary." ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "id839a8c19-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8c1a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-4-4> ;
  fro-usc:hasContentText "The Corporation and the primary financial regulatory agency, if any, of the financial company for which the Corporation was appointed receiver under this subchapter shall appear before Congress, if requested, not later than 30 days after the date on which the Corporation first files the reports required under subparagraph (A)." ;
  fro-usc:hasHeading "Congressional testimony" ;
  fro-usc:hasId "id839a8c1a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839a8c1b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-5> ;
  fro-usc:hasHeading "Default or in danger of default" ;
  fro-usc:hasId "id839a8c1b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-4-4-5-2> ;
