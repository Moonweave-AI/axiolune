  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83afe90c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83afe90d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3> ;
  fro-usc:hasHeading "Investigations and administrative discovery" ;
  fro-usc:hasId "id83ad78b7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562" ;
  fro-usc:hasNumberText "§ 5562." ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe90a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad78b8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78b9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78ba-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-2> ;
  fro-usc:hasHeading "Joint investigations" ;
  fro-usc:hasId "id83ad78b8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83ad78b9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-2-2> ;
  fro-usc:hasContentText "The Bureau or, where appropriate, a Bureau investigator, may engage in joint investigations and requests for information, as authorized under this title. 1" ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ad78b9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ad78ba-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-2-3> ;
  fro-usc:hasContentText "The authority under paragraph (1) includes matters relating to fair lending, and where appropriate, joint investigations with, and requests for information from, the Secretary of Housing and Urban Development, the Attorney General of the United States, or both." ;
  fro-usc:hasHeading "Fair lending" ;
  fro-usc:hasId "id83ad78ba-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ad78bb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78bc-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78bd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78be-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-3> ;
  fro-usc:hasHeading "Subpoenas" ;
  fro-usc:hasId "id83ad78bb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83ad78bc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-3-2> ;
  fro-usc:hasContentText "The Bureau or a Bureau investigator may issue subpoenas for the attendance and testimony of witnesses and the production of relevant papers, books, documents, or other material in connection with hearings under this title." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ad78bc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ad78bd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-3-3> ;
  fro-usc:hasContentText "In the case of contumacy or refusal to obey a subpoena issued pursuant to this paragraph and served upon any person, the district court of the United States for any district in which such person is found, resides, or transacts business, upon application by the Bureau or a Bureau investigator and after notice to such person, may issue an order requiring such person to appear and give testimony or to appear and produce documents or other material." ;
  fro-usc:hasHeading "Failure to obey" ;
  fro-usc:hasId "id83ad78bd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ad78be-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-3-4> ;
  fro-usc:hasContentText "Any failure to obey an order of the court under this subsection may be punished by the court as a contempt thereof." ;
  fro-usc:hasHeading "Contempt" ;
  fro-usc:hasId "id83ad78be-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
