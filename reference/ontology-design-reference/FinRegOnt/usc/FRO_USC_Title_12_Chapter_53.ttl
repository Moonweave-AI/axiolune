fro-usc-t12-ch53:id83a8bc90-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-4-3-3> ;
  fro-usc:hasContentText "providing oversight and enforcement of Federal laws intended to ensure the fair, equitable, and nondiscriminatory access to credit for both individuals and communities that are enforced by the Bureau, including the Equal Credit Opportunity Act [ 15 U.S.C. 1691 et seq.] and the Home Mortgage Disclosure Act [ 12 U.S.C. 2801 et seq.];" ;
  fro-usc:hasId "id83a8bc90-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s2801" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1691" ;
.
fro-usc-t12-ch53:id83a8bc91-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-4-3-4> ;
  fro-usc:hasContentText "coordinating fair lending efforts of the Bureau with other Federal agencies and State regulators, as appropriate, to promote consistent, efficient, and effective enforcement of Federal fair lending laws;" ;
  fro-usc:hasId "id83a8bc91-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a8bc92-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-4-3-5> ;
  fro-usc:hasContentText "working with private industry, fair lending, civil rights, consumer and community advocates on the promotion of fair lending compliance and education; and" ;
  fro-usc:hasId "id83a8bc92-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/c/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a8bc93-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
