fro-usc-t12-ch53:id83ab2e3f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-2-3-5-3-3> ;
  fro-usc:hasContentText "only extends credit for the sale of nonfinancial goods or services, as described in subparagraph (A)(i);" ;
  fro-usc:hasId "id83ab2e3f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/a/2/D/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83ab2e40-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-2-3-5-3-4> ;
  fro-usc:hasContentText "retains such credit on its own accounts (except to sell or convey such debt that is delinquent or otherwise in default); and" ;
  fro-usc:hasId "id83ab2e40-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/a/2/D/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83ab2e41-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-2-3-5-3-5> ;
  fro-usc:hasContentText "meets the relevant industry size threshold to be a small business concern, based on annual receipts, pursuant to section 3 of the Small Business Act ( 15 U.S.C. 632 ) and the implementing rules thereunder." ;
  fro-usc:hasId "id83ab2e41-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/a/2/D/ii/III" ;
  fro-usc:hasNumberText "(III)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s632" ;
.
fro-usc-t12-ch53:id83ab2e42-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-2-3-5-4> ;
  fro-usc:hasHeading "Initial year" ;
  fro-usc:hasId "id83ab2e42-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/a/2/D/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83ab2e43-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-2-3-5-5> ;
  fro-usc:hasHeading "Other standards for small business" ;
  fro-usc:hasId "id83ab2e43-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/a/2/D/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id83ab2e44-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-2-3-6> ;
  fro-usc:hasContentText "To the extent that the Bureau may not exercise authority under this subsection with respect to a merchant, retailer, or seller of nonfinancial goods or services, no action by a State attorney general or State regulator with respect to a claim made under this title  may be brought under sub section 5552(a) of this title , with respect to an activity described in any of clauses (i) through (iii) of subparagraph (A) by such merchant, retailer, or seller of nonfinancial goods or services." ;
  fro-usc:hasHeading "Exception from State enforcement" ;
  fro-usc:hasId "id83ab2e44-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/a/2/E" ;
  fro-usc:hasNumberText "(E)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5552/a" ;
.
fro-usc-t12-ch53:id83ab2e45-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e46-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e4b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-3> ;
  fro-usc:hasHeading "Exclusion for real estate brokerage activities" ;
  fro-usc:hasId "id83ab2e45-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83ab2e46-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-3-2> ;
  fro-usc:hasHeading "Real estate brokerage activities excluded" ;
  fro-usc:hasId "id83ab2e46-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/b/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-8-3-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e47-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e48-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e49-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e4a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e47-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-3-2-3> ;
  fro-usc:hasContentText "acts as a real estate agent or broker for a buyer, seller, lessor, or lessee of real property;" ;
  fro-usc:hasId "id83ab2e47-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/b/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2e48-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-3-2-4> ;
  fro-usc:hasContentText "brings together parties interested in the sale, purchase, lease, rental, or exchange of real property;" ;
  fro-usc:hasId "id83ab2e48-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/b/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2e49-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-3-2-5> ;
  fro-usc:hasContentText "negotiates, on behalf of any party, any portion of a contract relating to the sale, purchase, lease, rental, or exchange of real property (other than in connection with the provision of financing with respect to any such transaction); or" ;
  fro-usc:hasId "id83ab2e49-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/b/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ab2e4a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-3-2-6> ;
  fro-usc:hasContentText "offers to engage in any activity, or act in any capacity, described in subparagraph (A), (B), or (C)." ;
  fro-usc:hasId "id83ab2e4a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/b/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83ab2e4b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-3-3> ;
  fro-usc:hasHeading "Description of activities" ;
  fro-usc:hasId "id83ab2e4b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-8-3-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e4c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e4d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e4c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-3-3-3> ;
  fro-usc:hasContentText "engaged in an activity of offering or providing any consumer financial product or service, except that the Bureau may exercise such authority only with respect to that activity; or" ;
  fro-usc:hasId "id83ab2e4c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/b/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2e4d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-3-3-4> ;
  fro-usc:hasContentText "otherwise subject to any enumerated consumer law or any law for which authorities are transferred under subtitle F or H, but the Bureau may exercise such authority only with respect to that law." ;
  fro-usc:hasId "id83ab2e4d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2e4e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e4f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e55-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e56-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-4> ;
  fro-usc:hasHeading "Exclusion for manufactured home retailers and modular home retailers" ;
  fro-usc:hasId "id83ab2e4e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/c" ;
  fro-usc:hasNumberText "(c)" ;
.
