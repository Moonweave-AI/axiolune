fro-usc-t12-ch53:id83a191bb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-2-3> ;
  fro-usc:hasContentText "consult and cooperate with the Office of Thrift Supervision to facilitate the orderly transfer of functions to the Office of the Comptroller of the Currency, the Corporation, and the Board of Governors in accordance with this title;  1" ;
  fro-usc:hasId "id83a191bb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a191bc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-2-4> ;
  fro-usc:hasId "id83a191bc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-5-2-2-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191bd-1df7-11e6-87ee-8e4a3ab90f2a ;
