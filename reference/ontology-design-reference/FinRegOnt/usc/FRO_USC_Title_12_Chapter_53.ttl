  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-13-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd637-1df7-11e6-87ee-8e4a3ab90f2a ;
