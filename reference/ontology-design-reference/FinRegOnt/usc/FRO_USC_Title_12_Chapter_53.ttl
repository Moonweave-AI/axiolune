  fro-usc:hasContentText "a potential certification process and standards for certification;" ;
  fro-usc:hasId "id83a8bcad-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/d/7/A/i/I" ;
