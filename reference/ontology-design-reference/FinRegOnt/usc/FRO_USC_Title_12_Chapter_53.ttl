  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aae1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-4-4> ;
  fro-usc:hasHeading "Rulemaking authority" ;
  fro-usc:hasId "id8395aadf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id8395aae0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-4-4-2> ;
  fro-usc:hasContentText "The Office, in consultation with the Chairperson, shall issue rules, regulations, and orders only to the extent necessary to carry out the purposes and duties described in paragraphs (1), (2), and (7) of subsection (a)." ;
  fro-usc:hasHeading "Scope" ;
  fro-usc:hasId "id8395aae0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aae1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-4-4-3> ;
  fro-usc:hasContentText "Member agencies, in consultation with the Office, shall implement regulations promulgated by the Office under paragraph (1) to standardize the types and formats of data reported and collected on behalf of the Council, as described in subsection (a)(2). If a member agency fails to implement such regulations prior to the expiration of the 3-year period following the date of publication of final regulations, the Office, in consultation with the Chairperson, may implement such regulations with respect to the financial entities under the jurisdiction of the member agency. This paragraph shall not supersede or interfere with the independent authority of a member agency under other law to collect data, in such format and manner as the member agency requires." ;
  fro-usc:hasHeading "Standardization" ;
  fro-usc:hasId "id8395aae1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395aae2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aae3-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aae4-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-4-5> ;
  fro-usc:hasHeading "Testimony" ;
  fro-usc:hasId "id8395aae2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id8395aae3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-4-5-2> ;
  fro-usc:hasContentText "The Director of the Office shall report to and testify before the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives annually on the activities of the Office, including the work of the Data Center and the Research and Analysis Center, and the assessment of the Office of significant financial market developments and potential emerging threats to the financial stability of the United States." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id8395aae3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aae4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-4-5-3> ;
  fro-usc:hasContentText "No officer or agency of the United States shall have any authority to require the Director to submit the testimony required under paragraph (1) or other congressional testimony to any officer or agency of the United States for approval, comment, or review prior to the submission of such testimony. Any such testimony to Congress shall include a statement that the views expressed therein are those of the Director and do not necessarily represent the views of the President." ;
  fro-usc:hasHeading "No prior review" ;
  fro-usc:hasId "id8395aae4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395aae5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-4-6> ;
  fro-usc:hasContentText "The Director may provide additional reports to Congress concerning the financial stability of the United States. The Director shall notify the Council of any such additional reports provided to Congress." ;
  fro-usc:hasHeading "Additional reports" ;
  fro-usc:hasId "id8395aae5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id8395aae6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aae7-1df7-11e6-87ee-8e4a3ab90f2a ;
