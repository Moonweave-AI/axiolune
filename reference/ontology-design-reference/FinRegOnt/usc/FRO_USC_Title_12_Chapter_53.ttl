  fro-usc:hasContentText "to discuss and answer questions concerning such report." ;
  fro-usc:hasId "id839360b8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839360b9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360ba-1df7-11e6-87ee-8e4a3ab90f2a ;
