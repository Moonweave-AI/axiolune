.
fro-usc-t12-ch53:id83a67385-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a67386-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a67387-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-2> ;
  fro-usc:hasHeading "Information to assess systemic importance" ;
  fro-usc:hasId "id83a67385-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a67386-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-2-2> ;
  fro-usc:hasContentText "The Council is authorized to require any financial market utility to submit such information as the Council may require for the sole purpose of assessing whether that financial market utility is systemically important, but only if the Council has reasonable cause to believe that the financial market utility meets the standards for systemic importance set forth in section 5463 of this title ." ;
  fro-usc:hasHeading "Financial market utilities" ;
  fro-usc:hasId "id83a67386-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5463" ;
.
fro-usc-t12-ch53:id83a67387-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-2-3> ;
  fro-usc:hasContentText "The Council is authorized to require any financial institution to submit such information as the Council may require for the sole purpose of assessing whether any payment, clearing, or settlement activity engaged in or supported by a financial institution is systemically important, but only if the Council has reasonable cause to believe that the activity meets the standards for systemic importance set forth in section 5463 of this title ." ;
  fro-usc:hasHeading "Financial institutions engaged in payment, clearing, or settlement activities" ;
  fro-usc:hasId "id83a67387-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5463" ;
.
fro-usc-t12-ch53:id83a67388-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a67389-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a6738a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a6738d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-3> ;
  fro-usc:hasHeading "Reporting after designation" ;
  fro-usc:hasId "id83a67388-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a67389-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-3-2> ;
  fro-usc:hasContentText "The Board of Governors and the Council may each require a designated financial market utility to submit reports or data to the Board of Governors and the Council in such frequency and form as deemed necessary by the Board of Governors or the Council in order to assess the safety and soundness of the utility and the systemic risk that the utility’s operations pose to the financial system." ;
  fro-usc:hasHeading "Designated financial market utilities" ;
  fro-usc:hasId "id83a67389-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a6738a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-3-3> ;
  fro-usc:hasHeading "Financial institutions subject to standards for designated activities" ;
  fro-usc:hasId "id83a6738a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-9-3-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6738b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6738c-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a6738b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-3-3-3> ;
  fro-usc:hasContentText "the rules, orders, or standards prescribed under section 5464(a) of this title with respect to the designated activity appropriately address the risks to the financial system presented by such activity; and" ;
  fro-usc:hasId "id83a6738b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/b/2/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5464/a" ;
.
fro-usc-t12-ch53:id83a6738c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-3-3-4> ;
  fro-usc:hasContentText "the financial institutions are in compliance with this subchapter and the rules and orders prescribed under section 5464(a) of this title with respect to the designated activity." ;
  fro-usc:hasId "id83a6738c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5464/a" ;
.
fro-usc-t12-ch53:id83a6738d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-3-4> ;
  fro-usc:hasContentText "The Board of Governors may, upon an affirmative vote by a majority of the Council, prescribe regulations under this section that impose a recordkeeping or reporting requirement on designated clearing entities or financial institutions engaged in designated activities that are subject to standards that have been prescribed under section 5464(a)(2) of this title ." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id83a6738d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/b/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5464/a/2" ;
.
fro-usc-t12-ch53:id83a6738e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a6738f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a67390-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-4> ;
  fro-usc:hasHeading "Coordination with appropriate Federal Supervisory Agency" ;
  fro-usc:hasId "id83a6738e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a6738f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-4-2> ;
  fro-usc:hasContentText "Before requesting any material information from, or imposing reporting or recordkeeping requirements on, any financial market utility or any financial institution engaged in a payment, clearing, or settlement activity, the Board of Governors or the Council shall coordinate with the Supervisory Agency for a financial market utility or the appropriate financial regulator for a financial institution to determine if the information is available from or may be obtained by the agency in the form, format, or detail required by the Board of Governors or the Council." ;
  fro-usc:hasHeading "Advance coordination" ;
  fro-usc:hasId "id83a6738f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a67390-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-4-3> ;
  fro-usc:hasContentText "Notwithstanding any other provision of law, the Supervisory Agency, the appropriate financial regulator, and the Board of Governors are authorized to disclose to each other and the Council copies of its examination reports or similar reports regarding any financial market utility or any financial institution engaged in payment, clearing, or settlement activities." ;
  fro-usc:hasHeading "Supervisory reports" ;
  fro-usc:hasId "id83a67390-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a67391-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-5> ;
  fro-usc:hasContentText "If the information, report, records, or data requested by the Board of Governors or the Council under subsection (c)(1) are not provided in full by the Supervisory Agency or the appropriate financial regulator in less than 15 days after the date on which the material is requested, the Board of Governors or the Council may request the information or impose recordkeeping or reporting requirements directly on such persons as provided in subsections (a) and (b) with notice to the agency." ;
  fro-usc:hasHeading "Timing of response from appropriate Federal Supervisory Agency" ;
  fro-usc:hasId "id83a67391-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83a67392-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a67393-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a67396-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-6> ;
  fro-usc:hasHeading "Sharing of information" ;
  fro-usc:hasId "id83a67392-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83a67393-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-6-2> ;
  fro-usc:hasHeading "Material concerns" ;
  fro-usc:hasId "id83a67393-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/e/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-9-6-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67394-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67395-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a67394-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-6-2-3> ;
  fro-usc:hasContentText "promptly notify each other of material concerns about a designated financial market utility or any financial institution engaged in designated activities; and" ;
  fro-usc:hasId "id83a67394-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/e/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a67395-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-6-2-4> ;
  fro-usc:hasContentText "share appropriate reports, information, or data relating to such concerns." ;
  fro-usc:hasId "id83a67395-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/e/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a67396-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-6-3> ;
  fro-usc:hasContentText "Notwithstanding any other provision of law, the Board of Governors, the Council, the appropriate financial regulator, or any Supervisory Agency may, under such terms and conditions as it deems appropriate, provide confidential supervisory information and other information obtained under this subchapter to each other, and to the Secretary, Federal Reserve Banks, State financial institution supervisory agencies, foreign financial supervisors, foreign central banks, and foreign finance ministries, subject to reasonable assurances of confidentiality, provided, however, that no person or entity receiving information pursuant to this section may disseminate such information to entities or persons other than those listed in this paragraph without complying with applicable law, including section 12 of title 7 ." ;
  fro-usc:hasHeading "Other information" ;
  fro-usc:hasId "id83a67396-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/e/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s12" ;
.
fro-usc-t12-ch53:id83a67397-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-7> ;
  fro-usc:hasContentText "The Board of Governors, the Council, the appropriate financial regulator, and any Supervisory Agency providing reports or data under this section shall not be deemed to have waived any privilege applicable to those reports or data, or any portion thereof, by providing the reports or data to the other party or by permitting the reports or data, or any copies thereof, to be used by the other party." ;
  fro-usc:hasHeading "Privilege maintained" ;
  fro-usc:hasId "id83a67397-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83a67398-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-9-8> ;
  fro-usc:hasContentText "Information obtained by the Board of Governors, the Supervisory Agencies, or the Council under this section and any materials prepared by the Board of Governors, the Supervisory Agencies, or the Council regarding their assessment of the systemic importance of financial market utilities or any payment, clearing, or settlement activities engaged in by financial institutions, and in connection with their supervision of designated financial market utilities and designated activities, shall be confidential supervisory information exempt from disclosure under section 552 of title 5 . For purposes of such section 552, this subsection shall be considered a statute described in subsection (b)(3) of such section 552." ;
  fro-usc:hasHeading "Disclosure exemption" ;
  fro-usc:hasId "id83a67398-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5468/g" ;
  fro-usc:hasNumberText "(g)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s552" ;
.
fro-usc-t12-ch53:id83a67399-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-usc:hasId "id83a67399-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tVIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1818" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title VIII , § 809, July 21, 2010 , 124 Stat. 1818 .)" ;
.
fro-usc-t12-ch53:id83a6739a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-10> ;
  fro-usc:hasContentText "The Board of Governors, the Supervisory Agencies, and the Council are authorized to prescribe such rules and issue such orders as may be necessary to administer and carry out their respective authorities and duties granted under this subchapter and prevent evasions thereof." ;
  fro-usc:hasHeading "Rulemaking" ;
  fro-usc:hasId "id83a6739a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5469" ;
  fro-usc:hasNumberText "§ 5469." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6739b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a6739b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id83a6739b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tVIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1820" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title VIII , § 810, July 21, 2010 , 124 Stat. 1820 .)" ;
.
fro-usc-t12-ch53:id83a6739c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-11> ;
  fro-usc:hasContentText "Unless otherwise provided by its terms, this subchapter does not divest any appropriate financial regulator, any Supervisory Agency, or any other Federal or State agency, of any authority derived from any other applicable law, except that any standards prescribed by the Board of Governors under section 5464 of this title shall supersede any less stringent requirements established under other authority to the extent of any conflict." ;
  fro-usc:hasHeading "Other authority" ;
  fro-usc:hasId "id83a6739c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5470" ;
  fro-usc:hasNumberText "§ 5470." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6739d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a6739d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id83a6739d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tVIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1821" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title VIII , § 811, July 21, 2010 , 124 Stat. 1821 .)" ;
.
fro-usc-t12-ch53:id83a6739e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a6739f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a673a3-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83a673a9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-12> ;
  fro-usc:hasHeading "Consultation" ;
  fro-usc:hasId "id83a6739e-1df7-11e6-87ee-8e4a3ab90f2a" ;
