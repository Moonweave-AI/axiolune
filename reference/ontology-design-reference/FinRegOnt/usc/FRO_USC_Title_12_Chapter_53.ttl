  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-5-3> ;
  fro-usc:hasId "id839cd666-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/4/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-3-5-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd667-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd668-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd669-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd66a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd667-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-5-3-2> ;
  fro-usc:hasContentText "to maximize the value of the assets of the covered financial company;" ;
  fro-usc:hasId "id839cd667-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/4/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839cd668-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-5-3-3> ;
  fro-usc:hasContentText "to initiate and continue operations essential to implementation of the receivership or any bridge financial company;" ;
  fro-usc:hasId "id839cd668-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/4/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd669-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-5-3-4> ;
  fro-usc:hasContentText "to maximize the present value return from the sale or other disposition of the assets of the covered financial company; or" ;
  fro-usc:hasId "id839cd669-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/4/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839cd66a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-5-3-5> ;
  fro-usc:hasContentText "to minimize the amount of any loss realized upon the sale or other disposition of the assets of the covered financial company; and" ;
  fro-usc:hasId "id839cd66a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/4/A/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id839cd66b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-5-4> ;
  fro-usc:hasContentText "all claimants that are similarly situated under paragraph (1) receive not less than the amount provided in paragraphs (2) and (3) of subsection (d)." ;
  fro-usc:hasId "id839cd66b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/4/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839cd66c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-6> ;
  fro-usc:hasContentText "This section shall not affect secured claims or security entitlements in respect of assets or property held by the covered financial company, except to the extent that the security is insufficient to satisfy the claim, and then only with regard to the difference between the claim and the amount realized from the security." ;
  fro-usc:hasHeading "Secured claims unaffected" ;
  fro-usc:hasId "id839cd66c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id839cd66d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-7> ;
  fro-usc:hasHeading "Priority of expenses and unsecured claims in the orderly liquidation of SIPC member" ;
  fro-usc:hasId "id839cd66d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-3-7-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd66e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd66f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd670-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd671-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd66e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-7-3> ;
  fro-usc:hasContentText "SIPC shall be entitled to recover administrative expenses incurred in performing its responsibilities under section 5385 of this title on an equal basis with the Corporation, in accordance with paragraph (1)(A);" ;
  fro-usc:hasId "id839cd66e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/6/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5385" ;
.
fro-usc-t12-ch53:id839cd66f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-7-4> ;
  fro-usc:hasContentText "the Corporation shall be entitled to recover any amounts paid to customers or to SIPC pursuant to section 5385(f) of this title , in accordance with paragraph (1)(B);" ;
  fro-usc:hasId "id839cd66f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/6/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5385/f" ;
.
fro-usc-t12-ch53:id839cd670-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-7-5> ;
  fro-usc:hasContentText "SIPC shall be entitled to recover any amounts paid out of the SIPC Fund to meet its obligations under section 5385 of this title and under the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.), which claim shall be subordinate to the claims payable under subparagraphs (A) and (B) of paragraph (1), but senior to all other claims; and" ;
  fro-usc:hasId "id839cd670-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/6/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5385" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839cd671-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-7-6> ;
  fro-usc:hasContentText "the Corporation may, after paying any proven claims to customers under section 5385 of this title and the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.), and as provided above, pay dividends on other proven claims, in its discretion, and to the extent that funds are available, in accordance with the priorities set forth in paragraph (1)." ;
  fro-usc:hasId "id839cd671-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/6/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5385" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839cd672-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
