.
fro-usc-t12-ch53:id83a40273-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-7-4> ;
  fro-usc:hasContentText "sponsoring and recruiting at job fairs in urban communities;" ;
  fro-usc:hasId "id83a40273-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/f/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a40274-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-7-5> ;
  fro-usc:hasContentText "placing employment advertisements in newspapers and magazines oriented toward minorities and women;" ;
  fro-usc:hasId "id83a40274-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/f/3" ;
  fro-usc:hasNumberText "(3)" ;
.
