  fro-usc:hasContentText "sponsor and conduct research projects; and" ;
  fro-usc:hasId "id8395aadd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
