  fro-usc:hasHeading "Benefits other than retirement benefits" ;
  fro-usc:hasId "id83a191f7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/i/2" ;
  fro-usc:hasNumberText "(2)" ;
