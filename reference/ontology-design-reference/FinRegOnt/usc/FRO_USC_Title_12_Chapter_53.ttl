  fro-usc:hasContentText "an evaluation of the characteristics and amounts of contingent capital that should be required;" ;
  fro-usc:hasId "id8393612f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83936130-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-2-5> ;
  fro-usc:hasContentText "an analysis of potential prudential standards that should be used to determine whether the contingent capital of a company would be converted to equity in times of financial stress;" ;
  fro-usc:hasId "id83936130-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83936131-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-2-6> ;
  fro-usc:hasContentText "an evaluation of the costs to companies, the effects on the structure and operation of credit and other financial markets, and other economic effects of requiring contingent capital;" ;
  fro-usc:hasId "id83936131-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83936132-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-2-7> ;
  fro-usc:hasContentText "an evaluation of the effects of such requirement on the international competitiveness of companies subject to the requirement and the prospects for international coordination in establishing such requirement; and" ;
  fro-usc:hasId "id83936132-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/1/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83936133-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-2-8> ;
  fro-usc:hasContentText "recommendations for implementing regulations." ;
  fro-usc:hasId "id83936133-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/1/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id83936134-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-3> ;
  fro-usc:hasContentText "The Council shall submit a report to Congress regarding the study required by paragraph (1) not later than 2 years after July 21, 2010 ." ;
  fro-usc:hasHeading "Report" ;
  fro-usc:hasId "id83936134-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83936135-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-4> ;
  fro-usc:hasHeading "Recommendations" ;
  fro-usc:hasId "id83936135-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83936136-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83936137-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83936136-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-4-2> ;
  fro-usc:hasContentText "Subsequent to submitting a report to Congress under paragraph (2), the Council may make recommendations to the Board of Governors to require any nonbank financial company supervised by the Board of Governors and any bank holding company described in subsection (a) to maintain a minimum amount of contingent capital that is convertible to equity in times of financial stress." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83936136-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83936137-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-4-3> ;
  fro-usc:hasHeading "Factors to consider" ;
  fro-usc:hasId "id83936137-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-6-4-4-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83936138-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83936139-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393613a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393613b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393613c-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83936138-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-4-3-3> ;
  fro-usc:hasContentText "an appropriate transition period for implementation of a conversion under this subsection;" ;
  fro-usc:hasId "id83936138-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/3/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83936139-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-4-3-4> ;
  fro-usc:hasContentText "the factors described in subsection (b)(3);" ;
  fro-usc:hasId "id83936139-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/3/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id8393613a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-4-3-5> ;
  fro-usc:hasContentText "capital requirements applicable to a nonbank financial company supervised by the Board of Governors or a bank holding company described in subsection (a), and subsidiaries thereof;" ;
  fro-usc:hasId "id8393613a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/3/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id8393613b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-4-3-6> ;
  fro-usc:hasContentText "results of the study required by paragraph (1); and" ;
  fro-usc:hasId "id8393613b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/3/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id8393613c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-4-4-3-7> ;
  fro-usc:hasContentText "any other factor that the Council deems appropriate." ;
  fro-usc:hasId "id8393613c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/c/3/B/v" ;
  fro-usc:hasNumberText "(v)" ;
.
fro-usc-t12-ch53:id8393613d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8393613e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8393613f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-5> ;
  fro-usc:hasHeading "Resolution plan and credit exposure reports" ;
  fro-usc:hasId "id8393613d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id8393613e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-5-2> ;
  fro-usc:hasContentText "The Council may make recommendations to the Board of Governors concerning the requirement that each nonbank financial company supervised by the Board of Governors and each bank holding company described in subsection (a) report periodically to the Council, the Board of Governors, and the Corporation, the plan of such company for rapid and orderly resolution in the event of material financial distress or failure." ;
  fro-usc:hasHeading "Resolution plan" ;
  fro-usc:hasId "id8393613e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8393613f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-5-3> ;
  fro-usc:hasHeading "Credit exposure report" ;
  fro-usc:hasId "id8393613f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/d/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-6-5-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83936140-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83936141-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83936140-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-5-3-3> ;
  fro-usc:hasContentText "the nature and extent to which the company has credit exposure to other significant nonbank financial companies and significant bank holding companies; and" ;
  fro-usc:hasId "id83936140-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/d/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83936141-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-5-3-4> ;
  fro-usc:hasContentText "the nature and extent to which other such significant nonbank financial companies and significant bank holding companies have credit exposure to that company." ;
  fro-usc:hasId "id83936141-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/d/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83936142-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-6> ;
  fro-usc:hasContentText "In order to limit the risks that the failure of any individual company could pose to nonbank financial companies supervised by the Board of Governors or bank holding companies described in subsection (a), the Council may make recommendations to the Board of Governors to prescribe standards to limit such risks, as set forth in section 5365 of this title ." ;
  fro-usc:hasHeading "Concentration limits" ;
  fro-usc:hasId "id83936142-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5365" ;
.
fro-usc-t12-ch53:id83936143-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-7> ;
  fro-usc:hasContentText "The Council may make recommendations to the Board of Governors to require periodic public disclosures by bank holding companies described in subsection (a) and by nonbank financial companies supervised by the Board of Governors, in order to support market evaluation of the risk profile, capital adequacy, and risk management capabilities thereof." ;
  fro-usc:hasHeading "Enhanced public disclosures" ;
  fro-usc:hasId "id83936143-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83936144-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-8> ;
  fro-usc:hasContentText "The Council may make recommendations to the Board of Governors to require short-term debt limits to mitigate the risks that an over-accumulation of such debt could pose to bank holding companies described in subsection (a), nonbank financial companies supervised by the Board of Governors, or the financial system." ;
  fro-usc:hasHeading "Short-term debt limits" ;
  fro-usc:hasId "id83936144-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id83936145-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-usc:hasId "id83936145-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1403" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 115, July 21, 2010 , 124 Stat. 1403 .)" ;
.
