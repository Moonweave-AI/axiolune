fro-usc-t12-ch53:id83b25af1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-4-2> ;
  fro-usc:hasContentText "The Director shall review all Federal laws and regulations relating to the protection of consumers who use exchange facilitators for transactions primarily for personal, family, or household purposes." ;
  fro-usc:hasHeading "Review" ;
  fro-usc:hasId "id83b25af1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5603/a" ;
  fro-usc:hasNumberText "(a)" ;
.
