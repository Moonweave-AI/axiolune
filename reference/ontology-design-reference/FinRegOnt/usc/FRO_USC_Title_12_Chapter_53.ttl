  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-10-4> ;
  fro-usc:hasContentText "does not include an insured depository institution." ;
  fro-usc:hasId "id83981b7d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/8/B" ;
  fro-usc:hasNumberText "(B)" ;
.
