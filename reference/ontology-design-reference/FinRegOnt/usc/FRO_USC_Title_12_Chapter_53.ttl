  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-19> ;
  fro-usc:hasContentText "The term “transfer date” means the date established under section 5411 of this title ." ;
  fro-usc:hasHeading "Transfer date" ;
  fro-usc:hasId "id83936038-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/17" ;
  fro-usc:hasNumberText "(17)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5411" ;
.
