  fro-usc:hasHeading "Special procedures for designated clearing entities and designated activities of certain financial institutions" ;
  fro-usc:hasId "id83a402ff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5464/a/2" ;
  fro-usc:hasNumberText "(2)" ;
