.
fro-usc-t12-ch53:id83a40232-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-6-3-3-4> ;
  fro-usc:hasContentText "entitled to receive compensation at the same annual rate of basic pay that the Director of the Office of Thrift Supervision received on the day before the transfer date." ;
  fro-usc:hasId "id83a40232-1df7-11e6-87ee-8e4a3ab90f2a" ;
