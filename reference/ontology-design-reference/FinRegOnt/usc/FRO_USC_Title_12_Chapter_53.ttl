  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-7-4> ;
  fro-usc:hasContentText "hold, maintain, sell, lease, or otherwise dispose of the property (or property interest) acquired under paragraph (1)." ;
