  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bda4-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ab2da7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4> ;
  fro-usc:hasHeading "Review of Bureau regulations" ;
  fro-usc:hasId "id83a8bd85-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513" ;
  fro-usc:hasNumberText "§ 5513." ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2da5-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd86-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-2> ;
  fro-usc:hasContentText "On the petition of a member agency of the Council, the Council may set aside a final regulation prescribed by the Bureau, or any provision thereof, if the Council decides, in accordance with subsection (c), that the regulation or provision would put the safety and soundness of the United States banking system or the stability of the financial system of the United States at risk." ;
  fro-usc:hasHeading "Review of Bureau regulations" ;
  fro-usc:hasId "id83a8bd86-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a8bd87-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd88-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd8b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-3> ;
  fro-usc:hasHeading "Petition" ;
  fro-usc:hasId "id83a8bd87-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a8bd88-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-3-2> ;
  fro-usc:hasHeading "Procedure" ;
  fro-usc:hasId "id83a8bd88-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/b/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-4-3-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd89-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd8a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd89-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-3-2-3> ;
  fro-usc:hasContentText "has in good faith attempted to work with the Bureau to resolve concerns regarding the effect of the rule on the safety and soundness of the United States banking system or the stability of the financial system of the United States; and" ;
  fro-usc:hasId "id83a8bd89-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/b/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a8bd8a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-3-2-4> ;
  fro-usc:hasContentText "files the petition with the Council not later than 10 days after the date on which the regulation has been published in the Federal Register." ;
  fro-usc:hasId "id83a8bd8a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/b/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a8bd8b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-3-3> ;
  fro-usc:hasContentText "Any petition filed with the Council under this section shall be published in the Federal Register and transmitted contemporaneously with filing to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives." ;
  fro-usc:hasHeading "Publication" ;
  fro-usc:hasId "id83a8bd8b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a8bd8c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd8d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd92-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd93-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd98-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd9e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd9f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bda0-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bda1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4> ;
  fro-usc:hasHeading "Stays and set asides" ;
  fro-usc:hasId "id83a8bd8c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a8bd8d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-2> ;
  fro-usc:hasHeading "Stay" ;
  fro-usc:hasId "id83a8bd8d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd8e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd8f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd8e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-2-2> ;
  fro-usc:hasContentText "Upon the request of any member agency, the Chairperson of the Council may stay the effectiveness of a regulation for the purpose of allowing appropriate consideration of the petition by the Council." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a8bd8e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a8bd8f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-2-3> ;
  fro-usc:hasHeading "Expiration" ;
  fro-usc:hasId "id83a8bd8f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-4-4-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd90-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd91-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd90-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-2-3-3> ;
  fro-usc:hasContentText "90 days after the date of filing of the petition under subsection (b); or" ;
  fro-usc:hasId "id83a8bd90-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/1/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a8bd91-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-2-3-4> ;
  fro-usc:hasContentText "the date on which the Council makes a decision under paragraph (3)." ;
  fro-usc:hasId "id83a8bd91-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a8bd92-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-3> ;
  fro-usc:hasContentText "After the expiration of any stay imposed under this section, no inference shall be drawn regarding the validity or enforceability of a regulation which was the subject of the petition." ;
  fro-usc:hasHeading "No adverse inference" ;
  fro-usc:hasId "id83a8bd92-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a8bd93-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-4> ;
  fro-usc:hasHeading "Vote" ;
  fro-usc:hasId "id83a8bd93-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd94-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd95-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd94-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-4-2> ;
  fro-usc:hasContentText "The decision to issue a stay of, or set aside, any regulation under this section shall be made only with the affirmative vote in accordance with subparagraph (B) of ⅔ of the members of the Council then serving." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a8bd94-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a8bd95-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-4-3> ;
  fro-usc:hasHeading "Authorization to vote" ;
  fro-usc:hasId "id83a8bd95-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-4-4-4-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd96-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd97-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd96-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-4-3-3> ;
  fro-usc:hasContentText "considered any relevant information provided by the agency submitting the petition and by the Bureau; and" ;
  fro-usc:hasId "id83a8bd96-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/3/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a8bd97-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-4-3-4> ;
  fro-usc:hasContentText "made an official determination, at a public meeting where applicable, that the regulation which is the subject of the petition would put the safety and soundness of the United States banking system or the stability of the financial system of the United States at risk." ;
  fro-usc:hasId "id83a8bd97-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/3/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a8bd98-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-5> ;
  fro-usc:hasHeading "Decisions to set aside" ;
  fro-usc:hasId "id83a8bd98-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/4" ;
  fro-usc:hasNumberText "(4)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd99-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd9a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd9d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd99-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-5-2> ;
  fro-usc:hasContentText "A decision by the Council to set aside a regulation prescribed by the Bureau, or provision thereof, shall render such regulation, or provision thereof, unenforceable." ;
  fro-usc:hasHeading "Effect of decision" ;
  fro-usc:hasId "id83a8bd99-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a8bd9a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-5-3> ;
  fro-usc:hasHeading "Timely action required" ;
  fro-usc:hasId "id83a8bd9a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/4/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-4-4-5-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd9b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd9c-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd9b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-5-3-3> ;
  fro-usc:hasContentText "45 days following the date of filing of the petition, unless a stay is issued under paragraph (1); or" ;
  fro-usc:hasId "id83a8bd9b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/4/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a8bd9c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-5-3-4> ;
  fro-usc:hasContentText "the expiration of a stay issued by the Council under this section." ;
  fro-usc:hasId "id83a8bd9c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/4/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a8bd9d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-5-4> ;
  fro-usc:hasContentText "The issuance of a stay under this section does not affect the authority of the Council to set aside a regulation." ;
  fro-usc:hasHeading "Separate authority" ;
  fro-usc:hasId "id83a8bd9d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/4/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a8bd9e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-6> ;
  fro-usc:hasContentText "A petition under this section shall be deemed dismissed if the Council has not issued a decision to set aside a regulation, or provision thereof, within the period for timely action under paragraph (4)(B)." ;
  fro-usc:hasHeading "Dismissal due to inaction" ;
  fro-usc:hasId "id83a8bd9e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83a8bd9f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-7> ;
  fro-usc:hasContentText "Any decision under this subsection to issue a stay of, or set aside, a regulation or provision thereof shall be published by the Council in the Federal Register as soon as practicable after the decision is made, with an explanation of the reasons for the decision." ;
  fro-usc:hasHeading "Publication of decision" ;
  fro-usc:hasId "id83a8bd9f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id83a8bda0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-8> ;
  fro-usc:hasContentText "The notice and comment procedures under section 553 of title 5 shall not apply to any decision under this section of the Council to issue a stay of, or set aside, a regulation." ;
  fro-usc:hasHeading "Rulemaking procedures inapplicable" ;
  fro-usc:hasId "id83a8bda0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/7" ;
  fro-usc:hasNumberText "(7)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s553" ;
.
fro-usc-t12-ch53:id83a8bda1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-4-9> ;
  fro-usc:hasContentText "A decision by the Council to set aside a regulation prescribed by the Bureau, or provision thereof, shall be subject to review under chapter 7 of title 5." ;
  fro-usc:hasHeading "Judicial review of decisions by the Council" ;
  fro-usc:hasId "id83a8bda1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/c/8" ;
  fro-usc:hasNumberText "(8)" ;
.
fro-usc-t12-ch53:id83a8bda2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-5> ;
  fro-usc:hasContentText "Nothing in this section shall be construed as altering, limiting, or restricting the application of any other provision of law, except as otherwise specifically provided in this section, including chapter 5 and chapter 7 of title 5, to a regulation which is the subject of a petition filed under this section." ;
  fro-usc:hasHeading "Application of other law" ;
  fro-usc:hasId "id83a8bda2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83a8bda3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-6> ;
  fro-usc:hasContentText "Nothing in this section shall be construed as limiting or restricting the Bureau from engaging in a rulemaking in accordance with applicable law." ;
  fro-usc:hasHeading "Savings clause" ;
  fro-usc:hasId "id83a8bda3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83a8bda4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-7> ;
  fro-usc:hasContentText "The Council shall prescribe procedural rules to implement this section." ;
  fro-usc:hasHeading "Implementing rules" ;
  fro-usc:hasId "id83a8bda4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5513/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83ab2da5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-usc:hasId "id83ab2da5-1df7-11e6-87ee-8e4a3ab90f2a" ;
