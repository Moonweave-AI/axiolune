  lkif-mereo:component fro-usc-t12-ch53:id83b4a45c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a45d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a459-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-3-5-3> ;
  fro-usc:hasContentText "an organization described in section 501(c)(3) of title 26 , and exempt from tax under section 501(a) of such title;" ;
  fro-usc:hasId "id83b4a459-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5622/3/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t26/s501/c/3" ;
.
fro-usc-t12-ch53:id83b4a45a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-3-5-4> ;
  fro-usc:hasContentText "a federally insured depository institution;" ;
  fro-usc:hasId "id83b4a45a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5622/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b4a45b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-3-5-5> ;
  fro-usc:hasContentText "a community development financial institution;" ;
  fro-usc:hasId "id83b4a45b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5622/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83b4a45c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-3-5-6> ;
  fro-usc:hasContentText "a State, local, or tribal government entity; or" ;
  fro-usc:hasId "id83b4a45c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5622/3/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83b4a45d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-3-5-7> ;
  fro-usc:hasContentText "a partnership or other joint venture comprised of 1 or more of the entities described in subparagraphs (A) through (D), in accordance with regulations prescribed by the Secretary under this subchapter." ;
  fro-usc:hasId "id83b4a45d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5622/3/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83b4a45e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-3-6> ;
  fro-usc:hasContentText "The term “federally insured depository institution” means any insured depository institution (as that term is defined in section 1813 of this title ) and any insured credit union (as that term is defined in section 1752 of this title )." ;
  fro-usc:hasHeading "Federally insured depository institution" ;
  fro-usc:hasId "id83b4a45e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5622/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1752" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813" ;
.
fro-usc-t12-ch53:id83b4a45f-1df7-11e6-87ee-8e4a3ab90f2a
