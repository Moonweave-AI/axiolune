  fro-usc:hasContentText "steps that have been taken by the regulator in response to the complaint or inquiry of the consumer;" ;
  fro-usc:hasId "id83ad77ed-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5534/a/1" ;
