  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b4a447-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-4> ;
  fro-usc:hasHeading "Additional related matters" ;
  fro-usc:hasId "id83b4a43b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5613" ;
  fro-usc:hasNumberText "§ 5613." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a445-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a43c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-4-2> ;
  fro-usc:hasContentText "Effective upon July 21, 2010 , the Corporation may not exercise its authority under section 1823(c)(4)(G)(i) of this title to establish any widely available debt guarantee program for which section 5612 of this title would provide authority." ;
  fro-usc:hasHeading "Suspension of parallel Federal Deposit Insurance Act authority" ;
  fro-usc:hasId "id83b4a43c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5613/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1823/c/4/G/i" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5612" ;
.
