  fro-usc:hasContentText "identification of the cross-guarantees tied to different securities, identification of major counterparties, and a process for determining to whom the collateral of the company is pledged; and" ;
  fro-usc:hasId "id8395aba4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
