  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8bfd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8bfe-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8bff-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c00-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-3> ;
  fro-usc:hasHeading "Determination by the Secretary" ;
  fro-usc:hasId "id839a8bf9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-4-3-2> ;
.
fro-usc-t12-ch53:id839a8bfa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-3-3> ;
  fro-usc:hasContentText "the financial company is in default or in danger of default;" ;
  fro-usc:hasId "id839a8bfa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839a8bfb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-3-4> ;
  fro-usc:hasContentText "the failure of the financial company and its resolution under otherwise applicable Federal or State law would have serious adverse effects on financial stability in the United States;" ;
  fro-usc:hasId "id839a8bfb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839a8bfc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-3-5> ;
  fro-usc:hasContentText "no viable private sector alternative is available to prevent the default of the financial company;" ;
  fro-usc:hasId "id839a8bfc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839a8bfd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-3-6> ;
  fro-usc:hasContentText "any effect on the claims or interests of creditors, counterparties, and shareholders of the financial company and other market participants as a result of actions to be taken under this subchapter is appropriate, given the impact that any action taken under this subchapter would have on financial stability in the United States;" ;
  fro-usc:hasId "id839a8bfd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id839a8bfe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-3-7> ;
  fro-usc:hasContentText "any action under section 5384 of this title would avoid or mitigate such adverse effects, taking into consideration the effectiveness of the action in mitigating potential adverse effects on the financial system, the cost to the general fund of the Treasury, and the potential to increase excessive risk taking on the part of creditors, counterparties, and shareholders in the financial company;" ;
  fro-usc:hasId "id839a8bfe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/b/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5384" ;
.
fro-usc-t12-ch53:id839a8bff-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-3-8> ;
  fro-usc:hasContentText "a Federal regulatory agency has ordered the financial company to convert all of its convertible debt instruments that are subject to the regulatory order; and" ;
  fro-usc:hasId "id839a8bff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/b/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id839a8c00-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-3-9> ;
  fro-usc:hasContentText "the company satisfies the definition of a financial company under section 5381 of this title ." ;
  fro-usc:hasId "id839a8c00-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/b/7" ;
  fro-usc:hasNumberText "(7)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5381" ;
.
