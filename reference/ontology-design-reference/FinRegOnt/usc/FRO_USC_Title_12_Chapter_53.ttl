  fro-usc:hasContentText "any subsidiary (other than a depository institution) of a savings and loan holding company; and" ;
  fro-usc:hasId "id83a1917d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5412/b/1/A/i/II" ;
