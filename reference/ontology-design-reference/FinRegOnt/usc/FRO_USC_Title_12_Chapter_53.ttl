  fro-usc:hasContentText "responses received by the covered person from the consumer; and" ;
  fro-usc:hasId "id83ad77f2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5534/b/2" ;
