.
fro-usc-t12-ch53:id83a1914b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-14-3-5-2> ;
  fro-usc:hasContentText "involves personal dishonesty on the part of such senior executive or director; or" ;
  fro-usc:hasId "id83a1914b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5393/b/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a1914c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-14-3-5-3> ;
  fro-usc:hasContentText "demonstrates willful or continuing disregard by such senior executive or director for the safety or soundness of such company." ;
  fro-usc:hasId "id83a1914c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5393/b/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a1914d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1914e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1914f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-14-4> ;
  fro-usc:hasHeading "Authorized actions" ;
  fro-usc:hasId "id83a1914d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5393/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a1914e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-14-4-2> ;
  fro-usc:hasContentText "The appropriate agency for a financial company, as described in subsection (a), may serve upon a senior executive or director described in subsection (b) a written notice of the intention of the agency to prohibit any further participation by such person, in any manner, in the conduct of the affairs of any financial company for a period of time determined by the appropriate agency to be commensurate with such violation, practice, or breach, provided such period shall be not less than 2 years." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a1914e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5393/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a1914f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-14-4-3> ;
  fro-usc:hasContentText "The due process requirements and other procedures under section 8(e) of the Federal Deposit Insurance Act ( 12 U.S.C. 1818(e) ) shall apply to actions under this section as if the covered financial company were an insured depository institution and the senior executive or director were an institution-affiliated party, as those terms are defined in that Act [ 12 U.S.C. 1811 et seq.]." ;
  fro-usc:hasHeading "Procedures" ;
  fro-usc:hasId "id83a1914f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5393/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1811" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1818/e" ;
.
fro-usc-t12-ch53:id83a19150-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-14-5> ;
  fro-usc:hasContentText "The Corporation and the Board of Governors, in consultation with the Council, shall jointly prescribe rules or regulations to administer and carry out this section, including rules, regulations, or guidelines to further define the term senior executive for the purposes of this section." ;
  fro-usc:hasHeading "Regulations" ;
  fro-usc:hasId "id83a19150-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5393/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83a19151-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "id83a19151-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/stat/124/1517" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , § 213, July 21, 2010 , 124 Stat. 1517 .)" ;
.
fro-usc-t12-ch53:id83a19153-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-14-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a19153-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Federal Deposit Insurance Act, referred to in subsec. (c)(2), is act Sept. 21, 1950, ch. 967 , § 2, 64 Stat. 873 , which is classified generally to chapter 16 (§ 1811 et seq.) of this title. The terms “insured depository institution” and “institution-affiliated party” are defined in section 3 of the Act, which is classified to section 1813 of this title . For complete classification of this Act to the Code, see Short Title note set out under section 1811 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1950-09-21/ch967" ;
  fro-usc:hasReferenceText "/us/stat/64/873" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1811" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813" ;
.
fro-usc-t12-ch53:id83a19154-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19155-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19156-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19157-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83a1915a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-15> ;
  fro-usc:hasHeading "Prohibition on taxpayer funding" ;
  fro-usc:hasId "id83a19154-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5394" ;
  fro-usc:hasNumberText "§ 5394." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a19158-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a19155-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-15-2> ;
  fro-usc:hasContentText "All financial companies put into receivership under this subchapter shall be liquidated. No taxpayer funds shall be used to prevent the liquidation of any financial company under this subchapter." ;
  fro-usc:hasHeading "Liquidation required" ;
  fro-usc:hasId "id83a19155-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5394/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a19156-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-15-3> ;
  fro-usc:hasContentText "All funds expended in the liquidation of a financial company under this subchapter shall be recovered from the disposition of assets of such financial company, or shall be the responsibility of the financial sector, through assessments." ;
  fro-usc:hasHeading "Recovery of funds" ;
  fro-usc:hasId "id83a19156-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5394/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a19157-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-15-4> ;
  fro-usc:hasContentText "Taxpayers shall bear no losses from the exercise of any authority under this subchapter." ;
  fro-usc:hasHeading "No losses to taxpayers" ;
  fro-usc:hasId "id83a19157-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5394/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a19158-1df7-11e6-87ee-8e4a3ab90f2a
