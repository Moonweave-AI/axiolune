  fro-usc:hasContentText "current mechanisms and structures for facilitating international cooperation;" ;
  fro-usc:hasId "id839a8bdc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/f/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
