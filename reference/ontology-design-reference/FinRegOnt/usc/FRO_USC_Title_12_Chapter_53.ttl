  fro-usc:hasContentText "all rulemaking authority of the Office of Thrift Supervision and the Director of the Office of Thrift Supervision relating to savings and loan holding companies." ;
  fro-usc:hasId "id83a1917e-1df7-11e6-87ee-8e4a3ab90f2a" ;
