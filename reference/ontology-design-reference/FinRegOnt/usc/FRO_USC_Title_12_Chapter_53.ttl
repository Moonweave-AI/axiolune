  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-4-2> ;
  fro-usc:hasHeading "In general" ;
