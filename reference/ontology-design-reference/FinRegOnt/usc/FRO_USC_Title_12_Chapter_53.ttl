  fro-usc:hasContentText "entered into or conducted as a subterfuge or with a purpose to evade any Federal consumer financial law; or" ;
  fro-usc:hasId "id83a673f9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/xi/I" ;
