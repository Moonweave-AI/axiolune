  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-13> ;
  fro-usc:hasHeading "Certain security and customer interests not avoidable" ;
  fro-usc:hasId "id839cd71e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/12" ;
  fro-usc:hasNumberText "(12)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-13-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd71f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd720-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd71f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-13-3> ;
  fro-usc:hasContentText "legally enforceable or perfected security interest in any of the assets of any covered financial company, except in accordance with subsection (a)(11); or" ;
  fro-usc:hasId "id839cd71f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/12/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839cd720-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-13-4> ;
  fro-usc:hasContentText "legally enforceable interest in customer property, security entitlements in respect of assets or property held by the covered financial company for any security entitlement holder." ;
  fro-usc:hasId "id839cd720-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/12/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839cd721-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-14> ;
  fro-usc:hasHeading "Authority to enforce contracts" ;
  fro-usc:hasId "id839cd721-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/13" ;
  fro-usc:hasNumberText "(13)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd722-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4723-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4724-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4727-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd722-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-14-2> ;
  fro-usc:hasContentText "The Corporation, as receiver for a covered financial company, may enforce any contract, other than a liability insurance contract of a director or officer, a financial institution bond entered into by the covered financial company, notwithstanding any provision of the contract providing for termination, default, acceleration, or exercise of rights upon, or solely by reason of, insolvency, the appointment of or the exercise of rights or powers by the Corporation as receiver, the filing of the petition pursuant to section 5382(a)(1) of this title , or the issuance of the recommendations or determination, or any actions or events occurring in connection therewith or as a result thereof, pursuant to section 5383 of this title ." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839cd722-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/13/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5382/a/1" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5383" ;
.
fro-usc-t12-ch53:id839f4723-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-14-3> ;
  fro-usc:hasContentText "No provision of this paragraph may be construed as impairing or affecting any right of the Corporation as receiver to enforce or recover under a liability insurance contract of a director or officer or financial institution bond under other applicable law." ;
  fro-usc:hasHeading "Certain rights not affected" ;
  fro-usc:hasId "id839f4723-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/13/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f4724-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-14-4> ;
  fro-usc:hasHeading "Consent requirement and ipso facto clauses" ;
  fro-usc:hasId "id839f4724-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/13/C" ;
  fro-usc:hasNumberText "(C)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4725-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4726-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4725-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-14-4-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f4725-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/13/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f4726-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-14-4-3> ;
  fro-usc:hasHeading "Exceptions" ;
  fro-usc:hasId "id839f4726-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/13/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f4727-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-14-5> ;
  fro-usc:hasContentText "Notwithstanding any other provision in this subchapter, if the Corporation as receiver enforces any contract to extend credit to the covered financial company or bridge financial company, any valid and enforceable obligation to repay such debt shall be paid by the Corporation as receiver, as an administrative expense of the receivership." ;
  fro-usc:hasHeading "Contracts to extend credit" ;
  fro-usc:hasId "id839f4727-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/13/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839f4728-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-15> ;
  fro-usc:hasHeading "Exception for Federal reserve banks and Corporation security interest" ;
  fro-usc:hasId "id839f4728-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/14" ;
  fro-usc:hasNumberText "(14)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-15-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4729-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f472a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4729-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-15-3> ;
  fro-usc:hasContentText "any extension of credit from any Federal reserve bank or the Corporation to any covered financial company; or" ;
  fro-usc:hasId "id839f4729-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/14/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f472a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-15-4> ;
  fro-usc:hasContentText "any security interest in the assets of the covered financial company securing any such extension of credit." ;
  fro-usc:hasId "id839f472a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/14/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f472b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-16> ;
  fro-usc:hasContentText "The meanings of terms used in this subsection are applicable for purposes of this subsection only, and shall not be construed or applied so as to challenge or affect the characterization, definition, or treatment of any similar terms under any other statute, regulation, or rule, including the Gramm-Leach-Bliley Act, the Legal Certainty for Bank Products Act of 2000 [ 7 U.S.C. 27 to 27f], the securities laws (as that term is defined in section 3(a)(47) of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c(a)(47) ]), and the Commodity Exchange Act [ 7 U.S.C. 1 et seq.]." ;
  fro-usc:hasHeading "Savings clause" ;
  fro-usc:hasId "id839f472b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/15" ;
  fro-usc:hasNumberText "(15)" ;
