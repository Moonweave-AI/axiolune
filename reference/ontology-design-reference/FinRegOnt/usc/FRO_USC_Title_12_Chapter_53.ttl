fro-usc-t12-ch53:id83b25aa6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-7-2> ;
  fro-usc:hasContentText "The Secretary is authorized to perform the functions of the Bureau under this part until the Director of the Bureau is confirmed by the Senate in accordance with section 5491 of this title ." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b25aa6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5586/a" ;
