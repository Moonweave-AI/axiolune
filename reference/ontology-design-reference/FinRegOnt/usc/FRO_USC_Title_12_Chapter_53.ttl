fro-usc-t12-ch53:id83ab2dab-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-2-2-3> ;
  fro-usc:hasContentText "offers or provides origination, brokerage, or servicing of loans secured by real estate for use by consumers primarily for personal, family, or household purposes, or loan modification or foreclosure relief services in connection with such loans;" ;
  fro-usc:hasId "id83ab2dab-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2dac-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-2-2-4> ;
  fro-usc:hasContentText "is a larger participant of a market for other consumer financial products or services, as defined by rule in accordance with paragraph (2);" ;
  fro-usc:hasId "id83ab2dac-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2dad-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-2-2-5> ;
  fro-usc:hasContentText "the Bureau has reasonable cause to determine, by order, after notice to the covered person and a reasonable opportunity for such covered person to respond, based on complaints collected through the system under section 5493(b)(3) of this title or information from other sources, that such covered person is engaging, or has engaged, in conduct that poses risks to consumers with regard to the offering or provision of consumer financial products or services;" ;
  fro-usc:hasId "id83ab2dad-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/a/1/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5493/b/3" ;
.
fro-usc-t12-ch53:id83ab2dae-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-2-2-6> ;
  fro-usc:hasContentText "offers or provides to a consumer any private education loan, as defined in section 1650 of title 15 , notwithstanding section 5517(a)(2)(A) of this title and subject to section 5517(a)(2)(C) of this title ; or" ;
  fro-usc:hasId "id83ab2dae-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/a/1/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5517/a/2/A" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5517/a/2/C" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1650" ;
.
fro-usc-t12-ch53:id83ab2daf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-2-2-7> ;
  fro-usc:hasContentText "offers or provides to a consumer a payday loan." ;
  fro-usc:hasId "id83ab2daf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/a/1/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83ab2db0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-2-3> ;
  fro-usc:hasContentText "The Bureau shall consult with the Federal Trade Commission prior to issuing a rule, in accordance with paragraph (1)(B), to define covered persons subject to this section. The Bureau shall issue its initial rule not later than 1 year after the designated transfer date." ;
  fro-usc:hasHeading "Rulemaking to define covered persons subject to this section" ;
  fro-usc:hasId "id83ab2db0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ab2db1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-2-4> ;
  fro-usc:hasHeading "Rules of construction" ;
  fro-usc:hasId "id83ab2db1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/a/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2db2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2db3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2db2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-2-4-2> ;
  fro-usc:hasContentText "This section shall not apply to persons described in section 5515(a) or 5516(a) of this title." ;
  fro-usc:hasHeading "Certain persons excluded" ;
  fro-usc:hasId "id83ab2db2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/a/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2db3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-2-4-3> ;
  fro-usc:hasContentText "For purposes of computing activity levels under paragraph (1) or rules issued thereunder, activities of affiliated companies (other than insured depository institutions or insured credit unions) shall be aggregated." ;
  fro-usc:hasHeading "Activity levels" ;
  fro-usc:hasId "id83ab2db3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/a/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
