  fro-usc:hasHeading "Review, report, and program with respect to exchange facilitators" ;
  fro-usc:hasId "id83b25af0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5603" ;
  fro-usc:hasNumberText "§ 5603." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25afb-1df7-11e6-87ee-8e4a3ab90f2a ;
