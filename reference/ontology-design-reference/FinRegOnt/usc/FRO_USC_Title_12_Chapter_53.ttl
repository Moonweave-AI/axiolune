  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-3> ;
  fro-usc:hasId "id83ad7820-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-5-8-2-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7821-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7822-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7825-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad7821-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-3-2> ;
  fro-usc:hasContentText "a securities commission (or any agency or office performing like functions) of a State that the Office determines has adopted rules on the appropriate use of designations in the offer or sale of securities or the provision of investment advice that meet or exceed the minimum requirements of the NASAA Model Rule on the Use of Senior-Specific Certifications and Professional Designations (or any successor thereto);" ;
  fro-usc:hasId "id83ad7821-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ad7822-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-3-3> ;
  fro-usc:hasId "id83ad7822-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-5-8-2-3-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7823-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7824-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad7823-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-3-3-2> ;
  fro-usc:hasContentText "adopted rules on the appropriate use of designations in the sale of insurance products that, to the extent practicable, conform to the minimum requirements of the National Association of Insurance Commissioners Model Regulation on the Use of Senior-Specific Certifications and Professional Designations in the Sale of Life Insurance and Annuities (or any successor thereto); and" ;
  fro-usc:hasId "id83ad7823-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/1/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ad7824-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-3-3-3> ;
  fro-usc:hasContentText "adopted rules with respect to fiduciary or suitability requirements in the sale of annuities that meet or exceed the minimum requirements established by the Suitability in Annuity Transactions Model Regulation of the National Association of Insurance Commissioners (or any successor thereto); or" ;
  fro-usc:hasId "id83ad7824-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83ad7825-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-3-4> ;
  fro-usc:hasId "id83ad7825-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/1/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-5-8-2-3-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7826-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7827-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad7826-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-3-4-2> ;
  fro-usc:hasContentText "the securities commission (or any agency or office performing like functions) of the State is eligible under subparagraph (A); or" ;
  fro-usc:hasId "id83ad7826-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/1/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ad7827-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-3-4-3> ;
  fro-usc:hasContentText "the insurance commission (or any agency or office performing like functions) of the State is eligible under subparagraph (B);" ;
  fro-usc:hasId "id83ad7827-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/1/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83ad7828-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-4> ;
  fro-usc:hasContentText "the term “financial product” means a security, an insurance product (including an insurance product that pays a return, whether fixed or variable), a bank product, and a loan product;" ;
  fro-usc:hasId "id83ad7828-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ad7829-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-5> ;
  fro-usc:hasId "id83ad7829-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-5-8-2-5-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad782a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad782b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad782a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-5-2> ;
  fro-usc:hasContentText "means a certification, professional designation, or other purported credential that indicates or implies that a salesperson or adviser has special certification or training in advising or servicing seniors; and" ;
  fro-usc:hasId "id83ad782a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ad782b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-5-3> ;
  fro-usc:hasId "id83ad782b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-5-8-2-5-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad782c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad782d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad782e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad782c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-5-3-2> ;
  fro-usc:hasContentText "was issued by or obtained from an academic institution having regional accreditation;" ;
  fro-usc:hasId "id83ad782c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/3/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ad782d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-5-3-3> ;
  fro-usc:hasContentText "meets the standards for certifications and professional designations outlined by the NASAA Model Rule on the Use of Senior-Specific Certifications and Professional Designations (or any successor thereto) or by the Model Regulations on the Use of Senior-Specific Certifications and Professional Designations in the Sale of Life Insurance and Annuities, adopted by the National Association of Insurance Commissioners (or any successor thereto); or" ;
  fro-usc:hasId "id83ad782d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/3/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83ad782e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-5-3-4> ;
  fro-usc:hasContentText "was issued by or obtained from a State;" ;
  fro-usc:hasId "id83ad782e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/3/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83ad782f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-6> ;
  fro-usc:hasContentText "the term “misleading or fraudulent marketing” means the use of a misleading designation by a person that sells to or advises a senior in connection with the sale of a financial product;" ;
  fro-usc:hasId "id83ad782f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83ad7830-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-7> ;
  fro-usc:hasContentText "the term “NASAA” means the North American Securities Administrators Association;" ;
  fro-usc:hasId "id83ad7830-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83ad7831-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-8> ;
  fro-usc:hasContentText "the term “Office” means the Office of Financial Literacy of the Bureau;" ;
  fro-usc:hasId "id83ad7831-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id83ad7832-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-9> ;
  fro-usc:hasContentText "the term “senior” means any individual who has attained the age of 62 years or older; and" ;
  fro-usc:hasId "id83ad7832-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/7" ;
  fro-usc:hasNumberText "(7)" ;
.
fro-usc-t12-ch53:id83ad7833-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-2-10> ;
  fro-usc:hasContentText "the term “State” has the same meaning as in section 78c(a) of title 15 ." ;
  fro-usc:hasId "id83ad7833-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/a/8" ;
  fro-usc:hasNumberText "(8)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c/a" ;
.
fro-usc-t12-ch53:id83ad7834-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7835-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7836-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7837-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7838-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7839-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad783a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad783b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-3> ;
  fro-usc:hasHeading "Grants to States for enhanced protection of seniors from being misled by false designations" ;
  fro-usc:hasId "id83ad7834-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-5-8-3-2> ;
.
fro-usc-t12-ch53:id83ad7835-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-3-3> ;
  fro-usc:hasContentText "to hire staff to identify, investigate, and prosecute (through civil, administrative, or criminal enforcement actions) cases involving misleading or fraudulent marketing;" ;
  fro-usc:hasId "id83ad7835-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ad7836-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-3-4> ;
  fro-usc:hasContentText "to fund technology, equipment, and training for regulators, prosecutors, and law enforcement officers, in order to identify salespersons and advisers who target seniors through the use of misleading designations;" ;
  fro-usc:hasId "id83ad7836-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ad7837-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-3-5> ;
  fro-usc:hasContentText "to fund technology, equipment, and training for prosecutors to increase the successful prosecution of salespersons and advisers who target seniors with the use of misleading designations;" ;
  fro-usc:hasId "id83ad7837-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83ad7838-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-3-6> ;
  fro-usc:hasContentText "to provide educational materials and training to regulators on the appropriateness of the use of designations by salespersons and advisers in connection with the sale and marketing of financial products;" ;
  fro-usc:hasId "id83ad7838-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83ad7839-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-3-7> ;
  fro-usc:hasContentText "to provide educational materials and training to seniors to increase awareness and understanding of misleading or fraudulent marketing;" ;
  fro-usc:hasId "id83ad7839-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83ad783a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-3-8> ;
  fro-usc:hasContentText "to develop comprehensive plans to combat misleading or fraudulent marketing of financial products to seniors; and" ;
  fro-usc:hasId "id83ad783a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/b/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id83ad783b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-3-9> ;
  fro-usc:hasContentText "to enhance provisions of State law to provide protection for seniors against misleading or fraudulent marketing." ;
  fro-usc:hasId "id83ad783b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/b/7" ;
  fro-usc:hasNumberText "(7)" ;
.
