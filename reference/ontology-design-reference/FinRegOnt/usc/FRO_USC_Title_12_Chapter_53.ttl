  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 23 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23> ;
  fro-usc:hasHeading "Person regulated by the Commission" ;
  fro-usc:hasId "id83a6740d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21" ;
