fro-usc-t12-ch53:id83936045-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83936048-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83936049-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-4> ;
  fro-usc:hasContentText "If any provision of this Act, an amendment made by this Act, or the application of such provision or amendment to any person or circumstance is held to be unconstitutional, the remainder of this Act, the amendments made by this Act, and the application of the provisions of such to any person or circumstance shall not be affected thereby." ;
  fro-usc:hasHeading "Severability" ;
  fro-usc:hasId "id83936045-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5302" ;
  fro-usc:hasNumberText "§ 5302." ;
  lkif-mereo:component fro-usc-t12-ch53:id83936046-1df7-11e6-87ee-8e4a3ab90f2a ;
.
