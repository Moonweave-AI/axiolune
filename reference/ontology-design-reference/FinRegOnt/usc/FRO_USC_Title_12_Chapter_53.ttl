.
fro-usc-t12-ch53:id839f4734-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-5-3-3> ;
  fro-usc:hasContentText "the Corporation had not been appointed receiver with respect to the covered financial company; and" ;
  fro-usc:hasId "id839f4734-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/d/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f4735-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-5-3-4> ;
  fro-usc:hasContentText "the covered financial company had been liquidated under chapter 7 of the Bankruptcy Code, or any similar provision of State insolvency law applicable to the covered financial company." ;
  fro-usc:hasId "id839f4735-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/d/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
