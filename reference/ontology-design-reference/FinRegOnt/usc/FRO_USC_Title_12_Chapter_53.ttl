fro-usc-t12-ch53:id83afe9cb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-4-2-3> ;
  fro-usc:hasContentText "authority to require reports from and conduct examinations for compliance with Federal consumer financial laws with respect to a person described in section 5515(a) of this title , that is incidental to the backup and enforcement procedures provided to the regulator under section 5515(c) of this title ; and" ;
  fro-usc:hasId "id83afe9cb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/c/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5515/a" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5515/c" ;
.
fro-usc-t12-ch53:id83afe9cc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-4-2-4> ;
  fro-usc:hasContentText "exclusive authority (relative to the Bureau) to require reports from and conduct examinations for compliance with Federal consumer financial laws with respect to a person described in section 5516(a) of this title , except as provided to the Bureau under subsections (b) and (c) of section 5516 of this title ." ;
  fro-usc:hasId "id83afe9cc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/c/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5516" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5516/a" ;
.
fro-usc-t12-ch53:id83afe9cd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-4-3> ;
  fro-usc:hasHeading "Enforcement" ;
  fro-usc:hasId "id83afe9cd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9ce-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9cf-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9d0-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe9ce-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-4-3-2> ;
  fro-usc:hasContentText "The authority of a transferor agency that is a prudential regulator to enforce compliance with Federal consumer financial laws with respect to a person described in section 5515(a) of this title , shall be limited to the backup and enforcement procedures in  2 described in section 5515(c) of this title ." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id83afe9ce-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5515/a" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5515/c" ;
.
fro-usc-t12-ch53:id83afe9cf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-4-3-3> ;
  fro-usc:hasContentText "A transferor agency that is a prudential regulator shall have exclusive authority (relative to the Bureau) to enforce compliance with Federal consumer financial laws with respect to a person described in section 5516(a) of this title , except as provided to the Bureau under subsections (b) and (c) of section 5516 of this title ." ;
  fro-usc:hasHeading "Exclusive authority" ;
  fro-usc:hasId "id83afe9cf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5516" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5516/a" ;
.
fro-usc-t12-ch53:id83afe9d0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-4-3-4> ;
  fro-usc:hasHeading "Statutory enforcement" ;
  fro-usc:hasId "id83afe9d0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/c/2/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-2-4-3-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9d1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9d2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9d3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe9d1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-4-3-4-3> ;
  fro-usc:hasContentText "the Federal Credit Union Act ( 12 U.S.C. 1751 et seq.), by the National Credit Union Administration Board with respect to any covered person or service provider that is an insured credit union, or service provider thereto, or any affiliate of an insured credit union, who is subject to the jurisdiction of the Board under that Act; and" ;
  fro-usc:hasId "id83afe9d1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/c/2/C/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1751" ;
.
fro-usc-t12-ch53:id83afe9d2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-4-3-4-4> ;
  fro-usc:hasContentText "section 1818 of this title , by the appropriate Federal banking agency, as defined in section 1813(q) of this title , with respect to a covered person or service provider that is a person described in section 1813(q) of this title and who is subject to the jurisdiction of that agency, as set forth in sections 1813(q) and 1818 of this title; or" ;
  fro-usc:hasId "id83afe9d2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/c/2/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813/q" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1818" ;
.
fro-usc-t12-ch53:id83afe9d3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-4-3-4-5> ;
  fro-usc:hasContentText "the Bank Service Company Act ( 12 U.S.C. 1861 et seq.)." ;
  fro-usc:hasId "id83afe9d3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/c/2/C/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1861" ;
.
fro-usc-t12-ch53:id83afe9d4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-5> ;
  fro-usc:hasContentText "Subsections (b) and (c) shall become effective on the designated transfer date." ;
  fro-usc:hasHeading "Effective date" ;
  fro-usc:hasId "id83afe9d4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83afe9d5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
