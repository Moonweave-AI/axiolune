  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-3> ;
  fro-usc:hasHeading "Administrative expenses of the receiver" ;
  fro-usc:hasId "id83981b70-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-2-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b71-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b72-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b71-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-3-3> ;
  fro-usc:hasContentText "the actual, necessary costs and expenses incurred by the Corporation as receiver for a covered financial company in liquidating a covered financial company; and" ;
  fro-usc:hasId "id83981b71-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981b72-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-3-4> ;
  fro-usc:hasContentText "any obligations that the Corporation as receiver for a covered financial company determines are necessary and appropriate to facilitate the smooth and orderly liquidation of the covered financial company." ;
  fro-usc:hasId "id83981b72-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981b73-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-4> ;
  fro-usc:hasContentText "The term “Bankruptcy Code” means title 11." ;
  fro-usc:hasHeading "Bankruptcy Code" ;
  fro-usc:hasId "id83981b73-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83981b74-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-5> ;
  fro-usc:hasContentText "The term “bridge financial company” means a new financial company organized by the Corporation in accordance with section 5390(h) of this title for the purpose of resolving a covered financial company." ;
  fro-usc:hasHeading "Bridge financial company" ;
  fro-usc:hasId "id83981b74-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/h" ;
.
fro-usc-t12-ch53:id83981b75-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-6> ;
  fro-usc:hasContentText "The term “claim” means any right to payment, whether or not such right is reduced to judgment, liquidated, unliquidated, fixed, contingent, matured, unmatured, disputed, undisputed, legal, equitable, secured, or unsecured." ;
  fro-usc:hasHeading "Claim" ;
  fro-usc:hasId "id83981b75-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83981b76-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-7> ;
  fro-usc:hasContentText "The term “company” has the same meaning as in section 1841(b) of this title , except that such term includes any company described in paragraph (11), the majority of the securities of which are owned by the United States or any State." ;
  fro-usc:hasHeading "Company" ;
  fro-usc:hasId "id83981b76-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841/b" ;
.
fro-usc-t12-ch53:id83981b77-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-8> ;
  fro-usc:hasContentText "The term “Court” means the United States District Court for the District of Columbia, unless the context otherwise requires." ;
  fro-usc:hasHeading "Court" ;
  fro-usc:hasId "id83981b77-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id83981b78-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-9> ;
  fro-usc:hasHeading "Covered broker or dealer" ;
  fro-usc:hasId "id83981b78-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/7" ;
  fro-usc:hasNumberText "(7)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-2-2-9-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b79-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b7a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b79-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-9-3> ;
  fro-usc:hasContentText "is registered with the Commission under section 78 o (b) of title 15; and" ;
  fro-usc:hasId "id83981b79-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/7/A" ;
  fro-usc:hasNumberText "(A)" ;
.
