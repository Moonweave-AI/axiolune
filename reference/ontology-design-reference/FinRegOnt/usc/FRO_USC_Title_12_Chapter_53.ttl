  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-4-2> ;
  fro-usc:hasContentText "The Director shall establish within the Bureau the Office of Fair Lending and Equal Opportunity." ;
  fro-usc:hasHeading "Establishment" ;
