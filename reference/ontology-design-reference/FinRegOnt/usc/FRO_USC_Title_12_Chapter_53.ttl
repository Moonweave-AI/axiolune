  fro-usc:hasContentText "the enhanced vision benefits established under chapter 89B of title 5;" ;
  fro-usc:hasId "id83b25a8a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/2/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83b25a8b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-3-3-5> ;
  fro-usc:hasContentText "the Federal Employees Group Life Insurance Program established under chapter 87 of title 5, without regard to any requirement of insurability; and" ;
  fro-usc:hasId "id83b25a8b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/2/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83b25a8c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-3-3-6> ;
  fro-usc:hasContentText "the Federal Employees Health Benefits Program established under chapter 89 of title 5." ;
  fro-usc:hasId "id83b25a8c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/2/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id83b25a8d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-3-4> ;
  fro-usc:hasContentText "If, at the end of the 1-year period beginning on the designated transfer date, the Bureau has not established its own, or arranged for participation in another entity’s, long term care insurance program, an employee transferred pursuant to this part who was a member of such a program at the agency or Federal reserve bank from which the employee transferred may, before the coverage of that employee ends under subparagraph (A)(i), elect to apply for coverage under the Federal Long Term Care Insurance Program established under chapter 90 of title 5, under the underwriting requirements applicable to a new active workforce member (as defined in part 875 of title 5, Code of Federal Regulations)." ;
  fro-usc:hasHeading "Long term care insurance after 1st year" ;
  fro-usc:hasId "id83b25a8d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83b25a8e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-3-5> ;
  fro-usc:hasContentText "An individual enrolled in the Federal Employees Health Benefits program shall pay any employee contribution required by the plan." ;
  fro-usc:hasHeading "Employee contribution" ;
  fro-usc:hasId "id83b25a8e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83b25a8f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-3-6> ;
  fro-usc:hasContentText "The Bureau shall transfer to the Federal Employees Health Benefits Fund established under section 8909 of title 5 an amount determined by the Director of the Office of Personnel Management, after consultation with the Bureau and the Office of Management and Budget, to be necessary to reimburse the Fund for the cost to the Fund of providing benefits under this paragraph." ;
  fro-usc:hasHeading "Additional funding" ;
  fro-usc:hasId "id83b25a8f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/2/E" ;
  fro-usc:hasNumberText "(E)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s8909" ;
.
fro-usc-t12-ch53:id83b25a90-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-3-7> ;
  fro-usc:hasContentText "For employees transferred under this title, enrollment in a health benefits plan administered by a transferor agency or a Federal reserve bank, as the case may be, immediately before enrollment in a health benefits plan under chapter 89 of title 5 shall be considered as enrollment in a health benefits plan under that chapter for purposes of section 8905(b)(1)(A) of title 5 ." ;
  fro-usc:hasHeading "Credit for time enrolled in other plans" ;
  fro-usc:hasId "id83b25a90-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/2/F" ;
  fro-usc:hasNumberText "(F)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s8905/b/1/A" ;
.
fro-usc-t12-ch53:id83b25a91-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-3-8> ;
  fro-usc:hasHeading "Special provisions to ensure continuation of life insurance benefits" ;
  fro-usc:hasId "id83b25a91-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/2/G" ;
  fro-usc:hasNumberText "(G)" ;
