  fro-usc:hasContentText "whether the company owns an insured depository institution;" ;
  fro-usc:hasId "id83936127-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/b/3/A/ii" ;
