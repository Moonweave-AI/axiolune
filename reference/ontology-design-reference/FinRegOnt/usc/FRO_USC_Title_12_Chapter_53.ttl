.
fro-usc-t12-ch53:id839cd714-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-11-3-2-3> ;
  fro-usc:hasContentText "until 5:00 p.m. (eastern time) on the business day following the date of the appointment; or" ;
  fro-usc:hasId "id839cd714-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/10/B/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd715-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-11-3-2-4> ;
  fro-usc:hasContentText "after the person has received notice that the contract has been transferred pursuant to paragraph (9)(A)." ;
  fro-usc:hasId "id839cd715-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/10/B/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd716-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-11-3-3> ;
  fro-usc:hasHeading "Notice" ;
  fro-usc:hasId "id839cd716-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/10/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd717-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-11-4> ;
  fro-usc:hasContentText "For purposes of paragraph (9), a bridge financial company shall not be considered to be a financial institution for which a conservator, receiver, trustee in bankruptcy, or other legal custodian has been appointed, or which is otherwise the subject of a bankruptcy or insolvency proceeding." ;
  fro-usc:hasHeading "Treatment of bridge financial company" ;
  fro-usc:hasId "id839cd717-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/10/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839cd718-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-11-5> ;
  fro-usc:hasContentText "For purposes of this paragraph, the term “business day” means any day other than any Saturday, Sunday, or any day on which either the New York Stock Exchange or the Federal Reserve Bank of New York is closed." ;
  fro-usc:hasHeading "Business day defined" ;
  fro-usc:hasId "id839cd718-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/10/D" ;
  fro-usc:hasNumberText "(D)" ;
.
