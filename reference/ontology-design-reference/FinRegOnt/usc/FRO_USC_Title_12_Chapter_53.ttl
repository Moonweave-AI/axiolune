  fro-usc:hasContentText "performing applied research and essential long-term research;" ;
  fro-usc:hasId "id8395aad4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/a/3" ;
