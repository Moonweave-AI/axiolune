fro-usc-t12-ch53:id83981b1e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-9-4-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83981b1e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Part C, referred to in text, was in the original “subtitle C”, meaning subtitle C (§§ 161–176) of title I of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1420 , which is classified principally to this part. For complete classification of subtitle C to the Code, see Tables." ;
  fro-usc:hasNoteText "The effective date of this Act, referred to in text, is 1 day after July 21, 2010 , except as otherwise specifically provided in Pub. L. 111–203 , see section 4 of Pub. L. 111–203 , set out as an Effective Date note under section 5301 of this title ." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s4" ;
  fro-usc:hasReferenceText "/us/stat/124/1420" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b1f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83981b22-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-10> ;
  fro-usc:hasContentText "The Board of Governors shall take any action that the Board of Governors deems appropriate to avoid imposing requirements under this part that are duplicative of requirements applicable to bank holding companies and nonbank financial companies under other provisions of law." ;
  fro-usc:hasHeading "Avoiding duplication" ;
  fro-usc:hasId "id83981b1f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5369" ;
  fro-usc:hasNumberText "§ 5369." ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b20-1df7-11e6-87ee-8e4a3ab90f2a ;
.
