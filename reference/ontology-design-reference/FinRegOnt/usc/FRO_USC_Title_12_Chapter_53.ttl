  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-2-2-2-5> ;
  fro-usc:hasHeading "Issuance of order" ;
  fro-usc:hasId "id83981b9f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/a/1/A/iv" ;
  fro-usc:hasNumberText "(iv)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-3-2-2-2-5-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ba0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ba1-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981ba0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-2-2-2-5-3> ;
  fro-usc:hasContentText "is not arbitrary and capricious, the Court shall issue an order immediately authorizing the Secretary to appoint the Corporation as receiver of the covered financial company; or" ;
  fro-usc:hasId "id83981ba0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/a/1/A/iv/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83981ba1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-2-2-2-5-4> ;
  fro-usc:hasContentText "is arbitrary and capricious, the Court shall immediately provide to the Secretary a written statement of each reason supporting its determination, and afford the Secretary an immediate opportunity to amend and refile the petition under clause (i)." ;
  fro-usc:hasId "id83981ba1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/a/1/A/iv/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83981ba2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-2-2-2-6> ;
  fro-usc:hasHeading "Petition granted by operation of law" ;
  fro-usc:hasId "id83981ba2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/a/1/A/v" ;
  fro-usc:hasNumberText "(v)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-3-2-2-2-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ba3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ba4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ba5-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981ba3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-2-2-2-6-3> ;
  fro-usc:hasContentText "the petition shall be granted by operation of law;" ;
  fro-usc:hasId "id83981ba3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/a/1/A/v/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83981ba4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-2-2-2-6-4> ;
  fro-usc:hasContentText "the Secretary shall appoint the Corporation as receiver; and" ;
  fro-usc:hasId "id83981ba4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/a/1/A/v/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83981ba5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-2-2-2-6-5> ;
  fro-usc:hasContentText "liquidation under this subchapter shall automatically and without further notice or action be commenced and the Corporation may immediately take all actions authorized under this subchapter." ;
  fro-usc:hasId "id83981ba5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/a/1/A/v/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id83981ba6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-2-2-3> ;
  fro-usc:hasContentText "The determination of the Court under subparagraph (A) shall be final, and shall be subject to appeal only in accordance with paragraph (2). The decision shall not be subject to any stay or injunction pending appeal. Upon conclusion of its proceedings under subparagraph (A), the Court shall provide immediately for the record a written statement of each reason supporting the decision of the Court, and shall provide copies thereof to the Secretary and the covered financial company." ;
  fro-usc:hasHeading "Effect of determination" ;
  fro-usc:hasId "id83981ba6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981ba7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-2-2-4> ;
  fro-usc:hasContentText "A person who recklessly discloses a determination of the Secretary under section 5383(b) of this title or a petition of the Secretary under subparagraph (A), or the pendency of court proceedings as provided for under subparagraph (A), shall be fined not more than $250,000, or imprisoned for not more than 5 years, or both." ;
  fro-usc:hasHeading "Criminal penalties" ;
  fro-usc:hasId "id83981ba7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/a/1/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5383/b" ;
.
