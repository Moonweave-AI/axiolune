  fro-usc:hasContentText "relating to the functions of the Office of Thrift Supervision transferred under section 5412(b)(2)(C) of this title , shall be transferred to the Corporation on the transfer date; and" ;
  fro-usc:hasId "id83a40223-1df7-11e6-87ee-8e4a3ab90f2a" ;
