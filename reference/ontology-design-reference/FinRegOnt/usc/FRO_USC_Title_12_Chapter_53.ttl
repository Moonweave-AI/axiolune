  fro-usc:hasHeading "Office of Fair Lending and Equal Opportunity" ;
  fro-usc:hasId "id83a8bc8d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/c" ;
  fro-usc:hasNumberText "(c)" ;
.
