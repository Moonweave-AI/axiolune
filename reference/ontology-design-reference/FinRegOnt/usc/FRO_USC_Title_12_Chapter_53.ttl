.
fro-usc-t12-ch53:id83981b82-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-12> ;
  fro-usc:hasContentText "The terms “customer”, “customer name securities”, “customer property”, and “net equity” in the context of a covered broker or dealer, have the same meanings as in section 78 lll of title 15." ;
  fro-usc:hasHeading "Definitions relating to covered brokers and dealers" ;
  fro-usc:hasId "id83981b82-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/10" ;
  fro-usc:hasNumberText "(10)" ;
.
