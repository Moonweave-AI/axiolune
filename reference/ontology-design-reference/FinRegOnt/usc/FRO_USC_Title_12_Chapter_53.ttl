  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-3-3-3> ;
  fro-usc:hasContentText "give due regard to the principle of national treatment and equality of competitive opportunity; and" ;
  fro-usc:hasId "id8395ab8b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/b/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395ab8c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-3-3-4> ;
  fro-usc:hasContentText "take into account the extent to which the foreign financial company is subject on a consolidated basis to home country standards that are comparable to those applied to financial companies in the United States." ;
  fro-usc:hasId "id8395ab8c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
