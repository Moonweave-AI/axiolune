  lkif-mereo:component fro-usc-t12-ch53:id839f47ff-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47ec-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-3> ;
  fro-usc:hasContentText "economic conditions generally affecting financial companies so as to allow assessments to increase during more favorable economic conditions and to decrease during less favorable economic conditions;" ;
  fro-usc:hasId "id839f47ec-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f47ed-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-4> ;
  fro-usc:hasId "id839f47ed-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-16-5-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47ee-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47ef-1df7-11e6-87ee-8e4a3ab90f2a ;
