.
fro-usc-t12-ch53:id839360b1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-16-7-3> ;
  fro-usc:hasContentText "to promote market discipline; and" ;
  fro-usc:hasId "id839360b1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/N/vi/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839360b2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-16-7-4> ;
  fro-usc:hasContentText "to maintain investor confidence." ;
  fro-usc:hasId "id839360b2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/N/vi/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839360b3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360b4-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360b5-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-3> ;
  fro-usc:hasHeading "Statements by voting members of the Council" ;
  fro-usc:hasId "id839360b3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-3-3-2> ;
.
fro-usc-t12-ch53:id839360b4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-3-3> ;
  fro-usc:hasContentText "if such member believes that the Council, the Government, and the private sector are taking all reasonable steps to ensure financial stability and to mitigate systemic risk that would negatively affect the economy, submit a signed statement to Congress stating such belief; or" ;
  fro-usc:hasId "id839360b4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839360b5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-3-4> ;
  fro-usc:hasContentText "if such member does not believe that all reasonable steps described under paragraph (1) are being taken, submit a signed statement to Congress stating what actions such member believes need to be taken in order to ensure that all reasonable steps described under paragraph (1) are taken." ;
  fro-usc:hasId "id839360b5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
