  lkif-mereo:component fro-usc-t12-ch53:id83a8bcb9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bcb7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-6-2-3> ;
  fro-usc:hasContentText "educate and empower service members and their families to make better informed decisions regarding consumer financial products and services;" ;
  fro-usc:hasId "id83a8bcb7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/e/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a8bcb8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-6-2-4> ;
  fro-usc:hasContentText "coordinate with the unit of the Bureau established under subsection (b)(3), in order to monitor complaints by service members and their families and responses to those complaints by the Bureau or other appropriate Federal or State agency; and" ;
  fro-usc:hasId "id83a8bcb8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/e/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a8bcb9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-6-2-5> ;
  fro-usc:hasContentText "coordinate efforts among Federal and State agencies, as appropriate, regarding consumer protection measures relating to consumer financial products and services offered to, or used by, service members and their families." ;
  fro-usc:hasId "id83a8bcb9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/e/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a8bcba-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-6-3> ;
  fro-usc:hasHeading "Coordination" ;
  fro-usc:hasId "id83a8bcba-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/e/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bcbb-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bcbc-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bcbb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-6-3-2> ;
  fro-usc:hasContentText "The Director is authorized to assign employees of the Bureau as may be deemed necessary to conduct the business of the Office of Service Member Affairs, including by establishing and maintaining the functions of the Office in regional offices of the Bureau located near military bases, military treatment facilities, or other similar military facilities." ;
  fro-usc:hasHeading "Regional services" ;
  fro-usc:hasId "id83a8bcbb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/e/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a8bcbc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-6-3-3> ;
  fro-usc:hasContentText "The Director is authorized to enter into memoranda of understanding and similar agreements with the Department of Defense, including any branch or agency as authorized by the department, in order to carry out the business of the Office of Service Member Affairs." ;
  fro-usc:hasHeading "Agreements" ;
  fro-usc:hasId "id83a8bcbc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/e/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a8bcbd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-6-4> ;
  fro-usc:hasContentText "As used in this subsection, the term “service member” means any member of the United States Armed Forces and any member of the National Guard or Reserves." ;
  fro-usc:hasHeading "Definition" ;
  fro-usc:hasId "id83a8bcbd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a8bcbe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-7> ;
  fro-usc:hasContentText "The Office of Fair Lending and Equal Opportunity, the Office of Financial Education, and the Office of Service Member Affairs shall each be established not later than 1 year after the designated transfer date." ;
  fro-usc:hasHeading "Timing" ;
  fro-usc:hasId "id83a8bcbe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83a8bcbf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcc0-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcc1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcc2-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-8> ;
  fro-usc:hasHeading "Office of Financial Protection for Older Americans" ;
  fro-usc:hasId "id83a8bcbf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id83a8bcc0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-8-2> ;
  fro-usc:hasContentText "Before the end of the 180-day period beginning on the designated transfer date, the Director shall establish the Office of Financial Protection for Older Americans, the functions of which shall include activities designed to facilitate the financial literacy of individuals who have attained the age of 62 years or more (in this subsection, referred to as “seniors”) on protection from unfair, deceptive, and abusive practices and on current and future financial choices, including through the dissemination of materials to seniors on such topics." ;
  fro-usc:hasHeading "Establishment" ;
  fro-usc:hasId "id83a8bcc0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a8bcc1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-8-3> ;
  fro-usc:hasContentText "The Office of Financial Protection for Older Americans (in this subsection referred to as the “Office”) shall be headed by an assistant director." ;
  fro-usc:hasHeading "Assistant director" ;
  fro-usc:hasId "id83a8bcc1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a8bcc2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
