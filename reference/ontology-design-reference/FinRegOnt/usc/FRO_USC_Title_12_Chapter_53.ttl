  fro-usc:hasContentText "collecting data on behalf of the Council, and providing such data to the Council and member agencies;" ;
  fro-usc:hasId "id8395aad2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/a/1" ;
