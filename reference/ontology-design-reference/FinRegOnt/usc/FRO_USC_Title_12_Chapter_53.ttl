  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bce5-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7> ;
  fro-usc:hasHeading "Appearances before and reports to Congress" ;
  fro-usc:hasId "id83a8bce2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496" ;
  fro-usc:hasNumberText "§ 5496." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bcef-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bce3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-2> ;
  fro-usc:hasContentText "The Director of the Bureau shall appear before the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services and the Committee on Energy and Commerce of the House of Representatives at semi-annual hearings regarding the reports required under subsection (b)." ;
  fro-usc:hasHeading "Appearances before Congress" ;
  fro-usc:hasId "id83a8bce3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a8bce4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-3> ;
  fro-usc:hasContentText "The Bureau shall, concurrent with each semi-annual hearing referred to in subsection (a), prepare and submit to the President and to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services and the Committee on Energy and Commerce of the House of Representatives, a report, beginning with the session following the designated transfer date. The Bureau may also submit such report to the Committee on Commerce, Science, and Transportation of the Senate." ;
  fro-usc:hasHeading "Reports required" ;
  fro-usc:hasId "id83a8bce4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a8bce5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bce6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bce7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bce8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bce9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcea-1df7-11e6-87ee-8e4a3ab90f2a ;
