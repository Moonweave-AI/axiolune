  fro-usc:hasReferenceText "/us/stat/124/1985" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1023, July 21, 2010 , 124 Stat. 1985 .)" ;
.
fro-usc-t12-ch53:id83ab2da7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-4-9-0> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83ab2da7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section effective on the designated transfer date, see section 1029A of Pub. L. 111–203 , set out as a note under section 5511 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1029A" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5511" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id83a8bd32-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2da8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2da9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2db4-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2dca-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2dd6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2dd7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2dd8-1df7-11e6-87ee-8e4a3ab90f2a ;
