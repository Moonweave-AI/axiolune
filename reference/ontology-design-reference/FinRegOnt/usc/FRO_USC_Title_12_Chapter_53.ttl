  fro-usc:hasContentText "the operations related to the payment, clearing, and settlement activities of designated financial market utilities; and" ;
  fro-usc:hasId "id83a402fd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5464/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a402fe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-5-2-2-4> ;
  fro-usc:hasContentText "the conduct of designated activities by financial institutions." ;
  fro-usc:hasId "id83a402fe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5464/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
