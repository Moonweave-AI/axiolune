  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g/3/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-3-4-8-4-5-1> ;
