.
fro-usc-t12-ch53:id839f47c7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-9-2-3> ;
  fro-usc:hasContentText "the authorities of the Corporation contained in this subchapter shall not be used to assist the Deposit Insurance Fund or to assist any financial company under applicable law other than this Act;" ;
  fro-usc:hasId "id839f47c7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/8/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f47c8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-9-2-4> ;
  fro-usc:hasContentText "the authorities of the Corporation relating to the Deposit Insurance Fund, or any other responsibilities of the Corporation under applicable law other than this subchapter, shall not be used to assist a covered financial company pursuant to this subchapter; and" ;
  fro-usc:hasId "id839f47c8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/8/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f47c9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-9-2-5> ;
  fro-usc:hasContentText "the Deposit Insurance Fund may not be used in any manner to otherwise circumvent the purposes of this subchapter." ;
  fro-usc:hasId "id839f47c9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/8/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839f47ca-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-9-3> ;
  fro-usc:hasHeading "Valuation" ;
  fro-usc:hasId "id839f47ca-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/8/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-15-9-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47cb-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47cc-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47cb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-9-3-3> ;
  fro-usc:hasContentText "the Corporation shall include as an obligation any contingent liability of the Corporation pursuant to this subchapter; and" ;
  fro-usc:hasId "id839f47cb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/8/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f47cc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-9-3-4> ;
  fro-usc:hasContentText "the Corporation shall value any contingent liability at its expected cost to the Corporation." ;
  fro-usc:hasId "id839f47cc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/8/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f47cd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-10> ;
  fro-usc:hasHeading "Orderly liquidation and repayment plans" ;
  fro-usc:hasId "id839f47cd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/9" ;
  fro-usc:hasNumberText "(9)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47ce-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47cf-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47ce-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-10-2> ;
  fro-usc:hasContentText "Amounts in the Fund shall be available to the Corporation with regard to a covered financial company for which the Corporation is appointed receiver after the Corporation has developed an orderly liquidation plan that is acceptable to the Secretary with regard to such covered financial company, including the provision and use of funds, including taking any actions specified under section 5384(d) of this title and subsection (h)(2)(G)(iv) and (h)(9) of this section, and payments to third parties. The orderly liquidation plan shall take into account actions to avoid or mitigate potential adverse effects on low income, minority, or underserved communities affected by the failure of the covered financial company, and shall provide for coordination with the primary financial regulatory agencies, as appropriate, to ensure that such actions are taken. The Corporation may, at any time, amend any orderly liquidation plan approved by the Secretary with the concurrence of the Secretary." ;
  fro-usc:hasHeading "Orderly liquidation plan" ;
  fro-usc:hasId "id839f47ce-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/9/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5384/d" ;
.
fro-usc-t12-ch53:id839f47cf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-10-3> ;
  fro-usc:hasHeading "Mandatory repayment plan" ;
  fro-usc:hasId "id839f47cf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/9/B" ;
  fro-usc:hasNumberText "(B)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47d0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47d3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47d0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-10-3-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f47d0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/9/B/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-15-10-3-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47d1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47d2-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47d1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-10-3-2-3> ;
  fro-usc:hasContentText "provides a specific plan and schedule to achieve the repayment of the outstanding amount of any borrowing under paragraph (5); and" ;
  fro-usc:hasId "id839f47d1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/9/B/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839f47d2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-10-3-2-4> ;
  fro-usc:hasContentText "demonstrates that income to the Corporation from the liquidated assets of the covered financial company and assessments under subsection ( o ) will be sufficient to amortize the outstanding balance within the period established in the repayment schedule and pay the interest accruing on such balance within the time provided in subsection ( o )(1)(B)." ;
  fro-usc:hasId "id839f47d2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/9/B/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839f47d3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-10-3-3> ;
  fro-usc:hasHeading "Consultation with and report to Congress" ;
  fro-usc:hasId "id839f47d3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/9/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-15-10-3-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47d4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47d5-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47d4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-10-3-3-3> ;
  fro-usc:hasContentText "consult with the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives on the terms of any repayment schedule agreement; and" ;
  fro-usc:hasId "id839f47d4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/9/B/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839f47d5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-10-3-3-4> ;
  fro-usc:hasContentText "submit a copy of the repayment schedule agreement to the Committees described in subclause (I) before the end of the 30-day period beginning on the date on which any amount is provided by the Secretary to the Corporation under paragraph (5)." ;
  fro-usc:hasId "id839f47d5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/9/B/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839f47d6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-11> ;
  fro-usc:hasHeading "Implementation expenses" ;
  fro-usc:hasId "id839f47d6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/10" ;
  fro-usc:hasNumberText "(10)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47d7-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47d8-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47d9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47d7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-11-2> ;
  fro-usc:hasContentText "Reasonable implementation expenses of the Corporation incurred after July 21, 2010 , shall be treated as expenses of the Council." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f47d7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/10/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f47d8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-11-3> ;
  fro-usc:hasContentText "The Corporation shall periodically submit a request for reimbursement for implementation expenses to the Chairperson of the Council, who shall arrange for prompt reimbursement to the Corporation of reasonable implementation expenses." ;
  fro-usc:hasHeading "Requests for reimbursement" ;
  fro-usc:hasId "id839f47d8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/10/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f47d9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-11-4> ;
  fro-usc:hasHeading "Definition" ;
  fro-usc:hasId "id839f47d9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/10/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-15-11-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47da-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47db-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47da-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-11-4-3> ;
  fro-usc:hasContentText "means costs incurred by the Corporation beginning on July 21, 2010 , as part of its efforts to implement this subchapter that do not relate to a particular covered financial company; and" ;
  fro-usc:hasId "id839f47da-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/10/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f47db-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-11-4-4> ;
  fro-usc:hasContentText "includes the costs incurred in connection with the development of policies, procedures, rules, and regulations and other planning activities of the Corporation consistent with carrying out this subchapter." ;
  fro-usc:hasId "id839f47db-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/10/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
