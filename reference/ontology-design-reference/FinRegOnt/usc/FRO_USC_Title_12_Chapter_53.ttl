  fro-usc:hasContentText "a covered broker or dealer." ;
  fro-usc:hasId "id83981b81-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/9/C" ;
