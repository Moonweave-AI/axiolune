.
fro-usc-t12-ch53:id83afe910-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-2-3> ;
  fro-usc:hasContentText "the provisions of this title, 1 including any rules prescribed by the Bureau under this title;  1 and" ;
  fro-usc:hasId "id83afe910-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afe911-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-2-4> ;
  fro-usc:hasContentText "any other Federal law that the Bureau is authorized to enforce, including an enumerated consumer law, and any regulations or order prescribed thereunder, unless such Federal law specifically limits the Bureau from conducting a hearing or adjudication proceeding and only to the extent of such limitation." ;
  fro-usc:hasId "id83afe911-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83afe912-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe913-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe918-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe919-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe91a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe91b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-3> ;
  fro-usc:hasHeading "Special rules for cease-and-desist proceedings" ;
  fro-usc:hasId "id83afe912-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83afe913-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-3-2> ;
  fro-usc:hasHeading "Orders authorized" ;
  fro-usc:hasId "id83afe913-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/b/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe914-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe915-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe916-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe917-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe914-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-3-2-2> ;
  fro-usc:hasContentText "If, in the opinion of the Bureau, any covered person or service provider is engaging or has engaged in an activity that violates a law, rule, or any condition imposed in writing on the person by the Bureau, the Bureau may, subject to sections 5514, 5515, and 5516 of this title, issue and serve upon the covered person or service provider a notice of charges in respect thereof." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe914-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/b/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83afe915-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-3-2-3> ;
  fro-usc:hasContentText "The notice under subparagraph (A) shall contain a statement of the facts constituting the alleged violation or violations, and shall fix a time and place at which a hearing will be held to determine whether an order to cease and desist should issue against the covered person or service provider, such hearing to be held not earlier than 30 days nor later than 60 days after the date of service of such notice, unless an earlier or a later date is set by the Bureau, at the request of any party so served." ;
  fro-usc:hasHeading "Content of notice" ;
  fro-usc:hasId "id83afe915-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/b/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83afe916-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-3-2-4> ;
  fro-usc:hasContentText "Unless the party or parties served under subparagraph (B) appear at the hearing personally or by a duly authorized representative, such person shall be deemed to have consented to the issuance of the cease-and-desist order." ;
  fro-usc:hasHeading "Consent" ;
  fro-usc:hasId "id83afe916-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/b/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83afe917-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-3-2-5> ;
  fro-usc:hasContentText "In the event of consent under subparagraph (C), or if, upon the record, made at any such hearing, the Bureau finds that any violation specified in the notice of charges has been established, the Bureau may issue and serve upon the covered person or service provider an order to cease and desist from the violation or practice. Such order may, by provisions which may be mandatory or otherwise, require the covered person or service provider to cease and desist from the subject activity, and to take affirmative action to correct the conditions resulting from any such violation." ;
  fro-usc:hasHeading "Procedure" ;
  fro-usc:hasId "id83afe917-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/b/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83afe918-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-3-3> ;
  fro-usc:hasContentText "A cease-and-desist order shall become effective at the expiration of 30 days after the date of service of an order under paragraph (1) upon the covered person or service provider concerned (except in the case of a cease-and-desist order issued upon consent, which shall become effective at the time specified therein), and shall remain effective and enforceable as provided therein, except to such extent as the order is stayed, modified, terminated, or set aside by action of the Bureau or a reviewing court." ;
  fro-usc:hasHeading "Effectiveness of order" ;
  fro-usc:hasId "id83afe918-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83afe919-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-3-4> ;
  fro-usc:hasContentText "Any hearing provided for in this subsection shall be held in the Federal judicial district or in the territory in which the residence or principal office or place of business of the person is located unless the person consents to another place, and shall be conducted in accordance with the provisions of chapter 5 of title 5. After such hearing, and within 90 days after the Bureau has notified the parties that the case has been submitted to the Bureau for final decision, the Bureau shall render its decision (which shall include findings of fact upon which its decision is predicated) and shall issue and serve upon each party to the proceeding an order or orders consistent with the provisions of this section. Judicial review of any such order shall be exclusively as provided in this subsection. Unless a petition for review is timely filed in a court of appeals of the United States, as provided in paragraph (4), and thereafter until the record in the proceeding has been filed as provided in paragraph (4), the Bureau may at any time, upon such notice and in such manner as the Bureau shall determine proper, modify, terminate, or set aside any such order. Upon filing of the record as provided, the Bureau may modify, terminate, or set aside any such order with permission of the court." ;
  fro-usc:hasHeading "Decision and appeal" ;
  fro-usc:hasId "id83afe919-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83afe91a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-3-5> ;
  fro-usc:hasContentText "Any party to any proceeding under this subsection may obtain a review of any order served pursuant to this subsection (other than an order issued with the consent of the person concerned) by the filing in the court of appeals of the United States for the circuit in which the principal office of the covered person is located, or in the United States Court of Appeals for the District of Columbia Circuit, within 30 days after the date of service of such order, a written petition praying that the order of the Bureau be modified, terminated, or set aside. A copy of such petition shall be forthwith transmitted by the clerk of the court to the Bureau, and thereupon the Bureau shall file in the court the record in the proceeding, as provided in section 2112 of title 28 . Upon the filing of such petition, such court shall have jurisdiction, which upon the filing of the record shall except as provided in the last sentence of paragraph (3) be exclusive, to affirm, modify, terminate, or set aside, in whole or in part, the order of the Bureau. Review of such proceedings shall be had as provided in chapter 7 of title 5. The judgment and decree of the court shall be final, except that the same shall be subject to review by the Supreme Court of the United States, upon certiorari, as provided in section 1254 of title 28 ." ;
  fro-usc:hasHeading "Appeal to court of appeals" ;
  fro-usc:hasId "id83afe91a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/b/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t28/s1254" ;
  fro-usc:hasReferenceText "/us/usc/t28/s2112" ;
.
fro-usc-t12-ch53:id83afe91b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-3-6> ;
  fro-usc:hasContentText "The commencement of proceedings for judicial review under paragraph (4) shall not, unless specifically ordered by the court, operate as a stay of any order issued by the Bureau." ;
  fro-usc:hasHeading "No stay" ;
  fro-usc:hasId "id83afe91b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83afe91c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe91d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe91e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe91f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4> ;
  fro-usc:hasHeading "Special rules for temporary cease-and-desist proceedings" ;
  fro-usc:hasId "id83afe91c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83afe91d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-2> ;
  fro-usc:hasContentText "Whenever the Bureau determines that the violation specified in the notice of charges served upon a person, including a service provider, pursuant to subsection (b), or the continuation thereof, is likely to cause the person to be insolvent or otherwise prejudice the interests of consumers before the completion of the proceedings conducted pursuant to subsection (b), the Bureau may issue a temporary order requiring the person to cease and desist from any such violation or practice and to take affirmative action to prevent or remedy such insolvency or other condition pending completion of such proceedings. Such order may include any requirement authorized under this part. Such order shall become effective upon service upon the person and, unless set aside, limited, or suspended by a court in proceedings authorized by paragraph (2), shall remain effective and enforceable pending the completion of the administrative proceedings pursuant to such notice and until such time as the Bureau shall dismiss the charges specified in such notice, or if a cease-and-desist order is issued against the person, until the effective date of such order." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe91d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afe91e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-3> ;
  fro-usc:hasContentText "Not later than 10 days after the covered person or service provider concerned has been served with a temporary cease-and-desist order, the person may apply to the United States district court for the judicial district in which the residence or principal office or place of business of the person is located, or the United States District Court for the District of Columbia, for an injunction setting aside, limiting, or suspending the enforcement, operation, or effectiveness of such order pending the completion of the administrative proceedings pursuant to the notice of charges served upon the person under subsection (b), and such court shall have jurisdiction to issue such injunction." ;
  fro-usc:hasHeading "Appeal" ;
  fro-usc:hasId "id83afe91e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83afe91f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-4> ;
  fro-usc:hasHeading "Incomplete or inaccurate records" ;
  fro-usc:hasId "id83afe91f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe920-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe923-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe920-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-4-2> ;
  fro-usc:hasHeading "Temporary order" ;
  fro-usc:hasId "id83afe920-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-7-4-4-4-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe921-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe922-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe921-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-4-2-3> ;
  fro-usc:hasContentText "the cessation of any activity or practice which gave rise, whether in whole or in part, to the incomplete or inaccurate state of the books or records; or" ;
  fro-usc:hasId "id83afe921-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/3/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83afe922-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-4-2-4> ;
  fro-usc:hasContentText "affirmative action to restore such books or records to a complete and accurate state, until the completion of the proceedings under subsection (b)(1)." ;
  fro-usc:hasId "id83afe922-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/3/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83afe923-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-4-3> ;
  fro-usc:hasHeading "Effective period" ;
  fro-usc:hasId "id83afe923-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-7-4-4-4-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe924-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe925-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe924-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-4-3-3> ;
  fro-usc:hasContentText "shall become effective upon service; and" ;
  fro-usc:hasId "id83afe924-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/3/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83afe925-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-4-3-4> ;
  fro-usc:hasId "id83afe925-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/3/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-7-4-4-4-3-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe926-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe927-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe926-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-4-3-4-2> ;
  fro-usc:hasContentText "the completion of the proceeding initiated under subsection (b) in connection with the notice of charges; or" ;
  fro-usc:hasId "id83afe926-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/3/B/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83afe927-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-4-4-3-4-3> ;
  fro-usc:hasContentText "the date the Bureau determines, by examination or otherwise, that the books and records of the covered person or service provider are accurate and reflect the financial condition thereof." ;
  fro-usc:hasId "id83afe927-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/c/3/B/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83afe928-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe929-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe92a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-5> ;
  fro-usc:hasHeading "Special rules for enforcement of orders" ;
  fro-usc:hasId "id83afe928-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83afe929-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-5-2> ;
  fro-usc:hasContentText "The Bureau may in its discretion apply to the United States district court within the jurisdiction of which the principal office or place of business of the person is located, for the enforcement of any effective and outstanding notice or order issued under this section, and such court shall have jurisdiction and power to order and require compliance herewith." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe929-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afe92a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-5-3> ;
  fro-usc:hasContentText "Except as otherwise provided in this subsection, no court shall have jurisdiction to affect by injunction or otherwise the issuance or enforcement of any notice or order or to review, modify, suspend, terminate, or set aside any such notice or order." ;
  fro-usc:hasHeading "Exception" ;
  fro-usc:hasId "id83afe92a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83afe92b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-6> ;
  fro-usc:hasContentText "The Bureau shall prescribe rules establishing such procedures as may be necessary to carry out this section." ;
  fro-usc:hasHeading "Rules" ;
  fro-usc:hasId "id83afe92b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5563/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83afe92c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-usc:hasId "id83afe92c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/stat/124/2025" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1053, July 21, 2010 , 124 Stat. 2025 .)" ;
.
fro-usc-t12-ch53:id83afe92e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-8-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83afe92e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This title, referred to in subsec. (a)(1), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe92f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-4-8-1> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83afe92f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section effective on the designated transfer date, see section 1058 of Pub. L. 111–203 , set out as a note under section 5561 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1058" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5561" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id83ad78ae-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe930-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe931-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe932-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe933-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe934-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe93a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe93b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe93c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83afe944-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83afe945-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5> ;
  fro-usc:hasHeading "Litigation authority" ;
  fro-usc:hasId "id83afe930-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564" ;
  fro-usc:hasNumberText "§ 5564." ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe942-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe931-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-2> ;
  fro-usc:hasContentText "If any person violates a Federal consumer financial law, the Bureau may, subject to sections 5514, 5515, and 5516 of this title, commence a civil action against such person to impose a civil penalty or to seek all appropriate legal and equitable relief including a permanent or temporary injunction as permitted by law." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe931-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83afe932-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-3> ;
  fro-usc:hasContentText "The Bureau may act in its own name and through its own attorneys in enforcing any provision of this title, 1 rules thereunder, or any other law or regulation, or in any action, suit, or proceeding to which the Bureau is a party." ;
  fro-usc:hasHeading "Representation" ;
  fro-usc:hasId "id83afe932-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83afe933-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-4> ;
  fro-usc:hasContentText "The Bureau may compromise or settle any action if such compromise is approved by the court." ;
  fro-usc:hasHeading "Compromise of actions" ;
  fro-usc:hasId "id83afe933-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83afe934-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe935-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe936-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-5> ;
  fro-usc:hasHeading "Notice to the Attorney General" ;
  fro-usc:hasId "id83afe934-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83afe935-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-5-2> ;
  fro-usc:hasContentText "When commencing a civil action under Federal consumer financial law, or any rule thereunder, the Bureau shall notify the Attorney General and, with respect to a civil action against an insured depository institution or insured credit union, the appropriate prudential regulator." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe935-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afe936-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-5-3> ;
  fro-usc:hasHeading "Notice and coordination" ;
  fro-usc:hasId "id83afe936-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/d/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe937-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe938-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe939-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe937-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-5-3-2> ;
  fro-usc:hasContentText "In addition to any notice required under paragraph (1), the Bureau shall notify the Attorney General concerning any action, suit, or proceeding to which the Bureau is a party, except an action, suit, or proceeding that involves the offering or provision of consumer financial products or services." ;
  fro-usc:hasHeading "Notice of other actions" ;
  fro-usc:hasId "id83afe937-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/d/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83afe938-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-5-3-3> ;
  fro-usc:hasContentText "In order to avoid conflicts and promote consistency regarding litigation of matters under Federal law, the Attorney General and the Bureau shall consult regarding the coordination of investigations and proceedings, including by negotiating an agreement for coordination by not later than 180 days after the designated transfer date. The agreement under this subparagraph shall include provisions to ensure that parallel investigations and proceedings involving the Federal consumer financial laws are conducted in a manner that avoids conflicts and does not impede the ability of the Attorney General to prosecute violations of Federal criminal laws." ;
  fro-usc:hasHeading "Coordination" ;
  fro-usc:hasId "id83afe938-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/d/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83afe939-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-5-3-4> ;
  fro-usc:hasContentText "Nothing in this paragraph shall be construed to limit the authority of the Bureau under this title, including the authority to interpret Federal consumer financial law." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83afe939-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/d/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83afe93a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-6> ;
  fro-usc:hasContentText "The Bureau may represent itself in its own name before the Supreme Court of the United States, provided that the Bureau makes a written request to the Attorney General within the 10-day period which begins on the date of entry of the judgment which would permit any party to file a petition for writ of certiorari, and the Attorney General concurs with such request or fails to take action within 60 days of the request of the Bureau." ;
  fro-usc:hasHeading "Appearance before the Supreme Court" ;
  fro-usc:hasId "id83afe93a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83afe93b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-7> ;
  fro-usc:hasContentText "Any civil action brought under this title  may be brought in a United States district court or in any court of competent jurisdiction of a state in a district in which the defendant is located or resides or is doing business, and such court shall have jurisdiction to enjoin such person and to require compliance with any Federal consumer financial law." ;
  fro-usc:hasHeading "Forum" ;
  fro-usc:hasId "id83afe93b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83afe93c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe93d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe93e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-8> ;
  fro-usc:hasHeading "Time for bringing action" ;
  fro-usc:hasId "id83afe93c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id83afe93d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-8-2> ;
  fro-usc:hasContentText "Except as otherwise permitted by law or equity, no action may be brought under this title  more than 3 years after the date of discovery of the violation to which an action relates." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe93d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/g/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afe93e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-8-3> ;
  fro-usc:hasHeading "Limitations under other Federal laws" ;
  fro-usc:hasId "id83afe93e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/g/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe93f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe940-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe941-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe93f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-8-3-2> ;
  fro-usc:hasContentText "An action arising under this title  does not include claims arising solely under enumerated consumer laws." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe93f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/g/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83afe940-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-8-3-3> ;
  fro-usc:hasContentText "In any action arising solely under an enumerated consumer law, the Bureau may commence, defend, or intervene in the action in accordance with the requirements of that provision of law, as applicable." ;
  fro-usc:hasHeading "Bureau authority" ;
  fro-usc:hasId "id83afe940-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/g/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83afe941-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-8-3-4> ;
  fro-usc:hasContentText "In any action arising solely under laws for which authorities were transferred under subtitles F and H, the Bureau may commence, defend, or intervene in the action in accordance with the requirements of that provision of law, as applicable." ;
  fro-usc:hasHeading "Transferred authority" ;
  fro-usc:hasId "id83afe941-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5564/g/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83afe942-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-usc:hasId "id83afe942-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/stat/124/2028" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1054, July 21, 2010 , 124 Stat. 2028 .)" ;
.
fro-usc-t12-ch53:id83afe944-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-10-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83afe944-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Subtitle F, referred to in subsec. (g)(2)(C), is subtitle F (§§ 1061–1067) of title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 2035 , which is classified generally to part F (§ 5581 et seq.) of this subchapter. For complete classification of subtitle F to the Code, see Tables." ;
  fro-usc:hasNoteText "Subtitle H, referred to in subsec. (g)(2)(C), is subtitle H (§§ 1081–1100H) of title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 2080 . For complete classification of subtitle H to the Code, see Tables." ;
  fro-usc:hasNoteText "This title, referred to in subsecs. (b), (d)(2)(C), (f), and (g)(1), (2)(A), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/stat/124/2035" ;
  fro-usc:hasReferenceText "/us/stat/124/2080" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe945-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-5-10-1> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83afe945-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section effective on the designated transfer date, see section 1058 of Pub. L. 111–203 , set out as a note under section 5561 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1058" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5561" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id83ad78ae-1df7-11e6-87ee-8e4a3ab90f2a ;
.
