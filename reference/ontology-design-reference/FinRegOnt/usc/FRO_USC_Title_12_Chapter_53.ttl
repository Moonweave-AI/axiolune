fro-usc-t12-ch53:id83a1916e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-2-3-2-3> ;
  fro-usc:hasContentText "a written determination that commencement of the orderly process to implement this title  1 is not feasible by the date that is 1 year after July 21, 2010 ;" ;
  fro-usc:hasId "id83a1916e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5411/b/1/A" ;
