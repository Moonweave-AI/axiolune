.
fro-usc-t12-ch53:id83afe9bf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-7-5> ;
  fro-usc:hasContentText "To avoid duplication of or conflict between rules prescribed by the Bureau under section 5531 of this title and the Federal Trade Commission under section 18(a)(1)(B) of the Federal Trade Commission Act [ 15 U.S.C. 57a(a)(1)(B) ] that apply to a covered person or service provider with respect to the offering or provision of consumer financial products or services, the agencies shall negotiate an agreement with respect to rulemaking by each agency, including consultation with the other agency prior to proposing a rule and during the comment period." ;
  fro-usc:hasHeading "Coordination" ;
  fro-usc:hasId "id83afe9bf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/5/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5531" ;
  fro-usc:hasReferenceText "/us/usc/t15/s57a/a/1/B" ;
.
fro-usc-t12-ch53:id83afe9c0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-7-6> ;
  fro-usc:hasHeading "Deference" ;
  fro-usc:hasId "id83afe9c0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/5/E" ;
  fro-usc:hasNumberText "(E)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-2-3-7-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9c1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9c2-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe9c1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-7-6-3> ;
  fro-usc:hasContentText "Federal Trade Commission in making determinations regarding the meaning or interpretation of any provision of the Federal Trade Commission Act, or of any other Federal law for which the Commission has authority to prescribe rules; or" ;
  fro-usc:hasId "id83afe9c1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/5/E/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83afe9c2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-7-6-4> ;
  fro-usc:hasContentText "Bureau in making determinations regarding the meaning or interpretation of any provision of a Federal consumer financial law (other than any law described in clause (i))." ;
  fro-usc:hasId "id83afe9c2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/5/E/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83afe9c3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-8> ;
  fro-usc:hasHeading "National Credit Union Administration" ;
  fro-usc:hasId "id83afe9c3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/6" ;
  fro-usc:hasNumberText "(6)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9c4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9c5-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe9c4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-8-2> ;
  fro-usc:hasContentText "All consumer financial protection functions of the National Credit Union Administration are transferred to the Bureau." ;
  fro-usc:hasHeading "Transfer of functions" ;
  fro-usc:hasId "id83afe9c4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/6/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83afe9c5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-8-3> ;
  fro-usc:hasContentText "The Bureau shall have all powers and duties that were vested in the National Credit Union Administration, relating to consumer financial protection functions, on the day before the designated transfer date." ;
  fro-usc:hasHeading "National Credit Union Administration authority" ;
  fro-usc:hasId "id83afe9c5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83afe9c6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-9> ;
  fro-usc:hasHeading "Department of Housing and Urban Development" ;
  fro-usc:hasId "id83afe9c6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/7" ;
  fro-usc:hasNumberText "(7)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9c7-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe9c8-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe9c7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-9-2> ;
  fro-usc:hasContentText "All consumer protection functions of the Secretary of the Department of Housing and Urban Development relating to the Real Estate Settlement Procedures Act of 1974 ( 12 U.S.C. 2601 et seq.), the Secure and Fair Enforcement for Mortgage Licensing Act of 2008 ( 12 U.S.C. 5102 [5101] et seq.), and the Interstate Land Sales Full Disclosure Act ( 15 U.S.C. 1701 et seq.) are transferred to the Bureau." ;
  fro-usc:hasHeading "Transfer of functions" ;
  fro-usc:hasId "id83afe9c7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/7/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s2601" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5102" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1701" ;
.
fro-usc-t12-ch53:id83afe9c8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-9-3> ;
  fro-usc:hasContentText "The Bureau shall have all powers and duties that were vested in the Secretary of the Department of Housing and Urban Development relating to the Real Estate Settlement Procedures Act of 1974 ( 12 U.S.C. 2601 et seq.), the Secure and Fair Enforcement for Mortgage Licensing Act of 2008 ( 12 U.S.C. 5101 et seq.), and the Interstate Land Sales Full Disclosure Act ( 15 U.S.C. 1701 et seq.), on the day before the designated transfer date." ;
  fro-usc:hasHeading "Authority of the Department of Housing and Urban Development" ;
  fro-usc:hasId "id83afe9c8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/7/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s2601" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5101" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1701" ;
.
