.
fro-usc-t12-ch53:id8393612a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-3-4-4> ;
  fro-usc:hasContentText "to the extent possible, ensure that small changes in the factors listed in subsections (a) and (b) of section 5323 of this title would not result in sharp, discontinuous changes in the prudential standards established under section 5365 of this title ; and" ;
  fro-usc:hasId "id8393612a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/b/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5323" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5365" ;
.
fro-usc-t12-ch53:id8393612b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-3-4-5> ;
  fro-usc:hasContentText "adapt its recommendations as appropriate in light of any predominant line of business of such company, including assets under management or other activities for which particular standards may not be appropriate." ;
  fro-usc:hasId "id8393612b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/b/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
