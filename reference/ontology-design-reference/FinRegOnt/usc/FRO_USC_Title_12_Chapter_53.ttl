  fro-usc:hasContentText "to wind up the Office of Thrift Supervision; and" ;
  fro-usc:hasId "id83a4022e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5435/b/1/A" ;
