  lkif-mereo:component fro-usc-t12-ch53:id839a8bd5-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8bd3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-6-2-3-3> ;
  fro-usc:hasContentText "the effectiveness of chapter 7 or chapter 11 of the Bankruptcy Code in facilitating the orderly liquidation or reorganization of financial companies;" ;
  fro-usc:hasId "id839a8bd3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/e/1/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839a8bd4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-6-2-3-4> ;
  fro-usc:hasContentText "ways to maximize the efficiency and effectiveness of the Court; and" ;
  fro-usc:hasId "id839a8bd4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/e/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839a8bd5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-6-2-3-5> ;
  fro-usc:hasContentText "ways to make the orderly liquidation process under the Bankruptcy Code for financial companies more effective." ;
  fro-usc:hasId "id839a8bd5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/e/1/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839a8bd6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-6-3> ;
  fro-usc:hasContentText "Not later than 1 year after July 21, 2010 , in each successive year until the third year, and every fifth year after that date, the Administrative Office of the United States Courts and the Comptroller General of the United States shall submit to the Committee on Banking, Housing, and Urban Affairs and the Committee on the Judiciary of the Senate and the Committee on Financial Services and the Committee on the Judiciary of the House of Representatives separate reports summarizing the results of the studies conducted under paragraph (1)." ;
  fro-usc:hasHeading "Reports" ;
  fro-usc:hasId "id839a8bd6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
