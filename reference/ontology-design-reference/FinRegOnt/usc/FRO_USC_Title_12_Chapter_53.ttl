  fro-usc:hasReferenceText "/us/pl/111/203/tIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1523" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title III , § 313, July 21, 2010 , 124 Stat. 1523 .)" ;
.
