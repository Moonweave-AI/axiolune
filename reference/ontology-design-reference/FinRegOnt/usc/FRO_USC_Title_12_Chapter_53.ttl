  fro-usc:hasContentText "a credit union, as defined in section 101 of the Federal Credit Union Act ( 12 U.S.C. 1752 );  1" ;
  fro-usc:hasId "id83a402ae-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/5/A/iv" ;
