  lkif-mereo:component fro-usc-t12-ch53:id839cd67b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd67a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
