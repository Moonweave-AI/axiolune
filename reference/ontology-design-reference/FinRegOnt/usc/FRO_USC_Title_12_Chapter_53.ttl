  fro-usc:hasContentText "an investment company, as defined in section 80a–3 of title 15 ;" ;
  fro-usc:hasId "id83a402b0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/5/A/vi" ;
  fro-usc:hasNumberText "(vi)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3" ;
.
fro-usc-t12-ch53:id83a402b1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-7-2-9> ;
  fro-usc:hasContentText "an insurance company, as defined in section 80a–2 of title 15 ;" ;
  fro-usc:hasId "id83a402b1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/5/A/vii" ;
  fro-usc:hasNumberText "(vii)" ;
