  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-14-3-5> ;
  fro-usc:hasId "id83a1914a-1df7-11e6-87ee-8e4a3ab90f2a" ;
