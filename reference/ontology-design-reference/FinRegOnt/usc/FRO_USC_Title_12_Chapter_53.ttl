  fro-usc:hasContentText "a cost-benefit analysis of such certification;" ;
  fro-usc:hasId "id83a8bcb0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/d/7/A/i/IV" ;
  fro-usc:hasNumberText "(IV)" ;
.
fro-usc-t12-ch53:id83a8bcb1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-5-7-2-4> ;
  fro-usc:hasContentText "technological resources intended to collect, analyze, evaluate, or promote financial literacy and counseling programs;" ;
  fro-usc:hasId "id83a8bcb1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/d/7/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a8bcb2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-5-7-2-5> ;
  fro-usc:hasContentText "effective methods, tools, and strategies intended to educate and empower consumers about personal finance management; and" ;
  fro-usc:hasId "id83a8bcb2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/d/7/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83a8bcb3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-5-7-2-6> ;
  fro-usc:hasContentText "recommendations intended to encourage the development of programs that effectively improve financial education outcomes and empower consumers to make better informed financial decisions based on findings." ;
  fro-usc:hasId "id83a8bcb3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/d/7/A/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id83a8bcb4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-5-7-3> ;
  fro-usc:hasContentText "Not later than 1 year after July 21, 2010 , the Comptroller General of the United States shall submit a report on the results of the study conducted under this paragraph to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives." ;
  fro-usc:hasHeading "Report" ;
  fro-usc:hasId "id83a8bcb4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/d/7/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a8bcb5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcb6-1df7-11e6-87ee-8e4a3ab90f2a ;
