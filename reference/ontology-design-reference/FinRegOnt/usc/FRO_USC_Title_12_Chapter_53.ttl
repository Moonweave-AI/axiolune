  lkif-mereo:component fro-usc-t12-ch53:id83ad7861-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad785e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-1-2> ;
  fro-usc:hasContentText "to enjoin that practice;" ;
  fro-usc:hasId "id83ad785e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ad785f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-1-3> ;
  fro-usc:hasContentText "to enforce compliance with the rule;" ;
  fro-usc:hasId "id83ad785f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ad7860-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-1-4> ;
  fro-usc:hasContentText "to obtain damages, restitution, or other compensation on behalf of the residents of the State; or" ;
  fro-usc:hasId "id83ad7860-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ad7861-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-1-5> ;
  fro-usc:hasContentText "to obtain penalties and relief provided under the Consumer Financial Protection Act of 2010, the Federal Trade Commission Act [ 15 U.S.C. 41 et seq.], and such other relief as the court deems appropriate." ;
  fro-usc:hasId "id83ad7861-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/1/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s41" ;
.
fro-usc-t12-ch53:id83ad7862-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-2> ;
  fro-usc:hasContentText "The State shall serve written notice to the Bureau of Consumer Financial Protection or the Commission, as appropriate  1 of any civil action under paragraph (1) at least 60 days prior to initiating such civil action. The notice shall include a copy of the complaint to be filed to initiate such civil action, except that if it is not feasible for the State to provide such prior notice, the State shall provide notice immediately upon instituting such civil action." ;
  fro-usc:hasId "id83ad7862-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ad7863-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-3> ;
  fro-usc:hasId "id83ad7863-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-5-9-3-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7864-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7865-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7866-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad7864-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-3-2> ;
  fro-usc:hasContentText "be heard on all matters arising in such civil action;" ;
  fro-usc:hasId "id83ad7864-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ad7865-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-3-3> ;
  fro-usc:hasContentText "remove the action to the appropriate United States district court; and" ;
  fro-usc:hasId "id83ad7865-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ad7866-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-3-4> ;
  fro-usc:hasContentText "file petitions for appeal of a decision in such civil action." ;
  fro-usc:hasId "id83ad7866-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ad7867-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-4> ;
  fro-usc:hasContentText "Nothing in this subsection shall prevent the attorney general of a State from exercising the powers conferred on the attorney general by the laws of such State to conduct investigations or to administer oaths or affirmations or to compel the attendance of witnesses or the production of documentary and other evidence. Nothing in this section shall prohibit the attorney general of a State, or other authorized State officer, from proceeding in State or Federal court on the basis of an alleged violation of any civil or criminal statute of that State." ;
  fro-usc:hasId "id83ad7867-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83ad7868-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-5> ;
  fro-usc:hasId "id83ad7868-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-5-9-3-5-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7869-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad786a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad7869-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-5-2> ;
  fro-usc:hasContentText "the venue shall be a judicial district in which the defendant is found, is an inhabitant, or transacts business or wherever venue is proper under section 1391 of title 28 ; and" ;
  fro-usc:hasId "id83ad7869-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/5/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t28/s1391" ;
.
fro-usc-t12-ch53:id83ad786a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-5-3> ;
  fro-usc:hasContentText "process may be served without regard to the territorial limits of the district or of the State in which the civil action is instituted." ;
  fro-usc:hasId "id83ad786a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ad786b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-6> ;
  fro-usc:hasContentText "Whenever a civil action or an administrative action has been instituted by or on behalf of the Bureau of Consumer Financial Protection or the Commission for violation of any provision of law or rule described in paragraph (1), no State may, during the pendency of such action instituted by or on behalf of the Bureau of Consumer Financial Protection or the Commission, institute a civil action under that paragraph against any defendant named in the complaint in such action for violation of any law or rule as alleged in such complaint." ;
  fro-usc:hasId "id83ad786b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id83ad786c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-3-7> ;
  fro-usc:hasContentText "If the attorney general of a State prevails in any civil action under paragraph (1), the State can recover reasonable costs and attorney fees from the lender or related party." ;
  fro-usc:hasId "id83ad786c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5538/b/7" ;
  fro-usc:hasNumberText "(7)" ;
.
fro-usc-t12-ch53:id83ad786d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "id83ad786d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/pl/111/24/tV" ;
  fro-usc:hasReferenceText "/us/pl/111/8/dD/tVI" ;
  fro-usc:hasReferenceText "/us/stat/123/1763" ;
  fro-usc:hasReferenceText "/us/stat/123/678" ;
  fro-usc:hasReferenceText "/us/stat/124/2102" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–8, div. D, title VI , 123 Stat. 1763 ; Pub. L. 111–203, title X , § 1097, July 21, 2010 , 124 Stat. 2102 .) , § 626(a), (b), Mar. 11, 2009 , 123 Stat. 678 ; Pub. L. 111–24, title V , § 511(a), May 22, 2009" ;
.
fro-usc-t12-ch53:id83ad786f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83ad786f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Consumer Financial Protection Act of 2010, referred to in subsecs. (a) and (b)(1)(D), (3), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. Subtitle B of title X is classified generally to part B (§ 5511 et seq.) of this subchapter. For complete classification of this Act to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteText "The Federal Trade Commission Act, referred to in subsecs. (a)(3) and (b)(1)(D), is act Sept. 26, 1914, ch. 311 , 38 Stat. 717 , which is classified generally to subchapter I (§ 41 et seq.) of chapter 2 of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 58 of Title 15 and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1914-09-26/ch311" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/stat/38/717" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:hasReferenceText "/us/usc/t15/s58" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad7870-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-5-1> ;
  fro-usc:hasHeading "Codification" ;
  fro-usc:hasId "id83ad7870-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section was enacted as part of the Omnibus Appropriations Act, 2009, and not as part of subtitle C of title X of Pub. L. 111–203 , which comprises this part." ;
  fro-usc:hasNoteText "Section was formerly set out as a note under section 1638 of Title 15 , Commerce and Trade." ;
  fro-usc:hasNoteTopic "codification" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1638" ;
.
fro-usc-t12-ch53:id83ad7871-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-9-5-2> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "id83ad7871-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "2009—Subsec. (a). Pub. L. 111–24 , § 511(a), designated existing provisions as par. (1), inserted “Such rulemaking shall relate to unfair or deceptive acts or practices regarding mortgage loans, which may include unfair or deceptive acts or practices involving loan modification and foreclosure rescue services.”, and added pars. (2) to (4)." ;
  fro-usc:hasNoteText "2010—Subsec. (a). Pub. L. 111–203 , § 1097(1), added subsec. (a) and struck out former subsec. (a) which read as follows:" ;
  fro-usc:hasNoteText "Subsec. (b)(1). Pub. L. 111–203 , § 1097(2)(A), added par. (1) and struck out former par. (1) which read as follows: “Except as provided in paragraph (6), in any case in which the attorney general of a State has reason to believe that an interest of the residents of that State has been or is threatened or adversely affected by the engagement of any person subject to a rule prescribed under subsection (a) in a practice that violates such rule, the State, as parens patriae, may bring a civil action on behalf of the residents of the State in an appropriate district court of the United States or other court of competent jurisdiction—" ;
  fro-usc:hasNoteText "Subsec. (b)(1). Pub. L. 111–24 , § 511(a)(2)(A), added par. (1) and struck out former par. (1) which read as follows: “Except as provided in paragraph (6), a State, as parens patriae, may bring a civil action on behalf of its residents in an appropriate State or district court of the United States to enforce the provisions of section 128 of the Truth in Lending Act ( 15 U.S.C. 1638 ), any other provision of the Truth in Lending Act, or any mortgage loan rule promulgated by the Federal Trade Commission to obtain penalties and relief provided under such Act or rule whenever the attorney general of the State has reason to believe that the interests of the residents of the State have been or are being threatened or adversely affected by a violation of such Act or rule.”" ;
  fro-usc:hasNoteText "Subsec. (b)(2), (3), (6). Pub. L. 111–24 , § 511(a)(2)(B), substituted “primary Federal regulator” for “Commission” wherever appearing." ;
  fro-usc:hasNoteText "Subsec. (b)(2). Pub. L. 111–203 , § 1097(2)(B), substituted “the Bureau of Consumer Financial Protection or the Commission, as appropriate” for “the primary Federal regulator”." ;
  fro-usc:hasNoteText "Subsec. (b)(3). Pub. L. 111–203 , § 1097(2)(B), (C), inserted “and subject to subtitle B of the Consumer Financial Protection Act of 2010,” after “paragraph (2),” and substituted “the Bureau of Consumer Financial Protection or the Commission, as appropriate” for “the primary Federal regulator”." ;
  fro-usc:hasNoteText "Subsec. (b)(6). Pub. L. 111–203 , § 1097(2)(D), substituted “the Bureau of Consumer Financial Protection or the Commission” for “the primary Federal regulator” in two places." ;
  fro-usc:hasNoteText "“(2) Paragraph (1) shall not be construed to authorize the Federal Trade Commission to promulgate a rule with respect to an entity that is not subject to enforcement of the Federal Trade Commission Act ( 15 U.S.C. 41 et seq.) by the Commission." ;
  fro-usc:hasNoteText "“(3) Before issuing a final rule pursuant to the proceeding initiated under paragraph (1), the Federal Trade Commission shall consult with the Federal Reserve Board concerning any portion of the proposed rule applicable to acts or practices to which the provisions of the Truth in Lending Act ( 15 U.S.C. 1601 et seq.) may apply." ;
  fro-usc:hasNoteText "“(4) The Federal Trade Commission shall enforce the rules issued under paragraph (1) in the same manner, by the same means, and with the same jurisdiction, powers, and duties as though all applicable terms and provisions of the Federal Trade Commission Act ( 15 U.S.C. 41 et seq.) were incorporated into and made part of this section.”" ;
  fro-usc:hasNoteText "“(A) to enjoin that practice;" ;
  fro-usc:hasNoteText "“(B) to enforce compliance with the rule;" ;
  fro-usc:hasNoteText "“(C) to obtain damages, restitution, or other compensation on behalf of residents of the State; or" ;
  fro-usc:hasNoteText "“(D) to obtain penalties and relief provided by the Federal Trade Commission Act and such other relief as the court considers appropriate.”" ;
  fro-usc:hasNoteText "“(a)(1) Within 90 days after March 11, 2009 , the Federal Trade Commission shall initiate a rulemaking proceeding with respect to mortgage loans in accordance with section 553 of title 5 . Such rulemaking shall relate to unfair or deceptive acts or practices regarding mortgage loans, which may include unfair or deceptive acts or practices involving loan modification and foreclosure rescue services. Any violation of a rule prescribed under this subsection shall be treated as a violation of a rule under section 18 of the Federal Trade Commission Act ( 15 U.S.C. 57a ) regarding unfair or deceptive acts or practices." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/24" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1601" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1638" ;
  fro-usc:hasReferenceText "/us/usc/t15/s41" ;
  fro-usc:hasReferenceText "/us/usc/t15/s57a" ;
  fro-usc:hasReferenceText "/us/usc/t5/s553" ;
.
