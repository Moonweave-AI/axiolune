  fro-usc:hasReferenceText "/us/usc/t15/s78m" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
  fro-usc:hasReferenceText "/us/usc/t7/s2" ;
.
fro-usc-t12-ch53:id83a402df-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402e0-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402e8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402eb-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402f5-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402f8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4> ;
  fro-usc:hasHeading "Designation of systemic importance" ;
  fro-usc:hasId "id83a402df-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463" ;
  fro-usc:hasNumberText "§ 5463." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402f9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a402e0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402e1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402e2-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-2> ;
  fro-usc:hasHeading "Designation" ;
  fro-usc:hasId "id83a402e0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a402e1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-2-2> ;
  fro-usc:hasContentText "The Council, on a nondelegable basis and by a vote of not fewer than ⅔ of members then serving, including an affirmative vote by the Chairperson of the Council, shall designate those financial market utilities or payment, clearing, or settlement activities that the Council determines are, or are likely to become, systemically important." ;
  fro-usc:hasHeading "Financial stability oversight council" ;
  fro-usc:hasId "id83a402e1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a402e2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-2-3> ;
  fro-usc:hasHeading "Considerations" ;
  fro-usc:hasId "id83a402e2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-4-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402e3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402e4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402e5-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402e6-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402e7-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a402e3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-2-3-3> ;
  fro-usc:hasContentText "The aggregate monetary value of transactions processed by the financial market utility or carried out through the payment, clearing, or settlement activity." ;
  fro-usc:hasId "id83a402e3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a402e4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-2-3-4> ;
  fro-usc:hasContentText "The aggregate exposure of the financial market utility or a financial institution engaged in payment, clearing, or settlement activities to its counterparties." ;
  fro-usc:hasId "id83a402e4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a402e5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-2-3-5> ;
  fro-usc:hasContentText "The relationship, interdependencies, or other interactions of the financial market utility or payment, clearing, or settlement activity with other financial market utilities or payment, clearing, or settlement activities." ;
  fro-usc:hasId "id83a402e5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/a/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a402e6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-2-3-6> ;
  fro-usc:hasContentText "The effect that the failure of or a disruption to the financial market utility or payment, clearing, or settlement activity would have on critical markets, financial institutions, or the broader financial system." ;
  fro-usc:hasId "id83a402e6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/a/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83a402e7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-2-3-7> ;
  fro-usc:hasContentText "Any other factors that the Council deems appropriate." ;
  fro-usc:hasId "id83a402e7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/a/2/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83a402e8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402e9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402ea-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-3> ;
  fro-usc:hasHeading "Rescission of designation" ;
  fro-usc:hasId "id83a402e8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a402e9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-3-2> ;
  fro-usc:hasContentText "The Council, on a nondelegable basis and by a vote of not fewer than ⅔ of members then serving, including an affirmative vote by the Chairperson of the Council, shall rescind a designation of systemic importance for a designated financial market utility or designated activity if the Council determines that the utility or activity no longer meets the standards for systemic importance." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a402e9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a402ea-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-3-3> ;
  fro-usc:hasContentText "Upon rescission, the financial market utility or financial institutions conducting the activity will no longer be subject to the provisions of this subchapter or any rules or orders prescribed under this subchapter." ;
  fro-usc:hasHeading "Effect of rescission" ;
  fro-usc:hasId "id83a402ea-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a402eb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402ec-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402ed-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402f2-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-4> ;
  fro-usc:hasHeading "Consultation and notice and opportunity for hearing" ;
  fro-usc:hasId "id83a402eb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a402ec-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-4-2> ;
  fro-usc:hasContentText "Before making any determination under subsection (a) or (b), the Council shall consult with the relevant Supervisory Agency and the Board of Governors." ;
  fro-usc:hasHeading "Consultation" ;
  fro-usc:hasId "id83a402ec-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a402ed-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-4-3> ;
  fro-usc:hasHeading "Advance notice and opportunity for hearing" ;
  fro-usc:hasId "id83a402ed-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402ee-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402ef-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402f0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402f1-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a402ee-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-4-3-2> ;
  fro-usc:hasContentText "Before making any determination under subsection (a) or (b), the Council shall provide the financial market utility or, in the case of a payment, clearing, or settlement activity, financial institutions with advance notice of the proposed determination of the Council." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a402ee-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a402ef-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-4-3-3> ;
  fro-usc:hasContentText "The Council shall provide such advance notice to financial institutions by publishing a notice in the Federal Register." ;
  fro-usc:hasHeading "Notice in Federal Register" ;
  fro-usc:hasId "id83a402ef-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a402f0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-4-3-4> ;
  fro-usc:hasContentText "Within 30 days from the date of any notice of the proposed determination of the Council, the financial market utility or, in the case of a payment, clearing, or settlement activity, a financial institution engaged in the designated activity may request, in writing, an opportunity for a written or oral hearing before the Council to demonstrate that the proposed designation or rescission of designation is not supported by substantial evidence." ;
  fro-usc:hasHeading "Requests for hearing" ;
  fro-usc:hasId "id83a402f0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/c/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a402f1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-4-3-5> ;
  fro-usc:hasContentText "Upon receipt of a timely request, the Council shall fix a time, not more than 30 days after receipt of the request, unless extended at the request of the financial market utility or financial institution, and place at which the financial market utility or financial institution may appear, personally or through counsel, to submit written materials, or, at the sole discretion of the Council, oral testimony or oral argument." ;
  fro-usc:hasHeading "Written submissions" ;
  fro-usc:hasId "id83a402f1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/c/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83a402f2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-4-4> ;
  fro-usc:hasHeading "Emergency exception" ;
  fro-usc:hasId "id83a402f2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402f3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402f4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a402f3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-4-4-2> ;
  fro-usc:hasContentText "The Council may waive or modify the requirements of paragraph (2) if the Council determines, by an affirmative vote of not fewer than ⅔ of members then serving, including an affirmative vote by the Chairperson of the Council, that the waiver or modification is necessary to prevent or mitigate an immediate threat to the financial system posed by the financial market utility or the payment, clearing, or settlement activity." ;
  fro-usc:hasHeading "Waiver or modification by vote of the Council" ;
  fro-usc:hasId "id83a402f3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a402f4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-4-4-3> ;
  fro-usc:hasContentText "The Council shall provide notice of the waiver or modification to the financial market utility concerned or, in the case of a payment, clearing, or settlement activity, to financial institutions, as soon as practicable, which shall be no later than 24 hours after the waiver or modification in the case of a financial market utility and 3 business days in the case of financial institutions. The Council shall provide the notice to financial institutions by posting a notice on the website of the Council and by publishing a notice in the Federal Register." ;
  fro-usc:hasHeading "Notice of waiver or modification" ;
  fro-usc:hasId "id83a402f4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a402f5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402f6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a402f7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-5> ;
  fro-usc:hasHeading "Notification of final determination" ;
  fro-usc:hasId "id83a402f5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83a402f6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-5-2> ;
  fro-usc:hasContentText "Within 60 days of any hearing under subsection (c)(2), the Council shall notify the financial market utility or financial institutions of the final determination of the Council in writing, which shall include findings of fact upon which the determination of the Council is based." ;
  fro-usc:hasHeading "After hearing" ;
  fro-usc:hasId "id83a402f6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a402f7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-5-3> ;
  fro-usc:hasContentText "If the Council does not receive a timely request for a hearing under subsection (c)(2), the Council shall notify the financial market utility or financial institutions of the final determination of the Council in writing not later than 30 days after the expiration of the date by which a financial market utility or a financial institution could have requested a hearing. All notices to financial institutions under this subsection shall be published in the Federal Register." ;
  fro-usc:hasHeading "When no hearing requested" ;
  fro-usc:hasId "id83a402f7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a402f8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-4-6> ;
  fro-usc:hasContentText "The Council may extend the time periods established in subsections (c) and (d) as the Council determines to be necessary or appropriate." ;
  fro-usc:hasHeading "Extension of time periods" ;
  fro-usc:hasId "id83a402f8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5463/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83a402f9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-usc:hasId "id83a402f9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tVIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1807" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title VIII , § 804, July 21, 2010 , 124 Stat. 1807 .)" ;
.
