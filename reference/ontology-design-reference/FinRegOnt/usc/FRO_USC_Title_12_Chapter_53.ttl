  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-3-3-8> ;
  fro-usc:hasContentText "the extent to which assets are managed rather than owned by the company and the extent to which ownership of assets under management is diffuse;" ;
  fro-usc:hasId "id839360e1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/b/2/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id839360e2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-3-3-9> ;
  fro-usc:hasContentText "the nature, scope, size, scale, concentration, interconnectedness, and mix of the activities of the company;" ;
  fro-usc:hasId "id839360e2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/b/2/G" ;
  fro-usc:hasNumberText "(G)" ;
.
fro-usc-t12-ch53:id839360e3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-3-3-10> ;
  fro-usc:hasContentText "the extent to which the company is subject to prudential standards on a consolidated basis in its home country that are administered and enforced by a comparable foreign supervisory authority;" ;
  fro-usc:hasId "id839360e3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/b/2/H" ;
  fro-usc:hasNumberText "(H)" ;
.
fro-usc-t12-ch53:id839360e4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-3-3-11> ;
  fro-usc:hasContentText "the amount and nature of the United States financial assets of the company;" ;
  fro-usc:hasId "id839360e4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/b/2/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839360e5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-3-3-12> ;
  fro-usc:hasContentText "the amount and nature of the liabilities of the company used to fund activities and operations in the United States, including the degree of reliance on short-term funding; and" ;
  fro-usc:hasId "id839360e5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/b/2/J" ;
  fro-usc:hasNumberText "(J)" ;
.
fro-usc-t12-ch53:id839360e6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-3-3-13> ;
  fro-usc:hasContentText "any other risk-related factors that the Council deems appropriate." ;
  fro-usc:hasId "id839360e6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/b/2/K" ;
  fro-usc:hasNumberText "(K)" ;
.
fro-usc-t12-ch53:id839360e7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360e8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360ec-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360ed-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360f0-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360f1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360f5-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4> ;
  fro-usc:hasHeading "Antievasion" ;
  fro-usc:hasId "id839360e7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id839360e8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-2> ;
  fro-usc:hasHeading "Determinations" ;
  fro-usc:hasId "id839360e8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-4-4-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839360e9-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360ea-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360eb-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839360e9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-2-3> ;
  fro-usc:hasContentText "material financial distress related to, or the nature, scope, size, scale, concentration, interconnectedness, or mix of, the financial activities conducted directly or indirectly by a company incorporated or organized under the laws of the United States or any State or the financial activities in the United States of a company incorporated or organized in a country other than the United States would pose a threat to the financial stability of the United States, based on consideration of the factors in subsection (a)(2) or (b)(2), as applicable;" ;
  fro-usc:hasId "id839360e9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839360ea-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-2-4> ;
  fro-usc:hasContentText "the company is organized or operates in such a manner as to evade the application of this subchapter; and" ;
  fro-usc:hasId "id839360ea-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839360eb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-2-5> ;
  fro-usc:hasContentText "such financial activities of the company shall be supervised by the Board of Governors and subject to prudential standards in accordance with this subchapter, consistent with paragraph (3)." ;
  fro-usc:hasId "id839360eb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839360ec-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-3> ;
  fro-usc:hasContentText "Upon making a determination under paragraph (1), the Council shall submit a report to the appropriate committees of Congress detailing the reasons for making such determination." ;
  fro-usc:hasHeading "Report" ;
  fro-usc:hasId "id839360ec-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839360ed-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-4> ;
  fro-usc:hasHeading "Consolidated supervision of only financial activities; establishment of an intermediate holding company" ;
  fro-usc:hasId "id839360ed-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839360ee-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360ef-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839360ee-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-4-2> ;
  fro-usc:hasContentText "Upon a determination under paragraph (1), the company that is the subject of the determination may establish an intermediate holding company in which the financial activities of such company and its subsidiaries shall be conducted (other than the activities described in section 5367(b)(2) of this title ) in compliance with any regulations or guidance provided by the Board of Governors. Such intermediate holding company shall be subject to the supervision of the Board of Governors and to prudential standards under this subchapter as if the intermediate holding company were a nonbank financial company supervised by the Board of Governors." ;
  fro-usc:hasHeading "Establishment of an intermediate holding company" ;
  fro-usc:hasId "id839360ee-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5367/b/2" ;
.
fro-usc-t12-ch53:id839360ef-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-4-3> ;
  fro-usc:hasContentText "To facilitate the supervision of the financial activities subject to the determination in paragraph (1), the Board of Governors may require a company to establish an intermediate holding company, as provided for in section 5367 of this title , which would be subject to the supervision of the Board of Governors and to prudential standards under this subchapter, as if the intermediate holding company were a nonbank financial company supervised by the Board of Governors." ;
  fro-usc:hasHeading "Action of the Board of Governors" ;
  fro-usc:hasId "id839360ef-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5367" ;
.
fro-usc-t12-ch53:id839360f0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-5> ;
  fro-usc:hasContentText "Subsections (d) through (h) shall apply to determinations made by the Council pursuant to paragraph (1) in the same manner as such subsections apply to nonbank financial companies." ;
  fro-usc:hasHeading "Notice and opportunity for hearing and final determination; judicial review" ;
  fro-usc:hasId "id839360f0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id839360f1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-6> ;
  fro-usc:hasHeading "Covered financial activities" ;
  fro-usc:hasId "id839360f1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-4-4-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839360f2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360f3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360f4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839360f2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-6-3> ;
  fro-usc:hasContentText "means activities that are financial in nature (as defined in section 1843(k) of this title );" ;
  fro-usc:hasId "id839360f2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/5/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k" ;
.
fro-usc-t12-ch53:id839360f3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-6-4> ;
  fro-usc:hasContentText "includes the ownership or control of one or more insured depository institutions; and" ;
  fro-usc:hasId "id839360f3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839360f4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-6-5> ;
  fro-usc:hasContentText "does not include internal financial activities conducted for the company or any affiliate thereof, including internal treasury, investment, and employee benefit functions." ;
  fro-usc:hasId "id839360f4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/5/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839360f5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-4-7> ;
  fro-usc:hasContentText "Nonfinancial activities of the company shall not be subject to supervision by the Board of Governors and prudential standards of the Board. For purposes of this Act, the financial activities that are the subject of the determination in paragraph (1) shall be subject to the same requirements as a nonbank financial company supervised by the Board of Governors. Nothing in this paragraph shall prohibit or limit the authority of the Board of Governors to apply prudential standards under this subchapter to the financial activities that are subject to the determination in paragraph (1)." ;
  fro-usc:hasHeading "Only financial activities subject to prudential supervision" ;
  fro-usc:hasId "id839360f5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/c/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id839360f6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360f7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360f8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-5> ;
  fro-usc:hasHeading "Reevaluation and rescission" ;
  fro-usc:hasId "id839360f6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-4-5-2> ;
.
fro-usc-t12-ch53:id839360f7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-5-3> ;
  fro-usc:hasContentText "not less frequently than annually, reevaluate each determination made under subsections (a) and (b) with respect to such nonbank financial company supervised by the Board of Governors; and" ;
  fro-usc:hasId "id839360f7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839360f8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-5-4> ;
  fro-usc:hasContentText "rescind any such determination, if the Council, by a vote of not fewer than ⅔ of the voting members then serving, including an affirmative vote by the Chairperson, determines that the nonbank financial company no longer meets the standards under subsection (a) or (b), as applicable." ;
  fro-usc:hasId "id839360f8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839360f9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360fa-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360fb-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360fc-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360fd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-6> ;
  fro-usc:hasHeading "Notice and opportunity for hearing and final determination" ;
  fro-usc:hasId "id839360f9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id839360fa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-6-2> ;
  fro-usc:hasContentText "The Council shall provide to a nonbank financial company written notice of a proposed determination of the Council, including an explanation of the basis of the proposed determination of the Council, that a nonbank financial company shall be supervised by the Board of Governors and shall be subject to prudential standards in accordance with this subchapter." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839360fa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839360fb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-6-3> ;
  fro-usc:hasContentText "Not later than 30 days after the date of receipt of any notice of a proposed determination under paragraph (1), the nonbank financial company may request, in writing, an opportunity for a written or oral hearing before the Council to contest the proposed determination. Upon receipt of a timely request, the Council shall fix a time (not later than 30 days after the date of receipt of the request) and place at which such company may appear, personally or through counsel, to submit written materials (or, at the sole discretion of the Council, oral testimony and oral argument)." ;
  fro-usc:hasHeading "Hearing" ;
  fro-usc:hasId "id839360fb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839360fc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-6-4> ;
  fro-usc:hasContentText "Not later than 60 days after the date of a hearing under paragraph (2), the Council shall notify the nonbank financial company of the final determination of the Council, which shall contain a statement of the basis for the decision of the Council." ;
  fro-usc:hasHeading "Final determination" ;
  fro-usc:hasId "id839360fc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839360fd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-6-5> ;
  fro-usc:hasContentText "If a nonbank financial company does not make a timely request for a hearing, the Council shall notify the nonbank financial company, in writing, of the final determination of the Council under subsection (a) or (b), as applicable, not later than 10 days after the date by which the company may request a hearing under paragraph (2)." ;
  fro-usc:hasHeading "No hearing requested" ;
  fro-usc:hasId "id839360fd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/e/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id839360fe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360ff-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936100-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936101-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936102-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936103-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-7> ;
  fro-usc:hasHeading "Emergency exception" ;
  fro-usc:hasId "id839360fe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id839360ff-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-7-2> ;
  fro-usc:hasContentText "The Council may waive or modify the requirements of subsection (e) with respect to a nonbank financial company, if the Council determines, by a vote of not fewer than ⅔ of the voting members then serving, including an affirmative vote by the Chairperson, that such waiver or modification is necessary or appropriate to prevent or mitigate threats posed by the nonbank financial company to the financial stability of the United States." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839360ff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/f/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83936100-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-7-3> ;
  fro-usc:hasContentText "The Council shall provide notice of a waiver or modification under this subsection to the nonbank financial company concerned as soon as practicable, but not later than 24 hours after the waiver or modification is granted." ;
  fro-usc:hasHeading "Notice" ;
  fro-usc:hasId "id83936100-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/f/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83936101-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-7-4> ;
  fro-usc:hasContentText "In making a determination under paragraph (1), the Council shall consult with the appropriate home country supervisor, if any, of the foreign nonbank financial company that is being considered for such a determination." ;
  fro-usc:hasHeading "International coordination" ;
  fro-usc:hasId "id83936101-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/f/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83936102-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-7-5> ;
  fro-usc:hasContentText "The Council shall allow a nonbank financial company to request, in writing, an opportunity for a written or oral hearing before the Council to contest a waiver or modification under this subsection, not later than 10 days after the date of receipt of notice of the waiver or modification by the company. Upon receipt of a timely request, the Council shall fix a time (not later than 15 days after the date of receipt of the request) and place at which the nonbank financial company may appear, personally or through counsel, to submit written materials (or, at the sole discretion of the Council, oral testimony and oral argument)." ;
  fro-usc:hasHeading "Opportunity for hearing" ;
  fro-usc:hasId "id83936102-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/f/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83936103-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-7-6> ;
  fro-usc:hasContentText "Not later than 30 days after the date of any hearing under paragraph (4), the Council shall notify the subject nonbank financial company of the final determination of the Council under this subsection, which shall contain a statement of the basis for the decision of the Council." ;
  fro-usc:hasHeading "Notice of final determination" ;
  fro-usc:hasId "id83936103-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/f/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83936104-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-8> ;
  fro-usc:hasContentText "The Council shall consult with the primary financial regulatory agency, if any, for each nonbank financial company or subsidiary of a nonbank financial company that is being considered for supervision by the Board of Governors under this section before the Council makes any final determination with respect to such nonbank financial company under subsection (a), (b), or (c)." ;
  fro-usc:hasHeading "Consultation" ;
  fro-usc:hasId "id83936104-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id83936105-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-9> ;
  fro-usc:hasContentText "If the Council makes a final determination under this section with respect to a nonbank financial company, such nonbank financial company may, not later than 30 days after the date of receipt of the notice of final determination under subsection (d)(2), (e)(3), or (f)(5), bring an action in the United States district court for the judicial district in which the home office of such nonbank financial company is located, or in the United States District Court for the District of Columbia, for an order requiring that the final determination be rescinded, and the court shall, upon review, dismiss such action or direct the final determination to be rescinded. Review of such an action shall be limited to whether the final determination made under this section was arbitrary and capricious." ;
  fro-usc:hasHeading "Judicial review" ;
  fro-usc:hasId "id83936105-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/h" ;
  fro-usc:hasNumberText "(h)" ;
.
fro-usc-t12-ch53:id83936106-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-10> ;
  fro-usc:hasContentText "In exercising its duties under this subchapter with respect to foreign nonbank financial companies, foreign-based bank holding companies, and cross-border activities and markets, the Council shall consult with appropriate foreign regulatory authorities, to the extent appropriate." ;
  fro-usc:hasHeading "International coordination" ;
  fro-usc:hasId "id83936106-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83936107-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-usc:hasId "id83936107-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1398" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 113, July 21, 2010 , 124 Stat. 1398 .)" ;
.
fro-usc-t12-ch53:id83936109-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-12-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83936109-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This Act, referred to in subsec. (c)(6), is Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1376 , known as the Dodd-Frank Wall Street Reform and Consumer Protection Act, which enacted this chapter and chapters 108 (§ 8201 et seq.) and 109 (§ 8301 et seq.) of Title 15, Commerce and Trade, and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of this Act to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteText "This subchapter, referred to in subsecs. (a)(1), (b)(1), (c)(1), (3), (6), (e)(1), and (i), was in the original “this title”, meaning title I of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1391 , which is classified principally to this subchapter. For complete classification of title I to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1376" ;
  fro-usc:hasReferenceText "/us/stat/124/1391" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8393610a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id8393610d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-5> ;
  fro-usc:hasContentText "Not later than 180 days after the date of a final Council determination under section 5323 of this title that a nonbank financial company is to be supervised by the Board of Governors, such company shall register with the Board of Governors, on forms prescribed by the Board of Governors, which shall include such information as the Board of Governors, in consultation with the Council, may deem necessary or appropriate to carry out this subchapter." ;
  fro-usc:hasHeading "Registration of nonbank financial companies supervised by the Board of Governors" ;
  fro-usc:hasId "id8393610a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5324" ;
  fro-usc:hasNumberText "§ 5324." ;
  lkif-mereo:component fro-usc-t12-ch53:id8393610b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8393610b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id8393610b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1403" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 114, July 21, 2010 , 124 Stat. 1403 .)" ;
.
