  fro-usc:hasHeading "Definitions" ;
  fro-usc:hasId "id83b25a7e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/1/D" ;
