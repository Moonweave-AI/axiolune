  fro-usc:hasHeading "Standards for foreign financial companies" ;
  fro-usc:hasId "id8395ab8a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/b/2" ;
