  lkif-mereo:component fro-usc-t12-ch53:id83a191bf-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a191bd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-2-4-2> ;
  fro-usc:hasContentText "the amount of funds necessary to pay any expenses associated with the transfer of functions (including expenses for personnel, property, and administrative services) during the period beginning on July 21, 2010 , and ending on the transfer date;" ;
  fro-usc:hasId "id83a191bd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a191be-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-2-4-3> ;
  fro-usc:hasContentText "which personnel are appropriate to facilitate the orderly transfer of functions by this title;  and" ;
  fro-usc:hasId "id83a191be-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a191bf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-2-4-4> ;
  fro-usc:hasContentText "what property and administrative services are necessary to support the Office of the Comptroller of the Currency, the Corporation, and the Board of Governors during the period beginning on July 21, 2010 , and ending on the transfer date; and" ;
  fro-usc:hasId "id83a191bf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/a/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a191c0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-2-5> ;
  fro-usc:hasContentText "take such actions as may be necessary to provide for the orderly implementation of this title." ;
  fro-usc:hasId "id83a191c0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a191c1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191c2-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191c3-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191c4-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-3> ;
  fro-usc:hasHeading "Agency consultation" ;
  fro-usc:hasId "id83a191c1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-5-2-3-2> ;
.
fro-usc-t12-ch53:id83a191c2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-3-3> ;
  fro-usc:hasContentText "pay to the Office of the Comptroller of the Currency, the Corporation, or the Board of Governors, as applicable, from funds obtained by the Office of Thrift Supervision through assessments, fees, or other charges that the Office of Thrift Supervision is authorized by law to impose, such amounts as the Office of the Comptroller of the Currency, the Corporation, and the Board of Governors jointly determine to be necessary under subsection (a);" ;
  fro-usc:hasId "id83a191c2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a191c3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-3-4> ;
  fro-usc:hasContentText "detail to the Office of the Comptroller of the Currency, the Corporation, or the Board of Governors, as applicable, such personnel as the Office of the Comptroller of the Currency, the Corporation, and the Board of Governors jointly determine to be appropriate under subsection (a); and" ;
  fro-usc:hasId "id83a191c3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a191c4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-3-5> ;
  fro-usc:hasContentText "make available to the Office of the Comptroller of the Currency, the Corporation, or the Board of Governors, as applicable, such property and provide to the Office of the Comptroller of the Currency, the Corporation, or the Board of Governors, as applicable, such administrative services as the Office of the Comptroller of the Currency, the Corporation, and the Board of Governors jointly determine to be necessary under subsection (a)." ;
  fro-usc:hasId "id83a191c4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a191c5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-2-4> ;
  fro-usc:hasContentText "The Office of the Comptroller of the Currency, the Corporation, and the Board of Governors shall jointly give the Office of Thrift Supervision reasonable prior notice of any request that the Office of the Comptroller of the Currency, the Corporation, and the Board of Governors jointly intend to make under subsection (b)." ;
  fro-usc:hasHeading "Notice required" ;
  fro-usc:hasId "id83a191c5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5431/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a191c6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
