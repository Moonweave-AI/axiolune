  fro-usc:hasContentText "consistent with the number determined under clause (i), jointly identify employees of the Office of Thrift Supervision for transfer to the Bureau, in a manner that the Bureau and the Office of Thrift Supervision, in their sole discretion, determine equitable." ;
  fro-usc:hasId "id83b25a33-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/5/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83b25a34-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-6-3> ;
  fro-usc:hasContentText "All employees of the Office of Thrift Supervision identified under subparagraph (A)(ii) shall be transferred to the Bureau for employment." ;
  fro-usc:hasHeading "Identified employees transferred" ;
  fro-usc:hasId "id83b25a34-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b25a35-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-7> ;
  fro-usc:hasHeading "Certain employees of Department of Housing and Urban Development transferred" ;
  fro-usc:hasId "id83b25a35-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/6" ;
  fro-usc:hasNumberText "(6)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a36-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a39-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a36-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-7-2> ;
  fro-usc:hasHeading "Identifying employees for transfer" ;
  fro-usc:hasId "id83b25a36-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/6/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-5-2-7-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a37-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a38-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a37-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-7-2-3> ;
  fro-usc:hasContentText "jointly determine the number of employees of the Department of Housing and Urban Development necessary to perform or support the consumer protection functions of the Department that are transferred to the Bureau by this title;  and" ;
  fro-usc:hasId "id83b25a37-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/6/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83b25a38-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-7-2-4> ;
  fro-usc:hasContentText "consistent with the number determined under clause (i), jointly identify employees of the Department of Housing and Urban Development for transfer to the Bureau in a manner that the Bureau and the Secretary of the Department of Housing and Urban Development, in their sole discretion, deem equitable." ;
  fro-usc:hasId "id83b25a38-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/6/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83b25a39-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-7-3> ;
  fro-usc:hasContentText "All employees of the Department of Housing and Urban Development identified under subparagraph (A)(ii) shall be transferred to the Bureau for employment." ;
  fro-usc:hasHeading "Identified employees transferred" ;
  fro-usc:hasId "id83b25a39-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b25a3a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-8> ;
  fro-usc:hasContentText "The Bureau and each of the transferor agencies (except the Federal Trade Commission) shall jointly determine the number of employees and the types and grades of employees necessary to perform the functions of the Bureau under part A, including consumer education, financial literacy, policy analysis, responses to consumer complaints and inquiries, research, and similar functions. All employees jointly identified under this paragraph shall be transferred to the Bureau for employment." ;
  fro-usc:hasHeading "Consumer education, financial literacy, consumer complaints, and research functions" ;
  fro-usc:hasId "id83b25a3a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/7" ;
  fro-usc:hasNumberText "(7)" ;
.
fro-usc-t12-ch53:id83b25a3b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-9> ;
  fro-usc:hasHeading "Authority of the President to resolve disputes" ;
  fro-usc:hasId "id83b25a3b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/8" ;
  fro-usc:hasNumberText "(8)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a3c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a3d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a3e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a3c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-9-2> ;
  fro-usc:hasContentText "In the event that the Bureau and a transferor agency are unable to reach an agreement under paragraphs (1) through (7) by the designated transfer date, the President, or the designee thereof, may issue an order or directive to the transferor agency to effect the transfer of personnel and property under this part." ;
  fro-usc:hasHeading "Action authorized" ;
  fro-usc:hasId "id83b25a3c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/8/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83b25a3d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-9-3> ;
  fro-usc:hasContentText "If an order or directive is issued under subparagraph (A), the President shall transmit a copy of the written determination made with respect to such order or directive, including an explanation for the need for the order or directive, to the Committee on Banking, Housing, and Urban Affairs and the Committee on Appropriations of the Senate and the Committee on Financial Services and the Committee on Appropriations of the House of Representatives." ;
  fro-usc:hasHeading "Transmittal to Congress required" ;
  fro-usc:hasId "id83b25a3d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/8/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b25a3e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-9-4> ;
  fro-usc:hasContentText "The authority provided in this paragraph shall terminate 3 years after the designated transfer date." ;
  fro-usc:hasHeading "Sunset" ;
  fro-usc:hasId "id83b25a3e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/8/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83b25a3f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-10> ;
  fro-usc:hasHeading "Appointment authority for excepted service and senior executive service transferred" ;
  fro-usc:hasId "id83b25a3f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/9" ;
  fro-usc:hasNumberText "(9)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a40-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a41-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a40-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-10-2> ;
  fro-usc:hasContentText "In the case of an employee occupying a position in the excepted service or the Senior Executive Service, any appointment authority established pursuant to law or regulations of the Office of Personnel Management for filling such positions shall be transferred, subject to subparagraph (B)." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b25a40-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/9/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83b25a41-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-10-3> ;
  fro-usc:hasContentText "An agency or entity may decline to make a transfer of authority under subparagraph (A) (and the employees appointed pursuant thereto) to the extent that such authority relates to positions excepted from the competitive service because of their confidential, policy-making, policy-determining, or policy-advocating character, and non-career positions in the Senior Executive Service (within the meaning of section 3132(a)(7) of title 5 )." ;
  fro-usc:hasHeading "Declining transfers allowed" ;
  fro-usc:hasId "id83b25a41-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/9/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s3132/a/7" ;
.
fro-usc-t12-ch53:id83b25a42-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a43-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a44-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-3> ;
  fro-usc:hasHeading "Timing of transfers and position assignments" ;
  fro-usc:hasId "id83b25a42-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-5-3-2> ;
.
fro-usc-t12-ch53:id83b25a43-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-3-3> ;
  fro-usc:hasContentText "be transferred not later than 90 days after the designated transfer date; and" ;
  fro-usc:hasId "id83b25a43-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25a44-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-3-4> ;
  fro-usc:hasContentText "receive notice of a position assignment not later than 120 days after the effective date of his or her transfer." ;
  fro-usc:hasId "id83b25a44-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25a45-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a46-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a47-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-4> ;
  fro-usc:hasHeading "Transfer of function" ;
  fro-usc:hasId "id83b25a45-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83b25a46-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-4-2> ;
  fro-usc:hasContentText "Notwithstanding any other provision of law, the transfer of employees shall be deemed a transfer of functions for the purpose of section 3503 of title 5 ." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b25a46-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/c/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s3503" ;
.
fro-usc-t12-ch53:id83b25a47-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-4-3> ;
  fro-usc:hasContentText "If any provisions of this title  conflict with any protection provided to transferred employees under section 3503 of title 5 , the provisions of this title  shall control." ;
  fro-usc:hasHeading "Priority of this title " ;
  fro-usc:hasId "id83b25a47-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s3503" ;
.
fro-usc-t12-ch53:id83b25a48-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a49-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a4a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-5> ;
  fro-usc:hasHeading "Equal status and tenure positions" ;
  fro-usc:hasId "id83b25a48-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83b25a49-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-5-2> ;
  fro-usc:hasContentText "Each employee transferred to the Bureau from the Board of Governors, a Federal reserve bank, the Federal Deposit Insurance Corporation, the Department of Housing and Urban Development, the National Credit Union Administration, the Office of the Comptroller of the Currency, or the Office of Thrift Supervision shall be placed in a position at the Bureau with the same status and tenure as that employee held on the day before the designated transfer date." ;
  fro-usc:hasHeading "Employees transferred from the Federal Reserve System, FDIC, HUD, NCUA, OCC, and OTS" ;
  fro-usc:hasId "id83b25a49-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25a4a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-5-3> ;
  fro-usc:hasContentText "For purposes of determining the status and position placement of a transferred employee, any period of service with the Board of Governors or a Federal reserve bank shall be credited as a period of service with a Federal agency." ;
  fro-usc:hasHeading "Employees transferred from the Federal Reserve System" ;
  fro-usc:hasId "id83b25a4a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25a4b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-6> ;
  fro-usc:hasContentText "Examiners transferred to the Bureau are not subject to any additional certification requirements before being placed in a comparable examiner position at the Bureau examining the same types of institutions as they examined before they were transferred." ;
  fro-usc:hasHeading "Additional certification requirements limited" ;
  fro-usc:hasId "id83b25a4b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83b25a4c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a4d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a4e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-7> ;
  fro-usc:hasHeading "Personnel actions limited" ;
  fro-usc:hasId "id83b25a4c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83b25a4d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-7-2> ;
  fro-usc:hasContentText "Except as provided in paragraph (2), each transferred employee holding a permanent position on the day before the designated transfer date may not, during the 2-year period beginning on the designated transfer date, be involuntarily separated, or involuntarily reassigned outside his or her locality pay area." ;
  fro-usc:hasHeading "2-year protection" ;
  fro-usc:hasId "id83b25a4d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/f/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25a4e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-7-3> ;
  fro-usc:hasHeading "Exceptions" ;
  fro-usc:hasId "id83b25a4e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/f/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-5-7-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a4f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a50-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a51-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a4f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-7-3-3> ;
  fro-usc:hasContentText "to separate an employee for cause or for unacceptable performance;" ;
  fro-usc:hasId "id83b25a4f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/f/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83b25a50-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-7-3-4> ;
  fro-usc:hasContentText "to terminate an appointment to a position excepted from the competitive service because of its confidential policy-making, policy-determining, or policy-advocating character; or" ;
  fro-usc:hasId "id83b25a50-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/f/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b25a51-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-7-3-5> ;
  fro-usc:hasContentText "to reassign a supervisory employee outside of his or her locality pay area when the Bureau determines that the reassignment is necessary for the efficient operation of the Bureau." ;
  fro-usc:hasId "id83b25a51-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/f/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83b25a52-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a53-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a56-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a5a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a5b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-8> ;
  fro-usc:hasHeading "Pay" ;
  fro-usc:hasId "id83b25a52-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id83b25a53-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-8-2> ;
  fro-usc:hasHeading "2-year protection" ;
  fro-usc:hasId "id83b25a53-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/g/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a54-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a55-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a54-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-8-2-2> ;
  fro-usc:hasContentText "Except as provided in paragraph (2), each transferred employee shall, during the 2-year period beginning on the designated transfer date, receive pay at a rate equal to not less than the basic rate of pay (including any geographic differential) that the employee received during the pay period immediately preceding the date of transfer." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b25a54-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/g/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83b25a55-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-8-2-3> ;
  fro-usc:hasContentText "Notwithstanding subparagraph (A), if the employee was receiving a higher rate of basic pay on a temporary basis (because of a temporary assignment, temporary promotion, or other temporary action) immediately before the date of transfer, the Bureau may reduce the rate of basic pay on the date on which the rate would have been reduced but for the transfer, and the protected rate for the remainder of the 2-year period shall be the reduced rate that would have applied, but for the transfer." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id83b25a55-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/g/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b25a56-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-8-3> ;
  fro-usc:hasHeading "Exceptions" ;
  fro-usc:hasId "id83b25a56-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/g/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-5-8-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a57-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a58-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a59-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a57-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-8-3-3> ;
  fro-usc:hasContentText "for cause;" ;
  fro-usc:hasId "id83b25a57-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/g/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83b25a58-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-8-3-4> ;
  fro-usc:hasContentText "for unacceptable performance; or" ;
  fro-usc:hasId "id83b25a58-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/g/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b25a59-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-8-3-5> ;
  fro-usc:hasContentText "with the consent of the employee." ;
  fro-usc:hasId "id83b25a59-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/g/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83b25a5a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-8-4> ;
  fro-usc:hasContentText "Paragraph (1) applies to a transferred employee only while that employee remains employed by the Bureau." ;
  fro-usc:hasHeading "Protection only while employed" ;
  fro-usc:hasId "id83b25a5a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/g/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83b25a5b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-8-5> ;
  fro-usc:hasContentText "Paragraph (1) does not limit the authority of the Bureau to increase the pay of a transferred employee." ;
  fro-usc:hasHeading "Pay increases permitted" ;
  fro-usc:hasId "id83b25a5b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/g/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83b25a5c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a5d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a66-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9> ;
  fro-usc:hasHeading "Reorganization" ;
  fro-usc:hasId "id83b25a5c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h" ;
  fro-usc:hasNumberText "(h)" ;
.
fro-usc-t12-ch53:id83b25a5d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-2> ;
  fro-usc:hasHeading "Between 1st and 3rd year" ;
  fro-usc:hasId "id83b25a5d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a5e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a65-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a5e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-2-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b25a5e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-5-9-2-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a5f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a60-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a61-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a5f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-2-2-3> ;
  fro-usc:hasContentText "that reorganization shall be deemed a “substantial reorganization” for purposes of affording affected employees retirement under section 8336(d)(2) or 8414(b)(1)(B) of title 5;" ;
  fro-usc:hasId "id83b25a5f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/1/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83b25a60-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-2-2-4> ;
  fro-usc:hasContentText "before the reorganization occurs, all employees in the same locality pay area as defined by the Office of Personnel Management shall be placed in a uniform position classification system; and" ;
  fro-usc:hasId "id83b25a60-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/1/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83b25a61-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-2-2-5> ;
  fro-usc:hasId "id83b25a61-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/1/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-5-9-2-2-5-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a62-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a63-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a64-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a62-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-2-2-5-2> ;
  fro-usc:hasContentText "establish competitive areas (as that term is defined in regulations issued by the Office of Personnel Management) to include at a minimum all employees in the same locality pay area as defined by the Office of Personnel Management;" ;
  fro-usc:hasId "id83b25a62-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/1/A/iii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83b25a63-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-2-2-5-3> ;
  fro-usc:hasContentText "establish competitive levels (as that term is defined in regulations issued by the Office of Personnel Management) without regard to whether the particular employees have been appointed to positions in the competitive service or the excepted service; and" ;
  fro-usc:hasId "id83b25a63-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/1/A/iii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83b25a64-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-2-2-5-4> ;
  fro-usc:hasContentText "afford employees appointed to positions in the excepted service (other than to a position excepted from the competitive service because of its confidential policy-making, policy-determining, or policy-advocating character) the same assignment rights to positions within the Bureau as employees appointed to positions in the competitive service." ;
  fro-usc:hasId "id83b25a64-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/1/A/iii/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id83b25a65-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-2-3> ;
  fro-usc:hasContentText "For purposes of this paragraph, periods of service with a Federal home loan bank, a joint office of the Federal home loan banks, the Board of Governors, a Federal reserve bank, the Federal Deposit Insurance Corporation, or the National Credit Union Administration shall be credited as periods of service with a Federal agency." ;
  fro-usc:hasHeading "Service credit for reductions in force" ;
  fro-usc:hasId "id83b25a65-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b25a66-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-3> ;
  fro-usc:hasHeading "After 3rd year" ;
  fro-usc:hasId "id83b25a66-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a67-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a68-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a67-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-3-2> ;
  fro-usc:hasContentText "If the Bureau determines, at any time after the 3-year period beginning on the designated transfer date, that a reorganization of the staff of the Bureau is required, any resulting reduction in force shall be governed by the provisions of chapter 35 of title 5, except that the Bureau shall establish competitive levels (as that term is defined in regulations issued by the Office of Personnel Management) without regard to types of appointment held by particular employees transferred under this section." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b25a67-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83b25a68-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-9-3-3> ;
  fro-usc:hasContentText "For purposes of this paragraph, periods of service with a Federal home loan bank, a joint office of the Federal home loan banks, the Board of Governors, a Federal reserve bank, the Federal Deposit Insurance Corporation, or the National Credit Union Administration shall be credited as periods of service with a Federal agency." ;
  fro-usc:hasHeading "Service credit for reductions in force" ;
  fro-usc:hasId "id83b25a68-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/h/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
