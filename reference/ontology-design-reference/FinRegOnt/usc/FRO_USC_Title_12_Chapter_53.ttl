fro-usc-t12-ch53:id83ab2dc1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-3-5-3> ;
  fro-usc:hasContentText "reports pertaining to persons described in subsection (a)(1) that have been provided or required to have been provided to a Federal or State agency; and" ;
  fro-usc:hasId "id83ab2dc1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2dc2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-3-5-4> ;
  fro-usc:hasContentText "information that has been reported publicly." ;
  fro-usc:hasId "id83ab2dc2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/4/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2dc3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-3-6> ;
  fro-usc:hasContentText "Nothing in this title  may be construed as limiting the authority of the Director to require reports from persons described in subsection (a)(1), as permitted under paragraph (1), regarding information owned or under the control of such person, regardless of whether such information is maintained, stored, or processed by another person." ;
  fro-usc:hasHeading "Preservation of authority" ;
  fro-usc:hasId "id83ab2dc3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83ab2dc4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-3-7> ;
  fro-usc:hasContentText "The Bureau shall provide the Commissioner of Internal Revenue with any report of examination or related information identifying possible tax law noncompliance." ;
  fro-usc:hasHeading "Reports of tax law noncompliance" ;
  fro-usc:hasId "id83ab2dc4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id83ab2dc5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-3-8> ;
  fro-usc:hasHeading "Registration, recordkeeping and other requirements for certain persons" ;
  fro-usc:hasId "id83ab2dc5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/7" ;
  fro-usc:hasNumberText "(7)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dc6-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dc7-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dc8-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dc9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2dc6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-3-8-2> ;
  fro-usc:hasContentText "The Bureau shall prescribe rules to facilitate supervision of persons described in subsection (a)(1) and assessment and detection of risks to consumers." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2dc6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/7/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2dc7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-3-8-3> ;
  fro-usc:hasContentText "The Bureau may require a person described in subsection (a)(1), to generate, provide, or retain records for the purposes of facilitating supervision of such persons and assessing and detecting risks to consumers." ;
  fro-usc:hasHeading "Recordkeeping" ;
  fro-usc:hasId "id83ab2dc7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/7/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2dc8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-3-8-4> ;
  fro-usc:hasContentText "The Bureau may prescribe rules regarding a person described in subsection (a)(1), to ensure that such persons are legitimate entities and are able to perform their obligations to consumers. Such requirements may include background checks for principals, officers, directors, or key personnel and bonding or other appropriate financial requirements." ;
  fro-usc:hasHeading "Requirements concerning obligations" ;
  fro-usc:hasId "id83ab2dc8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/7/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ab2dc9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-3-8-5> ;
  fro-usc:hasContentText "In developing and implementing requirements under this paragraph, the Bureau shall consult with State agencies regarding requirements or systems (including coordinated or combined systems for registration), where appropriate." ;
  fro-usc:hasHeading "Consultation with State agencies" ;
  fro-usc:hasId "id83ab2dc9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/7/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83ab2dca-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2dcb-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2dcc-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2dcd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4> ;
  fro-usc:hasHeading "Enforcement authority" ;
  fro-usc:hasId "id83ab2dca-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83ab2dcb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-2> ;
  fro-usc:hasContentText "Except as provided in paragraph (3) and section 5581 of this title , with respect to any person described in subsection (a)(1), to the extent that Federal law authorizes the Bureau and another Federal agency to enforce Federal consumer financial law, the Bureau shall have exclusive authority to enforce that Federal consumer financial law." ;
  fro-usc:hasHeading "The Bureau to have enforcement authority" ;
  fro-usc:hasId "id83ab2dcb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5581" ;
.
fro-usc-t12-ch53:id83ab2dcc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-3> ;
  fro-usc:hasContentText "Any Federal agency authorized to enforce a Federal consumer financial law described in paragraph (1) may recommend in writing to the Bureau that the Bureau initiate an enforcement proceeding, as the Bureau is authorized by that Federal law or by this title." ;
  fro-usc:hasHeading "Referral" ;
  fro-usc:hasId "id83ab2dcc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ab2dcd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-4> ;
  fro-usc:hasHeading "Coordination with the Federal Trade Commission" ;
  fro-usc:hasId "id83ab2dcd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dce-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dcf-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dd4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dd5-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2dce-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-4-2> ;
  fro-usc:hasContentText "The Bureau and the Federal Trade Commission shall negotiate an agreement for coordinating with respect to enforcement actions by each agency regarding the offering or provision of consumer financial products or services by any covered person that is described in subsection (a)(1), or service providers thereto. The agreement shall include procedures for notice to the other agency, where feasible, prior to initiating a civil action to enforce any Federal law regarding the offering or provision of consumer financial products or services." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2dce-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2dcf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-4-3> ;
  fro-usc:hasHeading "Civil actions" ;
  fro-usc:hasId "id83ab2dcf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-5-4-4-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dd0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dd1-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2dd0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-4-3-3> ;
  fro-usc:hasContentText "the other agency may not, during the pendency of that action, institute a civil action under such provision of law against any defendant named in the complaint in such pending action for any violation alleged in the complaint; and" ;
  fro-usc:hasId "id83ab2dd0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/3/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ab2dd1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-4-3-4> ;
  fro-usc:hasId "id83ab2dd1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/3/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-5-4-4-3-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dd2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dd3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2dd2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-4-3-4-2> ;
  fro-usc:hasContentText "be heard on all matters arising in such enforcement action; and" ;
  fro-usc:hasId "id83ab2dd2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/3/B/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83ab2dd3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-4-3-4-3> ;
  fro-usc:hasContentText "file petitions for appeal in such actions." ;
  fro-usc:hasId "id83ab2dd3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/3/B/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83ab2dd4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-4-4> ;
  fro-usc:hasContentText "The terms of any agreement negotiated under subparagraph (A) may modify or supersede the provisions of subparagraph (B)." ;
  fro-usc:hasHeading "Agreement terms" ;
  fro-usc:hasId "id83ab2dd4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ab2dd5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-4-4-5> ;
  fro-usc:hasContentText "The agencies shall reach the agreement required under subparagraph (A) not later than 6 months after the designated transfer date." ;
  fro-usc:hasHeading "Deadline" ;
  fro-usc:hasId "id83ab2dd5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/c/3/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83ab2dd6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-5> ;
  fro-usc:hasContentText "Notwithstanding any other provision of Federal law and except as provided in section 5581 of this title , to the extent that Federal law authorizes the Bureau and another Federal agency to issue regulations or guidance, conduct examinations, or require reports from a person described in subsection (a)(1) under such law for purposes of assuring compliance with Federal consumer financial law and any regulations thereunder, the Bureau shall have the exclusive authority to prescribe rules, issue guidance, conduct examinations, require reports, or issue exemptions with regard to a person described in subsection (a)(1), subject to those provisions of law." ;
  fro-usc:hasHeading "Exclusive rulemaking and examination authority" ;
  fro-usc:hasId "id83ab2dd6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5581" ;
.
fro-usc-t12-ch53:id83ab2dd7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-6> ;
  fro-usc:hasContentText "A service provider to a person described in subsection (a)(1) shall be subject to the authority of the Bureau under this section, to the same extent as if such service provider were engaged in a service relationship with a bank, and the Bureau were an appropriate Federal banking agency under section 1867(c) of this title . In conducting any examination or requiring any report from a service provider subject to this subsection, the Bureau shall coordinate with the appropriate prudential regulator, as applicable." ;
  fro-usc:hasHeading "Service providers" ;
  fro-usc:hasId "id83ab2dd7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1867/c" ;
.
fro-usc-t12-ch53:id83ab2dd8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-7> ;
  fro-usc:hasContentText "No provision of this title  may be construed as modifying, limiting, or otherwise affecting the authority of the Farm Credit Administration." ;
  fro-usc:hasHeading "Preservation of Farm Credit Administration authority" ;
  fro-usc:hasId "id83ab2dd8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83ab2dd9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-usc:hasId "id83ab2dd9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/pl/113/173" ;
  fro-usc:hasReferenceText "/us/stat/124/1987" ;
  fro-usc:hasReferenceText "/us/stat/128/1899" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , 128 Stat. 1899 .) , § 1024, July 21, 2010 , 124 Stat. 1987 ; Pub. L. 113–173 , § 2, Sept. 26, 2014" ;
.
fro-usc-t12-ch53:id83ab2ddb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-9-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83ab2ddb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This title, where footnoted in subsecs. (a)(1), (b)(5), (c)(2), and (f), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2ddc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-9-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "id83ab2ddc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "2014—Subsec. (b)(3). Pub. L. 113–173 substituted “regulators, the State bank regulatory authorities, and the State agencies that licence, supervise, or examine the offering of consumer financial products or services” for “regulators and the State bank regulatory authorities” and inserted at end “The sharing of information with such regulators, authorities, and agencies shall not be construed as waiving, destroying, or otherwise affecting any privilege or confidentiality such person may claim with respect to such information under Federal or State law as to any person or entity other than such Bureau, agency, supervisor, or authority.”" ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/113/173" ;
.
