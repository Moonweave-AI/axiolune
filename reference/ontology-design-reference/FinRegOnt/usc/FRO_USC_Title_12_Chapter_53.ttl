fro-usc-t12-ch53:id83a19181-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-3-3-3-2> ;
  fro-usc:hasContentText "All rulemaking authority of the Office of Thrift Supervision and the Director of the Office of Thrift Supervision under section 1468 of this title relating to transactions with affiliates and extensions of credit to executive officers, directors, and principal shareholders and under section 1464(q) of this title relating to tying arrangements is transferred to the Board of Governors." ;
  fro-usc:hasHeading "Board of Governors" ;
  fro-usc:hasId "id83a19181-1df7-11e6-87ee-8e4a3ab90f2a" ;
