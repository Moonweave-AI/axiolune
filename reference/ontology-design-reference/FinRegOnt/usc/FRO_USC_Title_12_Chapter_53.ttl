  fro-usc:hasReferenceText "/us/stat/124/2018" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1051, July 21, 2010 , 124 Stat. 2018 .)" ;
.
fro-usc-t12-ch53:id83ad78b6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-2-9-0> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83ad78b6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Pub. L. 111–203, title X , § 1058, July 21, 2010 , 124 Stat. 2035 , provided that:" ;
  fro-usc:hasNoteText "[The term “designated transfer date” is defined in section 5481(9) of this title as the date established under section 5582 of this title .]" ;
  fro-usc:hasNoteTopic "effectiveDate" ;
