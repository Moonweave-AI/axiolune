  fro-usc:hasHeading "Extension of time limit" ;
  fro-usc:hasId "id83981bbf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/d/2" ;
  fro-usc:hasNumberText "(2)" ;
