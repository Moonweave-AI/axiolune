  fro-leg-ref:divided_by fro-usc-t12-ch53:id8393614b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-7-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83936147-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5326/a" ;
