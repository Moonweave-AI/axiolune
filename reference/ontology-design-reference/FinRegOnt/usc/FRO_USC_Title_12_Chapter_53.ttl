.
fro-usc-t12-ch53:id83a67369-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-5-2-2-4> ;
  fro-usc:hasContentText "the rules or orders prescribed under this subchapter." ;
  fro-usc:hasId "id83a67369-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/d/1/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a6736a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-5-2-3> ;
  fro-usc:hasContentText "Upon receipt of an appropriate written request, the Board of Governors will conduct the examination under such terms and conditions to which the Board of Governors and the appropriate financial regulator mutually agree." ;
  fro-usc:hasHeading "Examination by Board of Governors" ;
  fro-usc:hasId "id83a6736a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/d/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
