.
fro-usc-t12-ch53:id839f4743-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-7-2-4> ;
  fro-usc:hasContentText "acting based upon a suit, claim, or cause of action purchased from, assigned by, or otherwise conveyed by the Corporation as receiver; or" ;
  fro-usc:hasId "id839f4743-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/f/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
