  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-7-4-3> ;
  fro-usc:hasHeading "Commission authority relating to rules prescribed by the Bureau" ;
  fro-usc:hasId "id83afe9be-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5581/b/5/C/ii" ;
