  fro-usc:hasContentText "an insured depository institution with total assets of $10,000,000,000 or less; or" ;
  fro-usc:hasId "id83ab2e14-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5516/a/1" ;
