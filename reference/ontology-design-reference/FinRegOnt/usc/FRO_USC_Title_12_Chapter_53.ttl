  fro-usc:hasContentText "the Council; and" ;
  fro-usc:hasId "id8395aa94-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5332/a/1" ;
