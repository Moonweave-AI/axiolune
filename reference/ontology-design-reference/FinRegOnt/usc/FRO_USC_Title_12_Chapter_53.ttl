  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1035, July 21, 2010 , 124 Stat. 2009 .)" ;
.
fro-usc-t12-ch53:id83ad780d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
