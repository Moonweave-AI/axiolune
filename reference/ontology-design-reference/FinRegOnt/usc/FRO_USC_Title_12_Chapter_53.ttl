  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1016B, as added Pub. L. 112–10, div. B, title V , § 1573(a), Apr. 15, 2011 , 125 Stat. 138 .)" ;
.
fro-usc-t12-ch53:id83a8bcfe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-9-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a8bcfe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The date of the enactment of this Act, referred to in subsec. (a), probably means the date of enactment of Pub. L. 112–10 , which enacted this section and was approved Apr. 15, 2011 ." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/112/10" ;
.
