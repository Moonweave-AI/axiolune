  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f47c6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/8/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-15-9-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47c7-1df7-11e6-87ee-8e4a3ab90f2a ;
