  fro-usc:hasContentText "providing annual reports to Congress on the efforts of the Bureau to fulfill its fair lending mandate." ;
  fro-usc:hasId "id83a8bc93-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/c/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
