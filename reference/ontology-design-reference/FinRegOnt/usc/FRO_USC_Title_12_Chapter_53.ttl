fro-usc-t12-ch53:id83a1920b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-11> ;
  fro-usc:hasContentText "Not later than 30 months after the transfer date, the Comptroller of the Currency and the Chairperson of the Corporation shall place each transferred employee into the established pay system and structure of the appropriate employing agency." ;
  fro-usc:hasHeading "Incorporation into agency pay system" ;
  fro-usc:hasId "id83a1920b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/j" ;
  fro-usc:hasNumberText "(j)" ;
.
fro-usc-t12-ch53:id83a1920c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1920d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1920e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1920f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19210-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-12> ;
  fro-usc:hasHeading "Equitable treatment" ;
  fro-usc:hasId "id83a1920c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/k" ;
  fro-usc:hasNumberText "(k)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-5-3-12-2> ;
.
fro-usc-t12-ch53:id83a1920d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-12-3> ;
  fro-usc:hasContentText "may not take any action that would unfairly disadvantage a transferred employee relative to any other employee of the Office of the Comptroller of the Currency or the Corporation on the basis of prior employment by the Office of Thrift Supervision;" ;
  fro-usc:hasId "id83a1920d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/k/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a1920e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-12-4> ;
  fro-usc:hasContentText "may take such action as is appropriate in an individual case to ensure that a transferred employee receives equitable treatment, with respect to the status, tenure, pay, benefits (other than benefits under programs administered by the Office of Personnel Management), and accrued leave or vacation time for prior periods of service with any Federal agency of the transferred employee;" ;
  fro-usc:hasId "id83a1920e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/k/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a1920f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-12-5> ;
  fro-usc:hasContentText "shall, jointly with the Director of the Office of Thrift Supervision, develop and adopt procedures and safeguards designed to ensure that the requirements of this subsection are met; and" ;
  fro-usc:hasId "id83a1920f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/k/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a19210-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-12-6> ;
  fro-usc:hasContentText "shall conduct a study detailing the position assignments of all employees transferred pursuant to subsection (a), describing the procedures and safeguards adopted pursuant to paragraph (3), and demonstrating that the requirements of this subsection have been met; and shall, not later than 365 days after the transfer date, submit a copy of such study to Congress." ;
  fro-usc:hasId "id83a19210-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/k/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a19211-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19212-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19213-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-13> ;
  fro-usc:hasHeading "Reorganization" ;
  fro-usc:hasId "id83a19211-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/l" ;
  fro-usc:hasNumberText "(l)" ;
.
fro-usc-t12-ch53:id83a19212-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-13-2> ;
  fro-usc:hasContentText "If the Comptroller of the Currency or the Chairperson of the Corporation determines, during the 2-year period beginning 1 year after the transfer date, that a reorganization of the staff of the Office of the Comptroller of the Currency or the Corporation, respectively, is required, the reorganization shall be deemed a “major reorganization” for purposes of affording affected employees retirement under section 8336(d)(2) or 8414(b)(1)(B) of title 5." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a19212-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/l/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a19213-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-13-3> ;
  fro-usc:hasContentText "For purposes of this subsection, periods of service with a Federal home loan bank or a joint office of Federal home loan banks shall be credited as periods of service with a Federal agency." ;
  fro-usc:hasHeading "Service credit" ;
  fro-usc:hasId "id83a19213-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/l/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a19214-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-usc:hasId "id83a19214-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1529" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title III , § 322, July 21, 2010 , 124 Stat. 1529 .)" ;
.
fro-usc-t12-ch53:id83a19216-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-15-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a19216-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This title, referred to in subsecs. (a)(1)(B)(i) and (i)(2)(A)(i), (E)(i), is title III of Pub. L. 111–203 , 78 o –5, and 78w of Title 15, Commerce and Trade, sections 212, 657, 981, 982, 1006, 1014, and 1032 of Title 18, Crimes and Criminal Procedure, sections 321 and 714 of Title 31, Money and Finance, sections 4003 and 8105 of Title 42, The Public Health and Welfare, and section 3502 of Title 44 , Public Printing and Documents, repealed section 1441a of this title , enacted provisions set out as notes under sections 1, 16, 1438, 1787, 1812, 1817, and 1821 of this title and section 906 of Title 2 , and amended provisions set out as notes under sections 1437, 1463, 1464, 1467a, 1707, 1812, and 1818 of this title and section 509 of Title 28 , Judiciary and Judicial Procedure. For complete classification of title III to the Code, see Short title note set out under section 5301 of this title and Tables. , July 21, 2010 , 124 Stat. 1520 , known as the Enhancing Financial Institution Safety and Soundness Act of 2010, which enacted this subchapter and sections 4b and 16 of this title, amended sections 1, 11, 248, 461, 481, 482, 1438, 1462, 1462a, 1463, to 1464, 1466a, 1467, 1467a, 1468, 1468a, to 1468b, 1470, 1701c, 1701p–1, 1708, 1757, 1785, 1786, 1787, 1812, 1813, 1817, 1818, 1820, 1821, 1823, 1828, 1829, 1831e, 1831j, 1833b, 1833e, 1834, 1841, 1843, 1844, 1861, 1867, 1881, 1882, 1884, 1972, 2709, 2902, 2905, 3206 to 3208, 3332, 4515, and 4517 of this title, section 906 of Title 2 , The Congress, sections 78c, 78 l" ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1520" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1441a" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:hasReferenceText "/us/usc/t2/s906" ;
  fro-usc:hasReferenceText "/us/usc/t28/s509" ;
  fro-usc:hasReferenceText "/us/usc/t44/s3502" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a19217-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19218-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19219-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4021c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4021d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83a40220-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-4> ;
  fro-usc:hasHeading "Property transferred" ;
  fro-usc:hasId "id83a19217-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5433" ;
  fro-usc:hasNumberText "§ 5433." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4021e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a19218-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-4-2> ;
  fro-usc:hasContentText "For purposes of this section, the term “property” includes all real property (including leaseholds) and all personal property, including computers, furniture, fixtures, equipment, books, accounts, records, reports, files, memoranda, paper, reports of examination, work papers, and correspondence related to such reports, and any other information or materials." ;
  fro-usc:hasHeading "Property defined" ;
  fro-usc:hasId "id83a19218-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5433/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a19219-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1921a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1921b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-4-3> ;
  fro-usc:hasHeading "Property of the Office of Thrift Supervision" ;
  fro-usc:hasId "id83a19219-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5433/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a1921a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-4-3-2> ;
  fro-usc:hasContentText "No later than 90 days after the transfer date, all property of the Office of Thrift Supervision (other than property described under paragraph (b)(2)) that the Comptroller of the Currency and the Chairperson of the Corporation jointly determine is used, on the day before the transfer date, to perform or support the functions of the Office of Thrift Supervision transferred to the Office of the Comptroller of the Currency or the Corporation under this title, 1 shall be transferred to the Office of the Comptroller of the Currency or the Corporation in a manner consistent with the transfer of employees under this part." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a1921a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5433/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a1921b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-4-3-3> ;
  fro-usc:hasContentText "All books, accounts, records, reports, files, memoranda, papers, documents, reports of examination, work papers, and correspondence of the Office of Thrift Supervision that the Comptroller of the Currency, the Chairperson of the Corporation, and the Chairman of the Board of Governors jointly determine is used, on the day before the transfer date, to perform or support the functions of the Office of Thrift Supervision transferred to the Board of Governors under this title  shall be transferred to the Board of Governors in a manner consistent with the purposes of this title." ;
  fro-usc:hasHeading "Personal property" ;
  fro-usc:hasId "id83a1921b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5433/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a4021c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-4-4> ;
  fro-usc:hasContentText "Each contract, agreement, lease, license, permit, and similar arrangement relating to property transferred to the Office of the Comptroller of the Currency or the Corporation by this section shall be transferred to the Office of the Comptroller of the Currency or the Corporation, as appropriate, together with the property to which it relates." ;
  fro-usc:hasHeading "Contracts related to property transferred" ;
  fro-usc:hasId "id83a4021c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5433/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a4021d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-4-5> ;
  fro-usc:hasContentText "Property identified for transfer under this section shall not be altered, destroyed, or deleted before transfer under this section." ;
  fro-usc:hasHeading "Preservation of property" ;
  fro-usc:hasId "id83a4021d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5433/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83a4021e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
