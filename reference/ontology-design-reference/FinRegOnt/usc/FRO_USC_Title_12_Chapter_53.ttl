.
fro-usc-t12-ch53:id83a40356-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-7-2-3> ;
  fro-usc:hasId "id83a40356-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/f/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-7-7-2-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40357-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40358-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40357-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-7-2-3-2> ;
  fro-usc:hasContentText "an action engaged in, or contemplated by, a designated financial market utility (including any change proposed by the designated financial market utility to its rules, procedures, or operations that would otherwise be subject to section 5465(e) of this title ) poses an imminent risk of substantial harm to financial institutions, critical markets, or the broader financial system of the United States; or" ;
  fro-usc:hasId "id83a40357-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/f/1/A/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5465/e" ;
.
fro-usc-t12-ch53:id83a40358-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-7-2-3-3> ;
  fro-usc:hasContentText "the condition of a designated financial market utility poses an imminent risk of substantial harm to financial institutions, critical markets, or the broader financial system; and" ;
  fro-usc:hasId "id83a40358-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/f/1/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a40359-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-7-2-4> ;
  fro-usc:hasContentText "the imminent risk of substantial harm precludes the Board of Governors’ use of the procedures in subsection (e)." ;
  fro-usc:hasId "id83a40359-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/f/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a6735a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-7-3> ;
  fro-usc:hasContentText "For purposes of taking enforcement action under paragraph (1), a designated financial market utility shall be subject to, and the Board of Governors shall have authority under  2 the provisions of subsections (b) through (n) of section 1818 of this title in the same manner and to the same extent as if the designated financial market utility was an insured depository institution and the Board of Governors was the appropriate Federal banking agency for such insured depository institution." ;
  fro-usc:hasHeading "Enforcement authority" ;
  fro-usc:hasId "id83a6735a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/f/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1818" ;
.
fro-usc-t12-ch53:id83a6735b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-usc:hasId "id83a6735b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tVIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1814" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title VIII , § 807, July 21, 2010 , 124 Stat. 1814 .)" ;
.
