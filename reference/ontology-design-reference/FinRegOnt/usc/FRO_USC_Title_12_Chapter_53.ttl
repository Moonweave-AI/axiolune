  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-5> ;
  fro-usc:hasHeading "Status of regulations proposed or not yet effective" ;
  fro-usc:hasId "id83a191a7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/d" ;
