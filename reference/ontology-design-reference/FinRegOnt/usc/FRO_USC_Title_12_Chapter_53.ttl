  fro-usc:hasHeading "Foreign nonbank financial companies supervised by the Board of Governors" ;
  fro-usc:hasId "id839360d9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/b" ;
