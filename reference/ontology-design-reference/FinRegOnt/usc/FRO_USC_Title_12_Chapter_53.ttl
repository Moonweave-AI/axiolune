  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12> ;
  fro-usc:hasHeading "IMPROVING ACCESS TO MAINSTREAM FINANCIAL INSTITUTIONS" ;
  fro-usc:hasId "id83b4a44e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/ch53/schVII" ;
  fro-usc:hasNumberText "SUBCHAPTER VII—" ;
.
fro-usc-t12-ch53:id83b4a44f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b4a452-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b4a453-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b4a454-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-2> ;
  fro-usc:hasContentText "The purpose of this subchapter is to encourage initiatives for financial products and services that are appropriate and accessible for millions of Americans who are not fully incorporated into the financial mainstream." ;
  fro-usc:hasHeading "Purpose" ;
  fro-usc:hasId "id83b4a44f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5621" ;
  fro-usc:hasNumberText "§ 5621." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a450-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a450-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
