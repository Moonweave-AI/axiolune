  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-14-2-2-10> ;
  fro-usc:hasContentText "other limitations on the activities or structure of large financial institutions that may be useful to limit systemic risk." ;
  fro-usc:hasId "id8395aaa7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5333/a/1/H" ;
  fro-usc:hasNumberText "(H)" ;
.
