  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 25 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-25> ;
  fro-usc:hasHeading "Person that performs income tax preparation activities for consumers" ;
  fro-usc:hasId "id83a6741b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/23" ;
  fro-usc:hasNumberText "(23)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-25-2> ;
