.
fro-usc-t12-ch53:id8395aba7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-3-3> ;
  fro-usc:hasContentText "the nature and extent to which the company has credit exposure to other significant nonbank financial companies and significant bank holding companies; and" ;
  fro-usc:hasId "id8395aba7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395aba8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-3-4> ;
  fro-usc:hasContentText "the nature and extent to which other significant nonbank financial companies and significant bank holding companies have credit exposure to that company." ;
  fro-usc:hasId "id8395aba8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8395aba9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-4> ;
  fro-usc:hasContentText "The Board of Governors and the Corporation shall review the information provided in accordance with this subsection by each nonbank financial company supervised by the Board of Governors and bank holding company described in subsection (a)." ;
  fro-usc:hasHeading "Review" ;
  fro-usc:hasId "id8395aba9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id8395abaa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-5> ;
  fro-usc:hasHeading "Notice of deficiencies" ;
  fro-usc:hasId "id8395abaa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-6-5-5-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id8395abab-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395abac-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395abab-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-5-3> ;
  fro-usc:hasContentText "the Board of Governors and the Corporation shall notify the company of the deficiencies in the resolution plan; and" ;
  fro-usc:hasId "id8395abab-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395abac-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-5-4> ;
  fro-usc:hasContentText "the company shall resubmit the resolution plan within a timeframe determined by the Board of Governors and the Corporation, with revisions demonstrating that the plan is credible and would result in an orderly resolution under title 11, including any proposed changes in business operations and corporate structure to facilitate implementation of the plan." ;
  fro-usc:hasId "id8395abac-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/4/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8395abad-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-6> ;
  fro-usc:hasHeading "Failure to resubmit credible plan" ;
  fro-usc:hasId "id8395abad-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/5" ;
  fro-usc:hasNumberText "(5)" ;
  lkif-mereo:component fro-usc-t12-ch53:id8395abae-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395abaf-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395abae-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-6-2> ;
  fro-usc:hasContentText "If a nonbank financial company supervised by the Board of Governors or a bank holding company described in subsection (a) fails to timely resubmit the resolution plan as required under paragraph (4), with such revisions as are required under subparagraph (B), the Board of Governors and the Corporation may jointly impose more stringent capital, leverage, or liquidity requirements, or restrictions on the growth, activities, or operations of the company, or any subsidiary thereof, until such time as the company resubmits a plan that remedies the deficiencies." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id8395abae-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/5/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395abaf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-6-3> ;
  fro-usc:hasHeading "Divestiture" ;
  fro-usc:hasId "id8395abaf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/5/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-6-5-6-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id8395abb0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395abb1-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395abb0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-6-3-3> ;
  fro-usc:hasContentText "the Board of Governors and the Corporation have jointly imposed more stringent requirements on the company pursuant to subparagraph (A); and" ;
  fro-usc:hasId "id8395abb0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/5/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id8395abb1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-6-3-4> ;
  fro-usc:hasContentText "the company has failed, within the 2-year period beginning on the date of the imposition of such requirements under subparagraph (A), to resubmit the resolution plan with such revisions as were required under paragraph (4)(B)." ;
  fro-usc:hasId "id8395abb1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/5/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id8395abb2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-7> ;
  fro-usc:hasContentText "A resolution plan submitted in accordance with this subsection shall not be binding on a bankruptcy court, a receiver appointed under subchapter II, or any other authority that is authorized or required to resolve the nonbank financial company supervised by the Board, any bank holding company, or any subsidiary or affiliate of the foregoing." ;
  fro-usc:hasHeading "No limiting effect" ;
  fro-usc:hasId "id8395abb2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id8395abb3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-8> ;
  fro-usc:hasContentText "No private right of action may be based on any resolution plan submitted in accordance with this subsection." ;
  fro-usc:hasHeading "No private right of action" ;
  fro-usc:hasId "id8395abb3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/7" ;
  fro-usc:hasNumberText "(7)" ;
.
fro-usc-t12-ch53:id8395abb4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-5-9> ;
  fro-usc:hasContentText "Not later than 18 months after July 21, 2010 , the Board of Governors and the Corporation shall jointly issue final rules implementing this subsection." ;
  fro-usc:hasHeading "Rules" ;
  fro-usc:hasId "id8395abb4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/8" ;
  fro-usc:hasNumberText "(8)" ;
.
fro-usc-t12-ch53:id8395abb5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395abb6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395abb7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395abb8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981abf-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ac0-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ac1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ac2-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6> ;
  fro-usc:hasHeading "Concentration limits" ;
  fro-usc:hasId "id8395abb5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id8395abb6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-2> ;
  fro-usc:hasContentText "In order to limit the risks that the failure of any individual company could pose to a nonbank financial company supervised by the Board of Governors or a bank holding company described in subsection (a), the Board of Governors, by regulation, shall prescribe standards that limit such risks." ;
  fro-usc:hasHeading "Standards" ;
  fro-usc:hasId "id8395abb6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395abb7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-3> ;
  fro-usc:hasContentText "The regulations prescribed by the Board of Governors under paragraph (1) shall prohibit each nonbank financial company supervised by the Board of Governors and bank holding company described in subsection (a) from having credit exposure to any unaffiliated company that exceeds 25 percent of the capital stock and surplus (or such lower amount as the Board of Governors may determine by regulation to be necessary to mitigate risks to the financial stability of the United States) of the company." ;
  fro-usc:hasHeading "Limitation on credit exposure" ;
  fro-usc:hasId "id8395abb7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395abb8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-4> ;
  fro-usc:hasHeading "Credit exposure" ;
  fro-usc:hasId "id8395abb8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-6-6-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id8395abb9-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395abba-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981abb-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981abc-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981abd-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981abe-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395abb9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-4-3> ;
  fro-usc:hasContentText "all extensions of credit to the company, including loans, deposits, and lines of credit;" ;
  fro-usc:hasId "id8395abb9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395abba-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-4-4> ;
  fro-usc:hasContentText "all repurchase agreements and reverse repurchase agreements with the company, and all securities borrowing and lending transactions with the company, to the extent that such transactions create credit exposure for the nonbank financial company supervised by the Board of Governors or a bank holding company described in subsection (a);" ;
  fro-usc:hasId "id8395abba-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981abb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-4-5> ;
  fro-usc:hasContentText "all guarantees, acceptances, or letters of credit (including endorsement or standby letters of credit) issued on behalf of the company;" ;
  fro-usc:hasId "id83981abb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83981abc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-4-6> ;
  fro-usc:hasContentText "all purchases of or investment in securities issued by the company;" ;
  fro-usc:hasId "id83981abc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/3/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83981abd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-4-7> ;
  fro-usc:hasContentText "counterparty credit exposure to the company in connection with a derivative transaction between the nonbank financial company supervised by the Board of Governors or a bank holding company described in subsection (a) and the company; and" ;
  fro-usc:hasId "id83981abd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/3/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83981abe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-4-8> ;
  fro-usc:hasContentText "any other similar transactions that the Board of Governors, by regulation, determines to be a credit exposure for purposes of this section." ;
  fro-usc:hasId "id83981abe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/3/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id83981abf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-5> ;
  fro-usc:hasContentText "For purposes of this subsection, any transaction by a nonbank financial company supervised by the Board of Governors or a bank holding company described in subsection (a) with any person is a transaction with a company, to the extent that the proceeds of the transaction are used for the benefit of, or transferred to, that company." ;
  fro-usc:hasHeading "Attribution rule" ;
  fro-usc:hasId "id83981abf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83981ac0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-6> ;
  fro-usc:hasContentText "The Board of Governors may issue such regulations and orders, including definitions consistent with this section, as may be necessary to administer and carry out this subsection." ;
  fro-usc:hasHeading "Rulemaking" ;
  fro-usc:hasId "id83981ac0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83981ac1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-7> ;
  fro-usc:hasContentText "This subsection shall not apply to any Federal home loan bank. The Board of Governors may, by regulation or order, exempt transactions, in whole or in part, from the definition of the term “credit exposure” for purposes of this subsection, if the Board of Governors finds that the exemption is in the public interest and is consistent with the purpose of this subsection." ;
  fro-usc:hasHeading "Exemptions" ;
  fro-usc:hasId "id83981ac1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id83981ac2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-8> ;
  fro-usc:hasHeading "Transition period" ;
  fro-usc:hasId "id83981ac2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/7" ;
  fro-usc:hasNumberText "(7)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ac3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ac4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981ac3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-8-2> ;
  fro-usc:hasContentText "This subsection and any regulations and orders of the Board of Governors under this subsection shall not be effective until 3 years after July 21, 2010 ." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83981ac3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/7/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981ac4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-6-8-3> ;
  fro-usc:hasContentText "The Board of Governors may extend the period specified in subparagraph (A) for not longer than an additional 2 years." ;
  fro-usc:hasHeading "Extension authorized" ;
  fro-usc:hasId "id83981ac4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/e/7/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981ac5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-7> ;
  fro-usc:hasContentText "The Board of Governors may prescribe, by regulation, periodic public disclosures by nonbank financial companies supervised by the Board of Governors and bank holding companies described in subsection (a) in order to support market evaluation of the risk profile, capital adequacy, and risk management capabilities thereof." ;
  fro-usc:hasHeading "Enhanced public disclosures" ;
  fro-usc:hasId "id83981ac5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83981ac6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ac7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ac8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ac9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981aca-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981acb-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-8> ;
  fro-usc:hasHeading "Short-term debt limits" ;
  fro-usc:hasId "id83981ac6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id83981ac7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-8-2> ;
  fro-usc:hasContentText "In order to mitigate the risks that an over-accumulation of short-term debt could pose to financial companies and to the stability of the United States financial system, the Board of Governors may, by regulation, prescribe a limit on the amount of short-term debt, including off-balance sheet exposures, that may be accumulated by any bank holding company described in subsection (a) and any nonbank financial company supervised by the Board of Governors." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83981ac7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/g/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83981ac8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-8-3> ;
  fro-usc:hasContentText "Any limit prescribed under paragraph (1) shall be based on the short-term debt of the company described in paragraph (1) as a percentage of capital stock and surplus of the company or on such other measure as the Board of Governors considers appropriate." ;
  fro-usc:hasHeading "Basis of limit" ;
  fro-usc:hasId "id83981ac8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/g/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83981ac9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-8-4> ;
  fro-usc:hasContentText "For purposes of this subsection, the term “short-term debt” means such liabilities with short-dated maturity that the Board of Governors identifies, by regulation, except that such term does not include insured deposits." ;
  fro-usc:hasHeading "Short-term debt defined" ;
  fro-usc:hasId "id83981ac9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/g/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83981aca-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-8-5> ;
  fro-usc:hasContentText "In addition to prescribing regulations under paragraphs (1) and (3), the Board of Governors may prescribe such regulations, including definitions consistent with this subsection, and issue such orders, as may be necessary to carry out this subsection." ;
  fro-usc:hasHeading "Rulemaking authority" ;
  fro-usc:hasId "id83981aca-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/g/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83981acb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-8-6> ;
  fro-usc:hasContentText "Notwithstanding the Bank Holding Company Act of 1956 ( 12 U.S.C. 1841 et seq.), the Board of Governors may, if it determines such action is necessary to ensure appropriate heightened prudential supervision, with respect to a company described in paragraph (1) that does not control an insured depository institution, issue to such company an exemption from or adjustment to the limit prescribed under paragraph (1)." ;
  fro-usc:hasHeading "Authority to issue exemptions and adjustments" ;
  fro-usc:hasId "id83981acb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/g/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841" ;
.
fro-usc-t12-ch53:id83981acc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981acd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ace-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ad1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ad5-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-9> ;
  fro-usc:hasHeading "Risk committee" ;
  fro-usc:hasId "id83981acc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/h" ;
  fro-usc:hasNumberText "(h)" ;
.
fro-usc-t12-ch53:id83981acd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-9-2> ;
  fro-usc:hasContentText "The Board of Governors shall require each nonbank financial company supervised by the Board of Governors that is a publicly traded company to establish a risk committee, as set forth in paragraph (3), not later than 1 year after the date of receipt of a notice of final determination under section 5323(e)(3) of this title with respect to such nonbank financial company supervised by the Board of Governors." ;
  fro-usc:hasHeading "Nonbank financial companies supervised by the Board of Governors" ;
  fro-usc:hasId "id83981acd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/h/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5323/e/3" ;
.
fro-usc-t12-ch53:id83981ace-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-9-3> ;
  fro-usc:hasHeading "Certain bank holding companies" ;
  fro-usc:hasId "id83981ace-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/h/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83981acf-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ad0-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981acf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-9-3-2> ;
  fro-usc:hasContentText "The Board of Governors shall issue regulations requiring each bank holding company that is a publicly traded company and that has total consolidated assets of not less than $10,000,000,000 to establish a risk committee, as set forth in paragraph (3)." ;
  fro-usc:hasHeading "Mandatory regulations" ;
  fro-usc:hasId "id83981acf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/h/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981ad0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-9-3-3> ;
  fro-usc:hasContentText "The Board of Governors may require each bank holding company that is a publicly traded company and that has total consolidated assets of less than $10,000,000,000 to establish a risk committee, as set forth in paragraph (3), as determined necessary or appropriate by the Board of Governors to promote sound risk management practices." ;
  fro-usc:hasHeading "Permissive regulations" ;
  fro-usc:hasId "id83981ad0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/h/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981ad1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-9-4> ;
  fro-usc:hasHeading "Risk committee" ;
  fro-usc:hasId "id83981ad1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/h/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-6-9-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ad2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ad3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ad4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981ad2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-9-4-3> ;
  fro-usc:hasContentText "be responsible for the oversight of the enterprise-wide risk management practices of the nonbank financial company supervised by the Board of Governors or bank holding company described in subsection (a), as applicable;" ;
  fro-usc:hasId "id83981ad2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/h/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981ad3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-9-4-4> ;
  fro-usc:hasContentText "include such number of independent directors as the Board of Governors may determine appropriate, based on the nature of operations, size of assets, and other appropriate criteria related to the nonbank financial company supervised by the Board of Governors or a bank holding company described in subsection (a), as applicable; and" ;
  fro-usc:hasId "id83981ad3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/h/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981ad4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-9-4-5> ;
  fro-usc:hasContentText "include at least 1 risk management expert having experience in identifying, assessing, and managing risk exposures of large, complex firms." ;
  fro-usc:hasId "id83981ad4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/h/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83981ad5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-9-5> ;
  fro-usc:hasContentText "The Board of Governors shall issue final rules to carry out this subsection, not later than 1 year after the transfer date, to take effect not later than 15 months after the transfer date." ;
  fro-usc:hasHeading "Rulemaking" ;
  fro-usc:hasId "id83981ad5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/h/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83981ad6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ad7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981adf-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10> ;
  fro-usc:hasHeading "Stress tests" ;
  fro-usc:hasId "id83981ad6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83981ad7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-2> ;
  fro-usc:hasHeading "By the Board of Governors" ;
  fro-usc:hasId "id83981ad7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ad8-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ad9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981ad8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-2-2> ;
  fro-usc:hasContentText "The Board of Governors, in coordination with the appropriate primary financial regulatory agencies and the Federal Insurance Office, shall conduct annual analyses in which nonbank financial companies supervised by the Board of Governors and bank holding companies described in subsection (a) are subject to evaluation of whether such companies have the capital, on a total consolidated basis, necessary to absorb losses as a result of adverse economic conditions." ;
  fro-usc:hasHeading "Annual tests required" ;
  fro-usc:hasId "id83981ad8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981ad9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-2-3> ;
  fro-usc:hasHeading "Test parameters and consequences" ;
  fro-usc:hasId "id83981ad9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-6-10-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ada-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981adb-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981adc-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981add-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ade-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981ada-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-2-3-3> ;
  fro-usc:hasContentText "shall provide for at least 3 different sets of conditions under which the evaluation required by this subsection shall be conducted, including baseline, adverse, and severely adverse;" ;
  fro-usc:hasId "id83981ada-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/1/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83981adb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-2-3-4> ;
  fro-usc:hasContentText "may require the tests described in subparagraph (A) at bank holding companies and nonbank financial companies, in addition to those for which annual tests are required under subparagraph (A);" ;
  fro-usc:hasId "id83981adb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83981adc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-2-3-5> ;
  fro-usc:hasContentText "may develop and apply such other analytic techniques as are necessary to identify, measure, and monitor risks to the financial stability of the United States;" ;
  fro-usc:hasId "id83981adc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/1/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83981add-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-2-3-6> ;
  fro-usc:hasContentText "shall require the companies described in subparagraph (A) to update their resolution plans required under subsection (d)(1), as the Board of Governors determines appropriate, based on the results of the analyses; and" ;
  fro-usc:hasId "id83981add-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/1/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id83981ade-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-2-3-7> ;
  fro-usc:hasContentText "shall publish a summary of the results of the tests required under subparagraph (A) or clause (ii) of this subparagraph." ;
  fro-usc:hasId "id83981ade-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/1/B/v" ;
  fro-usc:hasNumberText "(v)" ;
.
fro-usc-t12-ch53:id83981adf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-3> ;
  fro-usc:hasHeading "By the company" ;
  fro-usc:hasId "id83981adf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ae0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ae1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ae2-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981ae0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-3-2> ;
  fro-usc:hasContentText "A nonbank financial company supervised by the Board of Governors and a bank holding company described in subsection (a) shall conduct semiannual stress tests. All other financial companies that have total consolidated assets of more than $10,000,000,000 and are regulated by a primary Federal financial regulatory agency shall conduct annual stress tests. The tests required under this subparagraph shall be conducted in accordance with the regulations prescribed under subparagraph (C)." ;
  fro-usc:hasHeading "Requirement" ;
  fro-usc:hasId "id83981ae0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981ae1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-3-3> ;
  fro-usc:hasContentText "A company required to conduct stress tests under subparagraph (A) shall submit a report to the Board of Governors and to its primary financial regulatory agency at such time, in such form, and containing such information as the primary financial regulatory agency shall require." ;
  fro-usc:hasHeading "Report" ;
  fro-usc:hasId "id83981ae1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981ae2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-3-4> ;
  fro-usc:hasHeading "Regulations" ;
  fro-usc:hasId "id83981ae2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/2/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-6-10-3-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ae3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ae4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ae5-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981ae6-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981ae3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-3-4-3> ;
  fro-usc:hasContentText "define the term “stress test” for purposes of this paragraph;" ;
  fro-usc:hasId "id83981ae3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/2/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83981ae4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-3-4-4> ;
  fro-usc:hasContentText "establish methodologies for the conduct of stress tests required by this paragraph that shall provide for at least 3 different sets of conditions, including baseline, adverse, and severely adverse;" ;
  fro-usc:hasId "id83981ae4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/2/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83981ae5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-3-4-5> ;
  fro-usc:hasContentText "establish the form and content of the report required by subparagraph (B); and" ;
  fro-usc:hasId "id83981ae5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/2/C/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83981ae6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-10-3-4-6> ;
  fro-usc:hasContentText "require companies subject to this paragraph to publish a summary of the results of the required stress tests." ;
  fro-usc:hasId "id83981ae6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/i/2/C/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id83981ae7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ae8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981ae9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981aea-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-11> ;
  fro-usc:hasHeading "Leverage limitation" ;
  fro-usc:hasId "id83981ae7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/j" ;
  fro-usc:hasNumberText "(j)" ;
.
fro-usc-t12-ch53:id83981ae8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-11-2> ;
  fro-usc:hasContentText "The Board of Governors shall require a bank holding company with total consolidated assets equal to or greater than $50,000,000,000 or a nonbank financial company supervised by the Board of Governors to maintain a debt to equity ratio of no more than 15 to 1, upon a determination by the Council that such company poses a grave threat to the financial stability of the United States and that the imposition of such requirement is necessary to mitigate the risk that such company poses to the financial stability of the United States. Nothing in this paragraph shall apply to a Federal home loan bank." ;
  fro-usc:hasHeading "Requirement" ;
  fro-usc:hasId "id83981ae8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/j/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83981ae9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-11-3> ;
  fro-usc:hasContentText "In making a determination under this subsection, the Council shall consider the factors described in subsections (a) and (b) of section 5323 of this title and any other risk-related factors that the Council deems appropriate." ;
  fro-usc:hasHeading "Considerations" ;
  fro-usc:hasId "id83981ae9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/j/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5323" ;
.
fro-usc-t12-ch53:id83981aea-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-11-4> ;
  fro-usc:hasContentText "The Board of Governors shall promulgate regulations to establish procedures and timelines for complying with the requirements of this subsection." ;
  fro-usc:hasHeading "Regulations" ;
  fro-usc:hasId "id83981aea-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/j/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83981aeb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981aec-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981aed-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981aee-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-12> ;
  fro-usc:hasHeading "Inclusion of off-balance-sheet activities in computing capital requirements" ;
  fro-usc:hasId "id83981aeb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/k" ;
  fro-usc:hasNumberText "(k)" ;
.
fro-usc-t12-ch53:id83981aec-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-12-2> ;
  fro-usc:hasContentText "In the case of any bank holding company described in subsection (a) or nonbank financial company supervised by the Board of Governors, the computation of capital for purposes of meeting capital requirements shall take into account any off-balance-sheet activities of the company." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83981aec-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/k/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83981aed-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-12-3> ;
  fro-usc:hasContentText "If the Board of Governors determines that an exemption from the requirement under paragraph (1) is appropriate, the Board of Governors may exempt a company, or any transaction or transactions engaged in by such company, from the requirements of paragraph (1)." ;
  fro-usc:hasHeading "Exemptions" ;
  fro-usc:hasId "id83981aed-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/k/2" ;
  fro-usc:hasNumberText "(2)" ;
.
