  lkif-mereo:component fro-usc-t12-ch53:id839cd6cc-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6cd-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6ce-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6cf-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6d0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6d1-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd6c8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5-3> ;
  fro-usc:hasContentText "with respect to a futures commission merchant, a contract for the purchase or sale of a commodity for future delivery on, or subject to the rules of, a contract market or board of trade;" ;
  fro-usc:hasId "id839cd6c8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd6c9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5-4> ;
  fro-usc:hasContentText "with respect to a foreign futures commission merchant, a foreign future;" ;
  fro-usc:hasId "id839cd6c9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd6ca-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5-5> ;
  fro-usc:hasContentText "with respect to a leverage transaction merchant, a leverage transaction;" ;
  fro-usc:hasId "id839cd6ca-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839cd6cb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5-6> ;
  fro-usc:hasContentText "with respect to a clearing organization, a contract for the purchase or sale of a commodity for future delivery on, or subject to the rules of, a contract market or board of trade that is cleared by such clearing organization, or commodity option traded on, or subject to the rules of, a contract market or board of trade that is cleared by such clearing organization;" ;
  fro-usc:hasId "id839cd6cb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii/IV" ;
  fro-usc:hasNumberText "(IV)" ;
.
fro-usc-t12-ch53:id839cd6cc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5-7> ;
  fro-usc:hasContentText "with respect to a commodity options dealer, a commodity option;" ;
  fro-usc:hasId "id839cd6cc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii/V" ;
  fro-usc:hasNumberText "(V)" ;
.
fro-usc-t12-ch53:id839cd6cd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5-8> ;
  fro-usc:hasContentText "any other agreement or transaction that is similar to any agreement or transaction referred to in this clause;" ;
  fro-usc:hasId "id839cd6cd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii/VI" ;
  fro-usc:hasNumberText "(VI)" ;
.
fro-usc-t12-ch53:id839cd6ce-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5-9> ;
  fro-usc:hasContentText "any combination of the agreements or transactions referred to in this clause;" ;
  fro-usc:hasId "id839cd6ce-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii/VII" ;
  fro-usc:hasNumberText "(VII)" ;
.
fro-usc-t12-ch53:id839cd6cf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5-10> ;
  fro-usc:hasContentText "any option to enter into any agreement or transaction referred to in this clause;" ;
  fro-usc:hasId "id839cd6cf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii/VIII" ;
  fro-usc:hasNumberText "(VIII)" ;
.
fro-usc-t12-ch53:id839cd6d0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5-11> ;
  fro-usc:hasContentText "a master agreement that provides for an agreement or transaction referred to in any of subclauses (I) through (VIII), together with all supplements to any such master agreement, without regard to whether the master agreement provides for an agreement or transaction that is not a commodity contract under this clause, except that the master agreement shall be considered to be a commodity contract under this clause only with respect to each agreement or transaction under the master agreement that is referred to in any of subclauses (I) through (VIII); or" ;
  fro-usc:hasId "id839cd6d0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii/IX" ;
  fro-usc:hasNumberText "(IX)" ;
.
fro-usc-t12-ch53:id839cd6d1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5-12> ;
  fro-usc:hasContentText "any security agreement or arrangement or other credit enhancement related to any agreement or transaction referred to in this clause, including any guarantee or reimbursement obligation in connection with any agreement or transaction referred to in this clause." ;
  fro-usc:hasId "id839cd6d1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii/X" ;
  fro-usc:hasNumberText "(X)" ;
.
fro-usc-t12-ch53:id839cd6d2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-6> ;
  fro-usc:hasHeading "Forward contract" ;
  fro-usc:hasId "id839cd6d2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iv" ;
  fro-usc:hasNumberText "(iv)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-9-5-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6d3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6d4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6d5-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6d6-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6d7-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd6d3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-6-3> ;
  fro-usc:hasContentText "a contract (other than a commodity contract) for the purchase, sale, or transfer of a commodity or any similar good, article, service, right, or interest which is presently or in the future becomes the subject of dealing in the forward contract trade, or product or byproduct thereof, with a maturity date that is more than 2 days after the date on which the contract is entered into, including a repurchase or reverse repurchase transaction (whether or not such repurchase or reverse repurchase transaction is a “repurchase agreement”, as defined in clause (v)), consignment, lease, swap, hedge transaction, deposit, loan, option, allocated transaction, unallocated transaction, or any other similar agreement;" ;
  fro-usc:hasId "id839cd6d3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iv/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd6d4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-6-4> ;
  fro-usc:hasContentText "any combination of agreements or transactions referred to in subclauses (I) and (III);" ;
  fro-usc:hasId "id839cd6d4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iv/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd6d5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-6-5> ;
  fro-usc:hasContentText "any option to enter into any agreement or transaction referred to in subclause (I) or (II);" ;
  fro-usc:hasId "id839cd6d5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iv/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839cd6d6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-6-6> ;
  fro-usc:hasContentText "a master agreement that provides for an agreement or transaction referred to in subclause (I), (II), or (III), together with all supplements to any such master agreement, without regard to whether the master agreement provides for an agreement or transaction that is not a forward contract under this clause, except that the master agreement shall be considered to be a forward contract under this clause only with respect to each agreement or transaction under the master agreement that is referred to in subclause (I), (II), or (III); or" ;
  fro-usc:hasId "id839cd6d6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iv/IV" ;
  fro-usc:hasNumberText "(IV)" ;
.
fro-usc-t12-ch53:id839cd6d7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-6-7> ;
  fro-usc:hasContentText "any security agreement or arrangement or other credit enhancement related to any agreement or transaction referred to in subclause (I), (II), (III), or (IV), including any guarantee or reimbursement obligation in connection with any agreement or transaction referred to in any such subclause." ;
  fro-usc:hasId "id839cd6d7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iv/V" ;
  fro-usc:hasNumberText "(V)" ;
.
fro-usc-t12-ch53:id839cd6d8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-7> ;
  fro-usc:hasHeading "Repurchase agreement" ;
  fro-usc:hasId "id839cd6d8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/v" ;
  fro-usc:hasNumberText "(v)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-9-5-7-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6d9-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6da-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6db-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6dc-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6dd-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6de-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd6d9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-7-3> ;
  fro-usc:hasContentText "means an agreement, including related terms, which provides for the transfer of one or more certificates of deposit, mortgage related securities (as such term is defined in section 3 of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c ]), mortgage loans, interests in mortgage-related securities or mortgage loans, eligible bankers’ acceptances, qualified foreign government securities (which, for purposes of this clause, means a security that is a direct obligation of, or that is fully guaranteed by, the central government of a member of the Organization for Economic Cooperation and Development, as determined by regulation or order adopted by the Board of Governors), or securities that are direct obligations of, or that are fully guaranteed by, the United States or any agency of the United States against the transfer of funds by the transferee of such certificates of deposit, eligible bankers’ acceptances, securities, mortgage loans, or interests with a simultaneous agreement by such transferee to transfer to the transferor thereof certificates of deposit, eligible bankers’ acceptances, securities, mortgage loans, or interests as described above, at a date certain not later than 1 year after such transfers or on demand, against the transfer of funds, or any other similar agreement;" ;
  fro-usc:hasId "id839cd6d9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/v/I" ;
  fro-usc:hasNumberText "(I)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c" ;
.
fro-usc-t12-ch53:id839cd6da-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-7-4> ;
  fro-usc:hasContentText "does not include any repurchase obligation under a participation in a commercial mortgage loan, unless the Corporation determines, by regulation, resolution, or order to include any such participation within the meaning of such term;" ;
  fro-usc:hasId "id839cd6da-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/v/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd6db-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-7-5> ;
  fro-usc:hasContentText "means any combination of agreements or transactions referred to in subclauses (I) and (IV);" ;
  fro-usc:hasId "id839cd6db-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/v/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839cd6dc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-7-6> ;
  fro-usc:hasContentText "means any option to enter into any agreement or transaction referred to in subclause (I) or (III);" ;
  fro-usc:hasId "id839cd6dc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/v/IV" ;
  fro-usc:hasNumberText "(IV)" ;
.
fro-usc-t12-ch53:id839cd6dd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-7-7> ;
  fro-usc:hasContentText "means a master agreement that provides for an agreement or transaction referred to in subclause (I), (III), or (IV), together with all supplements to any such master agreement, without regard to whether the master agreement provides for an agreement or transaction that is not a repurchase agreement under this clause, except that the master agreement shall be considered to be a repurchase agreement under this subclause only with respect to each agreement or transaction under the master agreement that is referred to in subclause (I), (III), or (IV); and" ;
  fro-usc:hasId "id839cd6dd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/v/V" ;
  fro-usc:hasNumberText "(V)" ;
.
fro-usc-t12-ch53:id839cd6de-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-7-8> ;
  fro-usc:hasContentText "means any security agreement or arrangement or other credit enhancement related to any agreement or transaction referred to in subclause (I), (III), (IV), or (V), including any guarantee or reimbursement obligation in connection with any agreement or transaction referred to in any such subclause." ;
  fro-usc:hasId "id839cd6de-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/v/VI" ;
  fro-usc:hasNumberText "(VI)" ;
.
fro-usc-t12-ch53:id839cd6df-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-8> ;
  fro-usc:hasHeading "Swap agreement" ;
  fro-usc:hasId "id839cd6df-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/vi" ;
  fro-usc:hasNumberText "(vi)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-9-5-8-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6e0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6e1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6e2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6e3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6e4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6e5-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd6e0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-8-3> ;
  fro-usc:hasContentText "any agreement, including the terms and conditions incorporated by reference in any such agreement, which is an interest rate swap, option, future, or forward agreement, including a rate floor, rate cap, rate collar, cross-currency rate swap, and basis swap; a spot, same day-tomorrow, tomorrow-next, forward, or other foreign exchange, precious metals, or other commodity agreement; a currency swap, option, future, or forward agreement; an equity index or equity swap, option, future, or forward agreement; a debt index or debt swap, option, future, or forward agreement; a total return, credit spread or credit swap, option, future, or forward agreement; a commodity index or commodity swap, option, future, or forward agreement; weather swap, option, future, or forward agreement; an emissions swap, option, future, or forward agreement; or an inflation swap, option, future, or forward agreement;" ;
  fro-usc:hasId "id839cd6e0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/vi/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd6e1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-8-4> ;
  fro-usc:hasContentText "any agreement or transaction that is similar to any other agreement or transaction referred to in this clause and that is of a type that has been, is presently, or in the future becomes, the subject of recurrent dealings in the swap or other derivatives markets (including terms and conditions incorporated by reference in such agreement) and that is a forward, swap, future, option, or spot transaction on one or more rates, currencies, commodities, equity securities or other equity instruments, debt securities or other debt instruments, quantitative measures associated with an occurrence, extent of an occurrence, or contingency associated with a financial, commercial, or economic consequence, or economic or financial indices or measures of economic or financial risk or value;" ;
  fro-usc:hasId "id839cd6e1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/vi/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd6e2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-8-5> ;
  fro-usc:hasContentText "any combination of agreements or transactions referred to in this clause;" ;
  fro-usc:hasId "id839cd6e2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/vi/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839cd6e3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-8-6> ;
  fro-usc:hasContentText "any option to enter into any agreement or transaction referred to in this clause;" ;
  fro-usc:hasId "id839cd6e3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/vi/IV" ;
  fro-usc:hasNumberText "(IV)" ;
.
fro-usc-t12-ch53:id839cd6e4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-8-7> ;
  fro-usc:hasContentText "a master agreement that provides for an agreement or transaction referred to in subclause (I), (II), (III), or (IV), together with all supplements to any such master agreement, without regard to whether the master agreement contains an agreement or transaction that is not a swap agreement under this clause, except that the master agreement shall be considered to be a swap agreement under this clause only with respect to each agreement or transaction under the master agreement that is referred to in subclause (I), (II), (III), or (IV); and" ;
  fro-usc:hasId "id839cd6e4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/vi/V" ;
  fro-usc:hasNumberText "(V)" ;
.
fro-usc-t12-ch53:id839cd6e5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-8-8> ;
  fro-usc:hasContentText "any security agreement or arrangement or other credit enhancement related to any agreement or transaction referred to in any of subclauses (I) through (V), including any guarantee or reimbursement obligation in connection with any agreement or transaction referred to in any such clause." ;
  fro-usc:hasId "id839cd6e5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/vi/VI" ;
  fro-usc:hasNumberText "(VI)" ;
.
fro-usc-t12-ch53:id839cd6e6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-9> ;
  fro-usc:hasHeading "Definitions relating to default" ;
  fro-usc:hasId "id839cd6e6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/vii" ;
  fro-usc:hasNumberText "(vii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-9-5-9-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6e7-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6e8-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd6e7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-9-3> ;
  fro-usc:hasContentText "the term “default” means, with respect to a covered financial company, any adjudication or other official decision by any court of competent jurisdiction, or other public authority pursuant to which the Corporation has been appointed receiver; and" ;
  fro-usc:hasId "id839cd6e7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/vii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
