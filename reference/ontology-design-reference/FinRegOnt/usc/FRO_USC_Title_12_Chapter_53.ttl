  fro-usc:hasContentText "is incorporated or organized under any provision of Federal law or the laws of any State;" ;
  fro-usc:hasId "id83981b84-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/11/A" ;
