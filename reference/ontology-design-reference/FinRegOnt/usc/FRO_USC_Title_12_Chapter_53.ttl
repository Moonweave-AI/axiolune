fro-usc-t12-ch53:id83a40314-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-5-5-3> ;
  fro-usc:hasContentText "the approval of, disapproval of, or stay of the clearing requirement for any group, category, type, or class of swaps that a designated clearing entity may accept for clearing;" ;
  fro-usc:hasId "id83a40314-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5464/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a40315-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-5-5-4> ;
  fro-usc:hasContentText "the determination that any group, category, type, or class of swaps shall be subject to the mandatory clearing requirement of section 2(h)(1) of title 7 or section 78c–3(a)(1) of title 15 ;" ;
  fro-usc:hasId "id83a40315-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5464/d/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c–3/a/1" ;
  fro-usc:hasReferenceText "/us/usc/t7/s2/h/1" ;
.
fro-usc-t12-ch53:id83a40316-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-5-5-5> ;
  fro-usc:hasContentText "the determination that any person is exempt from the mandatory clearing requirement of section 2(h)(1) of title 7 or section 78c–3(a)(1) of title 15 ; or" ;
  fro-usc:hasId "id83a40316-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5464/d/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c–3/a/1" ;
  fro-usc:hasReferenceText "/us/usc/t7/s2/h/1" ;
.
fro-usc-t12-ch53:id83a40317-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-5-5-6> ;
  fro-usc:hasContentText "any authority granted to the Commodity Futures Trading Commission or the Securities and Exchange Commission with respect to transaction reporting or trade execution." ;
  fro-usc:hasId "id83a40317-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5464/d/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a40318-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-5-6> ;
  fro-usc:hasContentText "The standards prescribed under subsection (a) governing the conduct of designated activities by financial institutions shall, where appropriate, establish a threshold as to the level or significance of engagement in the activity at which a financial institution will become subject to the standards with respect to that activity." ;
  fro-usc:hasHeading "Threshold level" ;
  fro-usc:hasId "id83a40318-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5464/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83a40319-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-5-7> ;
  fro-usc:hasContentText "Designated financial market utilities and financial institutions subject to the standards prescribed under subsection (a) for a designated activity shall conduct their operations in compliance with the applicable risk management standards." ;
  fro-usc:hasHeading "Compliance required" ;
  fro-usc:hasId "id83a40319-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5464/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83a4031a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-usc:hasId "id83a4031a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tVIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1809" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title VIII , § 805, July 21, 2010 , 124 Stat. 1809 .)" ;
.
fro-usc-t12-ch53:id83a4031b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4031c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4031d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4031e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4031f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40320-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83a4033e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6> ;
  fro-usc:hasHeading "Operations of designated financial market utilities" ;
  fro-usc:hasId "id83a4031b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465" ;
  fro-usc:hasNumberText "§ 5465." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4033c-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a4031c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-2> ;
  fro-usc:hasContentText "The Board of Governors may authorize a Federal Reserve Bank to establish and maintain an account for a designated financial market utility and provide the services listed in section 11A(b) of the Federal Reserve Act ( 12 U.S.C. 248a(b) ) and deposit accounts under the first undesignated paragraph of section 13 of the Federal Reserve Act ( 12 U.S.C. 342 ) to the designated financial market utility that the Federal Reserve Bank is authorized under the Federal Reserve Act [ 12 U.S.C. 221 et seq.] to provide to a depository institution, subject to any applicable rules, orders, standards, or guidelines prescribed by the Board of Governors." ;
  fro-usc:hasHeading "Federal Reserve account and services" ;
  fro-usc:hasId "id83a4031c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s221" ;
  fro-usc:hasReferenceText "/us/usc/t12/s248a/b" ;
  fro-usc:hasReferenceText "/us/usc/t12/s342" ;
.
fro-usc-t12-ch53:id83a4031d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-3> ;
  fro-usc:hasContentText "The Board of Governors may authorize a Federal Reserve bank under section 10B of the Federal Reserve Act ( 12 U.S.C. 347b ) to provide to a designated financial market utility discount and borrowing privileges only in unusual or exigent circumstances, upon the affirmative vote of a majority of the Board of Governors then serving (or such other number in accordance with the provisions of section 11(r)(2) of the Federal Reserve Act ( 12 U.S.C. 248(r)(2) )  1 after consultation with the Secretary, and upon a showing by the designated financial market utility that it is unable to secure adequate credit accommodations from other banking institutions. All such discounts and borrowing privileges shall be subject to such other limitations, restrictions, and regulations as the Board of Governors may prescribe. Access to discount and borrowing privileges under section 10B of the Federal Reserve Act as authorized in this section does not require a designated financial market utility to be or become a bank or bank holding company." ;
  fro-usc:hasHeading "Advances" ;
  fro-usc:hasId "id83a4031d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s248/r/2" ;
  fro-usc:hasReferenceText "/us/usc/t12/s347b" ;
.
fro-usc-t12-ch53:id83a4031e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-4> ;
  fro-usc:hasContentText "A Federal Reserve Bank may pay earnings on balances maintained by or on behalf of a designated financial market utility in the same manner and to the same extent as the Federal Reserve Bank may pay earnings to a depository institution under the Federal Reserve Act [ 12 U.S.C. 221 et seq.], subject to any applicable rules, orders, standards, or guidelines prescribed by the Board of Governors." ;
  fro-usc:hasHeading "Earnings on Federal Reserve balances" ;
  fro-usc:hasId "id83a4031e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s221" ;
.
fro-usc-t12-ch53:id83a4031f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-5> ;
  fro-usc:hasContentText "The Board of Governors may exempt a designated financial market utility from, or modify any, reserve requirements under section 19 of the Federal Reserve Act ( 12 U.S.C. 461 ) applicable to a designated financial market utility." ;
  fro-usc:hasHeading "Reserve requirements" ;
  fro-usc:hasId "id83a4031f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s461" ;
.
fro-usc-t12-ch53:id83a40320-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40321-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40331-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4033a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4033b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6> ;
  fro-usc:hasHeading "Changes to rules, procedures, or operations" ;
  fro-usc:hasId "id83a40320-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83a40321-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2> ;
  fro-usc:hasHeading "Advance notice" ;
  fro-usc:hasId "id83a40321-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40322-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40323-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40324-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40327-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40328-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4032b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4032c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4032f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40330-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40322-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-2> ;
  fro-usc:hasContentText "A designated financial market utility shall provide notice 60 days in advance notice  2 to its Supervisory Agency of any proposed change to its rules, procedures, or operations that could, as defined in rules of each Supervisory Agency, materially affect, the nature or level of risks presented by the designated financial market utility." ;
  fro-usc:hasHeading "Advance notice of proposed changes required" ;
  fro-usc:hasId "id83a40322-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a40323-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-3> ;
  fro-usc:hasContentText "Each Supervisory Agency, in consultation with the Board of Governors, shall prescribe regulations that define and describe the standards for determining when notice is required to be provided under subparagraph (A)." ;
  fro-usc:hasHeading "Terms and standards prescribed by the Supervisory Agencies" ;
  fro-usc:hasId "id83a40323-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a40324-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-4> ;
  fro-usc:hasHeading "Contents of notice" ;
  fro-usc:hasId "id83a40324-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-6-6-2-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40325-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40326-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40325-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-4-3> ;
  fro-usc:hasContentText "the nature of the change and expected effects on risks to the designated financial market utility, its participants, or the market; and" ;
  fro-usc:hasId "id83a40325-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a40326-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-4-4> ;
  fro-usc:hasContentText "how the designated financial market utility plans to manage any identified risks." ;
  fro-usc:hasId "id83a40326-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a40327-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-5> ;
  fro-usc:hasContentText "The Supervisory Agency may require a designated financial market utility to provide any information necessary to assess the effect the proposed change would have on the nature or level of risks associated with the designated financial market utility’s payment, clearing, or settlement activities and the sufficiency of any proposed risk management techniques." ;
  fro-usc:hasHeading "Additional information" ;
  fro-usc:hasId "id83a40327-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83a40328-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-6> ;
  fro-usc:hasHeading "Notice of objection" ;
  fro-usc:hasId "id83a40328-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/E" ;
  fro-usc:hasNumberText "(E)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-6-6-2-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40329-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4032a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40329-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-6-3> ;
  fro-usc:hasContentText "the date that the notice of the proposed change is received; or" ;
  fro-usc:hasId "id83a40329-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/E/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a4032a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-6-4> ;
  fro-usc:hasContentText "the date any further information requested for consideration of the notice is received." ;
  fro-usc:hasId "id83a4032a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/E/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a4032b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-7> ;
  fro-usc:hasContentText "A designated financial market utility shall not implement a change to which the Supervisory Agency has an objection." ;
  fro-usc:hasHeading "Change not allowed if objection" ;
  fro-usc:hasId "id83a4032b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id83a4032c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-8> ;
  fro-usc:hasHeading "Change allowed if no objection within 60 days" ;
  fro-usc:hasId "id83a4032c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/G" ;
  fro-usc:hasNumberText "(G)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-6-6-2-8-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4032d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4032e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a4032d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-8-3> ;
  fro-usc:hasContentText "the date that the Supervisory Agency receives the notice of proposed change; or" ;
  fro-usc:hasId "id83a4032d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/G/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a4032e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-8-4> ;
  fro-usc:hasContentText "the date the Supervisory Agency receives any further information it requests for consideration of the notice." ;
  fro-usc:hasId "id83a4032e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/G/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a4032f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-9> ;
  fro-usc:hasContentText "The Supervisory Agency may, during the 60-day review period, extend the review period for an additional 60 days for proposed changes that raise novel or complex issues, subject to the Supervisory Agency providing the designated financial market utility with prompt written notice of the extension. Any extension under this subparagraph will extend the time periods under subparagraphs (E) and (G)." ;
  fro-usc:hasHeading "Review extension for novel or complex issues" ;
  fro-usc:hasId "id83a4032f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/H" ;
  fro-usc:hasNumberText "(H)" ;
.
fro-usc-t12-ch53:id83a40330-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-2-10> ;
  fro-usc:hasContentText "A designated financial market utility may implement a change in less than 60 days from the date of receipt of the notice of proposed change by the Supervisory Agency, or the date the Supervisory Agency receives any further information it requested, if the Supervisory Agency notifies the designated financial market utility in writing that it does not object to the proposed change and authorizes the designated financial market utility to implement the change on an earlier date, subject to any conditions imposed by the Supervisory Agency." ;
  fro-usc:hasHeading "Change allowed earlier if notified of no objection" ;
  fro-usc:hasId "id83a40330-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/1/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83a40331-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-3> ;
  fro-usc:hasHeading "Emergency changes" ;
  fro-usc:hasId "id83a40331-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40332-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40335-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40336-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40339-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40332-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-3-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a40332-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/2/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-6-6-3-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40333-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40334-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40333-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-3-2-3> ;
  fro-usc:hasContentText "an emergency exists; and" ;
  fro-usc:hasId "id83a40333-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/2/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a40334-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-3-2-4> ;
  fro-usc:hasContentText "immediate implementation of the change is necessary for the designated financial market utility to continue to provide its services in a safe and sound manner." ;
  fro-usc:hasId "id83a40334-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/2/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a40335-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-3-3> ;
  fro-usc:hasContentText "The designated financial market utility shall provide notice of any such emergency change to its Supervisory Agency, as soon as practicable, which shall be no later than 24 hours after implementation of the change." ;
  fro-usc:hasHeading "Notice required within 24 hours" ;
  fro-usc:hasId "id83a40335-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a40336-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-3-4> ;
  fro-usc:hasHeading "Contents of emergency notice" ;
  fro-usc:hasId "id83a40336-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/2/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-6-6-3-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40337-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40338-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40337-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-3-4-3> ;
  fro-usc:hasContentText "the nature of the emergency; and" ;
  fro-usc:hasId "id83a40337-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/2/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a40338-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-3-4-4> ;
  fro-usc:hasContentText "the reason the change was necessary for the designated financial market utility to continue to provide its services in a safe and sound manner." ;
  fro-usc:hasId "id83a40338-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/2/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a40339-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-3-5> ;
  fro-usc:hasContentText "The Supervisory Agency may require modification or rescission of the change if it finds that the change is not consistent with the purposes of this Act or any applicable rules, orders, or standards prescribed under section 5464(a) of this title ." ;
  fro-usc:hasHeading "Modification or rescission of change may be required" ;
  fro-usc:hasId "id83a40339-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/2/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5464/a" ;
.
fro-usc-t12-ch53:id83a4033a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-4> ;
  fro-usc:hasContentText "The Supervisory Agency shall provide the Board of Governors concurrently with a complete copy of any notice, request, or other information it issues, submits, or receives under this subsection." ;
  fro-usc:hasHeading "Copying the Board of Governors" ;
  fro-usc:hasId "id83a4033a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a4033b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-6-5> ;
  fro-usc:hasContentText "Before taking any action on, or completing its review of, a change proposed by a designated financial market utility, the Supervisory Agency shall consult with the Board of Governors." ;
  fro-usc:hasHeading "Consultation with Board of Governors" ;
  fro-usc:hasId "id83a4033b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5465/e/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a4033c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-usc:hasId "id83a4033c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tVIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1811" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title VIII , § 806, July 21, 2010 , 124 Stat. 1811 .)" ;
.
fro-usc-t12-ch53:id83a4033e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-6-8-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a4033e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Federal Reserve Act, referred to in subsecs. (a) and (c), is act Dec. 23, 1913, ch. 6 , 38 Stat. 251 , which is classified principally to chapter 3 (§ 221 et seq.) of this title. For complete classification of this Act to the Code, see References in Text note set out under section 226 of this title and Tables." ;
  fro-usc:hasNoteText "This Act, referred to in subsec. (e)(2)(D), is Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1376 , known as the Dodd-Frank Wall Street Reform and Consumer Protection Act, which enacted this chapter and chapters 108 (§ 8201 et seq.) and 109 (§ 8301 et seq.) of Title 15, Commerce and Trade, and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of this Act to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1913-12-23/ch6" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1376" ;
  fro-usc:hasReferenceText "/us/stat/38/251" ;
  fro-usc:hasReferenceText "/us/usc/t12/s226" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
