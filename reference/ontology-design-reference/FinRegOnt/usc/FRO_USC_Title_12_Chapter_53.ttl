  fro-usc:hasContentText "the factors described in subsections (a) and (b) of section 5323 of this title ;" ;
  fro-usc:hasId "id83936126-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/b/3/A/i" ;
