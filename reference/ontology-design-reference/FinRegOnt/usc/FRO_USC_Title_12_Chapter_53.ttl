  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4> ;
  fro-usc:hasHeading "Authority to require supervision and regulation of certain nonbank financial companies" ;
  fro-usc:hasId "id839360ca-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323" ;
  fro-usc:hasNumberText "§ 5323." ;
