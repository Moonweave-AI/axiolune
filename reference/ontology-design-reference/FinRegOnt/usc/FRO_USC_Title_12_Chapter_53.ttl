  lkif-mereo:component fro-usc-t12-ch53:id839a8c1d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c1e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c1f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c1c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-5-3> ;
  fro-usc:hasContentText "a case has been, or likely will promptly be, commenced with respect to the financial company under the Bankruptcy Code;" ;
  fro-usc:hasId "id839a8c1c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839a8c1d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-5-4> ;
  fro-usc:hasContentText "the financial company has incurred, or is likely to incur, losses that will deplete all or substantially all of its capital, and there is no reasonable prospect for the company to avoid such depletion;" ;
  fro-usc:hasId "id839a8c1d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/4/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8c1e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-5-5> ;
  fro-usc:hasContentText "the assets of the financial company are, or are likely to be, less than its obligations to creditors and others; or" ;
  fro-usc:hasId "id839a8c1e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/4/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839a8c1f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-5-6> ;
  fro-usc:hasContentText "the financial company is, or is likely to be, unable to pay its obligations (other than those subject to a bona fide dispute) in the normal course of business." ;
  fro-usc:hasId "id839a8c1f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/4/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839a8c20-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-6> ;
  fro-usc:hasHeading "GAO review" ;
  fro-usc:hasId "id839a8c20-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-4-4-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c21-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c22-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c23-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c24-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c21-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-6-3> ;
  fro-usc:hasContentText "the basis for the determination;" ;
  fro-usc:hasId "id839a8c21-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/5/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839a8c22-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-6-4> ;
  fro-usc:hasContentText "the purpose for which any action was taken pursuant thereto;" ;
  fro-usc:hasId "id839a8c22-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8c23-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-6-5> ;
  fro-usc:hasContentText "the likely effect of the determination and such action on the incentives and conduct of financial companies and their creditors, counterparties, and shareholders; and" ;
  fro-usc:hasId "id839a8c23-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/5/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839a8c24-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-4-6-6> ;
  fro-usc:hasContentText "the likely disruptive effect of the determination and such action on the reasonable expectations of creditors, counterparties, and shareholders, taking into account the impact any action under this subchapter would have on financial stability in the United States, including whether the rights of such parties will be disrupted." ;
  fro-usc:hasId "id839a8c24-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/5/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839a8c25-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-5> ;
  fro-usc:hasContentText "As soon as is practicable after July 21, 2010 , the Corporation shall establish policies and procedures that are acceptable to the Secretary governing the use of funds available to the Corporation to carry out this subchapter, including the terms and conditions for the provision and use of funds under sections 5384(d), 5390(h)(2)(G)(iv), and 5390(h)(9) of this title." ;
  fro-usc:hasHeading "Corporation policies and procedures" ;
  fro-usc:hasId "id839a8c25-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id839a8c26-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c27-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c28-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c29-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-6> ;
  fro-usc:hasHeading "Treatment of insurance companies and insurance company subsidiaries" ;
  fro-usc:hasId "id839a8c26-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id839a8c27-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-6-2> ;
  fro-usc:hasContentText "Notwithstanding subsection (b), if an insurance company is a covered financial company or a subsidiary or affiliate of a covered financial company, the liquidation or rehabilitation of such insurance company, and any subsidiary or affiliate of such company that is not excepted under paragraph (2), shall be conducted as provided under applicable State law." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8c27-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839a8c28-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-6-3> ;
  fro-usc:hasContentText "The requirement of paragraph (1) shall not apply with respect to any subsidiary or affiliate of an insurance company that is not itself an insurance company." ;
  fro-usc:hasHeading "Exception for subsidiaries and affiliates" ;
  fro-usc:hasId "id839a8c28-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839a8c29-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-6-4> ;
  fro-usc:hasContentText "Notwithstanding paragraph (1), with respect to a covered financial company described in paragraph (1), if, after the end of the 60-day period beginning on the date on which a determination is made under section 5382(a) of this title with respect to such company, the appropriate regulatory agency has not filed the appropriate judicial action in the appropriate State court to place such company into orderly liquidation or rehabilitation under the laws and requirements of the State, the Corporation shall have the authority to stand in the place of the appropriate regulatory agency and file the appropriate judicial action in the appropriate State court to place such company into orderly liquidation or rehabilitation under the laws and requirements of the State." ;
  fro-usc:hasHeading "Backup authority" ;
  fro-usc:hasId "id839a8c29-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/e/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5382/a" ;
.
fro-usc-t12-ch53:id839a8c2a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-usc:hasId "id839a8c2a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/pl/114/113/dO/tVII" ;
  fro-usc:hasReferenceText "/us/stat/124/1450" ;
  fro-usc:hasReferenceText "/us/stat/129/3029" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , 129 Stat. 3029 .) , § 203, July 21, 2010 , 124 Stat. 1450 ; Pub. L. 114–113, div. O, title VII , § 706(b)(1), Dec. 18, 2015" ;
.
fro-usc-t12-ch53:id839a8c2c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-8-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id839a8c2c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This subchapter, referred to in subsecs. (a) to (d), was in the original “this title”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to this subchapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
.
fro-usc-t12-ch53:id839a8c2d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-8-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "id839a8c2d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "2015—Subsec. (e)(3). Pub. L. 114–113 inserted “or rehabilitation” after “orderly liquidation” in two places." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/114/113" ;
.
fro-usc-t12-ch53:id839a8c2e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c2f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c33-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c34-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c39-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id839a8c46-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id839a8c47-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5> ;
  fro-usc:hasHeading "Orderly liquidation of covered financial companies" ;
  fro-usc:hasId "id839a8c2e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384" ;
  fro-usc:hasNumberText "§ 5384." ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c44-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c2f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c30-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c31-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c32-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-2> ;
  fro-usc:hasHeading "Purpose of orderly liquidation authority" ;
  fro-usc:hasId "id839a8c2f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-5-2-2> ;
.
fro-usc-t12-ch53:id839a8c30-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-2-3> ;
  fro-usc:hasContentText "creditors and shareholders will bear the losses of the financial company;" ;
  fro-usc:hasId "id839a8c30-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839a8c31-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-2-4> ;
  fro-usc:hasContentText "management responsible for the condition of the financial company will not be retained; and" ;
  fro-usc:hasId "id839a8c31-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839a8c32-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-2-5> ;
  fro-usc:hasContentText "the Corporation and other appropriate agencies will take all steps necessary and appropriate to assure that all parties, including management, directors, and third parties, having responsibility for the condition of the financial company bear losses consistent with their responsibility, including actions for damages, restitution, and recoupment of compensation and other gains not compatible with such responsibility." ;
  fro-usc:hasId "id839a8c32-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839a8c33-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-3> ;
  fro-usc:hasContentText "Upon the appointment of the Corporation under section 5382 of this title , the Corporation shall act as the receiver for the covered financial company, with all of the rights and obligations set forth in this subchapter." ;
  fro-usc:hasHeading "Corporation as receiver" ;
  fro-usc:hasId "id839a8c33-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5382" ;
.
fro-usc-t12-ch53:id839a8c34-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c35-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c36-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c37-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c38-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-4> ;
  fro-usc:hasHeading "Consultation" ;
  fro-usc:hasId "id839a8c34-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-5-4-2> ;
.
fro-usc-t12-ch53:id839a8c35-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-4-3> ;
  fro-usc:hasContentText "shall consult with the primary financial regulatory agency or agencies of the covered financial company and its covered subsidiaries for purposes of ensuring an orderly liquidation of the covered financial company;" ;
  fro-usc:hasId "id839a8c35-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839a8c36-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-4-4> ;
  fro-usc:hasContentText "may consult with, or under subsection (a)(1)(B)(v) or (a)(1)(L) of section 5390 of this title , acquire the services of, any outside experts, as appropriate to inform and aid the Corporation in the orderly liquidation process;" ;
  fro-usc:hasId "id839a8c36-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390" ;
.
fro-usc-t12-ch53:id839a8c37-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-4-5> ;
  fro-usc:hasContentText "shall consult with the primary financial regulatory agency or agencies of any subsidiaries of the covered financial company that are not covered subsidiaries, and coordinate with such regulators regarding the treatment of such solvent subsidiaries and the separate resolution of any such insolvent subsidiaries under other governmental authority, as appropriate; and" ;
  fro-usc:hasId "id839a8c37-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/c/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839a8c38-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-4-6> ;
  fro-usc:hasContentText "shall consult with the Commission and the Securities Investor Protection Corporation in the case of any covered financial company for which the Corporation has been appointed as receiver that is a broker or dealer registered with the Commission under section 78 o (b) of title 15 and is a member of the Securities Investor Protection Corporation, for the purpose of determining whether to transfer to a bridge financial company organized by the Corporation as receiver, without consent of any customer, customer accounts of the covered financial company." ;
  fro-usc:hasId "id839a8c38-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/c/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id839a8c39-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c3a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c3b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c3c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c3d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c42-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c43-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5> ;
  fro-usc:hasHeading "Funding for orderly liquidation" ;
  fro-usc:hasId "id839a8c39-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-5-5-2> ;
.
fro-usc-t12-ch53:id839a8c3a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5-3> ;
  fro-usc:hasContentText "making loans to, or purchasing any debt obligation of, the covered financial company or any covered subsidiary;" ;
  fro-usc:hasId "id839a8c3a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839a8c3b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5-4> ;
  fro-usc:hasContentText "purchasing or guaranteeing against loss the assets of the covered financial company or any covered subsidiary, directly or through an entity established by the Corporation for such purpose;" ;
  fro-usc:hasId "id839a8c3b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839a8c3c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5-5> ;
  fro-usc:hasContentText "assuming or guaranteeing the obligations of the covered financial company or any covered subsidiary to 1 or more third parties;" ;
  fro-usc:hasId "id839a8c3c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839a8c3d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5-6> ;
  fro-usc:hasId "id839a8c3d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-5-5-6-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c3e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c3f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c3e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5-6-2> ;
  fro-usc:hasContentText "shall promptly notify the State insurance authority for the insurance company of the intention to take such lien; and" ;
  fro-usc:hasId "id839a8c3e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839a8c3f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5-6-3> ;
  fro-usc:hasId "id839a8c3f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d/4/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-5-5-6-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c40-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c41-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c40-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5-6-3-2> ;
  fro-usc:hasContentText "to secure repayment of funds made available to such covered financial company or covered subsidiary; and" ;
  fro-usc:hasId "id839a8c40-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d/4/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839a8c41-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5-6-3-3> ;
  fro-usc:hasContentText "if the Corporation determines, after consultation with the State insurance authority, that such lien will not unduly impede or delay the liquidation or rehabilitation of the insurance company, or the recovery by its policyholders;" ;
  fro-usc:hasId "id839a8c41-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d/4/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839a8c42-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5-7> ;
  fro-usc:hasContentText "selling or transferring all, or any part, of such acquired assets, liabilities, or obligations of the covered financial company or any covered subsidiary; and" ;
  fro-usc:hasId "id839a8c42-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id839a8c43-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-5-8> ;
  fro-usc:hasContentText "making payments pursuant to subsections (b)(4), (d)(4), and (h)(5)(E) of section 5390 of this title ." ;
  fro-usc:hasId "id839a8c43-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5384/d/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390" ;
.
fro-usc-t12-ch53:id839a8c44-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "id839a8c44-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/pl/114/113/dO/tVII" ;
  fro-usc:hasReferenceText "/us/stat/124/1454" ;
  fro-usc:hasReferenceText "/us/stat/129/3029" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , 129 Stat. 3029 .) , § 204, July 21, 2010 , 124 Stat. 1454 ; Pub. L. 114–113, div. O, title VII , § 706(b)(2), Dec. 18, 2015" ;
.
fro-usc-t12-ch53:id839a8c46-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id839a8c46-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This subchapter, referred to in subsecs. (a) and (b), was in the original “this title”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to this subchapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
.
fro-usc-t12-ch53:id839a8c47-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-5-7-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "id839a8c47-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "2015—Subsec. (d)(4). Pub. L. 114–113 inserted “, except that, if the covered financial company or covered subsidiary is an insurance company or a subsidiary of an insurance company, the Corporation—” and subpars. (A) and (B) before semicolon at end." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/114/113" ;
.
fro-usc-t12-ch53:id839a8c48-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c49-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c50-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c5c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c5d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c63-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c66-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c69-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c6c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id839a8c6f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6> ;
  fro-usc:hasHeading "Orderly liquidation of covered brokers and dealers" ;
  fro-usc:hasId "id839a8c48-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385" ;
  fro-usc:hasNumberText "§ 5385." ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c6d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c49-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c4a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c4b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-2> ;
  fro-usc:hasHeading "Appointment of SIPC as trustee" ;
  fro-usc:hasId "id839a8c49-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id839a8c4a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-2-2> ;
  fro-usc:hasContentText "Upon the appointment of the Corporation as receiver for any covered broker or dealer, the Corporation shall appoint, without any need for court approval, the Securities Investor Protection Corporation to act as trustee for the liquidation under the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.) of the covered broker or dealer." ;
  fro-usc:hasHeading "Appointment" ;
  fro-usc:hasId "id839a8c4a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c4b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-2-3> ;
  fro-usc:hasHeading "Actions by SIPC" ;
  fro-usc:hasId "id839a8c4b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c4c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c4d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c4e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c4f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c4c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-2-3-2> ;
  fro-usc:hasContentText "Upon appointment of SIPC under paragraph (1), SIPC shall promptly file with any Federal district court of competent jurisdiction specified in section 78u or 78aa of title 15, an application for a protective decree under the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.) as to the covered broker or dealer. The Federal district court shall accept and approve the filing, including outside of normal business hours, and shall immediately issue the protective decree as to the covered broker or dealer." ;
  fro-usc:hasHeading "Filing" ;
  fro-usc:hasId "id839a8c4c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c4d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-2-3-3> ;
  fro-usc:hasContentText "Following entry of the protective decree, and except as otherwise provided in this section, the determination of claims and the liquidation of assets retained in the receivership of the covered broker or dealer and not transferred to the bridge financial company shall be administered under the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.) by SIPC, as trustee for the covered broker or dealer." ;
  fro-usc:hasHeading "Administration by SIPC" ;
  fro-usc:hasId "id839a8c4d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c4e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-2-3-4> ;
  fro-usc:hasContentText "For purposes of the liquidation proceeding, the term “filing date” means the date on which the Corporation is appointed as receiver of the covered broker or dealer." ;
  fro-usc:hasHeading "Definition of filing date" ;
  fro-usc:hasId "id839a8c4e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/a/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839a8c4f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-2-3-5> ;
  fro-usc:hasContentText "As trustee for the covered broker or dealer, SIPC shall determine and satisfy, consistent with this subchapter and with the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.), all claims against the covered broker or dealer arising on or before the filing date." ;
  fro-usc:hasHeading "Determination of claims" ;
  fro-usc:hasId "id839a8c4f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/a/2/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c50-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c51-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c52-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c5a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c5b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-3> ;
  fro-usc:hasHeading "Powers and duties of SIPC" ;
  fro-usc:hasId "id839a8c50-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id839a8c51-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-3-2> ;
  fro-usc:hasContentText "Except as provided in this section, upon its appointment as trustee for the liquidation of a covered broker or dealer, SIPC shall have all of the powers and duties provided by the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.), including, without limitation, all rights of action against third parties, and shall conduct such liquidation in accordance with the terms of the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.), except that SIPC shall have no powers or duties with respect to assets and liabilities transferred by the Corporation from the covered broker or dealer to any bridge financial company established in accordance with this subchapter." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8c51-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/b/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
