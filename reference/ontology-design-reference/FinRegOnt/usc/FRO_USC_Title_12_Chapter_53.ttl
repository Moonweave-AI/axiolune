  fro-usc:hasContentText "an identification of the scope of the problem of misleading or fraudulent marketing in the State;" ;
  fro-usc:hasId "id83ad783e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/c/1/A" ;
