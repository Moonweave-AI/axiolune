  fro-usc:hasContentText "take enforcement action against the designated financial market utility." ;
  fro-usc:hasId "id83a40353-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/e/4/B" ;
