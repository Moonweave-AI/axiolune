  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b25aa4-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-6> ;
  fro-usc:hasHeading "Incidental transfers" ;
  fro-usc:hasId "id83b25a9f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5585" ;
  fro-usc:hasNumberText "§ 5585." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25aa2-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25aa0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-6-2> ;
  fro-usc:hasContentText "The Director of the Office of Management and Budget, in consultation with the Secretary, shall make such additional incidental transfers and dispositions of assets and liabilities held, used, arising from, available, or to be made available, in connection with the functions transferred by this title, 1 as the Director may determine necessary to accomplish the purposes of this title. 1" ;
  fro-usc:hasHeading "Incidental transfers authorized" ;
  fro-usc:hasId "id83b25aa0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5585/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83b25aa1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-6-3> ;
  fro-usc:hasContentText "The authority provided in this section shall terminate 5 years after July 21, 2010 ." ;
  fro-usc:hasHeading "Sunset" ;
  fro-usc:hasId "id83b25aa1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5585/b" ;
  fro-usc:hasNumberText "(b)" ;
.
