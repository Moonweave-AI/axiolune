  fro-usc:hasContentText "appoint itself as receiver for the insured depository institution that defaults; and" ;
  fro-usc:hasId "id83b4a43f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5613/c/1" ;
