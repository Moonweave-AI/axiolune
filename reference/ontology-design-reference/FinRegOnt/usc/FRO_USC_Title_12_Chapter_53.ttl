  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-5> ;
  fro-usc:hasContentText "The Office may establish such performance objectives and reporting requirements for States and eligible entities receiving a grant under this section as the Office determines are necessary to carry out and assess the effectiveness of the program under this section." ;
  fro-usc:hasHeading "Performance objectives and reporting requirements" ;
  fro-usc:hasId "id83ad7845-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/d" ;
  fro-usc:hasNumberText "(d)" ;
.
