  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-13-3-2-3> ;
  fro-usc:hasContentText "any records or other information under the control of or used by the Council;" ;
  fro-usc:hasId "id8395aa98-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5332/b/1/A" ;
