  lkif-mereo:component fro-usc-t12-ch53:id839cd5f9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8d01-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-2> ;
  fro-usc:hasContentText "The Corporation shall abide by any final, non-appealable judgment of any court of competent jurisdiction that was rendered before the appointment of the Corporation as receiver." ;
  fro-usc:hasHeading "Prior final adjudication" ;
  fro-usc:hasId "id839a8d01-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839a8d02-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-3> ;
  fro-usc:hasHeading "Rights and remedies of receiver" ;
  fro-usc:hasId "id839a8d02-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-10-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8d03-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd5f4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8d03-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-3-3> ;
  fro-usc:hasContentText "have all the rights and remedies available to the covered financial company (before the date of appointment of the Corporation as receiver under section 5382 of this title ) and the Corporation, including removal to Federal court and all appellate rights; and" ;
  fro-usc:hasId "id839a8d03-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/B/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5382" ;
.
fro-usc-t12-ch53:id839cd5f4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-3-4> ;
  fro-usc:hasContentText "not be required to post any bond in order to pursue such remedies." ;
  fro-usc:hasId "id839cd5f4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd5f5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-4> ;
  fro-usc:hasContentText "No attachment or execution may be issued by any court upon assets in the possession of the Corporation as receiver for a covered financial company." ;
  fro-usc:hasHeading "No attachment or execution" ;
  fro-usc:hasId "id839cd5f5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839cd5f6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-5> ;
  fro-usc:hasHeading "Limitation on judicial review" ;
  fro-usc:hasId "id839cd5f6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-10-5-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd5f7-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd5f8-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd5f7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-5-3> ;
  fro-usc:hasContentText "any claim or action for payment from, or any action seeking a determination of rights with respect to, the assets of any covered financial company for which the Corporation has been appointed receiver, including any assets which the Corporation may acquire from itself as such receiver; or" ;
  fro-usc:hasId "id839cd5f7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/D/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839cd5f8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-5-4> ;
  fro-usc:hasContentText "any claim relating to any act or omission of such covered financial company or the Corporation as receiver." ;
  fro-usc:hasId "id839cd5f8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/D/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd5f9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-6> ;
  fro-usc:hasHeading "Disposition of assets" ;
  fro-usc:hasId "id839cd5f9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/E" ;
  fro-usc:hasNumberText "(E)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-10-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd5fa-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd5fb-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd5fc-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd5fd-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd5fe-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd5fa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-6-3> ;
  fro-usc:hasContentText "maximizes the net present value return from the sale or disposition of such assets;" ;
  fro-usc:hasId "id839cd5fa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/E/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839cd5fb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-6-4> ;
  fro-usc:hasContentText "minimizes the amount of any loss realized in the resolution of cases;" ;
  fro-usc:hasId "id839cd5fb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/E/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd5fc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-6-5> ;
  fro-usc:hasContentText "mitigates the potential for serious adverse effects to the financial system;" ;
  fro-usc:hasId "id839cd5fc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/E/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839cd5fd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-6-6> ;
  fro-usc:hasContentText "ensures timely and adequate competition and fair and consistent treatment of offerors; and" ;
  fro-usc:hasId "id839cd5fd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/E/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id839cd5fe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10-6-7> ;
  fro-usc:hasContentText "prohibits discrimination on the basis of race, sex, or ethnic group in the solicitation and consideration of offers." ;
  fro-usc:hasId "id839cd5fe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9/E/v" ;
  fro-usc:hasNumberText "(v)" ;
.
