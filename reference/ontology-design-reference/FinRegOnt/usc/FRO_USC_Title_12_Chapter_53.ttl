  fro-usc:hasContentText "treated as an officer of the United States; and" ;
  fro-usc:hasId "id83a40231-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5435/b/2/A" ;
