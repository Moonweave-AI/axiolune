fro-usc-t12-ch53:id83a673a9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-12-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a673a9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section 745(b)(3) of the Wall Street Transparency and Accountability Act of 2010, referred to in subsec. (a)(2), probably means section 5c(c)(3) of the Commodity Exchange Act, which is classified to section 7a–2(c)(3) of Title 7 does not contain a par. (3). , Agriculture. Section 745(b) of the Wall Street Transparency and Accountability Act of 2010, which is section 745(b) of Pub. L. 111–203 , added subsec. (c) of section 7a–2 of Title 7 and struck out former subsec. (c) of that section. Section 7a–2(c)(3) of Title 7 relates to stays of the certification for rules. Section 745(b) of Pub. L. 111–203" ;
  fro-usc:hasNoteText "The Wall Street Transparency and Accountability Act of 2010, referred to in subsecs. (a) and (b), is title VII of Pub. L. 111–203 , Agriculture. For complete classification of this Act to the Code, see Short Title note set out under section 8301 of Title 15 , Commerce and Trade, and Tables. , July 21, 2010 , 124 Stat. 1641 . Section 728 of the Act amended the act of Sept. 21, 1922, ch. 369 , to add a new section 21 which is classified to section 24a of Title 7" ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1922-09-21/ch369" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s745/b" ;
  fro-usc:hasReferenceText "/us/stat/124/1641" ;
  fro-usc:hasReferenceText "/us/usc/t15/s8301" ;
  fro-usc:hasReferenceText "/us/usc/t7/s24a" ;
  fro-usc:hasReferenceText "/us/usc/t7/s7a–2" ;
  fro-usc:hasReferenceText "/us/usc/t7/s7a–2/c/3" ;
.
