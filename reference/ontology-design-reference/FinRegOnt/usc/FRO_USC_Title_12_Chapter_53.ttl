  fro-usc:hasReferenceText "/us/stat/124/2012" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1042, July 21, 2010 , 124 Stat. 2012 .)" ;
.
fro-usc-t12-ch53:id83ad78a6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83ad78a6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This title, referred to in subsecs. (a), (b)(1)(A), and (d)(2), (3), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad78a7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-7-1> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83ad78a7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section effective on the designated transfer date, see section 1048 of Pub. L. 111–203 , set out as a note under section 5551 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1048" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5551" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id83ad7875-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad78a8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ad78ab-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ad78ac-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-4> ;
  fro-usc:hasContentText "This title, 1 and regulations, orders, guidance, and interpretations prescribed, issued, or established by the Bureau, shall not be construed to alter or affect the applicability of any regulation, order, guidance, or interpretation prescribed, issued, and established by the Comptroller of the Currency or the Director of the Office of Thrift Supervision regarding the applicability of State law under Federal banking law to any contract entered into on or before July 21, 2010 , by national banks, Federal savings associations, or subsidiaries thereof that are regulated and supervised by the Comptroller of the Currency or the Director of the Office of Thrift Supervision, respectively." ;
  fro-usc:hasHeading "Preservation of existing contracts" ;
  fro-usc:hasId "id83ad78a8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5553" ;
  fro-usc:hasNumberText "§ 5553." ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78a9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad78a9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
