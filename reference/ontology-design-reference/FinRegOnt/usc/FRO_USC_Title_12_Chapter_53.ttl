.
fro-usc-t12-ch53:id83a402b2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-7-2-10> ;
  fro-usc:hasContentText "an investment adviser, as defined in section 80b–2 of title 15 ;" ;
  fro-usc:hasId "id83a402b2-1df7-11e6-87ee-8e4a3ab90f2a" ;
