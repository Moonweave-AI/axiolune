.
fro-usc-t12-ch53:id83a67368-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-5-2-2-3> ;
  fro-usc:hasContentText "this subchapter; or" ;
  fro-usc:hasId "id83a67368-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/d/1/A/i" ;
