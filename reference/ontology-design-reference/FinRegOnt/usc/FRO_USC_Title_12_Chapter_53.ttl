  lkif-mereo:component fro-usc-t12-ch53:id839a8cf9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8cf7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-8-2-3> ;
  fro-usc:hasContentText "allowed by the receiver;" ;
  fro-usc:hasId "id839a8cf7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/7/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839a8cf8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-8-2-4> ;
  fro-usc:hasContentText "approved by the receiver pursuant to a final determination pursuant to paragraph (3) or (5), as applicable; or" ;
  fro-usc:hasId "id839a8cf8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/7/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839a8cf9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-8-2-5> ;
  fro-usc:hasContentText "determined by the final judgment of a court of competent jurisdiction." ;
  fro-usc:hasId "id839a8cf9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/7/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839a8cfa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-8-3> ;
  fro-usc:hasContentText "A creditor shall, in no event, receive less than the amount that the creditor is entitled to receive under paragraphs (2) and (3) of subsection (d), as applicable." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id839a8cfa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/7/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8cfb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-8-4> ;
  fro-usc:hasContentText "The Corporation as receiver may, in its sole discretion, and to the extent otherwise permitted by this section, pay dividends on proven claims at any time, and no liability shall attach to the Corporation as receiver, by reason of any such payment or for failure to pay dividends to a claimant whose claim is not proved at the time of any such payment." ;
  fro-usc:hasHeading "Payment of dividends on claims" ;
  fro-usc:hasId "id839a8cfb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/7/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839a8cfc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-8-5> ;
  fro-usc:hasContentText "The Corporation may prescribe such rules, including definitions of terms, as the Corporation deems appropriate to establish an interest rate for or to make payments of post-insolvency interest to creditors holding proven claims against the receivership estate of a covered financial company, except that no such interest shall be paid until the Corporation as receiver has satisfied the principal amount of all creditor claims." ;
  fro-usc:hasHeading "Rulemaking by the Corporation" ;
  fro-usc:hasId "id839a8cfc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/7/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839a8cfd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-9> ;
  fro-usc:hasHeading "Suspension of legal actions" ;
  fro-usc:hasId "id839a8cfd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/8" ;
  fro-usc:hasNumberText "(8)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8cfe-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8cff-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8cfe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-9-2> ;
  fro-usc:hasContentText "After the appointment of the Corporation as receiver for a covered financial company, the Corporation may request a stay in any judicial action or proceeding in which such covered financial company is or becomes a party, for a period of not to exceed 90 days." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8cfe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/8/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839a8cff-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-9-3> ;
  fro-usc:hasContentText "Upon receipt of a request by the Corporation pursuant to subparagraph (A), the court shall grant such stay as to all parties." ;
  fro-usc:hasHeading "Grant of stay by all courts required" ;
  fro-usc:hasId "id839a8cff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/8/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8d00-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-10> ;
  fro-usc:hasHeading "Additional rights and duties" ;
  fro-usc:hasId "id839a8d00-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/9" ;
  fro-usc:hasNumberText "(9)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8d01-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8d02-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd5f5-1df7-11e6-87ee-8e4a3ab90f2a ;
