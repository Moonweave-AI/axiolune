  fro-usc:hasContentText "to discuss the efforts, activities, objectives, and plans of the Council; and" ;
  fro-usc:hasId "id839360b7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
