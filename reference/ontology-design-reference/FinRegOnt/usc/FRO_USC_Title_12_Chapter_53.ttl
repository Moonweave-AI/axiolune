  fro-usc:hasContentText "the percentage of the amounts described in paragraph (1) that were paid to contractors described in subsection (c)(1);" ;
  fro-usc:hasId "id83a4026d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/e/2" ;
