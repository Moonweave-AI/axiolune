  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-9-4-10> ;
  fro-usc:hasContentText "other similar functions that the Council may determine." ;
  fro-usc:hasId "id83a402d2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/7/C/viii" ;
  fro-usc:hasNumberText "(viii)" ;
.
fro-usc-t12-ch53:id83a402d3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-9-5> ;
  fro-usc:hasContentText "Payment, clearing, and settlement activities shall not include public reporting of swap transaction data under section 727 or 763(i) of the Wall Street Transparency and Accountability Act of 2010." ;
  fro-usc:hasHeading "Exclusion" ;
  fro-usc:hasId "id83a402d3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/7/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83a402d4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-10> ;
  fro-usc:hasHeading "Supervisory Agency" ;
  fro-usc:hasId "id83a402d4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/8" ;
  fro-usc:hasNumberText "(8)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402d5-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402da-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a402d5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-10-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a402d5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/8/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-3-10-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402d6-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402d7-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402d8-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402d9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a402d6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-10-2-3> ;
  fro-usc:hasContentText "The Securities and Exchange Commission, with respect to a designated financial market utility that is a clearing agency registered with the Securities and Exchange Commission." ;
  fro-usc:hasId "id83a402d6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/8/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a402d7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-10-2-4> ;
  fro-usc:hasContentText "The Commodity Futures Trading Commission, with respect to a designated financial market utility that is a derivatives clearing organization registered with the Commodity Futures Trading Commission." ;
  fro-usc:hasId "id83a402d7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/8/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a402d8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-10-2-5> ;
  fro-usc:hasContentText "The appropriate Federal banking agency, with respect to a designated financial market utility that is an institution described in section 1813(q) of this title ." ;
  fro-usc:hasId "id83a402d8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/8/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813/q" ;
.
fro-usc-t12-ch53:id83a402d9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-10-2-6> ;
  fro-usc:hasContentText "The Board of Governors, with respect to a designated financial market utility that is otherwise not subject to the jurisdiction of any agency listed in clauses (i), (ii), and (iii)." ;
  fro-usc:hasId "id83a402d9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/8/A/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id83a402da-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-10-3> ;
  fro-usc:hasContentText "If a designated financial market utility is subject to the jurisdictional supervision of more than 1 agency listed in subparagraph (A), then such agencies should agree on 1 agency to act as the Supervisory Agency, and if such agencies cannot agree on which agency has primary jurisdiction, the Council shall decide which agency is the Supervisory Agency for purposes of this subchapter." ;
  fro-usc:hasHeading "Multiple agency jurisdiction" ;
  fro-usc:hasId "id83a402da-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/8/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a402db-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-11> ;
  fro-usc:hasContentText "The terms “systemically important” and “systemic importance” mean a situation where the failure of or a disruption to the functioning of a financial market utility or the conduct of a payment, clearing, or settlement activity could create, or increase, the risk of significant liquidity or credit problems spreading among financial institutions or markets and thereby threaten the stability of the financial system of the United States." ;
  fro-usc:hasHeading "Systemically important and systemic importance" ;
  fro-usc:hasId "id83a402db-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/9" ;
  fro-usc:hasNumberText "(9)" ;
.
fro-usc-t12-ch53:id83a402dc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-usc:hasId "id83a402dc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tVIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1803" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title VIII , § 803, July 21, 2010 , 124 Stat. 1803 .)" ;
.
fro-usc-t12-ch53:id83a402de-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-13-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a402de-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Sections 25 and 25A of the Federal Reserve Act, referred to in pars. (1)(C) and (5)(A)(iii), are classified to subchapters I (§ 601 et seq.) and II (§ 611 et seq.), respectively, of chapter 6 of this title." ;
  fro-usc:hasNoteText "Sections 727 and 763(i) of the Wall Street Transparency and Accountability Act of 2010, referred to in par. (7)(D), are sections 727 and 763(i) of Pub. L. 111–203 , which amended section 2 of Title 7 , Agriculture, and section 78m of Title 15 , Commerce and Trade, respectively, effective on the later of 360 days after July 21, 2010 , or, to the extent it requires a rulemaking, not less than 60 days after publication of the final rule or regulation." ;
  fro-usc:hasNoteText "The Commodity Exchange Act, referred to in pars. (5)(B) and (6)(B)(i), is act Sept. 21, 1922, ch. 369 , 42 Stat. 998 , which is classified generally to chapter 1 (§ 1 et seq.) of Title 7, Agriculture. For complete classification of this Act to the Code, see section 1 of Title 7 and Tables." ;
  fro-usc:hasNoteText "The Federal Credit Union Act, referred to in par. (1)(B), is act June 26, 1934, ch. 750 , 48 Stat. 1216 , which is classified principally to chapter 14 (§ 1751 et seq.) of this title. Section 101 of the Act, classified to section 1752 of this title , does not contain a definition of “credit union”. For complete classification of this Act to the Code, see section 1751 of this title and Tables." ;
  fro-usc:hasNoteText "The Securities Act of 1933, referred to in par. (7)(A), is title I of act May 27, 1933, ch. 38 , 48 Stat. 74 , which is classified generally to subchapter I (§ 77a et seq.) of chapter 2A of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 77a of Title 15 and Tables." ;
  fro-usc:hasNoteText "The Securities Exchange Act of 1934, referred to in pars. (5)(B) and (6)(B)(i), is act June 6, 1934, ch. 404 , 48 Stat. 881 , which is classified principally to chapter 2B (§ 78a et seq.) of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 78a of Title 15 and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1922-09-21/ch369" ;
  fro-usc:hasReferenceText "/us/act/1933-05-27/ch38" ;
  fro-usc:hasReferenceText "/us/act/1934-06-06/ch404" ;
  fro-usc:hasReferenceText "/us/act/1934-06-26/ch750" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/42/998" ;
  fro-usc:hasReferenceText "/us/stat/48/1216" ;
  fro-usc:hasReferenceText "/us/stat/48/74" ;
  fro-usc:hasReferenceText "/us/stat/48/881" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1751" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1752" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
