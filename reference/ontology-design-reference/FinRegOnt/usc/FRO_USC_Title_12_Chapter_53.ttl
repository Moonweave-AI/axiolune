.
fro-usc-t12-ch53:id83936057-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-6-2-3> ;
  fro-usc:hasContentText "incorporated or organized in a country other than the United States; and" ;
  fro-usc:hasId "id83936057-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/4/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83936058-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-6-2-4> ;
  fro-usc:hasContentText "predominantly engaged in, including through a branch in the United States, financial activities, as defined in paragraph (6)." ;
  fro-usc:hasId "id83936058-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/4/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83936059-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-6-3> ;
  fro-usc:hasHeading "U.S. nonbank financial company" ;
  fro-usc:hasId "id83936059-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/4/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-2-2-6-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id8393605a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393605b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8393605a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-6-3-3> ;
  fro-usc:hasContentText "incorporated or organized under the laws of the United States or any State; and" ;
  fro-usc:hasId "id8393605a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/4/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id8393605b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-6-3-4> ;
  fro-usc:hasContentText "predominantly engaged in financial activities, as defined in paragraph (6)." ;
  fro-usc:hasId "id8393605b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/4/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id8393605c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-6-4> ;
  fro-usc:hasContentText "The term “nonbank financial company” means a U.S. nonbank financial company and a foreign nonbank financial company." ;
  fro-usc:hasHeading "Nonbank financial company" ;
  fro-usc:hasId "id8393605c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/4/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id8393605d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-6-5> ;
  fro-usc:hasContentText "The term “nonbank financial company supervised by the Board of Governors” means a nonbank financial company that the Council has determined under section 5323 of this title shall be supervised by the Board of Governors." ;
  fro-usc:hasHeading "Nonbank financial company supervised by the Board of Governors" ;
  fro-usc:hasId "id8393605d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/4/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5323" ;
.
fro-usc-t12-ch53:id8393605e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-7> ;
  fro-usc:hasContentText "The term “Office of Financial Research” means the office established under section 5342 of this title ." ;
  fro-usc:hasHeading "Office of Financial Research" ;
  fro-usc:hasId "id8393605e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5342" ;
.
fro-usc-t12-ch53:id8393605f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-8> ;
  fro-usc:hasHeading "Predominantly engaged" ;
  fro-usc:hasId "id8393605f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-2-2-8-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83936060-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83936061-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83936060-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-8-3> ;
  fro-usc:hasContentText "the annual gross revenues derived by the company and all of its subsidiaries from activities that are financial in nature (as defined in section 4(k) of the Bank Holding Company Act of 1956 [ 12 U.S.C. 1843(k) ]) and, if applicable, from the ownership or control of one or more insured depository institutions, represents 85 percent or more of the consolidated annual gross revenues of the company; or" ;
  fro-usc:hasId "id83936060-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/6/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k" ;
.
fro-usc-t12-ch53:id83936061-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-8-4> ;
  fro-usc:hasContentText "the consolidated assets of the company and all of its subsidiaries related to activities that are financial in nature (as defined in section 4(k) of the Bank Holding Company Act of 1956) and, if applicable, related to the ownership or control of one or more insured depository institutions, represents 85 percent or more of the consolidated assets of the company." ;
  fro-usc:hasId "id83936061-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83936062-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-9> ;
  fro-usc:hasContentText "The terms “significant nonbank financial company” and “significant bank holding company” have the meanings given those terms by rule of the Board of Governors, but in no instance shall the term “significant nonbank financial company” include those entities that are excluded under paragraph (4)(B)." ;
  fro-usc:hasHeading "Significant institutions" ;
  fro-usc:hasId "id83936062-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/7" ;
  fro-usc:hasNumberText "(7)" ;
.
fro-usc-t12-ch53:id83936063-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-3> ;
  fro-usc:hasContentText "The Board of Governors shall establish, by regulation, the requirements for determining if a company is predominantly engaged in financial activities, as defined in subsection (a)(6)." ;
  fro-usc:hasHeading "Definitional criteria" ;
  fro-usc:hasId "id83936063-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83936064-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-4> ;
  fro-usc:hasContentText "For purposes of the application of parts A and C (other than section 5323(b) of this title ) with respect to a foreign nonbank financial company, references in this subchapter to “company” or “subsidiary” include only the United States activities and subsidiaries of such foreign company, except as otherwise provided." ;
  fro-usc:hasHeading "Foreign nonbank financial companies" ;
  fro-usc:hasId "id83936064-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5323/b" ;
.
fro-usc-t12-ch53:id83936065-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id83936065-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1391" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 102, July 21, 2010 , 124 Stat. 1391 .)" ;
.
fro-usc-t12-ch53:id83936067-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83936067-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Part C, referred to in subsec. (c), was in the original “subtitle C”, meaning subtitle C (§§ 161–176) of title I of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1420 , which is classified principally to part C (§ 5361 et seq.) of this subchapter. For complete classification of subtitle C to the Code, see Tables." ;
  fro-usc:hasNoteText "The Bank Holding Company Act of 1956, referred to in subsec. (a)(1), is act May 9, 1956, ch. 240 , 70 Stat. 133 , which is classified principally to chapter 17 (§ 1841 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 1841 of this title and Tables." ;
  fro-usc:hasNoteText "The Farm Credit Act of 1971, referred to in subsec. (a)(4)(B), is Pub. L. 92–181 , Dec. 10, 1971 , 85 Stat. 583 , which is classified principally to chapter 23 (§ 2001 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 2001 of this title and Tables." ;
  fro-usc:hasNoteText "This subchapter, referred to in subsecs. (a) and (c), was in the original “this title”, meaning title I of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1391 , which is classified principally to this subchapter. For complete classification of title I to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1956-05-09/ch240" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/92/181" ;
  fro-usc:hasReferenceText "/us/stat/124/1391" ;
  fro-usc:hasReferenceText "/us/stat/124/1420" ;
  fro-usc:hasReferenceText "/us/stat/70/133" ;
  fro-usc:hasReferenceText "/us/stat/85/583" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841" ;
  fro-usc:hasReferenceText "/us/usc/t12/s2001" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
