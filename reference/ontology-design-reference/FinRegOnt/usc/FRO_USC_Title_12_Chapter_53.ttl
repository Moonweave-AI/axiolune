  fro-usc:hasContentText "providing credit counseling to any consumer; and" ;
  fro-usc:hasId "id83a673ef-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/viii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83a673f0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-10-3> ;
  fro-usc:hasContentText "providing services to assist a consumer with debt management or debt settlement, modifying the terms of any extension of credit, or avoiding foreclosure;" ;
  fro-usc:hasId "id83a673f0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/viii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
