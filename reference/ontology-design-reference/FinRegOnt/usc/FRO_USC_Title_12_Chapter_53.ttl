  fro-usc:hasContentText "a broker or dealer that is required to be registered under the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.];" ;
  fro-usc:hasId "id83a6740e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/A" ;
