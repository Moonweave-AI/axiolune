  fro-usc:hasContentText "at the last address of the creditor appearing in such books;" ;
  fro-usc:hasId "id839a8cbb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/2/C/i" ;
