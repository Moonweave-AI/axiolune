  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-6-3-4-3-5> ;
  fro-usc:hasContentText "any other factors that the Council determines appropriate;" ;
  fro-usc:hasId "id83936129-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/b/3/A/iv" ;
