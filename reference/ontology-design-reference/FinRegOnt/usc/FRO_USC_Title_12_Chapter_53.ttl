  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id8395aafa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-3-2-4> ;
  fro-usc:hasContentText "The Office shall promulgate regulations pursuant to subsections (a)(1), (a)(2), (a)(7), and (c)(1) of section 5343 of this title regarding the type and scope of the data to be collected by the Data Center under this paragraph." ;
  fro-usc:hasHeading "Rulemaking" ;
  fro-usc:hasId "id8395aafa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/b/1/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5343" ;
.
