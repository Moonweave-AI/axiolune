  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-5-3-5> ;
  fro-usc:hasHeading "Use of existing reports" ;
  fro-usc:hasId "id83ab2dc0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/4" ;
  fro-usc:hasNumberText "(4)" ;
