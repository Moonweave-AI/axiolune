  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1055, July 21, 2010 , 124 Stat. 2029 .)" ;
.
fro-usc-t12-ch53:id83afe966-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-6-0> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83afe966-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section effective on the designated transfer date, see section 1058 of Pub. L. 111–203 , set out as a note under section 5561 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1058" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5561" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id83ad78ae-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe967-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83afe96a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-7> ;
  fro-usc:hasContentText "If the Bureau obtains evidence that any person, domestic or foreign, has engaged in conduct that may constitute a violation of Federal criminal law, the Bureau shall transmit such evidence to the Attorney General of the United States, who may institute criminal proceedings under appropriate law. Nothing in this section affects any other authority of the Bureau to disclose information." ;
  fro-usc:hasHeading "Referrals for criminal proceedings" ;
  fro-usc:hasId "id83afe967-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5566" ;
  fro-usc:hasNumberText "§ 5566." ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe968-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe968-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id83afe968-1df7-11e6-87ee-8e4a3ab90f2a" ;
