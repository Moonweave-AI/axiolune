.
fro-usc-t12-ch53:id839f472e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-17-2-3> ;
  fro-usc:hasContentText "such guaranty or other support and all related assets and liabilities are transferred to and assumed by a bridge financial company or a third party (other than a third party for which a conservator, receiver, trustee in bankruptcy, or other legal custodian has been appointed, or which is otherwise the subject of a bankruptcy or insolvency proceeding) within the same period of time as the Corporation is entitled to transfer the qualified financial contracts of such covered financial company; or" ;
  fro-usc:hasId "id839f472e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/16/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f472f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-17-2-4> ;
  fro-usc:hasContentText "the Corporation, as receiver, otherwise provides adequate protection with respect to such obligations." ;
  fro-usc:hasId "id839f472f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/16/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f4730-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-17-3> ;
  fro-usc:hasContentText "For purposes of this paragraph, a bridge financial company shall not be considered to be a third party for which a conservator, receiver, trustee in bankruptcy, or other legal custodian has been appointed, or which is otherwise the subject of a bankruptcy or insolvency proceeding." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id839f4730-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/16/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f4731-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f4732-1df7-11e6-87ee-8e4a3ab90f2a ;
