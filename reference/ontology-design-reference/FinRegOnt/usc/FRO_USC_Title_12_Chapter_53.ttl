  fro-usc:hasContentText "any other information, as the Office determines is appropriate." ;
  fro-usc:hasId "id83ad7844-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
