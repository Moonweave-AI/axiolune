.
fro-usc-t12-ch53:id83b4a480-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a481-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a482-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b4a485-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-8> ;
  fro-usc:hasHeading "Regulations" ;
  fro-usc:hasId "id83b4a480-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5627" ;
  fro-usc:hasNumberText "§ 5627." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a483-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a481-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-8-2> ;
  fro-usc:hasContentText "The Secretary is authorized to promulgate regulations to implement and administer the grant programs and undertakings authorized by this subchapter." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b4a481-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5627/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83b4a482-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-8-3> ;
  fro-usc:hasContentText "Regulations prescribed under this section may contain such classifications, differentiations, or other provisions, and may provide for such adjustments and exceptions for any class of grant programs, undertakings, or eligible entities, as, in the judgment of the Secretary, are necessary or proper to effectuate the purposes of this subchapter, to prevent circumvention or evasion of this subchapter, or to facilitate compliance with this subchapter." ;
  fro-usc:hasHeading "Regulatory authority" ;
  fro-usc:hasId "id83b4a482-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5627/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83b4a483-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "id83b4a483-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tXII" ;
  fro-usc:hasReferenceText "/us/stat/124/2132" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title XII , § 1209, July 21, 2010 , 124 Stat. 2132 .)" ;
.
