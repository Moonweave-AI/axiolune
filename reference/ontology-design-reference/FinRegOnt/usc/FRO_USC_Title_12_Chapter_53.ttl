.
fro-usc-t12-ch53:id83a19127-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-4-2-4> ;
  fro-usc:hasContentText "an analysis of the approval by the Secretary of the policies and procedures of the Corporation under section 5383 of this title and acceptance of the orderly liquidation plan of the Corporation under section 5390 of this title ; and" ;
  fro-usc:hasId "id83a19127-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/e/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5383" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390" ;
.
fro-usc-t12-ch53:id83a19128-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-4-2-5> ;
  fro-usc:hasContentText "an assessment of the terms and conditions underlying the purchase by the Secretary of obligations of the Corporation under section 5390 of this title ." ;
  fro-usc:hasId "id83a19128-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/e/1/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390" ;
.
fro-usc-t12-ch53:id83a19129-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-4-3> ;
  fro-usc:hasContentText "Not later than 6 months after the date of appointment of the Corporation as receiver under this subchapter and every 6 months thereafter, the Inspector General of the Department of the Treasury shall conduct the audit and investigation described in paragraph (1)." ;
  fro-usc:hasHeading "Frequency" ;
  fro-usc:hasId "id83a19129-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a1912a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-4-4> ;
  fro-usc:hasContentText "The Inspector General of the Department of the Treasury shall include in the semiannual reports required by section 5(a) of the Inspector General Act of 1978 (5 U.S.C. App.), a summary of the findings and assessments under paragraph (1), and shall appear before the appropriate committees of Congress, if requested, to present each such report." ;
  fro-usc:hasHeading "Reports and testimony" ;
  fro-usc:hasId "id83a1912a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a1912b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-4-5> ;
  fro-usc:hasContentText "The duties and responsibilities of the Inspector General of the Department of the Treasury under this subsection shall terminate 1 year after the date on which the obligations purchased by the Secretary from the Corporation under section 5390 of this title are fully redeemed." ;
  fro-usc:hasHeading "Termination of responsibilities" ;
  fro-usc:hasId "id83a1912b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/e/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390" ;
.
fro-usc-t12-ch53:id83a1912c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1912d-1df7-11e6-87ee-8e4a3ab90f2a ;
