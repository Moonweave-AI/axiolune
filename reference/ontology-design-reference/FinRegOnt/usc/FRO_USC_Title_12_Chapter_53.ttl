fro-usc-t12-ch53:id8395ab78-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-2-2-3> ;
  fro-usc:hasContentText "are more stringent than the standards and requirements applicable to nonbank financial companies and bank holding companies that do not present similar risks to the financial stability of the United States; and" ;
  fro-usc:hasId "id8395ab78-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395ab79-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-2-2-4> ;
  fro-usc:hasContentText "increase in stringency, based on the considerations identified in subsection (b)(3)." ;
  fro-usc:hasId "id8395ab79-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8395ab7a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-2-3> ;
  fro-usc:hasHeading "Tailored application" ;
  fro-usc:hasId "id8395ab7a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id8395ab7b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395ab7c-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395ab7b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-2-3-2> ;
  fro-usc:hasContentText "In prescribing more stringent prudential standards under this section, the Board of Governors may, on its own or pursuant to a recommendation by the Council in accordance with section 5325 of this title , differentiate among companies on an individual basis or by category, taking into consideration their capital structure, riskiness, complexity, financial activities (including the financial activities of their subsidiaries), size, and any other risk-related factors that the Board of Governors deems appropriate." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id8395ab7b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5325" ;
.
fro-usc-t12-ch53:id8395ab7c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-2-3-3> ;
  fro-usc:hasContentText "The Board of Governors may, pursuant to a recommendation by the Council in accordance with section 5325 of this title , establish an asset threshold above $50,000,000,000 for the application of any standard established under subsections (c) through (g)." ;
  fro-usc:hasHeading "Adjustment of threshold for application of certain standards" ;
  fro-usc:hasId "id8395ab7c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5325" ;
.
