  fro-usc:hasContentText "on the appropriate use of designations in the offer or sale of securities or investment advice that meet or exceed the minimum requirements of the NASAA Model Rule on the Use of Senior-Specific Certifications and Professional Designations (or any successor thereto);" ;
  fro-usc:hasId "id83ad7848-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/e/1/A" ;
