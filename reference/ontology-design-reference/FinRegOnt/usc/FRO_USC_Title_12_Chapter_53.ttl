  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad77f6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-5-4> ;
  fro-usc:hasHeading "Provision of information to consumers" ;
  fro-usc:hasId "id83ad77f4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5534/c" ;
