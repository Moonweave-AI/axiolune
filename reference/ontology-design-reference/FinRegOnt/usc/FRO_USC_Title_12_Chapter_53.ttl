  fro-usc:hasContentText "the size and financial condition of the covered financial company;" ;
  fro-usc:hasId "id839a8c07-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/2/A" ;
