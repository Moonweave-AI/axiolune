  fro-usc:hasContentText "a description of how the proposed activities would be coordinated with other State efforts; and" ;
  fro-usc:hasId "id83ad7843-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/c/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
