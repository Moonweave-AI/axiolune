fro-usc-t12-ch53:id83b25a1d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-2-2-3> ;
  fro-usc:hasContentText "jointly determine the number of employees of the Board of Governors necessary to perform or support the consumer financial protection functions of the Board of Governors that are transferred to the Bureau by this title;  1 and" ;
  fro-usc:hasId "id83b25a1d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/1/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83b25a1e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-2-2-4> ;
  fro-usc:hasContentText "consistent with the number determined under clause (i), jointly identify employees of the Board of Governors for transfer to the Bureau, in a manner that the Bureau and the Board of Governors, in their sole discretion, determine equitable." ;
  fro-usc:hasId "id83b25a1e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/1/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83b25a1f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-2-3> ;
  fro-usc:hasContentText "All employees of the Board of Governors identified under subparagraph (A)(ii) shall be transferred to the Bureau for employment." ;
  fro-usc:hasHeading "Identified employees transferred" ;
  fro-usc:hasId "id83b25a1f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b25a20-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-2-2-4> ;
  fro-usc:hasContentText "Employees of any Federal reserve bank who are performing consumer financial protection functions on behalf of the Board of Governors shall be treated as employees of the Board of Governors for purposes of subparagraphs (A) and (B)." ;
  fro-usc:hasHeading "Federal reserve bank employees" ;
  fro-usc:hasId "id83b25a20-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/a/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
