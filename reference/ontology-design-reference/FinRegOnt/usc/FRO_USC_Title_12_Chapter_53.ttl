  lkif-mereo:component fro-usc-t12-ch53:id839f47f1-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47ee-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-4-2> ;
  fro-usc:hasContentText "is an insured depository institution, assessed pursuant to section 1817 or 1823(c)(4)(G) of this title;" ;
  fro-usc:hasId "id839f47ee-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f47ef-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-4-3> ;
  fro-usc:hasContentText "is a member of the Securities Investor Protection Corporation, assessed pursuant to section 4 of the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78ddd );" ;
  fro-usc:hasId "id839f47ef-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78ddd" ;
.
fro-usc-t12-ch53:id839f47f0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-4-4> ;
  fro-usc:hasContentText "is an insured credit union, assessed pursuant to section 1782(c)(1)(A)(i) of this title ; or" ;
  fro-usc:hasId "id839f47f0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1782/c/1/A/i" ;
.
fro-usc-t12-ch53:id839f47f1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-4-5> ;
  fro-usc:hasContentText "is an insurance company, assessed pursuant to applicable State law to cover (or reimburse payments made to cover) the costs of the rehabilitation, liquidation, or other State insolvency proceeding with respect to 1 or more insurance companies;" ;
  fro-usc:hasId "id839f47f1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
