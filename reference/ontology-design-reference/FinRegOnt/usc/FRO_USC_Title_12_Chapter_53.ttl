  fro-usc:hasId "id8395ab72-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1423" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 164, July 21, 2010 , 124 Stat. 1423 .)" ;
.
fro-usc-t12-ch53:id8395ab74-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-5-4-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id8395ab74-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Depository Institution Management Interlocks Act, referred to in text, is title II of Pub. L. 95–630 , Nov. 10, 1978 , 92 Stat. 3672 , which is classified principally to chapter 33 (§ 3201 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 3201 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/95/630" ;
  fro-usc:hasReferenceText "/us/stat/92/3672" ;
  fro-usc:hasReferenceText "/us/usc/t12/s3201" ;
.
