  lkif-mereo:component fro-usc-t12-ch53:id83ab2df7-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2df4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-2-3> ;
  fro-usc:hasContentText "coordinate the scheduling of examinations of the insured depository institution, insured credit union, or other covered person described in subsection (a);" ;
  fro-usc:hasId "id83ab2df4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2df5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-2-4> ;
  fro-usc:hasContentText "conduct simultaneous examinations of each insured depository institution or insured credit union, unless such institution requests examinations to be conducted separately;" ;
  fro-usc:hasId "id83ab2df5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2df6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-2-5> ;
  fro-usc:hasContentText "share each draft report of examination with the other agency and permit the receiving agency a reasonable opportunity (which shall not be less than a period of 30 days after the date of receipt) to comment on the draft report before such report is made final; and" ;
  fro-usc:hasId "id83ab2df6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ab2df7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-2-6> ;
  fro-usc:hasContentText "prior to issuing a final report of examination or taking supervisory action, take into consideration concerns, if any, raised in the comments made by the other agency." ;
  fro-usc:hasId "id83ab2df7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83ab2df8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-3> ;
  fro-usc:hasContentText "The Bureau shall pursue arrangements and agreements with State bank supervisors to coordinate examinations, consistent with paragraph (1)." ;
  fro-usc:hasHeading "Coordination with State bank supervisors" ;
  fro-usc:hasId "id83ab2df8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ab2df9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-4> ;
  fro-usc:hasHeading "Avoidance of conflict in supervision" ;
  fro-usc:hasId "id83ab2df9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dfa-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dfb-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2dfa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-4-2> ;
  fro-usc:hasContentText "If the proposed supervisory determinations of the Bureau and a prudential regulator (in this section referred to collectively as the “agencies”) are conflicting, an insured depository institution, insured credit union, or other covered person described in subsection (a) may request the agencies to coordinate and present a joint statement of coordinated supervisory action." ;
  fro-usc:hasHeading "Request" ;
  fro-usc:hasId "id83ab2dfa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2dfb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-4-3> ;
  fro-usc:hasContentText "The agencies shall provide a joint statement under subparagraph (A), not later than 30 days after the date of receipt of the request of the insured depository institution, credit union, or covered person described in subsection (a)." ;
  fro-usc:hasHeading "Joint statement" ;
  fro-usc:hasId "id83ab2dfb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2dfc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5> ;
  fro-usc:hasHeading "Appeals to governing panel" ;
  fro-usc:hasId "id83ab2dfc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4" ;
  fro-usc:hasNumberText "(4)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dfd-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dfe-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e03-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e0a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e0b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e0c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e0d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2dfd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-2> ;
  fro-usc:hasContentText "If the agencies do not resolve the conflict or issue a joint statement required by subparagraph (B), or if either of the agencies takes or attempts to take any supervisory action relating to the request for the joint statement without the consent of the other agency, an insured depository institution, insured credit union, or other covered person described in subsection (a) may institute an appeal to a governing panel, as provided in this subsection, not later than 30 days after the expiration of the period during which a joint statement is required to be filed under paragraph (3)(B)." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2dfd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2dfe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-3> ;
  fro-usc:hasHeading "Composition of governing panel" ;
  fro-usc:hasId "id83ab2dfe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-6-6-5-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2dff-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e02-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2dff-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-3-3> ;
  fro-usc:hasId "id83ab2dff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/B/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-6-6-5-3-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e00-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e01-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e00-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-3-3-2> ;
  fro-usc:hasContentText "have not participated in the material supervisory determinations under appeal; and" ;
  fro-usc:hasId "id83ab2e00-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/B/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83ab2e01-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-3-3-3> ;
  fro-usc:hasContentText "do not directly or indirectly report to the person who participated materially in the supervisory determinations under appeal; and" ;
  fro-usc:hasId "id83ab2e01-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/B/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83ab2e02-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-3-4> ;
  fro-usc:hasContentText "one individual representative, to be determined on a rotating basis, from among the Board of Governors, the Corporation, the National Credit Union Administration, and the Office of the Comptroller of the Currency, other than any agency involved in the subject dispute." ;
  fro-usc:hasId "id83ab2e02-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83ab2e03-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-4> ;
  fro-usc:hasHeading "Conduct of appeal" ;
  fro-usc:hasId "id83ab2e03-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-6-6-5-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e04-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e07-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e04-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-4-3> ;
  fro-usc:hasId "id83ab2e04-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/C/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-6-6-5-4-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e05-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e06-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e05-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-4-3-2> ;
  fro-usc:hasContentText "shall include in its appeal all the facts and legal arguments pertaining to the matter; and" ;
  fro-usc:hasId "id83ab2e05-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/C/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83ab2e06-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-4-3-3> ;
  fro-usc:hasContentText "may, through counsel, employees, or representatives, appear before the governing panel in person or by telephone; and" ;
  fro-usc:hasId "id83ab2e06-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/C/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83ab2e07-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-4-4> ;
  fro-usc:hasId "id83ab2e07-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-6-6-5-4-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e08-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e09-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e08-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-4-4-2> ;
  fro-usc:hasContentText "may request the insured depository institution, insured credit union, or other covered person described in subsection (a), the Bureau, or the prudential regulator to produce additional information relevant to the appeal; and" ;
  fro-usc:hasId "id83ab2e08-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/C/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83ab2e09-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-4-4-3> ;
  fro-usc:hasContentText "by a majority vote of its members, shall provide a final determination, in writing, not later than 30 days after the date of filing of an informationally complete appeal, or such longer period as the panel and the insured depository institution, insured credit union, or other covered person described in subsection (a) may jointly agree." ;
  fro-usc:hasId "id83ab2e09-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/C/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83ab2e0a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-5> ;
  fro-usc:hasContentText "A governing panel shall publish all information contained in a determination by the governing panel, with appropriate redactions of information that would be subject to an exemption from disclosure under section 552 of title 5 ." ;
  fro-usc:hasHeading "Public availability of determinations" ;
  fro-usc:hasId "id83ab2e0a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s552" ;
.
fro-usc-t12-ch53:id83ab2e0b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-6> ;
  fro-usc:hasContentText "The Bureau and the prudential regulators shall prescribe rules to provide safeguards from retaliation against the insured depository institution, insured credit union, or other covered person described in subsection (a) instituting an appeal under this paragraph, as well as their officers and employees." ;
  fro-usc:hasHeading "Prohibition against retaliation" ;
  fro-usc:hasId "id83ab2e0b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83ab2e0c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-7> ;
  fro-usc:hasContentText "The process provided in this paragraph shall not apply to a determination by a prudential regulator to appoint a conservator or receiver for an insured depository institution or a liquidating agent for an insured credit union, as the case may be, or a decision to take action pursuant to section 1831 o of this title or section 1790a of this title , as applicable." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id83ab2e0c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/F" ;
  fro-usc:hasNumberText "(F)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1790a" ;
.
fro-usc-t12-ch53:id83ab2e0d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-6-5-8> ;
  fro-usc:hasContentText "Nothing in this section shall modify or limit the authority of the Bureau to interpret, or take enforcement action under, any Federal consumer financial law, or the authority of a prudential regulator to interpret or take enforcement action under any other provision of Federal law for safety and soundness purposes." ;
  fro-usc:hasHeading "Effect on other authority" ;
  fro-usc:hasId "id83ab2e0d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/e/4/G" ;
  fro-usc:hasNumberText "(G)" ;
.
fro-usc-t12-ch53:id83ab2e0e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 7 ;
