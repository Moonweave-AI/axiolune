  fro-usc:hasId "id83981bb7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981bb8-1df7-11e6-87ee-8e4a3ab90f2a
