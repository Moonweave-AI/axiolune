  fro-usc:hasContentText "The Comptroller General of the United States shall conduct a study regarding international coordination relating to the orderly liquidation of financial companies under the Bankruptcy Code." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8bd9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/f/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
