  fro-usc:hasHeading "Rights of parties to contracts" ;
  fro-usc:hasId "id839cd6b0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/A" ;
