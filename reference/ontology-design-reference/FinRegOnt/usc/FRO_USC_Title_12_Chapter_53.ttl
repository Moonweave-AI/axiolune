  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-4-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e4f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/c/1" ;
  fro-usc:hasNumberText "(1)" ;
