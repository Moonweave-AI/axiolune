  fro-usc:hasContentText "the transfer of the accounts to a bridge financial company would materially interfere with the ability of the Corporation to avoid or mitigate serious adverse effects on financial stability or economic conditions in the United States." ;
  fro-usc:hasId "id839a8cb1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/O/i/II" ;
