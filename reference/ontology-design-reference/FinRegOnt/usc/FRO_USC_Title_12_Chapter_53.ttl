fro-usc-t12-ch53:id83a673dc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-15> ;
  fro-usc:hasContentText "The term “fair lending” means fair, equitable, and nondiscriminatory access to credit for consumers." ;
  fro-usc:hasHeading "Fair lending" ;
  fro-usc:hasId "id83a673dc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/13" ;
  fro-usc:hasNumberText "(13)" ;
.
fro-usc-t12-ch53:id83a673dd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-16> ;
  fro-usc:hasContentText "The term “Federal consumer financial law” means the provisions of this title, the enumerated consumer laws, the laws for which authorities are transferred under subtitles F and H, and any rule or order prescribed by the Bureau under this title, an enumerated consumer law, or pursuant to the authorities transferred under subtitles F and H. The term does not include the Federal Trade Commission Act [ 15 U.S.C. 41 et seq.]." ;
  fro-usc:hasHeading "Federal consumer financial law" ;
  fro-usc:hasId "id83a673dd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/14" ;
  fro-usc:hasNumberText "(14)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s41" ;
.
