.
fro-usc-t12-ch53:id83a8bcc4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-8-4-3-2> ;
  fro-usc:hasContentText "help seniors recognize warning signs of unfair, deceptive, or abusive practices, protect themselves from such practices;" ;
  fro-usc:hasId "id83a8bcc4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g/3/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a8bcc5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-8-4-3-3> ;
  fro-usc:hasContentText "provide one-on-one financial counseling on issues including long-term savings and later-life economic security; and" ;
  fro-usc:hasId "id83a8bcc5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g/3/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a8bcc6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-8-4-3-4> ;
  fro-usc:hasContentText "provide personal consumer credit advocacy to respond to consumer problems caused by unfair, deceptive, or abusive practices;" ;
  fro-usc:hasId "id83a8bcc6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g/3/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83a8bcc7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-8-4-4> ;
  fro-usc:hasContentText "monitor certifications or designations of financial advisors who advise seniors and alert the Commission and State regulators of certifications or designations that are identified as unfair, deceptive, or abusive;" ;
  fro-usc:hasId "id83a8bcc7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
