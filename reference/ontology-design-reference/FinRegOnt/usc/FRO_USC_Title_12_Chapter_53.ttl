fro-usc-t12-ch53:id83afea0a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-8-2-3> ;
  fro-usc:hasContentText "arises under any provision of law relating to any function of the Secretary of the Department of Housing and Urban Development with respect to the Real Estate Settlement Procedures Act of 1974 ( 12 U.S.C. 2601 transferred to the Bureau by this title;  and et seq.), the Secure and Fair Enforcement for Mortgage Licensing Act of 2008 [ 12 U.S.C. 5101 et seq.], or the Interstate Land Sales Full Disclosure Act ( 15 U.S.C. 1701 et seq)  3" ;
  fro-usc:hasId "id83afea0a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/g/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s2601" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5101" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1701" ;
.
fro-usc-t12-ch53:id83afea0b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-8-2-4> ;
  fro-usc:hasContentText "existed on the day before the designated transfer date." ;
  fro-usc:hasId "id83afea0b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/g/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83afea0c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-8-3> ;
  fro-usc:hasContentText "This title  shall not abate any proceeding commenced by or against the Secretary of the Department of Housing and Urban Development (or the Department of Housing and Urban Development) with respect to any consumer financial protection function of the Secretary of the Department of Housing and Urban Development transferred to the Bureau by this title  before the designated transfer date, except that the Bureau, subject to sections 5514, 5515, and 5516 of this title, shall be substituted for the Secretary of the Department of Housing and Urban Development (or the Department of Housing and Urban Development) as a party to any such proceeding as of the designated transfer date." ;
  fro-usc:hasHeading "Continuation of suits" ;
  fro-usc:hasId "id83afea0c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/g/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83afea0d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afea0e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afea0f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-9> ;
  fro-usc:hasHeading "Continuation of existing orders, rulings, determinations, agreements, and resolutions" ;
  fro-usc:hasId "id83afea0d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/h" ;
  fro-usc:hasNumberText "(h)" ;
.
fro-usc-t12-ch53:id83afea0e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-9-2> ;
  fro-usc:hasContentText "Except as provided in paragraph (2) and under subsection (i), all orders, resolutions, determinations, agreements, and rulings that have been issued, made, prescribed, or allowed to become effective by any transferor agency or by a court of competent jurisdiction, in the performance of consumer financial protection functions that are transferred by this title  and that are in effect on the day before the designated transfer date, shall continue in effect, and shall continue to be enforceable by the appropriate transferor agency, according to the terms of those orders, resolutions, determinations, agreements, and rulings, and shall not be enforceable by or against the Bureau." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afea0e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/h/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afea0f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-9-3> ;
  fro-usc:hasContentText "All orders, resolutions, determinations, agreements, and rulings that have been issued, made, prescribed, or allowed to become effective by any transferor agency or by a court of competent jurisdiction, in the performance of consumer financial protection functions that are transferred by this title  and that are in effect on the day before the designated transfer date with respect to any person described in section 5515(a) of this title , shall continue in effect, according to the terms of those orders, resolutions, determinations, agreements, and rulings, and shall be enforceable by or against the Bureau or transferor agency." ;
  fro-usc:hasHeading "Exception for orders applicable to persons described in" ;
  fro-usc:hasId "id83afea0f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/h/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5515/a" ;
.
fro-usc-t12-ch53:id83b25a10-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a11-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a12-1df7-11e6-87ee-8e4a3ab90f2a ;
