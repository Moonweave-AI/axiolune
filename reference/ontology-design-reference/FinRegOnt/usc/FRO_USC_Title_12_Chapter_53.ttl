  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
fro-usc-t12-ch53:id8393602b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-5-7> ;
  fro-usc:hasContentText "any futures association registered with the Commodity Futures Trading Commission under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.);" ;
  fro-usc:hasId "id8393602b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/C/vi" ;
  fro-usc:hasNumberText "(vi)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
fro-usc-t12-ch53:id8393602c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-5-8> ;
  fro-usc:hasContentText "any retail foreign exchange dealer registered with the Commodity Futures Trading Commission under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.), with respect to the activities of the retail foreign exchange dealer that require the retail foreign exchange dealer to be registered under that Act;" ;
  fro-usc:hasId "id8393602c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/C/vii" ;
  fro-usc:hasNumberText "(vii)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
fro-usc-t12-ch53:id8393602d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-5-9> ;
  fro-usc:hasContentText "any swap execution facility, swap data repository, swap dealer, or major swap participant registered with the Commodity Futures Trading Commission under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.) with respect to the swap activities of the person that require such person to be registered under that Act; and" ;
  fro-usc:hasId "id8393602d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/C/viii" ;
  fro-usc:hasNumberText "(viii)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
fro-usc-t12-ch53:id8393602e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-5-10> ;
  fro-usc:hasContentText "any registered entity under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.), with respect to the activities of the registered entity that require the registered entity to be registered under that Act;" ;
  fro-usc:hasId "id8393602e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/C/ix" ;
  fro-usc:hasNumberText "(ix)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
fro-usc-t12-ch53:id8393602f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-6> ;
  fro-usc:hasContentText "the State insurance authority of the State in which an insurance company is domiciled, with respect to the insurance activities and activities that are incidental to such insurance activities of an insurance company that is subject to supervision by the State insurance authority under State insurance law; and" ;
  fro-usc:hasId "id8393602f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83936030-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-7> ;
  fro-usc:hasContentText "the Federal Housing Finance Agency, with respect to Federal Home Loan Banks or the Federal Home Loan Bank System, and with respect to the Federal National Mortgage Association or the Federal Home Loan Mortgage Corporation." ;
  fro-usc:hasId "id83936030-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83936031-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-15> ;
  fro-usc:hasContentText "The term “prudential standards” means enhanced supervision and regulatory standards developed by the Board of Governors under section 5365 of this title ." ;
  fro-usc:hasHeading "Prudential standards" ;
  fro-usc:hasId "id83936031-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/13" ;
  fro-usc:hasNumberText "(13)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5365" ;
.
fro-usc-t12-ch53:id83936032-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-16> ;
  fro-usc:hasContentText "The term “Secretary” means the Secretary of the Treasury." ;
  fro-usc:hasHeading "Secretary" ;
  fro-usc:hasId "id83936032-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/14" ;
  fro-usc:hasNumberText "(14)" ;
.
