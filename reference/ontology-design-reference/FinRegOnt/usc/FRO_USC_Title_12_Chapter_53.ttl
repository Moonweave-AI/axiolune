  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-5-3-2> ;
  fro-usc:hasContentText "The appropriate financial regulator may request the Board of Governors to enforce this subchapter or the rules or orders prescribed under this subchapter against a financial institution that is subject to the standards prescribed under section 5464(a) of this title for a designated activity." ;
  fro-usc:hasHeading "Request to Board of Governors" ;
  fro-usc:hasId "id83a6736c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/d/2/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5464/a" ;
.
fro-usc-t12-ch53:id83a6736d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-5-3-3> ;
  fro-usc:hasContentText "Upon receipt of an appropriate written request, the Board of Governors shall determine whether an enforcement action is warranted, and, if so, it shall enforce compliance with this subchapter or the rules or orders prescribed under this subchapter and, if so, the financial institution shall be subject to, and the Board of Governors shall have authority under  the provisions of subsections (b) through (n) of section 1818 of this title in the same manner and to the same extent as if the financial institution was an insured depository institution and the Board of Governors was the appropriate Federal banking agency for such insured depository institution." ;
  fro-usc:hasHeading "Enforcement by Board of Governors" ;
  fro-usc:hasId "id83a6736d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/d/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1818" ;
.
fro-usc-t12-ch53:id83a6736e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a6736f-1df7-11e6-87ee-8e4a3ab90f2a ;
