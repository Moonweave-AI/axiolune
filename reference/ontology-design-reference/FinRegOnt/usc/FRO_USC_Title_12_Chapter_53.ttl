  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-10> ;
  fro-usc:hasId "id83a673ee-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/viii" ;
  fro-usc:hasNumberText "(viii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-17-2-10-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673ef-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673f0-1df7-11e6-87ee-8e4a3ab90f2a ;
