  fro-usc:hasContentText "assessing compliance with the requirements of Federal consumer financial law;" ;
  fro-usc:hasId "id83ab2db6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5514/b/1/A" ;
