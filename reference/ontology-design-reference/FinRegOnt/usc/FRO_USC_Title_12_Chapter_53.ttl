  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-7> ;
  fro-usc:hasHeading "Continuation of services" ;
  fro-usc:hasId "id83a40236-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5436" ;
  fro-usc:hasNumberText "§ 5436." ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-5-7-2> ;
