  fro-usc:hasContentText "a description of actions taken by the Secretary under this subchapter;" ;
  fro-usc:hasId "id83a19126-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/e/1/A" ;
