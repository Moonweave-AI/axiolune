  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-2-2> ;
  fro-usc:hasContentText "Except as provided in subsection (b), the term “transfer date” means the date that is 1 year after July 21, 2010 ." ;
  fro-usc:hasHeading "Transfer date" ;
