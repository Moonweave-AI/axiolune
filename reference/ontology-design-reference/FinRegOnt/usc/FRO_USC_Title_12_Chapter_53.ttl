  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-4> ;
  fro-usc:hasContentText "an investment adviser that is registered under the Investment Advisers Act of 1940 [ 15 U.S.C. 80b–1 et seq.];" ;
  fro-usc:hasId "id83a6740f-1df7-11e6-87ee-8e4a3ab90f2a" ;
