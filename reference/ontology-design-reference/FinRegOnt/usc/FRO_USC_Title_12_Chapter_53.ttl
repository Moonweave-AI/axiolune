.
fro-usc-t12-ch53:id83afe9ef-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-2-2-4> ;
  fro-usc:hasContentText "existed on the day before the designated transfer date." ;
  fro-usc:hasId "id83afe9ef-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83afe9f0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-2-3> ;
  fro-usc:hasContentText "No provision of this Act shall abate any proceeding commenced by or against the Board of Governors (or any Federal reserve bank) before the designated transfer date with respect to any consumer financial protection function of the Board of Governors (or any Federal reserve bank) transferred to the Bureau by this title, except that the Bureau, subject to sections 5514, 5515, and 5516 of this title, shall be substituted for the Board of Governors (or Federal reserve bank) as a party to any such proceeding as of the designated transfer date." ;
  fro-usc:hasHeading "Continuation of suits" ;
  fro-usc:hasId "id83afe9f0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
