  lkif-mereo:component fro-usc-t12-ch53:id839cd69b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd69a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-7-2-3> ;
  fro-usc:hasContentText "treat the contract as terminated by such repudiation; or" ;
  fro-usc:hasId "id839cd69a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839cd69b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-7-2-4> ;
  fro-usc:hasContentText "remain in possession of such real property." ;
  fro-usc:hasId "id839cd69b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd69c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-7-3> ;
  fro-usc:hasHeading "Provisions applicable to purchaser remaining in possession" ;
  fro-usc:hasId "id839cd69c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-7-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd69d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6a0-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd69d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-7-3-3> ;
  fro-usc:hasId "id839cd69d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/B/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-7-3-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd69e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd69f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd69e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-7-3-3-2> ;
  fro-usc:hasContentText "shall continue to make all payments due under the contract after the date of the repudiation of the contract; and" ;
  fro-usc:hasId "id839cd69e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/B/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd69f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-7-3-3-3> ;
  fro-usc:hasContentText "may offset against any such payments any damages which accrue after such date due to the nonperformance (after such date) of any obligation of the covered financial company under the contract; and" ;
  fro-usc:hasId "id839cd69f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/B/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd6a0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-7-3-4> ;
  fro-usc:hasId "id839cd6a0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-7-3-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6a1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6a2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6a3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd6a1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-7-3-4-2> ;
  fro-usc:hasContentText "not be liable to the purchaser for any damages arising after such date as a result of the repudiation, other than the amount of any offset allowed under clause (i)(II);" ;
  fro-usc:hasId "id839cd6a1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/B/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd6a2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-7-3-4-3> ;
  fro-usc:hasContentText "deliver title to the purchaser in accordance with the provisions of the contract; and" ;
  fro-usc:hasId "id839cd6a2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/B/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd6a3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-7-3-4-4> ;
  fro-usc:hasContentText "have no obligation under the contract other than the performance required under subclause (II)." ;
  fro-usc:hasId "id839cd6a3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/B/ii/III" ;
  fro-usc:hasNumberText "(III)" ;
.
