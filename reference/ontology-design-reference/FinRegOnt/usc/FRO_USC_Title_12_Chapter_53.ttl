  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcfa-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-9-2> ;
  fro-usc:hasHeading "Study" ;
