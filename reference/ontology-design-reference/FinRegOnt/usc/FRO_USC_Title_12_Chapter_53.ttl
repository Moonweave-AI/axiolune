  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/1/C/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-3-4-2-2-4-2-2> ;
