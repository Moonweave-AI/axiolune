  fro-usc:hasContentText "an insured credit union with total assets of more than $10,000,000,000 and any affiliate thereof." ;
  fro-usc:hasId "id83ab2de1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5515/a/2" ;
