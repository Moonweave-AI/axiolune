fro-usc-t12-ch53:id839360ce-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-3> ;
  fro-usc:hasContentText "the extent of the leverage of the company;" ;
  fro-usc:hasId "id839360ce-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839360cf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-4> ;
  fro-usc:hasContentText "the extent and nature of the off-balance-sheet exposures of the company;" ;
  fro-usc:hasId "id839360cf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839360d0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-5> ;
  fro-usc:hasContentText "the extent and nature of the transactions and relationships of the company with other significant nonbank financial companies and significant bank holding companies;" ;
  fro-usc:hasId "id839360d0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839360d1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-6> ;
  fro-usc:hasContentText "the importance of the company as a source of credit for households, businesses, and State and local governments and as a source of liquidity for the United States financial system;" ;
  fro-usc:hasId "id839360d1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839360d2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-7> ;
  fro-usc:hasContentText "the importance of the company as a source of credit for low-income, minority, or underserved communities, and the impact that the failure of such company would have on the availability of credit in such communities;" ;
  fro-usc:hasId "id839360d2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id839360d3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-8> ;
  fro-usc:hasContentText "the extent to which assets are managed rather than owned by the company, and the extent to which ownership of assets under management is diffuse;" ;
  fro-usc:hasId "id839360d3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id839360d4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-9> ;
  fro-usc:hasContentText "the nature, scope, size, scale, concentration, interconnectedness, and mix of the activities of the company;" ;
  fro-usc:hasId "id839360d4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/G" ;
  fro-usc:hasNumberText "(G)" ;
.
fro-usc-t12-ch53:id839360d5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-10> ;
  fro-usc:hasContentText "the degree to which the company is already regulated by 1 or more primary financial regulatory agencies;" ;
  fro-usc:hasId "id839360d5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/H" ;
  fro-usc:hasNumberText "(H)" ;
.
fro-usc-t12-ch53:id839360d6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-11> ;
  fro-usc:hasContentText "the amount and nature of the financial assets of the company;" ;
  fro-usc:hasId "id839360d6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839360d7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-12> ;
  fro-usc:hasContentText "the amount and types of the liabilities of the company, including the degree of reliance on short-term funding; and" ;
  fro-usc:hasId "id839360d7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/J" ;
  fro-usc:hasNumberText "(J)" ;
.
fro-usc-t12-ch53:id839360d8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-4-2-3-13> ;
  fro-usc:hasContentText "any other risk-related factors that the Council deems appropriate." ;
  fro-usc:hasId "id839360d8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5323/a/2/K" ;
  fro-usc:hasNumberText "(K)" ;
.
