  fro-usc:hasContentText "developing tools for risk measurement and monitoring;" ;
  fro-usc:hasId "id8395aad5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/a/4" ;
