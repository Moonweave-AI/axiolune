  lkif-mereo:component fro-usc-t12-ch53:id839a8cf4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8cf2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-7-3> ;
  fro-usc:hasContentText "is in writing;" ;
  fro-usc:hasId "id839a8cf2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/6/A" ;
