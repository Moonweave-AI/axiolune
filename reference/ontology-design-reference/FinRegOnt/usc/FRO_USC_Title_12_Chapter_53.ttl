.
fro-usc-t12-ch53:id83a19165-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83a19168-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-3> ;
  fro-usc:hasContentText "In this title, 1 the term “transferred employee” means, as the context requires, an employee transferred to the Office of the Comptroller of the Currency or the Corporation under section 5432 of this title ." ;
  fro-usc:hasHeading "Definition" ;
  fro-usc:hasId "id83a19165-1df7-11e6-87ee-8e4a3ab90f2a" ;
