  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-16-7-2> ;
  fro-usc:hasContentText "to enhance the integrity, efficiency, competitiveness, and stability of United States financial markets;" ;
  fro-usc:hasId "id839360b0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/N/vi/I" ;
