  fro-usc:hasContentText "any person or entity acting on behalf of or under the authority of the Council, to the extent that such activities relate to work for the Council by such person or entity." ;
  fro-usc:hasId "id8395aa95-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5332/a/2" ;
