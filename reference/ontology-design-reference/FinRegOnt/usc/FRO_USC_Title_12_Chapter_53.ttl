  fro-usc:hasContentText "retain the documentation for review under paragraph (2); and" ;
  fro-usc:hasId "id839a8c04-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/c/1/B" ;
