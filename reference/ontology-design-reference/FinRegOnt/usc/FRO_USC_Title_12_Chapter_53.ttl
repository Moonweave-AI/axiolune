  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-7> ;
  fro-usc:hasId "id83a673e7-1df7-11e6-87ee-8e4a3ab90f2a" ;
