fro-usc-t12-ch53:id83b25aca-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-8-6> ;
  fro-usc:hasContentText "In order to prepare the Bureau to conduct examinations under section 5515 of this title upon the designated transfer date, the Bureau and the applicable prudential regulator may agree to include, on a sampling basis, examiners on examinations of the compliance with Federal consumer financial law of institutions described in section 5515(a) of this title conducted by the prudential regulators prior to the designated transfer date." ;
  fro-usc:hasHeading "Participation in examinations" ;
  fro-usc:hasId "id83b25aca-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5587/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5515" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5515/a" ;
.
