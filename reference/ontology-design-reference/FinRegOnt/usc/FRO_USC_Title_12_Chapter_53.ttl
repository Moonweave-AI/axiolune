  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-8> ;
  fro-usc:hasHeading "Study of prompt corrective action implementation by the appropriate Federal agencies" ;
  fro-usc:hasId "id839a8be0-1df7-11e6-87ee-8e4a3ab90f2a" ;
