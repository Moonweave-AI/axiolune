  fro-usc:hasReferenceText "/us/stat/124/1432" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 166, July 21, 2010 , 124 Stat. 1432 .)" ;
.
fro-usc-t12-ch53:id83981b06-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b07-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b08-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b15-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83981b1a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8> ;
  fro-usc:hasHeading "Affiliations" ;
  fro-usc:hasId "id83981b06-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367" ;
  fro-usc:hasNumberText "§ 5367." ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b18-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b07-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-2> ;
  fro-usc:hasContentText "Nothing in this part shall be construed to require a nonbank financial company supervised by the Board of Governors, or a company that controls a nonbank financial company supervised by the Board of Governors, to conform the activities thereof to the requirements of section 1843 of this title ." ;
  fro-usc:hasHeading "Affiliations" ;
  fro-usc:hasId "id83981b07-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843" ;
.
fro-usc-t12-ch53:id83981b08-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b09-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b0e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b0f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b10-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b11-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3> ;
  fro-usc:hasHeading "Requirement" ;
  fro-usc:hasId "id83981b08-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83981b09-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83981b09-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b0a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b0b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b0a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-2-2> ;
  fro-usc:hasContentText "If a nonbank financial company supervised by the Board of Governors conducts activities other than those that are determined to be financial in nature or incidental thereto under section 1843(k) of this title , the Board of Governors may require such company to establish and conduct all or a portion of such activities that are determined to be financial in nature or incidental thereto in or through an intermediate holding company established pursuant to regulation of the Board of Governors, not later than 90 days (or such longer period as the Board of Governors may deem appropriate) after the date on which the nonbank financial company supervised by the Board of Governors is notified of the determination of the Board of Governors under this section." ;
  fro-usc:hasHeading "Board authority" ;
  fro-usc:hasId "id83981b0a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k" ;
.
fro-usc-t12-ch53:id83981b0b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-2-3> ;
  fro-usc:hasHeading "Necessary actions" ;
  fro-usc:hasId "id83981b0b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-8-3-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b0c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b0d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b0c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-2-3-3> ;
  fro-usc:hasContentText "appropriately supervise activities that are determined to be financial in nature or incidental thereto; or" ;
  fro-usc:hasId "id83981b0c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/1/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83981b0d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-2-3-4> ;
  fro-usc:hasContentText "to  1 ensure that supervision by the Board of Governors does not extend to the commercial activities of such nonbank financial company." ;
  fro-usc:hasId "id83981b0d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83981b0e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-3> ;
  fro-usc:hasContentText "For purposes of this subsection, activities that are determined to be financial in nature or incidental thereto under section 1843(k) of this title , as described in paragraph (1), shall not include internal financial activities, including internal treasury, investment, and employee benefit functions. With respect to any internal financial activity engaged in for the company or an affiliate and a non-affiliate of such company during the year prior to July 21, 2010 , such company (or an affiliate that is not an intermediate holding company or subsidiary of an intermediate holding company) may continue to engage in such activity, as long as not less than 2/3 of the assets or 2/3 of the revenues generated from the activity are from or attributable to such company or an affiliate, subject to review by the Board of Governors, to determine whether engaging in such activity presents undue risk to such company or to the financial stability of the United States." ;
  fro-usc:hasHeading "Internal financial activities" ;
  fro-usc:hasId "id83981b0e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k" ;
.
fro-usc-t12-ch53:id83981b0f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-4> ;
  fro-usc:hasContentText "A company that directly or indirectly controls an intermediate holding company established under this section shall serve as a source of strength to its subsidiary intermediate holding company." ;
  fro-usc:hasHeading "Source of strength" ;
  fro-usc:hasId "id83981b0f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83981b10-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-5> ;
  fro-usc:hasContentText "The Board of Governors may, from time to time, require reports under oath from a company that controls an intermediate holding company, and from the appropriate officers or directors of such company, solely for purposes of ensuring compliance with the provisions of this section, including assessing the ability of the company to serve as a source of strength to its subsidiary intermediate holding company pursuant to paragraph (3) and enforcing such compliance." ;
  fro-usc:hasHeading "Parent company reports" ;
  fro-usc:hasId "id83981b10-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83981b11-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-6> ;
  fro-usc:hasHeading "Limited parent company enforcement" ;
  fro-usc:hasId "id83981b11-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/5" ;
  fro-usc:hasNumberText "(5)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b12-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b13-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b14-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b12-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-6-2> ;
  fro-usc:hasContentText "In addition to any other authority of the Board of Governors, the Board of Governors may enforce compliance with the provisions of this subsection that are applicable to any company described in paragraph (1) that controls an intermediate holding company under section 8 of the Federal Deposit Insurance Act [ 12 U.S.C. 1818 ], and such company shall be subject to such section (solely for such purposes) in the same manner and to the same extent as if such company were a bank holding company." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83981b12-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/5/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1818" ;
.
fro-usc-t12-ch53:id83981b13-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-6-3> ;
  fro-usc:hasContentText "Any violation of this subsection by any company that controls an intermediate holding company may also be treated as a violation of the Federal Deposit Insurance Act [ 12 U.S.C. 1811 et seq.] for purposes of subparagraph (A)." ;
  fro-usc:hasHeading "Application of other Act" ;
  fro-usc:hasId "id83981b13-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/5/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1811" ;
.
fro-usc-t12-ch53:id83981b14-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-3-6-4> ;
  fro-usc:hasContentText "No provision of this paragraph shall be construed as limiting any authority of the Board of Governors or any other Federal agency under any other provision of law." ;
  fro-usc:hasHeading "No effect on other authority" ;
  fro-usc:hasId "id83981b14-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/b/5/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83981b15-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b16-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b17-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-4> ;
  fro-usc:hasHeading "Regulations" ;
  fro-usc:hasId "id83981b15-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-8-4-2> ;
.
fro-usc-t12-ch53:id83981b16-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-4-3> ;
  fro-usc:hasContentText "shall promulgate regulations to establish the criteria for determining whether to require a nonbank financial company supervised by the Board of Governors to establish an intermediate holding company under subsection (b); and" ;
  fro-usc:hasId "id83981b16-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83981b17-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-4-4> ;
  fro-usc:hasContentText "may promulgate regulations to establish any restrictions or limitations on transactions between an intermediate holding company or a nonbank financial company supervised by the Board of Governors and its affiliates, as necessary to prevent unsafe and unsound practices in connection with transactions between such company, or any subsidiary thereof, and its parent company or affiliates that are not subsidiaries of such company, except that such regulations shall not restrict or limit any transaction in connection with the bona fide acquisition or lease by an unaffiliated person of assets, goods, or services." ;
  fro-usc:hasId "id83981b17-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5367/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83981b18-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id83981b18-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1432" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 167, July 21, 2010 , 124 Stat. 1432 .)" ;
.
fro-usc-t12-ch53:id83981b1a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-8-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83981b1a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Federal Deposit Insurance Act, referred to in subsec. (b)(5)(B), is act Sept. 21, 1950, ch. 967 , § 2, 64 Stat. 873 , which is classified generally to chapter 16 (§ 1811 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 1811 of this title and Tables." ;
  fro-usc:hasNoteText "This part, referred to in subsec. (a), was in the original “this subtitle”, meaning subtitle C (§§ 161–176) of title I of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1420 , which is classified principally to this part. For complete classification of subtitle C to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1950-09-21/ch967" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1420" ;
  fro-usc:hasReferenceText "/us/stat/64/873" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1811" ;
.
fro-usc-t12-ch53:id83981b1b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83981b1e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-9> ;
  fro-usc:hasContentText "The Board of Governors shall have authority to issue regulations to implement parts A and C and the amendments made thereunder. Except as otherwise specified in part A or C, not later than 18 months after the effective date of this Act, the Board of Governors shall issue final regulations to implement parts A and C, and the amendments made thereunder." ;
  fro-usc:hasHeading "Regulations" ;
  fro-usc:hasId "id83981b1b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5368" ;
  fro-usc:hasNumberText "§ 5368." ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b1c-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b1c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id83981b1c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1434" ;
