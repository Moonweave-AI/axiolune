fro-usc-t12-ch53:id8390f008-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-3> ;
  fro-usc:hasContentText "The term “affiliate” has the same meaning as in section 1813 of this title ." ;
  fro-usc:hasHeading "Affiliate" ;
  fro-usc:hasId "id8390f008-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813" ;
.
fro-usc-t12-ch53:id8390f009-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-4> ;
  fro-usc:hasContentText "On and after the transfer date, the term “appropriate Federal banking agency” has the same meaning as in section 1813(q) of this title , as amended by title III. 1" ;
  fro-usc:hasHeading "Appropriate Federal banking agency" ;
  fro-usc:hasId "id8390f009-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813/q" ;
.
fro-usc-t12-ch53:id8390f00a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-5> ;
  fro-usc:hasContentText "The term “Board of Governors” means the Board of Governors of the Federal Reserve System." ;
  fro-usc:hasHeading "Board of Governors" ;
  fro-usc:hasId "id8390f00a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id8390f00b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-6> ;
  fro-usc:hasContentText "The term “Bureau” means the Bureau of Consumer Financial Protection established under title X." ;
  fro-usc:hasHeading "Bureau" ;
  fro-usc:hasId "id8390f00b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id8390f00c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-7> ;
  fro-usc:hasContentText "The term “Commission” means the Securities and Exchange Commission, except in the context of the Commodity Futures Trading Commission." ;
  fro-usc:hasHeading "Commission" ;
  fro-usc:hasId "id8390f00c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id8390f00d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-8> ;
  fro-usc:hasContentText "The terms “futures commission merchant”, “swap”, “swap dealer”, “swap execution facility”, “derivatives clearing organization”, “board of trade”, “commodity trading advisor”, “commodity pool”, and “commodity pool operator” have the same meanings as given the terms in section 1a of the Commodity Exchange Act ( 7 U.S.C. 1 et seq.) [ 7 U.S.C. 1a ]." ;
  fro-usc:hasHeading "Commodity futures terms" ;
  fro-usc:hasId "id8390f00d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1a" ;
.
fro-usc-t12-ch53:id8390f00e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-9> ;
  fro-usc:hasContentText "The term “Corporation” means the Federal Deposit Insurance Corporation." ;
  fro-usc:hasHeading "Corporation" ;
  fro-usc:hasId "id8390f00e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/7" ;
  fro-usc:hasNumberText "(7)" ;
.
fro-usc-t12-ch53:id8390f00f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-10> ;
  fro-usc:hasContentText "The term “Council” means the Financial Stability Oversight Council established under subchapter I." ;
  fro-usc:hasHeading "Council" ;
  fro-usc:hasId "id8390f00f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/8" ;
  fro-usc:hasNumberText "(8)" ;
.
fro-usc-t12-ch53:id8390f010-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-11> ;
  fro-usc:hasContentText "The term “credit union” means a Federal credit union, State credit union, or State-chartered credit union, as those terms are defined in section 1752 of this title ." ;
  fro-usc:hasHeading "Credit union" ;
  fro-usc:hasId "id8390f010-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/9" ;
  fro-usc:hasNumberText "(9)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1752" ;
.
fro-usc-t12-ch53:id8390f011-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-12> ;
  fro-usc:hasHeading "Federal banking agency" ;
  fro-usc:hasId "id8390f011-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/10" ;
  fro-usc:hasNumberText "(10)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-3-12-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id8390f012-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8390f013-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8390f012-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-12-3> ;
  fro-usc:hasContentText "“Federal banking agency” means, individually, the Board of Governors, the Office of the Comptroller of the Currency, and the Corporation; and" ;
  fro-usc:hasId "id8390f012-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/10/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8390f013-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-12-4> ;
  fro-usc:hasContentText "“Federal banking agencies” means all of the agencies referred to in subparagraph (A), collectively." ;
  fro-usc:hasId "id8390f013-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/10/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8390f014-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-13> ;
  fro-usc:hasContentText "The term “functionally regulated subsidiary” has the same meaning as in section 1844(c)(5) of this title ." ;
  fro-usc:hasHeading "Functionally regulated subsidiary" ;
  fro-usc:hasId "id8390f014-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/11" ;
  fro-usc:hasNumberText "(11)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1844/c/5" ;
.
