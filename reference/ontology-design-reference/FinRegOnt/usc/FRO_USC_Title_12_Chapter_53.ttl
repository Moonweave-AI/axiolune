fro-usc-t12-ch53:id8395aaa0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-14-2-2-3> ;
  fro-usc:hasContentText "explicit or implicit limits on the maximum size of banks, bank holding companies, and other large financial institutions;" ;
  fro-usc:hasId "id8395aaa0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5333/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395aaa1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-14-2-2-4> ;
  fro-usc:hasContentText "limits on the organizational complexity and diversification of large financial institutions;" ;
  fro-usc:hasId "id8395aaa1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5333/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8395aaa2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-14-2-2-5> ;
  fro-usc:hasContentText "requirements for operational separation between business units of large financial institutions in order to expedite resolution in case of failure;" ;
  fro-usc:hasId "id8395aaa2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5333/a/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id8395aaa3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-14-2-2-6> ;
  fro-usc:hasContentText "limits on risk transfer between business units of large financial institutions;" ;
  fro-usc:hasId "id8395aaa3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5333/a/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id8395aaa4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-14-2-2-7> ;
  fro-usc:hasContentText "requirements to carry contingent capital or similar mechanisms;" ;
  fro-usc:hasId "id8395aaa4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5333/a/1/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id8395aaa5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-14-2-2-8> ;
  fro-usc:hasContentText "limits on commingling of commercial and financial activities by large financial institutions;" ;
  fro-usc:hasId "id8395aaa5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5333/a/1/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id8395aaa6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-14-2-2-9> ;
  fro-usc:hasContentText "segregation requirements between traditional financial activities and trading or other high-risk operations in large financial institutions; and" ;
  fro-usc:hasId "id8395aaa6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5333/a/1/G" ;
  fro-usc:hasNumberText "(G)" ;
.
