.
fro-usc-t12-ch53:id83afe94f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-2-3-8> ;
  fro-usc:hasContentText "public notification regarding the violation, including the costs of notification;" ;
  fro-usc:hasId "id83afe94f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/a/2/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id83afe950-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-2-3-9> ;
  fro-usc:hasContentText "limits on the activities or functions of the person; and" ;
  fro-usc:hasId "id83afe950-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/a/2/G" ;
  fro-usc:hasNumberText "(G)" ;
.
fro-usc-t12-ch53:id83afe951-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-2-3-10> ;
  fro-usc:hasContentText "civil money penalties, as set forth more fully in subsection (c)." ;
  fro-usc:hasId "id83afe951-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/a/2/H" ;
  fro-usc:hasNumberText "(H)" ;
.
fro-usc-t12-ch53:id83afe952-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-2-4> ;
  fro-usc:hasContentText "Nothing in this subsection shall be construed as authorizing the imposition of exemplary or punitive damages." ;
  fro-usc:hasHeading "No exemplary or punitive damages" ;
  fro-usc:hasId "id83afe952-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83afe953-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-3> ;
  fro-usc:hasContentText "In any action brought by the Bureau, a State attorney general, or any State regulator to enforce any Federal consumer financial law, the Bureau, the State attorney general, or the State regulator may recover its costs in connection with prosecuting such action if the Bureau, the State attorney general, or the State regulator is the prevailing party in the action." ;
  fro-usc:hasHeading "Recovery of costs" ;
  fro-usc:hasId "id83afe953-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83afe954-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe955-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe956-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe95a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe960-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe961-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4> ;
  fro-usc:hasHeading "Civil money penalty in court and administrative actions" ;
  fro-usc:hasId "id83afe954-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83afe955-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-2> ;
  fro-usc:hasContentText "Any person that violates, through any act or omission, any provision of Federal consumer financial law shall forfeit and pay a civil penalty pursuant to this subsection." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe955-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afe956-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-3> ;
  fro-usc:hasHeading "Penalty amounts" ;
  fro-usc:hasId "id83afe956-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe957-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe958-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe959-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe957-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-3-2> ;
  fro-usc:hasContentText "For any violation of a law, rule, or final order or condition imposed in writing by the Bureau, a civil penalty may not exceed $5,000 for each day during which such violation or failure to pay continues." ;
  fro-usc:hasHeading "First tier" ;
  fro-usc:hasId "id83afe957-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83afe958-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-3-3> ;
  fro-usc:hasContentText "Notwithstanding paragraph (A), for any person that recklessly engages in a violation of a Federal consumer financial law, a civil penalty may not exceed $25,000 for each day during which such violation continues." ;
  fro-usc:hasHeading "Second tier" ;
  fro-usc:hasId "id83afe958-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83afe959-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-3-4> ;
  fro-usc:hasContentText "Notwithstanding subparagraphs (A) and (B), for any person that knowingly violates a Federal consumer financial law, a civil penalty may not exceed $1,000,000 for each day during which such violation continues." ;
  fro-usc:hasHeading "Third tier" ;
  fro-usc:hasId "id83afe959-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83afe95a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-4> ;
  fro-usc:hasHeading "Mitigating factors" ;
  fro-usc:hasId "id83afe95a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-7-6-4-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe95b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe95c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe95d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe95e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe95f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe95b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-4-3> ;
  fro-usc:hasContentText "the size of financial resources and good faith of the person charged;" ;
  fro-usc:hasId "id83afe95b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83afe95c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-4-4> ;
  fro-usc:hasContentText "the gravity of the violation or failure to pay;" ;
  fro-usc:hasId "id83afe95c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83afe95d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-4-5> ;
  fro-usc:hasContentText "the severity of the risks to or losses of the consumer, which may take into account the number of products or services sold or provided;" ;
  fro-usc:hasId "id83afe95d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83afe95e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-4-6> ;
  fro-usc:hasContentText "the history of previous violations; and" ;
  fro-usc:hasId "id83afe95e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/3/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83afe95f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-4-7> ;
  fro-usc:hasContentText "such other matters as justice may require." ;
  fro-usc:hasId "id83afe95f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/3/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83afe960-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-5> ;
  fro-usc:hasContentText "The Bureau may compromise, modify, or remit any penalty which may be assessed or had already been assessed under paragraph (2). The amount of such penalty, when finally determined, shall be exclusive of any sums owed by the person to the United States in connection with the costs of the proceeding, and may be deducted from any sums owing by the United States to the person charged." ;
  fro-usc:hasHeading "Authority to modify or remit penalty" ;
  fro-usc:hasId "id83afe960-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83afe961-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-6> ;
  fro-usc:hasHeading "Notice and hearing" ;
  fro-usc:hasId "id83afe961-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-7-6-4-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe962-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83afe963-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe962-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-6-3> ;
  fro-usc:hasContentText "the Bureau gives notice and an opportunity for a hearing to the person accused of the violation; or" ;
  fro-usc:hasId "id83afe962-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/5/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83afe963-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-6-4-6-4> ;
  fro-usc:hasContentText "the appropriate court has ordered such assessment and entered judgment in favor of the Bureau." ;
  fro-usc:hasId "id83afe963-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5565/c/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83afe964-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
