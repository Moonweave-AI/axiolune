  fro-usc:hasReferenceText "/us/stat/124/1524" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title III , § 316, July 21, 2010 , 124 Stat. 1524 .)" ;
.
fro-usc-t12-ch53:id83a191ac-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a191ac-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This title, referred to in subsecs. (a)(2), (b), and (d), is title III of Pub. L. 111–203 , 78 o –5, and 78w of Title 15, Commerce and Trade, sections 212, 657, 981, 982, 1006, 1014, and 1032 of Title 18, Crimes and Criminal Procedure, sections 321 and 714 of Title 31, Money and Finance, sections 4003 and 8105 of Title 42, The Public Health and Welfare, and section 3502 of Title 44 , Public Printing and Documents, repealed section 1441a of this title , enacted provisions set out as notes under sections 1, 16, 1438, 1787, 1812, 1817, and 1821 of this title and section 906 of Title 2 , and amended provisions set out as notes under sections 1437, 1463, 1464, 1467a, 1707, 1812, and 1818 of this title and section 509 of Title 28 , Judiciary and Judicial Procedure. For complete classification of title III to the Code, see Short title note set out under section 5301 of this title and Tables. , July 21, 2010 , 124 Stat. 1520 , known as the Enhancing Financial Institution Safety and Soundness Act of 2010, which enacted this subchapter and sections 4b and 16 of this title, amended sections 1, 11, 248, 461, 481, 482, 1438, 1462, 1462a, 1463, to 1464, 1466a, 1467, 1467a, 1468, 1468a, to 1468b, 1470, 1701c, 1701p–1, 1708, 1757, 1785, 1786, 1787, 1812, 1813, 1817, 1818, 1820, 1821, 1823, 1828, 1829, 1831e, 1831j, 1833b, 1833e, 1834, 1841, 1843, 1844, 1861, 1867, 1881, 1882, 1884, 1972, 2709, 2902, 2905, 3206 to 3208, 3332, 4515, and 4517 of this title, section 906 of Title 2 , The Congress, sections 78c, 78 l" ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1520" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1441a" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:hasReferenceText "/us/usc/t2/s906" ;
  fro-usc:hasReferenceText "/us/usc/t28/s509" ;
  fro-usc:hasReferenceText "/us/usc/t44/s3502" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a191ad-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83a191b0-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-6> ;
  fro-usc:hasContentText "On and after the transfer date, any reference in Federal law to the Director of the Office of Thrift Supervision or the Office of Thrift Supervision, in connection with any function of the Director of the Office of Thrift Supervision or the Office of Thrift Supervision transferred under section 5412(b) of this title or any other provision of this subtitle, shall be deemed to be a reference to the Comptroller of the Currency, the Office of the Comptroller of the Currency, the Chairperson of the Corporation, the Corporation, the Chairman of the Board of Governors, or the Board of Governors, as appropriate and consistent with the amendments made in subtitle E." ;
  fro-usc:hasHeading "References in Federal law to Federal banking agencies" ;
  fro-usc:hasId "id83a191ad-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5415" ;
  fro-usc:hasNumberText "§ 5415." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191ae-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a191ae-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id83a191ae-1df7-11e6-87ee-8e4a3ab90f2a" ;
