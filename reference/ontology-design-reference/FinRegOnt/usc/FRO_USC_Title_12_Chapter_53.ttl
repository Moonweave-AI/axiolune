  fro-usc:hasContentText "an organization operating under section 25 or 25A of the Federal Reserve Act ( 12 U.S.C. 601–604a and 611 through 631);" ;
  fro-usc:hasId "id83a402ad-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/5/A/iii" ;
