.
fro-usc-t12-ch53:id83a40251-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40252-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40255-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40256-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-2> ;
  fro-usc:hasHeading "Office of Minority and Women Inclusion" ;
  fro-usc:hasId "id83a40251-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a40252-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-2-2> ;
  fro-usc:hasHeading "Establishment" ;
  fro-usc:hasId "id83a40252-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40253-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40254-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40253-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-2-2-2> ;
  fro-usc:hasContentText "Except as provided in subparagraph (B), not later than 6 months after July 21, 2010 , each agency shall establish an Office of Minority and Women Inclusion that shall be responsible for all matters of the agency relating to diversity in management, employment, and business activities." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a40253-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a40254-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-2-2-3> ;
  fro-usc:hasContentText "The Bureau shall establish an Office of Minority and Women Inclusion not later than 6 months after the designated transfer date established under section 5582 of this title ." ;
  fro-usc:hasHeading "Bureau" ;
  fro-usc:hasId "id83a40254-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5582" ;
.
fro-usc-t12-ch53:id83a40255-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-2-3> ;
  fro-usc:hasContentText "Each agency that, on the day before July 21, 2010 , assigned the responsibilities described in paragraph (1) (or comparable responsibilities) to another office of the agency shall ensure that such responsibilities are transferred to the Office." ;
  fro-usc:hasHeading "Transfer of responsibilities" ;
  fro-usc:hasId "id83a40255-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a40256-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-2-4> ;
  fro-usc:hasContentText "The responsibilities described in paragraph (1) do not include enforcement of statutes, regulations, or executive orders pertaining to civil rights, except each Director shall coordinate with the agency administrator, or the designee of the agency administrator, regarding the design and implementation of any remedies resulting from violations of such statutes, regulations, or executive orders." ;
  fro-usc:hasHeading "Duties with respect to civil rights laws" ;
  fro-usc:hasId "id83a40256-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a40257-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40258-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40259-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4025d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4025e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-3> ;
  fro-usc:hasHeading "Director" ;
  fro-usc:hasId "id83a40257-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a40258-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-3-2> ;
  fro-usc:hasContentText "The Director of each Office shall be appointed by, and shall report to, the agency administrator. The position of Director shall be a career reserved position in the Senior Executive Service, as that position is defined in section 3132 of title 5 , or an equivalent designation." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a40258-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/b/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s3132" ;
.
fro-usc-t12-ch53:id83a40259-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-3-3> ;
  fro-usc:hasHeading "Duties" ;
  fro-usc:hasId "id83a40259-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-6-3-3-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4025a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4025b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4025c-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a4025a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-3-3-3> ;
  fro-usc:hasContentText "equal employment opportunity and the racial, ethnic, and gender diversity of the workforce and senior management of the agency;" ;
  fro-usc:hasId "id83a4025a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/b/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a4025b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-3-3-4> ;
  fro-usc:hasContentText "increased participation of minority-owned and women-owned businesses in the programs and contracts of the agency, including standards for coordinating technical assistance to such businesses; and" ;
  fro-usc:hasId "id83a4025b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a4025c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-3-3-5> ;
  fro-usc:hasContentText "assessing the diversity policies and practices of entities regulated by the agency." ;
  fro-usc:hasId "id83a4025c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/b/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a4025d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-3-4> ;
  fro-usc:hasContentText "Each Director shall advise the agency administrator on the impact of the policies and regulations of the agency on minority-owned and women-owned businesses." ;
  fro-usc:hasHeading "Other duties" ;
  fro-usc:hasId "id83a4025d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a4025e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-3-5> ;
  fro-usc:hasContentText "Nothing in paragraph (2)(C) may be construed to mandate any requirement on or otherwise affect the lending policies and practices of any regulated entity, or to require any specific action based on the findings of the assessment." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83a4025e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a4025f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40260-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40261-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40262-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4> ;
  fro-usc:hasHeading "Inclusion in all levels of business activities" ;
  fro-usc:hasId "id83a4025f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a40260-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4-2> ;
  fro-usc:hasContentText "The Director of each Office shall develop and implement standards and procedures to ensure, to the maximum extent possible, the fair inclusion and utilization of minorities, women, and minority-owned and women-owned businesses in all business and activities of the agency at all levels, including in procurement, insurance, and all types of contracts." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a40260-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a40261-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4-3> ;
  fro-usc:hasContentText "The procedures established by each agency for review and evaluation of contract proposals and for hiring service providers shall include, to the extent consistent with applicable law, a component that gives consideration to the diversity of the applicant. Such procedure shall include a written statement, in a form and with such content as the Director shall prescribe, that a contractor shall ensure, to the maximum extent possible, the fair inclusion of women and minorities in the workforce of the contractor and, as applicable, subcontractors." ;
  fro-usc:hasHeading "Contracts" ;
  fro-usc:hasId "id83a40261-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a40262-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4-4> ;
  fro-usc:hasHeading "Termination" ;
  fro-usc:hasId "id83a40262-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40263-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40264-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40263-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4-4-2> ;
  fro-usc:hasContentText "The standards and procedures developed and implemented under this subsection shall include a procedure for the Director to make a determination whether an agency contractor, and, as applicable, a subcontractor has failed to make a good faith effort to include minorities and women in their workforce." ;
  fro-usc:hasHeading "Determination" ;
  fro-usc:hasId "id83a40263-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a40264-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4-4-3> ;
  fro-usc:hasHeading "Effect of determination" ;
  fro-usc:hasId "id83a40264-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40265-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40266-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40265-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4-4-3-2> ;
  fro-usc:hasHeading "Recommendation to agency administrator" ;
  fro-usc:hasId "id83a40265-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c/3/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a40266-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4-4-3-3> ;
  fro-usc:hasHeading "Action by agency administrator" ;
  fro-usc:hasId "id83a40266-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c/3/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-6-3-4-4-3-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40267-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40268-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40269-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40267-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4-4-3-3-3> ;
  fro-usc:hasContentText "terminate the contract;" ;
  fro-usc:hasId "id83a40267-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c/3/B/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83a40268-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4-4-3-3-4> ;
  fro-usc:hasContentText "make a referral to the Office of Federal Contract Compliance Programs of the Department of Labor; or" ;
  fro-usc:hasId "id83a40268-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c/3/B/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83a40269-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-4-4-3-3-5> ;
  fro-usc:hasContentText "take other appropriate action." ;
  fro-usc:hasId "id83a40269-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/c/3/B/ii/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id83a4026a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-5> ;
  fro-usc:hasContentText "This section shall apply to all contracts of an agency for services of any kind, including the services of financial institutions, investment banking firms, mortgage banking firms, asset management firms, brokers, dealers, financial services entities, underwriters, accountants, investment consultants, and providers of legal services. The contracts referred to in this subsection include all contracts for all business and activities of an agency, at all levels, including contracts for the issuance or guarantee of any debt, equity, or security, the sale of assets, the management of the assets of the agency, the making of equity investments by the agency, and the implementation by the agency of programs to address economic recovery." ;
  fro-usc:hasHeading "Applicability" ;
  fro-usc:hasId "id83a4026a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/d" ;
  fro-usc:hasNumberText "(d)" ;
.
