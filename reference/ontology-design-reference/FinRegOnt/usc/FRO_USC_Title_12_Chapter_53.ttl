.
fro-usc-t12-ch53:id839a8bf1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-3-3> ;
  fro-usc:hasContentText "an evaluation of whether the financial company is in default or in danger of default;" ;
  fro-usc:hasId "id839a8bf1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839a8bf2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-3-4> ;
  fro-usc:hasContentText "a description of the effect that the default of the financial company would have on financial stability in the United States;" ;
  fro-usc:hasId "id839a8bf2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8bf3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-3-5> ;
  fro-usc:hasContentText "a description of the effect that the default of the financial company would have on economic conditions or financial stability for low income, minority, or underserved communities;" ;
  fro-usc:hasId "id839a8bf3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839a8bf4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-3-6> ;
  fro-usc:hasContentText "a recommendation regarding the nature and the extent of actions to be taken under this subchapter regarding the financial company;" ;
  fro-usc:hasId "id839a8bf4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839a8bf5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-3-7> ;
  fro-usc:hasContentText "an evaluation of the likelihood of a private sector alternative to prevent the default of the financial company;" ;
  fro-usc:hasId "id839a8bf5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/2/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id839a8bf6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-3-8> ;
  fro-usc:hasContentText "an evaluation of why a case under the Bankruptcy Code is not appropriate for the financial company;" ;
  fro-usc:hasId "id839a8bf6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/2/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id839a8bf7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-3-9> ;
  fro-usc:hasContentText "an evaluation of the effects on creditors, counterparties, and shareholders of the financial company and other market participants; and" ;
  fro-usc:hasId "id839a8bf7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/2/G" ;
  fro-usc:hasNumberText "(G)" ;
.
fro-usc-t12-ch53:id839a8bf8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-3-10> ;
  fro-usc:hasContentText "an evaluation of whether the company satisfies the definition of a financial company under section 5381 of this title ." ;
  fro-usc:hasId "id839a8bf8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/2/H" ;
  fro-usc:hasNumberText "(H)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5381" ;
.
fro-usc-t12-ch53:id839a8bf9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8bfa-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8bfb-1df7-11e6-87ee-8e4a3ab90f2a ;
