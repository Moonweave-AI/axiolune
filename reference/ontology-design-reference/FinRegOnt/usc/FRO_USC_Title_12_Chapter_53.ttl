  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-3> ;
  fro-usc:hasContentText "The Secretary and the Director shall disseminate information about the availability and functions of the Ombudsman to borrowers and potential borrowers, as well as institutions of higher education, lenders, guaranty agencies, loan servicers, and other participants in private education student loan programs." ;
  fro-usc:hasHeading "Public information" ;
  fro-usc:hasId "id83ad7801-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83ad7802-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7803-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7804-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7805-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7806-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-4> ;
  fro-usc:hasHeading "Functions of Ombudsman" ;
  fro-usc:hasId "id83ad7802-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-5-6-4-2> ;
.
fro-usc-t12-ch53:id83ad7803-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-4-3> ;
  fro-usc:hasContentText "in accordance with regulations of the Director, receive, review, and attempt to resolve informally complaints from borrowers of loans described in subsection (a), including, as appropriate, attempts to resolve such complaints in collaboration with the Department of Education and with institutions of higher education, lenders, guaranty agencies, loan servicers, and other participants in private education loan programs;" ;
  fro-usc:hasId "id83ad7803-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ad7804-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-4-4> ;
  fro-usc:hasContentText "not later than 90 days after the designated transfer date, establish a memorandum of understanding with the student loan ombudsman established under section 1018(f) of title 20 , to ensure coordination in providing assistance to and serving borrowers seeking to resolve complaints related to their private education or Federal student loans;" ;
  fro-usc:hasId "id83ad7804-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t20/s1018/f" ;
.
fro-usc-t12-ch53:id83ad7805-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-4-5> ;
  fro-usc:hasContentText "compile and analyze data on borrower complaints regarding private education loans; and" ;
  fro-usc:hasId "id83ad7805-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/c/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83ad7806-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-4-6> ;
  fro-usc:hasContentText "make appropriate recommendations to the Director, the Secretary, the Secretary of Education, the Committee on Banking, Housing, and Urban Affairs and the Committee on Health, Education, Labor, and Pensions of the Senate and the Committee on Financial Services and the Committee on Education and Labor of the House of Representatives." ;
  fro-usc:hasId "id83ad7806-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/c/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83ad7807-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7808-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7809-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-5> ;
  fro-usc:hasHeading "Annual reports" ;
  fro-usc:hasId "id83ad7807-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83ad7808-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-5-2> ;
  fro-usc:hasContentText "The Ombudsman shall prepare an annual report that describes the activities, and evaluates the effectiveness of the Ombudsman during the preceding year." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ad7808-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ad7809-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-5-3> ;
  fro-usc:hasContentText "The report required by paragraph (1) shall be submitted on the same date annually to the Secretary, the Secretary of Education, the Committee on Banking, Housing, and Urban Affairs and the Committee on Health, Education, Labor, and Pensions of the Senate and the Committee on Financial Services and the Committee on Education and Labor of the House of Representatives." ;
  fro-usc:hasHeading "Submission" ;
  fro-usc:hasId "id83ad7809-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ad780a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-6> ;
  fro-usc:hasContentText "For purposes of this section, the terms “private education loan” and “institution of higher education” have the same meanings as in section 1650 of title 15 ." ;
  fro-usc:hasHeading "Definitions" ;
  fro-usc:hasId "id83ad780a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s1650" ;
.
fro-usc-t12-ch53:id83ad780b-1df7-11e6-87ee-8e4a3ab90f2a
