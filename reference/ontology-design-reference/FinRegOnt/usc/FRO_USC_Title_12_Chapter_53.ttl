.
fro-usc-t12-ch53:id83981b86-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-13-4-2> ;
  fro-usc:hasContentText "a bank holding company, as defined in section 1841(a) of this title ;" ;
  fro-usc:hasId "id83981b86-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/11/B/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841/a" ;
.
fro-usc-t12-ch53:id83981b87-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-13-4-3> ;
  fro-usc:hasContentText "a nonbank financial company supervised by the Board of Governors;" ;
  fro-usc:hasId "id83981b87-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/11/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83981b88-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-13-4-4> ;
  fro-usc:hasContentText "any company that is predominantly engaged in activities that the Board of Governors has determined are financial in nature or incidental thereto for purposes of section 1843(k) of this title other than a company described in clause (i) or (ii); or" ;
  fro-usc:hasId "id83981b88-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/11/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k" ;
.
fro-usc-t12-ch53:id83981b89-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-13-4-5> ;
  fro-usc:hasContentText "any subsidiary of any company described in any of clauses (i) through (iii) that is predominantly engaged in activities that the Board of Governors has determined are financial in nature or incidental thereto for purposes of section 1843(k) of this title (other than a subsidiary that is an insured depository institution or an insurance company); and" ;
  fro-usc:hasId "id83981b89-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/11/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k" ;
.
fro-usc-t12-ch53:id83981b8a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-13-5> ;
  fro-usc:hasContentText "is not a Farm Credit System institution chartered under and subject to the provisions of the Farm Credit Act of 1971, as amended ( 12 U.S.C. 2001 et seq.), a governmental entity, or a regulated entity, as defined under section 4502(20) of this title ." ;
  fro-usc:hasId "id83981b8a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/11/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s2001" ;
  fro-usc:hasReferenceText "/us/usc/t12/s4502/20" ;
.
fro-usc-t12-ch53:id83981b8b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-14> ;
  fro-usc:hasContentText "The term “Fund” means the Orderly Liquidation Fund established under section 5390(n) of this title ." ;
  fro-usc:hasHeading "Fund" ;
  fro-usc:hasId "id83981b8b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/12" ;
  fro-usc:hasNumberText "(12)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390/n" ;
.
