  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ad780e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6> ;
  fro-usc:hasHeading "Private Education Loan Ombudsman" ;
  fro-usc:hasId "id83ad77ff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535" ;
  fro-usc:hasNumberText "§ 5535." ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad780b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad7800-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-6-2> ;
  fro-usc:hasContentText "The Secretary, in consultation with the Director, shall designate a Private Education Loan Ombudsman (in this section referred to as the “Ombudsman”) within the Bureau, to provide timely assistance to borrowers of private education loans." ;
  fro-usc:hasHeading "Establishment" ;
  fro-usc:hasId "id83ad7800-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5535/a" ;
  fro-usc:hasNumberText "(a)" ;
.
