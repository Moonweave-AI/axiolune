fro-usc-t12-ch53:id83a40229-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-6-2-3-2> ;
  fro-usc:hasContentText "manage the employees of the Office of Thrift Supervision who have not yet been transferred and provide for the payment of the compensation and benefits of the employees that accrue before the date on which the employees are transferred under this title;  and" ;
  fro-usc:hasId "id83a40229-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5435/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a4022a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-6-2-3-3> ;
  fro-usc:hasContentText "manage any property of the Office of Thrift Supervision, until the date on which the property is transferred under section 5433 of this title ; and" ;
  fro-usc:hasId "id83a4022a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5435/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5433" ;
.
fro-usc-t12-ch53:id83a4022b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-6-2-4> ;
  fro-usc:hasContentText "may take any other action necessary to wind up the affairs of the Office of Thrift Supervision." ;
  fro-usc:hasId "id83a4022b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5435/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
