.
fro-usc-t12-ch53:id8395ab5f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-2-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id8395ab5f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This subchapter, referred to in subsecs. (a)(1)(B) and (b)(1)(D), was in the original “this title”, meaning title I of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1391 , which is classified principally to this subchapter. For complete classification of title I to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1391" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395ab60-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395ab61-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395ab62-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id8395ab67-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-3> ;
  fro-usc:hasHeading "Enforcement" ;
  fro-usc:hasId "id8395ab60-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5362" ;
  fro-usc:hasNumberText "§ 5362." ;
  lkif-mereo:component fro-usc-t12-ch53:id8395ab65-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395ab61-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-3-2> ;
  fro-usc:hasContentText "Except as provided in subsection (b), a nonbank financial company supervised by the Board of Governors and any subsidiaries of such company (other than any depository institution subsidiary) shall be subject to the provisions of subsections (b) through (n) of section 1818 of this title , in the same manner and to the same extent as if the company were a bank holding company, as provided in section 1818(b)(3) of this title ." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id8395ab61-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5362/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1818" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1818/b/3" ;
.
fro-usc-t12-ch53:id8395ab62-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395ab63-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395ab64-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-3-3> ;
  fro-usc:hasHeading "Enforcement authority for functionally regulated subsidiaries" ;
  fro-usc:hasId "id8395ab62-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5362/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id8395ab63-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-3-3-2> ;
  fro-usc:hasContentText "If the Board of Governors determines that a condition, practice, or activity of a depository institution subsidiary or functionally regulated subsidiary of a nonbank financial company supervised by the Board of Governors does not comply with the regulations or orders prescribed by the Board of Governors under this Act, or otherwise poses a threat to the financial stability of the United States, the Board of Governors may recommend, in writing, to the primary financial regulatory agency for the subsidiary that such agency initiate a supervisory action or enforcement proceeding. The recommendation shall be accompanied by a written explanation of the concerns giving rise to the recommendation." ;
  fro-usc:hasHeading "Referral" ;
  fro-usc:hasId "id8395ab63-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5362/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395ab64-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-3-3-3> ;
  fro-usc:hasContentText "If, during the 60-day period beginning on the date on which the primary financial regulatory agency receives a recommendation under paragraph (1), the primary financial regulatory agency does not take supervisory or enforcement action against a subsidiary that is acceptable to the Board of Governors, the Board of Governors (upon a vote of its members) may take the recommended supervisory or enforcement action, as if the subsidiary were a bank holding company subject to supervision by the Board of Governors." ;
  fro-usc:hasHeading "Back-up authority of the Board of Governors" ;
  fro-usc:hasId "id8395ab64-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5362/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395ab65-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "id8395ab65-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1421" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 162, July 21, 2010 , 124 Stat. 1421 .)" ;
.
fro-usc-t12-ch53:id8395ab67-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-3-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id8395ab67-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This Act, referred to in subsec. (b)(1), is Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1376 , known as the Dodd-Frank Wall Street Reform and Consumer Protection Act, which enacted this chapter and chapters 108 (§ 8201 et seq.) and 109 (§ 8301 et seq.) of Title 15, Commerce and Trade, and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of this Act to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1376" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
