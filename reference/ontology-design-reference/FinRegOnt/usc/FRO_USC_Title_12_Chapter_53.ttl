fro-usc-t12-ch53:id8395aaf5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-3-2-2> ;
  fro-usc:hasContentText "The Data Center, on behalf of the Council, shall collect, validate, and maintain all data necessary to carry out the duties of the Data Center, as described in this part. The data assembled shall be obtained from member agencies, commercial data providers, publicly available data sources, and financial entities under subparagraph (B)." ;
  fro-usc:hasHeading "Data collection" ;
  fro-usc:hasId "id8395aaf5-1df7-11e6-87ee-8e4a3ab90f2a" ;
