  fro-usc:hasContentText "give due regard to the principle of national treatment and equality of competitive opportunity; and" ;
  fro-usc:hasId "id83936122-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5325/b/2/A" ;
