  fro-usc:hasContentText "limited to actual direct compensatory damages; and" ;
  fro-usc:hasId "id839cd67a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/3/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
