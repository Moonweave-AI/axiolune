  fro-usc:hasContentText "to amend an existing retirement plan (including the Federal Reserve System Retirement Plan or Federal Reserve System Thrift Plan);" ;
  fro-usc:hasId "id83b25a78-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/1/C/ii/I" ;
