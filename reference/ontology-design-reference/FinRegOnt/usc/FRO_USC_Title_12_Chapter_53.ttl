  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83b4a48d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-13-2-2-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a48e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a48f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a48e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-2-2-3> ;
  fro-usc:hasContentText "provides an executive officer, employee, director, or principal shareholder of the covered financial institution with excessive compensation, fees, or benefits; or" ;
  fro-usc:hasId "id83b4a48e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83b4a48f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-2-2-4> ;
  fro-usc:hasContentText "could lead to material financial loss to the covered financial institution." ;
  fro-usc:hasId "id83b4a48f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83b4a490-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-2-3> ;
  fro-usc:hasContentText "Nothing in this section shall be construed as requiring the reporting of the actual compensation of particular individuals. Nothing in this section shall be construed to require a covered financial institution that does not have an incentive-based payment arrangement to make the disclosures required under this subsection." ;
  fro-usc:hasHeading "Rules of construction" ;
  fro-usc:hasId "id83b4a490-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b4a491-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a492-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a493-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-3> ;
  fro-usc:hasHeading "Prohibition on certain compensation arrangements" ;
  fro-usc:hasId "id83b4a491-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-13-2-3-2> ;
.
fro-usc-t12-ch53:id83b4a492-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-3-3> ;
  fro-usc:hasContentText "by providing an executive officer, employee, director, or principal shareholder of the covered financial institution with excessive compensation, fees, or benefits; or" ;
  fro-usc:hasId "id83b4a492-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b4a493-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-3-4> ;
  fro-usc:hasContentText "that could lead to material financial loss to the covered financial institution." ;
  fro-usc:hasId "id83b4a493-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b4a494-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a495-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a496-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-4> ;
  fro-usc:hasHeading "Standards" ;
  fro-usc:hasId "id83b4a494-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-13-2-4-2> ;
.
fro-usc-t12-ch53:id83b4a495-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-4-3> ;
  fro-usc:hasContentText "ensure that any standards for compensation established under subsections (a) or (b) are comparable to the standards established under section 1831p–1  1 of this title for insured depository institutions; and" ;
  fro-usc:hasId "id83b4a495-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b4a496-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-4-4> ;
  fro-usc:hasContentText "in establishing such standards under such subsections, take into consideration the compensation standards described in section 1831p–1(c) of this title ." ;
  fro-usc:hasId "id83b4a496-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1831p–1/c" ;
.
fro-usc-t12-ch53:id83b4a497-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-5> ;
  fro-usc:hasContentText "The provisions of this section and the regulations issued under this section shall be enforced under section 505 of the Gramm-Leach-Bliley Act [ 15 U.S.C. 6805 ] and, for purposes of such section, a violation of this section or such regulations shall be treated as a violation of subtitle A of title V of such Act [ 15 U.S.C. 6801 et seq.]." ;
  fro-usc:hasHeading "Enforcement" ;
  fro-usc:hasId "id83b4a497-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s6801" ;
  fro-usc:hasReferenceText "/us/usc/t15/s6805" ;
.
fro-usc-t12-ch53:id83b4a498-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a499-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a49a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-6> ;
  fro-usc:hasHeading "Definitions" ;
  fro-usc:hasId "id83b4a498-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-13-2-6-2> ;
.
fro-usc-t12-ch53:id83b4a499-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-6-3> ;
  fro-usc:hasContentText "the term “appropriate Federal regulator” means the Board of Governors of the Federal Reserve System, the Office of the Comptroller of the Currency, the Board of Directors of the Federal Deposit Insurance Corporation, the Director of the Office of Thrift Supervision, the National Credit Union Administration Board, the Securities and Exchange Commission, the Federal Housing Finance Agency; and" ;
  fro-usc:hasId "id83b4a499-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
