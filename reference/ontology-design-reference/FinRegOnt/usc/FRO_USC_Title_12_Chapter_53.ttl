  fro-usc:hasIdentifierText "/us/usc/t12/s5401" ;
  fro-usc:hasNumberText "§ 5401." ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a19161-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a1915d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-2-3> ;
  fro-usc:hasContentText "to provide for the safe and sound operation of the banking system of the United States;" ;
  fro-usc:hasId "id83a1915d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5401/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a1915e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-2-4> ;
  fro-usc:hasContentText "to preserve and protect the dual system of Federal and State-chartered depository institutions;" ;
  fro-usc:hasId "id83a1915e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5401/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a1915f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-2-5> ;
  fro-usc:hasContentText "to ensure the fair and appropriate supervision of each depository institution, regardless of the size or type of charter of the depository institution; and" ;
  fro-usc:hasId "id83a1915f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5401/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a19160-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-2-6> ;
  fro-usc:hasContentText "to streamline and rationalize the supervision of depository institutions and the holding companies of depository institutions." ;
  fro-usc:hasId "id83a19160-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5401/4" ;
  fro-usc:hasNumberText "(4)" ;
.
