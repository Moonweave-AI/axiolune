  lkif-mereo:component fro-usc-t12-ch53:id83a8bc75-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a67480-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-4-2> ;
  fro-usc:hasHeading "Employee election" ;
  fro-usc:hasId "id83a67480-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/3/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-3-4-2-4-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67481-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67482-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a67481-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-4-2-3> ;
  fro-usc:hasContentText "both the Federal Reserve System Retirement Plan and the Federal Reserve System Thrift Plan, under the same terms on which such participation is offered to employees of the Board of Governors who participate in such plans and under the terms and conditions specified under section 5584(i)(1)(C) of this title ; or" ;
  fro-usc:hasId "id83a67481-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/3/A/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5584/i/1/C" ;
.
fro-usc-t12-ch53:id83a67482-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-4-2-4> ;
  fro-usc:hasContentText "the Civil Service Retirement System under chapter 83 of title 5 or the Federal Employees Retirement System under chapter 84 of title 5, if previously covered under one of those Federal employee retirement systems." ;
  fro-usc:hasId "id83a67482-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/3/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a67483-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-4-3> ;
  fro-usc:hasContentText "Bureau employees shall make an election under this paragraph not later than 1 year after the date of appointment by, or transfer under part F to, the Bureau. Participation in, and benefit accruals under, any other retirement plan established or maintained by the Federal Government shall end not later than the date on which participation in, and benefit accruals under, the Federal Reserve System Retirement Plan and Federal Reserve System Thrift Plan begin." ;
  fro-usc:hasHeading "Election period" ;
  fro-usc:hasId "id83a67483-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a8bc74-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-4-4> ;
  fro-usc:hasContentText "The Bureau shall pay an employer contribution to the Federal Reserve System Retirement Plan, in the amount established as an employer contribution under the Federal Employees Retirement System, as established under chapter 84 of title 5 for each Bureau employee who elects to participate in the Federal Reserve System Retirement Plan. The Bureau shall pay an employer contribution to the Federal Reserve System Thrift Plan for each Bureau employee who elects to participate in such plan, as required under the terms of such plan." ;
  fro-usc:hasHeading "Employer contribution" ;
  fro-usc:hasId "id83a8bc74-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a8bc75-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-4-5> ;
  fro-usc:hasContentText "The Bureau is the same employer as the Federal Reserve System (as comprised of the Board of Governors and each of the 12 Federal reserve banks prior to July 21, 2010 ) for purposes of subsections (b), (c), (m), and ( o ) of section 414 of title 26 ." ;
  fro-usc:hasHeading "Controlled group status" ;
  fro-usc:hasId "id83a8bc75-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/3/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t26/s414" ;
.
fro-usc-t12-ch53:id83a8bc76-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-5> ;
  fro-usc:hasContentText "Chapter 71 of title 5 shall apply to the Bureau and the employees of the Bureau." ;
  fro-usc:hasHeading "Labor-management relations" ;
  fro-usc:hasId "id83a8bc76-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a8bc77-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-6> ;
  fro-usc:hasHeading "Agency ombudsman" ;
  fro-usc:hasId "id83a8bc77-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/5" ;
  fro-usc:hasNumberText "(5)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bc78-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bc79-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bc78-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-6-2> ;
  fro-usc:hasContentText "Not later than 180 days after the designated transfer date, the Bureau shall appoint an ombudsman." ;
  fro-usc:hasHeading "Establishment required" ;
  fro-usc:hasId "id83a8bc78-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/5/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a8bc79-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-6-3> ;
  fro-usc:hasHeading "Duties of ombudsman" ;
  fro-usc:hasId "id83a8bc79-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/5/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-3-4-2-6-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bc7a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bc7b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bc7a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-6-3-3> ;
  fro-usc:hasContentText "act as a liaison between the Bureau and any affected person with respect to any problem that such party may have in dealing with the Bureau, resulting from the regulatory activities of the Bureau; and" ;
  fro-usc:hasId "id83a8bc7a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/5/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a8bc7b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-2-6-3-4> ;
  fro-usc:hasContentText "assure that safeguards exist to encourage complainants to come forward and preserve confidentiality." ;
  fro-usc:hasId "id83a8bc7b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/a/5/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
