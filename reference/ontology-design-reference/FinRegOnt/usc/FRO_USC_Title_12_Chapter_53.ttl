fro-usc-t12-ch53:id83981afc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-6-14-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83981afc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Subchapter II, referred to in subsec. (d)(6), was in the original “title II”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to subchapter II (§ 5381 et seq.) of this chapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteText "The Bank Holding Company Act of 1956, referred to in subsec. (g)(5), is act May 9, 1956, ch. 240 , 70 Stat. 133 , which is classified principally to chapter 17 (§ 1841 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 1841 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1956-05-09/ch240" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
  fro-usc:hasReferenceText "/us/stat/70/133" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841" ;
.
fro-usc-t12-ch53:id83981afd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981afe-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981aff-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b00-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-7> ;
  fro-usc:hasHeading "Early remediation requirements" ;
  fro-usc:hasId "id83981afd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5366" ;
  fro-usc:hasNumberText "§ 5366." ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b05-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981afe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-7-2> ;
  fro-usc:hasContentText "The Board of Governors, in consultation with the Council and the Corporation, shall prescribe regulations establishing requirements to provide for the early remediation of financial distress of a nonbank financial company supervised by the Board of Governors or a bank holding company described in section 5365(a) of this title , except that nothing in this subsection authorizes the provision of financial assistance from the Federal Government." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83981afe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5366/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5365/a" ;
.
fro-usc-t12-ch53:id83981aff-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-7-3> ;
  fro-usc:hasContentText "The purpose of the early remediation requirements under subsection (a) shall be to establish a series of specific remedial actions to be taken by a nonbank financial company supervised by the Board of Governors or a bank holding company described in section 5365(a) of this title that is experiencing increasing financial distress, in order to minimize the probability that the company will become insolvent and the potential harm of such insolvency to the financial stability of the United States." ;
  fro-usc:hasHeading "Purpose of the early remediation requirements" ;
  fro-usc:hasId "id83981aff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5366/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5365/a" ;
.
fro-usc-t12-ch53:id83981b00-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b01-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b02-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-7-4> ;
  fro-usc:hasHeading "Remediation requirements" ;
  fro-usc:hasId "id83981b00-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5366/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-7-4-2> ;
.
