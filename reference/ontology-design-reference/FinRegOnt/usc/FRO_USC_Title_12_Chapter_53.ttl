  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-8-2> ;
  fro-usc:hasContentText "The term “financial market utility” means any person that manages or operates a multilateral system for the purpose of transferring, clearing, or settling payments, securities, or other financial transactions among financial institutions or between financial institutions and the person." ;
  fro-usc:hasHeading "Inclusion" ;
  fro-usc:hasId "id83a402b7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/6/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a402b8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-8-3> ;
  fro-usc:hasHeading "Exclusions" ;
  fro-usc:hasId "id83a402b8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/6/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-3-8-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402b9-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402ba-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a402b9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-8-3-3> ;
  fro-usc:hasContentText "designated contract markets, registered futures associations, swap data repositories, and swap execution facilities registered under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.), or national securities exchanges, national securities associations, alternative trading systems, security-based swap data repositories, and swap execution facilities registered under the Securities Exchange Act of 1934 ( 15 U.S.C. 78a et seq.), solely by reason of their providing facilities for comparison of data respecting the terms of settlement of securities or futures transactions effected on such exchange or by means of any electronic system operated or controlled by such entities, provided that the exclusions in this clause apply only with respect to the activities that require the entity to be so registered; and" ;
  fro-usc:hasId "id83a402b9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/6/B/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
fro-usc-t12-ch53:id83a402ba-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-8-3-4> ;
  fro-usc:hasContentText "any broker, dealer, transfer agent, or investment company, or any futures commission merchant, introducing broker, commodity trading advisor, or commodity pool operator, solely by reason of functions performed by such institution as part of brokerage, dealing, transfer agency, or investment company activities, or solely by reason of acting on behalf of a financial market utility or a participant therein in connection with the furnishing by the financial market utility of services to its participants or the use of services of the financial market utility by its participants, provided that services performed by such institution do not constitute critical risk management or processing functions of the financial market utility." ;
  fro-usc:hasId "id83a402ba-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/6/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a402bb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-9> ;
  fro-usc:hasHeading "Payment, clearing, or settlement activity" ;
  fro-usc:hasId "id83a402bb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/7" ;
  fro-usc:hasNumberText "(7)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402bc-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402bd-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402ca-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a402d3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a402bc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-9-2> ;
  fro-usc:hasContentText "The term “payment, clearing, or settlement activity” means an activity carried out by 1 or more financial institutions to facilitate the completion of financial transactions, but shall not include any offer or sale of a security under the Securities Act of 1933 ( 15 U.S.C. 77a et seq.), or any quotation, order entry, negotiation, or other pre-trade activity or execution activity." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a402bc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/7/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
.
