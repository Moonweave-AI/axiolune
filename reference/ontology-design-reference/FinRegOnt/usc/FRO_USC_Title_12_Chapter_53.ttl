  fro-usc:hasContentText "providing the Board of Governors an enhanced role in the supervision of risk management standards for systemically important payment, clearing, and settlement activities by financial institutions." ;
  fro-usc:hasId "id83a4029c-1df7-11e6-87ee-8e4a3ab90f2a" ;
