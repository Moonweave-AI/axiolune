  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-4-4> ;
  fro-usc:hasContentText "electronic conduit services." ;
  fro-usc:hasId "id83a67407-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a67408-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-18> ;
  fro-usc:hasContentText "The term “foreign exchange” means the exchange, for compensation, of currency of the United States or of a foreign government for currency of another government." ;
  fro-usc:hasHeading "Foreign exchange" ;
  fro-usc:hasId "id83a67408-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/16" ;
  fro-usc:hasNumberText "(16)" ;
.
fro-usc-t12-ch53:id83a67409-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 19 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-19> ;
  fro-usc:hasContentText "The term “insured credit union” has the same meaning as in section 1752 of this title ." ;
  fro-usc:hasHeading "Insured credit union" ;
  fro-usc:hasId "id83a67409-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/17" ;
  fro-usc:hasNumberText "(17)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1752" ;
.
fro-usc-t12-ch53:id83a6740a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 20 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-20> ;
  fro-usc:hasContentText "The term “payment instrument” means a check, draft, warrant, money order, traveler’s check, electronic instrument, or other instrument, payment of funds, or monetary value (other than currency)." ;
  fro-usc:hasHeading "Payment instrument" ;
  fro-usc:hasId "id83a6740a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/18" ;
  fro-usc:hasNumberText "(18)" ;
.
fro-usc-t12-ch53:id83a6740b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 21 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-21> ;
  fro-usc:hasContentText "The term “person” means an individual, partnership, company, corporation, association (incorporated or unincorporated), trust, estate, cooperative organization, or other entity." ;
  fro-usc:hasHeading "Person" ;
  fro-usc:hasId "id83a6740b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/19" ;
  fro-usc:hasNumberText "(19)" ;
.
fro-usc-t12-ch53:id83a6740c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 22 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-22> ;
  fro-usc:hasContentText "The term “person regulated by the Commodity Futures Trading Commission” means any person that is registered, or required by statute or regulation to be registered, with the Commodity Futures Trading Commission, but only to the extent that the activities of such person are subject to the jurisdiction of the Commodity Futures Trading Commission under the Commodity Exchange Act [ 7 U.S.C. 1 et seq.]." ;
  fro-usc:hasHeading "Person regulated by the Commodity Futures Trading Commission" ;
  fro-usc:hasId "id83a6740c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/20" ;
  fro-usc:hasNumberText "(20)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
