  fro-usc:hasReferenceText "/us/stat/124/2004" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1029, July 21, 2010 , 124 Stat. 2004 .)" ;
.
fro-usc-t12-ch53:id83ab2ec1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-10-9-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83ab2ec1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Subtitle F, referred to in subsec. (c), is subtitle F (§§ 1061–1067) of title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 2035 , which is classified generally to part F (§ 5581 et seq.) of this subchapter. For complete classification of subtitle F to the Code, see Tables." ;
  fro-usc:hasNoteText "This title, referred to in subsec. (c), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/stat/124/2035" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2ec2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
