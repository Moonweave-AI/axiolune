.
fro-usc-t12-ch53:id83936156-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-2-3> ;
  fro-usc:hasId "id83936156-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-8-2-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83936157-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83936158-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83936157-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-2-3-2> ;
  fro-usc:hasContentText "was a bank holding company having total consolidated assets equal to or greater than $50,000,000,000 as of January 1, 2010 ; and" ;
  fro-usc:hasId "id83936157-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83936158-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-2-3-3> ;
  fro-usc:hasContentText "received financial assistance under or participated in the Capital Purchase Program established under the Troubled Asset Relief Program authorized by the Emergency Economic Stabilization Act of 2008 [ 12 U.S.C. 5201 et seq.]; and" ;
  fro-usc:hasId "id83936158-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5201" ;
.
fro-usc-t12-ch53:id8395aa49-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-2-4> ;
  fro-usc:hasContentText "any successor entity (as defined by the Board of Governors, in consultation with the Council) to an entity described in paragraph (1)." ;
  fro-usc:hasId "id8395aa49-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395aa4a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-3> ;
  fro-usc:hasContentText "If an entity described in subsection (a) ceases to be a bank holding company at any time after January 1, 2010 , then such entity shall be treated as a nonbank financial company supervised by the Board of Governors, as if the Council had made a determination under section 5323 of this title with respect to that entity." ;
  fro-usc:hasHeading "Treatment" ;
  fro-usc:hasId "id8395aa4a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5323" ;
.
fro-usc-t12-ch53:id8395aa4b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa4c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa4d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa53-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-4> ;
  fro-usc:hasHeading "Appeal" ;
  fro-usc:hasId "id8395aa4b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id8395aa4c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-4-2> ;
  fro-usc:hasContentText "An entity may request, in writing, an opportunity for a written or oral hearing before the Council to appeal its treatment as a nonbank financial company supervised by the Board of Governors in accordance with this section. Upon receipt of the request, the Council shall fix a time (not later than 30 days after the date of receipt of the request) and place at which such entity may appear, personally or through counsel, to submit written materials (or, at the sole discretion of the Council, oral testimony and oral argument)." ;
  fro-usc:hasHeading "Request for hearing" ;
  fro-usc:hasId "id8395aa4c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aa4d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-4-3> ;
  fro-usc:hasHeading "Decision" ;
  fro-usc:hasId "id8395aa4d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa4e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa4f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa52-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395aa4e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-4-3-2> ;
  fro-usc:hasContentText "A Council decision to grant an appeal under this subsection shall be made by a vote of not fewer than ⅔ of the voting members then serving, including an affirmative vote by the Chairperson. Not later than 60 days after the date of a hearing under paragraph (1), the Council shall submit a report to, and may testify before, the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives on the proposed decision of the Council regarding an appeal under paragraph (1), which report shall include a statement of the basis for the proposed decision of the Council." ;
  fro-usc:hasHeading "Proposed decision" ;
  fro-usc:hasId "id8395aa4e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395aa4f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-4-3-3> ;
  fro-usc:hasHeading "Notice of final decision" ;
  fro-usc:hasId "id8395aa4f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-8-4-3-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa50-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa51-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395aa50-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-4-3-3-3> ;
  fro-usc:hasContentText "the date of the submission of the report under subparagraph (A); or" ;
  fro-usc:hasId "id8395aa50-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/c/2/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id8395aa51-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-4-3-3-4> ;
  fro-usc:hasContentText "if, not later than 1 year after the date of submission of the report under subparagraph (A), the Committee on Banking, Housing, and Urban Affairs of the Senate or the Committee on Financial Services of the House of Representatives holds one or more hearings regarding such report, the date of the last such hearing." ;
  fro-usc:hasId "id8395aa51-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/c/2/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id8395aa52-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-4-3-4> ;
  fro-usc:hasContentText "In making a decision regarding an appeal under paragraph (1), the Council shall consider whether the company meets the standards under section 5323(a) or 5323(b) of this title, as applicable, and the definition of the term “nonbank financial company” under section 5311 of this title . The decision of the Council shall be final, subject to the review under paragraph (3)." ;
  fro-usc:hasHeading "Considerations" ;
  fro-usc:hasId "id8395aa52-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/c/2/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5311" ;
.
fro-usc-t12-ch53:id8395aa53-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-4-4> ;
  fro-usc:hasContentText "If the Council denies an appeal under this subsection, the Council shall, not less frequently than annually, review and reevaluate the decision." ;
  fro-usc:hasHeading "Review" ;
  fro-usc:hasId "id8395aa53-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5327/c/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id8395aa54-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id8395aa54-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1406" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 117, July 21, 2010 , 124 Stat. 1406 .)" ;
.
fro-usc-t12-ch53:id8395aa56-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-8-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id8395aa56-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Emergency Economic Stabilization Act of 2008, referred to in subsec. (a)(1)(B), is div. A of Pub. L. 110–343 , Oct. 3, 2008 , 122 Stat. 3765 , which is classified principally to chapter 52 (§ 5201 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 5201 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/110/343" ;
  fro-usc:hasReferenceText "/us/stat/122/3765" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5201" ;
.
