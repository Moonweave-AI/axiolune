  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-10> ;
  fro-usc:hasHeading "Covered financial company" ;
  fro-usc:hasId "id83981b7b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/8" ;
  fro-usc:hasNumberText "(8)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-2-2-10-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b7c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b7d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b7c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-10-3> ;
  fro-usc:hasContentText "means a financial company for which a determination has been made under section 5383(b) of this title ; and" ;
  fro-usc:hasId "id83981b7c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/8/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5383/b" ;
.
