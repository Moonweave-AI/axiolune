  fro-usc:hasId "id83a8bcd7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "2015—Subsec. (h). Pub. L. 114–113 added subsec. (h)." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/114/113" ;
.
fro-usc-t12-ch53:id83a8bcd8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcd9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcda-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcdb-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcdc-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-5> ;
  fro-usc:hasHeading "Consumer Advisory Board" ;
  fro-usc:hasId "id83a8bcd8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5494" ;
  fro-usc:hasNumberText "§ 5494." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bcdf-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bcd9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-5-2> ;
  fro-usc:hasContentText "The Director shall establish a Consumer Advisory Board to advise and consult with the Bureau in the exercise of its functions under the Federal consumer financial laws, and to provide information on emerging practices in the consumer financial products or services industry, including regional trends, concerns, and other relevant information." ;
  fro-usc:hasHeading "Establishment required" ;
  fro-usc:hasId "id83a8bcd9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5494/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a8bcda-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-5-3> ;
  fro-usc:hasContentText "In appointing the members of the Consumer Advisory Board, the Director shall seek to assemble experts in consumer protection, financial services, community development, fair lending and civil rights, and consumer financial products or services and representatives of depository institutions that primarily serve underserved communities, and representatives of communities that have been significantly impacted by higher-priced mortgage loans, and seek representation of the interests of covered persons and consumers, without regard to party affiliation. Not fewer than 6 members shall be appointed upon the recommendation of the regional Federal Reserve Bank Presidents, on a rotating basis." ;
  fro-usc:hasHeading "Membership" ;
  fro-usc:hasId "id83a8bcda-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5494/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a8bcdb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-5-4> ;
  fro-usc:hasContentText "The Consumer Advisory Board shall meet from time to time at the call of the Director, but, at a minimum, shall meet at least twice in each year." ;
  fro-usc:hasHeading "Meetings" ;
  fro-usc:hasId "id83a8bcdb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5494/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a8bcdc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcdd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bcde-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-5-5> ;
  fro-usc:hasHeading "Compensation and travel expenses" ;
  fro-usc:hasId "id83a8bcdc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5494/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-3-5-5-2> ;
.
fro-usc-t12-ch53:id83a8bcdd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-5-5-3> ;
  fro-usc:hasContentText "be entitled to receive compensation at a rate fixed by the Director while attending meetings of the Consumer Advisory Board, including travel time; and" ;
  fro-usc:hasId "id83a8bcdd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5494/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a8bcde-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-5-5-4> ;
  fro-usc:hasContentText "be allowed travel expenses, including transportation and subsistence, while away from their homes or regular places of business." ;
  fro-usc:hasId "id83a8bcde-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5494/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a8bcdf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "id83a8bcdf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/stat/124/1974" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1014, July 21, 2010 , 124 Stat. 1974 .)" ;
.
fro-usc-t12-ch53:id83a8bce0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-6> ;
  fro-usc:hasContentText "The Bureau shall coordinate with the Commission, the Commodity Futures Trading Commission, the Federal Trade Commission, and other Federal agencies and State regulators, as appropriate, to promote consistent regulatory treatment of consumer financial and investment products and services." ;
  fro-usc:hasHeading "Coordination" ;
  fro-usc:hasId "id83a8bce0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5495" ;
  fro-usc:hasNumberText "§ 5495." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bce1-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bce1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id83a8bce1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/stat/124/1974" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1015, July 21, 2010 , 124 Stat. 1974 .)" ;
.
fro-usc-t12-ch53:id83a8bce2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bce3-1df7-11e6-87ee-8e4a3ab90f2a ;
