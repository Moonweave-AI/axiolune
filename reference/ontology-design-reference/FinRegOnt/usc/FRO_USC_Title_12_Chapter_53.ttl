  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/2/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-3-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8cbb-1df7-11e6-87ee-8e4a3ab90f2a ;
