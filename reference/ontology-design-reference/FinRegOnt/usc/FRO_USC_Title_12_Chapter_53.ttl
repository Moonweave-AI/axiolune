.
fro-usc-t12-ch53:id83b25a95-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-3-8-5> ;
  fro-usc:hasHeading "Credit for time enrolled in other plans" ;
  fro-usc:hasId "id83b25a95-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/2/G/iv" ;
