  fro-usc:hasHeading "Examination and enforcement" ;
  fro-usc:hasId "id83a6736f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/e/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-8-6-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67370-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67371-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a67370-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-6-2-3> ;
  fro-usc:hasContentText "conduct an examination of the type described in subsection (a) of any financial institution that is subject to the standards prescribed under section 5464(a) of this title for a designated activity; and" ;
  fro-usc:hasId "id83a67370-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/e/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5464/a" ;
.
fro-usc-t12-ch53:id83a67371-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-6-2-4> ;
  fro-usc:hasContentText "enforce the provisions of this subchapter or any rules or orders prescribed under this subchapter against any financial institution that is subject to the standards prescribed under section 5464(a) of this title for a designated activity." ;
  fro-usc:hasId "id83a67371-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/e/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5464/a" ;
.
