.
fro-usc-t12-ch53:id83b25b10-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-2-5> ;
  fro-usc:hasContentText "On the earlier of the date of a submission made to Congress under section 5612(c) of this title , or within 30 days of the date of a determination under subsection (a), the Secretary shall provide written notice of the determination of the Corporation and the Board of Governors to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives, including a description of the basis for the determination." ;
  fro-usc:hasHeading "Report to Congress" ;
  fro-usc:hasId "id83b25b10-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5611/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5612/c" ;
.
fro-usc-t12-ch53:id83b25b11-1df7-11e6-87ee-8e4a3ab90f2a
