  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a8bd03-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5497/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-3-10-2-3-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd04-1df7-11e6-87ee-8e4a3ab90f2a ;
