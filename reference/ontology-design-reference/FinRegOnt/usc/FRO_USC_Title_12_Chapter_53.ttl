.
fro-usc-t12-ch53:id8395ab69-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-4-2> ;
  fro-usc:hasContentText "For purposes of section 1842 of this title , a nonbank financial company supervised by the Board of Governors shall be deemed to be, and shall be treated as, a bank holding company." ;
  fro-usc:hasHeading "Acquisitions of banks; treatment as a bank holding company" ;
  fro-usc:hasId "id8395ab69-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5363/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1842" ;
.
fro-usc-t12-ch53:id8395ab6a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395ab6b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395ab6c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395ab6d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395ab6e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395ab6f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-4-3> ;
  fro-usc:hasHeading "Acquisition of nonbank companies" ;
  fro-usc:hasId "id8395ab6a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5363/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id8395ab6b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-4-3-2> ;
  fro-usc:hasContentText "Notwithstanding section 1843(k)(6)(B) of this title , a bank holding company with total consolidated assets equal to or greater than $50,000,000,000 or a nonbank financial company supervised by the Board of Governors shall not acquire direct or indirect ownership or control of any voting shares of any company (other than an insured depository institution) that is engaged in activities described in section 1843(k) of this title having total consolidated assets of $10,000,000,000 or more, without providing written notice to the Board of Governors in advance of the transaction." ;
  fro-usc:hasHeading "Prior notice for large acquisitions" ;
  fro-usc:hasId "id8395ab6b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5363/b/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k/6/B" ;
.
fro-usc-t12-ch53:id8395ab6c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-4-3-3> ;
  fro-usc:hasContentText "The prior notice requirement in paragraph (1) shall not apply with regard to the acquisition of shares that would qualify for the exemptions in section 1843(c) of this title or section 1843(k)(4)(E) of this title ." ;
  fro-usc:hasHeading "Exemptions" ;
  fro-usc:hasId "id8395ab6c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5363/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/c" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k/4/E" ;
.
fro-usc-t12-ch53:id8395ab6d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-4-3-4> ;
  fro-usc:hasContentText "The notice procedures set forth in section 1843(j)(1) of this title , without regard to section 1843(j)(3) of this title , shall apply to an acquisition of any company (other than an insured depository institution) by a bank holding company with total consolidated assets equal to or greater than $50,000,000,000 or a nonbank financial company supervised by the Board of Governors, as described in paragraph (1), including any such company engaged in activities described in section 1843(k) of this title ." ;
  fro-usc:hasHeading "Notice procedures" ;
  fro-usc:hasId "id8395ab6d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5363/b/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/j/1" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/j/3" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k" ;
.
fro-usc-t12-ch53:id8395ab6e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-4-3-5> ;
  fro-usc:hasContentText "In addition to the standards provided in section 1843(j)(2) of this title , the Board of Governors shall consider the extent to which the proposed acquisition would result in greater or more concentrated risks to global or United States financial stability or the United States economy." ;
  fro-usc:hasHeading "Standards for review" ;
  fro-usc:hasId "id8395ab6e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5363/b/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/j/2" ;
.
fro-usc-t12-ch53:id8395ab6f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-4-3-6> ;
  fro-usc:hasContentText "Solely for purposes of section 18a(c)(8) of title 15 , the transactions subject to the requirements of paragraph (1) shall be treated as if Board of Governors approval is not required." ;
  fro-usc:hasHeading "Hart-Scott-Rodino filing requirement" ;
  fro-usc:hasId "id8395ab6f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5363/b/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s18a/c/8" ;
.
fro-usc-t12-ch53:id8395ab70-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "id8395ab70-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1422" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 163, July 21, 2010 , 124 Stat. 1422 .)" ;
.
fro-usc-t12-ch53:id8395ab71-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id8395ab74-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-5> ;
  fro-usc:hasContentText "A nonbank financial company supervised by the Board of Governors shall be treated as a bank holding company for purposes of the Depository Institutions  1 ) to permit service by a management official of a nonbank financial company supervised by the Board of Governors as a management official of any bank holding company with total consolidated assets equal to or greater than $50,000,000,000, or other nonaffiliated nonbank financial company supervised by the Board of Governors (other than to provide a temporary exemption for interlocks resulting from a merger, acquisition, or consolidation). Management Interlocks Act ( 12 U.S.C. 3201 et seq.), except that the Board of Governors shall not exercise the authority provided in section 7  2 of that Act ( 12 U.S.C. 3207" ;
  fro-usc:hasHeading "Prohibition against management interlocks between certain financial companies" ;
  fro-usc:hasId "id8395ab71-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5364" ;
  fro-usc:hasNumberText "§ 5364." ;
  lkif-mereo:component fro-usc-t12-ch53:id8395ab72-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395ab72-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
