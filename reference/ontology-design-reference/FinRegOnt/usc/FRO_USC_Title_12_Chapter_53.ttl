  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-5-7-2-3-3> ;
  fro-usc:hasContentText "appropriate certifying entities;" ;
  fro-usc:hasId "id83a8bcae-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/d/7/A/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83a8bcaf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
