  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-25-5> ;
  fro-usc:hasContentText "any authorized IRS e-file Providers (as defined for purposes of section 7216 of title 26 ), but only to the extent that the person acts in such capacity." ;
  fro-usc:hasId "id83a6741e-1df7-11e6-87ee-8e4a3ab90f2a" ;
