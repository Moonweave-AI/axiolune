  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-7-2-5> ;
  fro-usc:hasContentText "acting based upon a suit, claim, or cause of action purchased from, assigned by, or otherwise conveyed in whole or in part by a covered financial company or its affiliate in connection with assistance provided under this subchapter." ;
  fro-usc:hasId "id839f4744-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/f/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839f4745-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-7-3> ;
  fro-usc:hasContentText "Paragraph (1) shall apply with respect to actions for gross negligence, including any similar conduct or conduct that demonstrates a greater disregard of a duty of care (than gross negligence) including intentional tortious conduct, as such terms are defined and determined under applicable State law." ;
  fro-usc:hasHeading "Actions covered" ;
  fro-usc:hasId "id839f4745-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/f/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839f4746-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-7-4> ;
  fro-usc:hasContentText "Nothing in this subsection shall impair or affect any right of the Corporation under other applicable law." ;
  fro-usc:hasHeading "Savings clause" ;
  fro-usc:hasId "id839f4746-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/f/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839f4747-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-8> ;
  fro-usc:hasContentText "In any proceeding related to any claim against a director, officer, employee, agent, attorney, accountant, or appraiser of a covered financial company, or any other party employed by or providing services to a covered financial company, recoverable damages determined to result from the improvident or otherwise improper use or investment of any assets of the covered financial company shall include principal losses and appropriate interest." ;
  fro-usc:hasHeading "Damages" ;
  fro-usc:hasId "id839f4747-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id839f4748-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
