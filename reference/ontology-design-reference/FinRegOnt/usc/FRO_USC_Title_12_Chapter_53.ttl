  fro-usc:hasContentText "a statement of the total amounts paid by the agency to contractors since the previous report;" ;
  fro-usc:hasId "id83a4026c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
