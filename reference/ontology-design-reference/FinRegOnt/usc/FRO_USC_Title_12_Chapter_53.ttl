  fro-usc:hasId "id83a8bd84-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Pub. L. 114–94, div. G, title LXXXIX , § 89002, Dec. 4, 2015 , 129 Stat. 1799 , provided that:" ;
