  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-4-3> ;
  fro-usc:hasContentText "the initial term of the lease is at least 90 days; and" ;
  fro-usc:hasId "id83a673e3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83a673e4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-4-4> ;
  fro-usc:hasContentText "in the case of a lease involving real property, at the inception of the initial lease, the transaction is intended to result in ownership of the leased property to be transferred to the lessee, subject to standards prescribed by the Bureau;" ;
  fro-usc:hasId "id83a673e4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/ii/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id83a673e5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-5> ;
  fro-usc:hasContentText "providing real estate settlement services, except such services excluded under subparagraph (C), or performing appraisals of real estate or personal property;" ;
  fro-usc:hasId "id83a673e5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
