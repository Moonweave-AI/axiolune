  fro-usc:hasHeading "Changes Required to Small Bank Holding Company Policy Statement on Assessment of Financial and Managerial Factors" ;
  fro-usc:hasId "id83981b5f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Pub. L. 113–250 , Dec. 18, 2014 , 128 Stat. 2886 , provided that:" ;
  fro-usc:hasNoteTopic "miscellaneous" ;
  fro-usc:hasReferenceText "/us/pl/113/250" ;
  fro-usc:hasReferenceText "/us/stat/128/2886" ;
.
fro-usc-t12-ch53:id83981b60-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83981b63-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-13> ;
  fro-usc:hasContentText "Nothing in this Act shall be construed to limit or curtail the Corporation’s current authority to examine or bring enforcement actions with respect to any insured depository institution or institution-affiliated party." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83981b60-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5372" ;
  fro-usc:hasNumberText "§ 5372." ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b61-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b61-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id83981b61-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1439" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 172(c), July 21, 2010 , 124 Stat. 1439 .)" ;
.
fro-usc-t12-ch53:id83981b63-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-13-4-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83981b63-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This Act, referred to in text, is Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1376 , known as the Dodd-Frank Wall Street Reform and Consumer Protection Act, which enacted this chapter and chapters 108 (§ 8201 et seq.) and 109 (§ 8301 et seq.) of Title 15, Commerce and Trade, and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of this Act to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1376" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b64-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b65-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b66-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b67-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-14> ;
  fro-usc:hasHeading "International policy coordination" ;
  fro-usc:hasId "id83981b64-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5373" ;
  fro-usc:hasNumberText "§ 5373." ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b68-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b65-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-14-2> ;
  fro-usc:hasContentText "The President, or a designee of the President, may coordinate through all available international policy channels, similar policies as those found in United States law relating to limiting the scope, nature, size, scale, concentration, and interconnectedness of financial companies, in order to protect financial stability and the global economy." ;
  fro-usc:hasHeading "By the President" ;
  fro-usc:hasId "id83981b65-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5373/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83981b66-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-14-3> ;
  fro-usc:hasContentText "The Chairperson of the Council, in consultation with the other members of the Council, shall regularly consult with the financial regulatory entities and other appropriate organizations of foreign governments or international organizations on matters relating to systemic risk to the international financial system." ;
  fro-usc:hasHeading "By the Council" ;
  fro-usc:hasId "id83981b66-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5373/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83981b67-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-14-4> ;
  fro-usc:hasContentText "The Board of Governors and the Secretary shall consult with their foreign counterparts and through appropriate multilateral organizations to encourage comprehensive and robust prudential supervision and regulation for all highly leveraged and interconnected financial companies." ;
  fro-usc:hasHeading "By the Board of Governors and the Secretary" ;
  fro-usc:hasId "id83981b67-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5373/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83981b68-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id83981b68-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 175, July 21, 2010 , 124 Stat. 1442 .)" ;
.
fro-usc-t12-ch53:id83981b69-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83981b6c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-15> ;
  fro-usc:hasContentText "No regulation or standard imposed under this subchapter may be construed in a manner that would lessen the stringency of the requirements of any applicable primary financial regulatory agency or any other Federal or State agency that are otherwise applicable. This subchapter, and the rules and regulations or orders prescribed pursuant to this subchapter, do not divest any such agency of any authority derived from any other applicable law." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83981b69-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5374" ;
  fro-usc:hasNumberText "§ 5374." ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b6a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b6a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id83981b6a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 176, July 21, 2010 , 124 Stat. 1442 .)" ;
.
fro-usc-t12-ch53:id83981b6c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-15-4-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83981b6c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This subchapter, referred to in text, was in the original “this title”, meaning title I of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1391 , which is classified principally to this subchapter. For complete classification of title I to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1391" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
