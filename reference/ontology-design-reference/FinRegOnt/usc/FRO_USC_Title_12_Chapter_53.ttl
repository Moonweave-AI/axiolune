.
fro-usc-t12-ch53:id83ab2e5c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-2-3-2> ;
  fro-usc:hasContentText "customary and usual accounting activities, including the provision of accounting, tax, advisory, or other services that are subject to the regulatory authority of a State board of accountancy or a Federal authority; or" ;
  fro-usc:hasId "id83ab2e5c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/1/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ab2e5d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-2-3-3> ;
  fro-usc:hasId "id83ab2e5d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/1/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-8-5-2-3-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e5e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e5f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e5e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-2-3-3-2> ;
  fro-usc:hasContentText "by the person separate and apart from such customary and usual accounting activities; or" ;
  fro-usc:hasId "id83ab2e5e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/1/A/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83ab2e5f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-2-3-3-3> ;
  fro-usc:hasContentText "to consumers who are not receiving such customary and usual accounting activities; or" ;
  fro-usc:hasId "id83ab2e5f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/1/A/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83ab2e60-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-2-4> ;
  fro-usc:hasContentText "any person, other than a person described in subparagraph (A)  2 that performs income tax preparation activities for consumers." ;
  fro-usc:hasId "id83ab2e60-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2e61-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-3> ;
  fro-usc:hasHeading "Description of activities" ;
  fro-usc:hasId "id83ab2e61-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e62-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e63-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e64-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e67-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e62-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-3-2> ;
  fro-usc:hasContentText "Paragraph (1) shall not apply to any person described in paragraph (1)(A) or (1)(B) to the extent that such person is engaged in any activity which is not a customary and usual accounting activity described in paragraph (1)(A) or incidental thereto but which is the offering or provision of any consumer financial product or service, except to the extent that a person described in paragraph (1)(A) is engaged in an activity which is a customary and usual accounting activity described in paragraph (1)(A), or incidental thereto." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e62-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2e63-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-3-3> ;
  fro-usc:hasContentText "For purposes of this subsection, extending or brokering credit is not a customary and usual accounting activity, or incidental thereto." ;
  fro-usc:hasHeading "Not a customary and usual accounting activity" ;
  fro-usc:hasId "id83ab2e63-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2e64-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-3-4> ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83ab2e64-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/2/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-8-5-3-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e65-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e66-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e65-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-3-4-3> ;
  fro-usc:hasContentText "not subject to a finance charge; and" ;
  fro-usc:hasId "id83ab2e65-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/2/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ab2e66-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-3-4-4> ;
  fro-usc:hasContentText "not payable by written agreement in more than 4 installments." ;
  fro-usc:hasId "id83ab2e66-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/2/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83ab2e67-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-5-3-5> ;
  fro-usc:hasContentText "Paragraph (1) does not apply to any person described in paragraph (1)(A) or (1)(B) that is otherwise subject to any enumerated consumer law or any law for which authorities are transferred under subtitle F or H." ;
  fro-usc:hasHeading "Other limitations" ;
  fro-usc:hasId "id83ab2e67-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/d/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83ab2e68-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e69-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e6a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e6d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-6> ;
  fro-usc:hasHeading "Exclusion for practice of law" ;
  fro-usc:hasId "id83ab2e68-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83ab2e69-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-6-2> ;
  fro-usc:hasContentText "Except as provided under paragraph (2), the Bureau may not exercise any supervisory or enforcement authority with respect to an activity engaged in by an attorney as part of the practice of law under the laws of a State in which the attorney is licensed to practice law." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e69-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ab2e6a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-6-3> ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83ab2e6a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/e/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-8-6-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e6b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e6c-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e6b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-6-3-3> ;
  fro-usc:hasContentText "that is not offered or provided as part of, or incidental to, the practice of law, occurring exclusively within the scope of the attorney-client relationship; or" ;
  fro-usc:hasId "id83ab2e6b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/e/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2e6c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-6-3-4> ;
  fro-usc:hasContentText "that is otherwise offered or provided by the attorney in question with respect to any consumer who is not receiving legal advice or services from the attorney in connection with such financial product or service." ;
  fro-usc:hasId "id83ab2e6c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/e/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2e6d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-6-4> ;
  fro-usc:hasContentText "Paragraph (1) shall not be construed so as to limit the authority of the Bureau with respect to any attorney, to the extent that such attorney is otherwise subject to any of the enumerated consumer laws or the authorities transferred under subtitle F or H." ;
  fro-usc:hasHeading "Existing authority" ;
  fro-usc:hasId "id83ab2e6d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83ab2e6e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e6f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e70-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e71-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-7> ;
  fro-usc:hasHeading "Exclusion for persons regulated by a State insurance regulator" ;
  fro-usc:hasId "id83ab2e6e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83ab2e6f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-7-2> ;
  fro-usc:hasContentText "No provision of this title  shall be construed as altering, amending, or affecting the authority of any State insurance regulator to adopt rules, initiate enforcement proceedings, or take any other action with respect to a person regulated by a State insurance regulator. Except as provided in paragraph (2), the Bureau shall have no authority to exercise any power to enforce this title  with respect to a person regulated by a State insurance regulator." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e6f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/f/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ab2e70-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-7-3> ;
  fro-usc:hasContentText "Paragraph (1) does not apply to any person described in such paragraph to the extent that such person is engaged in the offering or provision of any consumer financial product or service or is otherwise subject to any enumerated consumer law or any law for which authorities are transferred under subtitle F or H." ;
  fro-usc:hasHeading "Description of activities" ;
  fro-usc:hasId "id83ab2e70-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/f/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ab2e71-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-7-4> ;
  fro-usc:hasContentText "Notwithstanding paragraph (2), the Bureau shall not exercise any authorities that are granted a State insurance authority under section 6805(a)(6) of title 15 with respect to a person regulated by a State insurance authority." ;
  fro-usc:hasHeading "State insurance authority under Gramm-Leach-Bliley" ;
  fro-usc:hasId "id83ab2e71-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/f/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s6805/a/6" ;
.
fro-usc-t12-ch53:id83ab2e72-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e73-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e74-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e78-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e7f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8> ;
  fro-usc:hasHeading "Exclusion for employee benefit and compensation plans and certain other arrangements under title 26" ;
  fro-usc:hasId "id83ab2e72-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id83ab2e73-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-2> ;
  fro-usc:hasContentText "No provision of this title  shall be construed as altering, amending, or affecting the authority of the Secretary of the Treasury, the Secretary of Labor, or the Commissioner of Internal Revenue to adopt regulations, initiate enforcement proceedings, or take any actions with respect to any specified plan or arrangement." ;
  fro-usc:hasHeading "Preservation of authority of other agencies" ;
  fro-usc:hasId "id83ab2e73-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ab2e74-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-3> ;
  fro-usc:hasHeading "Activities not constituting the offering or provision of any consumer financial product or service" ;
  fro-usc:hasId "id83ab2e74-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-8-8-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e75-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e76-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e77-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e75-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-3-3> ;
  fro-usc:hasContentText "a specified plan or arrangement;" ;
  fro-usc:hasId "id83ab2e75-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2e76-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-3-4> ;
  fro-usc:hasContentText "engaged in the activity of establishing or maintaining, for the benefit of employees of such person (or for members of an employee organization), any specified plan or arrangement; or" ;
  fro-usc:hasId "id83ab2e76-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2e77-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-3-5> ;
  fro-usc:hasContentText "engaged in the activity of establishing or maintaining a qualified tuition program under section 529(b)(1) of title 26 offered by a State or other prepaid tuition program offered by a State." ;
  fro-usc:hasId "id83ab2e77-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/2/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t26/s529/b/1" ;
.
fro-usc-t12-ch53:id83ab2e78-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-4> ;
  fro-usc:hasHeading "Limitation on Bureau authority" ;
  fro-usc:hasId "id83ab2e78-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e79-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e7a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e7e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e79-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-4-2> ;
  fro-usc:hasContentText "Except as provided under subparagraphs (B) and (C), the Bureau may not exercise any rulemaking or enforcement authority with respect to products or services that relate to any specified plan or arrangement." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e79-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2e7a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-4-3> ;
  fro-usc:hasHeading "Bureau action pursuant to agency request" ;
  fro-usc:hasId "id83ab2e7a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e7b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e7c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2e7d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e7b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-4-3-2> ;
  fro-usc:hasHeading "Agency request" ;
  fro-usc:hasId "id83ab2e7b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/3/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ab2e7c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-4-3-3> ;
  fro-usc:hasHeading "Agency response" ;
  fro-usc:hasId "id83ab2e7c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/3/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83ab2e7d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-4-3-4> ;
  fro-usc:hasHeading "Scope of Bureau action" ;
  fro-usc:hasId "id83ab2e7d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/3/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83ab2e7e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-4-4> ;
  fro-usc:hasContentText "To the extent that a person engaged in providing products or services relating to any specified plan or arrangement is subject to any enumerated consumer law or any law for which authorities are transferred under subtitle F or H, subparagraph (A) shall not apply with respect to that law." ;
  fro-usc:hasHeading "Description of products or services" ;
  fro-usc:hasId "id83ab2e7e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ab2e7f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-8-5> ;
  fro-usc:hasContentText "For purposes of this subsection, the term “specified plan or arrangement” means any plan, account, or arrangement described in section 220, 223, 401(a), 403(a), 403(b), 408, 408A, 529, 529A, or 530 of title 26, or any employee benefit or compensation plan or arrangement, including a plan that is subject to title I of the Employee Retirement Income Security Act of 1974 [ 29 U.S.C. 1001 et seq.], or any prepaid tuition program offered by a State." ;
  fro-usc:hasHeading "Specified plan or arrangement" ;
  fro-usc:hasId "id83ab2e7f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/g/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t29/s1001" ;
.
fro-usc-t12-ch53:id83ab2e80-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e81-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e82-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-9> ;
  fro-usc:hasHeading "Persons regulated by a State securities commission" ;
  fro-usc:hasId "id83ab2e80-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/h" ;
  fro-usc:hasNumberText "(h)" ;
.
fro-usc-t12-ch53:id83ab2e81-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-9-2> ;
  fro-usc:hasContentText "No provision of this title  shall be construed as altering, amending, or affecting the authority of any securities commission (or any agency or office performing like functions) of any State to adopt rules, initiate enforcement proceedings, or take any other action with respect to a person regulated by any securities commission (or any agency or office performing like functions) of any State. Except as permitted in paragraph (2) and subsection (f), the Bureau shall have no authority to exercise any power to enforce this title  with respect to a person regulated by any securities commission (or any agency or office performing like functions) of any State, but only to the extent that the person acts in such regulated capacity." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e81-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/h/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ab2e82-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-9-3> ;
  fro-usc:hasContentText "Paragraph (1) shall not apply to any person to the extent such person is engaged in the offering or provision of any consumer financial product or service, or is otherwise subject to any enumerated consumer law or any law for which authorities are transferred under subtitle F or H." ;
  fro-usc:hasHeading "Description of activities" ;
  fro-usc:hasId "id83ab2e82-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/h/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ab2e83-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e84-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e85-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-10> ;
  fro-usc:hasHeading "Exclusion for persons regulated by the Commission" ;
  fro-usc:hasId "id83ab2e83-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ab2e84-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-10-2> ;
  fro-usc:hasContentText "No provision of this title  may be construed as altering, amending, or affecting the authority of the Commission to adopt rules, initiate enforcement proceedings, or take any other action with respect to a person regulated by the Commission. The Bureau shall have no authority to exercise any power to enforce this title  with respect to a person regulated by the Commission." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e84-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/i/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ab2e85-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-10-3> ;
  fro-usc:hasContentText "Notwithstanding paragraph (1), the Commission shall consult and coordinate, where feasible, with the Bureau with respect to any rule (including any advance notice of proposed rulemaking) regarding an investment product or service that is the same type of product as, or that competes directly with, a consumer financial product or service that is subject to the jurisdiction of the Bureau under this title  or under any other law. In carrying out this paragraph, the agencies shall negotiate an agreement to establish procedures for such coordination, including procedures for providing advance notice to the Bureau when the Commission is initiating a rulemaking." ;
  fro-usc:hasHeading "Consultation and coordination" ;
  fro-usc:hasId "id83ab2e85-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/i/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ab2e86-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e87-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e88-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-11> ;
  fro-usc:hasHeading "Exclusion for persons regulated by the Commodity Futures Trading Commission" ;
  fro-usc:hasId "id83ab2e86-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/j" ;
  fro-usc:hasNumberText "(j)" ;
.
fro-usc-t12-ch53:id83ab2e87-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-11-2> ;
  fro-usc:hasContentText "No provision of this title  shall be construed as altering, amending, or affecting the authority of the Commodity Futures Trading Commission to adopt rules, initiate enforcement proceedings, or take any other action with respect to a person regulated by the Commodity Futures Trading Commission. The Bureau shall have no authority to exercise any power to enforce this title  with respect to a person regulated by the Commodity Futures Trading Commission." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e87-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/j/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ab2e88-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-11-3> ;
  fro-usc:hasContentText "Notwithstanding paragraph (1), the Commodity Futures Trading Commission shall consult and coordinate with the Bureau with respect to any rule (including any advance notice of proposed rulemaking) regarding a product or service that is the same type of product as, or that competes directly with, a consumer financial product or service that is subject to the jurisdiction of the Bureau under this title  or under any other law." ;
  fro-usc:hasHeading "Consultation and coordination" ;
  fro-usc:hasId "id83ab2e88-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/j/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ab2e89-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e8a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e8b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-12> ;
  fro-usc:hasHeading "Exclusion for persons regulated by the Farm Credit Administration" ;
  fro-usc:hasId "id83ab2e89-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/k" ;
  fro-usc:hasNumberText "(k)" ;
.
fro-usc-t12-ch53:id83ab2e8a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-12-2> ;
  fro-usc:hasContentText "No provision of this title  shall be construed as altering, amending, or affecting the authority of the Farm Credit Administration to adopt rules, initiate enforcement proceedings, or take any other action with respect to a person regulated by the Farm Credit Administration. The Bureau shall have no authority to exercise any power to enforce this title  with respect to a person regulated by the Farm Credit Administration." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e8a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/k/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ab2e8b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-12-3> ;
  fro-usc:hasContentText "For purposes of this subsection, the term “person regulated by the Farm Credit Administration” means any Farm Credit System institution that is chartered and subject to the provisions of the Farm Credit Act of 1971 ( 12 U.S.C. 2001 et seq.)." ;
  fro-usc:hasHeading "Definition" ;
  fro-usc:hasId "id83ab2e8b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/k/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s2001" ;
.
fro-usc-t12-ch53:id83ab2e8c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e8d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e8e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-13> ;
  fro-usc:hasHeading "Exclusion for activities relating to charitable contributions" ;
  fro-usc:hasId "id83ab2e8c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/l" ;
  fro-usc:hasNumberText "(l)" ;
.
fro-usc-t12-ch53:id83ab2e8d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-13-2> ;
  fro-usc:hasContentText "The Director and the Bureau may not exercise any rulemaking, supervisory, enforcement, or other authority, including authority to order penalties, over any activities related to the solicitation or making of voluntary contributions to a tax-exempt organization as recognized by the Internal Revenue Service, by any agent, volunteer, or representative of such organizations to the extent the organization, agent, volunteer, or representative thereof is soliciting or providing advice, information, education, or instruction to any donor or potential donor relating to a contribution to the organization." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ab2e8d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/l/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ab2e8e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-13-3> ;
  fro-usc:hasContentText "The exclusion in paragraph (1) does not apply to other activities not described in paragraph (1) that are the offering or provision of any consumer financial product or service, or are otherwise subject to any enumerated consumer law or any law for which authorities are transferred under subtitle F or H." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id83ab2e8e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/l/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ab2e8f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-14> ;
  fro-usc:hasContentText "The Bureau may not define as a financial product or service, by regulation or otherwise, engaging in the business of insurance." ;
  fro-usc:hasHeading "Insurance" ;
  fro-usc:hasId "id83ab2e8f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/m" ;
  fro-usc:hasNumberText "(m)" ;
.
fro-usc-t12-ch53:id83ab2e90-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e91-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e92-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-15> ;
  fro-usc:hasHeading "Limited authority of the Bureau" ;
  fro-usc:hasId "id83ab2e90-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/n" ;
  fro-usc:hasNumberText "(n)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-8-15-2> ;
.
fro-usc-t12-ch53:id83ab2e91-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-15-3> ;
  fro-usc:hasContentText "may be a service provider; and" ;
  fro-usc:hasId "id83ab2e91-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/n/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ab2e92-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-15-4> ;
  fro-usc:hasContentText "may be subject to requests from, or requirements imposed by, the Bureau regarding information in order to carry out the responsibilities and functions of the Bureau and in accordance with section 5512, 5562, or 5563 of this title." ;
  fro-usc:hasId "id83ab2e92-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/n/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ab2e93-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-16> ;
  fro-usc:hasContentText "No provision of this title  shall be construed as conferring authority on the Bureau to establish a usury limit applicable to an extension of credit offered or made by a covered person to a consumer, unless explicitly authorized by law." ;
  fro-usc:hasHeading "No authority to impose usury limit" ;
  fro-usc:hasId "id83ab2e93-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/o" ;
  fro-usc:hasNumberText "(o)" ;
.
fro-usc-t12-ch53:id83ab2e94-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-17> ;
  fro-usc:hasContentText "No provision of this title, including section 5514(c)(1) of this title , shall affect the authorities of the Attorney General under otherwise applicable provisions of law." ;
  fro-usc:hasHeading "Attorney General" ;
  fro-usc:hasId "id83ab2e94-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/p" ;
  fro-usc:hasNumberText "(p)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5514/c/1" ;
.
fro-usc-t12-ch53:id83ab2e95-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-18> ;
  fro-usc:hasContentText "No provision of this title  shall affect the authorities of the Secretary, including with respect to prescribing rules, initiating enforcement proceedings, or taking other actions with respect to a person that performs income tax preparation activities for consumers." ;
  fro-usc:hasHeading "Secretary of the Treasury" ;
  fro-usc:hasId "id83ab2e95-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/q" ;
  fro-usc:hasNumberText "(q)" ;
.
fro-usc-t12-ch53:id83ab2e96-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 19 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-19> ;
  fro-usc:hasContentText "Nothing in this title  shall affect the authority of the Corporation under the Federal Deposit Insurance Act [ 12 U.S.C. 1811 et seq.] or the National Credit Union Administration Board under the Federal Credit Union Act [ 12 U.S.C. 1751 et seq.] as to matters related to deposit insurance and share insurance, respectively." ;
  fro-usc:hasHeading "Deposit insurance and share insurance" ;
  fro-usc:hasId "id83ab2e96-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/r" ;
  fro-usc:hasNumberText "(r)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1751" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1811" ;
.
fro-usc-t12-ch53:id83ab2e97-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 20 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-20> ;
  fro-usc:hasContentText "No provision of this title  shall be construed as affecting any authority arising under the Fair Housing Act [ 42 U.S.C. 3601 et seq.]." ;
  fro-usc:hasHeading "Fair Housing Act" ;
  fro-usc:hasId "id83ab2e97-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5517/s" ;
  fro-usc:hasNumberText "(s)" ;
  fro-usc:hasReferenceText "/us/usc/t42/s3601" ;
.
fro-usc-t12-ch53:id83ab2e98-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 21 ;
  fro-usc:hasId "id83ab2e98-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/pl/113/295/dB/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1995" ;
  fro-usc:hasReferenceText "/us/stat/128/4062" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , 128 Stat. 4062 .) , § 1027, July 21, 2010 , 124 Stat. 1995 ; Pub. L. 113–295, div. B, title I , § 102(e)(7), Dec. 19, 2014" ;
.
fro-usc-t12-ch53:id83ab2e9a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-8-22-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83ab2e9a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Subtitle F, referred to in text, is subtitle F (§§ 1061–1067) of title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 2035 , which is classified generally to part F (§ 5581 et seq.) of this subchapter. For complete classification of subtitle F to the Code, see Tables." ;
  fro-usc:hasNoteText "Subtitle H, referred to text, is subtitle H (§§ 1081–1100H) of title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 2080 . For complete classification of subtitle H to the Code, see Tables." ;
  fro-usc:hasNoteText "The Employee Retirement Income Security Act of 1974, referred to in subsec. (g)(4), is Pub. L. 93–406 , Sept. 2, 1974 , 88 Stat. 829 . Title I of the Act is classified generally to subchapter I (§ 1001 et seq.) of chapter 18 of Title 29, Labor. For complete classification of this Act to the Code, see Short Title note set out under section 1001 of Title 29 and Tables." ;
  fro-usc:hasNoteText "The Fair Housing Act, referred to in subsec. (s), is title VIII of Pub. L. 90–284 , Apr. 11, 1968 , 82 Stat. 81 , which is classified principally to subchapter I (§ 3601 et seq.) of chapter 45 of Title 42, The Public Health and Welfare. For complete classification of this Act to the Code, see Short Title note set out under section 3601 of Title 42 and Tables." ;
  fro-usc:hasNoteText "The Farm Credit Act of 1971, referred to in subsec. (k)(2), is Pub. L. 92–181 , Dec. 10, 1971 , 85 Stat. 583 , which is classified principally to chapter 23 (§ 2001 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 2001 of this title and Tables." ;
  fro-usc:hasNoteText "The Federal Credit Union Act, referred to in subsec. (r), is act June 26, 1934, ch. 750 , 48 Stat. 1216 , which is classified principally to chapter 14 (§ 1751 et seq.) of this title. For complete classification of this Act to the Code, see section 1751 of this title and Tables." ;
  fro-usc:hasNoteText "The Federal Deposit Insurance Act, referred to in subsec. (r), is act Sept. 21, 1950, ch. 967 , § 2, 64 Stat. 873 , which is classified generally to chapter 16 (§ 1811 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 1811 of this title and Tables." ;
  fro-usc:hasNoteText "The Small Business Act, referred to in subsec. (a)(2)(D)(iv), is Pub. L. 85–536 , § 2(1 et seq.), July 18, 1958 , 72 Stat. 384 , which is classified generally to chapter 14A (§ 631 et seq.) of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see Short Title note set out under section 631 of Title 15 and Tables." ;
  fro-usc:hasNoteText "This title, where footnoted in text, is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1934-06-26/ch750" ;
  fro-usc:hasReferenceText "/us/act/1950-09-21/ch967" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
