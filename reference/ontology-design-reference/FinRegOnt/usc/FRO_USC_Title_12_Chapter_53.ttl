  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-25-3> ;
  fro-usc:hasContentText "any tax return preparer (as defined in section 7701(a)(36) of title 26 ), regardless of whether compensated, but only to the extent that the person acts in such capacity;" ;
  fro-usc:hasId "id83a6741c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/23/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t26/s7701/a/36" ;
.
