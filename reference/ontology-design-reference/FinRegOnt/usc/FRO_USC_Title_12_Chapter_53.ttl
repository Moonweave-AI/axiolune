fro-usc-t12-ch53:id83afe9ee-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-2-2-3> ;
  fro-usc:hasContentText "arises under any provision of law relating to any consumer financial protection function of the Board of Governors transferred to the Bureau by this title;  1 and" ;
  fro-usc:hasId "id83afe9ee-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/a/1/A" ;
