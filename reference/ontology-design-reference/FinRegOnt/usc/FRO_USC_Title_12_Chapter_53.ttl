fro-usc-t12-ch53:id839cd6bb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-3> ;
  fro-usc:hasContentText "means a contract for the purchase, sale, or loan of a security, a certificate of deposit, a mortgage loan, any interest in a mortgage loan, a group or index of securities, certificates of deposit, or mortgage loans or interests therein (including any interest therein or based on the value thereof), or any option on any of the foregoing, including any option to purchase or sell any such security, certificate of deposit, mortgage loan, interest, group or index, or option, and including any repurchase or reverse repurchase transaction on any such security, certificate of deposit, mortgage loan, interest, group or index, or option (whether or not such repurchase or reverse repurchase transaction is a “repurchase agreement”, as defined in clause (v));" ;
  fro-usc:hasId "id839cd6bb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd6bc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-4> ;
  fro-usc:hasContentText "does not include any purchase, sale, or repurchase obligation under a participation in a commercial mortgage loan unless the Corporation determines by regulation, resolution, or order to include any such agreement within the meaning of such term;" ;
  fro-usc:hasId "id839cd6bc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd6bd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-5> ;
  fro-usc:hasContentText "means any option entered into on a national securities exchange relating to foreign currencies;" ;
  fro-usc:hasId "id839cd6bd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839cd6be-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-6> ;
  fro-usc:hasContentText "means the guarantee (including by novation) by or to any securities clearing agency of any settlement of cash, securities, certificates of deposit, mortgage loans or interests therein, group or index of securities, certificates of deposit or mortgage loans or interests therein (including any interest therein or based on the value thereof) or an option on any of the foregoing, including any option to purchase or sell any such security, certificate of deposit, mortgage loan, interest, group or index, or option (whether or not such settlement is in connection with any agreement or transaction referred to in subclauses (I) through (XII) (other than subclause (II)));" ;
  fro-usc:hasId "id839cd6be-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/IV" ;
  fro-usc:hasNumberText "(IV)" ;
.
fro-usc-t12-ch53:id839cd6bf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-7> ;
  fro-usc:hasContentText "means any margin loan;" ;
  fro-usc:hasId "id839cd6bf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/V" ;
  fro-usc:hasNumberText "(V)" ;
.
fro-usc-t12-ch53:id839cd6c0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-8> ;
  fro-usc:hasContentText "means any extension of credit for the clearance or settlement of securities transactions;" ;
  fro-usc:hasId "id839cd6c0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/VI" ;
  fro-usc:hasNumberText "(VI)" ;
.
fro-usc-t12-ch53:id839cd6c1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-9> ;
  fro-usc:hasContentText "means any loan transaction coupled with a securities collar transaction, any prepaid securities forward transaction, or any total return swap transaction coupled with a securities sale transaction;" ;
  fro-usc:hasId "id839cd6c1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/VII" ;
  fro-usc:hasNumberText "(VII)" ;
.
fro-usc-t12-ch53:id839cd6c2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-10> ;
  fro-usc:hasContentText "means any other agreement or transaction that is similar to any agreement or transaction referred to in this clause;" ;
  fro-usc:hasId "id839cd6c2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/VIII" ;
  fro-usc:hasNumberText "(VIII)" ;
.
fro-usc-t12-ch53:id839cd6c3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-11> ;
  fro-usc:hasContentText "means any combination of the agreements or transactions referred to in this clause;" ;
  fro-usc:hasId "id839cd6c3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/IX" ;
  fro-usc:hasNumberText "(IX)" ;
.
fro-usc-t12-ch53:id839cd6c4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-12> ;
  fro-usc:hasContentText "means any option to enter into any agreement or transaction referred to in this clause;" ;
  fro-usc:hasId "id839cd6c4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/X" ;
  fro-usc:hasNumberText "(X)" ;
.
fro-usc-t12-ch53:id839cd6c5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-13> ;
  fro-usc:hasContentText "means a master agreement that provides for an agreement or transaction referred to in any of subclauses (I) through (X), other than subclause (II), together with all supplements to any such master agreement, without regard to whether the master agreement provides for an agreement or transaction that is not a securities contract under this clause, except that the master agreement shall be considered to be a securities contract under this clause only with respect to each agreement or transaction under the master agreement that is referred to in any of subclauses (I) through (X), other than subclause (II); and" ;
  fro-usc:hasId "id839cd6c5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/XI" ;
  fro-usc:hasNumberText "(XI)" ;
.
fro-usc-t12-ch53:id839cd6c6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-4-14> ;
  fro-usc:hasContentText "means any security agreement or arrangement or other credit enhancement related to any agreement or transaction referred to in this clause, including any guarantee or reimbursement obligation in connection with any agreement or transaction referred to in this clause." ;
  fro-usc:hasId "id839cd6c6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/ii/XII" ;
  fro-usc:hasNumberText "(XII)" ;
.
fro-usc-t12-ch53:id839cd6c7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-5-5> ;
  fro-usc:hasHeading "Commodity contract" ;
  fro-usc:hasId "id839cd6c7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/D/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-9-5-5-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6c8-1df7-11e6-87ee-8e4a3ab90f2a ;
