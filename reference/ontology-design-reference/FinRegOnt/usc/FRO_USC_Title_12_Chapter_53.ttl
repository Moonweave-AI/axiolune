  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-17> ;
  fro-usc:hasHeading "Securities terms" ;
  fro-usc:hasId "id83936033-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/15" ;
  fro-usc:hasNumberText "(15)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-3-17-2> ;
