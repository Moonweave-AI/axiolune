.
fro-usc-t12-ch53:id83a8bcc9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-8-4-5-2> ;
  fro-usc:hasContentText "disseminating information regarding the legitimacy of certifications of financial advisers who advise seniors;" ;
  fro-usc:hasId "id83a8bcc9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g/3/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a8bcca-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-8-4-5-3> ;
  fro-usc:hasContentText "methods in which a senior can identify the financial advisor most appropriate for the senior’s needs; and" ;
  fro-usc:hasId "id83a8bcca-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g/3/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a8bccb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-4-8-4-5-4> ;
  fro-usc:hasContentText "methods in which a senior can verify a financial advisor’s credentials;" ;
  fro-usc:hasId "id83a8bccb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/g/3/C/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
