  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c73-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c74-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c75-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c76-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id839a8c79-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-7> ;
  fro-usc:hasHeading "Mandatory terms and conditions for all orderly liquidation actions" ;
  fro-usc:hasId "id839a8c70-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5386" ;
  fro-usc:hasNumberText "§ 5386." ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-7-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c77-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c71-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-7-3> ;
  fro-usc:hasContentText "determine that such action is necessary for purposes of the financial stability of the United States, and not for the purpose of preserving the covered financial company;" ;
  fro-usc:hasId "id839a8c71-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5386/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839a8c72-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-7-4> ;
  fro-usc:hasContentText "ensure that the shareholders of a covered financial company do not receive payment until after all other claims and the Fund are fully paid;" ;
  fro-usc:hasId "id839a8c72-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5386/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839a8c73-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-7-5> ;
  fro-usc:hasContentText "ensure that unsecured creditors bear losses in accordance with the priority of claim provisions in section 5390 of this title ;" ;
  fro-usc:hasId "id839a8c73-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5386/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390" ;
.
fro-usc-t12-ch53:id839a8c74-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-7-6> ;
  fro-usc:hasContentText "ensure that management responsible for the failed condition of the covered financial company is removed (if such management has not already been removed at the time at which the Corporation is appointed receiver);" ;
  fro-usc:hasId "id839a8c74-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5386/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id839a8c75-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-7-7> ;
  fro-usc:hasContentText "ensure that the members of the board of directors (or body performing similar functions) responsible for the failed condition of the covered financial company are removed, if such members have not already been removed at the time the Corporation is appointed as receiver; and" ;
  fro-usc:hasId "id839a8c75-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5386/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id839a8c76-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-7-8> ;
  fro-usc:hasContentText "not take an equity interest in or become a shareholder of any covered financial company or any covered subsidiary." ;
  fro-usc:hasId "id839a8c76-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5386/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id839a8c77-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-usc:hasId "id839a8c77-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/stat/124/1459" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , § 206, July 21, 2010 , 124 Stat. 1459 .)" ;
.
fro-usc-t12-ch53:id839a8c79-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-7-10-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id839a8c79-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This subchapter, referred to in text, was in the original “this title”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to this subchapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
.
fro-usc-t12-ch53:id839a8c7a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-8> ;
  fro-usc:hasContentText "The members of the board of directors (or body performing similar functions) of a covered financial company shall not be liable to the shareholders or creditors thereof for acquiescing in or consenting in good faith to the appointment of the Corporation as receiver for the covered financial company under section 5383 of this title ." ;
  fro-usc:hasHeading "Directors not liable for acquiescing in appointment of receiver" ;
  fro-usc:hasId "id839a8c7a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5387" ;
  fro-usc:hasNumberText "§ 5387." ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c7b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c7b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "id839a8c7b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/stat/124/1459" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , § 207, July 21, 2010 , 124 Stat. 1459 .)" ;
.
fro-usc-t12-ch53:id839a8c7c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c7d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c7e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839a8c7f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id839a8c82-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-9> ;
  fro-usc:hasHeading "Dismissal and exclusion of other actions" ;
  fro-usc:hasId "id839a8c7c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5388" ;
  fro-usc:hasNumberText "§ 5388." ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c80-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c7d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-9-2> ;
  fro-usc:hasContentText "Effective as of the date of the appointment of the Corporation as receiver for the covered financial company under section 5382 of this title or the appointment of SIPC as trustee for a covered broker or dealer under section 5385 of this title , as applicable, any case or proceeding commenced with respect to the covered financial company under the Bankruptcy Code or the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.) shall be dismissed, upon notice to the bankruptcy court (with respect to a case commenced under the Bankruptcy Code), and upon notice to SIPC (with respect to a covered broker or dealer) and no such case or proceeding may be commenced with respect to a covered financial company at any time while the orderly liquidation is pending." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8c7d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5388/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5382" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5385" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c7e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-9-3> ;
  fro-usc:hasContentText "Effective as of the date of appointment of the Corporation as receiver, the assets of a covered financial company shall, to the extent they have vested in any entity other than the covered financial company as a result of any case or proceeding commenced with respect to the covered financial company under the Bankruptcy Code, the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.), or any similar provision of State liquidation or insolvency law applicable to the covered financial company, revest in the covered financial company." ;
  fro-usc:hasHeading "Revesting of assets" ;
  fro-usc:hasId "id839a8c7e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5388/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c7f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-9-4> ;
  fro-usc:hasContentText "Notwithstanding subsections (a) and (b), any order entered or other relief granted by a bankruptcy court prior to the date of appointment of the Corporation as receiver shall continue with the same validity as if an orderly liquidation had not been commenced." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id839a8c7f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5388/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id839a8c80-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id839a8c80-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/stat/124/1459" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , § 208, July 21, 2010 , 124 Stat. 1459 .)" ;
.
fro-usc-t12-ch53:id839a8c82-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-9-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id839a8c82-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Securities Investor Protection Act of 1970, referred to in subsecs. (a) and (b), is Pub. L. 91–598 , Dec. 30, 1970 , 84 Stat. 1636 , which is classified generally to chapter 2B–1 (§ 78aaa et seq.) of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 78aaa of Title 15 and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/91/598" ;
  fro-usc:hasReferenceText "/us/stat/84/1636" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839a8c83-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id839a8c86-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-10> ;
  fro-usc:hasContentText "The Corporation shall, in consultation with the Council, prescribe such rules or regulations as the Corporation considers necessary or appropriate to implement this subchapter, including rules and regulations with respect to the rights, interests, and priorities of creditors, counterparties, security entitlement holders, or other persons with respect to any covered financial company or any assets or other property of or held by such covered financial company, and address the potential for conflicts of interest between or among individual receiverships established under this subchapter or under the Federal Deposit Insurance Act [ 12 U.S.C. 1811 et seq.]. To the extent possible, the Corporation shall seek to harmonize applicable rules and regulations promulgated under this section with the insolvency laws that would otherwise apply to a covered financial company." ;
  fro-usc:hasHeading "Rulemaking; non-conflicting law" ;
  fro-usc:hasId "id839a8c83-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5389" ;
  fro-usc:hasNumberText "§ 5389." ;
