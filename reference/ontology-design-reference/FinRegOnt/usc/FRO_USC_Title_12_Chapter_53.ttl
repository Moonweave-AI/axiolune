  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-5-10-2-5-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a7f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a80-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a81-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a82-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83b25a83-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b25a7f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-2-5-3> ;
  fro-usc:hasContentText "the term “existing retirement plan” means, with respect to an employee transferred pursuant to this part, the retirement plan (including the Financial Institutions Retirement Fund) and any associated thrift savings plan, of the agency from which the employee was transferred under this part, in which the employee was enrolled on the day before the date on which the employee was transferred;" ;
  fro-usc:hasId "id83b25a7f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/1/D/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83b25a80-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-2-5-4> ;
  fro-usc:hasContentText "the term “Federal Employee Retirement Program” means either the Civil Service Retirement System established under chapter 83 of title 5 or the Federal Employees Retirement System established under chapter 84 of title 5, depending upon the service history of the individual;" ;
  fro-usc:hasId "id83b25a80-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/1/D/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83b25a81-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-2-5-5> ;
  fro-usc:hasContentText "the term “Federal Reserve System transferred employee” means a transferred employee who is an employee of the Board of Governors or a Federal reserve bank on the day before the designated transfer date, and who is transferred to the Bureau on the designated transfer date pursuant to this part;" ;
  fro-usc:hasId "id83b25a81-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/1/D/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83b25a82-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-2-5-6> ;
  fro-usc:hasContentText "the term “Federal Reserve System Retirement Plan” means the Retirement Plan for Employees of the Federal Reserve System; and" ;
  fro-usc:hasId "id83b25a82-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/1/D/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id83b25a83-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-2-5-7> ;
  fro-usc:hasContentText "the term “Federal Reserve System Thrift Plan” means the Thrift Plan for Employees of the Federal Reserve System." ;
  fro-usc:hasId "id83b25a83-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/1/D/v" ;
  fro-usc:hasNumberText "(v)" ;
.
