.
fro-usc-t12-ch53:id83b25a96-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-10-4> ;
  fro-usc:hasContentText "The Office of Personnel Management shall issue such rules as are necessary to carry out this subsection." ;
  fro-usc:hasHeading "OPM rules" ;
  fro-usc:hasId "id83b25a96-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83b25a97-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-11> ;
  fro-usc:hasContentText "Not later than 2 years after the designated transfer date, the Bureau shall implement a uniform pay and classification system for all employees transferred under this title." ;
  fro-usc:hasHeading "Implementation of uniform pay and classification system" ;
  fro-usc:hasId "id83b25a97-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/j" ;
  fro-usc:hasNumberText "(j)" ;
.
fro-usc-t12-ch53:id83b25a98-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a99-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a9a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-12> ;
  fro-usc:hasHeading "Equitable treatment" ;
  fro-usc:hasId "id83b25a98-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/k" ;
  fro-usc:hasNumberText "(k)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-5-12-2> ;
.
fro-usc-t12-ch53:id83b25a99-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-12-3> ;
  fro-usc:hasContentText "shall take no action that would unfairly disadvantage transferred employees relative to each other based on their prior employment by the Board of Governors, the Federal Deposit Insurance Corporation, the Department of Housing and Urban Development, the National Credit Union Administration, the Office of the Comptroller of the Currency, the Office of Thrift Supervision, a Federal reserve bank, a Federal home loan bank, or a joint office of the Federal home loan banks; and" ;
  fro-usc:hasId "id83b25a99-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/k/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25a9a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-12-4> ;
  fro-usc:hasContentText "may take such action as is appropriate in individual cases so that employees transferred under this section receive equitable treatment, with respect to the status, tenure, pay, benefits (other than benefits under programs administered by the Office of Personnel Management), and accrued leave or vacation time of those employees, for prior periods of service with any Federal agency, including the Board of Governors, the Corporation, the Department of Housing and Urban Development, the National Credit Union Administration, the Office of the Comptroller of the Currency, the Office of Thrift Supervision, a Federal reserve bank, a Federal home loan bank, or a joint office of the Federal home loan banks." ;
  fro-usc:hasId "id83b25a9a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/k/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25a9b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-5-13> ;
  fro-usc:hasContentText "In implementing the provisions of this section, the Bureau shall coordinate with the Office of Personnel Management and other entities having expertise in matters related to employment to ensure a fair and orderly transition for affected employees." ;
  fro-usc:hasHeading "Implementation" ;
  fro-usc:hasId "id83b25a9b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/l" ;
  fro-usc:hasNumberText "(l)" ;
.
fro-usc-t12-ch53:id83b25a9c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 14 ;
