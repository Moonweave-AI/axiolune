  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-4-3> ;
  fro-usc:hasContentText "the business of insurance; or" ;
  fro-usc:hasId "id83a67406-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
