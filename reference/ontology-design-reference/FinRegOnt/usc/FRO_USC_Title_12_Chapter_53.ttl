.
fro-usc-t12-ch53:id83ab2e10-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-8-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83ab2e10-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This title, referred to in subsec. (b)(4), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e11-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-6-8-1> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83ab2e11-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section effective on the designated transfer date, except that subsec. (e) of this section is effective July 21, 2010 , see section 1029A of Pub. L. 111–203 , set out as a note under section 5511 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1029A" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5511" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id83a8bd32-1df7-11e6-87ee-8e4a3ab90f2a ;
.
