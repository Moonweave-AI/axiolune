  fro-usc:hasContentText "the Federal Home Loan Mortgage Corporation; and" ;
  fro-usc:hasId "id83b4a4a0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/e/2/F" ;
