fro-usc-t12-ch53:id839cd70f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-11-2-2-3> ;
  fro-usc:hasContentText "the Corporation as receiver for a covered financial company in default or in danger of default transfers any assets or liabilities of the covered financial company; and" ;
  fro-usc:hasId "id839cd70f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/10/A/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd710-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-11-2-2-4> ;
  fro-usc:hasContentText "the transfer includes any qualified financial contract." ;
  fro-usc:hasId "id839cd710-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/10/A/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
