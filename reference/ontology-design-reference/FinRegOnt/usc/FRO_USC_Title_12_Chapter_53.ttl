.
fro-usc-t12-ch53:id83a1916f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-2-3-2-4> ;
  fro-usc:hasContentText "an explanation of why an extension is necessary to commence the process of orderly implementation of this title; " ;
  fro-usc:hasId "id83a1916f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5411/b/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a19170-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-2-3-2-5> ;
  fro-usc:hasContentText "the transfer date designated under this subsection; and" ;
  fro-usc:hasId "id83a19170-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5411/b/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a19171-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-2-3-2-6> ;
  fro-usc:hasContentText "a description of the steps that will be taken to initiate the process of an orderly and timely implementation of this title  within the extended time period." ;
  fro-usc:hasId "id83a19171-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5411/b/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83a19172-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-2-3-3> ;
  fro-usc:hasContentText "Not later than 270 days after July 21, 2010 , the Secretary shall publish in the Federal Register notice of any transfer date designated under paragraph (1)." ;
  fro-usc:hasHeading "Publication of notice" ;
  fro-usc:hasId "id83a19172-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5411/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
