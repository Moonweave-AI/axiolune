  fro-usc:hasHeading "Operation of bridge brokers or dealers" ;
  fro-usc:hasId "id839f4766-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/2/H/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id839f4767-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-4> ;
  fro-usc:hasHeading "Interests in and assets and obligations of covered financial company" ;
  fro-usc:hasId "id839f4767-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-9-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4768-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4769-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4768-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-4-3> ;
  fro-usc:hasContentText "a bridge financial company shall assume, acquire, or succeed to the assets or liabilities of a covered financial company (including the assets or liabilities associated with any trust or custody business) only to the extent that such assets or liabilities are transferred by the Corporation to the bridge financial company in accordance with, and subject to the restrictions set forth in, paragraph (1)(B); and" ;
  fro-usc:hasId "id839f4768-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f4769-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-4-4> ;
  fro-usc:hasContentText "a bridge financial company shall not assume, acquire, or succeed to any obligation that a covered financial company for which the Corporation has been appointed receiver may have to any shareholder, member, general partner, limited partner, or other person with an interest in the equity of the covered financial company that arises as a result of the status of that person having an equity claim in the covered financial company." ;
  fro-usc:hasId "id839f4769-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f476a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-5> ;
  fro-usc:hasContentText "A bridge financial company shall be treated as a covered financial company in default at such times and for such purposes as the Corporation may, in its discretion, determine." ;
  fro-usc:hasHeading "Bridge financial company treated as being in default for certain purposes" ;
  fro-usc:hasId "id839f476a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id839f476b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6> ;
  fro-usc:hasHeading "Transfer of assets and liabilities" ;
  fro-usc:hasId "id839f476b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5" ;
  fro-usc:hasNumberText "(5)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f476c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f476d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f476e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f476f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4770-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4776-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f476c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-2> ;
  fro-usc:hasContentText "The Corporation, as receiver for a covered financial company, may transfer any assets and liabilities of a covered financial company (including any assets or liabilities associated with any trust or custody business) to one or more bridge financial companies, in accordance with and subject to the restrictions of paragraph (1)." ;
  fro-usc:hasHeading "Authority of Corporation" ;
  fro-usc:hasId "id839f476c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f476d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-3> ;
  fro-usc:hasContentText "At any time after the establishment of a bridge financial company with respect to a covered financial company, the Corporation, as receiver, may transfer any assets and liabilities of such covered financial company as the Corporation may, in its discretion, determine to be appropriate in accordance with and subject to the restrictions of paragraph (1)." ;
  fro-usc:hasHeading "Subsequent transfers" ;
  fro-usc:hasId "id839f476d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f476e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-4> ;
  fro-usc:hasContentText "For purposes of this paragraph, the trust or custody business, including fiduciary appointments, held by any covered financial company is included among its assets and liabilities." ;
  fro-usc:hasHeading "Treatment of trust or custody business" ;
  fro-usc:hasId "id839f476e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839f476f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-5> ;
  fro-usc:hasContentText "The transfer of any assets or liabilities, including those associated with any trust or custody business of a covered financial company, to a bridge financial company shall be effective without any further approval under Federal or State law, assignment, or consent with respect thereto." ;
  fro-usc:hasHeading "Effective without approval" ;
  fro-usc:hasId "id839f476f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839f4770-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-6> ;
  fro-usc:hasHeading "Equitable treatment of similarly situated creditors" ;
  fro-usc:hasId "id839f4770-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/E" ;
  fro-usc:hasNumberText "(E)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-9-6-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4771-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4775-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4771-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-6-3> ;
  fro-usc:hasId "id839f4771-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/E/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-9-6-6-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4772-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4773-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4774-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4772-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-6-3-2> ;
  fro-usc:hasContentText "to maximize the value of the assets of the covered financial company;" ;
  fro-usc:hasId "id839f4772-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/E/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839f4773-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-6-3-3> ;
  fro-usc:hasContentText "to maximize the present value return from the sale or other disposition of the assets of the covered financial company; or" ;
  fro-usc:hasId "id839f4773-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/E/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839f4774-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-6-3-4> ;
  fro-usc:hasContentText "to minimize the amount of any loss realized upon the sale or other disposition of the assets of the covered financial company; and" ;
  fro-usc:hasId "id839f4774-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/E/i/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839f4775-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-6-4> ;
  fro-usc:hasContentText "all creditors that are similarly situated under subsection (b)(1) receive not less than the amount provided under paragraphs (2) and (3) of subsection (d)." ;
  fro-usc:hasId "id839f4775-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/E/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f4776-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-6-7> ;
  fro-usc:hasContentText "Notwithstanding any other provision of law, the aggregate amount of liabilities of a covered financial company that are transferred to, or assumed by, a bridge financial company from a covered financial company may not exceed the aggregate amount of the assets of the covered financial company that are transferred to, or purchased by, the bridge financial company from the covered financial company." ;
  fro-usc:hasHeading "Limitation on transfer of liabilities" ;
  fro-usc:hasId "id839f4776-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/5/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id839f4777-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-7> ;
  fro-usc:hasContentText "Any judicial action to which a bridge financial company becomes a party by virtue of its acquisition of any assets or assumption of any liabilities of a covered financial company shall be stayed from further proceedings for a period of not longer than 45 days (or such longer period as may be agreed to upon the consent of all parties) at the request of the bridge financial company." ;
  fro-usc:hasHeading "Stay of judicial action" ;
  fro-usc:hasId "id839f4777-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id839f4778-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-8> ;
  fro-usc:hasHeading "Agreements against interest of the bridge financial company" ;
  fro-usc:hasId "id839f4778-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/7" ;
  fro-usc:hasNumberText "(7)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-9-8-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4779-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f477a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f477b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4779-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-8-3> ;
  fro-usc:hasContentText "is in writing;" ;
  fro-usc:hasId "id839f4779-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/7/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f477a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-8-4> ;
  fro-usc:hasContentText "was executed by an authorized officer or representative of the covered financial company or confirmed in the ordinary course of business by the covered financial company; and" ;
  fro-usc:hasId "id839f477a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/7/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f477b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-8-5> ;
  fro-usc:hasContentText "has been on the official record of the company, since the time of its execution, or with which, the party claiming under the agreement provides documentation of such agreement and its authorized execution or confirmation by the covered financial company that is acceptable to the receiver." ;
  fro-usc:hasId "id839f477b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/7/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839f477c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-9> ;
  fro-usc:hasHeading "No Federal status" ;
  fro-usc:hasId "id839f477c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/8" ;
  fro-usc:hasNumberText "(8)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f477d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f477e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f477d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-9-2> ;
  fro-usc:hasContentText "A bridge financial company is not an agency, establishment, or instrumentality of the United States." ;
  fro-usc:hasHeading "Agency status" ;
  fro-usc:hasId "id839f477d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/8/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f477e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-9-3> ;
  fro-usc:hasHeading "Employee status" ;
  fro-usc:hasId "id839f477e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/8/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-9-9-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f477f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4780-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f477f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-9-3-3> ;
  fro-usc:hasContentText "solely by virtue of service in any such capacity lose any existing status as an officer or employee of the United States for purposes of title 5 or any other provision of law; or" ;
  fro-usc:hasId "id839f477f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/8/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f4780-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-9-3-4> ;
  fro-usc:hasContentText "receive any salary or benefits for service in any such capacity with respect to a bridge financial company in addition to such salary or benefits as are obtained through employment with the Corporation or such Federal instrumentality." ;
  fro-usc:hasId "id839f4780-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/8/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f4781-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-10> ;
  fro-usc:hasContentText "The Corporation may, subject to the plan described in subsection (n)(9), provide funding to facilitate any transaction described in subparagraph (A), (B), (C), or (D) of paragraph (13) with respect to any bridge financial company, or facilitate the acquisition by a bridge financial company of any assets, or the assumption of any liabilities, of a covered financial company for which the Corporation has been appointed receiver." ;
  fro-usc:hasHeading "Funding authorized" ;
  fro-usc:hasId "id839f4781-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/9" ;
  fro-usc:hasNumberText "(9)" ;
.
fro-usc-t12-ch53:id839f4782-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-11> ;
  fro-usc:hasContentText "Notwithstanding any other provision of Federal or State law, a bridge financial company, its franchise, property, and income shall be exempt from all taxation now or hereafter imposed by the United States, by any territory, dependency, or possession thereof, or by any State, county, municipality, or local taxing authority." ;
  fro-usc:hasHeading "Exempt tax status" ;
  fro-usc:hasId "id839f4782-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/10" ;
  fro-usc:hasNumberText "(10)" ;
.
fro-usc-t12-ch53:id839f4783-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-12> ;
  fro-usc:hasContentText "If a transaction involving the merger or sale of a bridge financial company requires approval by a Federal agency, the transaction may not be consummated before the 5th calendar day after the date of approval by the Federal agency responsible for such approval with respect thereto. If, in connection with any such approval a report on competitive factors from the Attorney General is required, the Federal agency responsible for such approval shall promptly notify the Attorney General of the proposed transaction and the Attorney General shall provide the required report within 10 days of the request. If a notification is required under section 18a of title 15 with respect to such transaction, the required waiting period shall end on the 15th day after the date on which the Attorney General and the Federal Trade Commission receive such notification, unless the waiting period is terminated earlier under section 18a(b)(2) of title 15 , or extended under section 18a(e)(2) of title 15 ." ;
  fro-usc:hasHeading "Federal agency approval; antitrust review" ;
  fro-usc:hasId "id839f4783-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/11" ;
  fro-usc:hasNumberText "(11)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s18a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s18a/b/2" ;
  fro-usc:hasReferenceText "/us/usc/t15/s18a/e/2" ;
.
fro-usc-t12-ch53:id839f4784-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-13> ;
  fro-usc:hasContentText "Subject to paragraphs (13) and (14), the status of a bridge financial company as such shall terminate at the end of the 2-year period following the date on which it was granted a charter. The Corporation may, in its discretion, extend the status of the bridge financial company as such for no more than 3 additional 1-year periods." ;
  fro-usc:hasHeading "Duration of bridge financial company" ;
  fro-usc:hasId "id839f4784-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/12" ;
  fro-usc:hasNumberText "(12)" ;
.
fro-usc-t12-ch53:id839f4785-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-14> ;
  fro-usc:hasHeading "Termination of bridge financial company status" ;
  fro-usc:hasId "id839f4785-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/13" ;
  fro-usc:hasNumberText "(13)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-9-14-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4786-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4787-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4788-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4789-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f478a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4786-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-14-3> ;
  fro-usc:hasContentText "the date of the merger or consolidation of the bridge financial company with a company that is not a bridge financial company;" ;
  fro-usc:hasId "id839f4786-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/13/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f4787-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-14-4> ;
  fro-usc:hasContentText "at the election of the Corporation, the sale of a majority of the capital stock of the bridge financial company to a company other than the Corporation and other than another bridge financial company;" ;
  fro-usc:hasId "id839f4787-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/13/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f4788-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-14-5> ;
  fro-usc:hasContentText "the sale of 80 percent, or more, of the capital stock of the bridge financial company to a person other than the Corporation and other than another bridge financial company;" ;
  fro-usc:hasId "id839f4788-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/13/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839f4789-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-14-6> ;
  fro-usc:hasContentText "at the election of the Corporation, either the assumption of all or substantially all of the liabilities of the bridge financial company by a company that is not a bridge financial company, or the acquisition of all or substantially all of the assets of the bridge financial company by a company that is not a bridge financial company, or other entity as permitted under applicable law; and" ;
  fro-usc:hasId "id839f4789-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/13/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839f478a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-14-7> ;
  fro-usc:hasContentText "the expiration of the period provided in paragraph (12), or the earlier dissolution of the bridge financial company, as provided in paragraph (15)." ;
  fro-usc:hasId "id839f478a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/13/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id839f478b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-15> ;
  fro-usc:hasHeading "Effect of termination events" ;
  fro-usc:hasId "id839f478b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/14" ;
  fro-usc:hasNumberText "(14)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f478c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f478d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f478e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f478f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4790-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f478c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-15-2> ;
  fro-usc:hasContentText "A merger or consolidation, described in paragraph (13)(A) shall be conducted in accordance with, and shall have the effect provided in, the provisions of applicable law. For the purpose of effecting such a merger or consolidation, the bridge financial company shall be treated as a corporation organized under the laws of the State of Delaware (unless the law of another State has been selected by the bridge financial company in accordance with paragraph (2)(F)), and the Corporation shall be treated as the sole shareholder thereof, notwithstanding any other provision of State or Federal law." ;
  fro-usc:hasHeading "Merger or consolidation" ;
  fro-usc:hasId "id839f478c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/14/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f478d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-15-3> ;
  fro-usc:hasContentText "Following the sale of a majority of the capital stock of the bridge financial company, as provided in paragraph (13)(B), the Corporation may amend the charter of the bridge financial company to reflect the termination of the status of the bridge financial company as such, whereupon the company shall have all of the rights, powers, and privileges under its constituent documents and applicable Federal or State law. In connection therewith, the Corporation may take such steps as may be necessary or convenient to reincorporate the bridge financial company under the laws of a State and, notwithstanding any provisions of Federal or State law, such State-chartered corporation shall be deemed to succeed by operation of law to such rights, titles, powers, and interests of the bridge financial company as the Corporation may provide, with the same effect as if the bridge financial company had merged with the State-chartered corporation under provisions of the corporate laws of such State." ;
  fro-usc:hasHeading "Charter conversion" ;
  fro-usc:hasId "id839f478d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/14/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f478e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-15-4> ;
  fro-usc:hasContentText "Following the sale of 80 percent or more of the capital stock of a bridge financial company, as provided in paragraph (13)(C), the company shall have all of the rights, powers, and privileges under its constituent documents and applicable Federal or State law. In connection therewith, the Corporation may take such steps as may be necessary or convenient to reincorporate the bridge financial company under the laws of a State and, notwithstanding any provisions of Federal or State law, the State-chartered corporation shall be deemed to succeed by operation of law to such rights, titles, powers and interests of the bridge financial company as the Corporation may provide, with the same effect as if the bridge financial company had merged with the State-chartered corporation under provisions of the corporate laws of such State." ;
  fro-usc:hasHeading "Sale of stock" ;
  fro-usc:hasId "id839f478e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/14/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839f478f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-15-5> ;
  fro-usc:hasContentText "Following the assumption of all or substantially all of the liabilities of the bridge financial company, or the sale of all or substantially all of the assets of the bridge financial company, as provided in paragraph (13)(D), at the election of the Corporation, the bridge financial company may retain its status as such for the period provided in paragraph (12) or may be dissolved at the election of the Corporation." ;
  fro-usc:hasHeading "Assumption of liabilities and sale of assets" ;
  fro-usc:hasId "id839f478f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/14/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839f4790-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-15-6> ;
  fro-usc:hasContentText "Following the consummation of a transaction described in subparagraph (A), (B), (C), or (D) of paragraph (13), the charter of the resulting company shall be amended to reflect the termination of bridge financial company status, if appropriate." ;
  fro-usc:hasHeading "Amendments to charter" ;
  fro-usc:hasId "id839f4790-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/14/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id839f4791-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-16> ;
  fro-usc:hasHeading "Dissolution of bridge financial company" ;
  fro-usc:hasId "id839f4791-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/15" ;
  fro-usc:hasNumberText "(15)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4792-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4795-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4792-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-16-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f4792-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/15/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-9-16-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4793-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4794-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4793-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-16-2-3> ;
  fro-usc:hasContentText "the Corporation may, in its discretion, dissolve the bridge financial company in accordance with this paragraph at any time; and" ;
  fro-usc:hasId "id839f4793-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/15/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f4794-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-16-2-4> ;
  fro-usc:hasContentText "the Corporation shall promptly commence dissolution proceedings in accordance with this paragraph upon the expiration of the 2-year period following the date on which the bridge financial company was chartered, or any extension thereof, as provided in paragraph (12)." ;
  fro-usc:hasId "id839f4794-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/15/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f4795-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-16-3> ;
  fro-usc:hasContentText "The Corporation shall remain the receiver for a bridge financial company for the purpose of dissolving the bridge financial company. The Corporation as receiver for a bridge financial company shall wind up the affairs of the bridge financial company in conformity with the provisions of law relating to the liquidation of covered financial companies under this subchapter. With respect to any such bridge financial company, the Corporation as receiver shall have all the rights, powers, and privileges and shall perform the duties related to the exercise of such rights, powers, or privileges granted by law to the Corporation as receiver for a covered financial company under this subchapter and, notwithstanding any other provision of law, in the exercise of such rights, powers, and privileges, the Corporation shall not be subject to the direction or supervision of any State agency or other Federal agency." ;
  fro-usc:hasHeading "Procedures" ;
  fro-usc:hasId "id839f4795-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/15/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f4796-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17> ;
  fro-usc:hasHeading "Authority to obtain credit" ;
  fro-usc:hasId "id839f4796-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16" ;
  fro-usc:hasNumberText "(16)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4797-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4798-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f479c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47a1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47a2-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4797-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-2> ;
  fro-usc:hasContentText "A bridge financial company may obtain unsecured credit and issue unsecured debt." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f4797-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f4798-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-3> ;
  fro-usc:hasHeading "Inability to obtain credit" ;
  fro-usc:hasId "id839f4798-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-9-17-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4799-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f479a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f479b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4799-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-3-3> ;
  fro-usc:hasContentText "with priority over any or all of the obligations of the bridge financial company;" ;
  fro-usc:hasId "id839f4799-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f479a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-3-4> ;
  fro-usc:hasContentText "secured by a lien on property of the bridge financial company that is not otherwise subject to a lien; or" ;
  fro-usc:hasId "id839f479a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f479b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-3-5> ;
  fro-usc:hasContentText "secured by a junior lien on property of the bridge financial company that is subject to a lien." ;
  fro-usc:hasId "id839f479b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839f479c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-4> ;
  fro-usc:hasHeading "Limitations" ;
  fro-usc:hasId "id839f479c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/C" ;
  fro-usc:hasNumberText "(C)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f479d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47a0-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f479d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-4-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f479d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/C/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-9-17-4-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f479e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f479f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f479e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-4-2-3> ;
  fro-usc:hasContentText "the bridge financial company is unable to otherwise obtain such credit or issue such debt; and" ;
  fro-usc:hasId "id839f479e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/C/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839f479f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-4-2-4> ;
  fro-usc:hasContentText "there is adequate protection of the interest of the holder of the lien on the property with respect to which such senior or equal lien is proposed to be granted." ;
  fro-usc:hasId "id839f479f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/C/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839f47a0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-4-3> ;
  fro-usc:hasHeading "Hearing" ;
  fro-usc:hasId "id839f47a0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f47a1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-5> ;
  fro-usc:hasContentText "In any hearing under this paragraph, the Corporation has the burden of proof on the issue of adequate protection." ;
  fro-usc:hasHeading "Burden of proof" ;
  fro-usc:hasId "id839f47a1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839f47a2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-17-6> ;
  fro-usc:hasContentText "No credit or debt obtained or issued by a bridge financial company may contain terms that impair the rights of a counterparty to a qualified financial contract upon a default by the bridge financial company, other than the priority of such counterparty’s unsecured claim (after the exercise of rights) relative to the priority of the bridge financial company’s obligations in respect of such credit or debt, unless such counterparty consents in writing to any such impairment." ;
  fro-usc:hasHeading "Qualified financial contracts" ;
  fro-usc:hasId "id839f47a2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/16/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id839f47a3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-18> ;
  fro-usc:hasContentText "The reversal or modification on appeal of an authorization under this subsection to obtain credit or issue debt, or of a grant under this section of a priority or a lien, does not affect the validity of any debt so issued, or any priority or lien so granted, to an entity that extended such credit in good faith, whether or not such entity knew of the pendency of the appeal, unless such authorization and the issuance of such debt, or the granting of such priority or lien, were stayed pending appeal." ;
  fro-usc:hasHeading "Effect on debts and liens" ;
  fro-usc:hasId "id839f47a3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/17" ;
  fro-usc:hasNumberText "(17)" ;
.
fro-usc-t12-ch53:id839f47a4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-10> ;
  fro-usc:hasContentText "If the Corporation has been appointed as receiver for a covered financial company, other Federal regulators shall make all records relating to the covered financial company available to the Corporation, which may be used by the Corporation in any manner that the Corporation determines to be appropriate." ;
  fro-usc:hasHeading "Sharing records" ;
  fro-usc:hasId "id839f47a4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f47a5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47a6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47a7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47a8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-11> ;
  fro-usc:hasHeading "Expedited procedures for certain claims" ;
  fro-usc:hasId "id839f47a5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/j" ;
  fro-usc:hasNumberText "(j)" ;
.
fro-usc-t12-ch53:id839f47a6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-11-2> ;
  fro-usc:hasContentText "The notice of appeal of any order, whether interlocutory or final, entered in any case brought by the Corporation against a director, officer, employee, agent, attorney, accountant, or appraiser of the covered financial company, or any other person employed by or providing services to a covered financial company, shall be filed not later than 30 days after the date of entry of the order. The hearing of the appeal shall be held not later than 120 days after the date of the notice of appeal. The appeal shall be decided not later than 180 days after the date of the notice of appeal." ;
  fro-usc:hasHeading "Time for filing notice of appeal" ;
  fro-usc:hasId "id839f47a6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/j/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839f47a7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-11-3> ;
  fro-usc:hasContentText "The court shall expedite the consideration of any case brought by the Corporation against a director, officer, employee, agent, attorney, accountant, or appraiser of a covered financial company or any other person employed by or providing services to a covered financial company. As far as practicable, the court shall give such case priority on its docket." ;
  fro-usc:hasHeading "Scheduling" ;
  fro-usc:hasId "id839f47a7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/j/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839f47a8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-11-4> ;
  fro-usc:hasContentText "The court may modify the schedule and limitations stated in paragraphs (1) and (2) in a particular case, based on a specific finding that the ends of justice that would be served by making such a modification would outweigh the best interest of the public in having the case resolved expeditiously." ;
  fro-usc:hasHeading "Judicial discretion" ;
  fro-usc:hasId "id839f47a8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/j/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839f47a9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47aa-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47ab-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-12> ;
  fro-usc:hasHeading "Foreign investigations" ;
  fro-usc:hasId "id839f47a9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/k" ;
  fro-usc:hasNumberText "(k)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-12-2> ;
.
fro-usc-t12-ch53:id839f47aa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-12-3> ;
  fro-usc:hasContentText "may request the assistance of any foreign financial authority and provide assistance to any foreign financial authority in accordance with section 1818(v) of this title , as if the covered financial company were an insured depository institution, the Corporation were the appropriate Federal banking agency for the company, and any foreign financial authority were the foreign banking authority; and" ;
  fro-usc:hasId "id839f47aa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/k/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1818/v" ;
.
fro-usc-t12-ch53:id839f47ab-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-12-4> ;
  fro-usc:hasContentText "may maintain an office to coordinate foreign investigations or investigations on behalf of foreign financial authorities." ;
  fro-usc:hasId "id839f47ab-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/k/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839f47ac-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-13> ;
  fro-usc:hasContentText "The Corporation may not enter into any agreement or approve any protective order which prohibits the Corporation from disclosing the terms of any settlement of an administrative or other action for damages or restitution brought by the Corporation in its capacity as receiver for a covered financial company." ;
  fro-usc:hasHeading "Prohibition on entering secrecy agreements and protective orders" ;
  fro-usc:hasId "id839f47ac-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/l" ;
  fro-usc:hasNumberText "(l)" ;
.
fro-usc-t12-ch53:id839f47ad-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47ae-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47b1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-14> ;
  fro-usc:hasHeading "Liquidation of certain covered financial companies or bridge financial companies" ;
  fro-usc:hasId "id839f47ad-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/m" ;
  fro-usc:hasNumberText "(m)" ;
.
fro-usc-t12-ch53:id839f47ae-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-14-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f47ae-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/m/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-14-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47af-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47b0-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47af-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-14-2-3> ;
  fro-usc:hasContentText "in the case of any covered financial company or bridge financial company that is a stockbroker, but is not a member of the Securities Investor Protection Corporation, apply the provisions of subchapter III of chapter 7 of the Bankruptcy Code, in respect of the distribution to any customer of all customer name security and customer property and member property, as if such covered financial company or bridge financial company were a debtor for purposes of such subchapter; or" ;
  fro-usc:hasId "id839f47af-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/m/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f47b0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-14-2-4> ;
  fro-usc:hasContentText "in the case of any covered financial company or bridge financial company that is a commodity broker, apply the provisions of subchapter IV of chapter 7  3 the Bankruptcy Code, in respect of the distribution to any customer of all customer property and member property, as if such covered financial company or bridge financial company were a debtor for purposes of such subchapter." ;
  fro-usc:hasId "id839f47b0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/m/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f47b1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-14-3> ;
  fro-usc:hasHeading "Definitions" ;
  fro-usc:hasId "id839f47b1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/m/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-14-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47b2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47b3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47b2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-14-3-3> ;
  fro-usc:hasContentText "the terms “customer”, “customer name security”, and “customer property and member property” have the same meanings as in sections 741 and 761 of title 11; and" ;
  fro-usc:hasId "id839f47b2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/m/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f47b3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-14-3-4> ;
  fro-usc:hasContentText "the terms “commodity broker” and “stockbroker” have the same meanings as in section 101 of the Bankruptcy Code." ;
  fro-usc:hasId "id839f47b3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/m/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f47b4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47b5-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47b6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47b7-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47b8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47b9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47c1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47c4-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47c5-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47cd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f47d6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15> ;
  fro-usc:hasHeading "Orderly Liquidation Fund" ;
  fro-usc:hasId "id839f47b4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n" ;
  fro-usc:hasNumberText "(n)" ;
.
fro-usc-t12-ch53:id839f47b5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-2> ;
  fro-usc:hasContentText "There is established in the Treasury of the United States a separate fund to be known as the “Orderly Liquidation Fund”, which shall be available to the Corporation to carry out the authorities contained in this subchapter, for the cost of actions authorized by this subchapter, including the orderly liquidation of covered financial companies, payment of administrative expenses, the payment of principal and interest by the Corporation on obligations issued under paragraph (5), and the exercise of the authorities of the Corporation under this subchapter." ;
  fro-usc:hasHeading "Establishment" ;
  fro-usc:hasId "id839f47b5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839f47b6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-3> ;
  fro-usc:hasContentText "Amounts received by the Corporation, including assessments received under subsection ( o ), proceeds of obligations issued under paragraph (5), interest and other earnings from investments, and repayments to the Corporation by covered financial companies, shall be deposited into the Fund." ;
  fro-usc:hasHeading "Proceeds" ;
  fro-usc:hasId "id839f47b6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839f47b7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-4> ;
  fro-usc:hasContentText "The Corporation shall manage the Fund in accordance with this subsection and the policies and procedures established under section 5383(d) of this title ." ;
  fro-usc:hasHeading "Management" ;
  fro-usc:hasId "id839f47b7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5383/d" ;
.
fro-usc-t12-ch53:id839f47b8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-5> ;
  fro-usc:hasContentText "At the request of the Corporation, the Secretary may invest such portion of amounts held in the Fund that are not, in the judgment of the Corporation, required to meet the current needs of the Corporation, in obligations of the United States having suitable maturities, as determined by the Corporation. The interest on and the proceeds from the sale or redemption of such obligations shall be credited to the Fund." ;
  fro-usc:hasHeading "Investments" ;
  fro-usc:hasId "id839f47b8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id839f47b9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-6> ;
  fro-usc:hasHeading "Authority to issue obligations" ;
  fro-usc:hasId "id839f47b9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/5" ;
  fro-usc:hasNumberText "(5)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47ba-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47bb-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47bc-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47bf-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47c0-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47ba-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-6-2> ;
  fro-usc:hasContentText "Upon appointment by the Secretary of the Corporation as receiver for a covered financial company, the Corporation is authorized to issue obligations to the Secretary." ;
  fro-usc:hasHeading "Corporation authorized to issue obligations" ;
  fro-usc:hasId "id839f47ba-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/5/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f47bb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-6-3> ;
  fro-usc:hasContentText "The Secretary may, under such terms and conditions as the Secretary may require, purchase or agree to purchase any obligations issued under subparagraph (A), and for such purpose, the Secretary is authorized to use as a public debt transaction the proceeds of the sale of any securities issued under chapter 31 of title 31, and the purposes for which securities may be issued under chapter 31 of title 31 are extended to include such purchases." ;
  fro-usc:hasHeading "Secretary authorized to purchase obligations" ;
  fro-usc:hasId "id839f47bb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f47bc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-6-4> ;
  fro-usc:hasHeading "Interest rate" ;
  fro-usc:hasId "id839f47bc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/5/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-15-6-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47bd-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47be-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47bd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-6-4-3> ;
  fro-usc:hasContentText "the current average rate on an index of corporate obligations of comparable maturity; and" ;
  fro-usc:hasId "id839f47bd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/5/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f47be-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-6-4-4> ;
  fro-usc:hasContentText "the current average rate on outstanding marketable obligations of the United States of comparable maturity." ;
  fro-usc:hasId "id839f47be-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/5/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f47bf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-6-5> ;
  fro-usc:hasContentText "The Secretary may sell, upon such terms and conditions as the Secretary shall determine, any of the obligations acquired under this paragraph." ;
  fro-usc:hasHeading "Secretary authorized to sell obligations" ;
  fro-usc:hasId "id839f47bf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/5/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839f47c0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-6-6> ;
  fro-usc:hasContentText "All purchases and sales by the Secretary of such obligations under this paragraph shall be treated as public debt transactions of the United States, and the proceeds from the sale of any obligations acquired by the Secretary under this paragraph shall be deposited into the Treasury of the United States as miscellaneous receipts." ;
  fro-usc:hasHeading "Public debt transactions" ;
  fro-usc:hasId "id839f47c0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/5/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id839f47c1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-7> ;
  fro-usc:hasHeading "Maximum obligation limitation" ;
  fro-usc:hasId "id839f47c1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-15-7-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47c2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47c3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47c2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-7-3> ;
  fro-usc:hasContentText "an amount that is equal to 10 percent of the total consolidated assets of the covered financial company, based on the most recent financial statement available, during the 30-day period immediately following the date of appointment of the Corporation as receiver (or a shorter time period if the Corporation has calculated the amount described under subparagraph (B)); and" ;
  fro-usc:hasId "id839f47c2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/6/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f47c3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-7-4> ;
  fro-usc:hasContentText "the amount that is equal to 90 percent of the fair value of the total consolidated assets of each covered financial company that are available for repayment, after the time period described in subparagraph (A)." ;
  fro-usc:hasId "id839f47c3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f47c4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-15-8> ;
  fro-usc:hasContentText "The Corporation and the Secretary shall jointly, in consultation with the Council, prescribe regulations governing the calculation of the maximum obligation limitation defined in this paragraph." ;
  fro-usc:hasHeading "Rulemaking" ;
  fro-usc:hasId "id839f47c4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/n/7" ;
  fro-usc:hasNumberText "(7)" ;
.
fro-usc-t12-ch53:id839f47c5-1df7-11e6-87ee-8e4a3ab90f2a
