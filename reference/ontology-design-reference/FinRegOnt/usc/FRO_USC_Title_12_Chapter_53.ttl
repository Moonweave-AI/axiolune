.
fro-usc-t12-ch53:id839a8c54-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-3-3-3-2> ;
  fro-usc:hasContentText "to make funds available under section 5384(d) of this title ;" ;
  fro-usc:hasId "id839a8c54-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/b/2/A/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5384/d" ;
.
fro-usc-t12-ch53:id839a8c55-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-6-3-3-3-3> ;
  fro-usc:hasContentText "to organize, establish, operate, or terminate any bridge financial company;" ;
  fro-usc:hasId "id839a8c55-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5385/b/2/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
