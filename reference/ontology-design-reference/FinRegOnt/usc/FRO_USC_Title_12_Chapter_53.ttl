.
fro-usc-t12-ch53:id83a191fd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-10-3-3-4> ;
  fro-usc:hasContentText "the enhanced vision benefits established under chapter 89B of title 5; and" ;
  fro-usc:hasId "id83a191fd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/i/2/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a191fe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-10-3-3-5> ;
  fro-usc:hasContentText "the Federal Employees’ Group Life Insurance Program established under chapter 87 of title 5, without regard to any requirement of insurability." ;
  fro-usc:hasId "id83a191fe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/i/2/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83a191ff-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-10-3-4> ;
  fro-usc:hasContentText "If, after the 1-year period beginning on the transfer date, the Office of the Comptroller of the Currency or the Corporation determines that the Office of the Comptroller of the Currency or the Corporation, as appropriate, will not continue to participate in any long term care insurance program of an agency from which an employee transferred, a transferred employee who is a member of such a program may, before the decision takes effect, elect to apply for coverage under the Federal Long Term Care Insurance Program established under chapter 90 of title 5 under the underwriting requirements applicable to a new active workforce member, as described in part 875 of title 5, Code of Federal Regulations (or any successor thereto)." ;
  fro-usc:hasHeading "Long term care insurance after 1st year" ;
  fro-usc:hasId "id83a191ff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/i/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
