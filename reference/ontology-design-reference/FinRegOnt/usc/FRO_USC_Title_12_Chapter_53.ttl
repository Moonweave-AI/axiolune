  fro-usc:hasContentText "ways to increase and make more effective international coordination." ;
  fro-usc:hasId "id839a8bde-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/f/1/B/iv" ;
