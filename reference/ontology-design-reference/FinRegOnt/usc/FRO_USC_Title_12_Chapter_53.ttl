  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-26-3> ;
  fro-usc:hasContentText "in the case of an insured depository institution or depository institution holding company (as defined in section 1813 of this title ), or subsidiary of such institution or company, the appropriate Federal banking agency, as that term is defined in section 1813 of this title ; and" ;
  fro-usc:hasId "id83a67420-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/24/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813" ;
.
fro-usc-t12-ch53:id83a67421-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-26-4> ;
  fro-usc:hasContentText "in the case of an insured credit union, the National Credit Union Administration." ;
  fro-usc:hasId "id83a67421-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/24/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a67422-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 27 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-27> ;
  fro-usc:hasHeading "Related person" ;
  fro-usc:hasId "id83a67422-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/25" ;
  fro-usc:hasNumberText "(25)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-27-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67423-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67424-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67425-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a67423-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-27-3> ;
  fro-usc:hasContentText "shall apply only with respect to a covered person that is not a bank holding company (as that term is defined in section 1841 of this title ), credit union, or depository institution;" ;
  fro-usc:hasId "id83a67423-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/25/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841" ;
.
fro-usc-t12-ch53:id83a67424-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-27-4> ;
  fro-usc:hasContentText "shall be deemed to mean a covered person for all purposes of any provision of Federal consumer financial law; and" ;
  fro-usc:hasId "id83a67424-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/25/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a67425-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-27-5> ;
  fro-usc:hasId "id83a67425-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/25/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-27-5-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67426-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67427-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67428-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a67426-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-27-5-2> ;
  fro-usc:hasContentText "any director, officer, or employee charged with managerial responsibility for, or controlling shareholder of, or agent for, such covered person;" ;
  fro-usc:hasId "id83a67426-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/25/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a67427-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-27-5-3> ;
  fro-usc:hasContentText "any shareholder, consultant, joint venture partner, or other person, as determined by the Bureau (by rule or on a case-by-case basis) who materially participates in the conduct of the affairs of such covered person; and" ;
  fro-usc:hasId "id83a67427-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/25/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a67428-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-27-5-4> ;
  fro-usc:hasId "id83a67428-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/25/C/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-27-5-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67429-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6742a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a67429-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-27-5-4-2> ;
  fro-usc:hasContentText "violation of any provision of law or regulation; or" ;
  fro-usc:hasId "id83a67429-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/25/C/iii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83a6742a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-27-5-4-3> ;
  fro-usc:hasContentText "breach of a fiduciary duty." ;
  fro-usc:hasId "id83a6742a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/25/C/iii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83a6742b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 28 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-28> ;
  fro-usc:hasHeading "Service provider" ;
  fro-usc:hasId "id83a6742b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/26" ;
  fro-usc:hasNumberText "(26)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6742c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6742f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67432-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a6742c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-28-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a6742c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/26/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-28-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6742d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6742e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a6742d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-28-2-3> ;
  fro-usc:hasContentText "participates in designing, operating, or maintaining the consumer financial product or service; or" ;
  fro-usc:hasId "id83a6742d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/26/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a6742e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-28-2-4> ;
  fro-usc:hasContentText "processes transactions relating to the consumer financial product or service (other than unknowingly or incidentally transmitting or processing financial data in a manner that such data is undifferentiated from other types of data of the same form as the person transmits or processes)." ;
  fro-usc:hasId "id83a6742e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/26/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a6742f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-28-3> ;
  fro-usc:hasHeading "Exceptions" ;
  fro-usc:hasId "id83a6742f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/26/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-28-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67430-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67431-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a67430-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-28-3-3> ;
  fro-usc:hasContentText "a support service of a type provided to businesses generally or a similar ministerial service; or" ;
  fro-usc:hasId "id83a67430-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/26/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a67431-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-28-3-4> ;
  fro-usc:hasContentText "time or space for an advertisement for a consumer financial product or service through print, newspaper, or electronic media." ;
  fro-usc:hasId "id83a67431-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/26/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a67432-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-28-4> ;
  fro-usc:hasContentText "A person that is a service provider shall be deemed to be a covered person to the extent that such person engages in the offering or provision of its own consumer financial product or service." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83a67432-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/26/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a67433-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 29 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-29> ;
  fro-usc:hasContentText "The term “State” means any State, territory, or possession of the United States, the District of Columbia, the Commonwealth of Puerto Rico, the Commonwealth of the Northern Mariana Islands, Guam, American Samoa, or the United States Virgin Islands or any federally recognized Indian tribe, as defined by the Secretary of the Interior under section 479a–1(a) of title 25 ." ;
  fro-usc:hasHeading "State" ;
  fro-usc:hasId "id83a67433-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/27" ;
  fro-usc:hasNumberText "(27)" ;
  fro-usc:hasReferenceText "/us/usc/t25/s479a–1/a" ;
.
fro-usc-t12-ch53:id83a67434-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 30 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-30> ;
  fro-usc:hasHeading "Stored value" ;
  fro-usc:hasId "id83a67434-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/28" ;
  fro-usc:hasNumberText "(28)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67435-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67436-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a67435-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-30-2> ;
  fro-usc:hasContentText "The term “stored value” means funds or monetary value represented in any electronic format, whether or not specially encrypted, and stored or capable of storage on electronic media in such a way as to be retrievable and transferred electronically, and includes a prepaid debit card or product, or any other similar product, regardless of whether the amount of the funds or monetary value may be increased or reloaded." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a67435-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/28/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a67436-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-30-3> ;
  fro-usc:hasHeading "Exclusion" ;
  fro-usc:hasId "id83a67436-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/28/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-30-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67437-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67438-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a67439-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6743a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6743b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a67437-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-30-3-3> ;
  fro-usc:hasContentText "issued by a merchant, retailer, or other seller of nonfinancial goods or services;" ;
  fro-usc:hasId "id83a67437-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/28/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a67438-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-30-3-4> ;
  fro-usc:hasContentText "redeemable only for transactions with the merchant, retailer, or seller of nonfinancial goods or services or with an affiliate of such person, which affiliate itself is a merchant, retailer, or seller of nonfinancial goods or services;" ;
  fro-usc:hasId "id83a67438-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/28/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a67439-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-30-3-5> ;
  fro-usc:hasContentText "issued in a specified amount that, except in the case of a card or product used solely for telephone services, may not be increased or reloaded;" ;
  fro-usc:hasId "id83a67439-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/28/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83a6743a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-30-3-6> ;
  fro-usc:hasContentText "purchased on a prepaid basis in exchange for payment; and" ;
  fro-usc:hasId "id83a6743a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/28/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id83a6743b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-30-3-7> ;
  fro-usc:hasContentText "honored upon presentation to such merchant, retailer, or seller of nonfinancial goods or services or an affiliate of such person, which affiliate itself is a merchant, retailer, or seller of nonfinancial goods or services, only for any nonfinancial goods or services." ;
  fro-usc:hasId "id83a6743b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/28/B/v" ;
  fro-usc:hasNumberText "(v)" ;
.
fro-usc-t12-ch53:id83a6743c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 31 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-31> ;
  fro-usc:hasContentText "The term “transmitting or exchanging funds” means receiving currency, monetary value, or payment instruments from a consumer for the purpose of exchanging or transmitting the same by any means, including transmission by wire, facsimile, electronic transfer, courier, the Internet, or through bill payment services or through other businesses that facilitate third-party transfers within the United States or to or from the United States." ;
  fro-usc:hasHeading "Transmitting or exchanging funds" ;
  fro-usc:hasId "id83a6743c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/29" ;
  fro-usc:hasNumberText "(29)" ;
.
fro-usc-t12-ch53:id83a6743d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 32 ;
  fro-usc:hasId "id83a6743d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1002, July 21, 2010 , 124 Stat. 1955 .)" ;
.
fro-usc-t12-ch53:id83a6743f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-33-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a6743f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section 626 of the Omnibus Appropriations Act, 2009, referred to in par. (12)(Q), is section 626 of div. D of Pub. L. 111–8 . Subsecs. (a) and (b) of section 626 are classified to section 5538 of this title , and subsec. (c) of section 626 amended section 1639 of Title 15 , Commerce and Trade." ;
  fro-usc:hasNoteText "Subtitle F, referred to in pars. (14) and (15)(B)(ii)(II), is subtitle F (§§ 1061–1067) of title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 2035 , which is classified generally to part F (§ 5581 et seq.) of this subchapter. For complete classification of subtitle F to the Code, see Tables." ;
  fro-usc:hasNoteText "Subtitle G, referred to in par. (12), is subtitle G (§§ 1071–1079A) of title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 2056 . For complete classification of subtitle G to the Code, see Tables." ;
  fro-usc:hasNoteText "Subtitle H, referred to in pars. (12) and (15)(B)(ii)(II), is subtitle H (§§ 1081–1100H) of title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 2080 . For complete classification of subtitle H to the Code, see Tables." ;
  fro-usc:hasNoteText "The Alternative Mortgage Transaction Parity Act of 1982, referred to in par. (12)(A), is title VIII of Pub. L. 97–320 , Oct. 15, 1982 , 96 Stat. 1545 , which is classified generally to chapter 39 (§ 3801 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 3801 of this title and Tables." ;
  fro-usc:hasNoteText "The Commodity Exchange Act, referred to in par. (20), is act Sept. 21, 1922, ch. 369 , 42 Stat. 998 , which is classified generally to chapter 1 (§ 1 et seq.) of Title 7, Agriculture. For complete classification of this Act to the Code, see section 1 of Title 7 and Tables." ;
  fro-usc:hasNoteText "The Consumer Leasing Act of 1976, referred to in par. (12)(B), is Pub. L. 94–240 , Mar. 23, 1976 , 90 Stat. 257 . For complete classification of this Act to the Code, see Short Title of 1976 Amendment note set out under section 1601 of Title 15 , Commerce and Trade, and Tables." ;
  fro-usc:hasNoteText "The Electronic Fund Transfer Act, referred to in par. (12)(C), is title IX of Pub. L. 90–321 and Tables. , as added by Pub. L. 95–630, title XX , § 2001, Nov. 10, 1978 , 92 Stat. 3728 , which is classified generally to subchapter VI (§ 1693 et seq.) of chapter 41 of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see Short Title note set out under section 1601 of Title 15" ;
  fro-usc:hasNoteText "The Equal Credit Opportunity Act, referred to in par. (12)(D), is title VII of Pub. L. 90–321 and Tables. , as added by Pub. L. 93–495, title V , § 503, Oct. 28, 1974 , 88 Stat. 1521 , which is classified generally to subchapter IV (§ 1691 et seq.) of chapter 41 of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see Short Title note set out under section 1601 of Title 15" ;
  fro-usc:hasNoteText "The Fair Credit Billing Act, referred to in par. (12)(E), is title III of Pub. L. 93–495 and Tables. , Oct. 28, 1974 , 88 Stat. 1511 , which enacted sections 1666 to 1666i and 1666j of Title 15, Commerce and Trade, amended sections 1601, 1602, 1610, 1631, 1632, and 1637 of Title 15, and enacted provisions set out as a note under section 1666 of Title 15 . For complete classification of this Act to the Code, see Short Title of 1974 Amendment note set out under section 1601 of Title 15" ;
  fro-usc:hasNoteText "The Fair Credit Reporting Act, referred to in par. (12)(F), is title VI of Pub. L. 90–321 and Tables. , as added by Pub. L. 91–508, title VI , § 601, Oct. 26, 1970 , 84 Stat. 1127 , which is classified generally to subchapter III (§ 1681 et seq.) of chapter 41 of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see Short Title note set out under section 1601 of Title 15" ;
  fro-usc:hasNoteText "The Fair Debt Collection Practices Act, referred to in par. (12)(H), is title VIII of Pub. L. 90–321 and Tables. , as added by Pub. L. 95–109 , Sept. 20, 1977 , 91 Stat. 874 , which is classified generally to subchapter V (§ 1692 et seq.) of chapter 41 of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see Short Title note set out under section 1601 of Title 15" ;
  fro-usc:hasNoteText "The Federal Trade Commission Act, referred to in par. (14), is act Sept. 26, 1914, ch. 311 , 38 Stat. 717 , which is classified generally to subchapter I (§ 41 et seq.) of chapter 2 of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 58 of Title 15 and Tables." ;
  fro-usc:hasNoteText "The Home Mortgage Disclosure Act of 1975, referred to in par. (12)(K), is title III of Pub. L. 94–200 , Dec. 31, 1975 , 89 Stat. 1125 , which is classified principally to chapter 29 (§ 2801 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 2801 of this title and Tables." ;
  fro-usc:hasNoteText "The Home Ownership and Equity Protection Act of 1994, referred to in par. (12)(L), is subtitle B (§§ 151–158) of title I of Pub. L. 103–325 , Sept. 23, 1994 , 108 Stat. 2190 , which enacted sections 1639 and 1648 of Title 15, Commerce and Trade, amended sections 1602, 1604, 1610, 1640, 1641, and 1647 of Title 15, and enacted provisions set out as notes under sections 1601 and 1602 of Title 15. For complete classification of this Act to the Code, see Short Title of 1994 Amendment note set out under section 1601 of Title 15 and Tables." ;
  fro-usc:hasNoteText "The Homeowners Protection Act of 1998, referred to in par. (12)(G), is Pub. L. 105–216 , July 29, 1998 , 112 Stat. 897 , which is classified principally to chapter 49 (§ 4901 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 4901 of this title and Tables." ;
  fro-usc:hasNoteText "The Interstate Land Sales Full Disclosure Act, referred to in par. (12)(R), is title XIV of Pub. L. 90–448 , Aug. 1, 1968 , 82 Stat. 590 , which is classified generally to chapter 42 (§ 1701 et seq.) of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see Short Title note set out under section 1701 of Title 15 and Tables." ;
  fro-usc:hasNoteText "The Investment Advisers Act of 1940, referred to in par. (21)(B), is title II of act Aug. 22, 1940, ch. 686 , 54 Stat. 847 , which is classified generally to subchapter II (§ 80b–1 et seq.) of chapter 2D of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 80b–20 of Title 15 and Tables." ;
  fro-usc:hasNoteText "The Investment Company Act of 1940, referred to in par. (21)(C), is title I of act Aug. 22, 1940, ch. 686 , 54 Stat. 789 , which is classified generally to subchapter I (§ 80a–1 et seq.) of chapter 2D of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 80a–51 of Title 15 and Tables." ;
  fro-usc:hasNoteText "The Real Estate Settlement Procedures Act of 1974, referred to in par. (12)(M), is Pub. L. 93–533 , Dec. 22, 1974 , 88 Stat. 1724 , which is classified principally to chapter 27 (§ 2601 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 2601 of this title and Tables." ;
  fro-usc:hasNoteText "The S.A.F.E. Mortgage Licensing Act of 2008, referred to in par. (12)(N), is title V of div. A of Pub. L. 110–289 , July 30, 2008 , 122 Stat. 2810 , also known as the Secure and Fair Enforcement for Mortgage Licensing Act of 2008, which is classified generally to chapter 51 (§ 5101 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 5101 of this title and Tables." ;
  fro-usc:hasNoteText "The Securities Exchange Act of 1934, referred to in par. (21)(A), (D) to (F), and (K), is act June 6, 1934, ch. 404 , 48 Stat. 881 , which is classified principally to chapter 2B (§ 78a et seq.) of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 78a of Title 15 and Tables." ;
  fro-usc:hasNoteText "The Truth in Lending Act, referred to in par. (12)(O), is title I of Pub. L. 90–321 , May 29, 1968 , 82 Stat. 146 , which is classified generally to subchapter I (§ 1601 et seq.) of chapter 41 of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see Short Title note set out under section 1601 of Title 15 and Tables." ;
  fro-usc:hasNoteText "The Truth in Savings Act, referred to in par. (12)(P), is subtitle F (§§ 261–274) of title II of Pub. L. 102–242 , Dec. 19, 1991 , 105 Stat. 2334 , which is classified generally to chapter 44 (§ 4301 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 4301 of this title and Tables." ;
  fro-usc:hasNoteText "This title, where footnoted in text, is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
