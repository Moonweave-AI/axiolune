  lkif-mereo:component fro-usc-t12-ch53:id83ad789e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad789a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-3-3-3> ;
  fro-usc:hasContentText "intervene in the action as a party;" ;
  fro-usc:hasId "id83ad789a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5552/b/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ad789b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-3-3-4> ;
  fro-usc:hasId "id83ad789b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5552/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-6-3-3-3-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad789c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad789d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad789c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-3-3-4-2> ;
  fro-usc:hasContentText "remove the action to the appropriate United States district court, if the action was not originally brought there; and" ;
  fro-usc:hasId "id83ad789c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5552/b/2/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ad789d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-3-3-4-3> ;
  fro-usc:hasContentText "be heard on all matters arising in the action; and" ;
  fro-usc:hasId "id83ad789d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5552/b/2/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83ad789e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-3-3-5> ;
  fro-usc:hasContentText "appeal any order or judgment, to the same extent as any other party in the proceeding may." ;
  fro-usc:hasId "id83ad789e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5552/b/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ad789f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-4> ;
  fro-usc:hasContentText "The Bureau shall prescribe regulations to implement the requirements of this section and, from time to time, provide guidance in order to further coordinate actions with the State attorneys general and other regulators." ;
  fro-usc:hasHeading "Regulations" ;
  fro-usc:hasId "id83ad789f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5552/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83ad78a0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78a1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78a2-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78a3-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-5> ;
  fro-usc:hasHeading "Preservation of State authority" ;
  fro-usc:hasId "id83ad78a0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5552/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83ad78a1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-5-2> ;
  fro-usc:hasContentText "No provision of this section shall be construed as altering, limiting, or affecting the authority of a State attorney general or any other regulatory or enforcement agency or authority to bring an action or other regulatory proceeding arising solely under the law in effect in that State." ;
  fro-usc:hasHeading "State claims" ;
  fro-usc:hasId "id83ad78a1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5552/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ad78a2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-5-3> ;
  fro-usc:hasContentText "No provision of this title  shall be construed as altering, limiting, or affecting the authority of a State securities commission (or any agency or office performing like functions) under State law to adopt rules, initiate enforcement proceedings, or take any other action with respect to a person regulated by such commission or authority." ;
  fro-usc:hasHeading "State securities regulators" ;
  fro-usc:hasId "id83ad78a2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5552/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ad78a3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-3-5-4> ;
  fro-usc:hasContentText "No provision of this title  shall be construed as altering, limiting, or affecting the authority of a State insurance commission or State insurance regulator under State law to adopt rules, initiate enforcement proceedings, or take any other action with respect to a person regulated by such commission or regulator." ;
  fro-usc:hasHeading "State insurance regulators" ;
  fro-usc:hasId "id83ad78a3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5552/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83ad78a4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "id83ad78a4-1df7-11e6-87ee-8e4a3ab90f2a" ;
