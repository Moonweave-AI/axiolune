  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-8> ;
  fro-usc:hasHeading "Annual audits" ;
  fro-usc:hasId "id83a8bcf0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496a" ;
  fro-usc:hasNumberText "§ 5496a." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bcf3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bcf1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-8-2> ;
  fro-usc:hasContentText "The Bureau shall order an annual independent audit of the operations and budget of the Bureau." ;
  fro-usc:hasHeading "Annual independent audit" ;
  fro-usc:hasId "id83a8bcf1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496a/a" ;
  fro-usc:hasNumberText "(a)" ;
.
