  fro-usc:hasHeading "Agreements against interest of the receiver" ;
  fro-usc:hasId "id839a8cf1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/6" ;
