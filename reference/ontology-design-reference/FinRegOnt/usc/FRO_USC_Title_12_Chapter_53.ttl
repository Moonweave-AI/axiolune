fro-usc-t12-ch53:id83ad78ae-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78af-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78b0-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78b1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78b2-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad78b3-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ad78b6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-2> ;
  fro-usc:hasHeading "Definitions" ;
  fro-usc:hasId "id83ad78ae-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5561" ;
  fro-usc:hasNumberText "§ 5561." ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-7-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78b4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad78af-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-2-3> ;
  fro-usc:hasContentText "The term “Bureau investigation” means any inquiry conducted by a Bureau investigator for the purpose of ascertaining whether any person is or has been engaged in any conduct that is a violation, as defined in this section." ;
  fro-usc:hasHeading "Bureau investigation" ;
  fro-usc:hasId "id83ad78af-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5561/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ad78b0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-2-4> ;
  fro-usc:hasContentText "The term “Bureau investigator” means any attorney or investigator employed by the Bureau who is charged with the duty of enforcing or carrying into effect any Federal consumer financial law." ;
  fro-usc:hasHeading "Bureau investigator" ;
  fro-usc:hasId "id83ad78b0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5561/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ad78b1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-2-5> ;
  fro-usc:hasContentText "The term “custodian” means the custodian or any deputy custodian designated by the Bureau." ;
  fro-usc:hasHeading "Custodian" ;
  fro-usc:hasId "id83ad78b1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5561/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83ad78b2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-2-6> ;
  fro-usc:hasContentText "The term “documentary material” includes the original or any copy of any book, document, record, report, memorandum, paper, communication, tabulation, chart, logs, electronic files, or other data or data compilations stored in any medium." ;
  fro-usc:hasHeading "Documentary material" ;
  fro-usc:hasId "id83ad78b2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5561/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83ad78b3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-2-7> ;
  fro-usc:hasContentText "The term “violation” means any act or omission that, if proved, would constitute a violation of any provision of Federal consumer financial law." ;
  fro-usc:hasHeading "Violation" ;
  fro-usc:hasId "id83ad78b3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5561/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83ad78b4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-usc:hasId "id83ad78b4-1df7-11e6-87ee-8e4a3ab90f2a" ;
