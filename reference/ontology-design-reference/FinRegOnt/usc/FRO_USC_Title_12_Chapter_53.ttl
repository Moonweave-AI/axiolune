  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-4-3-3-4> ;
  fro-usc:hasContentText "discourage and reduce cases of misleading or fraudulent marketing; and" ;
  fro-usc:hasId "id83ad7842-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/c/1/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
