  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-3-3-11> ;
  fro-usc:hasContentText "the Chairman of the National Credit Union Administration Board; and" ;
  fro-usc:hasId "id83936077-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/b/1/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83936078-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-3-3-12> ;
  fro-usc:hasContentText "an independent member appointed by the President, by and with the advice and consent of the Senate, having insurance expertise." ;
  fro-usc:hasId "id83936078-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/b/1/J" ;
  fro-usc:hasNumberText "(J)" ;
.
fro-usc-t12-ch53:id83936079-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-3-4> ;
  fro-usc:hasHeading "Nonvoting members" ;
  fro-usc:hasId "id83936079-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-2-3-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id8393607a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393607b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393607c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393607d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393607e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8393607a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-3-4-3> ;
  fro-usc:hasContentText "the Director of the Office of Financial Research;" ;
  fro-usc:hasId "id8393607a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/b/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8393607b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-3-4-4> ;
  fro-usc:hasContentText "the Director of the Federal Insurance Office;" ;
  fro-usc:hasId "id8393607b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8393607c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-3-4-5> ;
  fro-usc:hasContentText "a State insurance commissioner, to be designated by a selection process determined by the State insurance commissioners;" ;
  fro-usc:hasId "id8393607c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/b/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id8393607d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-3-4-6> ;
  fro-usc:hasContentText "a State banking supervisor, to be designated by a selection process determined by the State banking supervisors; and" ;
  fro-usc:hasId "id8393607d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/b/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id8393607e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-3-4-7> ;
  fro-usc:hasContentText "a State securities commissioner (or an officer performing like functions), to be designated by a selection process determined by such State securities commissioners." ;
  fro-usc:hasId "id8393607e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/b/2/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id8393607f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-3-5> ;
  fro-usc:hasContentText "The nonvoting members of the Council shall not be excluded from any of the proceedings, meetings, discussions, or deliberations of the Council, except that the Chairperson may, upon an affirmative vote of the member agencies, exclude the nonvoting members from any of the proceedings, meetings, discussions, or deliberations of the Council when necessary to safeguard and promote the free exchange of confidential supervisory information." ;
  fro-usc:hasHeading "Nonvoting member participation" ;
  fro-usc:hasId "id8393607f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83936080-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936081-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936082-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936083-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-4> ;
  fro-usc:hasHeading "Terms; vacancy" ;
  fro-usc:hasId "id83936080-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83936081-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-4-2> ;
  fro-usc:hasContentText "The independent member of the Council shall serve for a term of 6 years, and each nonvoting member described in subparagraphs (C), (D), and (E) of subsection (b)(2) shall serve for a term of 2 years." ;
  fro-usc:hasHeading "Terms" ;
  fro-usc:hasId "id83936081-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83936082-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-4-3> ;
  fro-usc:hasContentText "Any vacancy on the Council shall be filled in the manner in which the original appointment was made." ;
  fro-usc:hasHeading "Vacancy" ;
  fro-usc:hasId "id83936082-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83936083-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-4-4> ;
  fro-usc:hasContentText "In the event of a vacancy in the office of the head of a member agency or department, and pending the appointment of a successor, or during the absence or disability of the head of a member agency or department, the acting head of the member agency or department shall serve as a member of the Council in the place of that agency or department head." ;
  fro-usc:hasHeading "Acting officials may serve" ;
  fro-usc:hasId "id83936083-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/c/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83936084-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-5> ;
  fro-usc:hasContentText "The Council may appoint such special advisory, technical, or professional committees as may be useful in carrying out the functions of the Council, including an advisory committee consisting of State regulators, and the members of such committees may be members of the Council, or other persons, or both." ;
  fro-usc:hasHeading "Technical and professional advisory committees" ;
  fro-usc:hasId "id83936084-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83936085-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936086-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936087-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-6> ;
  fro-usc:hasHeading "Meetings" ;
  fro-usc:hasId "id83936085-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83936086-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-6-2> ;
  fro-usc:hasContentText "The Council shall meet at the call of the Chairperson or a majority of the members then serving, but not less frequently than quarterly." ;
  fro-usc:hasHeading "Timing" ;
  fro-usc:hasId "id83936086-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83936087-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-6-3> ;
  fro-usc:hasContentText "The Council shall adopt such rules as may be necessary for the conduct of the business of the Council. Such rules shall be rules of agency organization, procedure, or practice for purposes of section 553 of title 5 ." ;
  fro-usc:hasHeading "Rules for conducting business" ;
  fro-usc:hasId "id83936087-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/e/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s553" ;
.
fro-usc-t12-ch53:id83936088-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-7> ;
  fro-usc:hasContentText "Unless otherwise specified, the Council shall make all decisions that it is authorized or required to make by a majority vote of the voting members then serving." ;
  fro-usc:hasHeading "Voting" ;
  fro-usc:hasId "id83936088-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83936089-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-8> ;
  fro-usc:hasContentText "The Federal Advisory Committee Act (5 U.S.C. App.) shall not apply to the Council, or to any special advisory, technical, or professional committee appointed by the Council, except that, if an advisory, technical, or professional committee has one or more members who are not employees of or affiliated with the United States Government, the Council shall publish a list of the names of the members of such committee." ;
  fro-usc:hasHeading "Nonapplicability of FACA" ;
  fro-usc:hasId "id83936089-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id8393608a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-9> ;
  fro-usc:hasContentText "Any department or agency of the United States may provide to the Council and any special advisory, technical, or professional committee appointed by the Council, such services, funds, facilities, staff, and other support services as the Council may determine advisable." ;
  fro-usc:hasHeading "Assistance from Federal agencies" ;
  fro-usc:hasId "id8393608a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/h" ;
  fro-usc:hasNumberText "(h)" ;
.
fro-usc-t12-ch53:id8393608b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8393608c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8393608d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-10> ;
  fro-usc:hasHeading "Compensation of members" ;
  fro-usc:hasId "id8393608b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id8393608c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-10-2> ;
  fro-usc:hasContentText "All members of the Council who are officers or employees of the United States shall serve without compensation in addition to that received for their services as officers or employees of the United States." ;
  fro-usc:hasHeading "Federal employee members" ;
  fro-usc:hasId "id8393608c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/i/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8393608d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-10-3> ;
  fro-usc:hasHeading "Omitted" ;
  fro-usc:hasId "id8393608d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/i/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8393608e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-11> ;
  fro-usc:hasContentText "Any employee of the Federal Government may be detailed to the Council without reimbursement, and such detail shall be without interruption or loss of civil service status or privilege. An employee of the Federal Government detailed to the Council shall report to and be subject to oversight by the Council during the assignment to the Council, and shall be compensated by the department or agency from which the employee was detailed." ;
  fro-usc:hasHeading "Detail of Government employees" ;
  fro-usc:hasId "id8393608e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5321/j" ;
  fro-usc:hasNumberText "(j)" ;
.
fro-usc-t12-ch53:id8393608f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-usc:hasId "id8393608f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1392" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 111, July 21, 2010 , 124 Stat. 1392 .)" ;
.
fro-usc-t12-ch53:id83936091-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-13-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83936091-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Federal Advisory Committee Act, referred to in subsec. (g), is Pub. L. 92–463 , Oct. 6, 1972 , 86 Stat. 770 , which is set out in the Appendix to Title 5, Government Organization and Employees." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/92/463" ;
  fro-usc:hasReferenceText "/us/stat/86/770" ;
.
fro-usc-t12-ch53:id83936092-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-2-13-1> ;
  fro-usc:hasHeading "Codification" ;
  fro-usc:hasId "id83936092-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section is comprised of section 111 of Pub. L. 111–203 . Subsec. (i)(2) of section 111 of Pub. L. 111–203 amended section 5314 of Title 5 , Government Organization and Employees." ;
  fro-usc:hasNoteTopic "codification" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s111" ;
  fro-usc:hasReferenceText "/us/usc/t5/s5314" ;
.
fro-usc-t12-ch53:id83936093-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936094-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360b3-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360b6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839360b9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id839360c9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3> ;
  fro-usc:hasHeading "Council authority" ;
  fro-usc:hasId "id83936093-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322" ;
  fro-usc:hasNumberText "§ 5322." ;
  lkif-mereo:component fro-usc-t12-ch53:id839360c7-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83936094-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936095-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83936099-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2> ;
  fro-usc:hasHeading "Purposes and duties of the Council" ;
  fro-usc:hasId "id83936094-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83936095-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83936095-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-3-2-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83936096-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83936097-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83936098-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83936096-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-2-3> ;
  fro-usc:hasContentText "to identify risks to the financial stability of the United States that could arise from the material financial distress or failure, or ongoing activities, of large, interconnected bank holding companies or nonbank financial companies, or that could arise outside the financial services marketplace;" ;
  fro-usc:hasId "id83936096-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83936097-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-2-4> ;
  fro-usc:hasContentText "to promote market discipline, by eliminating expectations on the part of shareholders, creditors, and counterparties of such companies that the Government will shield them from losses in the event of failure; and" ;
  fro-usc:hasId "id83936097-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83936098-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-2-5> ;
  fro-usc:hasContentText "to respond to emerging threats to the stability of the United States financial system." ;
  fro-usc:hasId "id83936098-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83936099-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3> ;
  fro-usc:hasHeading "Duties" ;
  fro-usc:hasId "id83936099-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-3-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id8393609a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393609b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393609c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393609d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393609e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8393609f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360a0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360a1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360a2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360a3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360a4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360a5-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360a6-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360a9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8393609a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-3> ;
  fro-usc:hasContentText "collect information from member agencies, other Federal and State financial regulatory agencies, the Federal Insurance Office and, if necessary to assess risks to the United States financial system, direct the Office of Financial Research to collect information from bank holding companies and nonbank financial companies;" ;
  fro-usc:hasId "id8393609a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8393609b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-4> ;
  fro-usc:hasContentText "provide direction to, and request data and analyses from, the Office of Financial Research to support the work of the Council;" ;
  fro-usc:hasId "id8393609b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8393609c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-5> ;
  fro-usc:hasContentText "monitor the financial services marketplace in order to identify potential threats to the financial stability of the United States;" ;
  fro-usc:hasId "id8393609c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id8393609d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-6> ;
  fro-usc:hasContentText "to  1 monitor domestic and international financial regulatory proposals and developments, including insurance and accounting issues, and to advise Congress and make recommendations in such areas that will enhance the integrity, efficiency, competitiveness, and stability of the U.S. financial markets;" ;
  fro-usc:hasId "id8393609d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id8393609e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-7> ;
  fro-usc:hasContentText "facilitate information sharing and coordination among the member agencies and other Federal and State agencies regarding domestic financial services policy development, rulemaking, examinations, reporting requirements, and enforcement actions;" ;
  fro-usc:hasId "id8393609e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id8393609f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-8> ;
  fro-usc:hasContentText "recommend to the member agencies general supervisory priorities and principles reflecting the outcome of discussions among the member agencies;" ;
  fro-usc:hasId "id8393609f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id839360a0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-9> ;
  fro-usc:hasContentText "identify gaps in regulation that could pose risks to the financial stability of the United States;" ;
  fro-usc:hasId "id839360a0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/G" ;
  fro-usc:hasNumberText "(G)" ;
.
fro-usc-t12-ch53:id839360a1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-10> ;
  fro-usc:hasContentText "require supervision by the Board of Governors for nonbank financial companies that may pose risks to the financial stability of the United States in the event of their material financial distress or failure, or because of their activities pursuant to section 5323 of this title ;" ;
  fro-usc:hasId "id839360a1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/H" ;
  fro-usc:hasNumberText "(H)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5323" ;
.
fro-usc-t12-ch53:id839360a2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-11> ;
  fro-usc:hasContentText "make recommendations to the Board of Governors concerning the establishment of heightened prudential standards for risk-based capital, leverage, liquidity, contingent capital, resolution plans and credit exposure reports, concentration limits, enhanced public disclosures, and overall risk management for nonbank financial companies and large, interconnected bank holding companies supervised by the Board of Governors;" ;
  fro-usc:hasId "id839360a2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839360a3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-12> ;
  fro-usc:hasContentText "identify systemically important financial market utilities and payment, clearing, and settlement activities (as that term is defined in subchapter IV);" ;
  fro-usc:hasId "id839360a3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/J" ;
  fro-usc:hasNumberText "(J)" ;
.
fro-usc-t12-ch53:id839360a4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-13> ;
  fro-usc:hasContentText "make recommendations to primary financial regulatory agencies to apply new or heightened standards and safeguards for financial activities or practices that could create or increase risks of significant liquidity, credit, or other problems spreading among bank holding companies, nonbank financial companies, and United States financial markets;" ;
  fro-usc:hasId "id839360a4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/K" ;
  fro-usc:hasNumberText "(K)" ;
.
fro-usc-t12-ch53:id839360a5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-14> ;
  fro-usc:hasContentText "review and, as appropriate, may submit comments to the Commission and any standard-setting body with respect to an existing or proposed accounting principle, standard, or procedure;" ;
  fro-usc:hasId "id839360a5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/L" ;
  fro-usc:hasNumberText "(L)" ;
.
fro-usc-t12-ch53:id839360a6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-15> ;
  fro-usc:hasId "id839360a6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/M" ;
  fro-usc:hasNumberText "(M)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-3-2-3-15-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839360a7-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360a8-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839360a7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-15-2> ;
  fro-usc:hasContentText "discussion and analysis of emerging market developments and financial regulatory issues; and" ;
  fro-usc:hasId "id839360a7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/M/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839360a8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-15-3> ;
  fro-usc:hasContentText "resolution of jurisdictional disputes among the members of the Council; and" ;
  fro-usc:hasId "id839360a8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/M/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839360a9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-2-3-16> ;
  fro-usc:hasId "id839360a9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/a/2/N" ;
  fro-usc:hasNumberText "(N)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-3-2-3-16-1> ;
