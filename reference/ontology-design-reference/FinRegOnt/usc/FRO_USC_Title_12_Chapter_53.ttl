  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-5-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4737-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4738-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4737-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-5-4-3> ;
  fro-usc:hasContentText "equal to the amount that such customer would have received with respect to such customer property in a case initiated by SIPC under the Securities Investor Protection Act of 1970 ( 15 U.S.C. 78aaa et seq.); and" ;
  fro-usc:hasId "id839f4737-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/d/3/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78aaa" ;
.
fro-usc-t12-ch53:id839f4738-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-5-4-4> ;
  fro-usc:hasContentText "determined as of the close of business on the date on which the Corporation is appointed as receiver." ;
  fro-usc:hasId "id839f4738-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/d/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
