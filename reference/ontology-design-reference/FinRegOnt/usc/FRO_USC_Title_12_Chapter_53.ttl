.
fro-usc-t12-ch53:id839a8cf3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-7-4> ;
  fro-usc:hasContentText "was executed by an authorized officer or representative of the covered financial company, or confirmed in the ordinary course of business by the covered financial company; and" ;
  fro-usc:hasId "id839a8cf3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8cf4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-7-5> ;
  fro-usc:hasContentText "has been, since the time of its execution, an official record of the company or the party claiming under the agreement provides documentation, acceptable to the receiver, of such agreement and its authorized execution or confirmation by the covered financial company." ;
  fro-usc:hasId "id839a8cf4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/6/C" ;
  fro-usc:hasNumberText "(C)" ;
.
