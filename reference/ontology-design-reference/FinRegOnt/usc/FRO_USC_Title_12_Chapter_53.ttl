  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-6> ;
  fro-usc:hasHeading "Study of bankruptcy and orderly liquidation process for financial companies" ;
  fro-usc:hasId "id83981bcf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/e" ;
