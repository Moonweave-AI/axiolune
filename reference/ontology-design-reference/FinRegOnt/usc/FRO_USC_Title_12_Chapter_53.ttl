  fro-usc:hasContentText "making the results of the activities of the Office available to financial regulatory agencies; and" ;
  fro-usc:hasId "id8395aad7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/a/6" ;
