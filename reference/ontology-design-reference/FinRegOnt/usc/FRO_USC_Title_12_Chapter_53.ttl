  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-8-4> ;
  fro-usc:hasContentText "The term “agency administrator” means the head of an agency." ;
  fro-usc:hasHeading "Agency administrator" ;
  fro-usc:hasId "id83a40283-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/g/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a40284-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-8-5> ;
  fro-usc:hasContentText "The term “minority” has the same meaning as in section 1204(c) of the Financial Institutions Reform, Recovery, and Enforcement Act of 1989 ( 12 U.S.C. 1811 note)." ;
  fro-usc:hasHeading "Minority" ;
  fro-usc:hasId "id83a40284-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/g/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1811" ;
.
fro-usc-t12-ch53:id83a40285-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-8-6> ;
  fro-usc:hasContentText "The term “minority-owned business” has the same meaning as in section 1441a(r)(4)(A) of this title , as in effect on the day before the transfer date." ;
  fro-usc:hasHeading "Minority-owned business" ;
  fro-usc:hasId "id83a40285-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/g/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1441a/r/4/A" ;
.
fro-usc-t12-ch53:id83a40286-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-8-7> ;
  fro-usc:hasContentText "The term “Office” means the Office of Minority and Women Inclusion established by an agency under subsection (a)." ;
  fro-usc:hasHeading "Office" ;
  fro-usc:hasId "id83a40286-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/g/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83a40287-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-8-8> ;
  fro-usc:hasContentText "The term “women-owned business” has the meaning given the term “women’s business” in section 1441a(r)(4)(B) of this title , as in effect on the day before the transfer date." ;
  fro-usc:hasHeading "Women-owned business" ;
  fro-usc:hasId "id83a40287-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/g/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1441a/r/4/B" ;
.
