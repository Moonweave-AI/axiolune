.
fro-usc-t12-ch53:id839360ba-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839360ba-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-3-5-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839360bb-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360bc-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839360bb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-2-3> ;
  fro-usc:hasContentText "to monitor the financial services marketplace to identify potential risks to the financial stability of the United States; or" ;
  fro-usc:hasId "id839360bb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839360bc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-2-4> ;
  fro-usc:hasContentText "to otherwise carry out any of the provisions of this subchapter." ;
  fro-usc:hasId "id839360bc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839360bd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-3> ;
  fro-usc:hasContentText "Notwithstanding any other provision of law, the Office of Financial Research, any member agency, and the Federal Insurance Office, are authorized to submit information to the Council." ;
  fro-usc:hasHeading "Submissions by the office and member agencies" ;
  fro-usc:hasId "id839360bd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839360be-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-4> ;
  fro-usc:hasHeading "Financial data collection" ;
  fro-usc:hasId "id839360be-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839360bf-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360c0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360c1-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839360bf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-4-2> ;
  fro-usc:hasContentText "The Council, acting through the Office of Financial Research, may require the submission of periodic and other reports from any nonbank financial company or bank holding company for the purpose of assessing the extent to which a financial activity or financial market in which the nonbank financial company or bank holding company participates, or the nonbank financial company or bank holding company itself, poses a threat to the financial stability of the United States." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839360bf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839360c0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-4-3> ;
  fro-usc:hasContentText "Before requiring the submission of reports from any nonbank financial company or bank holding company that is regulated by a member agency or any primary financial regulatory agency, the Council, acting through the Office of Financial Research, shall coordinate with such agencies and shall, whenever possible, rely on information available from the Office of Financial Research or such agencies." ;
  fro-usc:hasHeading "Mitigation of report burden" ;
  fro-usc:hasId "id839360c0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839360c1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-4-4> ;
  fro-usc:hasContentText "Before requiring the submission of reports from a company that is a foreign nonbank financial company or foreign-based bank holding company, the Council shall, acting through the Office of Financial Research, to the extent appropriate, consult with the appropriate foreign regulator of such company and, whenever possible, rely on information already being collected by such foreign regulator, with English translation." ;
  fro-usc:hasHeading "Mitigation in case of foreign financial companies" ;
  fro-usc:hasId "id839360c1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839360c2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-5> ;
  fro-usc:hasContentText "If the Council is unable to determine whether the financial activities of a U.S. nonbank financial company pose a threat to the financial stability of the United States, based on information or reports obtained under paragraphs (1) and (3), discussions with management, and publicly available information, the Council may request the Board of Governors, and the Board of Governors is authorized, to conduct an examination of the U.S. nonbank financial company for the sole purpose of determining whether the nonbank financial company should be supervised by the Board of Governors for purposes of this subchapter." ;
  fro-usc:hasHeading "Back-up examination by the Board of Governors" ;
  fro-usc:hasId "id839360c2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id839360c3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-6> ;
  fro-usc:hasHeading "Confidentiality" ;
  fro-usc:hasId "id839360c3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/5" ;
  fro-usc:hasNumberText "(5)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839360c4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360c5-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839360c6-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839360c4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-6-2> ;
  fro-usc:hasContentText "The Council, the Office of Financial Research, and the other member agencies shall maintain the confidentiality of any data, information, and reports submitted under this subchapter." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839360c4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/5/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839360c5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-6-3> ;
  fro-usc:hasContentText "The submission of any nonpublicly available data or information under this subsection and part B shall not constitute a waiver of, or otherwise affect, any privilege arising under Federal or State law (including the rules of any Federal or State court) to which the data or information is otherwise subject." ;
  fro-usc:hasHeading "Retention of privilege" ;
  fro-usc:hasId "id839360c5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839360c6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-5-6-4> ;
  fro-usc:hasContentText "Section 552 of title 5 , including the exceptions thereunder, shall apply to any data or information submitted under this subsection and part B." ;
  fro-usc:hasHeading "Freedom of Information Act" ;
  fro-usc:hasId "id839360c6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5322/d/5/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s552" ;
.
fro-usc-t12-ch53:id839360c7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "id839360c7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1394" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 112, July 21, 2010 , 124 Stat. 1394 .)" ;
.
fro-usc-t12-ch53:id839360c9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-3-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id839360c9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This subchapter, referred to in subsecs. (a)(2) and (d)(1)(B), (4), (5)(A), was in the original “this title”, meaning title I of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1391 , which is classified principally to this subchapter. For complete classification of title I to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1391" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
