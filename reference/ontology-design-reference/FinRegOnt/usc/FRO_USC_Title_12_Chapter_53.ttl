  lkif-mereo:component fro-usc-t12-ch53:id83ab2ebb-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2eb7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-10-7-3-3> ;
  fro-usc:hasContentText "any self-propelled vehicle designed for transporting persons or property on a street, highway, or other road;" ;
  fro-usc:hasId "id83ab2eb7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5519/f/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ab2eb8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-10-7-3-4> ;
  fro-usc:hasContentText "recreational boats and marine equipment;" ;
  fro-usc:hasId "id83ab2eb8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5519/f/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ab2eb9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-10-7-3-5> ;
  fro-usc:hasContentText "motorcycles;" ;
  fro-usc:hasId "id83ab2eb9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5519/f/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ab2eba-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-10-7-3-6> ;
  fro-usc:hasContentText "motor homes, recreational vehicle trailers, and slide-in campers, as those terms are defined in sections 571.3 and 575.103 (d) of title 49, Code of Federal Regulations, or any successor thereto; and" ;
  fro-usc:hasId "id83ab2eba-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5519/f/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
