  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-10-2-2-3> ;
  fro-usc:hasHeading "Employer’s contribution" ;
  fro-usc:hasId "id83a191f5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/i/1/A/ii" ;
