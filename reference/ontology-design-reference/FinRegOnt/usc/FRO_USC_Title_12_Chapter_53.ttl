  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-5-5> ;
  fro-usc:hasContentText "identify the custodian to whom such things shall be submitted." ;
  fro-usc:hasId "id83ad78ce-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/4/C" ;
  fro-usc:hasNumberText "(C)" ;
.
