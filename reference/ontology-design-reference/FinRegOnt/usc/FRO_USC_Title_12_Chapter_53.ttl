  fro-usc:hasReferenceText "/us/stat/124/2003" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1028, July 21, 2010 , 124 Stat. 2003 .)" ;
.
fro-usc-t12-ch53:id83ab2ea5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-9-7-0> ;
