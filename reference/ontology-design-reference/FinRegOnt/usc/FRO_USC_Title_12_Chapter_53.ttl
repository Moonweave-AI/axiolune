  fro-usc:hasContentText "full descriptions of the ownership structure, assets, liabilities, and contractual obligations of the company;" ;
  fro-usc:hasId "id8395aba3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5365/d/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8395aba4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
