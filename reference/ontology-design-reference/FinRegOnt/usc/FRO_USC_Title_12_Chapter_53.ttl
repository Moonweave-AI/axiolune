  fro-usc:hasContentText "the successes achieved and challenges faced by the agency in operating minority and women outreach programs;" ;
  fro-usc:hasId "id83a4026e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a4026f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-3-6-6> ;
  fro-usc:hasContentText "the challenges the agency may face in hiring qualified minority and women employees and contracting with qualified minority-owned and women-owned businesses; and" ;
  fro-usc:hasId "id83a4026f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/e/4" ;
