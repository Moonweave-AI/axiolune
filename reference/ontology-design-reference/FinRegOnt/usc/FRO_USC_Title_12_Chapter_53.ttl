  fro-usc:hasHeading "Contracts for the sale of real property" ;
  fro-usc:hasId "id839cd698-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6" ;
  fro-usc:hasNumberText "(6)" ;
