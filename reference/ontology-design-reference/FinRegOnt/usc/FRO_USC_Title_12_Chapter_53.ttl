  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a67361-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a67362-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-2> ;
  fro-usc:hasHeading "Examination" ;
  fro-usc:hasId "id83a6735d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-8-2-2> ;
.
fro-usc-t12-ch53:id83a6735e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-2-3> ;
  fro-usc:hasContentText "The nature and scope of the designated activities engaged in by the financial institution." ;
  fro-usc:hasId "id83a6735e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a6735f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-2-4> ;
  fro-usc:hasContentText "The financial and operational risks the designated activities engaged in by the financial institution may pose to the safety and soundness of the financial institution." ;
  fro-usc:hasId "id83a6735f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a67360-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-2-5> ;
  fro-usc:hasContentText "The financial and operational risks the designated activities engaged in by the financial institution may pose to other financial institutions, critical markets, or the broader financial system." ;
  fro-usc:hasId "id83a67360-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a67361-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-2-6> ;
  fro-usc:hasContentText "The resources available to and the capabilities of the financial institution to monitor and control the risks described in paragraphs (2) and (3)." ;
  fro-usc:hasId "id83a67361-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a67362-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-2-7> ;
  fro-usc:hasContentText "The financial institution’s compliance with this subchapter and the rules and orders prescribed under section 5464(a) of this title ." ;
  fro-usc:hasId "id83a67362-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/a/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5464/a" ;
.
fro-usc-t12-ch53:id83a67363-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-3> ;
  fro-usc:hasContentText "For purposes of enforcing the provisions of this subchapter, and the rules and orders prescribed under this section, a financial institution subject to the standards prescribed under section 5464(a) of this title for a designated activity shall be subject to, and the appropriate financial regulator shall have authority under  1 the provisions of subsections (b) through (n) of section 1818 of this title in the same manner and to the same extent as if the financial institution was an insured depository institution and the appropriate financial regulator was the appropriate Federal banking agency for such insured depository institution." ;
  fro-usc:hasHeading "Enforcement" ;
  fro-usc:hasId "id83a67363-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1818" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5464/a" ;
.
fro-usc-t12-ch53:id83a67364-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-8-4> ;
  fro-usc:hasContentText "The Board of Governors shall consult with and provide such technical assistance as may be required by the appropriate financial regulators to ensure that the rules and orders prescribed under this subchapter are interpreted and applied in as consistent and uniform a manner as practicable." ;
  fro-usc:hasHeading "Technical assistance" ;
  fro-usc:hasId "id83a67364-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5467/c" ;
  fro-usc:hasNumberText "(c)" ;
.
