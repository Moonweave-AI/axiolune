  fro-usc:hasHeading "Identification of rules and orders continued" ;
  fro-usc:hasId "id83b25a10-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-8-4-10-2> ;
.
fro-usc-t12-ch53:id83b25a11-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-10-3> ;
  fro-usc:hasContentText "shall, after consultation with the head of each transferor agency, identify the rules and orders that will be enforced by the Bureau; and" ;
  fro-usc:hasId "id83b25a11-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/i/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25a12-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-10-4> ;
  fro-usc:hasContentText "shall publish a list of such rules and orders in the Federal Register." ;
  fro-usc:hasId "id83b25a12-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/i/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25a13-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a14-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25a15-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-11> ;
  fro-usc:hasHeading "Status of rules proposed or not yet effective" ;
  fro-usc:hasId "id83b25a13-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/j" ;
  fro-usc:hasNumberText "(j)" ;
.
fro-usc-t12-ch53:id83b25a14-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-11-2> ;
  fro-usc:hasContentText "Any proposed rule of a transferor agency which that agency, in performing consumer financial protection functions transferred by this title, has proposed before the designated transfer date, but has not been published as a final rule before that date, shall be deemed to be a proposed rule of the Bureau." ;
  fro-usc:hasHeading "Proposed rules" ;
  fro-usc:hasId "id83b25a14-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/j/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25a15-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-4-11-3> ;
  fro-usc:hasContentText "Any interim or final rule of a transferor agency which that agency, in performing consumer financial protection functions transferred by this title, has published before the designated transfer date, but which has not become effective before that date, shall become effective as a rule of the Bureau according to its terms." ;
  fro-usc:hasHeading "Rules not yet effective" ;
  fro-usc:hasId "id83b25a15-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5583/j/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25a16-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-usc:hasId "id83b25a16-1df7-11e6-87ee-8e4a3ab90f2a" ;
