  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-10-7-3-7> ;
  fro-usc:hasContentText "other vehicles that are titled and sold through dealers." ;
  fro-usc:hasId "id83ab2ebb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5519/f/1/E" ;
