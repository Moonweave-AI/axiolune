  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-8> ;
  fro-usc:hasContentText "A State or eligible entity that receives a grant under this section may reapply for a grant under this section, notwithstanding the limitations on grant amounts under subsection (e)." ;
  fro-usc:hasHeading "Reapplication" ;
  fro-usc:hasId "id83ad7851-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id83ad7852-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-8-9> ;
  fro-usc:hasContentText "There are authorized to be appropriated to carry out this section, $8,000,000 for each of fiscal years 2011 through 2015." ;
  fro-usc:hasHeading "Authorization of appropriations" ;
  fro-usc:hasId "id83ad7852-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5537/h" ;
  fro-usc:hasNumberText "(h)" ;
.
