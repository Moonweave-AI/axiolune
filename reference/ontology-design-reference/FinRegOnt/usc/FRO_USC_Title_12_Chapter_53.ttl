  fro-usc:hasContentText "a broker or dealer, as defined in section 3 of the Securities Exchange Act of 1934 ( 15 U.S.C. 78c );" ;
  fro-usc:hasId "id83a402af-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/5/A/v" ;
