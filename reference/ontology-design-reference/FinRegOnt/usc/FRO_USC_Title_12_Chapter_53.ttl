.
fro-usc-t12-ch53:id839cd63e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-2-5-2> ;
  fro-usc:hasContentText "after the 90-day period preceding the date on which the Corporation was appointed as receiver for the covered financial company;" ;
  fro-usc:hasId "id839cd63e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/A/iii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd63f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-2-5-3> ;
  fro-usc:hasContentText "while the covered financial company was insolvent; and" ;
  fro-usc:hasId "id839cd63f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/A/iii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd640-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-2-5-4> ;
  fro-usc:hasContentText "for the purpose of obtaining a right of setoff against the covered financial company (except for a setoff in connection with a qualified financial contract)." ;
  fro-usc:hasId "id839cd640-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/A/iii/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839cd641-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-3> ;
  fro-usc:hasHeading "Insufficiency" ;
  fro-usc:hasId "id839cd641-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/B" ;
  fro-usc:hasNumberText "(B)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd642-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd645-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd642-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-3-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839cd642-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/B/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-13-3-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd643-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd644-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd643-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-3-2-3> ;
  fro-usc:hasContentText "the date that is 90 days before the date on which the Corporation is appointed as receiver for the covered financial company; or" ;
  fro-usc:hasId "id839cd643-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/B/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd644-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-3-2-4> ;
  fro-usc:hasContentText "the first day on which there is an insufficiency during the 90-day period preceding the date on which the Corporation is appointed as receiver for the covered financial company." ;
  fro-usc:hasId "id839cd644-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/B/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd645-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-3-3> ;
  fro-usc:hasHeading "Definition of insufficiency" ;
  fro-usc:hasId "id839cd645-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd646-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-4> ;
  fro-usc:hasContentText "The term “insolvent” has the same meaning as in section 101(32) of the Bankruptcy Code." ;
  fro-usc:hasHeading "Insolvency" ;
  fro-usc:hasId "id839cd646-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839cd647-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-5> ;
  fro-usc:hasContentText "For purposes of this paragraph, the covered financial company is presumed to have been insolvent on and during the 90-day period preceding the date of appointment of the Corporation as receiver." ;
  fro-usc:hasHeading "Presumption of insolvency" ;
  fro-usc:hasId "id839cd647-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839cd648-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-6> ;
  fro-usc:hasContentText "Nothing in this paragraph (12) shall be the basis for any right of setoff where no such right exists under applicable noninsolvency law." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id839cd648-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id839cd649-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-7> ;
  fro-usc:hasContentText "Except as otherwise provided in this subchapter, the Corporation as receiver for the covered financial company may sell or transfer any assets free and clear of the setoff rights of any party, except that such party shall be entitled to a claim, subordinate to the claims payable under subparagraphs (A), (B), (C), and (D) of subsection (b)(1), but senior to all other unsecured liabilities defined in subsection (b)(1)(E), in an amount equal to the value of such setoff rights." ;
  fro-usc:hasHeading "Priority claim" ;
  fro-usc:hasId "id839cd649-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id839cd64a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-14> ;
  fro-usc:hasContentText "Subject to paragraph (14), any court of competent jurisdiction may, at the request of the Corporation as receiver for a covered financial company, issue an order in accordance with Rule 65 of the Federal Rules of Civil Procedure, including an order placing the assets of any person designated by the Corporation under the control of the court and appointing a trustee to hold such assets." ;
  fro-usc:hasHeading "Attachment of assets and other injunctive relief" ;
  fro-usc:hasId "id839cd64a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/13" ;
  fro-usc:hasNumberText "(13)" ;
.
fro-usc-t12-ch53:id839cd64b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-15> ;
  fro-usc:hasHeading "Standards" ;
  fro-usc:hasId "id839cd64b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/14" ;
  fro-usc:hasNumberText "(14)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd64c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd64d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd64c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-15-2> ;
  fro-usc:hasContentText "Rule 65 of the Federal Rules of Civil Procedure shall apply with respect to any proceeding under paragraph (13), without regard to the requirement that the applicant show that the injury, loss, or damage is irreparable and immediate." ;
  fro-usc:hasHeading "Showing" ;
  fro-usc:hasId "id839cd64c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/14/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839cd64d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-15-3> ;
  fro-usc:hasContentText "If, in the case of any proceeding in a State court, the court determines that rules of civil procedure available under the laws of the State provide substantially similar protections of the right of the parties to due process as provided under Rule 65 (as modified with respect to such proceeding by subparagraph (A)), the relief sought by the Corporation pursuant to paragraph (14) may be requested under the laws of such State." ;
  fro-usc:hasHeading "State proceeding" ;
  fro-usc:hasId "id839cd64d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/14/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839cd64e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-16> ;
  fro-usc:hasContentText "Notwithstanding any other provision of this subchapter, any final and non-appealable judgment for monetary damages entered against the Corporation as receiver for a covered financial company for the breach of an agreement executed or approved by the Corporation after the date of its appointment shall be paid as an administrative expense of the receiver. Nothing in this paragraph shall be construed to limit the power of a receiver to exercise any rights under contract or law, including to terminate, breach, cancel, or otherwise discontinue such agreement." ;
  fro-usc:hasHeading "Treatment of claims arising from breach of contracts executed by the Corporation as receiver" ;
  fro-usc:hasId "id839cd64e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/15" ;
  fro-usc:hasNumberText "(15)" ;
.
fro-usc-t12-ch53:id839cd64f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-17> ;
  fro-usc:hasHeading "Accounting and recordkeeping requirements" ;
  fro-usc:hasId "id839cd64f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/16" ;
  fro-usc:hasNumberText "(16)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd650-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd651-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd652-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd653-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd650-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-17-2> ;
  fro-usc:hasContentText "The Corporation as receiver for a covered financial company shall, consistent with the accounting and reporting practices and procedures established by the Corporation, maintain a full accounting of each receivership or other disposition of any covered financial company." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839cd650-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/16/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839cd651-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-17-3> ;
  fro-usc:hasContentText "With respect to each receivership to which the Corporation is appointed, the Corporation shall make an annual accounting or report, as appropriate, available to the Secretary and the Comptroller General of the United States." ;
  fro-usc:hasHeading "Annual accounting or report" ;
  fro-usc:hasId "id839cd651-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/16/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839cd652-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-17-4> ;
  fro-usc:hasContentText "Any report prepared pursuant to subparagraph (B) and section 5383(c)(3) of this title shall be made available to the public by the Corporation." ;
  fro-usc:hasHeading "Availability of reports" ;
  fro-usc:hasId "id839cd652-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/16/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5383/c/3" ;
.
fro-usc-t12-ch53:id839cd653-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-17-5> ;
  fro-usc:hasHeading "Recordkeeping requirement" ;
  fro-usc:hasId "id839cd653-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/16/D" ;
  fro-usc:hasNumberText "(D)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd654-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd657-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd658-1df7-11e6-87ee-8e4a3ab90f2a ;
.
