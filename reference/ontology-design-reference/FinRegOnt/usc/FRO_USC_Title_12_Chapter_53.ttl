fro-usc-t12-ch53:id839a8ccd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-4-4-3-3> ;
  fro-usc:hasContentText "the claimant did not receive notice of the appointment of the receiver in time to file such claim before such date; and" ;
  fro-usc:hasId "id839a8ccd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/3/C/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839a8cce-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-4-4-3-4> ;
  fro-usc:hasContentText "such claim is filed in time to permit payment of such claim." ;
  fro-usc:hasId "id839a8cce-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/3/C/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
