  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-11-3-2> ;
  fro-usc:hasHeading "Receivership" ;
  fro-usc:hasId "id839cd713-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/10/B/i" ;
