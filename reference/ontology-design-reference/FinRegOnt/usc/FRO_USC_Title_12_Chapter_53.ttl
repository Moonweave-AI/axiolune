.
fro-usc-t12-ch53:id83a1915a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-15-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a1915a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This subchapter, referred to in text, was in the original “this title”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to this subchapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
.
