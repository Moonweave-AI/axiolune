fro-usc-t12-ch53:id839cd65b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-2-3> ;
  fro-usc:hasContentText "Administrative expenses of the receiver." ;
  fro-usc:hasId "id839cd65b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839cd65c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-2-4> ;
  fro-usc:hasContentText "Any amounts owed to the United States, unless the United States agrees or consents otherwise." ;
  fro-usc:hasId "id839cd65c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839cd65d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-2-5> ;
  fro-usc:hasContentText "Wages, salaries, or commissions, including vacation, severance, and sick leave pay earned by an individual (other than an individual described in subparagraph (G)), but only to the extent of $11,725 for each individual (as indexed for inflation, by regulation of the Corporation) earned not later than 180 days before the date of appointment of the Corporation as receiver." ;
  fro-usc:hasId "id839cd65d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839cd65e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-2-6> ;
  fro-usc:hasContentText "Contributions owed to employee benefit plans arising from services rendered not later than 180 days before the date of appointment of the Corporation as receiver, to the extent of the number of employees covered by each such plan, multiplied by $11,725 (as indexed for inflation, by regulation of the Corporation), less the aggregate amount paid to such employees under subparagraph (C), plus the aggregate amount paid by the receivership on behalf of such employees to any other employee benefit plan." ;
  fro-usc:hasId "id839cd65e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839cd65f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-2-7> ;
  fro-usc:hasContentText "Any other general or senior liability of the covered financial company (which is not a liability described under subparagraph (F), (G), or (H))." ;
  fro-usc:hasId "id839cd65f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/1/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id839cd660-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-2-8> ;
  fro-usc:hasContentText "Any obligation subordinated to general creditors (which is not an obligation described under subparagraph (G) or (H))." ;
  fro-usc:hasId "id839cd660-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/1/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id839cd661-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-2-9> ;
  fro-usc:hasContentText "Any wages, salaries, or commissions, including vacation, severance, and sick leave pay earned, owed to senior executives and directors of the covered financial company." ;
  fro-usc:hasId "id839cd661-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/1/G" ;
  fro-usc:hasNumberText "(G)" ;
.
fro-usc-t12-ch53:id839cd662-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-2-10> ;
  fro-usc:hasContentText "Any obligation to shareholders, members, general partners, limited partners, or other persons, with interests in the equity of the covered financial company arising as a result of their status as shareholders, members, general partners, limited partners, or other persons with interests in the equity of the covered financial company." ;
  fro-usc:hasId "id839cd662-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/1/H" ;
  fro-usc:hasNumberText "(H)" ;
.
fro-usc-t12-ch53:id839cd663-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-3> ;
  fro-usc:hasContentText "In the event that the Corporation, as receiver for a covered financial company, is unable to obtain unsecured credit for the covered financial company from commercial sources, the Corporation as receiver may obtain credit or incur debt on the part of the covered financial company, which shall have priority over any or all administrative expenses of the receiver under paragraph (1)(A)." ;
  fro-usc:hasHeading "Post-receivership financing priority" ;
  fro-usc:hasId "id839cd663-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839cd664-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-4> ;
  fro-usc:hasContentText "Unsecured claims of the United States shall, at a minimum, have a higher priority than liabilities of the covered financial company that count as regulatory capital." ;
  fro-usc:hasHeading "Claims of the United States" ;
  fro-usc:hasId "id839cd664-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839cd665-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-3-5> ;
  fro-usc:hasHeading "Creditors similarly situated" ;
  fro-usc:hasId "id839cd665-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/b/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-3-5-2> ;
