fro-usc-t12-ch53:id839a8cb6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-3-2> ;
  fro-usc:hasContentText "The Corporation, as receiver for a covered financial company, shall report on claims, as set forth in section 5383(c)(3) of this title . Subject to paragraph (4) of this subsection, the Corporation, as receiver for a covered financial company, shall determine claims in accordance with the requirements of this subsection and regulations prescribed under section 5389 of this title ." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8cb6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5383/c/3" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5389" ;
.
fro-usc-t12-ch53:id839a8cb7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-3-3> ;
  fro-usc:hasHeading "Notice requirements" ;
  fro-usc:hasId "id839a8cb7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-3-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8cb8-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8cb9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8cb8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-3-3-3> ;
  fro-usc:hasContentText "promptly publish a notice to the creditors of the covered financial company to present their claims, together with proof, to the receiver by a date specified in the notice, which shall be not earlier than 90 days after the date of publication of such notice; and" ;
  fro-usc:hasId "id839a8cb8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/2/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839a8cb9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-3-3-4> ;
  fro-usc:hasContentText "republish such notice 1 month and 2 months, respectively, after the date of publication under clause (i)." ;
  fro-usc:hasId "id839a8cb9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/2/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
