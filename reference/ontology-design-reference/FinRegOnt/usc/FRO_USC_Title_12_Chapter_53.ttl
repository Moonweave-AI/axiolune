  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-5-4-6-4> ;
  fro-usc:hasContentText "take into account conditions under which covered persons do business both in the United States and in other countries; and" ;
  fro-usc:hasId "id83ad77e6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5533/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
