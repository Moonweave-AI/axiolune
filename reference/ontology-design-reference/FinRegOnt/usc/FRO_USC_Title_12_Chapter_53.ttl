fro-usc-t12-ch53:id83a19119-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-2-3> ;
  fro-usc:hasContentText "a description of actions taken by the Corporation as receiver;" ;
  fro-usc:hasId "id83a19119-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/1/A" ;
