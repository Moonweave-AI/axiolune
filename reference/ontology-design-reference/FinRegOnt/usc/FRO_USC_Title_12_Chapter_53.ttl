  fro-usc:hasContentText "do not require or promote the use of any particular technology in order to develop systems for compliance." ;
  fro-usc:hasId "id83ad77e7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5533/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
