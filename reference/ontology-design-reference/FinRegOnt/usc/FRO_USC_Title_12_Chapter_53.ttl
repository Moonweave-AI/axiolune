  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-16-2-5-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47e3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47e4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47e3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2-5-3-2> ;
  fro-usc:hasContentText "the aggregate value the claimant received from the Corporation on a claim pursuant to this subchapter (including pursuant to subsection  4 (b)(4), (d)(4), and (h)(5)(E)), as of the date on which such value was received; and" ;
  fro-usc:hasId "id839f47e3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/1/D/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839f47e4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2-5-3-3> ;
  fro-usc:hasContentText "the value the claimant was entitled to receive from the Corporation on such claim solely from the proceeds of the liquidation of the covered financial company under this subchapter; and" ;
  fro-usc:hasId "id839f47e4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/1/D/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839f47e5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2-5-4> ;
  fro-usc:hasId "id839f47e5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/1/D/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-16-2-5-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47e6-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47e7-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47e6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2-5-4-2> ;
  fro-usc:hasContentText "eligible financial companies; and" ;
  fro-usc:hasId "id839f47e6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/1/D/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839f47e7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2-5-4-3> ;
  fro-usc:hasContentText "financial companies with total consolidated assets equal to or greater than $50,000,000,000 that are not eligible financial companies." ;
  fro-usc:hasId "id839f47e7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/1/D/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839f47e8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2-6> ;
  fro-usc:hasContentText "Payments or amounts necessary to initiate and continue operations essential to implementation of the receivership or any bridge financial company described in subparagraph (D)(i) shall not include the provision of financing, as defined by rule of the Corporation, to third parties." ;
  fro-usc:hasHeading "Provision of financing" ;
  fro-usc:hasId "id839f47e8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/1/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id839f47e9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-3> ;
  fro-usc:hasContentText "The Corporation shall impose assessments on a graduated basis, with financial companies having greater assets and risk being assessed at a higher rate." ;
  fro-usc:hasHeading "Graduated assessment rate" ;
  fro-usc:hasId "id839f47e9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839f47ea-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-4> ;
  fro-usc:hasContentText "The Corporation shall notify each financial company of that company’s assessment under this subsection. Any financial company subject to assessment under this subsection shall pay such assessment in accordance with the regulations prescribed pursuant to paragraph (6)." ;
  fro-usc:hasHeading "Notification and payment" ;
  fro-usc:hasId "id839f47ea-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839f47eb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5> ;
  fro-usc:hasHeading "Risk-based assessment considerations" ;
  fro-usc:hasId "id839f47eb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-16-5-2> ;
