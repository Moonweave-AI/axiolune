  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-8-3> ;
  fro-usc:hasContentText "The Comptroller General of the United States shall conduct an annual audit of the Bureau’s financial statements in accordance with generally accepted government accounting standards." ;
  fro-usc:hasHeading "Annual GAO audit" ;
  fro-usc:hasId "id83a8bcf2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496a/b" ;
  fro-usc:hasNumberText "(b)" ;
.
