  fro-usc:hasContentText "shall be maintained with at least the same level of security as is used by the Office; and" ;
  fro-usc:hasId "id8395aadb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5343/b/1/A" ;
