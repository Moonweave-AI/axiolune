  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-4> ;
  fro-usc:hasHeading "Contents" ;
  fro-usc:hasId "id83a8bce5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-3-7-4-2> ;
.
fro-usc-t12-ch53:id83a8bce6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-4-3> ;
  fro-usc:hasContentText "a discussion of the significant problems faced by consumers in shopping for or obtaining consumer financial products or services;" ;
  fro-usc:hasId "id83a8bce6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a8bce7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-4-4> ;
  fro-usc:hasContentText "a justification of the budget request of the previous year;" ;
  fro-usc:hasId "id83a8bce7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a8bce8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-4-5> ;
  fro-usc:hasContentText "a list of the significant rules and orders adopted by the Bureau, as well as other significant initiatives conducted by the Bureau, during the preceding year and the plan of the Bureau for rules, orders, or other initiatives to be undertaken during the upcoming period;" ;
  fro-usc:hasId "id83a8bce8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/c/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a8bce9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-4-6> ;
  fro-usc:hasContentText "an analysis of complaints about consumer financial products or services that the Bureau has received and collected in its central database on complaints during the preceding year;" ;
  fro-usc:hasId "id83a8bce9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/c/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a8bcea-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-4-7> ;
  fro-usc:hasContentText "a list, with a brief statement of the issues, of the public supervisory and enforcement actions to which the Bureau was a party during the preceding year;" ;
  fro-usc:hasId "id83a8bcea-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/c/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83a8bceb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-4-8> ;
  fro-usc:hasContentText "the actions taken regarding rules, orders, and supervisory actions with respect to covered persons which are not credit unions or depository institutions;" ;
  fro-usc:hasId "id83a8bceb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/c/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id83a8bcec-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-4-9> ;
  fro-usc:hasContentText "an assessment of significant actions by State attorneys general or State regulators relating to Federal consumer financial law;" ;
  fro-usc:hasId "id83a8bcec-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/c/7" ;
  fro-usc:hasNumberText "(7)" ;
.
fro-usc-t12-ch53:id83a8bced-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-4-10> ;
  fro-usc:hasContentText "an analysis of the efforts of the Bureau to fulfill the fair lending mission of the Bureau; and" ;
  fro-usc:hasId "id83a8bced-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/c/8" ;
  fro-usc:hasNumberText "(8)" ;
.
fro-usc-t12-ch53:id83a8bcee-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-7-4-11> ;
  fro-usc:hasContentText "an analysis of the efforts of the Bureau to increase workforce and contracting diversity consistent with the procedures established by the Office of Minority and Women Inclusion." ;
  fro-usc:hasId "id83a8bcee-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496/c/9" ;
  fro-usc:hasNumberText "(9)" ;
.
