.
fro-usc-t12-ch53:id83b4a486-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b4a489-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-12-9> ;
  fro-usc:hasContentText "For each fiscal year in which a program or project is carried out under this subchapter, the Secretary shall submit a report to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives containing a description of the activities funded, amounts distributed, and measurable results, as appropriate and available." ;
  fro-usc:hasHeading "Evaluation and reports to Congress" ;
  fro-usc:hasId "id83b4a486-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5628" ;
  fro-usc:hasNumberText "§ 5628." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a487-1df7-11e6-87ee-8e4a3ab90f2a ;
.
