.
fro-usc-t12-ch53:id839f47f3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-2> ;
  fro-usc:hasContentText "the amount, different categories, and concentrations of assets of the financial company and its affiliates, including both on-balance sheet and off-balance sheet assets;" ;
  fro-usc:hasId "id839f47f3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f47f4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-3> ;
  fro-usc:hasContentText "the activities of the financial company and its affiliates;" ;
  fro-usc:hasId "id839f47f4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f47f5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-4> ;
  fro-usc:hasContentText "the relevant market share of the financial company and its affiliates;" ;
  fro-usc:hasId "id839f47f5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839f47f6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-5> ;
  fro-usc:hasContentText "the extent to which the financial company is leveraged;" ;
  fro-usc:hasId "id839f47f6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id839f47f7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-6> ;
  fro-usc:hasContentText "the potential exposure to sudden calls on liquidity precipitated by economic distress;" ;
  fro-usc:hasId "id839f47f7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/v" ;
  fro-usc:hasNumberText "(v)" ;
.
fro-usc-t12-ch53:id839f47f8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-7> ;
  fro-usc:hasContentText "the amount, maturity, volatility, and stability of the company’s financial obligations to, and relationship with, other financial companies;" ;
  fro-usc:hasId "id839f47f8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/vi" ;
  fro-usc:hasNumberText "(vi)" ;
.
fro-usc-t12-ch53:id839f47f9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-8> ;
  fro-usc:hasContentText "the amount, maturity, volatility, and stability of the liabilities of the company, including the degree of reliance on short-term funding, taking into consideration existing systems for measuring a company’s risk-based capital;" ;
  fro-usc:hasId "id839f47f9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/vii" ;
  fro-usc:hasNumberText "(vii)" ;
.
fro-usc-t12-ch53:id839f47fa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-9> ;
  fro-usc:hasContentText "the stability and variety of the company’s sources of funding;" ;
  fro-usc:hasId "id839f47fa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/viii" ;
  fro-usc:hasNumberText "(viii)" ;
.
fro-usc-t12-ch53:id839f47fb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-10> ;
  fro-usc:hasContentText "the company’s importance as a source of credit for households, businesses, and State and local governments and as a source of liquidity for the financial system;" ;
  fro-usc:hasId "id839f47fb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/ix" ;
  fro-usc:hasNumberText "(ix)" ;
.
fro-usc-t12-ch53:id839f47fc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-11> ;
  fro-usc:hasContentText "the extent to which assets are simply managed and not owned by the financial company and the extent to which ownership of assets under management is diffuse; and" ;
  fro-usc:hasId "id839f47fc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/x" ;
  fro-usc:hasNumberText "(x)" ;
.
fro-usc-t12-ch53:id839f47fd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-5-12> ;
  fro-usc:hasContentText "the amount, different categories, and concentrations of liabilities, both insured and uninsured, contingent and noncontingent, including both on-balance sheet and off-balance sheet liabilities, of the financial company and its affiliates;" ;
  fro-usc:hasId "id839f47fd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/C/xi" ;
  fro-usc:hasNumberText "(xi)" ;
.
fro-usc-t12-ch53:id839f47fe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-6> ;
  fro-usc:hasContentText "any risks presented by the financial company during the 10-year period immediately prior to the appointment of the Corporation as receiver for the covered financial company that contributed to the failure of the covered financial company; and" ;
  fro-usc:hasId "id839f47fe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839f47ff-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-5-7> ;
  fro-usc:hasContentText "such other risk-related factors as the Corporation, or the Council, as applicable, may determine to be appropriate." ;
  fro-usc:hasId "id839f47ff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/4/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id839f4800-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-6> ;
  fro-usc:hasContentText "The Corporation may impose on covered financial companies such collection of information requirements as the Corporation deems necessary to carry out this subsection after the appointment of the Corporation as receiver under this subchapter." ;
  fro-usc:hasHeading "Collection of information" ;
  fro-usc:hasId "id839f4800-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id839f4801-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-7> ;
  fro-usc:hasHeading "Rulemaking" ;
  fro-usc:hasId "id839f4801-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/6" ;
  fro-usc:hasNumberText "(6)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4802-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4803-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4802-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-7-2> ;
  fro-usc:hasContentText "The Corporation shall prescribe regulations to carry out this subsection. The Corporation shall consult with the Secretary in the development and finalization of such regulations." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f4802-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/6/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f4803-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-7-3> ;
  fro-usc:hasContentText "The regulations prescribed under subparagraph (A) shall take into account the differences in risks posed to the financial stability of the United States by financial companies, the differences in the liability structures of financial companies, and the different bases for other assessments that such financial companies may be required to pay, to ensure that assessed financial companies are treated equitably and that assessments under this subsection reflect such differences." ;
  fro-usc:hasHeading "Equitable treatment" ;
  fro-usc:hasId "id839f4803-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f4804-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f4805-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f4806-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-17> ;
  fro-usc:hasHeading "Unenforceability of certain agreements" ;
  fro-usc:hasId "id839f4804-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/p" ;
  fro-usc:hasNumberText "(p)" ;
.
fro-usc-t12-ch53:id839f4805-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-17-2> ;
  fro-usc:hasContentText "No provision described in paragraph (2) shall be enforceable against or impose any liability on any person, as such enforcement or liability shall be contrary to public policy." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f4805-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/p/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839f4806-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-17-3> ;
  fro-usc:hasHeading "Prohibited provisions" ;
  fro-usc:hasId "id839f4806-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/p/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-17-3-2> ;
  fro-usc:refers_toContinuation <fro-usc-t12-ch53:r-1-0-4-7-11-17-3-6> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4807-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4808-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4809-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4807-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-17-3-3> ;
  fro-usc:hasContentText "affects, restricts, or limits the ability of any person to offer to acquire or acquire;" ;
  fro-usc:hasId "id839f4807-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/p/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f4808-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-17-3-4> ;
  fro-usc:hasContentText "prohibits any person from offering to acquire or acquiring; or" ;
  fro-usc:hasId "id839f4808-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/p/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f4809-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-17-3-5> ;
  fro-usc:hasContentText "prohibits any person from using any previously disclosed information in connection with any such offer to acquire or acquisition of," ;
  fro-usc:hasId "id839f4809-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/p/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839f480a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f480b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f4810-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-18> ;
  fro-usc:hasHeading "Other exemptions" ;
  fro-usc:hasId "id839f480a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/q" ;
  fro-usc:hasNumberText "(q)" ;
.
fro-usc-t12-ch53:id839f480b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-18-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f480b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/q/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-18-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f480c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f480d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f480e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f480f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f480c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-18-2-3> ;
  fro-usc:hasContentText "the Corporation, including its franchise, its capital, reserves and surplus, and its income, shall be exempt from all taxation imposed by any State, county, municipality, or local taxing authority, except that any real property of the Corporation shall be subject to State, territorial, county, municipal, or local taxation to the same extent according to its value as other real property is taxed, except that, notwithstanding the failure of any person to challenge an assessment under State law of the value of such property, such value, and the tax thereon, shall be determined as of the period for which such tax is imposed;" ;
  fro-usc:hasId "id839f480c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/q/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f480d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-18-2-4> ;
  fro-usc:hasContentText "no property of the Corporation shall be subject to levy, attachment, garnishment, foreclosure, or sale without the consent of the Corporation, nor shall any involuntary lien attach to the property of the Corporation; and" ;
  fro-usc:hasId "id839f480d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/q/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f480e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-18-2-5> ;
  fro-usc:hasContentText "the Corporation shall not be liable for any amounts in the nature of penalties or fines, including those arising from the failure of any person to pay any real property, personal property, probate, or recording tax or any recording or filing fees when due; and" ;
  fro-usc:hasId "id839f480e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/q/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839f480f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-18-2-6> ;
  fro-usc:hasContentText "the Corporation shall be exempt from all prosecution by the United States or any State, county, municipality, or local authority for any criminal offense arising under Federal, State, county, municipal, or local law, which was allegedly committed by the covered financial company, or persons acting on behalf of the covered financial company, prior to the appointment of the Corporation as receiver." ;
  fro-usc:hasId "id839f480f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/q/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839f4810-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-18-3> ;
  fro-usc:hasContentText "Paragraph (1) shall not apply with respect to any tax imposed (or other amount arising) under the Internal Revenue Code of 1986 [ 26 U.S.C. 1 et seq.]." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id839f4810-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/q/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t26/s1" ;
.
fro-usc-t12-ch53:id839f4811-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f4812-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f4819-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f481c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f481d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 19 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19> ;
  fro-usc:hasHeading "Certain sales of assets prohibited" ;
  fro-usc:hasId "id839f4811-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r" ;
  fro-usc:hasNumberText "(r)" ;
.
fro-usc-t12-ch53:id839f4812-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-2> ;
  fro-usc:hasHeading "Persons who engaged in improper conduct with, or caused losses to, covered financial companies" ;
  fro-usc:hasId "id839f4812-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-19-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4813-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4817-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4818-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4813-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-2-3> ;
  fro-usc:hasId "id839f4813-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-19-2-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4814-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4815-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4816-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f4814-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-2-3-2> ;
  fro-usc:hasContentText "has defaulted, or was a member of a partnership or an officer or director of a corporation that has defaulted, on 1 or more obligations, the aggregate amount of which exceeds $1,000,000, to such covered financial company;" ;
  fro-usc:hasId "id839f4814-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/1/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839f4815-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-2-3-3> ;
  fro-usc:hasContentText "has been found to have engaged in fraudulent activity in connection with any obligation referred to in clause (i); and" ;
  fro-usc:hasId "id839f4815-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/1/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f4816-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-2-3-4> ;
  fro-usc:hasContentText "proposes to purchase any such asset in whole or in part through the use of the proceeds of a loan or advance of credit from the Corporation or from any covered financial company;" ;
  fro-usc:hasId "id839f4816-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/1/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839f4817-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-2-4> ;
  fro-usc:hasContentText "any person who participated, as an officer or director of such covered financial company or of any affiliate of such company, in a material way in any transaction that resulted in a substantial loss to such covered financial company; or" ;
  fro-usc:hasId "id839f4817-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f4818-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-2-5> ;
  fro-usc:hasContentText "any person who has demonstrated a pattern or practice of defalcation regarding obligations to such covered financial company." ;
  fro-usc:hasId "id839f4818-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839f4819-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-3> ;
  fro-usc:hasHeading "Convicted debtors" ;
  fro-usc:hasId "id839f4819-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-19-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f481a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f481b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f481a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-3-3> ;
  fro-usc:hasContentText "has been convicted of an offense under section 215, 656, 657, 1005, 1006, 1007, 1008, 1014, 1032, 1341, 1343, or 1344 of title 18, or of conspiring to commit such an offense, affecting any covered financial company; and" ;
  fro-usc:hasId "id839f481a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f481b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-3-4> ;
  fro-usc:hasContentText "is in default on any loan or other extension of credit from such covered financial company which, if not paid, will cause substantial loss to the Fund or the Corporation." ;
  fro-usc:hasId "id839f481b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f481c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-4> ;
  fro-usc:hasContentText "Paragraphs (1) and (2) shall not apply to the sale or transfer by the Corporation of any asset of any covered financial company to any person, if the sale or transfer of the asset resolves or settles, or is part of the resolution or settlement, of 1 or more claims that have been, or could have been, asserted by the Corporation against the person." ;
  fro-usc:hasHeading "Settlement of claims" ;
  fro-usc:hasId "id839f481c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839f481d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-19-5> ;
  fro-usc:hasContentText "For purposes of this subsection, the term “default” means a failure to comply with the terms of a loan or other obligation to such an extent that the property securing the obligation is foreclosed upon." ;
  fro-usc:hasHeading "Definition of default" ;
  fro-usc:hasId "id839f481d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/r/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id839f481e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f481f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f4820-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id839f4821-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 20 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-20> ;
  fro-usc:hasHeading "Recoupment of compensation from senior executives and directors" ;
  fro-usc:hasId "id839f481e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/s" ;
  fro-usc:hasNumberText "(s)" ;
.
fro-usc-t12-ch53:id839f481f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-20-2> ;
  fro-usc:hasContentText "The Corporation, as receiver of a covered financial company, may recover from any current or former senior executive or director substantially responsible for the failed condition of the covered financial company any compensation received during the 2-year period preceding the date on which the Corporation was appointed as the receiver of the covered financial company, except that, in the case of fraud, no time limit shall apply." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f481f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/s/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id839f4820-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-20-3> ;
  fro-usc:hasContentText "In seeking to recover any such compensation, the Corporation shall weigh the financial and deterrent benefits of such recovery against the cost of executing the recovery." ;
  fro-usc:hasHeading "Cost considerations" ;
  fro-usc:hasId "id839f4820-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/s/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id839f4821-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-20-4> ;
  fro-usc:hasContentText "The Corporation shall promulgate regulations to implement the requirements of this subsection, including defining the term “compensation” to mean any financial remuneration, including salary, bonuses, incentives, benefits, severance, deferred compensation, or golden parachute benefits, and any profits realized from the sale of the securities of the covered financial company." ;
  fro-usc:hasHeading "Rulemaking" ;
  fro-usc:hasId "id839f4821-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/s/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839f4822-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 21 ;
  fro-usc:hasId "id839f4822-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/stat/124/1460" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , § 210, July 21, 2010 , 124 Stat. 1460 .)" ;
.
fro-usc-t12-ch53:id839f4824-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-22-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id839f4824-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Commodity Exchange Act, referred to in subsec. (c)(15), is act Sept. 21, 1922, ch. 369 , 42 Stat. 998 , which is classified generally to chapter 1 (§ 1 et seq.) of Title 7, Agriculture. For complete classification of this Act to the Code, see section 1 of Title 7 and Tables." ;
  fro-usc:hasNoteText "The Federal Deposit Insurance Corporation Improvement Act of 1991, referred to in subsec. (c)(13)(C)(ii), is Pub. L. 102–242 , Dec. 19, 1991 , 105 Stat. 2236 . Subtitle A of title IV of the Act is classified generally to subchapter I (§ 4401 et seq.) of chapter 45 of this title. For complete classification of this Act to the Code, see Short Title of 1991 Amendment note set out under section 1811 of this title and Tables." ;
  fro-usc:hasNoteText "The Federal Rules of Civil Procedure, referred to in subsec. (a)(13), (14), are set out in the Appendix to Title 28, Judiciary and Judicial Procedure." ;
  fro-usc:hasNoteText "The Gramm-Leach-Bliley Act, referred to in subsec. (c)(15), is Pub. L. 106–102 , Nov. 12, 1999 , 113 Stat. 1338 . For complete classification of this Act to the Code, see Short Title of 1999 Amendment note set out under section 1811 of this title and Tables." ;
  fro-usc:hasNoteText "The Internal Revenue Code of 1986, referred to in subsec. (q)(2), is classified generally to Title 26, Internal Revenue Code." ;
  fro-usc:hasNoteText "The Legal Certainty for Bank Products Act of 2000, referred to in subsec. (c)(15), is title IV of H.R. 5660, as enacted by Pub. L. 106–554 , § 1(a)(5), Dec. 21, 2000 , 114 Stat. 2763 , 2763A–457, which is classified to sections 27 to 27f of Title 7, Agriculture. For complete classification of this Act to the Code, see Short Title of 2000 Amendment note set out under section 1 of Title 7 and Tables." ;
  fro-usc:hasNoteText "The Securities Exchange Act of 1934, referred to in subsec. (h)(2)(H)(i)(I), is act June 6, 1934, ch. 404 , 48 Stat. 881 , which is classified principally to chapter 2B (§ 78a et seq.) of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 78a of Title 15 and Tables." ;
  fro-usc:hasNoteText "The Securities Investor Protection Act of 1970, referred to in subsecs. (a)(1)(O)(iv), (b)(6)(C), (D), (d)(3)(A), and (h)(2)(H)(iii), is Pub. L. 91–598 , Dec. 30, 1970 , 84 Stat. 1636 , which is classified generally to chapter 2B–1 (§ 78aaa et seq.) of Title 15, Commerce and Trade. For complete classification of this Act to the Code, see section 78aaa of Title 15 and Tables." ;
  fro-usc:hasNoteText "This Act, referred to in subsec. (n)(8)(A)(i), is Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1376 , known as the Dodd-Frank Wall Street Reform and Consumer Protection Act, which enacted this chapter and chapters 108 (§ 8201 et seq.) and 109 (§ 8301 et seq.) of Title 15, Commerce and Trade, and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of this Act to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteText "This subchapter, referred to in text, was in the original “this title”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to this subchapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1922-09-21/ch369" ;
  fro-usc:hasReferenceText "/us/act/1934-06-06/ch404" ;
  fro-usc:hasReferenceText "/us/pl/102/242" ;
  fro-usc:hasReferenceText "/us/pl/106/102" ;
  fro-usc:hasReferenceText "/us/pl/106/554" ;
