  fro-usc:hasContentText "file a petition for involuntary bankruptcy on behalf of the company under section 303 of title 11 ." ;
  fro-usc:hasId "id83b4a444-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5613/c/2/B" ;
