.
fro-usc-t12-ch53:id83ad7876-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7877-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7878-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ad7876-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83ad7877-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-2-2> ;
  fro-usc:hasContentText "This title, 1 and then only to the extent of the inconsistency. other than sections 1044 through 1048, 1 may not be construed as annulling, altering, or affecting, or exempting any person subject to the provisions of this title  1 from complying with, the statutes, regulations, orders, or interpretations in effect in any State, except to the extent that any such provision of law is inconsistent with the provisions of this title, 1" ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83ad7877-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ad7878-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-2-3> ;
  fro-usc:hasContentText "For purposes of this subsection, a statute, regulation, order, or interpretation in effect in any State is not inconsistent with the provisions of this title  if the protection that such statute, regulation, order, or interpretation affords to consumers is greater than the protection provided under this title. A determination regarding whether a statute, regulation, order, or interpretation in effect in any State is inconsistent with the provisions of this title  may be made by the Bureau on its own motion or in response to a nonfrivolous petition initiated by any interested person." ;
  fro-usc:hasHeading "Greater protection under State law" ;
  fro-usc:hasId "id83ad7878-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83ad7879-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-3> ;
  fro-usc:hasContentText "No provision of this title, except as provided in section 1083, shall be construed as modifying, limiting, or superseding the operation of any provision of an enumerated consumer law that relates to the application of a law in effect in any State with respect to such Federal law." ;
  fro-usc:hasHeading "Relation to other provisions of enumerated consumer laws that relate to State law" ;
  fro-usc:hasId "id83ad7879-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83ad787a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad787b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad787c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7880-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7883-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7884-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ad7885-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4> ;
  fro-usc:hasHeading "Additional consumer protection regulations in response to State action" ;
  fro-usc:hasId "id83ad787a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83ad787b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-2> ;
  fro-usc:hasContentText "The Bureau shall issue a notice of proposed rulemaking whenever a majority of the States has enacted a resolution in support of the establishment or modification of a consumer protection regulation by the Bureau." ;
  fro-usc:hasHeading "Notice of proposed rule required" ;
  fro-usc:hasId "id83ad787b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83ad787c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-3> ;
  fro-usc:hasHeading "Bureau considerations required for issuance of final regulation" ;
  fro-usc:hasId "id83ad787c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-6-2-4-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad787d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad787e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad787f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad787d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-3-3> ;
  fro-usc:hasContentText "the proposed regulation would afford greater protection to consumers than any existing regulation;" ;
  fro-usc:hasId "id83ad787d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ad787e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-3-4> ;
  fro-usc:hasContentText "the intended benefits of the proposed regulation for consumers would outweigh any increased costs or inconveniences for consumers, and would not discriminate unfairly against any category or class of consumers; and" ;
  fro-usc:hasId "id83ad787e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ad787f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-3-5> ;
  fro-usc:hasContentText "a Federal banking agency has advised that the proposed regulation is likely to present an unacceptable safety and soundness risk to insured depository institutions." ;
  fro-usc:hasId "id83ad787f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ad7880-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-4> ;
  fro-usc:hasHeading "Explanation of considerations" ;
  fro-usc:hasId "id83ad7880-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-6-2-4-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7881-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad7882-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad7881-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-4-3> ;
  fro-usc:hasContentText "shall include a discussion of the considerations required in paragraph (2) in the Federal Register notice of a final regulation prescribed pursuant to this subsection; and" ;
  fro-usc:hasId "id83ad7881-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83ad7882-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-4-4> ;
  fro-usc:hasContentText "whenever the Bureau determines not to prescribe a final regulation, shall publish an explanation of such determination in the Federal Register, and provide a copy of such explanation to each State that enacted a resolution in support of the proposed regulation, the Committee on Banking, Housing, and Urban Affairs of the Senate, and the Committee on Financial Services of the House of Representatives." ;
  fro-usc:hasId "id83ad7882-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ad7883-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-5> ;
  fro-usc:hasContentText "No provision of this subsection shall be construed as limiting or restricting the authority of the Bureau to enhance consumer protection standards established pursuant to this title  in response to its own motion or in response to a request by any other interested person." ;
  fro-usc:hasHeading "Reservation of authority" ;
  fro-usc:hasId "id83ad7883-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83ad7884-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-6> ;
  fro-usc:hasContentText "No provision of this subsection shall be construed as exempting the Bureau from complying with subchapter II of chapter 5 of title 5." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83ad7884-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83ad7885-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-4-7> ;
  fro-usc:hasContentText "For purposes of this subsection, the term “consumer protection regulation” means a regulation that the Bureau is authorized to prescribe under the Federal consumer financial laws." ;
  fro-usc:hasHeading "Definition" ;
  fro-usc:hasId "id83ad7885-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5551/c/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id83ad7886-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id83ad7886-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/stat/124/2011" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1041, July 21, 2010 , 124 Stat. 2011 .)" ;
.
fro-usc-t12-ch53:id83ad7888-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83ad7888-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section 1083, referred to in subsec. (b), is section 1083 of Pub. L. 111–203 , which amended sections 3802 and 3803 of this title and enacted provisions set out as notes under section 3802 of this title ." ;
  fro-usc:hasNoteText "Sections 1044 through 1048, referred to in subsec. (a)(1), are sections 1044 to 1048 of Pub. L. 111–203 , which enacted and amended sections 25b and 1465 of this title and enacted provisions set out as a note below." ;
  fro-usc:hasNoteText "This title, referred to in subsecs. (a), (b), and (c)(4), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1083" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/usc/t12/s3802" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad7889-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-6-2-6-1> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83ad7889-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Pub. L. 111–203, title X , § 1048, July 21, 2010 , 124 Stat. 2018 , provided that:" ;
  fro-usc:hasNoteText "[The term “designated transfer date” is defined in section 5481(9) of this title as the date established under section 5582 of this title .]" ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
