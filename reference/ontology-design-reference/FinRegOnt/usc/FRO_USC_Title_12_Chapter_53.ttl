  fro-usc:hasHeading "Generally applicable leverage capital requirements" ;
  fro-usc:hasId "id83981b2e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-12-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b2f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b30-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b2f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-3-3> ;
  fro-usc:hasContentText "the minimum ratios of tier 1 capital to average total assets, as established by the appropriate Federal banking agencies to apply to insured depository institutions under the prompt corrective action regulations implementing section 1831 o of this title, regardless of total consolidated asset size or foreign financial exposure; and" ;
  fro-usc:hasId "id83981b2f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981b30-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-3-4> ;
  fro-usc:hasContentText "includes the regulatory capital components in the numerator of that capital requirement, average total assets in the denominator of that capital requirement, and the required ratio of the numerator to the denominator." ;
  fro-usc:hasId "id83981b30-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981b31-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-4> ;
  fro-usc:hasHeading "Generally applicable risk-based capital requirements" ;
  fro-usc:hasId "id83981b31-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-12-2-4-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b32-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b33-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b32-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-4-3> ;
  fro-usc:hasContentText "the risk-based capital requirements, as established by the appropriate Federal banking agencies to apply to insured depository institutions under the prompt corrective action regulations implementing section 1831 o of this title, regardless of total consolidated asset size or foreign financial exposure; and" ;
  fro-usc:hasId "id83981b32-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981b33-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-4-4> ;
  fro-usc:hasContentText "includes the regulatory capital components in the numerator of those capital requirements, the risk-weighted assets in the denominator of those capital requirements, and the required ratio of the numerator to the denominator." ;
  fro-usc:hasId "id83981b33-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981b34-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-5> ;
  fro-usc:hasContentText "The term “depository institution holding company” means a bank holding company or a savings and loan holding company (as those terms are defined in section 1813 of this title ) that is organized in the United States, including any bank or savings and loan holding company that is owned or controlled by a foreign organization, but does not include the foreign organization." ;
  fro-usc:hasHeading "Definition of depository institution holding company" ;
  fro-usc:hasId "id83981b34-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813" ;
.
fro-usc-t12-ch53:id83981b35-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-6> ;
  fro-usc:hasContentText "The term “business of insurance” has the same meaning as in section 5481(3) of this title ." ;
  fro-usc:hasHeading "Business of insurance" ;
  fro-usc:hasId "id83981b35-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5481/3" ;
.
fro-usc-t12-ch53:id83981b36-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-7> ;
  fro-usc:hasContentText "The term “person regulated by a State insurance regulator” has the same meaning as in section 5481(22) of this title ." ;
  fro-usc:hasHeading "Person regulated by a State insurance regulator" ;
  fro-usc:hasId "id83981b36-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5481/22" ;
.
fro-usc-t12-ch53:id83981b37-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-8> ;
  fro-usc:hasHeading "Regulated foreign subsidiary and regulated foreign affiliate" ;
  fro-usc:hasId "id83981b37-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-12-2-8-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b38-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b39-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b38-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-8-3> ;
  fro-usc:hasContentText "such person acts in its capacity as a regulated insurance entity; and" ;
  fro-usc:hasId "id83981b38-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/6/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981b39-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-8-4> ;
  fro-usc:hasContentText "the Board of Governors does not determine that the capital requirements in a specific foreign jurisdiction are inadequate." ;
  fro-usc:hasId "id83981b39-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981b3a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-9> ;
  fro-usc:hasHeading "Capacity as a regulated insurance entity" ;
  fro-usc:hasId "id83981b3a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/7" ;
  fro-usc:hasNumberText "(7)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-12-2-9-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b3b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b3c-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b3b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-9-3> ;
  fro-usc:hasContentText "includes any action or activity undertaken by a person regulated by a State insurance regulator or a regulated foreign subsidiary or regulated foreign affiliate of such person, as those actions relate to the provision of insurance, or other activities necessary to engage in the business of insurance; and" ;
  fro-usc:hasId "id83981b3b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/7/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981b3c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-2-9-4> ;
  fro-usc:hasContentText "does not include any action or activity, including any financial activity, that is not regulated by a State insurance regulator or a foreign agency or authority and subject to State insurance capital requirements or, in the case of a regulated foreign subsidiary or regulated foreign affiliate, capital requirements imposed by a foreign insurance regulatory authority." ;
  fro-usc:hasId "id83981b3c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/a/7/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981b3d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b3e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b3f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b40-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b41-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b47-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b4b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b4f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3> ;
  fro-usc:hasHeading "Minimum capital requirements" ;
  fro-usc:hasId "id83981b3d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83981b3e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-2> ;
  fro-usc:hasContentText "The appropriate Federal banking agencies shall establish minimum leverage capital requirements on a consolidated basis for insured depository institutions, depository institution holding companies, and nonbank financial companies supervised by the Board of Governors. The minimum leverage capital requirements established under this paragraph shall not be less than the generally applicable leverage capital requirements, which shall serve as a floor for any capital requirements that the agency may require, nor quantitatively lower than the generally applicable leverage capital requirements that were in effect for insured depository institutions as of July 21, 2010 ." ;
  fro-usc:hasHeading "Minimum leverage capital requirements" ;
  fro-usc:hasId "id83981b3e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83981b3f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-3> ;
  fro-usc:hasContentText "The appropriate Federal banking agencies shall establish minimum risk-based capital requirements on a consolidated basis for insured depository institutions, depository institution holding companies, and nonbank financial companies supervised by the Board of Governors. The minimum risk-based capital requirements established under this paragraph shall not be less than the generally applicable risk-based capital requirements, which shall serve as a floor for any capital requirements that the agency may require, nor quantitatively lower than the generally applicable risk-based capital requirements that were in effect for insured depository institutions as of July 21, 2010 ." ;
  fro-usc:hasHeading "Minimum risk-based capital requirements" ;
  fro-usc:hasId "id83981b3f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83981b40-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-4> ;
  fro-usc:hasContentText "For purposes of this section, investments in financial subsidiaries that insured depository institutions are required to deduct from regulatory capital under section 24a of this title or section 1831w(a)(2) of this title need not be deducted from regulatory capital by depository institution holding companies or nonbank financial companies supervised by the Board of Governors, unless such capital deduction is required by the Board of Governors or the primary financial regulatory agency in the case of nonbank financial companies supervised by the Board of Governors." ;
  fro-usc:hasHeading "Investments in financial subsidiaries" ;
  fro-usc:hasId "id83981b40-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1831w/a/2" ;
  fro-usc:hasReferenceText "/us/usc/t12/s24a" ;
.
fro-usc-t12-ch53:id83981b41-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-5> ;
  fro-usc:hasHeading "Effective dates and phase-in periods" ;
  fro-usc:hasId "id83981b41-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/4" ;
  fro-usc:hasNumberText "(4)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b42-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b43-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b44-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b45-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b46-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b42-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-5-2> ;
  fro-usc:hasContentText "For debt or equity instruments issued on or after May 19, 2010 , by depository institution holding companies or by nonbank financial companies supervised by the Board of Governors, this section shall be deemed to have become effective as of May 19, 2010 ." ;
  fro-usc:hasHeading "Debt or equity instruments on or after" ;
  fro-usc:hasId "id83981b42-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981b43-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-5-3> ;
  fro-usc:hasContentText "For debt or equity instruments issued before May 19, 2010 , by depository institution holding companies or by nonbank financial companies supervised by the Board of Governors, any regulatory capital deductions required under this section shall be phased in incrementally over a period of 3 years, with the phase-in period to begin on January 1, 2013 , except as set forth in subparagraph (C)." ;
  fro-usc:hasHeading "Debt or equity instruments issued before" ;
  fro-usc:hasId "id83981b43-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/4/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981b44-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-5-4> ;
  fro-usc:hasContentText "For debt or equity instruments issued before May 19, 2010 , by depository institution holding companies with total consolidated assets of less than $15,000,000,000 as of December 31, 2009 , or March 31, 2010 , and by organizations that were mutual holding companies on May 19, 2010 , the capital deductions that would be required for other institutions under this section are not required as a result of this section." ;
  fro-usc:hasHeading "Debt or equity instruments of smaller institutions" ;
  fro-usc:hasId "id83981b44-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/4/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83981b45-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-5-5> ;
  fro-usc:hasContentText "For any depository institution holding company that was not supervised by the Board of Governors as of May 19, 2010 , the requirements of this section, except as set forth in subparagraphs (A) and (B), shall be effective 5 years after July 21, 2010   1" ;
  fro-usc:hasHeading "Depository institution holding companies not previously supervised by the Board of Governors" ;
  fro-usc:hasId "id83981b45-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/4/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83981b46-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-5-6> ;
  fro-usc:hasContentText "For bank holding company subsidiaries of foreign banking organizations that have relied on Supervision and Regulation Letter SR-01-1 issued by the Board of Governors (as in effect on May 19, 2010 ), the requirements of this section, except as set forth in subparagraph (A), shall be effective 5 years after July 21, 2010 ." ;
  fro-usc:hasHeading "Certain bank holding company subsidiaries of foreign banking organizations" ;
  fro-usc:hasId "id83981b46-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/4/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83981b47-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-6> ;
  fro-usc:hasHeading "Exceptions" ;
  fro-usc:hasId "id83981b47-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-12-3-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b48-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b49-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b4a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b48-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-6-3> ;
  fro-usc:hasContentText "debt or equity instruments issued to the United States or any agency or instrumentality thereof pursuant to the Emergency Economic Stabilization Act of 2008 [ 12 U.S.C. 5201 et seq.], and prior to October 4, 2010 ;" ;
  fro-usc:hasId "id83981b48-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/5/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5201" ;
.
fro-usc-t12-ch53:id83981b49-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-6-4> ;
  fro-usc:hasContentText "any Federal home loan bank; or" ;
  fro-usc:hasId "id83981b49-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981b4a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-6-5> ;
  fro-usc:hasContentText "any bank holding company or savings and loan holding company having less than $1,000,000,000 in total consolidated assets that complies with the requirements of the Small Bank Holding Company Policy Statement on Assessment of Financial and Managerial Factors of the Board of Governors (12 CFR part 225 appendix C), as the requirements of such Policy Statement are amended pursuant to section 1 of an Act entitled “To enhance the ability of community financial institutions to foster economic growth and serve their communities, boost small businesses, increase individual savings, and for other purposes”." ;
  fro-usc:hasId "id83981b4a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/5/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83981b4b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-7> ;
  fro-usc:hasHeading "Study and report on small institution access to capital" ;
  fro-usc:hasId "id83981b4b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/6" ;
  fro-usc:hasNumberText "(6)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b4c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b4d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b4e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b4c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-7-2> ;
  fro-usc:hasContentText "The Comptroller General of the United States, after consultation with the Federal banking agencies, shall conduct a study of access to capital by smaller insured depository institutions." ;
  fro-usc:hasHeading "Study required" ;
  fro-usc:hasId "id83981b4c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/6/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981b4d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-7-3> ;
  fro-usc:hasContentText "For purposes of this study required by subparagraph (A), the term “smaller insured depository institution” means an insured depository institution with total consolidated assets of $5,000,000,000 or less." ;
  fro-usc:hasHeading "Scope" ;
  fro-usc:hasId "id83981b4d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981b4e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-7-4> ;
  fro-usc:hasContentText "Not later than 18 months after July 21, 2010 , the Comptroller General of the United States shall submit to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives a report summarizing the results of the study conducted under subparagraph (A), together with any recommendations for legislative or regulatory action that would enhance the access to capital of smaller insured depository institutions, in a manner that is consistent with safe and sound banking operations." ;
  fro-usc:hasHeading "Report to Congress" ;
  fro-usc:hasId "id83981b4e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/6/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83981b4f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-8> ;
  fro-usc:hasHeading "Capital requirements to address activities that pose risks to the financial system" ;
  fro-usc:hasId "id83981b4f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/7" ;
  fro-usc:hasNumberText "(7)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b50-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b51-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b50-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-8-2> ;
  fro-usc:hasContentText "Subject to the recommendations of the Council, in accordance with section 5330 of this title , the Federal banking agencies shall develop capital requirements applicable to insured depository institutions, depository institution holding companies, and nonbank financial companies supervised by the Board of Governors that address the risks that the activities of such institutions pose, not only to the institution engaging in the activity, but to other public and private stakeholders in the event of adverse performance, disruption, or failure of the institution or the activity." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83981b50-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/7/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5330" ;
.
fro-usc-t12-ch53:id83981b51-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-8-3> ;
  fro-usc:hasHeading "Content" ;
  fro-usc:hasId "id83981b51-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/7/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-5-12-3-8-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b52-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b53-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b54-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b52-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-8-3-3> ;
  fro-usc:hasContentText "significant volumes of activity in derivatives, securitized products purchased and sold, financial guarantees purchased and sold, securities borrowing and lending, and repurchase agreements and reverse repurchase agreements;" ;
  fro-usc:hasId "id83981b52-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/7/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83981b53-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-8-3-4> ;
  fro-usc:hasContentText "concentrations in assets for which the values presented in financial reports are based on models rather than historical cost or prices deriving from deep and liquid 2-way markets; and" ;
  fro-usc:hasId "id83981b53-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/7/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83981b54-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-3-8-3-5> ;
  fro-usc:hasContentText "concentrations in market share for any activity that would substantially disrupt financial markets if the institution is forced to unexpectedly cease the activity." ;
  fro-usc:hasId "id83981b54-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/b/7/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83981b55-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b56-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b57-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b58-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-4> ;
  fro-usc:hasHeading "Clarification" ;
  fro-usc:hasId "id83981b55-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83981b56-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-4-2> ;
  fro-usc:hasContentText "In establishing the minimum leverage capital requirements and minimum risk-based capital requirements on a consolidated basis for a depository institution holding company or a nonbank financial company supervised by the Board of Governors as required under paragraphs (1) and (2) of subsection (b), the appropriate Federal banking agencies shall not be required to include, for any purpose of this section (including in any determination of consolidation), a person regulated by a State insurance regulator or a regulated foreign subsidiary or a regulated foreign affiliate of such person engaged in the business of insurance, to the extent that such person acts in its capacity as a regulated insurance entity." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83981b56-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83981b57-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-4-3> ;
  fro-usc:hasContentText "This subsection shall not be construed to prohibit, modify, limit, or otherwise supersede any other provision of Federal law that provides the Board of Governors authority to issue regulations and orders relating to capital requirements for depository institution holding companies or nonbank financial companies supervised by the Board of Governors." ;
  fro-usc:hasHeading "Rule of construction on Board’s authority" ;
  fro-usc:hasId "id83981b57-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83981b58-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-4-4> ;
  fro-usc:hasHeading "Rule of construction on accounting principles" ;
  fro-usc:hasId "id83981b58-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b59-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b5a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b59-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-4-4-2> ;
  fro-usc:hasContentText "A depository institution holding company or nonbank financial company supervised by the Board of Governors of the Federal Reserve that is also a person regulated by a State insurance regulator that is engaged in the business of insurance that files financial statements with a State insurance regulator or the National Association of Insurance Commissioners utilizing only Statutory Accounting Principles in accordance with State law, shall not be required by the Board under the authority of this section or the authority of the Home Owners’ Loan Act [ 12 U.S.C. 1461 et seq.] to prepare such financial statements in accordance with Generally Accepted Accounting Principles." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83981b59-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1461" ;
.
fro-usc-t12-ch53:id83981b5a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-4-4-3> ;
  fro-usc:hasContentText "Nothing in subparagraph (A) shall limit the authority of the Board under any other applicable provision of law to conduct any regulatory or supervisory activity of a depository institution holding company or non-bank financial company supervised by the Board of Governors, including the collection or reporting of any information on an entity or group-wide basis. Nothing in this paragraph shall excuse the Board from its obligations to comply with section 5361(a) of this title and section 10(b)(2) of the Home Owners’ Loan Act ( 12 U.S.C. 1467a(b)(2) ), as appropriate." ;
  fro-usc:hasHeading "Preservation of authority" ;
  fro-usc:hasId "id83981b5a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5371/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1467a/b/2" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5361/a" ;
.
fro-usc-t12-ch53:id83981b5b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id83981b5b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/pl/113/250" ;
  fro-usc:hasReferenceText "/us/pl/113/279" ;
  fro-usc:hasReferenceText "/us/pl/114/94/dG/tLXXXVII" ;
  fro-usc:hasReferenceText "/us/stat/124/1435" ;
  fro-usc:hasReferenceText "/us/stat/128/2886" ;
  fro-usc:hasReferenceText "/us/stat/128/3017" ;
  fro-usc:hasReferenceText "/us/stat/129/1798" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , 128 Stat. 2886 ; Pub. L. 113–279 , § 2, Dec. 18, 2014 , 128 Stat. 3017 ; Pub. L. 114–94, div. G, title LXXXVII , § 87001, Dec. 4, 2015 , 129 Stat. 1798 .) , § 171, July 21, 2010 , 124 Stat. 1435 ; Pub. L. 113–250 , § 2(a), Dec. 18, 2014" ;
.
fro-usc-t12-ch53:id83981b5d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83981b5d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section 1 of an Act entitled “To enhance the ability of community financial institutions to foster economic growth and serve their communities, boost small businesses, increase individual savings, and for other purposes”, referred to in subsec. (b)(5)(C), is section 1 of Pub. L. 113–250 , which is set out as a note below." ;
  fro-usc:hasNoteText "The Emergency Economic Stabilization Act of 2008, referred to in subsec. (b)(5)(A), is div. A of Pub. L. 110–343 , Oct. 3, 2008 , 122 Stat. 3765 , which is classified principally to chapter 52 (§ 5201 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 5201 of this title and Tables." ;
  fro-usc:hasNoteText "The Home Owners’ Loan Act, referred to in subsec. (c)(3)(A), is act June 13, 1933, ch. 64 , 48 Stat. 128 , which is classified generally to chapter 12 (§ 1461 et seq.) of this title. For complete classification of this Act to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1933-06-13/ch64" ;
  fro-usc:hasReferenceText "/us/pl/110/343" ;
  fro-usc:hasReferenceText "/us/pl/113/250/s1" ;
  fro-usc:hasReferenceText "/us/stat/122/3765" ;
  fro-usc:hasReferenceText "/us/stat/48/128" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5201" ;
.
fro-usc-t12-ch53:id83981b5e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-12-6-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "id83981b5e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "2014—Subsec. (a)(4) to (7). Pub. L. 113–279 , § 2(1), added pars. (4) to (7)." ;
  fro-usc:hasNoteText "2015—Subsec. (b)(4)(C). Pub. L. 114–94 inserted “or March 31, 2010 ,” after “ December 31, 2009 ,”." ;
  fro-usc:hasNoteText "Subsec. (b)(5)(C). Pub. L. 113–250 amended subpar. (C) generally. Prior to amendment, subpar. (C) read as follows: “any small bank holding company that is subject to the Small Bank Holding Company Policy Statement of the Board of Governors, as in effect on May 19, 2010 .”" ;
  fro-usc:hasNoteText "Subsec. (c). Pub. L. 113–279 , § 2(2), added subsec. (c)." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/113/250" ;
  fro-usc:hasReferenceText "/us/pl/113/279" ;
  fro-usc:hasReferenceText "/us/pl/114/94" ;
.
fro-usc-t12-ch53:id83981b5f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
