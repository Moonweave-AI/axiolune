.
fro-usc-t12-ch53:id839cd60f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-2-3> ;
  fro-usc:hasId "id839cd60f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/A/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-2-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd610-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd611-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd610-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-2-3-2> ;
  fro-usc:hasContentText "made such transfer or incurred such obligation with actual intent to hinder, delay, or defraud any entity to which the covered financial company was or became, on or after the date on which such transfer was made or such obligation was incurred, indebted; or" ;
  fro-usc:hasId "id839cd610-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/A/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd611-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-2-3-3> ;
  fro-usc:hasContentText "received less than a reasonably equivalent value in exchange for such transferor obligation; and" ;
  fro-usc:hasId "id839cd611-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/A/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd612-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-2-4> ;
  fro-usc:hasId "id839cd612-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-2-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd613-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd614-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd615-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd616-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd613-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-2-4-2> ;
  fro-usc:hasContentText "was insolvent on the date that such transfer was made or such obligation was incurred, or became insolvent as a result of such transfer or obligation;" ;
  fro-usc:hasId "id839cd613-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/A/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd614-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-2-4-3> ;
  fro-usc:hasContentText "was engaged in business or a transaction, or was about to engage in business or a transaction, for which any property remaining with the covered financial company was an unreasonably small capital;" ;
  fro-usc:hasId "id839cd614-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/A/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd615-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-2-4-4> ;
  fro-usc:hasContentText "intended to incur, or believed that the covered financial company would incur, debts that would be beyond the ability of the covered financial company to pay as such debts matured; or" ;
  fro-usc:hasId "id839cd615-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/A/ii/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839cd616-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-2-4-5> ;
  fro-usc:hasContentText "made such transfer to or for the benefit of an insider, or incurred such obligation to or for the benefit of an insider, under an employment contract and not in the ordinary course of business." ;
  fro-usc:hasId "id839cd616-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/A/ii/IV" ;
  fro-usc:hasNumberText "(IV)" ;
.
fro-usc-t12-ch53:id839cd617-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3> ;
  fro-usc:hasHeading "Preferential transfers" ;
  fro-usc:hasId "id839cd617-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd618-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd619-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd61a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd61b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd61e-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd618-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3-3> ;
  fro-usc:hasContentText "to or for the benefit of a creditor;" ;
  fro-usc:hasId "id839cd618-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839cd619-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3-4> ;
  fro-usc:hasContentText "for or on account of an antecedent debt that was owed by the covered financial company before the transfer was made;" ;
  fro-usc:hasId "id839cd619-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd61a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3-5> ;
  fro-usc:hasContentText "that was made while the covered financial company was insolvent;" ;
  fro-usc:hasId "id839cd61a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839cd61b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3-6> ;
  fro-usc:hasId "id839cd61b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-3-6-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd61c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd61d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd61c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3-6-2> ;
  fro-usc:hasContentText "90 days or less before the date on which the Corporation was appointed receiver; or" ;
  fro-usc:hasId "id839cd61c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B/iv/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd61d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3-6-3> ;
  fro-usc:hasContentText "more than 90 days, but less than 1 year before the date on which the Corporation was appointed receiver, if such creditor at the time of the transfer was an insider; and" ;
  fro-usc:hasId "id839cd61d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B/iv/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd61e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3-7> ;
  fro-usc:hasId "id839cd61e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B/v" ;
  fro-usc:hasNumberText "(v)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-3-7-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd61f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd620-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd621-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd61f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3-7-2> ;
  fro-usc:hasContentText "the covered financial company had been liquidated under chapter 7 of the Bankruptcy Code;" ;
  fro-usc:hasId "id839cd61f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B/v/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd620-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3-7-3> ;
  fro-usc:hasContentText "the transfer had not been made; and" ;
  fro-usc:hasId "id839cd620-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B/v/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd621-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-3-7-4> ;
  fro-usc:hasContentText "the creditor received payment of such debt to the extent provided by the provisions of chapter 7 of the Bankruptcy Code." ;
  fro-usc:hasId "id839cd621-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/B/v/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839cd622-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-4> ;
  fro-usc:hasContentText "The Corporation as receiver for any covered financial company may avoid a transfer of property of the receivership that occurred after the Corporation was appointed receiver that was not authorized under this subchapter by the Corporation as receiver." ;
  fro-usc:hasHeading "Post-receivership transactions" ;
  fro-usc:hasId "id839cd622-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839cd623-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-5> ;
  fro-usc:hasHeading "Right of recovery" ;
  fro-usc:hasId "id839cd623-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-5-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd624-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd625-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd624-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-5-3> ;
  fro-usc:hasContentText "the initial transferee of such transfer or the person for whose benefit such transfer was made; or" ;
  fro-usc:hasId "id839cd624-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/D/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839cd625-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-5-4> ;
  fro-usc:hasContentText "any immediate or mediate transferee of any such initial transferee." ;
  fro-usc:hasId "id839cd625-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/D/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd626-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-6> ;
  fro-usc:hasHeading "Rights of transferee or obligee" ;
  fro-usc:hasId "id839cd626-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/E" ;
  fro-usc:hasNumberText "(E)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd627-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd628-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd627-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-6-3> ;
  fro-usc:hasContentText "any transferee that takes for value, including in satisfaction of or to secure a present or antecedent debt, in good faith, and without knowledge of the voidability of the transfer avoided; or" ;
  fro-usc:hasId "id839cd627-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/E/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839cd628-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-6-4> ;
  fro-usc:hasContentText "any immediate or mediate good faith transferee of such transferee." ;
  fro-usc:hasId "id839cd628-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/E/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd629-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-7> ;
  fro-usc:hasHeading "Defenses" ;
  fro-usc:hasId "id839cd629-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/F" ;
  fro-usc:hasNumberText "(F)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-7-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd62a-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd62b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd62a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-7-3> ;
  fro-usc:hasContentText "a transferee or obligee from which the Corporation seeks to recover a transfer or to avoid an obligation under subparagraph (A), (B), (C), or (D) shall have the same defenses available to a transferee or obligee from which a trustee seeks to recover a transfer or avoid an obligation under sections 547, 548, and 549 of the Bankruptcy Code; and" ;
  fro-usc:hasId "id839cd62a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/F/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839cd62b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-7-4> ;
  fro-usc:hasContentText "the authority of the Corporation to recover a transfer or avoid an obligation shall be subject to subsections (b) and (c) of section 546, section 547(c), and section 548(c) of the Bankruptcy Code." ;
  fro-usc:hasId "id839cd62b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/F/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd62c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-8> ;
  fro-usc:hasContentText "The rights of the Corporation as receiver under this section shall be superior to any rights of a trustee or any other party (other than a Federal agency) under the Bankruptcy Code." ;
  fro-usc:hasHeading "Rights under this section" ;
  fro-usc:hasId "id839cd62c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/G" ;
  fro-usc:hasNumberText "(G)" ;
.
fro-usc-t12-ch53:id839cd62d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-9> ;
  fro-usc:hasHeading "Rules of construction; definitions" ;
  fro-usc:hasId "id839cd62d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/H" ;
  fro-usc:hasNumberText "(H)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-9-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd62e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd632-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd62e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-9-3> ;
  fro-usc:hasId "id839cd62e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/H/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-9-3-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd62f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd630-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd631-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd62f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-9-3-2> ;
  fro-usc:hasContentText "the term “insider” has the same meaning as in section 101(31) of the Bankruptcy Code;" ;
  fro-usc:hasId "id839cd62f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/H/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd630-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-9-3-3> ;
  fro-usc:hasContentText "a transfer is made when such transfer is so perfected that a bona fide purchaser from the covered financial company against whom applicable law permits such transfer to be perfected cannot acquire an interest in the property transferred that is superior to the interest in such property of the transferee, but if such transfer is not so perfected before the date on which the Corporation is appointed as receiver for the covered financial company, such transfer is made immediately before the date of such appointment; and" ;
  fro-usc:hasId "id839cd630-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/H/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839cd631-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-9-3-4> ;
  fro-usc:hasContentText "the term “value” means property, or satisfaction or securing of a present or antecedent debt of the covered financial company, but does not include an unperformed promise to furnish support to the covered financial company; and" ;
  fro-usc:hasId "id839cd631-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/H/i/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839cd632-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-9-4> ;
  fro-usc:hasId "id839cd632-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/H/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-9-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd633-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd634-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd633-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-9-4-2> ;
  fro-usc:hasContentText "the covered financial company is presumed to have been insolvent on and during the 90-day period immediately preceding the date of appointment of the Corporation as receiver; and" ;
  fro-usc:hasId "id839cd633-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/H/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839cd634-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-12-9-4-3> ;
  fro-usc:hasContentText "the term “insolvent” has the same meaning as in section 101(32) of the Bankruptcy Code." ;
  fro-usc:hasId "id839cd634-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/H/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
