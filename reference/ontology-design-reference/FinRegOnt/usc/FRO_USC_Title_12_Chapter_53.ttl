  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-2-3-7-4-2> ;
