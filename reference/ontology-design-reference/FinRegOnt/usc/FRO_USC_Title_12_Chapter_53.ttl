  fro-usc:hasReferenceText "/us/stat/124/1408" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 119, July 21, 2010 , 124 Stat. 1408 .)" ;
.
fro-usc-t12-ch53:id8395aa6b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-10-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id8395aa6b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Title X, referred to in subsec. (a)(1), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted subchapter V (§ 5481 et seq.) of this chapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395aa6c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa6d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa6e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa73-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa78-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa7c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11> ;
  fro-usc:hasHeading "Additional standards applicable to activities or practices for financial stability purposes" ;
  fro-usc:hasId "id8395aa6c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330" ;
  fro-usc:hasNumberText "§ 5330." ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa81-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395aa6d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-2> ;
  fro-usc:hasContentText "The Council may provide for more stringent regulation of a financial activity by issuing recommendations to the primary financial regulatory agencies to apply new or heightened standards and safeguards, including standards enumerated in section 5325 of this title , for a financial activity or practice conducted by bank holding companies or nonbank financial companies under their respective jurisdictions, if the Council determines that the conduct, scope, nature, size, scale, concentration, or interconnectedness of such activity or practice could create or increase the risk of significant liquidity, credit, or other problems spreading among bank holding companies and nonbank financial companies, financial markets of the United States, or low-income, minority, or underserved communities." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id8395aa6d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5325" ;
.
fro-usc-t12-ch53:id8395aa6e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa6f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa70-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-3> ;
  fro-usc:hasHeading "Procedure for recommendations to regulators" ;
  fro-usc:hasId "id8395aa6e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id8395aa6f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-3-2> ;
  fro-usc:hasContentText "The Council shall consult with the primary financial regulatory agencies and provide notice to the public and opportunity for comment for any proposed recommendation that the primary financial regulatory agencies apply new or heightened standards and safeguards for a financial activity or practice." ;
  fro-usc:hasHeading "Notice and opportunity for comment" ;
  fro-usc:hasId "id8395aa6f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aa70-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-3-3> ;
  fro-usc:hasHeading "Criteria" ;
  fro-usc:hasId "id8395aa70-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-11-3-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa71-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa72-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395aa71-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-3-3-3> ;
  fro-usc:hasContentText "shall take costs to long-term economic growth into account; and" ;
  fro-usc:hasId "id8395aa71-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/b/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395aa72-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-3-3-4> ;
  fro-usc:hasContentText "may include prescribing the conduct of the activity or practice in specific ways (such as by limiting its scope, or applying particular capital or risk management requirements to the conduct of the activity) or prohibiting the activity or practice." ;
  fro-usc:hasId "id8395aa72-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8395aa73-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa74-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa77-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-4> ;
  fro-usc:hasHeading "Implementation of recommended standards" ;
  fro-usc:hasId "id8395aa73-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id8395aa74-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-4-2> ;
  fro-usc:hasHeading "Role of primary financial regulatory agency" ;
  fro-usc:hasId "id8395aa74-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/c/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa75-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa76-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395aa75-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-4-2-2> ;
  fro-usc:hasContentText "Each primary financial regulatory agency may impose, require reports regarding, examine for compliance with, and enforce standards in accordance with this section with respect to those entities for which it is the primary financial regulatory agency." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id8395aa75-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/c/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395aa76-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-4-2-3> ;
  fro-usc:hasContentText "The authority under this paragraph is in addition to, and does not limit, any other authority of a primary financial regulatory agency. Compliance by an entity with actions taken by a primary financial regulatory agency under this section shall be enforceable in accordance with the statutes governing the respective jurisdiction of the primary financial regulatory agency over the entity, as if the agency action were taken under those statutes." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id8395aa76-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/c/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8395aa77-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-4-3> ;
  fro-usc:hasContentText "The primary financial regulatory agency shall impose the standards recommended by the Council in accordance with subsection (a), or similar standards that the Council deems acceptable, or shall explain in writing to the Council, not later than 90 days after the date on which the Council issues the recommendation, why the agency has determined not to follow the recommendation of the Council." ;
  fro-usc:hasHeading "Imposition of standards" ;
  fro-usc:hasId "id8395aa77-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395aa78-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa79-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa7a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa7b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-5> ;
  fro-usc:hasHeading "Report to Congress" ;
  fro-usc:hasId "id8395aa78-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-11-5-2> ;
.
fro-usc-t12-ch53:id8395aa79-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-5-3> ;
  fro-usc:hasContentText "any recommendations issued by the Council under this section;" ;
  fro-usc:hasId "id8395aa79-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aa7a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-5-4> ;
  fro-usc:hasContentText "the implementation of, or failure to implement, such recommendation on the part of a primary financial regulatory agency; and" ;
  fro-usc:hasId "id8395aa7a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395aa7b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-5-5> ;
  fro-usc:hasContentText "in any case in which no primary financial regulatory agency exists for the nonbank financial company conducting financial activities or practices referred to in subsection (a), recommendations for legislation that would prevent such activities or practices from threatening the stability of the financial system of the United States." ;
  fro-usc:hasId "id8395aa7b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id8395aa7c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa7d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa7e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-6> ;
  fro-usc:hasHeading "Effect of rescission of identification" ;
  fro-usc:hasId "id8395aa7c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id8395aa7d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-6-2> ;
  fro-usc:hasContentText "The Council may recommend to the relevant primary financial regulatory agency that a financial activity or practice no longer requires any standards or safeguards implemented under this section." ;
  fro-usc:hasHeading "Notice" ;
  fro-usc:hasId "id8395aa7d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aa7e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-6-3> ;
  fro-usc:hasHeading "Determination of primary financial regulatory agency to continue" ;
  fro-usc:hasId "id8395aa7e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/e/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa7f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa80-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395aa7f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-6-3-2> ;
  fro-usc:hasContentText "Upon receipt of a recommendation under paragraph (1), a primary financial regulatory agency that has imposed standards under this section shall determine whether such standards should remain in effect." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id8395aa7f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/e/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id8395aa80-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-11-6-3-3> ;
  fro-usc:hasContentText "Each primary financial regulatory agency that has imposed standards under this section shall promulgate regulations to establish a procedure under which entities under its jurisdiction may appeal a determination by such agency under this paragraph that standards imposed under this section should remain in effect." ;
  fro-usc:hasHeading "Appeal process" ;
  fro-usc:hasId "id8395aa80-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5330/e/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8395aa81-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-usc:hasId "id8395aa81-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1408" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 120, July 21, 2010 , 124 Stat. 1408 .)" ;
.
fro-usc-t12-ch53:id8395aa82-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa83-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa89-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa8d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa8e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12> ;
  fro-usc:hasHeading "Mitigation of risks to financial stability" ;
  fro-usc:hasId "id8395aa82-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331" ;
  fro-usc:hasNumberText "§ 5331." ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aa91-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395aa83-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa84-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa85-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa86-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa87-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa88-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-2> ;
  fro-usc:hasHeading "Mitigatory actions" ;
  fro-usc:hasId "id8395aa83-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-12-2-2> ;
.
fro-usc-t12-ch53:id8395aa84-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-2-3> ;
  fro-usc:hasContentText "limit the ability of the company to merge with, acquire, consolidate with, or otherwise become affiliated with another company;" ;
  fro-usc:hasId "id8395aa84-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aa85-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-2-4> ;
  fro-usc:hasContentText "restrict the ability of the company to offer a financial product or products;" ;
  fro-usc:hasId "id8395aa85-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395aa86-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-2-5> ;
  fro-usc:hasContentText "require the company to terminate one or more activities;" ;
  fro-usc:hasId "id8395aa86-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id8395aa87-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-2-6> ;
  fro-usc:hasContentText "impose conditions on the manner in which the company conducts 1 or more activities; or" ;
  fro-usc:hasId "id8395aa87-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id8395aa88-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-2-7> ;
  fro-usc:hasContentText "if the Board of Governors determines that the actions described in paragraphs (1) through (4) are inadequate to mitigate a threat to the financial stability of the United States in its recommendation, require the company to sell or otherwise transfer assets or off-balance-sheet items to unaffiliated entities." ;
  fro-usc:hasId "id8395aa88-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/a/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id8395aa89-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa8a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa8b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa8c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-3> ;
  fro-usc:hasHeading "Notice and hearing" ;
  fro-usc:hasId "id8395aa89-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id8395aa8a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-3-2> ;
  fro-usc:hasContentText "The Board of Governors, in consultation with the Council, shall provide to a company described in subsection (a) written notice that such company is being considered for mitigatory action pursuant to this section, including an explanation of the basis for, and description of, the proposed mitigatory action." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id8395aa8a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aa8b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-3-3> ;
  fro-usc:hasContentText "Not later than 30 days after the date of receipt of notice under paragraph (1), the company may request, in writing, an opportunity for a written or oral hearing before the Board of Governors to contest the proposed mitigatory action. Upon receipt of a timely request, the Board of Governors shall fix a time (not later than 30 days after the date of receipt of the request) and place at which such company may appear, personally or through counsel, to submit written materials (or, at the discretion of the Board of Governors, in consultation with the Council, oral testimony and oral argument)." ;
  fro-usc:hasHeading "Hearing" ;
  fro-usc:hasId "id8395aa8b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395aa8c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-3-4> ;
  fro-usc:hasContentText "Not later than 60 days after the date of a hearing under paragraph (2), or not later than 60 days after the provision of a notice under paragraph (1) if no hearing was held, the Board of Governors shall notify the company of the final decision of the Board of Governors, including the results of the vote of the Council, as described in subsection (a)." ;
  fro-usc:hasHeading "Decision" ;
  fro-usc:hasId "id8395aa8c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id8395aa8d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-4> ;
  fro-usc:hasContentText "The Board of Governors and the Council shall take into consideration the factors set forth in subsection (a) or (b) of section 5323 of this title , as applicable, in making any determination under subsection (a)." ;
  fro-usc:hasHeading "Factors for consideration" ;
  fro-usc:hasId "id8395aa8d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5323" ;
.
fro-usc-t12-ch53:id8395aa8e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa8f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aa90-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-5> ;
  fro-usc:hasHeading "Application to foreign financial companies" ;
  fro-usc:hasId "id8395aa8e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-6-3-12-5-2> ;
.
fro-usc-t12-ch53:id8395aa8f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-5-3> ;
  fro-usc:hasContentText "giving due regard to the principle of national treatment and equality of competitive opportunity; and" ;
  fro-usc:hasId "id8395aa8f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aa90-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-12-5-4> ;
  fro-usc:hasContentText "taking into account the extent to which the foreign nonbank financial company or foreign-based bank holding company is subject on a consolidated basis to home country standards that are comparable to those applied to financial companies in the United States." ;
  fro-usc:hasId "id8395aa90-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5331/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
