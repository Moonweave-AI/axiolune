fro-usc-t12-ch53:id83a673e8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-7-2> ;
  fro-usc:hasContentText "a seller shall not be found to exercise substantial control over the terms or conditions of the stored value if the seller is not a party to the contract with the consumer for the stored value product, and another person is principally responsible for establishing the terms or conditions of the stored value; and" ;
  fro-usc:hasId "id83a673e8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/v/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83a673e9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-7-3> ;
  fro-usc:hasContentText "advertising the nonfinancial goods or services of the seller on the stored value card or device is not in itself an exercise of substantial control over the terms or conditions;" ;
  fro-usc:hasId "id83a673e9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/v/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id83a673ea-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-8> ;
  fro-usc:hasContentText "providing check cashing, check collection, or check guaranty services;" ;
  fro-usc:hasId "id83a673ea-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/vi" ;
  fro-usc:hasNumberText "(vi)" ;
.
fro-usc-t12-ch53:id83a673eb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-9> ;
  fro-usc:hasId "id83a673eb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/vii" ;
  fro-usc:hasNumberText "(vii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-17-2-9-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673ec-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673ed-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a673ec-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-9-2> ;
  fro-usc:hasContentText "is a merchant, retailer, or seller of any nonfinancial good or service who engages in financial data processing by transmitting or storing payments data about a consumer exclusively for purpose of initiating payments instructions by the consumer to pay such person for the purchase of, or to complete a commercial transaction for, such nonfinancial good or service sold directly by such person to the consumer; or" ;
  fro-usc:hasId "id83a673ec-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/vii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83a673ed-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-9-3> ;
  fro-usc:hasContentText "provides access to a host server to a person for purposes of enabling that person to establish and maintain a website;" ;
  fro-usc:hasId "id83a673ed-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/vii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
