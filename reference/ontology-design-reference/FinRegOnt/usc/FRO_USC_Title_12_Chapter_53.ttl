fro-usc-t12-ch53:id839f47dd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2> ;
  fro-usc:hasHeading "Risk-based assessments" ;
  fro-usc:hasId "id839f47dd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47de-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47df-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47e0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47e1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f47e8-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839f47de-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2-2> ;
  fro-usc:hasContentText "For purposes of this subsection, the term “eligible financial company” means any bank holding company with total consolidated assets equal to or greater than $50,000,000,000 and any nonbank financial company supervised by the Board of Governors." ;
  fro-usc:hasHeading "Eligible financial companies defined" ;
  fro-usc:hasId "id839f47de-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839f47df-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2-3> ;
  fro-usc:hasContentText "The Corporation shall charge one or more risk-based assessments in accordance with the provisions of subparagraph (D), if such assessments are necessary to pay in full the obligations issued by the Corporation to the Secretary under this subchapter within 60 months of the date of issuance of such obligations." ;
  fro-usc:hasHeading "Assessments" ;
  fro-usc:hasId "id839f47df-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839f47e0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2-4> ;
  fro-usc:hasContentText "The Corporation may, with the approval of the Secretary, extend the time period under subparagraph (B), if the Corporation determines that an extension is necessary to avoid a serious adverse effect on the financial system of the United States." ;
  fro-usc:hasHeading "Extensions authorized" ;
  fro-usc:hasId "id839f47e0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/o/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839f47e1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-16-2-5> ;
  fro-usc:hasHeading "Application of assessments" ;
  fro-usc:hasId "id839f47e1-1df7-11e6-87ee-8e4a3ab90f2a" ;
