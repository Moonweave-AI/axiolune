  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1914d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19150-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83a19153-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-14> ;
  fro-usc:hasHeading "Ban on certain activities by senior executives and directors" ;
  fro-usc:hasId "id83a1913e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5393" ;
  fro-usc:hasNumberText "§ 5393." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a19151-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a1913f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-14-2> ;
  fro-usc:hasContentText "The Board of Governors or, if the covered financial company was not supervised by the Board of Governors, the Corporation, may exercise the authority provided by this section." ;
  fro-usc:hasHeading "Prohibition authority" ;
  fro-usc:hasId "id83a1913f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5393/a" ;
  fro-usc:hasNumberText "(a)" ;
.
