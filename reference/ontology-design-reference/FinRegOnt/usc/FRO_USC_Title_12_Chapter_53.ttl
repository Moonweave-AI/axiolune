fro-usc-t12-ch53:id83a191b6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-7-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a191b6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Competition in Contracting Act, referred to in text, probably means the Competition in Contracting Act of 1984, which is title VII of Pub. L. 98–369, div. B , July 18, 1984 , 98 Stat. 1175 . For complete classification of this Act to the Code, see Short Title of 1984 Act note set out under section 101 of Title 41 , Public Contracts, and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/98/369/dB" ;
  fro-usc:hasReferenceText "/us/stat/98/1175" ;
  fro-usc:hasReferenceText "/us/usc/t41/s101" ;
.
fro-usc-t12-ch53:id83a191b7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-7-6-1> ;
  fro-usc:hasHeading "Codification" ;
  fro-usc:hasId "id83a191b7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "In text, “chapters 1 to 11 of title 40 and division C (except sections 3302, 3307(e), 3501(b), 3509, 3906, 4710, and 4711) of subtitle I of title 41” substituted for “the Federal Property and Administrative Services Act of 1949 ( 41 U.S.C. 251 , § 6(c), Jan. 4, 2011 , 124 Stat. 3854 , which Act enacted Title 41, Public Contracts. et seq.)” on authority of Pub. L. 107–217 , § 5(c), Aug. 21, 2002 , 116 Stat. 1303 , which Act enacted Title 40, Public Buildings, Property, and Works, and Pub. L. 111–350" ;
  fro-usc:hasNoteTopic "codification" ;
  fro-usc:hasReferenceText "/us/pl/107/217" ;
