  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839f4760-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/2/H/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-9-3-9-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4761-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839f4762-1df7-11e6-87ee-8e4a3ab90f2a ;
