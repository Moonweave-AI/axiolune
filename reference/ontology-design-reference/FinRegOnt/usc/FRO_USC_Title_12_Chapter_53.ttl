  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-3-4-4> ;
  fro-usc:hasContentText "in any claim filed by the claimant; or" ;
  fro-usc:hasId "id839a8cbc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/2/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839a8cbd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-3-4-5> ;
  fro-usc:hasContentText "upon discovery of the name and address of a claimant not appearing on the books and records of the covered financial company, not later than 30 days after the date of the discovery of such name and address." ;
  fro-usc:hasId "id839a8cbd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/2/C/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
