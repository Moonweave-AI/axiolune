fro-usc-t12-ch53:id83a4023c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4023d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4023e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40245-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83a40248-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8> ;
  fro-usc:hasHeading "Implementation plan and reports" ;
  fro-usc:hasId "id83a4023c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5437" ;
  fro-usc:hasNumberText "§ 5437." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40246-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a4023d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8-2> ;
  fro-usc:hasContentText "Within 180 days of July 21, 2010 , the Board of Governors, the Corporation, the Office of the Comptroller of the Currency, and the Office of Thrift Supervision, shall jointly submit a plan to the Committee on Banking, Housing, and Urban Affairs of the Senate, the Committee on Financial Services of the House of Representatives, and the Inspectors General of the Department of the Treasury, the Corporation, and the Board of Governors detailing the steps the Board of Governors, the Corporation, the Office of the Comptroller of the Currency, and the Office of Thrift Supervision will take to implement the provisions of sections 301 through 326, 1 and the provisions of the amendments made by such sections." ;
  fro-usc:hasHeading "Plan submission" ;
  fro-usc:hasId "id83a4023d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5437/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a4023e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4023f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40240-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40241-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40242-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40243-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40244-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8-3> ;
  fro-usc:hasHeading "Inspectors General review of the plan" ;
  fro-usc:hasId "id83a4023e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5437/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-5-8-3-2> ;
.
fro-usc-t12-ch53:id83a4023f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8-3-3> ;
  fro-usc:hasContentText "whether the plan sufficiently takes into consideration the orderly transfer of personnel;" ;
  fro-usc:hasId "id83a4023f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5437/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a40240-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8-3-4> ;
  fro-usc:hasContentText "whether the plan describes procedures and safeguards to ensure that the Office of Thrift Supervision employees are not unfairly disadvantaged relative to employees of the Office of the Comptroller of the Currency and the Corporation;" ;
  fro-usc:hasId "id83a40240-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5437/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a40241-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8-3-5> ;
  fro-usc:hasContentText "whether the plan sufficiently takes into consideration the orderly transfer of authority and responsibilities;" ;
  fro-usc:hasId "id83a40241-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5437/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a40242-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8-3-6> ;
  fro-usc:hasContentText "whether the plan sufficiently takes into consideration the effective transfer of funds;" ;
  fro-usc:hasId "id83a40242-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5437/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a40243-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8-3-7> ;
  fro-usc:hasContentText "whether the plan sufficiently takes in  2 consideration the orderly transfer of property; and" ;
  fro-usc:hasId "id83a40243-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5437/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id83a40244-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8-3-8> ;
  fro-usc:hasContentText "any additional recommendations for an orderly and effective process." ;
  fro-usc:hasId "id83a40244-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5437/b/6" ;
  fro-usc:hasNumberText "(6)" ;
.
fro-usc-t12-ch53:id83a40245-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8-4> ;
  fro-usc:hasContentText "Not later than 6 months after the date on which the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives receives the report required under subsection (b), and every 6 months thereafter until all aspects of the plan have been implemented, the Inspectors General of the Department of the Treasury, the Corporation, and the Board of Governors shall jointly provide a written report on the status of the implementation of the plan to the Board of Governors, the Corporation, the Office of the Comptroller of the Currency, and the Office of Thrift Supervision and shall submit a copy to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives." ;
  fro-usc:hasHeading "Implementation reports" ;
  fro-usc:hasId "id83a40245-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5437/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83a40246-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id83a40246-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1537" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title III , § 327, July 21, 2010 , 124 Stat. 1537 .)" ;
.
fro-usc-t12-ch53:id83a40248-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-8-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a40248-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Sections 301 through 326, referred to in subsecs. (a) and (b), are sections 301 to 326 of Pub. L. 111–203 , which enacted sections 4b, 16, and 5401 to 5436 of this title, amended sections 1, 11, 248, 481, 482, 1813, and 1820 of this title and section 3502 of Title 44 , Public Printing and Documents, and enacted provisions set out as notes under sections 1 and 16 of this title." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/usc/t44/s3502" ;
.
fro-usc-t12-ch53:id83a4024a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4024b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4024c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83a4024f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-2> ;
  fro-usc:hasHeading "Branching" ;
  fro-usc:hasId "id83a4024a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5451" ;
  fro-usc:hasNumberText "§ 5451." ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-6-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a4024d-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a4024b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-2-3> ;
  fro-usc:hasContentText "continue to operate any branch or agency that the savings association operated immediately before the savings association became a bank; and" ;
  fro-usc:hasId "id83a4024b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5451/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a4024c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-2-4> ;
  fro-usc:hasContentText "establish, acquire, and operate additional branches and agencies at any location within any State in which the savings association operated a branch immediately before the savings association became a bank, if the law of the State in which the branch is located, or is to be located, would permit establishment of the branch if the bank were a State bank chartered by such State." ;
  fro-usc:hasId "id83a4024c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5451/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a4024d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "id83a4024d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIII" ;
  fro-usc:hasReferenceText "/us/stat/124/1540" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title III , § 341, July 21, 2010 , 124 Stat. 1540 .)" ;
.
fro-usc-t12-ch53:id83a4024f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-6-2-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a4024f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Bank Holding Company Act of 1956, referred to in text, is act May 9, 1956, ch. 240 , 70 Stat. 133 , which is classified principally to chapter 17 (§ 1841 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 1841 of this title and Tables." ;
  fro-usc:hasNoteText "The Federal Deposit Insurance Act, referred to in text, is act Sept. 21, 1950, ch. 967 , § 2, 64 Stat. 873 , which is classified generally to chapter 16 (§ 1811 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 1811 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1950-09-21/ch967" ;
  fro-usc:hasReferenceText "/us/act/1956-05-09/ch240" ;
  fro-usc:hasReferenceText "/us/stat/64/873" ;
  fro-usc:hasReferenceText "/us/stat/70/133" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1811" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841" ;
.
