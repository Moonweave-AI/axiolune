fro-usc-t12-ch53:id839a8c8b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-2-3> ;
  fro-usc:hasContentText "all rights, titles, powers, and privileges of the covered financial company and its assets, and of any stockholder, member, officer, or director of such company; and" ;
  fro-usc:hasId "id839a8c8b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839a8c8c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-2-4> ;
  fro-usc:hasContentText "title to the books, records, and assets of any previous receiver or other legal custodian of such covered financial company." ;
  fro-usc:hasId "id839a8c8c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839a8c8d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-3> ;
  fro-usc:hasHeading "Operation of the covered financial company during the period of orderly liquidation" ;
  fro-usc:hasId "id839a8c8d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c8e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c8f-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c90-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c91-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c92-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c8e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-3-3> ;
  fro-usc:hasContentText "take over the assets of and operate the covered financial company with all of the powers of the members or shareholders, the directors, and the officers of the covered financial company, and conduct all business of the covered financial company;" ;
  fro-usc:hasId "id839a8c8e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839a8c8f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-3-4> ;
  fro-usc:hasContentText "collect all obligations and money owed to the covered financial company;" ;
  fro-usc:hasId "id839a8c8f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839a8c90-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-3-5> ;
  fro-usc:hasContentText "perform all functions of the covered financial company, in the name of the covered financial company;" ;
  fro-usc:hasId "id839a8c90-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839a8c91-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-3-6> ;
  fro-usc:hasContentText "manage the assets and property of the covered financial company, consistent with maximization of the value of the assets in the context of the orderly liquidation; and" ;
  fro-usc:hasId "id839a8c91-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id839a8c92-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-3-7> ;
  fro-usc:hasContentText "provide by contract for assistance in fulfilling any function, activity, action, or duty of the Corporation as receiver." ;
  fro-usc:hasId "id839a8c92-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/B/v" ;
  fro-usc:hasNumberText "(v)" ;
.
fro-usc-t12-ch53:id839a8c93-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-4> ;
  fro-usc:hasContentText "The Corporation may provide for the exercise of any function by any member or stockholder, director, or officer of any covered financial company for which the Corporation has been appointed as receiver under this subchapter." ;
  fro-usc:hasHeading "Functions of covered financial company officers, directors, and shareholders" ;
  fro-usc:hasId "id839a8c93-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839a8c94-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-5> ;
  fro-usc:hasContentText "The Corporation shall, as receiver for a covered financial company, and subject to all legally enforceable and perfected security interests and all legally enforceable security entitlements in respect of assets held by the covered financial company, liquidate, and wind-up  1 the affairs of a covered financial company, including taking steps to realize upon the assets of the covered financial company, in such manner as the Corporation deems appropriate, including through the sale of assets, the transfer of assets to a bridge financial company established under subsection (h), or the exercise of any other rights or privileges granted to the receiver under this section." ;
  fro-usc:hasHeading "Additional powers as receiver" ;
  fro-usc:hasId "id839a8c94-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id839a8c95-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-6> ;
  fro-usc:hasHeading "Additional powers with respect to failing subsidiaries of a covered financial company" ;
  fro-usc:hasId "id839a8c95-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/E" ;
  fro-usc:hasNumberText "(E)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c96-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c9a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c96-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-6-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8c96-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/E/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-2-6-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c97-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c98-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c99-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c97-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-6-2-3> ;
  fro-usc:hasContentText "the covered subsidiary is in default or in danger of default;" ;
  fro-usc:hasId "id839a8c97-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/E/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839a8c98-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-6-2-4> ;
  fro-usc:hasContentText "such action would avoid or mitigate serious adverse effects on the financial stability or economic conditions of the United States; and" ;
  fro-usc:hasId "id839a8c98-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/E/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839a8c99-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-6-2-5> ;
  fro-usc:hasContentText "such action would facilitate the orderly liquidation of the covered financial company." ;
  fro-usc:hasId "id839a8c99-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/E/i/III" ;
  fro-usc:hasNumberText "(III)" ;
.
fro-usc-t12-ch53:id839a8c9a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-6-3> ;
  fro-usc:hasHeading "Treatment as covered financial company" ;
  fro-usc:hasId "id839a8c9a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/E/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839a8c9b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-7> ;
  fro-usc:hasContentText "The Corporation, as receiver for a covered financial company, may organize a bridge financial company under subsection (h)." ;
  fro-usc:hasHeading "Organization of bridge companies" ;
  fro-usc:hasId "id839a8c9b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id839a8c9c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-8> ;
  fro-usc:hasHeading "Merger; transfer of assets and liabilities" ;
  fro-usc:hasId "id839a8c9c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/G" ;
  fro-usc:hasNumberText "(G)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c9d-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8ca0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8ca4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c9d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-8-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8c9d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/G/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-2-8-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c9e-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c9f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8c9e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-8-2-3> ;
  fro-usc:hasContentText "merge the covered financial company with another company; or" ;
  fro-usc:hasId "id839a8c9e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/G/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839a8c9f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-8-2-4> ;
  fro-usc:hasContentText "transfer any asset or liability of the covered financial company (including any assets and liabilities held by the covered financial company for security entitlement holders, any customer property, or any assets and liabilities associated with any trust or custody business) without obtaining any approval, assignment, or consent with respect to such transfer." ;
  fro-usc:hasId "id839a8c9f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/G/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839a8ca0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-8-3> ;
  fro-usc:hasHeading "Federal agency approval; antitrust review" ;
  fro-usc:hasId "id839a8ca0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/G/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-2-8-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8ca1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8ca2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8ca3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8ca1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-8-3-3> ;
  fro-usc:hasContentText "the transaction may not be consummated before the 5th calendar day after the date of approval by the Federal agency responsible for such approval;" ;
  fro-usc:hasId "id839a8ca1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/G/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839a8ca2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-8-3-4> ;
  fro-usc:hasContentText "if, in connection with any such approval, a report on competitive factors is required, the Federal agency responsible for such approval shall promptly notify the Attorney General of the United States of the proposed transaction, and the Attorney General shall provide the required report not later than 10 days after the date of the request; and" ;
  fro-usc:hasId "id839a8ca2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/G/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839a8ca3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-8-3-5> ;
  fro-usc:hasContentText "if notification under section 18a of title 15 is required with respect to such transaction, then the required waiting period shall end on the 15th day after the date on which the Attorney General and the Federal Trade Commission receive such notification, unless the waiting period is terminated earlier under subsection (b)(2) of such section 18a, or is extended pursuant to subsection (e)(2) of such section 18a." ;
  fro-usc:hasId "id839a8ca3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/G/ii/III" ;
  fro-usc:hasNumberText "(III)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s18a" ;
.
fro-usc-t12-ch53:id839a8ca4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-8-4> ;
  fro-usc:hasHeading "Setoff" ;
  fro-usc:hasId "id839a8ca4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/G/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839a8ca5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-9> ;
  fro-usc:hasContentText "The Corporation, as receiver for a covered financial company, shall, to the extent that funds are available, pay all valid obligations of the covered financial company that are due and payable at the time of the appointment of the Corporation as receiver, in accordance with the prescriptions and limitations of this subchapter." ;
  fro-usc:hasHeading "Payment of valid obligations" ;
  fro-usc:hasId "id839a8ca5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/H" ;
  fro-usc:hasNumberText "(H)" ;
.
fro-usc-t12-ch53:id839a8ca6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-10> ;
  fro-usc:hasContentText "Except as may otherwise be provided in this subchapter, the applicable noninsolvency law shall be determined by the noninsolvency choice of law rules otherwise applicable to the claims, rights, titles, persons, or entities at issue." ;
  fro-usc:hasHeading "Applicable noninsolvency law" ;
  fro-usc:hasId "id839a8ca6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id839a8ca7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-11> ;
  fro-usc:hasHeading "Subpoena authority" ;
  fro-usc:hasId "id839a8ca7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/J" ;
  fro-usc:hasNumberText "(J)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8ca8-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8ca9-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8ca8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-11-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8ca8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/J/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839a8ca9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-11-3> ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id839a8ca9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/J/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839a8caa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-12> ;
  fro-usc:hasContentText "The Corporation, as receiver for a covered financial company, may exercise all powers and authorities specifically granted to receivers under this subchapter, and such incidental powers as shall be necessary to carry out such powers under this subchapter." ;
  fro-usc:hasHeading "Incidental powers" ;
  fro-usc:hasId "id839a8caa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/K" ;
  fro-usc:hasNumberText "(K)" ;
.
fro-usc-t12-ch53:id839a8cab-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-13> ;
  fro-usc:hasContentText "In carrying out its responsibilities in the management and disposition of assets from the covered financial company, the Corporation, as receiver for a covered financial company, may utilize the services of private persons, including real estate and loan portfolio asset management, property management, auction marketing, legal, and brokerage services, if such services are available in the private sector, and the Corporation determines that utilization of such services is practicable, efficient, and cost effective." ;
  fro-usc:hasHeading "Utilization of private sector" ;
  fro-usc:hasId "id839a8cab-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/L" ;
  fro-usc:hasNumberText "(L)" ;
.
fro-usc-t12-ch53:id839a8cac-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-14> ;
  fro-usc:hasContentText "Notwithstanding any other provision of law, the Corporation, as receiver for a covered financial company, shall succeed by operation of law to the rights, titles, powers, and privileges described in subparagraph (A), and shall terminate all rights and claims that the stockholders and creditors of the covered financial company may have against the assets of the covered financial company or the Corporation arising out of their status as stockholders or creditors, except for their right to payment, resolution, or other satisfaction of their claims, as permitted under this section. The Corporation shall ensure that shareholders and unsecured creditors bear losses, consistent with the priority of claims provisions under this section." ;
  fro-usc:hasHeading "Shareholders and creditors of covered financial company" ;
  fro-usc:hasId "id839a8cac-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/M" ;
  fro-usc:hasNumberText "(M)" ;
.
fro-usc-t12-ch53:id839a8cad-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-15> ;
  fro-usc:hasContentText "The Corporation, as receiver for a covered financial company, shall coordinate, to the maximum extent possible, with the appropriate foreign financial authorities regarding the orderly liquidation of any covered financial company that has assets or operations in a country other than the United States." ;
  fro-usc:hasHeading "Coordination with foreign financial authorities" ;
  fro-usc:hasId "id839a8cad-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/N" ;
  fro-usc:hasNumberText "(N)" ;
.
fro-usc-t12-ch53:id839a8cae-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-16> ;
  fro-usc:hasHeading "Restriction on transfers" ;
  fro-usc:hasId "id839a8cae-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/O" ;
  fro-usc:hasNumberText "(O)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8caf-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8cb2-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8cb3-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8cb4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8caf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-16-2> ;
  fro-usc:hasHeading "Selection of accounts for transfer" ;
  fro-usc:hasId "id839a8caf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/O/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-2-16-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8cb0-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8cb1-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8cb0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-2-16-2-3> ;
  fro-usc:hasContentText "the customer accounts, customer name securities, and customer property are likely to be promptly transferred to another broker or dealer that is registered with the Commission under section 78 o (b) of title 15 and is a member of SIPC; or" ;
  fro-usc:hasId "id839a8cb0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/O/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
