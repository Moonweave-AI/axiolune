  lkif-mereo:component fro-usc-t12-ch53:id839a8be4-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8be3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-8-3-3> ;
  fro-usc:hasContentText "the effectiveness of implementation of prompt corrective action by the appropriate Federal banking agencies and the resolution of insured depository institutions by the Corporation; and" ;
  fro-usc:hasId "id839a8be3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/g/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839a8be4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-8-3-4> ;
  fro-usc:hasContentText "ways to make prompt corrective action a more effective tool to resolve the insured depository institutions at the least possible long-term cost to the Deposit Insurance Fund." ;
  fro-usc:hasId "id839a8be4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/g/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8be5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-8-4> ;
  fro-usc:hasContentText "Not later than 1 year after July 21, 2010 , the Comptroller General shall submit a report to the Council on the results of the study conducted under this subsection." ;
  fro-usc:hasHeading "Report to Council" ;
  fro-usc:hasId "id839a8be5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/g/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id839a8be6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-8-5> ;
  fro-usc:hasContentText "Not later than 6 months after the date of receipt of the report from the Comptroller General under paragraph (3), the Council shall submit a report to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives on actions taken in response to the report, including any recommendations made to the Federal primary financial regulatory agencies under section 5330 of this title ." ;
  fro-usc:hasHeading "Council report of action" ;
  fro-usc:hasId "id839a8be6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/g/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5330" ;
.
