fro-usc-t12-ch53:id83ad78e9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-2-4> ;
  fro-usc:hasHeading "Transmission to custodian" ;
  fro-usc:hasId "id83ad78e9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83ad78ea-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-3> ;
  fro-usc:hasContentText "Any Bureau investigator before whom oral testimony is to be taken shall exclude from the place where the testimony is to be taken all other persons, except the person giving the testimony, the attorney for that person, the officer before whom the testimony is to be taken, an investigator or representative of an agency with which the Bureau is engaged in a joint investigation, and any stenographer taking such testimony." ;
  fro-usc:hasHeading "Parties present" ;
  fro-usc:hasId "id83ad78ea-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83ad78eb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-4> ;
  fro-usc:hasContentText "The oral testimony of any person taken pursuant to a civil investigative demand shall be taken in the judicial district of the United States in which such person resides, is found, or transacts business, or in such other place as may be agreed upon by the Bureau investigator before whom the oral testimony of such person is to be taken and such person." ;
  fro-usc:hasHeading "Location" ;
  fro-usc:hasId "id83ad78eb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83ad78ec-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-5> ;
  fro-usc:hasHeading "Attorney representation" ;
  fro-usc:hasId "id83ad78ec-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/D" ;
  fro-usc:hasNumberText "(D)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78ed-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78ee-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78ef-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78f0-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad78ed-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-5-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83ad78ed-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/D/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ad78ee-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-5-3> ;
  fro-usc:hasHeading "Authority" ;
  fro-usc:hasId "id83ad78ee-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/D/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83ad78ef-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-5-4> ;
  fro-usc:hasHeading "Objections" ;
  fro-usc:hasId "id83ad78ef-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/D/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83ad78f0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-5-5> ;
  fro-usc:hasHeading "Refusal to answer" ;
  fro-usc:hasId "id83ad78f0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/D/iv" ;
  fro-usc:hasNumberText "(iv)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-7-3-4-14-5-5-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78f1-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78f2-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad78f1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-5-5-3> ;
  fro-usc:hasContentText "the Bureau may petition the district court of the United States pursuant to this section for an order compelling such person to answer such question; and" ;
  fro-usc:hasId "id83ad78f1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/D/iv/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83ad78f2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-5-5-4> ;
  fro-usc:hasContentText "if the refusal is on grounds of the privilege against self-incrimination, the testimony of such person may be compelled in accordance with the provisions of section 6004 of title 18 ." ;
  fro-usc:hasId "id83ad78f2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/D/iv/II" ;
  fro-usc:hasNumberText "(II)" ;
  fro-usc:hasReferenceText "/us/usc/t18/s6004" ;
.
fro-usc-t12-ch53:id83ad78f3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-6> ;
  fro-usc:hasHeading "Transcripts" ;
  fro-usc:hasId "id83ad78f3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/E" ;
  fro-usc:hasNumberText "(E)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-7-3-4-14-6-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78f4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78f5-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78f6-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78f7-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83ad78f8-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ad78f4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-6-3> ;
  fro-usc:hasContentText "after the testimony of any witness is fully transcribed, the Bureau investigator shall afford the witness (who may be accompanied by an attorney) a reasonable opportunity to examine the transcript;" ;
  fro-usc:hasId "id83ad78f4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/E/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83ad78f5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-6-4> ;
  fro-usc:hasContentText "the transcript shall be read to or by the witness, unless such examination and reading are waived by the witness;" ;
  fro-usc:hasId "id83ad78f5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/E/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83ad78f6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-6-5> ;
  fro-usc:hasContentText "any changes in form or substance which the witness desires to make shall be entered and identified upon the transcript by the Bureau investigator, with a statement of the reasons given by the witness for making such changes;" ;
  fro-usc:hasId "id83ad78f6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/E/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id83ad78f7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-6-6> ;
  fro-usc:hasContentText "the transcript shall be signed by the witness, unless the witness in writing waives the signing, is ill, cannot be found, or refuses to sign; and" ;
  fro-usc:hasId "id83ad78f7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/E/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
fro-usc-t12-ch53:id83ad78f8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-6-7> ;
  fro-usc:hasContentText "if the transcript is not signed by the witness during the 30-day period following the date on which the witness is first afforded a reasonable opportunity to examine the transcript, the Bureau investigator shall sign the transcript and state on the record the fact of the waiver, illness, absence of the witness, or the refusal to sign, together with any reasons given for the failure to sign." ;
  fro-usc:hasId "id83ad78f8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/E/v" ;
  fro-usc:hasNumberText "(v)" ;
.
fro-usc-t12-ch53:id83ad78f9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-7> ;
  fro-usc:hasContentText "The Bureau investigator shall certify on the transcript that the witness was duly sworn by him or her and that the transcript is a true record of the testimony given by the witness, and the Bureau investigator shall promptly deliver the transcript or send it by registered or certified mail to the custodian." ;
  fro-usc:hasHeading "Certification by investigator" ;
  fro-usc:hasId "id83ad78f9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id83afe8fa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-8> ;
  fro-usc:hasContentText "The Bureau investigator shall furnish a copy of the transcript (upon payment of reasonable charges for the transcript) to the witness only, except that the Bureau may for good cause limit such witness to inspection of the official transcript of his testimony." ;
  fro-usc:hasHeading "Copy of transcript" ;
  fro-usc:hasId "id83afe8fa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/G" ;
  fro-usc:hasNumberText "(G)" ;
.
fro-usc-t12-ch53:id83afe8fb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-4-14-9> ;
  fro-usc:hasContentText "Any witness appearing for the taking of oral testimony pursuant to a civil investigative demand shall be entitled to the same fees and mileage which are paid to witnesses in the district courts of the United States." ;
  fro-usc:hasHeading "Witness fees" ;
  fro-usc:hasId "id83afe8fb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/c/13/H" ;
  fro-usc:hasNumberText "(H)" ;
.
fro-usc-t12-ch53:id83afe8fc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe8fd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe8fe-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-5> ;
  fro-usc:hasHeading "Confidential treatment of demand material" ;
  fro-usc:hasId "id83afe8fc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83afe8fd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-5-2> ;
  fro-usc:hasContentText "Documentary materials and tangible things received as a result of a civil investigative demand shall be subject to requirements and procedures regarding confidentiality, in accordance with rules established by the Bureau." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe8fd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afe8fe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-5-3> ;
  fro-usc:hasContentText "No rule established by the Bureau regarding the confidentiality of materials submitted to, or otherwise obtained by, the Bureau shall be intended to prevent disclosure to either House of Congress or to an appropriate committee of the Congress, except that the Bureau is permitted to adopt rules allowing prior notice to any party that owns or otherwise provided the material to the Bureau and had designated such material as confidential." ;
  fro-usc:hasHeading "Disclosure to Congress" ;
  fro-usc:hasId "id83afe8fe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83afe8ff-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe900-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe901-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-6> ;
  fro-usc:hasHeading "Petition for enforcement" ;
  fro-usc:hasId "id83afe8ff-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83afe900-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-6-2> ;
  fro-usc:hasContentText "Whenever any person fails to comply with any civil investigative demand duly served upon him under this section, or whenever satisfactory copying or reproduction of material requested pursuant to the demand cannot be accomplished and such person refuses to surrender such material, the Bureau, through such officers or attorneys as it may designate, may file, in the district court of the United States for any judicial district in which such person resides, is found, or transacts business, and serve upon such person, a petition for an order of such court for the enforcement of this section." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe900-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afe901-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-6-3> ;
  fro-usc:hasContentText "All process of any court to which application may be made as provided in this subsection may be served in any judicial district." ;
  fro-usc:hasHeading "Service of process" ;
  fro-usc:hasId "id83afe901-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83afe902-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe903-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe904-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe905-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-7> ;
  fro-usc:hasHeading "Petition for order modifying or setting aside demand" ;
  fro-usc:hasId "id83afe902-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83afe903-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-7-2> ;
  fro-usc:hasContentText "Not later than 20 days after the service of any civil investigative demand upon any person under subsection (b), or at any time before the return date specified in the demand, whichever period is shorter, or within such period exceeding 20 days after service or in excess of such return date as may be prescribed in writing, subsequent to service, by any Bureau investigator named in the demand, such person may file with the Bureau a petition for an order by the Bureau modifying or setting aside the demand." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe903-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/f/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afe904-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-7-3> ;
  fro-usc:hasContentText "The time permitted for compliance with the demand in whole or in part, as determined proper and ordered by the Bureau, shall not run during the pendency of a petition under paragraph (1) at the Bureau, except that such person shall comply with any portions of the demand not sought to be modified or set aside." ;
  fro-usc:hasHeading "Compliance during pendency" ;
  fro-usc:hasId "id83afe904-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/f/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83afe905-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-7-4> ;
  fro-usc:hasContentText "A petition under paragraph (1) shall specify each ground upon which the petitioner relies in seeking relief, and may be based upon any failure of the demand to comply with the provisions of this section, or upon any constitutional or other legal right or privilege of such person." ;
  fro-usc:hasHeading "Specific grounds" ;
  fro-usc:hasId "id83afe905-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/f/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83afe906-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-8> ;
  fro-usc:hasContentText "At any time during which any custodian is in custody or control of any documentary material, tangible things, reports, answers to questions, or transcripts of oral testimony given by any person in compliance with any civil investigative demand, such person may file, in the district court of the United States for the judicial district within which the office of such custodian is situated, and serve upon such custodian, a petition for an order of such court requiring the performance by such custodian of any duty imposed upon him by this section or rule promulgated by the Bureau." ;
  fro-usc:hasHeading "Custodial control" ;
  fro-usc:hasId "id83afe906-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id83afe907-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe908-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83afe909-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-9> ;
  fro-usc:hasHeading "Jurisdiction of court" ;
  fro-usc:hasId "id83afe907-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/h" ;
  fro-usc:hasNumberText "(h)" ;
.
fro-usc-t12-ch53:id83afe908-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-9-2> ;
  fro-usc:hasContentText "Whenever any petition is filed in any district court of the United States under this section, such court shall have jurisdiction to hear and determine the matter so presented, and to enter such order or orders as may be required to carry out the provisions of this section." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83afe908-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/h/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83afe909-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-9-3> ;
  fro-usc:hasContentText "Any final order entered as described in paragraph (1) shall be subject to appeal pursuant to section 1291 of title 28 ." ;
  fro-usc:hasHeading "Appeal" ;
  fro-usc:hasId "id83afe909-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5562/h/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t28/s1291" ;
.
fro-usc-t12-ch53:id83afe90a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-usc:hasId "id83afe90a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/stat/124/2019" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1052, July 21, 2010 , 124 Stat. 2019 .)" ;
.
fro-usc-t12-ch53:id83afe90c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-11-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83afe90c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "This title, referred to in subsecs. (a)(1) and (b)(1), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83afe90d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-7-3-11-1> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83afe90d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section effective on the designated transfer date, see section 1058 of Pub. L. 111–203 , set out as a note under section 5561 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1058" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5561" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id83ad78ae-1df7-11e6-87ee-8e4a3ab90f2a ;
.
