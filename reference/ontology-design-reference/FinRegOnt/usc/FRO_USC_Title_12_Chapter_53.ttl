  lkif-mereo:component fro-usc-t12-ch53:id8395ab14-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395ab12-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-5-3-3> ;
  fro-usc:hasContentText "an analysis of any threats to the financial stability of the United States;" ;
  fro-usc:hasId "id8395ab12-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/d/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
