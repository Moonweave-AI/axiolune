  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-5-5-3-4> ;
  fro-usc:hasContentText "the status of the efforts of the Office in meeting the mission of the Office; and" ;
  fro-usc:hasId "id8395ab13-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5344/d/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
