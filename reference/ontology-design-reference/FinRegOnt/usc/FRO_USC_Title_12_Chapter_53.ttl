  fro-usc:hasHeading "Successor to covered financial company" ;
  fro-usc:hasId "id839a8c8a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-2-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c8b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8c8c-1df7-11e6-87ee-8e4a3ab90f2a ;
