  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-3> ;
  fro-usc:hasHeading "Establishment and transmittal of rules and procedures" ;
  fro-usc:hasId "id83981bb3-1df7-11e6-87ee-8e4a3ab90f2a" ;
