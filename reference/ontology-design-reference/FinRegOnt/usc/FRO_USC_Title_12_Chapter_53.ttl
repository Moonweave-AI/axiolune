  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title III , § 317, July 21, 2010 , 124 Stat. 1526 .)" ;
.
fro-usc-t12-ch53:id83a191b0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-6-4-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a191b0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Subtitle E, referred to in text, is subtitle E (§ 351–378) of title III of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1546 . For complete classification of subtitle E to the Code, see Tables." ;
  fro-usc:hasNoteText "This subtitle, referred to in text, is subtitle A (§§ 311–319) of title III of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1520 , which enacted this part and sections 4b and 16 of this title, amended sections 1, 11, 248, 481, 482, 1813, and 1820 of this title and section 3502 of Title 44 , Public Printing and Documents, and enacted provisions set out as notes under sections 1 and 16 of this title. For complete classification of subtitle A to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1520" ;
  fro-usc:hasReferenceText "/us/stat/124/1546" ;
  fro-usc:hasReferenceText "/us/usc/t44/s3502" ;
.
