  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-7-4-3> ;
  fro-usc:hasContentText "define measures of the financial condition of the company, including regulatory capital, liquidity measures, and other forward-looking indicators; and" ;
  fro-usc:hasId "id83981b01-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5366/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
