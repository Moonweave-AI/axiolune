  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-17-5-3> ;
  fro-usc:hasHeading "Retention of records" ;
  fro-usc:hasId "id839cd657-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/16/D/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
