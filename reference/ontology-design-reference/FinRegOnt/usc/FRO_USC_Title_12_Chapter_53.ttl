  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-7-3> ;
  fro-usc:hasContentText "enter into and perform contracts, execute instruments, and acquire real property (or property interest) as the Comptroller deems necessary to carry out the duties and responsibilities of the Office of the Comptroller of the Currency; and" ;
  fro-usc:hasId "id83a191b2-1df7-11e6-87ee-8e4a3ab90f2a" ;
