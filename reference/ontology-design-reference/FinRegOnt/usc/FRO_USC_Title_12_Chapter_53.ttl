.
fro-usc-t12-ch53:id839cd637-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-2-13-2-3> ;
  fro-usc:hasContentText "the claim of the creditor against the covered financial company is disallowed;" ;
  fro-usc:hasId "id839cd637-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/12/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
