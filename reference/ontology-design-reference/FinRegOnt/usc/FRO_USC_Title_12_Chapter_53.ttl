  fro-usc:hasReferenceText "/us/usc/t15/s80a–1" ;
.
fro-usc-t12-ch53:id83a67411-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-6> ;
  fro-usc:hasContentText "a national securities exchange that is required to be registered under the Securities Exchange Act of 1934;" ;
  fro-usc:hasId "id83a67411-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83a67412-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-7> ;
  fro-usc:hasContentText "a transfer agent that is required to be registered under the Securities Exchange Act of 1934;" ;
  fro-usc:hasId "id83a67412-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83a67413-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-8> ;
  fro-usc:hasContentText "a clearing corporation that is required to be registered under the Securities Exchange Act of 1934;" ;
  fro-usc:hasId "id83a67413-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id83a67414-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-9> ;
  fro-usc:hasContentText "any self-regulatory organization that is required to be registered with the Commission;" ;
  fro-usc:hasId "id83a67414-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/G" ;
  fro-usc:hasNumberText "(G)" ;
.
fro-usc-t12-ch53:id83a67415-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-10> ;
  fro-usc:hasContentText "any nationally recognized statistical rating organization that is required to be registered with the Commission;" ;
  fro-usc:hasId "id83a67415-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/H" ;
  fro-usc:hasNumberText "(H)" ;
.
fro-usc-t12-ch53:id83a67416-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-11> ;
  fro-usc:hasContentText "any securities information processor that is required to be registered with the Commission;" ;
  fro-usc:hasId "id83a67416-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/I" ;
  fro-usc:hasNumberText "(I)" ;
.
fro-usc-t12-ch53:id83a67417-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-12> ;
  fro-usc:hasContentText "any municipal securities dealer that is required to be registered with the Commission;" ;
  fro-usc:hasId "id83a67417-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/J" ;
  fro-usc:hasNumberText "(J)" ;
.
fro-usc-t12-ch53:id83a67418-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-13> ;
  fro-usc:hasContentText "any other person that is required to be registered with the Commission under the Securities Exchange Act of 1934; and" ;
  fro-usc:hasId "id83a67418-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/K" ;
  fro-usc:hasNumberText "(K)" ;
.
fro-usc-t12-ch53:id83a67419-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-14> ;
  fro-usc:hasContentText "any employee, agent, or contractor acting on behalf of, registered with, or providing services to, any person described in any of subparagraphs (A) through (K), but only to the extent that any person described in any of subparagraphs (A) through (K), or the employee, agent, or contractor of such person, acts in a regulated capacity." ;
  fro-usc:hasId "id83a67419-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/L" ;
  fro-usc:hasNumberText "(L)" ;
.
fro-usc-t12-ch53:id83a6741a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 24 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-24> ;
  fro-usc:hasContentText "The term “person regulated by a State insurance regulator” means any person that is engaged in the business of insurance and subject to regulation by any State insurance regulator, but only to the extent that such person acts in such capacity." ;
  fro-usc:hasHeading "Person regulated by a State insurance regulator" ;
  fro-usc:hasId "id83a6741a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/22" ;
  fro-usc:hasNumberText "(22)" ;
.
