fro-usc-t12-ch53:id83936034-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-17-3> ;
  fro-usc:hasContentText "terms “broker”, “dealer”, “issuer”, “nationally recognized statistical rating organization”, “security”, and “securities laws” have the same meanings as in section 3 of the Securities Exchange Act of 1934 ( 15 U.S.C. 78c );" ;
  fro-usc:hasId "id83936034-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/15/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c" ;
.
fro-usc-t12-ch53:id83936035-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-17-4> ;
  fro-usc:hasContentText "term “investment adviser” has the same meaning as in section 202 of the Investment Advisers Act of 1940 ( 15 U.S.C. 80b–2 ); and" ;
  fro-usc:hasId "id83936035-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/15/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–2" ;
.
fro-usc-t12-ch53:id83936036-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-17-5> ;
  fro-usc:hasContentText "term “investment company” has the same meaning as in section 3 of the Investment Company Act of 1940 ( 15 U.S.C. 80a–3 )." ;
  fro-usc:hasId "id83936036-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/15/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3" ;
.
fro-usc-t12-ch53:id83936037-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-18> ;
  fro-usc:hasContentText "The term “State” means any State, commonwealth, territory, or possession of the United States, the District of Columbia, the Commonwealth of Puerto Rico, the Commonwealth of the Northern Mariana Islands, American Samoa, Guam, or the United States Virgin Islands." ;
  fro-usc:hasHeading "State" ;
  fro-usc:hasId "id83936037-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/16" ;
  fro-usc:hasNumberText "(16)" ;
.
