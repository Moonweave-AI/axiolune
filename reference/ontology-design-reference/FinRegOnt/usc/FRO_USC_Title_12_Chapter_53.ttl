  fro-usc:hasContentText "assist, on a reimbursable basis, with financial analyses undertaken at the request of other Federal agencies that are not member agencies." ;
  fro-usc:hasId "id8395aade-1df7-11e6-87ee-8e4a3ab90f2a" ;
