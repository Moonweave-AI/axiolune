  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-3-5> ;
  fro-usc:hasContentText "the Corporation, in the case of a function of the Office of Thrift Supervision or the Director of the Office of Thrift Supervision transferred to the Corporation, until modified, terminated, set aside, or superseded in accordance with applicable law by the Corporation, by any court of competent jurisdiction, or by operation of law." ;
  fro-usc:hasId "id83a1919c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
