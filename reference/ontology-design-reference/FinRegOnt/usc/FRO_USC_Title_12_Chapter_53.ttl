fro-usc-t12-ch53:id83936052-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-3> ;
  fro-usc:hasContentText "The term “bank holding company” has the same meaning as in section 2 of the Bank Holding Company Act of 1956 ( 12 U.S.C. 1841 ). A foreign bank or company that is treated as a bank holding company for purposes of the Bank Holding Company Act of 1956 [ 12 U.S.C. 1841 et seq.], pursuant to section 3106(a) of this title , shall be treated as a bank holding company for purposes of this subchapter." ;
  fro-usc:hasHeading "Bank holding company" ;
  fro-usc:hasId "id83936052-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841" ;
  fro-usc:hasReferenceText "/us/usc/t12/s3106/a" ;
.
fro-usc-t12-ch53:id83936053-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-4> ;
  fro-usc:hasContentText "The term “Chairperson” means the Chairperson of the Council." ;
  fro-usc:hasHeading "Chairperson" ;
  fro-usc:hasId "id83936053-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83936054-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-2-2-5> ;
  fro-usc:hasContentText "The term “member agency” means an agency represented by a voting member of the Council." ;
  fro-usc:hasHeading "Member agency" ;
  fro-usc:hasId "id83936054-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5311/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
