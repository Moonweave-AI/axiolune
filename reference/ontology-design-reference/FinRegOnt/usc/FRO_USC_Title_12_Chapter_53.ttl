  fro-usc:hasContentText "a branch or agency of a foreign bank, as defined in section 3101 of this title ;" ;
  fro-usc:hasId "id83a402ac-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/5/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
