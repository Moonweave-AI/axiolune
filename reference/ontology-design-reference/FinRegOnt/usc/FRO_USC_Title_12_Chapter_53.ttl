fro-usc-t12-ch53:id839a8c86-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-10-4-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id839a8c86-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Federal Deposit Insurance Act, referred to in text, is act Sept. 21, 1950, ch. 967 , § 2, 64 Stat. 873 , which is classified generally to chapter 16 (§ 1811 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 1811 of this title and Tables." ;
  fro-usc:hasNoteText "This subchapter, referred to in text, was in the original “this title”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to this subchapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1950-09-21/ch967" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
  fro-usc:hasReferenceText "/us/stat/64/873" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1811" ;
.
