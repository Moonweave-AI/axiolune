  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id8395aace-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id8395aacf-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3> ;
  fro-usc:hasHeading "Office of Financial Research established" ;
  fro-usc:hasId "id8395aaba-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342" ;
  fro-usc:hasNumberText "§ 5342." ;
  lkif-mereo:component fro-usc-t12-ch53:id8395aacc-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id8395aabb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-2> ;
  fro-usc:hasContentText "There is established within the Department of the Treasury the Office of Financial Research." ;
  fro-usc:hasHeading "Establishment" ;
  fro-usc:hasId "id8395aabb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id8395aabc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aabd-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aabe-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aabf-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aac0-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aac1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-3> ;
  fro-usc:hasHeading "Director" ;
  fro-usc:hasId "id8395aabc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id8395aabd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-3-2> ;
  fro-usc:hasContentText "The Office shall be headed by a Director, who shall be appointed by the President, by and with the advice and consent of the Senate." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id8395aabd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aabe-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-3-3> ;
  fro-usc:hasContentText "The Director shall serve for a term of 6 years, except that, in the event that a successor is not nominated and confirmed by the end of the term of service of a Director, the Director may continue to serve until such time as the next Director is appointed and confirmed." ;
  fro-usc:hasHeading "Term of service" ;
  fro-usc:hasId "id8395aabe-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395aabf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-3-4> ;
  fro-usc:hasContentText "The Director shall be compensated at Level III of the Executive Schedule." ;
  fro-usc:hasHeading "Executive level" ;
  fro-usc:hasId "id8395aabf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id8395aac0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-3-5> ;
  fro-usc:hasContentText "The individual serving in the position of Director may not, during such service, also serve as the head of any financial regulatory agency." ;
  fro-usc:hasHeading "Prohibition on dual service" ;
  fro-usc:hasId "id8395aac0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id8395aac1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-3-6> ;
  fro-usc:hasContentText "The Director shall have sole discretion in the manner in which the Director fulfills the responsibilities and duties and exercises the authorities described in this part." ;
  fro-usc:hasHeading "Responsibilities, duties, and authority" ;
  fro-usc:hasId "id8395aac1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
fro-usc-t12-ch53:id8395aac2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-4> ;
  fro-usc:hasContentText "The Director, in consultation with the Chairperson, shall establish the annual budget of the Office." ;
  fro-usc:hasHeading "Budget" ;
  fro-usc:hasId "id8395aac2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id8395aac3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aac4-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aac5-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id8395aac6-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-5> ;
  fro-usc:hasHeading "Office personnel" ;
  fro-usc:hasId "id8395aac3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id8395aac4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-5-2> ;
  fro-usc:hasContentText "The Director, in consultation with the Chairperson, may fix the number of, and appoint and direct, all employees of the Office." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id8395aac4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id8395aac5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-5-3> ;
  fro-usc:hasContentText "The Director, in consultation with the Chairperson, shall fix, adjust, and administer the pay for all employees of the Office, without regard to chapter 51 or subchapter III of chapter 53 of title 5, relating to classification of positions and General Schedule pay rates." ;
  fro-usc:hasHeading "Compensation" ;
  fro-usc:hasId "id8395aac5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395aac6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-5-4> ;
  fro-usc:hasHeading ", (4) Omitted" ;
  fro-usc:hasId "id8395aac6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id8395aac7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-6> ;
  fro-usc:hasContentText "Any department or agency of the United States may provide to the Office and any special advisory, technical, or professional committees appointed by the Office, such services, funds, facilities, staff, and other support services as the Office may determine advisable. Any Federal Government employee may be detailed to the Office without reimbursement, and such detail shall be without interruption or loss of civil service status or privilege." ;
  fro-usc:hasHeading "Assistance from Federal agencies" ;
  fro-usc:hasId "id8395aac7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id8395aac8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-7> ;
  fro-usc:hasContentText "The Director may procure temporary and intermittent services under section 3109(b) of title 5 at rates for individuals which do not exceed the daily equivalent of the annual rate of basic pay prescribed for Level V of the Executive Schedule under section 5316 of such title." ;
  fro-usc:hasHeading "Procurement of temporary and intermittent services" ;
  fro-usc:hasId "id8395aac8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/f" ;
  fro-usc:hasNumberText "(f)" ;
  fro-usc:hasReferenceText "/us/usc/t5/s3109/b" ;
.
fro-usc-t12-ch53:id8395aac9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-8> ;
  fro-usc:hasContentText "The Secretary, with the concurrence of the Director of the Office of Government Ethics, shall issue regulations prohibiting the Director and any employee of the Office who has had access to the transaction or position data maintained by the Data Center or other business confidential information about financial entities required to report to the Office from being employed by or providing advice or consulting services to a financial company, for a period of 1 year after last having had access in the course of official duties to such transaction or position data or business confidential information, regardless of whether that entity is required to report to the Office. For employees whose access to business confidential information was limited, the regulations may provide, on a case-by-case basis, for a shorter period of post-employment prohibition, provided that the shorter period does not compromise business confidential information." ;
  fro-usc:hasHeading "Post-employment prohibitions" ;
  fro-usc:hasId "id8395aac9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/g" ;
  fro-usc:hasNumberText "(g)" ;
.
fro-usc-t12-ch53:id8395aaca-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-9> ;
  fro-usc:hasContentText "The Office, in consultation with the Chairperson, may appoint such special advisory, technical, or professional committees as may be useful in carrying out the functions of the Office, and the members of such committees may be staff of the Office, or other persons, or both." ;
  fro-usc:hasHeading "Technical and professional advisory committees" ;
  fro-usc:hasId "id8395aaca-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/h" ;
  fro-usc:hasNumberText "(h)" ;
.
fro-usc-t12-ch53:id8395aacb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-10> ;
  fro-usc:hasContentText "The Office, in consultation with the Chairperson, may establish and maintain an academic and professional fellowship program, under which qualified academics and professionals shall be invited to spend not longer than 2 years at the Office, to perform research and to provide advanced training for Office personnel." ;
  fro-usc:hasHeading "Fellowship program" ;
  fro-usc:hasId "id8395aacb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5342/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id8395aacc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-usc:hasId "id8395aacc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1413" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 152, July 21, 2010 , 124 Stat. 1413 .)" ;
.
fro-usc-t12-ch53:id8395aace-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-12-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id8395aace-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Level III of the Executive Schedule, referred to in subsec. (b)(3), is set out in section 5314 of Title 5 , Government Organization and Employees." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/usc/t5/s5314" ;
.
fro-usc-t12-ch53:id8395aacf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-4-3-12-1> ;
  fro-usc:hasHeading "Codification" ;
  fro-usc:hasId "id8395aacf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section is comprised of section 152 of Pub. L. 111–203 . Subsecs. (d)(3), (4) and (j) of section 152 amended section 1833b of this title and sections 3132 and 5314 of Title 5, Government Organization and Employees, respectively." ;
  fro-usc:hasNoteTopic "codification" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s152" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1833b" ;
.
