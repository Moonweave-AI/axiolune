  fro-usc:hasId "id83a8bcd6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section is comprised of section 1013 of Pub. L. 111–203 . Subsec. (d)(5), (6) of section 1013 of Pub. L. 111–203 amended section 9702 of Title 20 , Education." ;
  fro-usc:hasNoteTopic "codification" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1013" ;
  fro-usc:hasReferenceText "/us/usc/t20/s9702" ;
.
