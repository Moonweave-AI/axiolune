  fro-usc:hasContentText "consideration of whether a determination shall be made, as provided in section 5383 of this title to resolve the company under section 5382 of this title ; and" ;
  fro-usc:hasId "id83b4a442-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5613/c/2/A/i" ;
