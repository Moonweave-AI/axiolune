  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-8-3> ;
  fro-usc:hasContentText "Subject to rules prescribed by the Bureau, the Bureau may publicly disclose registration information to facilitate the ability of consumers to identify covered persons that are registered with the Bureau." ;
  fro-usc:hasHeading "Registration information" ;
  fro-usc:hasId "id83a8bd74-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/7/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a8bd75-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-8-4> ;
  fro-usc:hasContentText "In developing and implementing registration requirements under this paragraph, the Bureau shall consult with State agencies regarding requirements or systems (including coordinated or combined systems for registration), where appropriate." ;
  fro-usc:hasHeading "Consultation with State agencies" ;
  fro-usc:hasId "id83a8bd75-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/7/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a8bd76-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-9> ;
  fro-usc:hasContentText "In collecting information from any person, publicly releasing information held by the Bureau, or requiring covered persons to publicly report information, the Bureau shall take steps to ensure that proprietary, personal, or confidential consumer information that is protected from public disclosure under section 552(b) or 552a of title 5 or any other provision of law, is not made public under this title." ;
  fro-usc:hasHeading "Privacy considerations" ;
  fro-usc:hasId "id83a8bd76-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/8" ;
  fro-usc:hasNumberText "(8)" ;
.
fro-usc-t12-ch53:id83a8bd77-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-10> ;
  fro-usc:hasHeading "Consumer privacy" ;
  fro-usc:hasId "id83a8bd77-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/9" ;
  fro-usc:hasNumberText "(9)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd78-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd7b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd78-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-10-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a8bd78-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/9/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-3-4-10-2-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd79-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd7a-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd79-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-10-2-3> ;
  fro-usc:hasContentText "if the financial records are reasonably described in a request by the Bureau and the consumer provides written permission for the disclosure of such information by the covered person or service provider to the Bureau; or" ;
  fro-usc:hasId "id83a8bd79-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/9/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a8bd7a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-10-2-4> ;
  fro-usc:hasContentText "as may be specifically permitted or required under other applicable provisions of law and in accordance with the Right to Financial Privacy Act of 1978 ( 12 U.S.C. 3401 et seq.)." ;
  fro-usc:hasId "id83a8bd7a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/9/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s3401" ;
.
fro-usc-t12-ch53:id83a8bd7b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-10-3> ;
  fro-usc:hasContentText "With respect to the application of any provision of the Right to Financial Privacy Act of 1978, 2 to a disclosure by a covered person or service provider subject to this subsection, the covered person or service provider shall be treated as if it were a “financial institution”, as defined in section 1101 of that Act ( 12 U.S.C. 3401 )." ;
  fro-usc:hasHeading "Treatment of covered person or service provider" ;
  fro-usc:hasId "id83a8bd7b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/9/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s3401" ;
.
fro-usc-t12-ch53:id83a8bd7c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd7d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd7e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a8bd7f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-5> ;
  fro-usc:hasHeading "Assessment of significant rules" ;
  fro-usc:hasId "id83a8bd7c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83a8bd7d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-5-2> ;
  fro-usc:hasContentText "The Bureau shall conduct an assessment of each significant rule or order adopted by the Bureau under Federal consumer financial law. The assessment shall address, among other relevant factors, the effectiveness of the rule or order in meeting the purposes and objectives of this title  and the specific goals stated by the Bureau. The assessment shall reflect available evidence and any data that the Bureau reasonably may collect." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a8bd7d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a8bd7e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-5-3> ;
  fro-usc:hasContentText "The Bureau shall publish a report of its assessment under this subsection not later than 5 years after the effective date of the subject rule or order." ;
  fro-usc:hasHeading "Reports" ;
  fro-usc:hasId "id83a8bd7e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a8bd7f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-5-4> ;
  fro-usc:hasContentText "Before publishing a report of its assessment, the Bureau shall invite public comment on recommendations for modifying, expanding, or eliminating the newly adopted significant rule or order." ;
  fro-usc:hasHeading "Public comment required" ;
  fro-usc:hasId "id83a8bd7f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a8bd80-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "id83a8bd80-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tX" ;
  fro-usc:hasReferenceText "/us/stat/124/1980" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title X , § 1022, July 21, 2010 , 124 Stat. 1980 .)" ;
.
fro-usc-t12-ch53:id83a8bd82-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83a8bd82-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Right to Financial Privacy Act of 1978, referred to in subsec. (c)(9)(A)(ii), (B), is title XI of Pub. L. 95–630 , Nov. 10, 1978 , 92 Stat. 3697 , which is classified generally to chapter 35 (§ 3401 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 3401 of this title and Tables." ;
  fro-usc:hasNoteText "This title, where footnoted in subsecs. (b)(3)(A), (4)(B), (c)(8), and (d)(1), is title X of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1955 , known as the Consumer Financial Protection Act of 2010, which enacted this subchapter and enacted, amended, and repealed numerous other sections and notes in the Code. For complete classification of title X to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/95/630" ;
  fro-usc:hasReferenceText "/us/stat/124/1955" ;
  fro-usc:hasReferenceText "/us/stat/92/3697" ;
  fro-usc:hasReferenceText "/us/usc/t12/s3401" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd83-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
