.
fro-usc-t12-ch53:id83a191a8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-5-2> ;
  fro-usc:hasContentText "Any proposed regulation of the Office of Thrift Supervision, which the Office of Thrift Supervision in performing functions transferred by this title, has proposed before the transfer date but has not published as a final regulation before such date, shall be deemed to be a proposed regulation of the Office of the Comptroller of the Currency or the Board of Governors, as appropriate, according to the terms of the proposed regulation." ;
  fro-usc:hasHeading "Proposed regulations" ;
  fro-usc:hasId "id83a191a8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a191a9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-5-3> ;
  fro-usc:hasContentText "Any interim or final regulation of the Office of Thrift Supervision, which the Office of Thrift Supervision, in performing functions transferred by this title, has published before the transfer date but which has not become effective before that date, shall become effective as a regulation of the Office of the Comptroller of the Currency or the Board of Governors, as appropriate, according to the terms of the interim or final regulation, unless modified, terminated, set aside, or superseded in accordance with applicable law by the Office of the Comptroller of the Currency or the Board of Governors, as appropriate, by any court of competent jurisdiction, or by operation of law." ;
  fro-usc:hasHeading "Regulations not yet effective" ;
  fro-usc:hasId "id83a191a9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a191aa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "id83a191aa-1df7-11e6-87ee-8e4a3ab90f2a" ;
