fro-usc-t12-ch53:id839cd6f2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-6> ;
  fro-usc:hasContentText "No provision of law shall be construed as limiting the right or power of the Corporation, or authorizing any court or agency to limit or delay, in any manner, the right or power of the Corporation to transfer any qualified financial contract or to disaffirm or repudiate any such contract in accordance with this subsection." ;
  fro-usc:hasHeading "Clarification" ;
  fro-usc:hasId "id839cd6f2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/E" ;
  fro-usc:hasNumberText "(E)" ;
.
