.
fro-usc-t12-ch53:id83a19193-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19194-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a19195-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-2> ;
  fro-usc:hasHeading "Office of Thrift Supervision" ;
  fro-usc:hasId "id83a19193-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83a19194-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-2-2> ;
  fro-usc:hasContentText "Sections 5412(b) and 5413 of this title shall not affect the validity of any right, duty, or obligation of the United States, the Director of the Office of Thrift Supervision, the Office of Thrift Supervision, or any other person, that existed on the day before the transfer date." ;
  fro-usc:hasHeading "Existing rights, duties, and obligations not affected" ;
  fro-usc:hasId "id83a19194-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a19195-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-2-3> ;
  fro-usc:hasHeading "Continuation of suits" ;
  fro-usc:hasId "id83a19195-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-4-5-2-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a19196-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a19197-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a19198-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a19196-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-2-3-3> ;
  fro-usc:hasContentText "for any action or proceeding arising out of a function of the Office of Thrift Supervision or the Director of the Office of Thrift Supervision transferred to the Board of Governors by this title, the Board of Governors shall be substituted for the Office of Thrift Supervision or the Director of the Office of Thrift Supervision as a party to the action or proceeding on and after the transfer date;" ;
  fro-usc:hasId "id83a19196-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a19197-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-2-3-4> ;
  fro-usc:hasContentText "for any action or proceeding arising out of a function of the Office of Thrift Supervision or the Director of the Office of Thrift Supervision transferred to the Office of the Comptroller of the Currency or the Comptroller of the Currency by this title, the Office of the Comptroller of the Currency or the Comptroller of the Currency shall be substituted for the Office of Thrift Supervision or the Director of the Office of Thrift Supervision, as the case may be, as a party to the action or proceeding on and after the transfer date; and" ;
  fro-usc:hasId "id83a19197-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a19198-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-2-3-5> ;
  fro-usc:hasContentText "for any action or proceeding arising out of a function of the Office of Thrift Supervision or the Director of the Office of Thrift Supervision transferred to the Corporation by this title, the Corporation shall be substituted for the Office of Thrift Supervision or the Director of the Office of Thrift Supervision as a party to the action or proceeding on and after the transfer date." ;
  fro-usc:hasId "id83a19198-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/a/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a19199-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1919a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1919b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a1919c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-3> ;
  fro-usc:hasHeading "Continuation of existing OTS orders, resolutions, determinations, agreements, regulations, etc." ;
  fro-usc:hasId "id83a19199-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-4-5-3-2> ;
.
fro-usc-t12-ch53:id83a1919a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-3-3> ;
  fro-usc:hasContentText "the Board of Governors, in the case of a function of the Office of Thrift Supervision or the Director of the Office of Thrift Supervision transferred to the Board of Governors, until modified, terminated, set aside, or superseded in accordance with applicable law by the Board of Governors, by any court of competent jurisdiction, or by operation of law;" ;
  fro-usc:hasId "id83a1919a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a1919b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-4-5-3-4> ;
  fro-usc:hasContentText "the Office of the Comptroller of the Currency or the Comptroller of the Currency, in the case of a function of the Office of Thrift Supervision or the Director of the Office of Thrift Supervision transferred to the Office of the Comptroller of the Currency or the Comptroller of the Currency, respectively, until modified, terminated, set aside, or superseded in accordance with applicable law by the Office of the Comptroller of the Currency or the Comptroller of the Currency, by any court of competent jurisdiction, or by operation of law; and" ;
  fro-usc:hasId "id83a1919b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5414/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
