  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-5> ;
  fro-usc:hasId "id83936025-1df7-11e6-87ee-8e4a3ab90f2a" ;
