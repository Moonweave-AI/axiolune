  fro-usc:hasHeading "Examination of and enforcement actions against designated financial market utilities" ;
  fro-usc:hasId "id83a4033f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466" ;
  fro-usc:hasNumberText "§ 5466." ;
  lkif-mereo:component fro-usc-t12-ch53:id83a6735b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40340-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40341-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40342-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40343-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40344-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40345-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-2> ;
  fro-usc:hasHeading "Examination" ;
  fro-usc:hasId "id83a40340-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-7-2-2> ;
.
fro-usc-t12-ch53:id83a40341-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-2-3> ;
  fro-usc:hasContentText "The nature of the operations of, and the risks borne by, the designated financial market utility." ;
  fro-usc:hasId "id83a40341-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a40342-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-2-4> ;
  fro-usc:hasContentText "The financial and operational risks presented by the designated financial market utility to financial institutions, critical markets, or the broader financial system." ;
  fro-usc:hasId "id83a40342-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a40343-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-2-5> ;
  fro-usc:hasContentText "The resources and capabilities of the designated financial market utility to monitor and control such risks." ;
  fro-usc:hasId "id83a40343-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a40344-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-2-6> ;
  fro-usc:hasContentText "The safety and soundness of the designated financial market utility." ;
  fro-usc:hasId "id83a40344-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a40345-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-2-7> ;
  fro-usc:hasId "id83a40345-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/a/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-7-2-7-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40346-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40347-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a40346-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-2-7-2> ;
  fro-usc:hasContentText "this subchapter; and" ;
  fro-usc:hasId "id83a40346-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/a/5/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a40347-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-2-7-3> ;
  fro-usc:hasContentText "the rules and orders prescribed under this subchapter." ;
  fro-usc:hasId "id83a40347-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/a/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a40348-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-3> ;
  fro-usc:hasContentText "Whenever a service integral to the operation of a designated financial market utility is performed for the designated financial market utility by another entity, whether an affiliate or non-affiliate and whether on or off the premises of the designated financial market utility, the Supervisory Agency may examine whether the provision of that service is in compliance with applicable law, rules, orders, and standards to the same extent as if the designated financial market utility were performing the service on its own premises." ;
  fro-usc:hasHeading "Service providers" ;
  fro-usc:hasId "id83a40348-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a40349-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-4> ;
  fro-usc:hasContentText "For purposes of enforcing the provisions of this subchapter, a designated financial market utility shall be subject to, and the appropriate Supervisory Agency shall have authority under the provisions of subsections (b) through (n) of section 1818 of this title in the same manner and to the same extent as if the designated financial market utility was an insured depository institution and the Supervisory Agency was the appropriate Federal banking agency for such insured depository institution." ;
  fro-usc:hasHeading "Enforcement" ;
  fro-usc:hasId "id83a40349-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1818" ;
.
fro-usc-t12-ch53:id83a4034a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4034b-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4034c-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-5> ;
  fro-usc:hasHeading "Board of Governors involvement in examinations" ;
  fro-usc:hasId "id83a4034a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83a4034b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-5-2> ;
  fro-usc:hasContentText "The Supervisory Agency shall consult annually with the Board of Governors regarding the scope and methodology of any examination conducted under subsections (a) and (b). The Supervisory Agency shall lead all examinations conducted under subsections (a) and (b)  1" ;
  fro-usc:hasHeading "Board of Governors consultation on examination planning" ;
  fro-usc:hasId "id83a4034b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a4034c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-5-3> ;
  fro-usc:hasContentText "The Board of Governors may, in its discretion, participate in any examination led by a Supervisory Agency and conducted under subsections (a) and (b)." ;
  fro-usc:hasHeading "Board of Governors participation in examination" ;
  fro-usc:hasId "id83a4034c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a4034d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4034e-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a4034f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40350-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a40351-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-6> ;
  fro-usc:hasHeading "Board of Governors enforcement recommendations" ;
  fro-usc:hasId "id83a4034d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83a4034e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-6-2> ;
  fro-usc:hasContentText "The Board of Governors may, after consulting with the Council and the Supervisory Agency, at any time recommend to the Supervisory Agency that such agency take enforcement action against a designated financial market utility in order to prevent or mitigate significant liquidity, credit, operational, or other risks to the financial markets or to the financial stability of the United States. Any such recommendation for enforcement action shall provide a detailed analysis supporting the recommendation of the Board of Governors." ;
  fro-usc:hasHeading "Recommendation" ;
  fro-usc:hasId "id83a4034e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a4034f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-6-3> ;
  fro-usc:hasContentText "The Supervisory Agency shall consider the recommendation of the Board of Governors and submit a response to the Board of Governors within 60 days." ;
  fro-usc:hasHeading "Consideration" ;
  fro-usc:hasId "id83a4034f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a40350-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-6-4> ;
  fro-usc:hasContentText "If the Supervisory Agency rejects, in whole or in part, the recommendation of the Board of Governors, the Board of Governors may refer the recommendation to the Council for a binding decision on whether an enforcement action is warranted." ;
  fro-usc:hasHeading "Binding arbitration" ;
  fro-usc:hasId "id83a40350-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a40351-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-7-6-5> ;
  fro-usc:hasHeading "Enforcement action" ;
  fro-usc:hasId "id83a40351-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5466/e/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-9-7-6-5-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a40352-1df7-11e6-87ee-8e4a3ab90f2a ;
