.
fro-usc-t12-ch53:id839f473d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-5-5-3-3> ;
  fro-usc:hasHeading "No obligation" ;
  fro-usc:hasId "id839f473d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/d/4/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839f473e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-5-5-4> ;
  fro-usc:hasContentText "The Corporation may make payments or credit amounts under subparagraph (A) directly to the claimants or may make such payments or credit such amounts to a company other than a covered financial company or a bridge financial company established with respect thereto in order to induce such other company to accept liability for such claims." ;
  fro-usc:hasHeading "Manner of payment" ;
  fro-usc:hasId "id839f473e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/d/4/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839f473f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-6> ;
  fro-usc:hasContentText "Except as provided in this subchapter, no court may take any action to restrain or affect the exercise of powers or functions of the receiver hereunder, and any remedy against the Corporation or receiver shall be limited to money damages determined in accordance with this subchapter." ;
  fro-usc:hasHeading "Limitation on court action" ;
  fro-usc:hasId "id839f473f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/e" ;
  fro-usc:hasNumberText "(e)" ;
.
