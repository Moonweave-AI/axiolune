.
fro-usc-t12-ch53:id83afe9e9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-3-6-0> ;
  fro-usc:hasHeading "Definition of Designated Transfer Date" ;
  fro-usc:hasId "id83afe9e9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Notice of Secretary of the Treasury, Sept. 20, 2010 , 75 F.R. 57252, provided that the designated transfer date is July 21, 2011 ." ;
  fro-usc:hasNoteTopic "prospectiveAmendment" ;
.
fro-usc-t12-ch53:id83afe9ea-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-8-3-6-1> ;
