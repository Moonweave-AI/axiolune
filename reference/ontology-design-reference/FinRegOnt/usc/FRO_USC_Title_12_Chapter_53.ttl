fro-usc-t12-ch53:id83b25af3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-4-3-3> ;
  fro-usc:hasContentText "recommendations for legislation to ensure the appropriate protection of consumers who use exchange facilitators for transactions primarily for personal, family, or household purposes;" ;
  fro-usc:hasId "id83b25af3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5603/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25af4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-4-3-4> ;
  fro-usc:hasContentText "recommendations for updating the regulations of Federal departments and agencies to ensure the appropriate protection of such consumers; and" ;
  fro-usc:hasId "id83b25af4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5603/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25af5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-4-3-5> ;
  fro-usc:hasContentText "recommendations for regulations to ensure the appropriate protection of such consumers." ;
  fro-usc:hasId "id83b25af5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5603/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83b25af6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-4-4> ;
  fro-usc:hasContentText "Not later than 2 years after the date of the submission of the report under subsection (b), the Bureau shall, consistent with part B, propose regulations or otherwise establish a program to protect consumers who use exchange facilitators." ;
  fro-usc:hasHeading "Program" ;
  fro-usc:hasId "id83b25af6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5603/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83b25af7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25af8-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25af9-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b25afa-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-4-5> ;
  fro-usc:hasHeading "Exchange facilitator defined" ;
  fro-usc:hasId "id83b25af7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5603/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-9-4-5-2> ;
.
fro-usc-t12-ch53:id83b25af8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-4-5-3> ;
  fro-usc:hasContentText "facilitates, for a fee, an exchange of like kind property by entering into an agreement with a taxpayer by which the exchange facilitator acquires from the taxpayer the contractual rights to sell the taxpayer’s relinquished property and transfers a replacement property to the taxpayer as a qualified intermediary (within the meaning of Treasury Regulations section 1.1031(k)–1(g)(4)) or enters into an agreement with the taxpayer to take title to a property as an exchange accommodation titleholder (within the meaning of Revenue Procedure 2000–37) or enters into an agreement with a taxpayer to act as a qualified trustee or qualified escrow holder (within the meaning of Treasury Regulations section 1.1031(k)–1(g)(3));" ;
  fro-usc:hasId "id83b25af8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5603/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b25af9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-4-5-4> ;
  fro-usc:hasContentText "maintains an office for the purpose of soliciting business to perform the services described in paragraph (1); or" ;
  fro-usc:hasId "id83b25af9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5603/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83b25afa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-9-4-5-5> ;
  fro-usc:hasContentText "advertises any of the services described in paragraph (1) or solicits clients in printed publications, direct mail, television or radio advertisements, telephone calls, facsimile transmissions, or other electronic communications directed to the general public for purposes of providing any such services." ;
  fro-usc:hasId "id83b25afa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5603/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
