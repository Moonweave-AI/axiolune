  fro-usc:hasContentText "recruiting at historically black colleges and universities, Hispanic-serving institutions, women’s colleges, and colleges that typically serve majority minority populations;" ;
  fro-usc:hasId "id83a40272-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5452/f/1" ;
