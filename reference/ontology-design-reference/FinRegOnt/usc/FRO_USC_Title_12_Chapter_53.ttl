.
fro-usc-t12-ch53:id839cd674-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-2-3> ;
  fro-usc:hasContentText "to which the covered financial company is a party;" ;
  fro-usc:hasId "id839cd674-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839cd675-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-2-4> ;
  fro-usc:hasContentText "the performance of which the Corporation as receiver, in the discretion of the Corporation, determines to be burdensome; and" ;
  fro-usc:hasId "id839cd675-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839cd676-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-2-5> ;
  fro-usc:hasContentText "the disaffirmance or repudiation of which the Corporation as receiver determines, in the discretion of the Corporation, will promote the orderly administration of the affairs of the covered financial company." ;
  fro-usc:hasId "id839cd676-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839cd677-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-3> ;
  fro-usc:hasContentText "The Corporation, as receiver for any covered financial company, shall determine whether or not to exercise the rights of repudiation under this section within a reasonable period of time." ;
  fro-usc:hasHeading "Timing of repudiation" ;
  fro-usc:hasId "id839cd677-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
