  fro-usc:hasContentText "examination or enforcement powers authority under this title  with respect to a covered person or service provider engaging in an activity described in subparagraph (A)(ix); or" ;
  fro-usc:hasId "id83a67403-1df7-11e6-87ee-8e4a3ab90f2a" ;
