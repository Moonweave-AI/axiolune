fro-usc-t12-ch53:id83a67410-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-23-5> ;
  fro-usc:hasContentText "an investment company that is required to be registered under the Investment Company Act of 1940 [ 15 U.S.C. 80a–1 et seq.], and any company that has elected to be regulated as a business development company under that Act;" ;
  fro-usc:hasId "id83a67410-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/21/C" ;
