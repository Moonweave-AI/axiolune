  fro-usc:hasHeading "No liability after assignment and sale" ;
  fro-usc:hasId "id839cd6a6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/6/C/ii" ;
