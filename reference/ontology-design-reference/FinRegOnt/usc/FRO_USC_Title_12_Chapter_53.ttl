  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-14-2-3> ;
  fro-usc:hasContentText "The study required by this section shall include recommendations for the optimal structure of any limits considered in subparagraphs (A) through (E), in order to maximize their effectiveness and minimize their economic impact." ;
  fro-usc:hasHeading "Recommendations" ;
  fro-usc:hasId "id8395aaa8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5333/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id8395aaa9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-14-3> ;
  fro-usc:hasContentText "Not later than the end of the 180-day period beginning on July 21, 2010 , and not later than every 5 years thereafter, the Chairperson shall issue a report to the Congress containing any findings and determinations made in carrying out the study required under subsection (a)." ;
  fro-usc:hasHeading "Report" ;
  fro-usc:hasId "id8395aaa9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5333/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id8395aaaa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "id8395aaaa-1df7-11e6-87ee-8e4a3ab90f2a" ;
