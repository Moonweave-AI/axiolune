fro-usc-t12-ch53:id83a673b2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-3> ;
  fro-usc:hasContentText "The term “affiliate” means any person that controls, is controlled by, or is under common control with another person." ;
  fro-usc:hasHeading "Affiliate" ;
  fro-usc:hasId "id83a673b2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a673b3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-4> ;
  fro-usc:hasContentText "The term “Bureau” means the Bureau of Consumer Financial Protection." ;
  fro-usc:hasHeading "Bureau" ;
  fro-usc:hasId "id83a673b3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a673b4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-5> ;
  fro-usc:hasContentText "The term “business of insurance” means the writing of insurance or the reinsuring of risks by an insurer, including all acts necessary to such writing or reinsuring and the activities relating to the writing of insurance or the reinsuring of risks conducted by persons who act as, or are, officers, directors, agents, or employees of insurers or who are other persons authorized to act on behalf of such persons." ;
  fro-usc:hasHeading "Business of insurance" ;
  fro-usc:hasId "id83a673b4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a673b5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-6> ;
  fro-usc:hasContentText "The term “consumer” means an individual or an agent, trustee, or representative acting on behalf of an individual." ;
  fro-usc:hasHeading "Consumer" ;
  fro-usc:hasId "id83a673b5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/4" ;
  fro-usc:hasNumberText "(4)" ;
.
fro-usc-t12-ch53:id83a673b6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-7> ;
  fro-usc:hasHeading "Consumer financial product or service" ;
  fro-usc:hasId "id83a673b6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-7-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673b7-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673b8-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a673b7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-7-3> ;
  fro-usc:hasContentText "paragraph (15) and is offered or provided for use by consumers primarily for personal, family, or household purposes; or" ;
  fro-usc:hasId "id83a673b7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/5/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a673b8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-7-4> ;
  fro-usc:hasContentText "clause (i), (iii), (ix), or (x) of paragraph (15)(A), and is delivered, offered, or provided in connection with a consumer financial product or service referred to in subparagraph (A)." ;
  fro-usc:hasId "id83a673b8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/5/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a673b9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-8> ;
  fro-usc:hasHeading "Covered person" ;
  fro-usc:hasId "id83a673b9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-8-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673ba-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673bb-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a673ba-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-8-3> ;
  fro-usc:hasContentText "any person that engages in offering or providing a consumer financial product or service; and" ;
  fro-usc:hasId "id83a673ba-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/6/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a673bb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-8-4> ;
  fro-usc:hasContentText "any affiliate of a person described in subparagraph (A) if such affiliate acts as a service provider to such person." ;
  fro-usc:hasId "id83a673bb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a673bc-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-9> ;
  fro-usc:hasContentText "The term “credit” means the right granted by a person to a consumer to defer payment of a debt, incur debt and defer its payment, or purchase property or services and defer payment for such purchase." ;
  fro-usc:hasHeading "Credit" ;
  fro-usc:hasId "id83a673bc-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/7" ;
  fro-usc:hasNumberText "(7)" ;
.
fro-usc-t12-ch53:id83a673bd-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-10> ;
  fro-usc:hasHeading "Deposit-taking activity" ;
  fro-usc:hasId "id83a673bd-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/8" ;
  fro-usc:hasNumberText "(8)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-10-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673be-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673bf-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673c0-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a673be-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-10-3> ;
  fro-usc:hasContentText "the acceptance of deposits, maintenance of deposit accounts, or the provision of services related to the acceptance of deposits or the maintenance of deposit accounts;" ;
  fro-usc:hasId "id83a673be-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/8/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a673bf-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-10-4> ;
  fro-usc:hasContentText "the acceptance of funds, the provision of other services related to the acceptance of funds, or the maintenance of member share accounts by a credit union; or" ;
  fro-usc:hasId "id83a673bf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/8/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a673c0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-10-5> ;
  fro-usc:hasContentText "the receipt of funds or the equivalent thereof, as the Bureau may determine by rule or order, received or held by a covered person (or an agent for a covered person) for the purpose of facilitating a payment or transferring funds or value of funds between a consumer and a third party." ;
  fro-usc:hasId "id83a673c0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/8/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a673c1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-11> ;
  fro-usc:hasContentText "The term “designated transfer date” means the date established under section 5582 of this title ." ;
  fro-usc:hasHeading "Designated transfer date" ;
  fro-usc:hasId "id83a673c1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/9" ;
  fro-usc:hasNumberText "(9)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5582" ;
.
fro-usc-t12-ch53:id83a673c2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-12> ;
  fro-usc:hasContentText "The term “Director” means the Director of the Bureau." ;
  fro-usc:hasHeading "Director" ;
  fro-usc:hasId "id83a673c2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/10" ;
  fro-usc:hasNumberText "(10)" ;
.
fro-usc-t12-ch53:id83a673c3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-13> ;
  fro-usc:hasHeading "Electronic conduit services" ;
  fro-usc:hasId "id83a673c3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/11" ;
  fro-usc:hasNumberText "(11)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-13-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673c4-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673c5-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a673c4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-13-3> ;
  fro-usc:hasContentText "means the provision, by a person, of electronic data transmission, routing, intermediate or transient storage, or connections to a telecommunications system or network; and" ;
  fro-usc:hasId "id83a673c4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/11/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a673c5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-13-4> ;
  fro-usc:hasId "id83a673c5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/11/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-2-13-4-1> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673c6-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673c7-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a673c8-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a673c6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-13-4-2> ;
  fro-usc:hasContentText "selects or modifies the content of the electronic data;" ;
  fro-usc:hasId "id83a673c6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/11/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a673c7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-13-4-3> ;
  fro-usc:hasContentText "transmits, routes, stores, or provides connections for electronic data, including financial data, in a manner that such financial data is differentiated from other types of data of the same form that such person transmits, routes, or stores, or with respect to which, provides connections; or" ;
  fro-usc:hasId "id83a673c7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/11/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a673c8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-13-4-4> ;
  fro-usc:hasContentText "is a payee, payor, correspondent, or similar party to a payment transaction with a consumer." ;
  fro-usc:hasId "id83a673c8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/11/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
