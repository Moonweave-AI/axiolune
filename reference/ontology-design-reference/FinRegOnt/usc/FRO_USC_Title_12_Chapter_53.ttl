.
fro-usc-t12-ch53:id8395aa99-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-13-3-2-4> ;
  fro-usc:hasContentText "any records or other information under the control of a person or entity acting on behalf of or under the authority of the Council, to the extent that such records or other information is relevant to an audit under subsection (a); and" ;
  fro-usc:hasId "id8395aa99-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5332/b/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id8395aa9a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-13-3-2-5> ;
  fro-usc:hasContentText "the officers, directors, employees, financial advisors, staff, working groups, and agents and representatives of the Council (as related to the activities on behalf of the Council of such agent or representative), at such reasonable times as the Comptroller General may request." ;
  fro-usc:hasId "id8395aa9a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5332/b/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id8395aa9b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-3-13-3-3> ;
  fro-usc:hasContentText "The Comptroller General may make and retain copies of such books, accounts, and other records, access to which is granted under this section, as the Comptroller General considers appropriate." ;
  fro-usc:hasHeading "Copies" ;
  fro-usc:hasId "id8395aa9b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5332/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
