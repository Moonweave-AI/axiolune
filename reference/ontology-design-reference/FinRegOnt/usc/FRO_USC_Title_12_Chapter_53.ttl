  fro-usc:hasHeading "Services performed after appointment and prior to repudiation" ;
  fro-usc:hasId "id839cd6ab-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/7/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-4-8-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6ac-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839cd6ad-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839cd6ac-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-8-3-3> ;
  fro-usc:hasContentText "the other party shall be paid under the terms of the contract for the services performed; and" ;
  fro-usc:hasId "id839cd6ac-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/7/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839cd6ad-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-8-3-4> ;
  fro-usc:hasContentText "the amount of such payment shall be treated as an administrative expense of the receivership." ;
  fro-usc:hasId "id839cd6ad-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/7/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd6ae-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-8-4> ;
  fro-usc:hasContentText "The acceptance by the Corporation as receiver for services referred to in subparagraph (B) in connection with a contract described in subparagraph (B) shall not affect the right of the Corporation as receiver to repudiate such contract under this section at any time after such performance." ;
  fro-usc:hasHeading "Acceptance of performance no bar to subsequent repudiation" ;
  fro-usc:hasId "id839cd6ae-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/7/C" ;
  fro-usc:hasNumberText "(C)" ;
.
