  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-2-17-2-12> ;
  fro-usc:hasContentText "collecting debt related to any consumer financial product or service; and" ;
  fro-usc:hasId "id83a673f7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5481/15/A/x" ;
