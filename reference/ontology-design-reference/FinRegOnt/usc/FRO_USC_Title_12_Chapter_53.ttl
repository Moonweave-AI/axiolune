.
fro-usc-t12-ch53:id83b4a4a2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-7> ;
  fro-usc:hasContentText "The requirements of this section shall not apply to covered financial institutions with assets of less than $1,000,000,000." ;
  fro-usc:hasHeading "Exemption for certain financial institutions" ;
  fro-usc:hasId "id83b4a4a2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/f" ;
  fro-usc:hasNumberText "(f)" ;
.
fro-usc-t12-ch53:id83b4a4a3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
