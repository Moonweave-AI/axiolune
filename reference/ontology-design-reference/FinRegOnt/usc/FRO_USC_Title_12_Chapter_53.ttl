  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83ab2ec2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section effective on the designated transfer date, see section 1029A of Pub. L. 111–203 , set out as a note under section 5511 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1029A" ;
