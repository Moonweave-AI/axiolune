.
fro-usc-t12-ch53:id83a191e7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-8-3-3> ;
  fro-usc:hasContentText "separate an employee for cause or for unacceptable performance;" ;
  fro-usc:hasId "id83a191e7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/g/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a191e8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-8-3-4> ;
  fro-usc:hasContentText "terminate an appointment to a position excepted from the competitive service because of its confidential policy-making, policy-determining, or policy-advocating character; or" ;
  fro-usc:hasId "id83a191e8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/g/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a191e9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-8-3-5> ;
  fro-usc:hasContentText "reassign an employee outside such employee’s locality pay area when the Office of the Comptroller of the Currency or the Corporation determines that the reassignment is necessary for the efficient operation of the agency." ;
  fro-usc:hasId "id83a191e9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/g/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a191ea-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191eb-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191ec-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191ef-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83a191f0-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-9> ;
  fro-usc:hasHeading "Pay" ;
  fro-usc:hasId "id83a191ea-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/h" ;
  fro-usc:hasNumberText "(h)" ;
.
fro-usc-t12-ch53:id83a191eb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-9-2> ;
  fro-usc:hasContentText "Except as provided in paragraph (2), during the 30-month period beginning on the date on which the employee was transferred under this part, a transferred employee shall be paid at a rate that is not less than the basic rate of pay, including any geographic differential, that the transferred employee received during the pay period immediately preceding the date on which the employee was transferred. Notwithstanding the preceding sentence, if the employee was receiving a higher rate of basic pay on a temporary basis (because of a temporary assignment, temporary promotion, or other temporary action) immediately before the transfer, the Agency may reduce the rate of basic pay on the date the rate would have been reduced but for the transfer, and the protected rate for the remainder of the 30-month period will be the reduced rate that would have applied but for the transfer." ;
  fro-usc:hasHeading "30-month protection" ;
  fro-usc:hasId "id83a191eb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/h/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a191ec-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-9-3> ;
  fro-usc:hasHeading "Exceptions" ;
  fro-usc:hasId "id83a191ec-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/h/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-8-5-3-9-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191ed-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a191ee-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a191ed-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-9-3-3> ;
  fro-usc:hasContentText "for cause, including for unacceptable performance; or" ;
  fro-usc:hasId "id83a191ed-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/h/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a191ee-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-9-3-4> ;
  fro-usc:hasContentText "with the consent of the transferred employee." ;
  fro-usc:hasId "id83a191ee-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/h/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a191ef-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-9-4> ;
  fro-usc:hasContentText "This subsection shall apply to a transferred employee only during the period that the transferred employee remains employed by Office of the Comptroller of the Currency or the Corporation." ;
  fro-usc:hasHeading "Protection only while employed" ;
  fro-usc:hasId "id83a191ef-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/h/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a191f0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-8-5-3-9-5> ;
  fro-usc:hasContentText "Nothing in this subsection shall limit the authority of the Comptroller of the Currency or the Chairperson of the Corporation to increase the pay of a transferred employee." ;
  fro-usc:hasHeading "Pay increases permitted" ;
  fro-usc:hasId "id83a191f0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5432/h/4" ;
  fro-usc:hasNumberText "(4)" ;
.
