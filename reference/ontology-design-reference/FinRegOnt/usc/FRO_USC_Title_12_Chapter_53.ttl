.
fro-usc-t12-ch53:id839cd6b1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-2-3> ;
  fro-usc:hasContentText "any right that such person has to cause the termination, liquidation, or acceleration of any qualified financial contract with a covered financial company which arises upon the date of appointment of the Corporation as receiver for such covered financial company or at any time after such appointment;" ;
  fro-usc:hasId "id839cd6b1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id839cd6b2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-2-4> ;
  fro-usc:hasContentText "any right under any security agreement or arrangement or other credit enhancement related to one or more qualified financial contracts described in clause (i); or" ;
  fro-usc:hasId "id839cd6b2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id839cd6b3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-2-5> ;
  fro-usc:hasContentText "any right to offset or net out any termination value, payment amount, or other transfer obligation arising under or in connection with 1 or more contracts or agreements described in clause (i), including any master agreement for such contracts or agreements." ;
  fro-usc:hasId "id839cd6b3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
fro-usc-t12-ch53:id839cd6b4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-4-9-3> ;
  fro-usc:hasContentText "Subsection (a)(8) shall apply in the case of any judicial action or proceeding brought against the Corporation as receiver referred to in subparagraph (A), or the subject covered financial company, by any party to a contract or agreement described in subparagraph (A)(i) with such covered financial company." ;
  fro-usc:hasHeading "Applicability of other provisions" ;
  fro-usc:hasId "id839cd6b4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/c/8/B" ;
  fro-usc:hasNumberText "(B)" ;
.
