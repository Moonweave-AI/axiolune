  fro-usc:hasContentText "for administering an existing retirement plan (including the Federal Reserve System Retirement Plan or Federal Reserve System Thrift Plan); or" ;
  fro-usc:hasId "id83b25a79-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5584/i/1/C/ii/II" ;
