  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-3-7> ;
  fro-usc:hasHeading "Study of international coordination relating to bankruptcy process for financial companies" ;
  fro-usc:hasId "id839a8bd7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5382/f" ;
  fro-usc:hasNumberText "(f)" ;
.
