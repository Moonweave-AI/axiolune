.
fro-usc-t12-ch53:id83981b8d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-15-3> ;
  fro-usc:hasContentText "engaged in the business of insurance;" ;
  fro-usc:hasId "id83981b8d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/13/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83981b8e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-15-4> ;
  fro-usc:hasContentText "subject to regulation by a State insurance regulator; and" ;
  fro-usc:hasId "id83981b8e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/13/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83981b8f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-15-5> ;
  fro-usc:hasContentText "covered by a State law that is designed to specifically deal with the rehabilitation, liquidation, or insolvency of an insurance company." ;
  fro-usc:hasId "id83981b8f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/13/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83981b90-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-16> ;
  fro-usc:hasContentText "The term “nonbank financial company” has the same meaning as in section 5311(a)(4)(C) of this title ." ;
  fro-usc:hasHeading "Nonbank financial company" ;
  fro-usc:hasId "id83981b90-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/14" ;
  fro-usc:hasNumberText "(14)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5311/a/4/C" ;
.
fro-usc-t12-ch53:id83981b91-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-17> ;
  fro-usc:hasContentText "The term “nonbank financial company supervised by the Board of Governors” has the same meaning as in section 5311(a)(4)(D) of this title ." ;
  fro-usc:hasHeading "Nonbank financial company supervised by the Board of Governors" ;
  fro-usc:hasId "id83981b91-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/15" ;
  fro-usc:hasNumberText "(15)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5311/a/4/D" ;
.
fro-usc-t12-ch53:id83981b92-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-2-18> ;
  fro-usc:hasContentText "The term “SIPC” means the Securities Investor Protection Corporation." ;
  fro-usc:hasHeading "SIPC" ;
  fro-usc:hasId "id83981b92-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/a/16" ;
  fro-usc:hasNumberText "(16)" ;
.
fro-usc-t12-ch53:id83981b93-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-3> ;
  fro-usc:hasContentText "For purpose of the definition of the term “financial company” under subsection (a)(11), no company shall be deemed to be predominantly engaged in activities that the Board of Governors has determined are financial in nature or incidental thereto for purposes of section 1843(k) of this title , if the consolidated revenues of such company from such activities constitute less than 85 percent of the total consolidated revenues of such company, as the Corporation, in consultation with the Secretary, shall establish by regulation. In determining whether a company is a financial company under this subchapter, the consolidated revenues derived from the ownership or control of a depository institution shall be included." ;
  fro-usc:hasHeading "Definitional criteria" ;
  fro-usc:hasId "id83981b93-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5381/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1843/k" ;
.
fro-usc-t12-ch53:id83981b94-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "id83981b94-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tII" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title II , § 201, July 21, 2010 , 124 Stat. 1442 .)" ;
.
fro-usc-t12-ch53:id83981b96-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83981b96-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "The Farm Credit Act of 1971, referred to in subsec. (a)(11)(C), is Pub. L. 92–181 , Dec. 10, 1971 , 85 Stat. 583 , which is classified principally to chapter 23 (§ 2001 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 2001 of this title and Tables." ;
  fro-usc:hasNoteText "This subchapter, referred to in text, was in the original “this title”, meaning title II of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1442 , which is classified principally to this subchapter. For complete classification of title II to the Code, see Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/92/181" ;
  fro-usc:hasReferenceText "/us/stat/124/1442" ;
  fro-usc:hasReferenceText "/us/stat/85/583" ;
  fro-usc:hasReferenceText "/us/usc/t12/s2001" ;
.
fro-usc-t12-ch53:id83981b97-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-2-5-1> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "id83981b97-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Subchapter effective 1 day after July 21, 2010 , except as otherwise provided, see section 4 of Pub. L. 111–203 , set out as a note under section 5301 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s4" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
