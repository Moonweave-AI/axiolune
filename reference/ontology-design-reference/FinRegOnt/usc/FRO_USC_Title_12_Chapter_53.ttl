  fro-usc:hasContentText "impose substantively similar requirements on covered persons;" ;
  fro-usc:hasId "id83ad77e5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5533/e/1" ;
