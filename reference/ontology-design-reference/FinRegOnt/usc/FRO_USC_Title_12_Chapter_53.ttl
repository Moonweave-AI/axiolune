  fro-usc:hasContentText "resources required for funding such a process; and" ;
  fro-usc:hasId "id83a8bcaf-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5493/d/7/A/i/III" ;
