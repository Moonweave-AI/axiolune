fro-usc-t12-ch53:id83936026-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-5-2> ;
  fro-usc:hasContentText "any futures commission merchant registered with the Commodity Futures Trading Commission under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.), with respect to the activities of the futures commission merchant that require the futures commission merchant to be registered under that Act;" ;
  fro-usc:hasId "id83936026-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/C/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
fro-usc-t12-ch53:id83936027-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-5-3> ;
  fro-usc:hasContentText "any commodity pool operator registered with the Commodity Futures Trading Commission under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.), with respect to the activities of the commodity pool operator that require the commodity pool operator to be registered under that Act, or a commodity pool, as defined in that Act;" ;
  fro-usc:hasId "id83936027-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
fro-usc-t12-ch53:id83936028-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-5-4> ;
  fro-usc:hasContentText "any commodity trading advisor or introducing broker registered with the Commodity Futures Trading Commission under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.), with respect to the activities of the commodity trading advisor or introducing broker that require the commodity trading adviser or introducing broker to be registered under that Act;" ;
  fro-usc:hasId "id83936028-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/C/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
fro-usc-t12-ch53:id83936029-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-5-5> ;
  fro-usc:hasContentText "any derivatives clearing organization registered with the Commodity Futures Trading Commission under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.), with respect to the activities of the derivatives clearing organization that require the derivatives clearing organization to be registered under that Act;" ;
  fro-usc:hasId "id83936029-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/C/iv" ;
  fro-usc:hasNumberText "(iv)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
fro-usc-t12-ch53:id8393602a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-3-14-5-6> ;
  fro-usc:hasContentText "any board of trade designated as a contract market by the Commodity Futures Trading Commission under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.);" ;
  fro-usc:hasId "id8393602a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5301/12/C/v" ;
