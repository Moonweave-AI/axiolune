fro-usc-t12-ch53:id83a402a3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-3-3> ;
  fro-usc:hasContentText "the primary financial regulatory agency, as defined in section 5301 of this title ;" ;
  fro-usc:hasId "id83a402a3-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
.
fro-usc-t12-ch53:id83a402a4-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-3-4> ;
  fro-usc:hasContentText "the National Credit Union Administration, with respect to any insured credit union under the Federal Credit Union Act ( 12 U.S.C. 1751 et seq.); and" ;
  fro-usc:hasId "id83a402a4-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1751" ;
.
fro-usc-t12-ch53:id83a402a5-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-3-5> ;
  fro-usc:hasContentText "the Board of Governors, with respect to organizations operating under section 25A of the Federal Reserve Act ( 12 U.S.C. 611 ), and any other financial institution engaged in a designated activity." ;
  fro-usc:hasId "id83a402a5-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/1/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s611" ;
.
fro-usc-t12-ch53:id83a402a6-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-4> ;
  fro-usc:hasContentText "The term “designated activity” means a payment, clearing, or settlement activity that the Council has designated as systemically important under section 5463 of this title ." ;
  fro-usc:hasHeading "Designated activity" ;
  fro-usc:hasId "id83a402a6-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5463" ;
.
fro-usc-t12-ch53:id83a402a7-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-5> ;
  fro-usc:hasContentText "The term “designated clearing entity” means a designated financial market utility that is a derivatives clearing organization registered under section 5b of the Commodity Exchange Act ( 7 U.S.C. 7a–1 ) or a clearing agency registered with the Securities and Exchange Commission under section 17A of the Securities Exchange Act of 1934 ( 15 U.S.C. 78q–1 )." ;
  fro-usc:hasHeading "Designated clearing entity" ;
  fro-usc:hasId "id83a402a7-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78q–1" ;
  fro-usc:hasReferenceText "/us/usc/t7/s7a–1" ;
.
fro-usc-t12-ch53:id83a402a8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-3-6> ;
  fro-usc:hasContentText "The term “designated financial market utility” means a financial market utility that the Council has designated as systemically important under section 5463 of this title ." ;
  fro-usc:hasHeading "Designated financial market utility" ;
  fro-usc:hasId "id83a402a8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5462/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5463" ;
.
