  lkif-mereo:component fro-usc-t12-ch53:id83a8bd75-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd73-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-8-2> ;
  fro-usc:hasContentText "The Bureau may prescribe rules regarding registration requirements applicable to a covered person, other than an insured depository institution, insured credit union, or related person." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a8bd73-1df7-11e6-87ee-8e4a3ab90f2a" ;
