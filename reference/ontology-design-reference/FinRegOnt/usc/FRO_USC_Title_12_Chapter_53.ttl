.
fro-usc-t12-ch53:id83a1911a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-2-4> ;
  fro-usc:hasContentText "a description of any material sales, transfers, mergers, obligations, purchases, and other material transactions entered into by the Corporation;" ;
  fro-usc:hasId "id83a1911a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a1911b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-2-5> ;
  fro-usc:hasContentText "an evaluation of the adequacy of the policies and procedures of the Corporation under section 5383(d) of this title and orderly liquidation plan under section 5390(n)(14)  1 of this title;" ;
  fro-usc:hasId "id83a1911b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/1/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5383/d" ;
.
fro-usc-t12-ch53:id83a1911c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-2-6> ;
  fro-usc:hasContentText "an evaluation of the utilization by the Corporation of the private sector in carrying out its functions, including the adequacy of any conflict-of-interest reviews; and" ;
  fro-usc:hasId "id83a1911c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83a1911d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-2-7> ;
  fro-usc:hasContentText "an evaluation of the overall performance of the Corporation in liquidating the covered financial company, including administrative costs, timeliness of liquidation process, and impact on the financial system." ;
  fro-usc:hasId "id83a1911d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/1/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83a1911e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-3> ;
  fro-usc:hasContentText "Not later than 6 months after the date of appointment of the Corporation as receiver under this subchapter and every 6 months thereafter, the Inspector General of the Corporation shall conduct the audit and investigation described in paragraph (1)." ;
  fro-usc:hasHeading "Frequency" ;
  fro-usc:hasId "id83a1911e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83a1911f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-4> ;
  fro-usc:hasContentText "The Inspector General of the Corporation shall include in the semiannual reports required by section 5(a) of the Inspector General Act of 1978 (5 U.S.C. App.), a summary of the findings and evaluations under paragraph (1), and shall appear before the appropriate committees of Congress, if requested, to present each such report." ;
  fro-usc:hasHeading "Reports and testimony" ;
  fro-usc:hasId "id83a1911f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a19120-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-5> ;
  fro-usc:hasHeading "Funding" ;
  fro-usc:hasId "id83a19120-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/4" ;
  fro-usc:hasNumberText "(4)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a19121-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a19122-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a19121-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-5-2> ;
  fro-usc:hasContentText "The expenses of the Inspector General of the Corporation in carrying out this subsection shall be considered administrative expenses of the receivership." ;
  fro-usc:hasHeading "Initial funding" ;
  fro-usc:hasId "id83a19121-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a19122-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-5-3> ;
  fro-usc:hasContentText "If the maximum amount available to the Corporation as receiver under this subchapter is insufficient to enable the Inspector General of the Corporation to carry out the duties under this subsection, the Corporation shall pay such additional amounts from assessments imposed under section 5390 of this title ." ;
  fro-usc:hasHeading "Additional funding" ;
  fro-usc:hasId "id83a19122-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/4/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5390" ;
.
fro-usc-t12-ch53:id83a19123-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-12-3-6> ;
  fro-usc:hasContentText "The duties and responsibilities of the Inspector General of the Corporation under this subsection shall terminate 1 year after the date of termination of the receivership under this subchapter." ;
  fro-usc:hasHeading "Termination of responsibilities" ;
  fro-usc:hasId "id83a19123-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5391/d/5" ;
  fro-usc:hasNumberText "(5)" ;
.
