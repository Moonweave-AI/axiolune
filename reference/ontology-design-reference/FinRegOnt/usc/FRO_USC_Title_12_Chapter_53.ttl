.
fro-usc-t12-ch53:id83a8bd5a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-3-3> ;
  fro-usc:hasContentText "likely risks and costs to consumers associated with buying or using a type of consumer financial product or service;" ;
  fro-usc:hasId "id83a8bd5a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a8bd5b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-3-4> ;
  fro-usc:hasContentText "understanding by consumers of the risks of a type of consumer financial product or service;" ;
  fro-usc:hasId "id83a8bd5b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a8bd5c-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-3-5> ;
  fro-usc:hasContentText "the legal protections applicable to the offering or provision of a consumer financial product or service, including the extent to which the law is likely to adequately protect consumers;" ;
  fro-usc:hasId "id83a8bd5c-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a8bd5d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-3-6> ;
  fro-usc:hasContentText "rates of growth in the offering or provision of a consumer financial product or service;" ;
  fro-usc:hasId "id83a8bd5d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
fro-usc-t12-ch53:id83a8bd5e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-3-7> ;
  fro-usc:hasContentText "the extent, if any, to which the risks of a consumer financial product or service may disproportionately affect traditionally underserved consumers; or" ;
  fro-usc:hasId "id83a8bd5e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/2/E" ;
  fro-usc:hasNumberText "(E)" ;
.
fro-usc-t12-ch53:id83a8bd5f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-3-8> ;
  fro-usc:hasContentText "the types, number, and other pertinent characteristics of covered persons that offer or provide the consumer financial product or service." ;
  fro-usc:hasId "id83a8bd5f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/2/F" ;
  fro-usc:hasNumberText "(F)" ;
.
fro-usc-t12-ch53:id83a8bd60-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-4> ;
  fro-usc:hasHeading "Significant findings" ;
  fro-usc:hasId "id83a8bd60-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd61-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd62-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd61-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-4-2> ;
  fro-usc:hasContentText "The Bureau shall publish not fewer than 1 report of significant findings of its monitoring required by this subsection in each calendar year, beginning with the first calendar year that begins at least 1 year after the designated transfer date." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a8bd61-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a8bd62-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-4-3> ;
  fro-usc:hasContentText "The Bureau may make public such information obtained by the Bureau under this section as is in the public interest, through aggregated reports or other appropriate formats designed to protect confidential information in accordance with paragraphs (4), (6), (8), and (9)." ;
  fro-usc:hasHeading "Confidential information" ;
  fro-usc:hasId "id83a8bd62-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id83a8bd63-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-5> ;
  fro-usc:hasHeading "Collection of information" ;
  fro-usc:hasId "id83a8bd63-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/4" ;
  fro-usc:hasNumberText "(4)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd64-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd65-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd68-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd64-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-5-2> ;
  fro-usc:hasContentText "In conducting any monitoring or assessment required by this section, the Bureau shall have the authority to gather information from time to time regarding the organization, business conduct, markets, and activities of covered persons and service providers." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83a8bd64-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id83a8bd65-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-5-3> ;
  fro-usc:hasHeading "Methodology" ;
  fro-usc:hasId "id83a8bd65-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/4/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-10-4-3-4-5-3-2> ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd66-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd67-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd66-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-5-3-3> ;
  fro-usc:hasContentText "gather and compile information from a variety of sources, including examination reports concerning covered persons or service providers, consumer complaints, voluntary surveys and voluntary interviews of consumers, surveys and interviews with covered persons and service providers, and review of available databases; and" ;
  fro-usc:hasId "id83a8bd66-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/4/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
fro-usc-t12-ch53:id83a8bd67-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-5-3-4> ;
  fro-usc:hasContentText "require covered persons and service providers participating in consumer financial services markets to file with the Bureau, under oath or otherwise, in such form and within such reasonable period of time as the Bureau may prescribe by rule or order, annual or special reports, or answers in writing to specific questions, furnishing information described in paragraph (4), as necessary for the Bureau to fulfill the monitoring, assessment, and reporting responsibilities imposed by Congress." ;
  fro-usc:hasId "id83a8bd67-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/4/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
fro-usc-t12-ch53:id83a8bd68-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-5-4> ;
  fro-usc:hasContentText "The Bureau may not use its authorities under this paragraph to obtain records from covered persons and service providers participating in consumer financial services markets for purposes of gathering or analyzing the personally identifiable financial information of consumers." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id83a8bd68-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/4/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id83a8bd69-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-6> ;
  fro-usc:hasContentText "In order to assess whether a nondepository is a covered person, as defined in section 5481 of this title , the Bureau may require such nondepository to file with the Bureau, under oath or otherwise, in such form and within such reasonable period of time as the Bureau may prescribe by rule or order, annual or special reports, or answers in writing to specific questions." ;
  fro-usc:hasHeading "Limited information gathering" ;
  fro-usc:hasId "id83a8bd69-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5481" ;
.
fro-usc-t12-ch53:id83a8bd6a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-7> ;
  fro-usc:hasHeading "Confidentiality rules" ;
  fro-usc:hasId "id83a8bd6a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/6" ;
  fro-usc:hasNumberText "(6)" ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd6b-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd6c-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id83a8bd6f-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83a8bd6b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-3-4-7-2> ;
  fro-usc:hasContentText "The Bureau shall prescribe rules regarding the confidential treatment of information obtained from persons in connection with the exercise of its authorities under Federal consumer financial law." ;
  fro-usc:hasHeading "Rulemaking" ;
  fro-usc:hasId "id83a8bd6b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5512/c/6/A" ;
  fro-usc:hasNumberText "(A)" ;
.
