  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-2> ;
  fro-usc:hasHeading "Vote required" ;
  fro-usc:hasId "id839a8bec-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8bed-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8bee-1df7-11e6-87ee-8e4a3ab90f2a ;
  lkif-mereo:component fro-usc-t12-ch53:id839a8bef-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id839a8bed-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-2-2> ;
  fro-usc:hasContentText "On their own initiative, or at the request of the Secretary, the Corporation and the Board of Governors shall consider whether to make a written recommendation described in paragraph (2) with respect to whether the Secretary should appoint the Corporation as receiver for a financial company. Such recommendation shall be made upon a vote of not fewer than ⅔ of the members of the Board of Governors then serving and ⅔ of the members of the board of directors of the Corporation then serving." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id839a8bed-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
fro-usc-t12-ch53:id839a8bee-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-2-3> ;
  fro-usc:hasContentText "In the case of a broker or dealer, or in which the largest United States subsidiary (as measured by total assets as of the end of the previous calendar quarter) of a financial company is a broker or dealer, the Commission and the Board of Governors, at the request of the Secretary, or on their own initiative, shall consider whether to make the written recommendation described in paragraph (2) with respect to the financial company. Subject to the requirements in paragraph (2), such recommendation shall be made upon a vote of not fewer than ⅔ of the members of the Board of Governors then serving and ⅔ of the members of the Commission then serving, and in consultation with the Corporation." ;
  fro-usc:hasHeading "Cases involving brokers or dealers" ;
  fro-usc:hasId "id839a8bee-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
fro-usc-t12-ch53:id839a8bef-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-2-4> ;
  fro-usc:hasContentText "In the case of an insurance company, or in which the largest United States subsidiary (as measured by total assets as of the end of the previous calendar quarter) of a financial company is an insurance company, the Director of the Federal Insurance Office and the Board of Governors, at the request of the Secretary or on their own initiative, shall consider whether to make the written recommendation described in paragraph (2) with respect to the financial company. Subject to the requirements in paragraph (2), such recommendation shall be made upon a vote of not fewer than ⅔ of the Board of Governors then serving and the affirmative approval of the Director of the Federal Insurance Office, and in consultation with the Corporation." ;
  fro-usc:hasHeading "Cases involving insurance companies" ;
  fro-usc:hasId "id839a8bef-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5383/a/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
fro-usc-t12-ch53:id839a8bf0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-4-2-3> ;
  fro-usc:hasHeading "Recommendation required" ;
  fro-usc:hasId "id839a8bf0-1df7-11e6-87ee-8e4a3ab90f2a" ;
