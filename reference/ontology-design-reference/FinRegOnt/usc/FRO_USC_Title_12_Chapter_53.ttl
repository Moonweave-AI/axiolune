.
fro-usc-t12-ch53:id839f4761-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-3-9-2-3> ;
  fro-usc:hasContentText "be established and deemed registered with the Commission under the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.] and a member of SIPC;" ;
  fro-usc:hasId "id839f4761-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/2/H/i/I" ;
  fro-usc:hasNumberText "(I)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
fro-usc-t12-ch53:id839f4762-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-3-9-2-4> ;
  fro-usc:hasContentText "operate in accordance with such articles and this section; and" ;
  fro-usc:hasId "id839f4762-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/2/H/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
fro-usc-t12-ch53:id839f4763-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-7-11-9-3-9-2-5> ;
  fro-usc:hasContentText "succeed to any and all registrations and memberships of the covered financial company with or in any self-regulatory organizations." ;
  fro-usc:hasId "id839f4763-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/h/2/H/i/III" ;
  fro-usc:hasNumberText "(III)" ;
.
