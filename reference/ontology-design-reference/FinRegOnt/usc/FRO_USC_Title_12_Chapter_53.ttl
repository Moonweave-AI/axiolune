.
fro-usc-t12-ch53:id83a8bcf8-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-9-2-3> ;
  fro-usc:hasContentText "the impact of regulation on the financial marketplace, including the effects on the safety and soundness of regulated entities, cost and availability of credit, savings realized by consumers, reductions in consumer paperwork burden, changes in personal and small business bankruptcy filings, and costs of compliance with rules, including whether relevant Federal agencies are applying sound cost-benefit analysis in promulgating rules;" ;
  fro-usc:hasId "id83a8bcf8-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496b/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83a8bcf9-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-9-2-4> ;
  fro-usc:hasContentText "efforts to avoid duplicative or conflicting rulemakings, including an evaluation of the consultative process under subparagraphs (B) and (C) of section 5512(b)(2) of this title , information requests, and examinations; and" ;
  fro-usc:hasId "id83a8bcf9-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496b/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5512/b/2" ;
.
fro-usc-t12-ch53:id83a8bcfa-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-9-2-5> ;
  fro-usc:hasContentText "other matters related to the operations of financial services regulations deemed by the Comptroller General to be appropriate." ;
  fro-usc:hasId "id83a8bcfa-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496b/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
fro-usc-t12-ch53:id83a8bcfb-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-3-9-3> ;
  fro-usc:hasContentText "Not later than the end of the 30-day period following the completion of a study conducted pursuant to subsection (a), the Comptroller General shall issue a report to the Congress containing a detailed description of all findings and conclusions made by the Comptroller General in carrying out such study, together with such recommendations for legislative or administrative action as the Comptroller General may determine to be appropriate." ;
  fro-usc:hasHeading "Report" ;
  fro-usc:hasId "id83a8bcfb-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5496b/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83a8bcfc-1df7-11e6-87ee-8e4a3ab90f2a
