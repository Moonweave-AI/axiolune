  fro-usc:hasHeading "Fraudulent transfers" ;
  fro-usc:hasId "id839cd60e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5390/a/11/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t12-ch53:r-1-0-4-7-11-2-12-2-2> ;
