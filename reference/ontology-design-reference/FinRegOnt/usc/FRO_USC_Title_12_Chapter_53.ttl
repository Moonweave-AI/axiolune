  fro-usc:hasHeading "Codification" ;
  fro-usc:hasId "id83b4a447-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Section is comprised of section 1106 of Pub. L. 111–203 . Subsec. (b) of section 1106 of Pub. L. 111–203 amended section 1823 of this title ." ;
  fro-usc:hasNoteTopic "codification" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s1106" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1823" ;
.
fro-usc-t12-ch53:id83b4a448-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a449-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83b4a44a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83b4a44d-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-5> ;
  fro-usc:hasHeading "Exercise of Federal Reserve authority" ;
  fro-usc:hasId "id83b4a448-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5614" ;
  fro-usc:hasNumberText "§ 5614." ;
  lkif-mereo:component fro-usc-t12-ch53:id83b4a44b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83b4a449-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-5-2> ;
  fro-usc:hasContentText "No provision of subchapter I relating to the authority of the Board of Governors shall be construed as conferring any decision-making authority on presidents of Federal reserve banks." ;
  fro-usc:hasHeading "No decisions by Federal reserve bank presidents" ;
  fro-usc:hasId "id83b4a449-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5614/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83b4a44a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-5-3> ;
  fro-usc:hasContentText "The Board of Governors shall not delegate the authority to make any voting decision that the Board of Governors is authorized or required to make under subchapter I of this chapter in contravention of section 248(k) of this title ." ;
  fro-usc:hasHeading "Voting decisions by Board" ;
  fro-usc:hasId "id83b4a44a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5614/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s248/k" ;
.
fro-usc-t12-ch53:id83b4a44b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "id83b4a44b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tXI" ;
  fro-usc:hasReferenceText "/us/stat/124/2127" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title XI , § 1108(d), July 21, 2010 , 124 Stat. 2127 .)" ;
.
fro-usc-t12-ch53:id83b4a44d-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-11-5-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "id83b4a44d-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasNoteText "Subchapter I, referred to in text, was in the original “title I”, meaning title I of Pub. L. 111–203 , July 21, 2010 , 124 Stat. 1391 , known as the Financial Stability Act of 2010, which is classified principally to subchapter I (§ 5311 et seq.) of this chapter. For complete classification of title I to the Code, see Short Title note set out under section 5301 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/stat/124/1391" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:refers_toLevel fro-usc-t12-ch53:id8390f007-1df7-11e6-87ee-8e4a3ab90f2a ;
.
