fro-usc-t12-ch53:id83ab2e9e-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2e9f-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2ea0-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2ea1-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83ab2ea2-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:refers_toNote fro-usc-t12-ch53:id83ab2ea5-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-9> ;
  fro-usc:hasHeading "Authority to restrict mandatory pre-dispute arbitration" ;
  fro-usc:hasId "id83ab2e9e-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5518" ;
  fro-usc:hasNumberText "§ 5518." ;
  lkif-mereo:component fro-usc-t12-ch53:id83ab2ea3-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83ab2e9f-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-9-2> ;
  fro-usc:hasContentText "The Bureau shall conduct a study of, and shall provide a report to Congress concerning, the use of agreements providing for arbitration of any future dispute between covered persons and consumers in connection with the offering or providing of consumer financial products or services." ;
  fro-usc:hasHeading "Study and report" ;
  fro-usc:hasId "id83ab2e9f-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5518/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83ab2ea0-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-9-3> ;
  fro-usc:hasContentText "The Bureau, by regulation, may prohibit or impose conditions or limitations on the use of an agreement between a covered person and a consumer for a consumer financial product or service providing for arbitration of any future dispute between the parties, if the Bureau finds that such a prohibition or imposition of conditions or limitations is in the public interest and for the protection of consumers. The findings in such rule shall be consistent with the study conducted under subsection (a)." ;
  fro-usc:hasHeading "Further authority" ;
  fro-usc:hasId "id83ab2ea0-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5518/b" ;
  fro-usc:hasNumberText "(b)" ;
.
fro-usc-t12-ch53:id83ab2ea1-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-9-4> ;
  fro-usc:hasContentText "The authority described in subsection (b) may not be construed to prohibit or restrict a consumer from entering into a voluntary arbitration agreement with a covered person after a dispute has arisen." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "id83ab2ea1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5518/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83ab2ea2-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-10-4-9-5> ;
  fro-usc:hasContentText "Notwithstanding any other provision of law, any regulation prescribed by the Bureau under subsection (b) shall apply, consistent with the terms of the regulation, to any agreement between a consumer and a covered person entered into after the end of the 180-day period beginning on the effective date of the regulation, as established by the Bureau." ;
  fro-usc:hasHeading "Effective date" ;
  fro-usc:hasId "id83ab2ea2-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5518/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83ab2ea3-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "id83ab2ea3-1df7-11e6-87ee-8e4a3ab90f2a" ;
