  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-9-2-3-5> ;
  fro-usc:hasContentText "strengthening the liquidity of systemically important financial market utilities; and" ;
  fro-usc:hasId "id83a4029b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5461/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
