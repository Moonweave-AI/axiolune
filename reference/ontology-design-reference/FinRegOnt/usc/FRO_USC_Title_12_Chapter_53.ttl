  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-13-2-6-4-8> ;
  fro-usc:hasContentText "any other financial institution that the appropriate Federal regulators, jointly, by rule, determine should be treated as a covered financial institution for purposes of this section." ;
  fro-usc:hasId "id83b4a4a1-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5641/e/2/G" ;
