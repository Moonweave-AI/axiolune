fro-usc-t12-ch53:id83981b23-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b24-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b25-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b26-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b27-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b2a-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-11> ;
  fro-usc:hasHeading "Safe harbor" ;
  fro-usc:hasId "id83981b23-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5370" ;
  fro-usc:hasNumberText "§ 5370." ;
  lkif-mereo:component fro-usc-t12-ch53:id83981b2b-1df7-11e6-87ee-8e4a3ab90f2a ;
.
fro-usc-t12-ch53:id83981b24-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-11-2> ;
  fro-usc:hasContentText "The Board of Governors shall promulgate regulations on behalf of, and in consultation with, the Council setting forth the criteria for exempting certain types or classes of U.S. nonbank financial companies or foreign nonbank financial companies from supervision by the Board of Governors." ;
  fro-usc:hasHeading "Regulations" ;
  fro-usc:hasId "id83981b24-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5370/a" ;
  fro-usc:hasNumberText "(a)" ;
.
fro-usc-t12-ch53:id83981b25-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-11-3> ;
  fro-usc:hasContentText "In developing the criteria under subsection (a), the Board of Governors shall take into account the factors for consideration described in subsections (a) and (b) of section 5323 of this title in determining whether a U.S. nonbank financial company or foreign nonbank financial company shall be supervised by the Board of Governors." ;
  fro-usc:hasHeading "Considerations" ;
  fro-usc:hasId "id83981b25-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5370/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5323" ;
.
fro-usc-t12-ch53:id83981b26-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-11-4> ;
  fro-usc:hasContentText "Nothing in this section shall be construed to require supervision by the Board of Governors of a U.S. nonbank financial company or foreign nonbank financial company, if such company does not meet the criteria for exemption established under subsection (a)." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "id83981b26-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5370/c" ;
  fro-usc:hasNumberText "(c)" ;
.
fro-usc-t12-ch53:id83981b27-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b28-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:divided_by fro-usc-t12-ch53:id83981b29-1df7-11e6-87ee-8e4a3ab90f2a ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-11-5> ;
  fro-usc:hasHeading "Revisions" ;
  fro-usc:hasId "id83981b27-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5370/d" ;
  fro-usc:hasNumberText "(d)" ;
.
fro-usc-t12-ch53:id83981b28-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-11-5-2> ;
  fro-usc:hasContentText "The Board of Governors shall, in consultation with the Council, review the regulations promulgated under subsection (a), not less frequently than every 5 years, and based upon the review, the Board of Governors may revise such regulations on behalf of, and in consultation with, the Council to update as necessary the criteria set forth in such regulations." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "id83981b28-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5370/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
fro-usc-t12-ch53:id83981b29-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-11-5-3> ;
  fro-usc:hasContentText "No revisions under paragraph (1) shall take effect before the end of the 2-year period after the date of publication of such revisions in final form." ;
  fro-usc:hasHeading "Transition period" ;
  fro-usc:hasId "id83981b29-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5370/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
fro-usc-t12-ch53:id83981b2a-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title12-chapter53.ttl#r-1-0-4-6-5-11-6> ;
  fro-usc:hasContentText "The Chairman of the Board of Governors and the Chairperson of the Council shall submit a joint report to the Committee on Banking, Housing, and Urban Affairs of the Senate and the Committee on Financial Services of the House of Representatives not later than 30 days after the date of the issuance in final form of regulations under subsection (a), or any subsequent revision to such regulations under subsection (d), as applicable. Such report shall include, at a minimum, the rationale for exemption and empirical evidence to support the criteria for exemption." ;
  fro-usc:hasHeading "Report" ;
  fro-usc:hasId "id83981b2a-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasIdentifierText "/us/usc/t12/s5370/e" ;
  fro-usc:hasNumberText "(e)" ;
.
fro-usc-t12-ch53:id83981b2b-1df7-11e6-87ee-8e4a3ab90f2a
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-usc:hasId "id83981b2b-1df7-11e6-87ee-8e4a3ab90f2a" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tI" ;
  fro-usc:hasReferenceText "/us/stat/124/1435" ;
  fro-usc:hasSourceCreditText "( Pub. L. 111–203, title I , § 170, July 21, 2010 , 124 Stat. 1435 .)" ;
.
