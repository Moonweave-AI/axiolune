  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-3> ;
  fro-usc:hasHeading "Prohibition of transactions in interstate commerce by depositors or trustees of companies" ;
  fro-usc:hasId "idd03eb996-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/b" ;
