usc-t15-ch2D:idd058f8d4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-24-2> ;
  fro-usc:hasContentText "Nothing in this subchapter shall affect the jurisdiction of the securities commissioner (or any agency or officer performing like functions) of any State over any security or any person insofar as it does not conflict with the provisions of this subchapter or the rules and regulations thereunder." ;
  fro-usc:hasHeading "Jurisdiction of State regulators" ;
  fro-usc:hasId "idd058f8d4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–18a/a" ;
  fro-usc:hasNumberText "(a)" ;
.
