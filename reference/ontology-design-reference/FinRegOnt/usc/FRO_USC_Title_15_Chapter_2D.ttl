.
usc-t15-ch2D:idd0485643-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485644-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485645-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485646-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485647-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-2> ;
  fro-usc:hasHeading "Custody and sale of securities" ;
  fro-usc:hasId "idd0485643-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-28-2-2> ;
.
usc-t15-ch2D:idd0485644-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-2-3> ;
  fro-usc:hasContentText "designates one or more trustees or custodians, each of which is a bank, and provides that each such trustee or custodian shall have at all times an aggregate capital, surplus, and undivided profits of a specified minimum amount, which shall not be less than $500,000 (but may also provide, if such trustee or custodian publishes reports of condition at least annually, pursuant to law or to the requirements of its supervising or examining authority, that for the purposes of this paragraph the aggregate capital, surplus, and undivided profits of such trustee or custodian shall be deemed to be its aggregate capital, surplus, and undivided profits as set forth in its most recent report of condition so published);" ;
  fro-usc:hasId "idd0485644-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0485645-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-2-4> ;
  fro-usc:hasContentText "provides, in substance, (A) that during the life of the trust the trustee or custodian, if not otherwise remunerated, may charge against and collect from the income of the trust, and from the corpus thereof if no income is available, such fees for its services and such reimbursement for its expenses as are provided for in such instrument; (B) that no such charge or collection shall be made except for services theretofore performed or expenses theretofore incurred; (C) that no payment to the depositor of or a principal underwriter for such trust, or to any affiliated person or agent of such depositor or underwriter, shall be allowed the trustee or custodian as an expense (except that provision may be made for the payment to any such person of a fee, not exceeding such reasonable amount as the Commission may prescribe as compensation for performing bookkeeping and other administrative services, of a character normally performed by the trustee or custodian itself); and (D) that the trustee or custodian shall have possession of all securities and other property in which the funds of the trust are invested, all funds held for such investment, all equalization, redemption, and other special funds of the trust, and all income upon, accretions to, and proceeds of such property and funds, and shall segregate and hold the same in trust (subject only to the charges and collections allowed under clauses (A), (B), and (C) of this paragraph) until distribution thereof to the security holders of the trust;" ;
  fro-usc:hasId "idd0485645-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0485646-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-2-5> ;
  fro-usc:hasContentText "provides, in substance, that the trustee or custodian shall not resign until either (A) the trust has been completely liquidated and the proceeds of the liquidation distributed to the security holders of the trust, or (B) a successor trustee or custodian, having the qualifications prescribed in paragraph (1) of this subsection, has been designated and has accepted such trusteeship or custodianship; and" ;
  fro-usc:hasId "idd0485646-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0485647-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-2-6> ;
  fro-usc:hasContentText "provides, in substance, (A) that a record will be kept by the depositor or an agent of the depositor of the name and address of, and the shares issued by the trust and held by, every holder of any security issued pursuant to such instrument, insofar as such information is known to the depositor or agent; and (B) that whenever a security is deposited with the trustee in substitution for any security in which such security holder has an undivided interest, the depositor or the agent of the depositor will, within five days after such substitution, either deliver or mail to such security holder a notice of substitution, including an identification of the securities eliminated and the securities substituted, and a specification of the shares of such security holder affected by the substitution." ;
  fro-usc:hasId "idd0485647-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd0485648-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-3> ;
  fro-usc:hasContentText "The Commission may, after consultation with and taking into consideration the views of the Federal banking agencies (as defined in section 1813 of title 12 ), adopt rules and regulations, and issue orders, consistent with the protection of investors, prescribing the conditions under which a bank, or an affiliated person of a bank, either of which is an affiliated person of a principal underwriter for, or depositor of, a registered unit investment trust, may serve as trustee or custodian under subsection (a)(1)." ;
  fro-usc:hasHeading "Bank or affiliated person of bank as trustee or custodian" ;
  fro-usc:hasId "idd0485648-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813" ;
.
usc-t15-ch2D:idd0485649-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-4> ;
  fro-usc:hasContentText "It shall be unlawful for any depositor or trustee of a registered unit investment trust holding the security of a single issuer to substitute another security for such security unless the Commission shall have approved such substitution. The Commission shall issue an order approving such substitution if the evidence establishes that it is consistent with the protection of investors and the purposes fairly intended by the policy and provisions of this subchapter." ;
  fro-usc:hasHeading "Substitution of securities" ;
  fro-usc:hasId "idd0485649-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd048564a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-5> ;
  fro-usc:hasContentText "In the event that a trust indenture, agreement of custodianship, or other instrument pursuant to which securities of a registered unit investment trust are issued does not comply with the requirements of subsection (a), such instrument will be deemed to meet such requirements if a written contract or agreement binding on the parties and embodying such requirements has been executed by the depositor on the one part and the trustee or custodian on the other part, and three copies of such contract or agreement have been filed with the Commission." ;
  fro-usc:hasHeading "Binding contract or agreement embodying applicable provisions deemed to qualify non-complying instrument by which securities were issued" ;
  fro-usc:hasId "idd048564a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd048564b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-6> ;
  fro-usc:hasContentText "Whenever the Commission has reason to believe that a unit investment trust is inactive and that its liquidation is in the interest of the security holders of such trust, the Commission may file a complaint seeking the liquidation of such trust in the district court of the United States in any district wherein any trustee of such trust resides or has its principal place of business. A copy of such complaint shall be served on every trustee of such trust, and notice of the proceeding shall be given such other interested persons in such manner and at such times as the court may direct. If the court determines that such liquidation is in the interest of the security holders of such trust, the court shall order such liquidation and, after payment of necessary expenses, the distribution of the proceeds to the security holders of the trust in such manner and on such terms as may to the court appear equitable." ;
  fro-usc:hasHeading "Liquidation of unit investment trust" ;
  fro-usc:hasId "idd048564b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/e" ;
  fro-usc:hasNumberText "(e)" ;
.
usc-t15-ch2D:idd048564c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd048564d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd048564e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485654-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485655-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-7> ;
  fro-usc:hasHeading "Exemption" ;
  fro-usc:hasId "idd048564c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/f" ;
  fro-usc:hasNumberText "(f)" ;
.
usc-t15-ch2D:idd048564d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-7-2> ;
  fro-usc:hasContentText "Subsection (a) does not apply to any registered separate account funding variable insurance contracts, or to the sponsoring insurance company and principal underwriter of such account." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd048564d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/f/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd048564e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-7-3> ;
  fro-usc:hasHeading "Limitation on sales" ;
  fro-usc:hasId "idd048564e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/f/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-28-7-3-2> ;
  lkif-mereo:component usc-t15-ch2D:idd048564f-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0485650-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd048564f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-7-3-3> ;
  fro-usc:hasContentText "unless the fees and charges deducted under the contract, in the aggregate, are reasonable in relation to the services rendered, the expenses expected to be incurred, and the risks assumed by the insurance company, and, beginning on the earlier of August 1, 1997 , or the earliest effective date of any registration statement or amendment thereto for such contract following October 11, 1996 , the insurance company so represents in the registration statement for the contract; and" ;
  fro-usc:hasId "idd048564f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/f/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd0485650-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-7-3-4> ;
  fro-usc:hasId "idd0485650-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/f/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-28-7-3-4-1> ;
  lkif-mereo:component usc-t15-ch2D:idd0485651-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0485652-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0485653-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0485651-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-7-3-4-2> ;
  fro-usc:hasContentText "complies with all other applicable provisions of this section, as if it were a trustee or custodian of the registered separate account;" ;
  fro-usc:hasId "idd0485651-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/f/2/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd0485652-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-7-3-4-3> ;
  fro-usc:hasContentText "files with the insurance regulatory authority of the State which is the domiciliary State of the insurance company, an annual statement of its financial condition, which most recent statement indicates that the insurance company has a combined capital and surplus, if a stock company, or an unassigned surplus, if a mutual company, of not less than $1,000,000, or such other amount as the Commission may from time to time prescribe by rule, as necessary or appropriate in the public interest or for the protection of investors; and" ;
  fro-usc:hasId "idd0485652-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/f/2/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0485653-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-7-3-4-4> ;
  fro-usc:hasContentText "together with its registered separate accounts, is supervised and examined periodically by the insurance authority of such State." ;
  fro-usc:hasId "idd0485653-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/f/2/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
usc-t15-ch2D:idd0485654-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-7-4> ;
  fro-usc:hasContentText "For purposes of paragraph (2), the fees and charges deducted under the contract shall include all fees and charges imposed for any purpose and in any manner." ;
  fro-usc:hasHeading "Fees and charges" ;
  fro-usc:hasId "idd0485654-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/f/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0485655-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-7-5> ;
  fro-usc:hasContentText "The Commission may issue such rules and regulations to carry out paragraph (2)(A) as it determines are necessary or appropriate in the public interest or for the protection of investors." ;
  fro-usc:hasHeading "Regulatory authority" ;
  fro-usc:hasId "idd0485655-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–26/f/4" ;
  fro-usc:hasNumberText "(4)" ;
.
