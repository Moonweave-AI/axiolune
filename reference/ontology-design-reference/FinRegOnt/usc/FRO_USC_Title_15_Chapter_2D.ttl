usc-t15-ch2D:idd048567b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-11-2-3> ;
  fro-usc:hasContentText "for any registered investment company to issue any periodic payment plan certificate; or" ;
  fro-usc:hasId "idd048567b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/j/1/A" ;
