  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa13e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa13f-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa140-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43> ;
  fro-usc:hasHeading "Enforcement of subchapter" ;
  fro-usc:hasId "idd04aa126-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41" ;
  fro-usc:hasNumberText "§ 80a–41." ;
  lkif-mereo:component usc-t15-ch2D:idd04aa139-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa127-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-2> ;
  fro-usc:hasContentText "The Commission may make such investigations as it deems necessary to determine whether any person has violated or is about to violate any provision of this subchapter or of any rule, regulation, or order hereunder, or to determine whether any action in any court or any proceeding before the Commission shall be instituted under this subchapter against a particular person or persons, or with respect to a particular transaction or transactions. The Commission shall permit any person to file with it a statement in writing, under oath or otherwise as the Commission shall determine, as to all the facts and circumstances concerning the matter to be investigated." ;
  fro-usc:hasHeading "Investigation" ;
  fro-usc:hasId "idd04aa127-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd04aa128-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-3> ;
  fro-usc:hasContentText "For the purpose of any investigation or any other proceeding under this subchapter, any member of the Commission, or any officer thereof designated by it, is empowered to administer oaths and affirmations, subpena witnesses, compel their attendance, take evidence, and require the production of any books, papers, correspondence, memoranda, contracts, agreements, or other records which are relevant or material to the inquiry. Such attendance of witnesses and the production of any such records may be required from any place in any State or in any Territory or other place subject to the jurisdiction of the United States at any designated place of hearing." ;
  fro-usc:hasHeading "Administration of oaths and affirmations, subpena of witnesses, etc." ;
  fro-usc:hasId "idd04aa128-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04aa129-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-4> ;
  fro-usc:hasContentText "In case of contumacy by, or refusal to obey a subpena issued to, any person, the Commission may invoke the aid of any court of the United States within the jurisdiction of which such investigation or proceeding is carried on, or where such person resides or carries on business, in requiring the attendance and testimony of witnesses and the production of books, papers, correspondence, memoranda, contracts, agreements, and other records. And such court may issue an order requiring such person to appear before the Commission or member or officer designated by the Commission, there to produce records, if so ordered, or to give testimony touching the matter under investigation or in question; any failure to obey such order of the court may be punished by such court as a contempt thereof. All process in any such case may be served in the judicial district whereof such person is an inhabitant or wherever he may be found. Any person who without just cause shall fail or refuse to attend and testify or to answer any lawful inquiry or to produce books, papers, correspondence, memoranda, contracts, agreements, or other records, if in his or its power so to do, in obedience to the subpena of the Commission, shall be guilty of a misdemeanor, and upon conviction shall be subject to a fine of not more than $1,000 or to imprisonment for a term of not more than one year, or both." ;
  fro-usc:hasHeading "Jurisdiction of courts of United States" ;
  fro-usc:hasId "idd04aa129-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd04aa12a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-5> ;
  fro-usc:hasContentText "Whenever it shall appear to the Commission that any person has engaged or is about to engage in any act or practice constituting a violation of any provision of this subchapter, or of any rule, regulation, or order hereunder, it may in its discretion bring an action in the proper district court of the United States, or the proper United States court of any Territory or other place subject to the jurisdiction of the United States, to enjoin such acts or practices and to enforce compliance with this subchapter or any rule, regulation, or order hereunder. Upon a showing that such person has engaged or is about to engage in any such act or practice, a permanent or temporary injunction or decree or restraining order shall be granted without bond. In any proceeding under this subsection to enforce compliance with section 80a–7 of this title , the court as a court of equity may, to the extent it deems necessary or appropriate, take exclusive jurisdiction and possession of the investment company or companies involved and the books, records, and assets thereof, wherever located; and the court shall have jurisdiction to appoint a trustee, who with the approval of the court shall have power to dispose of any or all of such assets, subject to such terms and conditions as the court may prescribe. The Commission may transmit such evidence as may be available concerning any violation of the provisions of this subchapter or of any rule, regulation, or order thereunder, to the Attorney General, who, in his discretion, may institute the appropriate criminal proceedings under this subchapter." ;
  fro-usc:hasHeading "Action for injunction" ;
  fro-usc:hasId "idd04aa12a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–7" ;
.
usc-t15-ch2D:idd04aa12b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa12c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa12d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa133-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa138-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6> ;
  fro-usc:hasHeading "Money penalties in civil actions" ;
  fro-usc:hasId "idd04aa12b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e" ;
  fro-usc:hasNumberText "(e)" ;
.
usc-t15-ch2D:idd04aa12c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-2> ;
  fro-usc:hasContentText "Whenever it shall appear to the Commission that any person has violated any provision of this subchapter, the rules or regulations thereunder, or a cease-and-desist order entered by the Commission pursuant to section 80a–9(f) of this title , the Commission may bring an action in a United States district court to seek, and the court shall have jurisdiction to impose, upon a proper showing, a civil penalty to be paid by the person who committed such violation." ;
  fro-usc:hasHeading "Authority of Commission" ;
  fro-usc:hasId "idd04aa12c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–9/f" ;
.
usc-t15-ch2D:idd04aa12d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-3> ;
  fro-usc:hasHeading "Amount of penalty" ;
  fro-usc:hasId "idd04aa12d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component usc-t15-ch2D:idd04aa12e-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa12f-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa130-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa12e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-3-2> ;
  fro-usc:hasContentText "The amount of the penalty shall be determined by the court in light of the facts and circumstances. For each violation, the amount of the penalty shall not exceed the greater of (i) $5,000 for a natural person or $50,000 for any other person, or (ii) the gross amount of pecuniary gain to such defendant as a result of the violation." ;
  fro-usc:hasHeading "First tier" ;
  fro-usc:hasId "idd04aa12e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04aa12f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-3-3> ;
  fro-usc:hasContentText "Notwithstanding subparagraph (A), the amount of penalty for each such violation shall not exceed the greater of (i) $50,000 for a natural person or $250,000 for any other person, or (ii) the gross amount of pecuniary gain to such defendant as a result of the violation, if the violation described in paragraph (1) involved fraud, deceit, manipulation, or deliberate or reckless disregard of a regulatory requirement." ;
  fro-usc:hasHeading "Second tier" ;
  fro-usc:hasId "idd04aa12f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04aa130-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-3-4> ;
  fro-usc:hasHeading "Third tier" ;
  fro-usc:hasId "idd04aa130-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/2/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-43-6-3-4-2> ;
  lkif-mereo:component usc-t15-ch2D:idd04aa131-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa132-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa131-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-3-4-3> ;
  fro-usc:hasContentText "the violation described in paragraph (1) involved fraud, deceit, manipulation, or deliberate or reckless disregard of a regulatory requirement; and" ;
  fro-usc:hasId "idd04aa131-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/2/C/I" ;
  fro-usc:hasNumberText "(I)" ;
.
usc-t15-ch2D:idd04aa132-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-3-4-4> ;
  fro-usc:hasContentText "such violation directly or indirectly resulted in substantial losses or created a significant risk of substantial losses to other persons." ;
  fro-usc:hasId "idd04aa132-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/2/C/II" ;
  fro-usc:hasNumberText "(II)" ;
.
usc-t15-ch2D:idd04aa133-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-4> ;
  fro-usc:hasHeading "Procedures for collection" ;
  fro-usc:hasId "idd04aa133-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component usc-t15-ch2D:idd04aa134-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa135-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa136-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa137-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa134-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-4-2> ;
  fro-usc:hasContentText "A penalty imposed under this section shall be payable into the Treasury of the United States, except as otherwise provided in section 7246 of this title and section 78u–6 of this title ." ;
  fro-usc:hasHeading "Payment of penalty to Treasury" ;
  fro-usc:hasId "idd04aa134-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/3/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s7246" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78u–6" ;
.
usc-t15-ch2D:idd04aa135-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-4-3> ;
  fro-usc:hasContentText "If a person upon whom such a penalty is imposed shall fail to pay such penalty within the time prescribed in the court’s order, the Commission may refer the matter to the Attorney General who shall recover such penalty by action in the appropriate United States district court." ;
  fro-usc:hasHeading "Collection of penalties" ;
  fro-usc:hasId "idd04aa135-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04aa136-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-4-4> ;
  fro-usc:hasContentText "The actions authorized by this subsection may be brought in addition to any other action that the Commission or the Attorney General is entitled to bring." ;
  fro-usc:hasHeading "Remedy not exclusive" ;
  fro-usc:hasId "idd04aa136-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd04aa137-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-4-5> ;
  fro-usc:hasContentText "For purposes of section 80a–43 of this title , actions under this paragraph shall be actions to enforce a liability or a duty created by this subchapter." ;
  fro-usc:hasHeading "Jurisdiction and venue" ;
  fro-usc:hasId "idd04aa137-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/3/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–43" ;
.
usc-t15-ch2D:idd04aa138-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-43-6-5> ;
  fro-usc:hasContentText "In an action to enforce a cease-and-desist order entered by the Commission pursuant to section 80a–9(f) of this title , each separate violation of such order shall be a separate offense, except that in the case of a violation through a continuing failure to comply with the order, each day of the failure to comply shall be deemed a separate offense." ;
  fro-usc:hasHeading "Special provisions relating to a violation of a cease-and-desist order" ;
  fro-usc:hasId "idd04aa138-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–41/e/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–9/f" ;
.
