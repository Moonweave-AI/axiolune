usc-t15-ch2D:idd03eb92d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-12-4-2> ;
  fro-usc:hasContentText "a trust or fund is “maintained” by a charitable organization if the organization serves as a trustee or administrator of the trust or fund or has the power to remove the trustees or administrators of the trust or fund and to designate new trustees or administrators;" ;
  fro-usc:hasId "idd03eb92d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/10/D/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd03eb92e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-12-4-3> ;
  fro-usc:hasContentText "the term “pooled income fund” has the same meaning as in section 642(c)(5) of title 26 ;" ;
  fro-usc:hasId "idd03eb92e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/10/D/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:hasReferenceText "/us/usc/t26/s642/c/5" ;
.
usc-t15-ch2D:idd03eb92f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-12-4-4> ;
  fro-usc:hasContentText "the term “charitable organization” means an organization described in paragraphs (1) through (5) of section 170(c) or section 501(c)(3) of title 26 ;" ;
  fro-usc:hasId "idd03eb92f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/10/D/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:hasReferenceText "/us/usc/t26/s501/c/3" ;
.
usc-t15-ch2D:idd03eb930-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-12-4-5> ;
  fro-usc:hasContentText "the term “charitable lead trust” means a trust described in section 170(f)(2)(B), 2055(e)(2)(B), or 2522(c)(2)(B) of title 26;" ;
  fro-usc:hasId "idd03eb930-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/10/D/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
usc-t15-ch2D:idd03eb931-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-12-4-6> ;
  fro-usc:hasContentText "the term “charitable remainder trust” means a charitable remainder annuity trust or a charitable remainder unitrust, as those terms are defined in section 664(d) of title 26 ; and" ;
  fro-usc:hasId "idd03eb931-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/10/D/v" ;
  fro-usc:hasNumberText "(v)" ;
  fro-usc:hasReferenceText "/us/usc/t26/s664/d" ;
.
usc-t15-ch2D:idd03eb932-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-12-4-7> ;
  fro-usc:hasContentText "the term “charitable gift annuity” means an annuity issued by a charitable organization that is described in section 501(m)(5) of title 26 ." ;
  fro-usc:hasId "idd03eb932-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/10/D/vi" ;
  fro-usc:hasNumberText "(vi)" ;
  fro-usc:hasReferenceText "/us/usc/t26/s501/m/5" ;
.
usc-t15-ch2D:idd03eb933-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-13> ;
  fro-usc:hasContentText "Any employee’s stock bonus, pension, or profit-sharing trust which meets the requirements for qualification under section 401 of title 26 by section 77c(a)(2)(C) of this title , and (C) advances made by an insurance company in connection with the operation of such separate account. ; or any governmental plan described in section 77c(a)(2)(C) of this title ; or any collective trust fund maintained by a bank consisting solely of assets of one or more of such trusts, government plans, or church plans, companies or accounts that are excluded from the definition of an investment company under paragraph (14) of this subsection; or any separate account the assets of which are derived solely from (A) contributions under pension or profit-sharing plans which meet the requirements of section 401 of title 26 or the requirements for deduction of the employer’s contribution under section 404(a)(2) of title 26 , (B) contributions under governmental plans in connection with which interests, participations, or securities are exempted from the registration provisions of section 77e of this title" ;
  fro-usc:hasId "idd03eb933-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/11" ;
  fro-usc:hasNumberText "(11)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77c/a/2/C" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77e" ;
  fro-usc:hasReferenceText "/us/usc/t26/s401" ;
  fro-usc:hasReferenceText "/us/usc/t26/s404/a/2" ;
.
usc-t15-ch2D:idd03eb934-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-14> ;
  fro-usc:hasContentText "Any voting trust the assets of which consist exclusively of securities of a single issuer which is not an investment company." ;
  fro-usc:hasId "idd03eb934-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/12" ;
  fro-usc:hasNumberText "(12)" ;
.
usc-t15-ch2D:idd03eb935-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-15> ;
  fro-usc:hasContentText "Any security holders’ protective committee or similar issuer having outstanding and issuing no securities other than certificates of deposit and short-term paper." ;
  fro-usc:hasId "idd03eb935-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/13" ;
  fro-usc:hasNumberText "(13)" ;
.
