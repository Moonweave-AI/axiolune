usc-t15-ch2D:idd04f5b74-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-2-2> ;
  fro-usc:hasContentText "the name and form of organization under which the investment adviser engages or intends to engage in business; the name of the State or other sovereign power under which such investment adviser is organized; the location of his or its principal office, principal place of business, and branch offices, if any; the names and addresses of his or its partners, officers, directors, and persons performing similar functions or, if such an investment adviser be an individual, of such individual; and the number of his or its employees;" ;
  fro-usc:hasId "idd04f5b74-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04f5b75-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-2-3> ;
  fro-usc:hasContentText "the education, the business affiliations for the past ten years, and the present business affiliations of such investment adviser and of his or its partners, officers, directors, and persons performing similar functions and of any controlling person thereof;" ;
  fro-usc:hasId "idd04f5b75-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04f5b76-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-2-4> ;
  fro-usc:hasContentText "the nature of the business of such investment adviser, including the manner of giving advice and rendering analyses or reports;" ;
  fro-usc:hasId "idd04f5b76-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd04f5b77-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-2-5> ;
  fro-usc:hasContentText "a balance sheet certified by an independent public accountant and other financial statements (which shall, as the Commission specifies, be certified);" ;
  fro-usc:hasId "idd04f5b77-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/1/D" ;
  fro-usc:hasNumberText "(D)" ;
.
usc-t15-ch2D:idd04f5b78-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-2-6> ;
  fro-usc:hasContentText "the nature and scope of the authority of such investment adviser with respect to clients’ funds and accounts;" ;
  fro-usc:hasId "idd04f5b78-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/1/E" ;
  fro-usc:hasNumberText "(E)" ;
.
usc-t15-ch2D:idd04f5b79-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-2-7> ;
  fro-usc:hasContentText "the basis or bases upon which such investment adviser is compensated;" ;
  fro-usc:hasId "idd04f5b79-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/1/F" ;
  fro-usc:hasNumberText "(F)" ;
.
usc-t15-ch2D:idd04f5b7a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-2-8> ;
  fro-usc:hasContentText "whether such investment adviser, or any person associated with such investment adviser, is subject to any disqualification which would be a basis for denial, suspension, or revocation of registration of such investment adviser under the provisions of subsection (e) of this section; and" ;
  fro-usc:hasId "idd04f5b7a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/1/G" ;
  fro-usc:hasNumberText "(G)" ;
.
usc-t15-ch2D:idd04f5b7b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-2-9> ;
  fro-usc:hasContentText "a statement as to whether the principal business of such investment adviser consists or is to consist of acting as investment adviser and a statement as to whether a substantial part of the business of such investment adviser, consists or is to consist of rendering investment supervisory services." ;
  fro-usc:hasId "idd04f5b7b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/1/H" ;
  fro-usc:hasNumberText "(H)" ;
.
usc-t15-ch2D:idd04f5b7c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-3> ;
  fro-usc:hasId "idd04f5b7c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-4-4-3-1> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-4-4-4-3-4> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b7d-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b7e-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b7d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-3-2> ;
  fro-usc:hasContentText "by order grant such registration; or" ;
  fro-usc:hasId "idd04f5b7d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04f5b7e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-4-3-3> ;
  fro-usc:hasContentText "institute proceedings to determine whether registration should be denied. Such proceedings shall include notice of the grounds for denial under consideration and opportunity for hearing and shall be concluded within one hundred twenty days of the date of the filing of the application for registration. At the conclusion of such proceedings the Commission, by order, shall grant or deny such registration. The Commission may extend the time for conclusion of such proceedings for up to ninety days if it finds good cause for such extension and publishes its reasons for so finding or for such longer period as to which the applicant consents." ;
  fro-usc:hasId "idd04f5b7e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04f5b7f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-5> ;
  fro-usc:hasContentText "Any provision of this subchapter (other than subsection (a) of this section) which prohibits any act, practice, or course of business if the mails or any means or instrumentality of interstate commerce are used in connection therewith shall also prohibit any such act, practice, or course of business by any investment adviser registered pursuant to this section or any person acting on behalf of such an investment adviser, irrespective of any use of the mails or any means or instrumentality of interstate commerce in connection therewith." ;
  fro-usc:hasHeading "Other acts prohibited by subchapter" ;
  fro-usc:hasId "idd04f5b7f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd04f5b80-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b81-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b82-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b87-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b8a-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b8b-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd051cc8c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd051cc8f-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd051cc90-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd051cc94-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6> ;
  fro-usc:hasHeading "Censure, denial, or suspension of registration; notice and hearing" ;
  fro-usc:hasId "idd04f5b80-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-4-6-2> ;
.
usc-t15-ch2D:idd04f5b81-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-3> ;
  fro-usc:hasContentText "has willfully made or caused to be made in any application for registration or report required to be filed with the Commission under this subchapter, or in any proceeding before the Commission with respect to registration, any statement which was at the time and in the light of the circumstances under which it was made false or misleading with respect to any material fact, or has omitted to state in any such application or report any material fact which is required to be stated therein." ;
  fro-usc:hasId "idd04f5b81-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04f5b82-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-4> ;
  fro-usc:hasId "idd04f5b82-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-4-6-4-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b83-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b84-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b85-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b86-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b83-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-4-2> ;
  fro-usc:hasContentText "involves the purchase or sale of any security, the taking of a false oath, the making of a false report, bribery, perjury, burglary, any substantially equivalent activity however denominated by the laws of the relevant foreign government, or conspiracy to commit any such offense;" ;
  fro-usc:hasId "idd04f5b83-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04f5b84-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-4-3> ;
  fro-usc:hasContentText "arises out of the conduct of the business of a broker, dealer, municipal securities dealer, investment adviser, bank, insurance company, government securities broker, government securities dealer, fiduciary, transfer agent, credit rating agency, foreign person performing a function substantially equivalent to any of the above, or entity or person required to be registered under the Commodity Exchange Act [ 7 U.S.C. 1 et seq.] or any substantially equivalent statute or regulation;" ;
  fro-usc:hasId "idd04f5b84-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
usc-t15-ch2D:idd04f5b85-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-4-4> ;
  fro-usc:hasContentText "involves the larceny, theft, robbery, extortion, forgery, counterfeiting, fraudulent concealment, embezzlement, fraudulent conversion, or misappropriation of funds or securities or substantially equivalent activity however denominated by the laws of the relevant foreign government; or" ;
  fro-usc:hasId "idd04f5b85-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd04f5b86-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-4-5> ;
  fro-usc:hasContentText "involves the violation of section 152, 1341, 1342, or 1343 or chapter 25 or 47 of title 18, or a violation of  2 substantially equivalent foreign statute." ;
  fro-usc:hasId "idd04f5b86-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
usc-t15-ch2D:idd04f5b87-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-5> ;
  fro-usc:hasId "idd04f5b87-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-4-6-5-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b88-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b89-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b88-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-5-2> ;
  fro-usc:hasContentText "any crime that is punishable by imprisonment for 1 or more years, and that is not described in paragraph (2); or" ;
  fro-usc:hasId "idd04f5b88-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04f5b89-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-5-3> ;
  fro-usc:hasContentText "a substantially equivalent crime by a foreign court of competent jurisdiction." ;
  fro-usc:hasId "idd04f5b89-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04f5b8a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-6> ;
  fro-usc:hasContentText "is permanently or temporarily enjoined by order, judgment, or decree of any court of competent jurisdiction, including any foreign court of competent jurisdiction, from acting as an investment adviser, underwriter, broker, dealer, municipal securities dealer, government securities broker, government securities dealer, transfer agent, credit rating agency, foreign person performing a function substantially equivalent to any of the above, or entity or person required to be registered under the Commodity Exchange Act [ 7 U.S.C. 1 et seq.] or any substantially equivalent statute or regulation, or as an affiliated person or employee of any investment company, bank, insurance company, foreign entity substantially equivalent to any of the above, or entity or person required to be registered under the Commodity Exchange Act or any substantially equivalent statute or regulation, or from engaging in or continuing any conduct or practice in connection with any such activity, or in connection with the purchase or sale of any security." ;
  fro-usc:hasId "idd04f5b8a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
usc-t15-ch2D:idd04f5b8b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-7> ;
  fro-usc:hasContentText "has willfully violated any provision of the Securities Act of 1933 [ 15 U.S.C. 77a et seq.], the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], subchapter I of this chapter, this subchapter, the Commodity Exchange Act [ 7 U.S.C. 1 et seq.], or the rules or regulations under any such statutes or any rule of the Municipal Securities Rulemaking Board, or is unable to comply with any such provision." ;
  fro-usc:hasId "idd04f5b8b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
usc-t15-ch2D:idd051cc8c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-8> ;
  fro-usc:hasId "idd051cc8c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-4-6-8-1> ;
  lkif-mereo:component usc-t15-ch2D:idd051cc8d-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd051cc8e-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd051cc8d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-8-2> ;
  fro-usc:hasContentText "there have been established procedures, and a system for applying such procedures, which would reasonably be expected to prevent and detect, insofar as practicable, any such violation by such other person, and" ;
  fro-usc:hasId "idd051cc8d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/6/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd051cc8e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-8-3> ;
  fro-usc:hasContentText "such person has reasonably discharged the duties and obligations incumbent upon him by reason of such procedures and system without reasonable cause to believe that such procedures and system were not being complied with." ;
  fro-usc:hasId "idd051cc8e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd051cc8f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-9> ;
  fro-usc:hasContentText "is subject to any order of the Commission barring or suspending the right of the person to be associated with an investment adviser;" ;
  fro-usc:hasId "idd051cc8f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/7" ;
  fro-usc:hasNumberText "(7)" ;
.
usc-t15-ch2D:idd051cc90-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-10> ;
  fro-usc:hasId "idd051cc90-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/8" ;
  fro-usc:hasNumberText "(8)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-4-6-10-1> ;
  lkif-mereo:component usc-t15-ch2D:idd051cc91-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd051cc92-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd051cc93-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd051cc91-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-10-2> ;
  fro-usc:hasContentText "made or caused to be made in any application for registration or report required to be filed with a foreign securities authority, or in any proceeding before a foreign securities authority with respect to registration, any statement that was at the time and in light of the circumstances under which it was made false or misleading with respect to any material fact, or has omitted to state in any application or report to a foreign securities authority any material fact that is required to be stated therein;" ;
  fro-usc:hasId "idd051cc91-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/8/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd051cc92-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-10-3> ;
  fro-usc:hasContentText "violated any foreign statute or regulation regarding transactions in securities or contracts of sale of a commodity for future delivery traded on or subject to the rules of a contract market or any board of trade; or" ;
  fro-usc:hasId "idd051cc92-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/8/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd051cc93-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-10-4> ;
  fro-usc:hasContentText "aided, abetted, counseled, commanded, induced, or procured the violation by any other person of any foreign statute or regulation regarding transactions in securities or contracts of sale of a commodity for future delivery traded on or subject to the rules of a contract market or any board of trade, or has been found, by the foreign finanical  3 regulatory authority, to have failed reasonably to supervise, with a view to preventing violations of statutory provisions, and rules and regulations promulgated thereunder, another person who commits such a violation, if such other person is subject to his supervision; or" ;
  fro-usc:hasId "idd051cc93-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/8/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd051cc94-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-11> ;
  fro-usc:hasId "idd051cc94-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/9" ;
  fro-usc:hasNumberText "(9)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-4-6-11-1> ;
  lkif-mereo:component usc-t15-ch2D:idd051cc95-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd051cc96-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd051cc95-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-11-2> ;
  fro-usc:hasContentText "bars such person from association with an entity regulated by such commission, authority, agency, or officer, or from engaging in the business of securities, insurance, banking, savings association activities, or credit union activities; or" ;
  fro-usc:hasId "idd051cc95-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/9/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd051cc96-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-6-11-3> ;
  fro-usc:hasContentText "constitutes a final order based on violations of any laws or regulations that prohibit fraudulent, manipulative, or deceptive conduct." ;
  fro-usc:hasId "idd051cc96-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/e/9/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd051cc97-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-7> ;
  fro-usc:hasContentText "The Commission, by order, shall censure or place limitations on the activities of any person associated, seeking to become associated, or, at the time of the alleged misconduct, associated or seeking to become associated with an investment adviser, or suspend for a period not exceeding 12 months or bar any such person from being associated with an investment adviser, broker, dealer, municipal securities dealer, municipal advisor, transfer agent, or nationally recognized statistical rating organization, if the Commission finds, on the record after notice and opportunity for hearing, that such censure, placing of limitations, suspension, or bar is in the public interest and that such person has committed or omitted any act or omission enumerated in paragraph (1), (5), (6), (8), or (9) of subsection (e) or has been convicted of any offense specified in paragraph (2) or (3) of subsection (e) within ten years of the commencement of the proceedings under this subsection, or is enjoined from any action, conduct, or practice specified in paragraph (4) of subsection (e). It shall be unlawful for any person as to whom such an order suspending or barring him from being associated with an investment adviser is in effect willfully to become, or to be, associated with an investment adviser without the consent of the Commission, and it shall be unlawful for any investment adviser to permit such a person to become, or remain, a person associated with him without the consent of the Commission, if such investment adviser knew, or in the exercise of reasonable care, should have known, of such order." ;
  fro-usc:hasHeading "Bar or suspension from association with investment adviser; notice and hearing" ;
  fro-usc:hasId "idd051cc97-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/f" ;
  fro-usc:hasNumberText "(f)" ;
.
usc-t15-ch2D:idd051cc98-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-8> ;
  fro-usc:hasContentText "Any successor to the business of an investment adviser registered under this section shall be deemed likewise registered hereunder, if within thirty days from its succession to such business it shall file an application for registration under this section, unless and until the Commission, pursuant to subsection (c) or subsection (e) of this section, shall deny registration to or revoke or suspend the registration of such successor." ;
  fro-usc:hasHeading "Registration of successor to business of investment adviser" ;
  fro-usc:hasId "idd051cc98-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/g" ;
  fro-usc:hasNumberText "(g)" ;
.
usc-t15-ch2D:idd051cc99-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-9> ;
  fro-usc:hasContentText "Any person registered under this section may, upon such terms and conditions as the Commission finds necessary in the public interest or for the protection of investors, withdraw from registration by filing a written notice of withdrawal with the Commission. If the Commission finds that any person registered under this section, or who has pending an application for registration filed under this section, is no longer in existence, is not engaged in business as an investment adviser, or is prohibited from registering as an investment adviser under section 80b–3a of this title , the Commission shall by order cancel the registration of such person." ;
  fro-usc:hasHeading "Withdrawal of registration" ;
  fro-usc:hasId "idd051cc99-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/h" ;
  fro-usc:hasNumberText "(h)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3a" ;
.
