  fro-usc:hasReferenceText "/us/stat/94/2287" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title I, § 62, as added Pub. L. 96–477, title I , § 105, Oct. 21, 1980 , 94 Stat. 2287 .)" ;
.
usc-t15-ch2D:idd04f5b06-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b07-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b08-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b0c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 64 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-64> ;
  fro-usc:hasHeading "Distribution and repurchase of securities" ;
  fro-usc:hasId "idd04f5b06-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–62" ;
  fro-usc:hasNumberText "§ 80a–62." ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-64-2> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b0d-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b07-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-64-3> ;
  fro-usc:hasContentText "The prohibitions of section 80a–23(a)(2) of this title shall not apply to any company which (A) is a wholly-owned subsidiary of, or directly or indirectly controlled by, a business development company, and (B) immediately after the issuance of any of its securities for property other than cash or securities, will not be an investment company within the meaning of section 80a–3(a) of this title ." ;
  fro-usc:hasId "idd04f5b07-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–62/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–23/a/2" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/a" ;
.
usc-t15-ch2D:idd04f5b08-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-64-4> ;
  fro-usc:hasId "idd04f5b08-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–62/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-64-4-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b09-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b0a-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b0b-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b09-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-64-4-2> ;
  fro-usc:hasContentText "the holders of a majority of such business development company’s outstanding voting securities, and the holders of a majority of such company’s outstanding voting securities that are not affiliated persons of such company, approved such company’s policy and practice of making such sales of securities at the last annual meeting of shareholders or partners within one year immediately prior to any such sale, except that the shareholder approval requirements of this subparagraph shall not apply to the initial public offering by a business development company of its securities;" ;
  fro-usc:hasId "idd04f5b09-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–62/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04f5b0a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-64-4-3> ;
  fro-usc:hasContentText "a required majority (as defined in section 80a–56( o ) of this title) of the directors of or general partners in such business development company have determined that any such sale would be in the best interests of such company and its shareholders or partners; and" ;
  fro-usc:hasId "idd04f5b0a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–62/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04f5b0b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-64-4-4> ;
  fro-usc:hasContentText "a required majority (as defined in section 80a–56( o ) of this title) of the directors of or general partners in such business development company, in consultation with the underwriter or underwriters of the offering if it is to be underwritten, have determined in good faith, and as of a time immediately prior to the first solicitation by or on behalf of such company of firm commitments to purchase such securities or immediately prior to the issuance of such securities, that the price at which such securities are to be sold is not less than a price which closely approximates the market value of those securities, less any distributing commission or discount." ;
  fro-usc:hasId "idd04f5b0b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–62/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd04f5b0c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-64-5> ;
  fro-usc:hasContentText "A business development company may sell any common stock of which it is the issuer at a price below the current net asset value of such stock upon the exercise of any warrant, option, or right issued in accordance with section 80a–60(a)(3) of this title ." ;
  fro-usc:hasId "idd04f5b0c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–62/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–60/a/3" ;
.
usc-t15-ch2D:idd04f5b0d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "idd04f5b0d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/96/477/tI" ;
  fro-usc:hasReferenceText "/us/stat/94/2288" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title I, § 63, as added Pub. L. 96–477, title I , § 105, Oct. 21, 1980 , 94 Stat. 2288 .)" ;
.
usc-t15-ch2D:idd04f5b0e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b0f-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b10-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 65 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04f5b15-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-65> ;
  fro-usc:hasHeading "Accounts and records" ;
  fro-usc:hasId "idd04f5b0e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–63" ;
  fro-usc:hasNumberText "§ 80a–63." ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b13-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b0f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-65-2> ;
  fro-usc:hasContentText "Notwithstanding the exemption set forth in section 80a–6(f) of this title , section 80a–30 of this title shall apply to a business development company to the same extent as if it were a registered closed-end investment company, except that the reference to the financial statements required to be filed pursuant to section 80a–29 of this title shall be construed to refer to the financial statements required to be filed by such business development company pursuant to section 78m of this title ." ;
  fro-usc:hasHeading "Exception for business development company" ;
  fro-usc:hasId "idd04f5b0f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–63/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78m" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–29" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–30" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–6/f" ;
.
usc-t15-ch2D:idd04f5b10-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b11-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b12-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-65-3> ;
  fro-usc:hasHeading "Risk factors statement; availability" ;
  fro-usc:hasId "idd04f5b10-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–63/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04f5b11-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-65-3-2> ;
  fro-usc:hasContentText "In addition to the requirements of subsection (a), a business development company shall file with the Commission and supply annually to its shareholders a written statement, in such form and manner as the Commission may, by rule, prescribe, describing the risk factors involved in an investment in the securities of a business development company due to the nature of such company’s investment portfolio and capital structure, and shall supply copies of such statement to any registered broker or dealer upon request." ;
  fro-usc:hasId "idd04f5b11-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–63/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04f5b12-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-65-3-3> ;
  fro-usc:hasContentText "If the Commission finds it is necessary or appropriate in the public interest and consistent with the protection of investors and the purposes fairly intended by the policy and provisions of this subchapter, the Commission may also require, by rule, any person who, acting as principal or agent, sells a security of a business development company to inform the purchaser of such securities, at or before the time of sale, of the existence of the risk statement prepared by such business development company pursuant to this subsection, and make such risk statement available on request. The Commission, in making such rules and regulations, shall consider, among other matters, whether any such rule or regulation would impose any unreasonable burdens on such brokers or dealers or unreasonably impair the maintenance of fair and orderly markets." ;
  fro-usc:hasId "idd04f5b12-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–63/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04f5b13-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "idd04f5b13-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/104/290/tV" ;
  fro-usc:hasReferenceText "/us/pl/96/477/tI" ;
  fro-usc:hasReferenceText "/us/stat/110/3446" ;
  fro-usc:hasReferenceText "/us/stat/94/2289" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , § 507, Oct. 11, 1996 , 110 Stat. 3446 .) , title I, § 64, as added Pub. L. 96–477, title I § 105, Oct. 21, 1980 , 94 Stat. 2289 ; amended Pub. L. 104–290, title V" ;
.
usc-t15-ch2D:idd04f5b15-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-65-5-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04f5b15-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1996—Subsec. (b)(1). Pub. L. 104–290 inserted “and capital structure” after “portfolio”." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/104/290" ;
.
usc-t15-ch2D:idd04f5b16-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 66 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-66> ;
  fro-usc:hasContentText "Notwithstanding the exemption set forth in section 80a–6(f) of this title , section 80a–47 of this title shall apply to a business development company to the same extent as if it were a registered closed-end investment company, except that the provisions of section 80a–47(a) of this title shall not be construed to require any company which is not an investment company within the meaning of section 80a–3(a) of this title to comply with the provisions of this subchapter which are applicable to a business development company solely because such company is a wholly-owned subsidiary of, or directly or indirectly controlled by, a business development company." ;
  fro-usc:hasHeading "Preventing compliance with subchapter; liability of controlling persons" ;
  fro-usc:hasId "idd04f5b16-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–64" ;
  fro-usc:hasNumberText "§ 80a–64." ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b17-0c74-11e6-aa53-e455a13f2ad9 ;
.
