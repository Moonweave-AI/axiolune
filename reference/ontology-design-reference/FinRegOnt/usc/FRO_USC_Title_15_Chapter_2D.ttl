.
usc-t15-ch2D:idd04f5b61-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-3-3> ;
  fro-usc:hasContentText "any investment adviser, other than an investment adviser who acts as an investment adviser to any private fund, all of whose clients are residents of the State within which such investment adviser maintains his or its principal office and place of business, and who does not furnish advice or issue analyses or reports with respect to securities listed or admitted to unlisted trading privileges on any national securities exchange;" ;
  fro-usc:hasId "idd04f5b61-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04f5b62-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-3-4> ;
  fro-usc:hasContentText "any investment adviser whose only clients are insurance companies;" ;
  fro-usc:hasId "idd04f5b62-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04f5b63-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-3-5> ;
  fro-usc:hasContentText "any investment adviser that is a foreign private adviser;" ;
  fro-usc:hasId "idd04f5b63-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
