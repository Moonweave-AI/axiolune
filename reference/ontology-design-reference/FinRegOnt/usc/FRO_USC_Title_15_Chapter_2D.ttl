  fro-usc:hasContentText "the insurance company complies with section 80a–26(f) of this title and any rules or regulations issued by the Commission under section 80a–26(f) of this title ." ;
  fro-usc:hasId "idd0485678-0c74-11e6-aa53-e455a13f2ad9" ;
