  fro-usc:hasContentText "the investment or trading strategies of the investment adviser;" ;
  fro-usc:hasId "idd0568704-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/10/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd0568705-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
