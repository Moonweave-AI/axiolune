.
usc-t15-ch2D:idd03eb94b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-3-3> ;
  fro-usc:hasContentText "a charitable organization;" ;
  fro-usc:hasId "idd03eb94b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3a/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd03eb94c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-3-4> ;
  fro-usc:hasContentText "a fund that is excluded from the definition of an investment company under section 80a–3(c)(10)(B) of this title ; or" ;
  fro-usc:hasId "idd03eb94c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3a/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/10/B" ;
.
usc-t15-ch2D:idd03eb94d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-3-5> ;
  fro-usc:hasContentText "a trust or other donative instrument described in section 80a–3(c)(10)(B) of this title , or the settlors (or potential settlors) or beneficiaries of any such trusts or other instruments." ;
  fro-usc:hasId "idd03eb94d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3a/b/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/10/B" ;
.
usc-t15-ch2D:idd03eb94e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-4> ;
  fro-usc:hasContentText "Notwithstanding subsections (a) and (b), during the 3-year period beginning on December 8, 1995 , a State may enact a statute that specifically refers to this section and provides prospectively that this section shall not preempt the laws of that State referred to in this section." ;
  fro-usc:hasHeading "State action" ;
  fro-usc:hasId "idd03eb94e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3a/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd03eb94f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb950-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb951-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb952-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-5> ;
  fro-usc:hasHeading "Definitions" ;
  fro-usc:hasId "idd03eb94f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3a/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-5-5-2> ;
.
usc-t15-ch2D:idd03eb950-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-5-3> ;
  fro-usc:hasContentText "the term “charitable organization” means an organization described in paragraphs (1) through (5) of section 170(c) or section 501(c)(3) of title 26 ;" ;
  fro-usc:hasId "idd03eb950-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3a/d/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t26/s501/c/3" ;
.
usc-t15-ch2D:idd03eb951-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-5-4> ;
  fro-usc:hasContentText "the term “security” has the same meaning as in section 78c of this title ; and" ;
  fro-usc:hasId "idd03eb951-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3a/d/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c" ;
.
usc-t15-ch2D:idd03eb952-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-5-5> ;
  fro-usc:hasContentText "the term “State” means each of the several States of the United States, the District of Columbia, the Commonwealth of Puerto Rico, the Virgin Islands, Guam, American Samoa, and the Commonwealth of the Northern Mariana Islands." ;
  fro-usc:hasId "idd03eb952-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3a/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
