  fro-usc:hasContentText "analytical or research methodologies;" ;
  fro-usc:hasId "idd0568705-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/10/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0568706-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-11-3-5> ;
  fro-usc:hasContentText "trading data;" ;
  fro-usc:hasId "idd0568706-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/10/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
usc-t15-ch2D:idd0568707-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-11-3-6> ;
  fro-usc:hasContentText "computer hardware or software containing intellectual property; and" ;
  fro-usc:hasId "idd0568707-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/10/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
usc-t15-ch2D:idd0568708-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-11-3-7> ;
  fro-usc:hasContentText "any additional information that the Commission determines to be proprietary." ;
  fro-usc:hasId "idd0568708-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/10/B/v" ;
  fro-usc:hasNumberText "(v)" ;
.
usc-t15-ch2D:idd0568709-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-12> ;
  fro-usc:hasContentText "The Commission shall report annually to Congress on how the Commission has used the data collected pursuant to this subsection to monitor the markets for the protection of investors and the integrity of the markets." ;
  fro-usc:hasHeading "Annual report to Congress" ;
  fro-usc:hasId "idd0568709-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/11" ;
  fro-usc:hasNumberText "(11)" ;
.
usc-t15-ch2D:idd056870a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd056870b-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd056870c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-4> ;
  fro-usc:hasHeading "Filing depositories" ;
  fro-usc:hasId "idd056870a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-6-4-2> ;
.
usc-t15-ch2D:idd056870b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-4-3> ;
  fro-usc:hasContentText "to file with the Commission any fee, application, report, or notice required to be filed by this subchapter or the rules issued under this subchapter through any entity designated by the Commission for that purpose; and" ;
  fro-usc:hasId "idd056870b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd056870c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-4-4> ;
  fro-usc:hasContentText "to pay the reasonable costs associated with such filing and the establishment and maintenance of the systems required by subsection (c)." ;
  fro-usc:hasId "idd056870c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd056870d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd056870e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0568711-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0568712-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-5> ;
  fro-usc:hasHeading "Access to disciplinary and other information" ;
  fro-usc:hasId "idd056870d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd056870e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-5-2> ;
  fro-usc:hasHeading "Maintenance of system to respond to inquiries" ;
  fro-usc:hasId "idd056870e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/d/1" ;
  fro-usc:hasNumberText "(1)" ;
  lkif-mereo:component usc-t15-ch2D:idd056870f-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0568710-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd056870f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-5-2-2> ;
  fro-usc:hasContentText "The Commission shall require the entity designated by the Commission under subsection (b)(1) to establish and maintain a toll-free telephone listing, or a readily accessible electronic or other process, to receive and promptly respond to inquiries regarding registration information (including disciplinary actions, regulatory, judicial, and arbitration proceedings, and other information required by law or rule to be reported) involving investment advisers and persons associated with investment advisers." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd056870f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/d/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd0568710-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-5-2-3> ;
  fro-usc:hasContentText "This subsection shall apply to any investment adviser (and the persons associated with that adviser), whether the investment adviser is registered with the Commission under section 80b–3 of this title or regulated solely by a State, as described in section 80b–3a of this title ." ;
  fro-usc:hasHeading "Applicability" ;
  fro-usc:hasId "idd0568710-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/d/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3a" ;
.
usc-t15-ch2D:idd0568711-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-5-3> ;
  fro-usc:hasContentText "An entity designated by the Commission under subsection (b)(1) may charge persons making inquiries, other than individual investors, reasonable fees for responses to inquiries described in paragraph (1)." ;
  fro-usc:hasHeading "Recovery of costs" ;
  fro-usc:hasId "idd0568711-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0568712-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-5-4> ;
  fro-usc:hasContentText "An entity designated by the Commission under subsection (b)(1) shall not have any liability to any person for any actions taken or omitted in good faith under this subsection." ;
  fro-usc:hasHeading "Limitation on liability" ;
  fro-usc:hasId "idd0568712-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0568713-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0568714-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0568715-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-6> ;
  fro-usc:hasHeading "Records of persons with custody or use" ;
  fro-usc:hasHeading " " ;
  fro-usc:hasId "idd0568713-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd0568714-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-6-2> ;
  fro-usc:hasContentText "Records of persons having custody or use of the securities, deposits, or credits of a client, that relate to such custody or use, are subject at any time, or from time to time, to such reasonable periodic, special, or other examinations and other information and document requests by representatives of the Commission, as the Commission deems necessary or appropriate in the public interest or for the protection of investors." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd0568714-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0568715-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-6-3> ;
  fro-usc:hasContentText "Any person that is subject to regulation and examination by a Federal financial institution regulatory agency (as such term is defined under section 212(c)(2) of title 18 ) may satisfy any examination request, information request, or document request described under paragraph (1), by providing the Commission with a detailed listing, in writing, of the securities, deposits, or credits of the client within the custody or use of such person." ;
  fro-usc:hasHeading "Certain persons subject to other regulation" ;
  fro-usc:hasId "idd0568715-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/d/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t18/s212/c/2" ;
.
usc-t15-ch2D:idd0568716-0c74-11e6-aa53-e455a13f2ad9
