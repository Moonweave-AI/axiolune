usc-t15-ch2D:idd045e5f8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-23-3> ;
  fro-usc:hasContentText "the investment policies of such registered company, as recited in its registration statement and reports filed under this subchapter, do not permit such a loan; or" ;
  fro-usc:hasId "idd045e5f8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–21/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd045e5f9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-23-4> ;
  fro-usc:hasContentText "such person controls or is under common control with such registered company; except that the provisions of this paragraph shall not apply to any loan from a registered company to a company which owns all of the outstanding securities of such registered company, except directors’ qualifying shares." ;
  fro-usc:hasId "idd045e5f9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–21/b" ;
  fro-usc:hasNumberText "(b)" ;
.
