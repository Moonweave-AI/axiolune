usc-t15-ch2D:idd0412b17-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-11-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd0412b17-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1970—Subsec. (a). Pub. L. 91–547 , § 5(a), struck out introductory text “After one year from the effective date of this subchapter” and substituted “interested persons of such registered company” for “investment advisers of, affiliated persons of an investment adviser of, or officers or employees of, such registered company”." ;
  fro-usc:hasNoteText "1975—Subsec. (e). Pub. L. 94–29 inserted reference to provisions of section 80a–15(f)(1) of this title ." ;
  fro-usc:hasNoteText "1999—Subsec. (c). Pub. L. 106–102 substituted “bank (together with its affiliates and subsidiaries) or any one bank holding company (together with its affiliates and subsidiaries) (as such terms are defined in section 1841 of title 12 ), except” for “bank, except”." ;
  fro-usc:hasNoteText "2006—Subsec. (c). Pub. L. 109–351 inserted “or any one savings and loan holding company, together with its affiliates and subsidiaries (as such terms are defined in section 1467a of title 12 ),” after “1841 of title 12)”." ;
  fro-usc:hasNoteText "Subsec. (b)(2). Pub. L. 91–547 , § 5(b)(2), substituted “interested” for “affiliated” in two places." ;
  fro-usc:hasNoteText "Subsec. (b). Pub. L. 91–547 , § 5(b)(1), struck out introductory text “After one year from the effective date of this subchapter,” and substituted “No” for “no”." ;
  fro-usc:hasNoteText "Subsec. (c). Pub. L. 91–547 , § 5(c), struck out introductory text “After the effective date of this subchapter”, substituted “No”, “, except that”, “had a majority”, and “such company” for “no”, “:  Provided , That”, “shall have had a majority”, and “such company”, respectively, and inserted reference to employees where first appearing." ;
  fro-usc:hasNoteText "Subsec. (d). Pub. L. 91–547 , § 5(d), reenacted provisions except for substitution of “interested persons” for “affiliated persons” in introductory text, deletion of “such investment adviser” before “is engaged” in item (2), and substitution of “class of securities” for “class of stock” and “unit” for “share” in two places in item (8)." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/106/102" ;
  fro-usc:hasReferenceText "/us/pl/109/351" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
  fro-usc:hasReferenceText "/us/pl/94/29" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1467a" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–15/f/1" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd043747c-0c74-11e6-aa53-e455a13f2ad9 ;
.
