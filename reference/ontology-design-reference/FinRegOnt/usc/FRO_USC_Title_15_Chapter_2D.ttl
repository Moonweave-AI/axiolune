  fro-usc:hasHeading "Payment of registration fees" ;
  fro-usc:hasId "idd045e629-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–24/f/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-26-7-3-2> ;
