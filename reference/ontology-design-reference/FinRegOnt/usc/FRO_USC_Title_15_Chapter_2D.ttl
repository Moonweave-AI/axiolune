  fro-usc:hasHeading "Civil actions by Commission; jurisdiction; allegations; injunctive or other relief" ;
  fro-usc:hasId "idd04aa0f7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-37-2-2> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-37-2-5> ;
.
usc-t15-ch2D:idd04aa0f8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-2-3> ;
  fro-usc:hasContentText "as officer, director, member of any advisory board, investment adviser, or depositor; or" ;
  fro-usc:hasId "idd04aa0f8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04aa0f9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-2-4> ;
  fro-usc:hasContentText "as principal underwriter, if such registered company is an open-end company, unit investment trust, or face-amount certificate company." ;
  fro-usc:hasId "idd04aa0f9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04aa0fa-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0fb-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0fc-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0fd-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0fe-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0ff-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa100-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-3> ;
  fro-usc:hasHeading "Compensation or payments as basis of fiduciary duty; civil actions by Commission or security holder; burden of proof; judicial consideration of director or shareholder approval; persons liable; extent of liability; exempted transactions; jurisdiction; finding restriction" ;
  fro-usc:hasId "idd04aa0fa-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-37-3-2> ;
.
usc-t15-ch2D:idd04aa0fb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-3-3> ;
  fro-usc:hasContentText "It shall not be necessary to allege or prove that any defendant engaged in personal misconduct, and the plaintiff shall have the burden of proving a breach of fiduciary duty." ;
  fro-usc:hasId "idd04aa0fb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04aa0fc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-3-4> ;
  fro-usc:hasContentText "In any such action approval by the board of directors of such investment company of such compensation or payments, or of contracts or other arrangements providing for such compensation or payments, and ratification or approval of such compensation or payments, or of contracts or other arrangements providing for such compensation or payments, by the shareholders of such investment company, shall be given such consideration by the court as is deemed appropriate under all the circumstances." ;
  fro-usc:hasId "idd04aa0fc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04aa0fd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-3-5> ;
  fro-usc:hasContentText "No such action shall be brought or maintained against any person other than the recipient of such compensation or payments, and no damages or other relief shall be granted against any person other than the recipient of such compensation or payments. No award of damages shall be recoverable for any period prior to one year before the action was instituted. Any award of damages against such recipient shall be limited to the actual damages resulting from the breach of fiduciary duty and shall in no event exceed the amount of compensation or payment received from such investment company, or the security holders thereof, by such recipient." ;
  fro-usc:hasId "idd04aa0fd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd04aa0fe-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-3-6> ;
  fro-usc:hasContentText "This subsection shall not apply to compensation or payments made in connection with transactions subject to section 80a–17 of this title , or rules, regulations, or orders thereunder, or to sales loads for the acquisition of any security issued by a registered investment company." ;
  fro-usc:hasId "idd04aa0fe-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/b/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–17" ;
.
usc-t15-ch2D:idd04aa0ff-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-3-7> ;
  fro-usc:hasContentText "Any action pursuant to this subsection may be brought only in an appropriate district court of the United States." ;
  fro-usc:hasId "idd04aa0ff-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd04aa100-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-3-8> ;
  fro-usc:hasContentText "No finding by a court with respect to a breach of fiduciary duty under this subsection shall be made a basis (A) for a finding of a violation of this subchapter for the purposes of sections 80a–9 and 80a–48 of this title, section 78 o of this title, or section 80b–3 of this title , or (B) for an injunction to prohibit any person from serving in any of the capacities enumerated in subsection (a) of this section." ;
  fro-usc:hasId "idd04aa100-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/b/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3" ;
.
usc-t15-ch2D:idd04aa101-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-4> ;
  fro-usc:hasContentText "For the purposes of subsections (a) and (b) of this section, the term “investment adviser” includes a corporate or other trustee performing the functions of an investment adviser." ;
  fro-usc:hasHeading "Corporate or other trustees performing functions of investment advisers" ;
  fro-usc:hasId "idd04aa101-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–35/c" ;
  fro-usc:hasNumberText "(c)" ;
.
