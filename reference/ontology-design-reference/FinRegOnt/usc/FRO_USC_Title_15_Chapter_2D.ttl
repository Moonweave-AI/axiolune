  fro-usc:hasReferenceText "/us/usc/t22/s8532/c" ;
.
usc-t15-ch2D:idd0437457-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-4-3> ;
  fro-usc:hasHeading "Applicability" ;
  fro-usc:hasId "idd0437457-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component usc-t15-ch2D:idd0437458-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0437459-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0437458-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-4-3-2> ;
  fro-usc:hasContentText "Nothing in paragraph (1) shall be construed to create, imply, diminish, change, or affect in any way whether or not a private right of action exists under subsection (a) or any other provision of this chapter." ;
  fro-usc:hasHeading "Rule of construction" ;
  fro-usc:hasId "idd0437458-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd0437459-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-4-3-3> ;
  fro-usc:hasContentText "Paragraph (1) shall not apply to a registered investment company, or any employee, officer, director, or investment adviser thereof, unless the investment company makes disclosures in accordance with regulations prescribed by the Commission." ;
  fro-usc:hasHeading "Disclosures" ;
  fro-usc:hasId "idd0437459-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd043745a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-4-4> ;
  fro-usc:hasContentText "For purposes of this subsection the term “person” includes the Federal Government and any State or political subdivision of a State." ;
  fro-usc:hasHeading "Person defined" ;
  fro-usc:hasId "idd043745a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/c/3" ;
  fro-usc:hasNumberText "(3)" ;
.
