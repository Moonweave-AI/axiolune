  fro-usc:hasContentText "securities of any eligible portfolio company with respect to which the business development company satisfies the requirements of section 80a–2(a)(46)(C)(ii) of this title ;" ;
  fro-usc:hasId "idd04d11a1-0c74-11e6-aa53-e455a13f2ad9" ;
