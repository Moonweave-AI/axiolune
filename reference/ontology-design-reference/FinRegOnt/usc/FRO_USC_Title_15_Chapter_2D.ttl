usc-t15-ch2D:idd04aa11a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa11b-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa11c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa11d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 41 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa120-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa121-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-41> ;
  fro-usc:hasHeading "Procedure for issuance of orders" ;
  fro-usc:hasId "idd04aa11a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–39" ;
  fro-usc:hasNumberText "§ 80a–39." ;
  lkif-mereo:component usc-t15-ch2D:idd04aa11e-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa11b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-41-2> ;
  fro-usc:hasContentText "Orders of the Commission under this subchapter shall be issued only after appropriate notice and opportunity for hearing. Notice to the parties to a proceeding before the Commission shall be given by personal service upon each party or by registered mail or certified mail or confirmed telegraphic notice to the party’s last known business address. Notice to interested persons, if any, other than parties may be given in the same manner or by publication in the Federal Register." ;
  fro-usc:hasHeading "Notice and hearing" ;
  fro-usc:hasId "idd04aa11b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–39/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd04aa11c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-41-3> ;
  fro-usc:hasContentText "The Commission may provide, by appropriate rules or regulations, that an application verified under oath may be admissible in evidence in a proceeding before the Commission and that the record in such a proceeding may consist, in whole or in part, of such application." ;
  fro-usc:hasHeading "Application verified under oath admissible as evidence" ;
  fro-usc:hasId "idd04aa11c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–39/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04aa11d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-41-4> ;
  fro-usc:hasContentText "In any proceeding before the Commission, the Commission, in accordance with such rules and regulations as it may prescribe, shall admit as a party any interested State or State agency, and may admit as a party any representative of interested security holders, or any other person whose participation in the proceeding may be in the public interest or for the protection of investors." ;
  fro-usc:hasHeading "Parties" ;
  fro-usc:hasId "idd04aa11d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–39/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd04aa11e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "idd04aa11e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/86/507" ;
  fro-usc:hasReferenceText "/us/stat/54/842" ;
  fro-usc:hasReferenceText "/us/stat/74/201" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 .) , title I, § 40, 54 Stat. 842 ; Pub. L. 86–507 , § 1(15), June 11, 1960 , 74 Stat. 201" ;
.
usc-t15-ch2D:idd04aa120-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-41-6-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04aa120-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1960—Subsec. (a). Pub. L. 86–507 inserted “or certified mail” after “registered mail”." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/86/507" ;
.
usc-t15-ch2D:idd04aa121-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-41-6-1> ;
  fro-usc:hasHeading "Transfer of Functions" ;
  fro-usc:hasId "idd04aa121-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For transfer of functions of Securities and Exchange Commission, with certain exceptions, to Chairman of such Commission, see Reorg. Plan No. 10 of 1950, §§ 1, 2, eff. May 24, 1950 , 15 F.R. 3175, 64 Stat. 1265 , set out under section 78d of this title ." ;
  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
usc-t15-ch2D:idd04aa122-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 42 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa125-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-42> ;
  fro-usc:hasContentText "Hearings may be public and may be held before the Commission, any member or members thereof, or any officer or officers of the Commission designated by it, and appropriate records thereof shall be kept." ;
  fro-usc:hasHeading "Hearings by Commission" ;
  fro-usc:hasId "idd04aa122-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–40" ;
  fro-usc:hasNumberText "§ 80a–40." ;
  lkif-mereo:component usc-t15-ch2D:idd04aa123-0c74-11e6-aa53-e455a13f2ad9 ;
.
