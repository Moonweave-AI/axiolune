  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-2> ;
  fro-usc:hasHeading "Compensation, assignment, and partnership-membership provisions" ;
  fro-usc:hasId "idd0568722-0c74-11e6-aa53-e455a13f2ad9" ;
