  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b36-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b37-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b38-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b3c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b3d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b3e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b3f-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b42-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b43-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b44-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b45-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04f5b4e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd04f5b22-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-3-2-2> ;
.
usc-t15-ch2D:idd04f5b23-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-3> ;
  fro-usc:hasContentText "“Assignment” includes any direct or indirect transfer or hypothecation of an investment advisory contract by the assignor or of a controlling block of the assignor’s outstanding voting securities by a security holder of the assignor; but if the investment adviser is a partnership, no assignment of an investment advisory contract shall be deemed to result from the death or withdrawal of a minority of the members of the investment adviser having only a minority interest in the business of the investment adviser, or from the admission to the investment adviser of one or more members who, after such admission, shall be only a minority of the members and shall have only a minority interest in the business." ;
  fro-usc:hasId "idd04f5b23-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04f5b24-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-4> ;
  fro-usc:hasContentText "“Bank” means (A) a banking institution organized under the laws of the United States or a Federal savings association, as defined in section 1462(5) of title 12 , (B) a member bank of the Federal Reserve System, (C) any other banking institution, savings association, as defined in section 1462(4) of title 12 , or trust company, whether incorporated or not, doing business under the laws of any State or of the United States, a substantial portion of the business of which consists of receiving deposits or exercising fiduciary powers similar to those permitted to national banks under the authority of the Comptroller of the Currency, and which is supervised and examined by State or Federal authority having supervision over banks or savings associations, and which is not operated for the purpose of evading the provisions of this subchapter, and (D) a receiver, conservator, or other liquidating agent of any institution or firm included in clauses (A), (B), or (C) of this paragraph." ;
  fro-usc:hasId "idd04f5b24-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1462/4" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1462/5" ;
.
usc-t15-ch2D:idd04f5b25-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-5> ;
  fro-usc:hasContentText "The term “broker” has the same meaning as given in section 3 of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c ]." ;
  fro-usc:hasId "idd04f5b25-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c" ;
.
usc-t15-ch2D:idd04f5b26-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-6> ;
  fro-usc:hasContentText "“Commission” means the Securities and Exchange Commission." ;
  fro-usc:hasId "idd04f5b26-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd04f5b27-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-7> ;
  fro-usc:hasContentText "“Company” means a corporation, a partnership, an association, a joint-stock company, a trust, or any organized group of persons, whether incorporated or not; or any receiver, trustee in a case under title 11, or similar official, or any liquidating agent for any of the foregoing, in his capacity as such." ;
  fro-usc:hasId "idd04f5b27-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd04f5b28-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-8> ;
  fro-usc:hasContentText "“Convicted” includes a verdict, judgment, or plea of guilty, or a finding of guilt on a plea of nolo contendere, if such verdict, judgment, plea, or finding has not been reversed, set aside, or withdrawn, whether or not sentence has been imposed." ;
  fro-usc:hasId "idd04f5b28-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/6" ;
  fro-usc:hasNumberText "(6)" ;
.
usc-t15-ch2D:idd04f5b29-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-9> ;
  fro-usc:hasContentText "The term “dealer” has the same meaning as given in section 3 of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c ], but does not include an insurance company or investment company." ;
  fro-usc:hasId "idd04f5b29-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/7" ;
  fro-usc:hasNumberText "(7)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c" ;
.
usc-t15-ch2D:idd04f5b2a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-10> ;
  fro-usc:hasContentText "“Director” means any director of a corporation or any person performing similar functions with respect to any organization, whether incorporated or unincorporated." ;
  fro-usc:hasId "idd04f5b2a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/8" ;
  fro-usc:hasNumberText "(8)" ;
.
usc-t15-ch2D:idd04f5b2b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-11> ;
  fro-usc:hasContentText "“Exchange” means any organization, association, or group of persons, whether incorporated or unincorporated, which constitutes, maintains, or provides a market place or facilities for bringing together purchasers and sellers of securities or for otherwise performing with respect to securities the functions commonly performed by a stock exchange as that term is generally understood, and includes the market place and the market facilities maintained by such exchange." ;
  fro-usc:hasId "idd04f5b2b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/9" ;
  fro-usc:hasNumberText "(9)" ;
.
usc-t15-ch2D:idd04f5b2c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-12> ;
  fro-usc:hasContentText "“Interstate commerce” means trade, commerce, transportation, or communication among the several States, or between any foreign country and any State, or between any State and any place or ship outside thereof." ;
  fro-usc:hasId "idd04f5b2c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/10" ;
  fro-usc:hasNumberText "(10)" ;
.
usc-t15-ch2D:idd04f5b2d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-13> ;
  fro-usc:hasContentText "“Investment adviser” means any person who, for compensation, engages in the business of advising others, either directly or through publications or writings, as to the value of securities or as to the advisability of investing in, purchasing, or selling securities, or who, for compensation and as part of a regular business, issues or promulgates analyses or reports concerning securities; but does not include (A) a bank, or any bank holding company as defined in the Bank Holding Company Act of 1956 [ 12 U.S.C. 1841 (G) any family office, as defined by rule, regulation, or order of the Commission, in accordance with the purposes of this subchapter; or (H) such other persons not within the intent of this paragraph, as the Commission may designate by rules and regulations or order. et seq.] which is not an investment company, except that the term “investment adviser” includes any bank or bank holding company to the extent that such bank or bank holding company serves or acts as an investment adviser to a registered investment company, but if, in the case of a bank, such services or actions are performed through a separately identifiable department or division, the department or division, and not the bank itself, shall be deemed to be the investment adviser; (B) any lawyer, accountant, engineer, or teacher whose performance of such services is solely incidental to the practice of his profession; (C) any broker or dealer whose performance of such services is solely incidental to the conduct of his business as a broker or dealer and who receives no special compensation therefor; (D) the publisher of any bona fide newspaper, news magazine or business or financial publication of general and regular circulation; (E) any person whose advice, analyses or reports relate to no securities other than securities which are direct obligations of or obligations guaranteed as to principal or interest by the United States, or securities issued or guaranteed by corporations in which the United States has a direct or indirect interest which shall have been designated by the Secretary of the Treasury, pursuant to section 3(a)(12) of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c(a)(12) ], as exempted securities for the purposes of that Act [ 15 U.S.C. 78a et seq.]; (F) any nationally recognized statistical rating organization, as that term is defined in section 3(a)(62) of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c(a)(62) ], unless such organization engages in issuing recommendations as to purchasing, selling, or holding securities or in managing assets, consisting in whole or in part of securities, on behalf of others;;  1" ;
  fro-usc:hasId "idd04f5b2d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/11" ;
  fro-usc:hasNumberText "(11)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c/a/12" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c/a/62" ;
.
usc-t15-ch2D:idd04f5b2e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-14> ;
  fro-usc:hasContentText "“Investment company”, affiliated person, and “insurance company” have the same meanings as in the Investment Company Act of 1940 [ 15 U.S.C. 80a–1 et seq.]. “Control” means the power to exercise a controlling influence over the management or policies of a company, unless such power is solely the result of an official position with such company." ;
  fro-usc:hasId "idd04f5b2e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/12" ;
  fro-usc:hasNumberText "(12)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–1" ;
.
usc-t15-ch2D:idd04f5b2f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-15> ;
  fro-usc:hasContentText "“Investment supervisory services” means the giving of continuous advice as to the investment of funds on the basis of the individual needs of each client." ;
  fro-usc:hasId "idd04f5b2f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/13" ;
  fro-usc:hasNumberText "(13)" ;
.
usc-t15-ch2D:idd04f5b30-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-16> ;
  fro-usc:hasContentText "“Means or instrumentality of interstate commerce” includes any facility of a national securities exchange." ;
  fro-usc:hasId "idd04f5b30-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/14" ;
  fro-usc:hasNumberText "(14)" ;
.
usc-t15-ch2D:idd04f5b31-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-17> ;
  fro-usc:hasContentText "“National securities exchange” means an exchange registered under section 6 of the Securities Exchange Act of 1934 [ 15 U.S.C. 78f ]." ;
  fro-usc:hasId "idd04f5b31-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/15" ;
  fro-usc:hasNumberText "(15)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78f" ;
.
usc-t15-ch2D:idd04f5b32-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-18> ;
  fro-usc:hasContentText "“Person” means a natural person or a company." ;
  fro-usc:hasId "idd04f5b32-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/16" ;
  fro-usc:hasNumberText "(16)" ;
.
usc-t15-ch2D:idd04f5b33-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 19 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-19> ;
  fro-usc:hasContentText "The term “person associated with an investment adviser” means any partner, officer, or director of such investment adviser (or any person performing similar functions), or any person directly or indirectly controlling or controlled by such investment adviser, including any employee of such investment adviser, except that for the purposes of section 80b–3 of this title (other than subsection (f) thereof), persons associated with an investment adviser whose functions are clerical or ministerial shall not be included in the meaning of such term. The Commission may by rules and regulations classify, for the purposes of any portion of portions of this subchapter, persons, including employees controlled by an investment adviser." ;
  fro-usc:hasId "idd04f5b33-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/17" ;
  fro-usc:hasNumberText "(17)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3" ;
.
usc-t15-ch2D:idd04f5b34-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 20 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-20> ;
  fro-usc:hasContentText "“Security” means any note, stock, treasury stock, security future, bond, debenture, evidence of indebtedness, certificate of interest or participation in any profit-sharing agreement, collateral-trust certificate, preorganization certificate or subscription, transferable share, investment contract, voting-trust certificate, certificate of deposit for a security, fractional undivided interest in oil, gas, or other mineral rights, any put, call, straddle, option, or privilege on any security (including a certificate of deposit) or on any group or index of securities (including any interest therein or based on the value thereof), or any put, call, straddle, option, or privilege entered into on a national securities exchange relating to foreign currency, or, in general, any interest or instrument commonly known as a “security”, or any certificate of interest or participation in, temporary or interim certificate for, receipt for, guaranty of, or warrant or right to subscribe to or purchase any of the foregoing." ;
  fro-usc:hasId "idd04f5b34-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/18" ;
  fro-usc:hasNumberText "(18)" ;
.
usc-t15-ch2D:idd04f5b35-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 21 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-21> ;
  fro-usc:hasContentText "“State” means any State of the United States, the District of Columbia, Puerto Rico, the Virgin Islands, or any other possession of the United States." ;
  fro-usc:hasId "idd04f5b35-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/19" ;
  fro-usc:hasNumberText "(19)" ;
.
usc-t15-ch2D:idd04f5b36-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 22 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-22> ;
  fro-usc:hasContentText "“Underwriter” means any person who has purchased from an issuer with a view to, or sells for an issuer in connection with, the distribution of any security, or participates or has a direct or indirect participation in any such undertaking, or participates or has a participation in the direct or indirect underwriting of any such undertaking; but such term shall not include a person whose interest is limited to a commission from an underwriter or dealer not in excess of the usual and customary distributor’s or seller’s commission. As used in this paragraph the term “issuer” shall include in addition to an issuer, any person directly or indirectly controlling or controlled by the issuer, or any person under direct or indirect common control with the issuer." ;
  fro-usc:hasId "idd04f5b36-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/20" ;
  fro-usc:hasNumberText "(20)" ;
.
usc-t15-ch2D:idd04f5b37-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 23 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-23> ;
  fro-usc:hasContentText "“Securities Act of 1933” [ 15 U.S.C. 77a et seq.], “Securities Exchange Act of 1934” [ 15 U.S.C. 78a et seq.], and “Trust Indenture Act of 1939” [ 15 U.S.C. 77aaa et seq.], mean those Acts, respectively, as heretofore or hereafter amended." ;
  fro-usc:hasId "idd04f5b37-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/21" ;
  fro-usc:hasNumberText "(21)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77aaa" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd04f5b38-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 24 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-24> ;
  fro-usc:hasId "idd04f5b38-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/22" ;
  fro-usc:hasNumberText "(22)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-3-2-24-1> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-4-3-2-24-5> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b39-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b3a-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b3b-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b39-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-24-2> ;
  fro-usc:hasContentText "the 70 per centum of the value of the total assets condition referred to in sections 80a–2(a)(48) and 80a–54 of this title shall be 60 per centum for purposes of determining compliance therewith;" ;
  fro-usc:hasId "idd04f5b39-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/22/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04f5b3a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-24-3> ;
  fro-usc:hasContentText "such company need not be a closed-end company and need not elect to be subject to the provisions of sections 80a–54 through 80a–64 of this title; and" ;
  fro-usc:hasId "idd04f5b3a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/22/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04f5b3b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-24-4> ;
  fro-usc:hasContentText "the securities which may be purchased pursuant to section 80a–54(a) of this title may be purchased from any person." ;
  fro-usc:hasId "idd04f5b3b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/22/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–54/a" ;
.
usc-t15-ch2D:idd04f5b3c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 25 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-25> ;
  fro-usc:hasContentText "“Foreign securities authority” means any foreign government, or any governmental body or regulatory organization empowered by a foreign government to administer or enforce its laws as they relate to securities matters." ;
  fro-usc:hasId "idd04f5b3c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/23" ;
  fro-usc:hasNumberText "(23)" ;
.
usc-t15-ch2D:idd04f5b3d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 26 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-26> ;
  fro-usc:hasContentText "“Foreign financial regulatory authority” means any (A) foreign securities authority, (B) other governmental body or foreign equivalent of a self-regulatory organization empowered by a foreign government to administer or enforce its laws relating to the regulation of fiduciaries, trusts, commercial lending, insurance, trading in contracts of sale of a commodity for future delivery, or other instruments traded on or subject to the rules of a contract market, board of trade or foreign equivalent, or other financial activities, or (C) membership organization a function of which is to regulate the participation of its members in activities listed above." ;
  fro-usc:hasId "idd04f5b3d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/24" ;
  fro-usc:hasNumberText "(24)" ;
.
usc-t15-ch2D:idd04f5b3e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 27 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-27> ;
  fro-usc:hasContentText "“Supervised person” means any partner, officer, director (or other person occupying a similar status or performing similar functions), or employee of an investment adviser, or other person who provides investment advice on behalf of the investment adviser and is subject to the supervision and control of the investment adviser." ;
  fro-usc:hasId "idd04f5b3e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/25" ;
  fro-usc:hasNumberText "(25)" ;
.
usc-t15-ch2D:idd04f5b3f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 28 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-28> ;
  fro-usc:hasId "idd04f5b3f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/26" ;
  fro-usc:hasNumberText "(26)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-3-2-28-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b40-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b41-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b40-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-28-2> ;
  fro-usc:hasContentText "that is under the direct supervision of an officer or officers designated by the board of directors of the bank as responsible for the day-to-day conduct of the bank’s investment adviser activities for one or more investment companies, including the supervision of all bank employees engaged in the performance of such activities; and" ;
  fro-usc:hasId "idd04f5b40-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/26/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04f5b41-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-28-3> ;
  fro-usc:hasContentText "for which all of the records relating to its investment adviser activities are separately maintained in or extractable from such unit’s own facilities or the facilities of the bank, and such records are so maintained or otherwise accessible as to permit independent examination and enforcement by the Commission of this subchapter or the Investment Company Act of 1940 [ 15 U.S.C. 80a–1 et seq.] and rules and regulations promulgated under this subchapter or the Investment Company Act of 1940." ;
  fro-usc:hasId "idd04f5b41-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/26/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–1" ;
.
usc-t15-ch2D:idd04f5b42-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 29 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-29> ;
  fro-usc:hasContentText "The terms “security future” and “narrow-based security index” have the same meanings as provided in section 3(a)(55) of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c(a)(55) ]." ;
  fro-usc:hasId "idd04f5b42-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/27" ;
  fro-usc:hasNumberText "(27)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c/a/55" ;
.
usc-t15-ch2D:idd04f5b43-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 30 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-30> ;
  fro-usc:hasContentText "The term “credit rating agency” has the same meaning as in section 3 of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c ]." ;
  fro-usc:hasId "idd04f5b43-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/28" ;
  fro-usc:hasNumberText "(28)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c" ;
.
usc-t15-ch2D:idd04f5b44-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 31 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-31> ;
  fro-usc:hasContentText "  2 The term “private fund” means an issuer that would be an investment company, as defined in section 3 of the Investment Company Act of 1940 ( 15 U.S.C. 80a–3 ), but for section 3(c)(1) or 3(c)(7) of that Act." ;
  fro-usc:hasId "idd04f5b44-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/29" ;
  fro-usc:hasNumberText "(29)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3" ;
.
usc-t15-ch2D:idd04f5b45-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 32 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-32> ;
  fro-usc:hasId "idd04f5b45-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/30" ;
  fro-usc:hasNumberText "(30)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-3-2-32-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b46-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b47-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b48-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b49-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b46-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-32-2> ;
  fro-usc:hasContentText "has no place of business in the United States;" ;
  fro-usc:hasId "idd04f5b46-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/30/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04f5b47-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-32-3> ;
  fro-usc:hasContentText "has, in total, fewer than 15 clients and investors in the United States in private funds advised by the investment adviser;" ;
  fro-usc:hasId "idd04f5b47-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/30/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04f5b48-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-32-4> ;
  fro-usc:hasContentText "has aggregate assets under management attributable to clients in the United States and investors in the United States in private funds advised by the investment adviser of less than $25,000,000, or such higher amount as the Commission may, by rule, deem appropriate in accordance with the purposes of this subchapter; and" ;
  fro-usc:hasId "idd04f5b48-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/30/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd04f5b49-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-32-5> ;
  fro-usc:hasId "idd04f5b49-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/30/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-3-2-32-5-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b4a-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b4b-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b4a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-32-5-2> ;
  fro-usc:hasContentText "holds itself out generally to the public in the United States as an investment adviser; nor" ;
  fro-usc:hasId "idd04f5b4a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/30/D/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd04f5b4b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-32-5-3> ;
  fro-usc:hasId "idd04f5b4b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/30/D/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-3-2-32-5-3-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b4c-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04f5b4d-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04f5b4c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-32-5-3-2> ;
  fro-usc:hasContentText "an investment adviser to any investment company registered under the Investment Company Act of 1940 [ 15 U.S.C. 80a–1 et seq.]; or" ;
  fro-usc:hasId "idd04f5b4c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/30/D/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–1" ;
.
usc-t15-ch2D:idd04f5b4d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-32-5-3-3> ;
  fro-usc:hasContentText "a company that has elected to be a business development company pursuant to section 54 of the Investment Company Act of 1940 ( 15 U.S.C. 80a–53 ), and has not withdrawn its election." ;
  fro-usc:hasId "idd04f5b4d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/30/D/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–53" ;
.
usc-t15-ch2D:idd04f5b4e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 33 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-2-33> ;
  fro-usc:hasContentText "  3 The terms “commodity pool”, “commodity pool operator”, “commodity trading advisor”, “major swap participant”, “swap”, “swap dealer”, and “swap execution facility” have the same meanings as in section 1a of title 7 ." ;
  fro-usc:hasId "idd04f5b4e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/a/29" ;
  fro-usc:hasNumberText "(29)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1a" ;
.
usc-t15-ch2D:idd04f5b4f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-3> ;
  fro-usc:hasContentText "No provision in this subchapter shall apply to, or be deemed to include, the United States, a State, or any political subdivision of a State, or any agency, authority, or instrumentality of any one or more of the foregoing, or any corporation which is wholly owned directly or indirectly by any one or more of the foregoing, or any officer, agent, or employee of any of the foregoing acting as such in the course of his official duty, unless such provision makes specific reference thereto." ;
  fro-usc:hasHeading "Applicability to Federal or State government, agency, or instrumentality, or to officers, agents, or employees thereof" ;
  fro-usc:hasId "idd04f5b4f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04f5b50-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-3-4> ;
  fro-usc:hasContentText "Whenever pursuant to this subchapter the Commission is engaged in rulemaking and is required to consider or determine whether an action is necessary or appropriate in the public interest, the Commission shall also consider, in addition to the protection of investors, whether the action will promote efficiency, competition, and capital formation." ;
  fro-usc:hasHeading "Consideration of promotion of efficiency, competition, and capital formation" ;
  fro-usc:hasId "idd04f5b50-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–2/c" ;
  fro-usc:hasNumberText "(c)" ;
.
