usc-t15-ch2D:idd04f5b6b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-3-8-1-2> ;
  fro-usc:hasContentText "an investment company registered under subchapter I of this chapter; or" ;
  fro-usc:hasId "idd04f5b6b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/b/6/A/i" ;
