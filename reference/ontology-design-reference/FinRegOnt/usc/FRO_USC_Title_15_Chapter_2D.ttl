  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04856a7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-3-4> ;
  fro-usc:hasContentText "copies of every periodic or interim report or similar communication containing financial statements and transmitted to any class of such company’s security holders, such copies to be filed not later than ten days after such transmission." ;
  fro-usc:hasId "idd04856a7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04856a8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04856a9-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04856ac-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-4> ;
  fro-usc:hasHeading "Minimizing reporting burdens" ;
  fro-usc:hasId "idd04856a8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/c" ;
  fro-usc:hasNumberText "(c)" ;
.
