.
usc-t15-ch2D:idd043744e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-2-3> ;
  fro-usc:hasContentText "change its subclassification as defined in section 80a–5(a)(1) and (2) of this title or its subclassification from a diversified to a nondiversified company;" ;
  fro-usc:hasId "idd043744e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd043744f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-2-4> ;
  fro-usc:hasContentText "borrow money, issue senior securities, underwrite securities issued by other persons, purchase or sell real estate or commodities or make loans to other persons, except in each case in accordance with the recitals of policy contained in its registration statement in respect thereto;" ;
  fro-usc:hasId "idd043744f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0437450-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-2-5> ;
  fro-usc:hasContentText "deviate from its policy in respect of concentration of investments in any particular industry or group of industries as recited in its registration statement, deviate from any investment policy which is changeable only if authorized by shareholder vote, or deviate from any policy recited in its registration statement pursuant to section 80a–8(b)(3) of this title ; or" ;
  fro-usc:hasId "idd0437450-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/a/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–8/b/3" ;
.
usc-t15-ch2D:idd0437451-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-2-6> ;
  fro-usc:hasContentText "change the nature of its business so as to cease to be an investment company." ;
  fro-usc:hasId "idd0437451-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd0437452-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-3> ;
  fro-usc:hasContentText "In the case of a common-law trust of the character described in section 80a–16(c) of this title , either written approval by holders of a majority of the outstanding shares of beneficial interest or the vote of a majority of such outstanding shares cast in person or by proxy at a meeting called for the purpose shall for the purposes of subsection (a) be deemed the equivalent of the vote of a majority of the outstanding voting securities, and the provisions of paragraph (42) of section 80a–2(a) of this title as to a majority shall be applicable to the vote cast at such a meeting." ;
  fro-usc:hasHeading "Majority equivalent for common-law trusts" ;
  fro-usc:hasId "idd0437452-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–16/c" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–2/a" ;
.
