usc-t15-ch2D:idd058f8e3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 25 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8e6-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-25> ;
  fro-usc:hasContentText "An investment adviser registered under this subchapter shall take such steps to safeguard client assets over which such adviser has custody, including, without limitation, verification of such assets by an independent public accountant, as the Commission may, by rule, prescribe." ;
  fro-usc:hasHeading "Custody of client accounts" ;
  fro-usc:hasId "idd058f8e3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–18b" ;
  fro-usc:hasNumberText "§ 80b–18b." ;
  lkif-mereo:component usc-t15-ch2D:idd058f8e4-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd058f8e4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "idd058f8e4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIV" ;
  fro-usc:hasReferenceText "/us/stat/124/1577" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title II, § 223, as added Pub. L. 111–203, title IV , § 411, July 21, 2010 , 124 Stat. 1577 .)" ;
.
usc-t15-ch2D:idd058f8e6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-25-4-0> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "idd058f8e6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Section effective 1 year after July 21, 2010 , except that any investment adviser may, at the discretion of the investment adviser, register with the Commission under the Investment Advisers Act of 1940 during that 1-year period, subject to the rules of the Commission, and except as otherwise provided, see section 419 of Pub. L. 111–203 , set out as an Effective Date of 2010 Amendment note under section 80b–2 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s419" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–2" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd04f5b21-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd058f8e7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 26 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8ea-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8eb-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-26> ;
  fro-usc:hasContentText "Nothing in this subchapter shall relieve any person of any obligation or duty, or affect the availability of any right or remedy available to the Commodity Futures Trading Commission or any private party, arising under the Commodity Exchange Act ( 7 U.S.C. 1 et seq.) governing commodity pools, commodity pool operators, or commodity trading advisors." ;
  fro-usc:hasHeading "Rule of construction relating to the Commodities Exchange Act" ;
  fro-usc:hasId "idd058f8e7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–18c" ;
  fro-usc:hasNumberText "§ 80b–18c." ;
  lkif-mereo:component usc-t15-ch2D:idd058f8e8-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd058f8e8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
