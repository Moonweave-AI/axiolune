usc-t15-ch2D:idd04d11f9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11fa-0c74-11e6-aa53-e455a13f2ad9 ;
