  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-11-2-4> ;
  fro-usc:hasContentText "for such company, or any depositor of or underwriter for any such company, or any other person, to sell such a certificate." ;
  fro-usc:hasId "idd048567c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/j/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd048567d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-11-3> ;
  fro-usc:hasContentText "Paragraph (1) shall not be construed to alter, invalidate, or otherwise affect any rights or obligations, including rights of redemption, under any periodic payment plan certificate issued and sold before 30 days after September 29, 2006 ." ;
  fro-usc:hasHeading "No invalidation of existing certificates" ;
  fro-usc:hasId "idd048567d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/j/2" ;
  fro-usc:hasNumberText "(2)" ;
.
