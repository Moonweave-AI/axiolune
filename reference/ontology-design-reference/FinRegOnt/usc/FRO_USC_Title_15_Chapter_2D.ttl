  fro-leg-ref:hasSequenceNumber 2 ;
  fro-usc:hasChapeauText "No investment adviser that is regulated or required to be regulated as an investment adviser in the State in which it maintains its principal office and place of business shall register under section 80b–3 of this title , unless the investment adviser—" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd04f5b5e-0c74-11e6-aa53-e455a13f2ad9 ;
.
