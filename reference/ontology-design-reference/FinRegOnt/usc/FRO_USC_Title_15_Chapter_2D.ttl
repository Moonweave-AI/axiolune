  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd0543df4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-6-3-2-2> ;
  lkif-mereo:component usc-t15-ch2D:idd0543df5-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0543df6-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0543df5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-2-3> ;
  fro-usc:hasContentText "to maintain such records of, and file with the Commission such reports regarding, private funds advised by the investment adviser, as necessary and appropriate in the public interest and for the protection of investors, or for the assessment of systemic risk by the Financial Stability Oversight Council (in this subsection referred to as the “Council”); and" ;
  fro-usc:hasId "idd0543df5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd0543df6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-2-4> ;
  fro-usc:hasContentText "to provide or make available to the Council those reports or records or the information contained therein." ;
  fro-usc:hasId "idd0543df6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd0543df7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-3> ;
  fro-usc:hasContentText "The records and reports of any private fund to which an investment adviser registered under this subchapter provides investment advice shall be deemed to be the records and reports of the investment adviser." ;
  fro-usc:hasHeading "Treatment of records" ;
  fro-usc:hasId "idd0543df7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
