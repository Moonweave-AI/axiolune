  fro-usc:hasHeading "Effective Date of 1995 Amendment" ;
  fro-usc:hasId "idd0543dcf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Amendment by Pub. L. 104–62 , set out as a note under section 77c of this title . applicable as defense to any claim in administrative and judicial actions pending on or commenced after Dec. 8, 1995 , that any person, security, interest, or participation of type described in Pub. L. 104–62 is subject to the Securities Act of 1933, the Securities Exchange Act of 1934, the Investment Company Act of 1940, the Investment Advisers Act of 1940, or any State statute or regulation preempted as provided in section 80a–3a of this title , except as specifically provided in such statutes, see section 7 of Pub. L. 104–62" ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/104/62" ;
