  fro-usc:hasReferenceText "/us/stat/101/1261" ;
  fro-usc:hasReferenceText "/us/stat/54/800" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 .) , title I, § 5, 54 Stat. 800 ; Pub. L. 100–181, title VI , § 607, Dec. 4, 1987 , 101 Stat. 1261" ;
.
usc-t15-ch2D:idd03eb968-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-7-6-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd03eb968-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1987—Subsec. (a)(2). Pub. L. 100–181 substituted “Closed-end” for “Close-end”." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
.
