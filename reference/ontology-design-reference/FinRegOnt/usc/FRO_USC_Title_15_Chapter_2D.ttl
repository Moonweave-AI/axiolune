usc-t15-ch2D:idd045e5ec-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e5ed-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e5ee-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e5ef-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e5f2-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 22 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd045e5f5-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd045e5f6-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-22> ;
  fro-usc:hasHeading "Proxies; voting trusts; circular ownership" ;
  fro-usc:hasId "idd045e5ec-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–20" ;
  fro-usc:hasNumberText "§ 80a–20." ;
  lkif-mereo:component usc-t15-ch2D:idd045e5f3-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd045e5ed-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-22-2> ;
  fro-usc:hasContentText "It shall be unlawful for any person, by use of the mails or any means or instrumentality of interstate commerce or otherwise, to solicit or to permit the use of his name to solicit any proxy or consent or authorization in respect of any security of which a registered investment company is the issuer in contravention of such rules and regulations as the Commission may prescribe as necessary or appropriate in the public interest or for the protection of investors." ;
  fro-usc:hasHeading "Prohibition on use of means of interstate commerce for solicitation of proxies" ;
  fro-usc:hasId "idd045e5ed-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–20/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd045e5ee-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-22-3> ;
  fro-usc:hasContentText "It shall be unlawful for any registered investment company or affiliated person thereof, any issuer of a voting-trust certificate relating to any security of a registered investment company, or any underwriter of such a certificate, by use of the mails or any means or instrumentality of interstate commerce, or otherwise, to offer for sale, sell, or deliver after sale, in connection with a public offering, any such voting-trust certificate." ;
  fro-usc:hasHeading "Prohibition on use of means of interstate commerce for sale of voting-trust certificates" ;
  fro-usc:hasId "idd045e5ee-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–20/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd045e5ef-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e5f0-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e5f1-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-22-4> ;
  fro-usc:hasHeading "Prohibition on purchase of securities knowingly resulting in cross-ownership or circular ownership" ;
  fro-usc:hasId "idd045e5ef-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–20/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-22-4-2> ;
.
usc-t15-ch2D:idd045e5f0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-22-4-3> ;
  fro-usc:hasContentText "beneficially owns more than 3 per centum of the outstanding voting securities of one or more other companies of the group; and" ;
  fro-usc:hasId "idd045e5f0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–20/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd045e5f1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-22-4-4> ;
  fro-usc:hasContentText "has more than 3 per centum of its own outstanding voting securities beneficially owned by another company, or by each of two or more other companies, of the group." ;
  fro-usc:hasId "idd045e5f1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–20/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd045e5f2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-22-5> ;
  fro-usc:hasContentText "If cross-ownership or circular ownership between a registered investment company and any other company or companies comes into existence upon the purchase by a registered investment company of the securities of another company, it shall be the duty of such registered company, within one year after it first knows of the existence of such cross-ownership or circular ownership, to eliminate the same." ;
  fro-usc:hasHeading "Duty to eliminate existing cross-ownership or circular ownership" ;
  fro-usc:hasId "idd045e5f2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–20/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd045e5f3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "idd045e5f3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/100/181/tVI" ;
  fro-usc:hasReferenceText "/us/stat/101/1262" ;
  fro-usc:hasReferenceText "/us/stat/54/822" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 .) , title I, § 20, 54 Stat. 822 ; Pub. L. 100–181, title VI , § 614, Dec. 4, 1987 , 101 Stat. 1262" ;
.
usc-t15-ch2D:idd045e5f5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-22-7-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd045e5f5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1987—Subsec. (b). Pub. L. 100–181 , § 614(1), struck out at end “The prohibitions of this subsection shall not apply to a class of voting-trust certificates, if any certificate of such class was made the subject of a public offering by the issuer or by or through an underwriter prior to March 15, 1940 .”" ;
  fro-usc:hasNoteText "Subsec. (d). Pub. L. 100–181 , § 614(2), (3), struck out first sentence “If on the effective date of this subchapter cross-ownership or circular ownership exists between a registered investment company and any other company or companies, it shall be the duty of such registered company, within five years after such effective date, to eliminate such cross-ownership or circular ownership.” and “at any time after the effective date of this subchapter” after “If” in second sentence." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
.
usc-t15-ch2D:idd045e5f6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
