  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb9aa-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412aae-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412aaf-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ab2-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0412ab5-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0412ab6-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0412ab7-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0412ab8-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10> ;
  fro-usc:hasHeading "Registration of investment companies" ;
  fro-usc:hasId "idd03eb9a2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8" ;
  fro-usc:hasNumberText "§ 80a–8." ;
  lkif-mereo:component usc-t15-ch2D:idd0412ab3-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03eb9a3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-2> ;
  fro-usc:hasContentText "Any investment company organized or otherwise created under the laws of the United States or of a State may register for the purposes of this subchapter by filing with the Commission a notification of registration, in such form as the Commission shall by rules and regulations prescribe as necessary or appropriate in the public interest or for the protection of investors. An investment company shall be deemed to be registered upon receipt by the Commission of such notification of registration." ;
  fro-usc:hasHeading "Notification of registration; effective date of registration" ;
  fro-usc:hasId "idd03eb9a3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd03eb9a4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb9a5-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb9a6-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb9a7-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb9a8-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb9a9-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-3> ;
  fro-usc:hasHeading "Registration statement; contents" ;
  fro-usc:hasId "idd03eb9a4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-10-3-2> ;
.
usc-t15-ch2D:idd03eb9a5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-3-3> ;
  fro-usc:hasContentText "a recital of the policy of the registrant in respect of each of the following types of activities, such recital consisting in each case of a statement whether the registrant reserves freedom of action to engage in activities of such type, and if such freedom of action is reserved, a statement briefly indicating, insofar as is practicable, the extent to which the registrant intends to engage therein: (A) the classification and subclassifications, as defined in sections 80a–4 and 80a–5 of this title, within which the registrant proposes to operate; (B) borrowing money; (C) the issuance of senior securities; (D) engaging in the business of underwriting securities issued by other persons; (E) concentrating investments in a particular industry or group of industries; (F) the purchase and sale of real estate and commodities, or either of them; (G) making loans to other persons; and (H) portfolio turn-over (including a statement showing the aggregate dollar amount of purchases and sales of portfolio securities, other than Government securities, in each of the last three full fiscal years preceding the filing of such registration statement);" ;
  fro-usc:hasId "idd03eb9a5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd03eb9a6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-3-4> ;
  fro-usc:hasContentText "a recital of all investment policies of the registrant, not enumerated in paragraph (1), which are changeable only if authorized by shareholder vote;" ;
  fro-usc:hasId "idd03eb9a6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd03eb9a7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-3-5> ;
  fro-usc:hasContentText "a recital of all policies of the registrant, not enumerated in paragraphs (1) and (2), in respect of matters which the registrant deems matters of fundamental policy;" ;
  fro-usc:hasId "idd03eb9a7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd03eb9a8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-3-6> ;
  fro-usc:hasContentText "the name and address of each affiliated person of the registrant; the name and principal address of every company, other than the registrant, of which each such person is an officer, director, or partner; a brief statement of the business experience for the preceding five years of each officer and director of the registrant; and" ;
  fro-usc:hasId "idd03eb9a8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd03eb9a9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-3-7> ;
  fro-usc:hasContentText "the information and documents which would be required to be filed in order to register under the Securities Act of 1933 [ 15 U.S.C. 77a et seq.] and the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], all securities (other than short-term paper) which the registrant has outstanding or proposes to issue." ;
  fro-usc:hasId "idd03eb9a9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/b/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd03eb9aa-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb9ab-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412aac-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412aad-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-4> ;
  fro-usc:hasHeading "Alternative information" ;
  fro-usc:hasId "idd03eb9aa-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-10-4-2> ;
.
usc-t15-ch2D:idd03eb9ab-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-4-3> ;
  fro-usc:hasContentText "copies of the most recent registration statement filed by the registrant under the Securities Act of 1933 [ 15 U.S.C. 77a et seq.] and currently effective under such Act, or if the registrant has not filed such a statement, copies of a registration statement filed by the registrant under the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.] and currently effective under such Act;" ;
  fro-usc:hasId "idd03eb9ab-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/c/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd0412aac-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-4-4> ;
  fro-usc:hasContentText "copies of any reports filed by the registrant pursuant to section 78m or 78 o (d) of this title; and" ;
  fro-usc:hasId "idd0412aac-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0412aad-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-4-5> ;
  fro-usc:hasContentText "a report containing reasonably current information regarding the matters included in copies filed pursuant to paragraphs (1) and (2) of this subsection, and such further information regarding matters not included in such copies as the Commission is authorized to require under subsection (b)." ;
  fro-usc:hasId "idd0412aad-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/c/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0412aae-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-5> ;
  fro-usc:hasContentText "If the registrant is a unit investment trust substantially all of the assets of which are securities issued by another registered investment company, the Commission is authorized to prescribe for the registrant, by rules and regulations or order, a registration statement which eliminates inappropriate duplication of information contained in the registration statement filed under this section by such other investment company." ;
  fro-usc:hasHeading "Registration of unit investment trusts" ;
  fro-usc:hasId "idd0412aae-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd0412aaf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ab0-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ab1-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-6> ;
  fro-usc:hasHeading "Failure to file registration statement or omissions of material fact" ;
  fro-usc:hasId "idd0412aaf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-10-6-2> ;
.
usc-t15-ch2D:idd0412ab0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-6-3> ;
  fro-usc:hasContentText "that such company has failed to file a registration statement required by this section or a report required pursuant to section 80a–29(a) or (b) of this title, or has filed such a registration statement or report but omitted therefrom material facts required to be stated therein, or has filed such a registration statement or report in violation of section 80a–33(b) of this title ; and" ;
  fro-usc:hasId "idd0412ab0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/e/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–33/b" ;
.
usc-t15-ch2D:idd0412ab1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-6-4> ;
  fro-usc:hasContentText "that such suspension or revocation is in the public interest." ;
  fro-usc:hasId "idd0412ab1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0412ab2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-10-7> ;
  fro-usc:hasContentText "Whenever the Commission, on its own motion or upon application, finds that a registered investment company has ceased to be an investment company, it shall so declare by order and upon the taking effect of such order the registration of such company shall cease to be in effect. If necessary for the protection of investors, an order under this subsection may be made upon appropriate conditions. The Commission’s denial of any application under this subsection shall be by order." ;
  fro-usc:hasHeading "Cessation of existence as investment company" ;
  fro-usc:hasId "idd0412ab2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–8/f" ;
  fro-usc:hasNumberText "(f)" ;
.
