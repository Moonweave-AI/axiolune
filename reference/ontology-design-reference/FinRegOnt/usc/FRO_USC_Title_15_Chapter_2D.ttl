usc-t15-ch2D:idd03eb997-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-3-3> ;
  fro-usc:hasContentText "offer for sale, sell, or deliver after sale, by use of the mails or any means or instrumentality of interstate commerce, any security or any interest in a security of which such company is the issuer; or offer for sale, sell, or deliver after sale any such security or interest, having reason to believe that such security or interest will be made the subject of a public offering by use of the mails or any means or instrumentality of interstate commerce;" ;
  fro-usc:hasId "idd03eb997-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd03eb998-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-3-4> ;
  fro-usc:hasContentText "purchase, redeem, or otherwise acquire or attempt to acquire, by use of the mails or any means or instrumentality of interstate commerce, any security or any interest in a security of which such company is the issuer; or" ;
  fro-usc:hasId "idd03eb998-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd03eb999-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-3-5> ;
  fro-usc:hasContentText "sell or purchase for the account of such company, by use of the mails or any means or instrumentality of interstate commerce, any security or interest in a security, by whomever issued." ;
  fro-usc:hasId "idd03eb999-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd03eb99a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-4> ;
  fro-usc:hasContentText "No promoter of a proposed investment company, and no underwriter for such a promoter, shall make use of the mails or any means or instrumentality of interstate commerce, directly or indirectly, to offer for sale, sell, or deliver after sale, in connection with a public offering, any preorganization certificate or subscription for such a company." ;
  fro-usc:hasHeading "Prohibition of transactions in interstate commerce by promoters of proposed investment companies" ;
  fro-usc:hasId "idd03eb99a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd03eb99b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-5> ;
  fro-usc:hasContentText "No investment company, unless organized or otherwise created under the laws of the United States or of a State, and no depositor or trustee of or underwriter for such a company not so organized or created, shall make use of the mails or any means or instrumentality of interstate commerce, directly or indirectly, to offer for sale, sell, or deliver after sale, in connection with a public offering, any security of which such company is the issuer. Notwithstanding the provisions of this subsection and of section 80a–8(a) of this title , the Commission is authorized, upon application by an investment company organized or otherwise created under the laws of a foreign country, to issue a conditional or unconditional order permitting such company to register under this subchapter, and to make a public offering of its securities by use of the mails and means or instrumentalities of interstate commerce, if the Commission finds that, by reason of special circumstances or arrangements, it is both legally and practically feasible effectively to enforce the provisions of this subchapter against such company and that the issuance of such order is otherwise consistent with the public interest and the protection of investors." ;
  fro-usc:hasHeading "Prohibition of transactions in interstate commerce by companies not organized under laws of the United States or a State; exceptions" ;
  fro-usc:hasId "idd03eb99b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–8/a" ;
.
usc-t15-ch2D:idd03eb99c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-6> ;
  fro-usc:hasContentText "Each fund that is excluded from the definition of an investment company under section 80a–3(c)(10)(B) of this title shall provide, to each donor to such fund, at the time of the donation or within 90 days after December 8, 1995 , whichever is later, written information describing the material terms of the operation of such fund." ;
  fro-usc:hasHeading "Disclosure by exempt charitable organizations" ;
  fro-usc:hasId "idd03eb99c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/10/B" ;
.
usc-t15-ch2D:idd03eb99d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
