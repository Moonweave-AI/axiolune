  fro-usc:hasReferenceText "/us/stat/54/856" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 ; Pub. L. 101–429, title IV , § 403, Oct. 15, 1990 , 104 Stat. 951 ; Pub. L. 111–203, title IX , §§ 929E(d), 929P(b)(3), July 21, 2010 , 124 Stat. 1853 , 1865.) , title II, § 214, 54 Stat. 856 ; Pub. L. 100–181, title VII , § 707, Dec. 4, 1987 , 101 Stat. 1264" ;
.
usc-t15-ch2D:idd058f8b8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-19-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd058f8b8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Federal Rules of Civil Procedure, referred to in subsec. (a), are set out in the Appendix to Title 28, Judiciary and Judicial Procedure." ;
  fro-usc:hasNoteTopic "referencesInText" ;
.
usc-t15-ch2D:idd058f8b9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-19-5-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd058f8b9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1987— Pub. L. 100–181 substituted “sections 1254, 1291, 1292, and 1294 of title 28” for “sections 128 and 240 of the Judicial Code, as amended, and section 7, as amended, of the Act entitled ‘An Act to establish a court of appeals for the District of Columbia’, approved February 9, 1893 ”." ;
  fro-usc:hasNoteText "1990— Pub. L. 101–429 inserted “and actions at law brought to enforce any liability or duty created by, or” after “all suits in equity” and “to enforce any liability or duty created by, or” after “Any suit or action”." ;
  fro-usc:hasNoteText "2010— Pub. L. 111–203 , § 929P(b)(3), designated existing provisions as subsec. (a), inserted heading, and added subsec. (b)." ;
  fro-usc:hasNoteText "Pub. L. 111–203 , § 929E(d), inserted “In any action or proceeding instituted by the Commission under this subchapter in a United States district court for any judicial district, a subpoena issued to compel the attendance of a witness or the production of documents or tangible things (or both) at a hearing or trial may be served at any place within the United States. Rule 45(c)(3)(A)(ii) of the Federal Rules of Civil Procedure shall not apply to a subpoena issued under the preceding sentence.” after “defendant may be found.”" ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
  fro-usc:hasReferenceText "/us/pl/101/429" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
.
