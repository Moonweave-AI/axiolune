  lkif-mereo:component usc-t15-ch2D:idd05686ff-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd05686fe-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-9-4-2> ;
  fro-usc:hasContentText "a request for information from any other Federal department or agency or any self-regulatory organization requesting the report or information for purposes within the scope of its jurisdiction; or" ;
  fro-usc:hasId "idd05686fe-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/8/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd05686ff-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-9-4-3> ;
  fro-usc:hasContentText "an order of a court of the United States in an action brought by the United States or the Commission." ;
  fro-usc:hasId "idd05686ff-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/8/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0568700-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-10> ;
  fro-usc:hasContentText "Any department, agency, or self-regulatory organization that receives reports or information from the Commission under this subsection shall maintain the confidentiality of such reports, documents, records, and information in a manner consistent with the level of confidentiality established for the Commission under paragraph (8)." ;
  fro-usc:hasHeading "Other recipients confidentiality" ;
  fro-usc:hasId "idd0568700-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/9" ;
  fro-usc:hasNumberText "(9)" ;
.
usc-t15-ch2D:idd0568701-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-11> ;
  fro-usc:hasHeading "Public information exception" ;
  fro-usc:hasId "idd0568701-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/10" ;
  fro-usc:hasNumberText "(10)" ;
  lkif-mereo:component usc-t15-ch2D:idd0568702-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0568703-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0568702-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-11-2> ;
  fro-usc:hasContentText "The Commission, the Council, and any other department, agency, or self-regulatory organization that receives information, reports, documents, records, or information from the Commission under this subsection, shall be exempt from the provisions of section 552 of title 5 with respect to any such report, document, record, or information. Any proprietary information of an investment adviser ascertained by the Commission from any report required to be filed with the Commission pursuant to this subsection shall be subject to the same limitations on public disclosure as any facts ascertained during an examination, as provided by section 80b–10(b) of this title ." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd0568702-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/10/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–10/b" ;
  fro-usc:hasReferenceText "/us/usc/t5/s552" ;
.
usc-t15-ch2D:idd0568703-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-11-3> ;
  fro-usc:hasHeading "Proprietary information" ;
  fro-usc:hasId "idd0568703-0c74-11e6-aa53-e455a13f2ad9" ;
