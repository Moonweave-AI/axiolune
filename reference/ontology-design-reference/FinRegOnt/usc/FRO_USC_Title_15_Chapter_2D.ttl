  fro-usc:hasContentText "such assets were contributed before the date which is 60 days after December 8, 1995 ; and" ;
  fro-usc:hasId "idd03eb92a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/10/C/i" ;
