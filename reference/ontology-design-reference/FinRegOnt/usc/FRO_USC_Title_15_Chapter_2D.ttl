  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 .) , title I, § 21, 54 Stat. 822 ; Pub. L. 100–181, title VI , § 615, Dec. 4, 1987 , 101 Stat. 1262" ;
.
usc-t15-ch2D:idd045e5fc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-23-6-0> ;
