usc-t15-ch2D:idd0568741-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0568744-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-10> ;
  fro-usc:hasContentText "The Commission, by rules and regulations, upon its own motion, or by order upon application, may conditionally or unconditionally exempt any person or transaction, or any class or classes of persons, or transactions, from any provision or provisions of this subchapter or of any rule or regulation thereunder, if and to the extent that such exemption is necessary or appropriate in the public interest and consistent with the protection of investors and the purposes fairly intended by the policy and provisions of this subchapter." ;
  fro-usc:hasHeading "Exemptions" ;
  fro-usc:hasId "idd0568741-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–6a" ;
  fro-usc:hasNumberText "§ 80b–6a." ;
  lkif-mereo:component usc-t15-ch2D:idd0568742-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0568742-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "idd0568742-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
  fro-usc:hasReferenceText "/us/stat/84/1433" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title II, § 206A, as added Pub. L. 91–547 , § 26, Dec. 14, 1970 , 84 Stat. 1433 .)" ;
.
usc-t15-ch2D:idd0568744-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-10-4-0> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "idd0568744-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Section effective Dec. 14, 1970 , see section 30 of Pub. L. 91–547 , set out as a note under section 80a–2 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/91/547/s30" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–2" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd039fe81-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0568745-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0568748-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-11> ;
  fro-usc:hasContentText "It shall be unlawful for any person willfully to make any untrue statement of a material fact in any registration application or report filed with the Commission under section 80b–3 or 80b–4 of this title, or willfully to omit to state in any such application or report any material fact which is required to be stated therein." ;
  fro-usc:hasHeading "Material misstatements" ;
  fro-usc:hasId "idd0568745-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–7" ;
  fro-usc:hasNumberText "§ 80b–7." ;
  lkif-mereo:component usc-t15-ch2D:idd0568746-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0568746-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
