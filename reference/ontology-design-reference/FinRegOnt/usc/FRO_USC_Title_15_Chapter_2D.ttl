  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-4-2> ;
  fro-usc:hasId "idd04856a9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/c/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-31-4-2-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04856aa-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04856ab-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04856aa-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-4-2-2> ;
  fro-usc:hasContentText "under subsection (f); and" ;
  fro-usc:hasId "idd04856aa-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/c/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04856ab-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-4-2-3> ;
  fro-usc:hasContentText "under subsection (b)(1), if the Commission requires the filing of information, documents, and reports under that subsection on a basis more frequently than semiannually." ;
  fro-usc:hasId "idd04856ab-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/c/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04856ac-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-4-3> ;
  fro-usc:hasId "idd04856ac-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-31-4-3-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04856ad-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04856ae-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04856ad-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-4-3-2> ;
  fro-usc:hasContentText "feasible alternatives that minimize the reporting burdens on registered investment companies; and" ;
  fro-usc:hasId "idd04856ad-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04856ae-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-4-3-3> ;
  fro-usc:hasContentText "the utility of such information, documents, and reports to the Commission in relation to the costs to registered investment companies and their affiliated persons of providing such information, documents, and reports." ;
  fro-usc:hasId "idd04856ae-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04856af-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-5> ;
  fro-usc:hasContentText "The Commission shall issue rules and regulations permitting the filing with the Commission, and with any national securities exchange concerned, of copies of periodic reports, or of extracts therefrom, filed by any registered investment company pursuant to subsections (a) and (b), in lieu of any reports and documents required of such company under section 13 or 15(d) of the Securities Exchange Act of 1934 [ 15 U.S.C. 78m or 78 o (d)]." ;
  fro-usc:hasHeading "Reports under this section in lieu of reports under other provisions of law" ;
  fro-usc:hasId "idd04856af-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78m" ;
.
usc-t15-ch2D:idd04856b0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04856b1-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04856b2-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04856b3-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04856b4-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04856b5-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04856b6-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-6> ;
  fro-usc:hasHeading "Semiannual reports to stockholders" ;
  fro-usc:hasId "idd04856b0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-31-6-2> ;
.
usc-t15-ch2D:idd04856b1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-6-3> ;
  fro-usc:hasContentText "a balance sheet accompanied by a statement of the aggregate value of investments on the date of such balance sheet;" ;
  fro-usc:hasId "idd04856b1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04856b2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-6-4> ;
  fro-usc:hasContentText "a list showing the amounts and values of securities owned on the date of such balance sheet;" ;
  fro-usc:hasId "idd04856b2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04856b3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-6-5> ;
  fro-usc:hasContentText "a statement of income, for the period covered by the report, which shall be itemized at least with respect to each category of income and expense representing more than 5 per centum of total income or expense;" ;
  fro-usc:hasId "idd04856b3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd04856b4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-6-6> ;
  fro-usc:hasContentText "a statement of surplus, which shall be itemized at least with respect to each charge or credit to the surplus account which represents more than 5 per centum of the total charges or credits during the period covered by the report;" ;
  fro-usc:hasId "idd04856b4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/e/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd04856b5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-6-7> ;
  fro-usc:hasContentText "a statement of the aggregate remuneration paid by the company during the period covered by the report (A) to all directors and to all members of any advisory board for regular compensation; (B) to each director and to each member of an advisory board for special compensation; (C) to all officers; and (D) to each person of whom any officer or director of the company is an affiliated person; and" ;
  fro-usc:hasId "idd04856b5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/e/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd04856b6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-6-8> ;
  fro-usc:hasContentText "a statement of the aggregate dollar amounts of purchases and sales of investment securities, other than Government securities, made during the period covered by the report:" ;
  fro-usc:hasId "idd04856b6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/e/6" ;
  fro-usc:hasNumberText "(6)" ;
.
usc-t15-ch2D:idd04856b7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-7> ;
  fro-usc:hasContentText "The Commission may, by rule, require that semiannual reports containing the information set forth in subsection (e) include such other information as the Commission deems necessary or appropriate in the public interest or for the protection of investors." ;
  fro-usc:hasHeading "Additional information" ;
  fro-usc:hasId "idd04856b7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/f" ;
  fro-usc:hasNumberText "(f)" ;
.
usc-t15-ch2D:idd04856b8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-8> ;
  fro-usc:hasContentText "Financial statements contained in annual reports required pursuant to subsections (a) and (e), if required by the rules and regulations of the Commission, shall be accompanied by a certificate of independent public accountants. The certificate of such independent public accountants shall be based upon an audit not less in scope or procedures followed than that which independent public accountants would ordinarily make for the purpose of presenting comprehensive and dependable financial statements, and shall contain such information as the Commission may prescribe, by rules and regulations in the public interest or for the protection of investors, as to the nature and scope of the audit and the findings and opinion of the accountants. Each such report shall state that such independent public accountants have verified securities owned, either by actual examination, or by receipt of a certificate from the custodian, as the Commission may prescribe by rules and regulations." ;
  fro-usc:hasHeading "Certificate of independent public accountants" ;
  fro-usc:hasId "idd04856b8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/g" ;
  fro-usc:hasNumberText "(g)" ;
.
usc-t15-ch2D:idd04856b9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-9> ;
  fro-usc:hasContentText "Every person who is directly or indirectly the beneficial owner of more than 10 per centum of any class of outstanding securities (other than short-term paper) of which a registered closed-end company is the issuer or who is an officer, director, member of an advisory board, investment adviser, or affiliated person of an investment adviser of such a company shall in respect of his transactions in any securities of such company (other than short-term paper) be subject to the same duties and liabilities as those imposed by section 16 of the Securities Exchange Act of 1934 [ 15 U.S.C. 78p ] upon certain beneficial owners, directors, and officers in respect of their transactions in certain equity securities." ;
  fro-usc:hasHeading "Duties and liabilities of affiliated persons" ;
  fro-usc:hasId "idd04856b9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/h" ;
  fro-usc:hasNumberText "(h)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78p" ;
.
usc-t15-ch2D:idd04856ba-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04856bb-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04856bc-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-10> ;
  fro-usc:hasHeading "Disclosure to church plan participants" ;
  fro-usc:hasId "idd04856ba-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-31-10-2> ;
.
usc-t15-ch2D:idd04856bb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-10-3> ;
  fro-usc:hasContentText "the plan, or any company or account maintained to manage or hold plan assets and interests in such plan, company, or account, are not subject to registration, regulation, or reporting under this subchapter, the Securities Act of 1933 [ 15 U.S.C. 77a et seq.], the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], or State securities laws; and" ;
  fro-usc:hasId "idd04856bb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/i/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd04856bc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-10-4> ;
  fro-usc:hasContentText "plan participants and beneficiaries therefore will not be afforded the protections of those provisions." ;
  fro-usc:hasId "idd04856bc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/i/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04856bd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-11> ;
  fro-usc:hasContentText "The Commission may issue rules and regulations to require any person that maintains a church plan that is excluded from the definition of an investment company solely by reason of section 80a–3(c)(14) of this title to file a notice with the Commission containing such information and in such form as the Commission may prescribe as necessary or appropriate in the public interest or consistent with the protection of investors." ;
  fro-usc:hasHeading "Notice to Commission" ;
  fro-usc:hasId "idd04856bd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/j" ;
  fro-usc:hasNumberText "(j)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/14" ;
.
usc-t15-ch2D:idd04aa0ae-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-usc:hasId "idd04aa0ae-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/104/290/tII" ;
  fro-usc:hasReferenceText "/us/pl/105/353/tIII" ;
  fro-usc:hasReferenceText "/us/stat/110/3430" ;
  fro-usc:hasReferenceText "/us/stat/112/3237" ;
  fro-usc:hasReferenceText "/us/stat/54/836" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , 3449; Pub. L. 105–353, title III , § 301(c)(5), Nov. 3, 1998 , 112 Stat. 3237 .) , title I, § 30, 54 Stat. 836 ; Pub. L. 104–290, title II , § 206, title V, § 508(g), Oct. 11, 1996 , 110 Stat. 3430" ;
.
usc-t15-ch2D:idd04aa0b0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-13-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd04aa0b0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Securities Act of 1933, referred to in subsec. (i)(1), is act May 27, 1933, ch. 38, title I , 48 Stat. 74 , as amended, which is classified generally to subchapter I (§ 77a et seq.) of chapter 2A of this title. For complete classification of this Act to the Code, see section 77a of this title and Tables." ;
  fro-usc:hasNoteText "The Securities Exchange Act of 1934, referred to in subsec. (i)(1), is act June 6, 1934, ch. 404 , 48 Stat. 881 , as amended, which is classified principally to chapter 2B (§ 78a et seq.) of this title. For complete classification of this Act to the Code, see section 78a of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1933-05-27/ch38/tI" ;
  fro-usc:hasReferenceText "/us/act/1934-06-06/ch404" ;
  fro-usc:hasReferenceText "/us/stat/48/74" ;
  fro-usc:hasReferenceText "/us/stat/48/881" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd04aa0b1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-13-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04aa0b1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1996—Subsec. (b)(1). Pub. L. 104–290 , § 206(1), added par. (1) and struck out former par. (1) which read as follows: “such information and documents (other than financial statements) as the Commission may require, on a semi-annual or quarterly basis, to keep reasonably current the information and documents contained in the registration statement of such company filed under this subchapter; and”." ;
  fro-usc:hasNoteText "1998—Subsec. (b)(1). Pub. L. 105–353 , § 301(c)(5)(A), inserted “and” after semicolon at end." ;
  fro-usc:hasNoteText "Pub. L. 104–290 , § 206(2), (5), redesignated subsec. (e), relating to certificate of independent public accountants, as (g), and substituted “pursuant to subsections (a) and (e)” for “pursuant to subsections (a) and (d)”." ;
  fro-usc:hasNoteText "Pub. L. 104–290 , § 206(2), redesignated subsec. (f), relating to duties and liabilities of affiliated persons, as (h)." ;
  fro-usc:hasNoteText "Subsec. (e). Pub. L. 105–353 , § 301(c)(5)(B), substituted “semiannually” for “semi-annually” in introductory provisions." ;
  fro-usc:hasNoteText "Subsec. (f). Pub. L. 104–290 , § 206(2), (4), added subsec. (f). Former subsec. (f) redesignated (h)." ;
  fro-usc:hasNoteText "Subsec. (g). Pub. L. 104–290 , § 508(g), added subsec. (g), relating to disclosure to church plan participants." ;
  fro-usc:hasNoteText "Subsec. (h). Pub. L. 104–290 , § 508(g), added subsec. (h), relating to notice to Commission." ;
  fro-usc:hasNoteText "Subsecs. (c) to (e). Pub. L. 104–290 , § 206(2), (3), added subsec. (c) and redesignated former subsecs. (c) and (d) as (d) and (e), respectively. Former subsec. (e) redesignated (g)." ;
  fro-usc:hasNoteText "Subsecs. (g) to (j). Pub. L. 105–353 , § 301(c)(5)(C), redesignated subsecs. (g) and (h), relating to disclosure to church plan participants and notice to Commission, respectively, as (i) and (j), respectively." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/104/290" ;
  fro-usc:hasReferenceText "/us/pl/105/353" ;
.
usc-t15-ch2D:idd04aa0b2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-13-2> ;
  fro-usc:hasHeading "Transfer of Functions" ;
  fro-usc:hasId "idd04aa0b2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For transfer of functions of Securities and Exchange Commission, with certain exceptions, to Chairman of such Commission, see Reorg. Plan No. 10 of 1950, §§ 1, 2, eff. May 24, 1950 , 15 F.R. 3175, 64 Stat. 1265 , set out under section 78d of this title ." ;
  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
