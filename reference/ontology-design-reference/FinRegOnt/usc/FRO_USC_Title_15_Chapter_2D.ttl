  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-3> ;
  fro-usc:hasId "idd04d1202-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-62-2-5-3-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04d1203-0c74-11e6-aa53-e455a13f2ad9 ;
