  fro-usc:hasNoteText "Amendment by Pub. L. 101–429 effective Oct. 15, 1990 , with provisions relating to civil penalties and accounting and disgorgement, see section 1(c)(1), (2) of Pub. L. 101–429 , set out in a note under section 77g of this title ." ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/101/429" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77g" ;
.
usc-t15-ch2D:idd058f8bc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-19-5-4> ;
  fro-usc:hasHeading "Transfer of Functions" ;
