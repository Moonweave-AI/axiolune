.
usc-t15-ch2D:idd058f8c5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-21-2-0> ;
  fro-usc:hasHeading "Codification" ;
  fro-usc:hasId "idd058f8c5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Section, act Aug. 22, 1940, ch. 686, title II , Money and Finance. See, also, page 191 of House Document No. 103–7. , § 216, 54 Stat. 857 , which required the Securities and Exchange Commission to submit an annual report to Congress on the work of the Commission, terminated, effective May 15, 2000 , pursuant to section 3003 of Pub. L. 104–66 , as amended, set out as a note under section 1113 of Title 31" ;
  fro-usc:hasNoteTopic "codification" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686/tII" ;
  fro-usc:hasReferenceText "/us/pl/104/66/s3003" ;
  fro-usc:hasReferenceText "/us/stat/54/857" ;
  fro-usc:hasReferenceText "/us/usc/t31/s1113" ;
.
usc-t15-ch2D:idd058f8c6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 22 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8c9-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8ca-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-22> ;
  fro-usc:hasContentText "Any person who willfully violates any provision of this subchapter, or any rule, regulation, or order promulgated by the Commission under authority thereof, shall, upon conviction, be fined not more than $10,000, imprisoned for not more than five years, or both." ;
  fro-usc:hasHeading "Penalties" ;
  fro-usc:hasId "idd058f8c6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–17" ;
  fro-usc:hasNumberText "§ 80b–17." ;
  lkif-mereo:component usc-t15-ch2D:idd058f8c7-0c74-11e6-aa53-e455a13f2ad9 ;
.
