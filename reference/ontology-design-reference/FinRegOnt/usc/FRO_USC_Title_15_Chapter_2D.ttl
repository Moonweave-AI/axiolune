usc-t15-ch2D:idd03c6fb0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-21-3-7-4> ;
  fro-usc:hasContentText "any account for which the investment adviser has borrowing authority, and" ;
  fro-usc:hasId "idd03c6fb0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/19/B/vi/III" ;
