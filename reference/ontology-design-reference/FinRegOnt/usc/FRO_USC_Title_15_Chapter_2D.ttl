.
usc-t15-ch2D:idd04f5b66-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-3-6-3> ;
  fro-usc:hasContentText "a fund that is excluded from the definition of an investment company under section 80a–3(c)(10)(B) of this title ; or" ;
  fro-usc:hasId "idd04f5b66-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/b/4/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/10/B" ;
.
usc-t15-ch2D:idd04f5b67-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-3-6-4> ;
  fro-usc:hasContentText "a trust or other donative instrument described in section 80a–3(c)(10)(B) of this title , or the trustees, administrators, settlors (or potential settlors), or beneficiaries of any such trust or other instrument;" ;
  fro-usc:hasId "idd04f5b67-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/b/4/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/10/B" ;
.
usc-t15-ch2D:idd04f5b68-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-3-7> ;
  fro-usc:hasContentText "any plan described in section 414(e) of title 26 , any person or entity eligible to establish and maintain such a plan under title 26, or any trustee, director, officer, or employee of or volunteer for any such plan or person, if such person or entity, acting in such capacity, provides investment advice exclusively to, or with respect to, any plan, person, or entity or any company, account, or fund that is excluded from the definition of an investment company under section 80a–3(c)(14) of this title ;" ;
  fro-usc:hasId "idd04f5b68-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/b/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/14" ;
  fro-usc:hasReferenceText "/us/usc/t26/s414/e" ;
.
