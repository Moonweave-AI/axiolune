.
usc-t15-ch2D:idd04f5af9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-4-2> ;
  fro-usc:hasContentText "such warrants, options, or rights satisfy the conditions in clauses (i) and (iii) of subparagraph (A); and" ;
  fro-usc:hasId "idd04f5af9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd04f5afa-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-4-3> ;
  fro-usc:hasContentText "the proposal to issue such warrants, options, or rights is authorized by the shareholders or partners of such business development company, and such issuance is approved by the required majority (as defined in section 80a–56( o ) of this title) of the directors of or general partners in such company on the basis that such issuance is in the best interests of the company and its shareholders or partners." ;
  fro-usc:hasId "idd04f5afa-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd04f5afb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-6> ;
  fro-usc:hasContentText "For purposes of measuring the asset coverage requirements of section 80a–18(a) of this title , a senior security created by the guarantee by a business development company of indebtedness issued by another company shall be the amount of the maximum potential liability less the fair market value of the net unencumbered assets (plus the indebtedness which has been guaranteed) available in the borrowing company whose debts have been guaranteed, except that a guarantee issued by a business development company of indebtedness issued by a company which is a wholly-owned subsidiary of the business development company and is licensed as a small business investment company under the Small Business Investment Act of 1958 [ 15 U.S.C. 661 et seq.] shall not be deemed to be a senior security of such business development company for purposes of section 80a–18(a) of this title if the amount of the indebtedness at the time of its issuance by the borrowing company is itself taken fully into account as a liability by such business development company, as if it were issued by such business development company, in determining whether such business development company, at that time, satisfies the asset coverage requirements of section 80a–18(a) of this title ." ;
  fro-usc:hasId "idd04f5afb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s661" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–18/a" ;
.
usc-t15-ch2D:idd04f5afc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-3> ;
  fro-usc:hasContentText "A business development company shall comply with the provisions of this section at the time it becomes subject to sections 80a–54 through 80a–64 of this title, as if it were issuing a security of each class which it has outstanding at such time." ;
  fro-usc:hasHeading "Compliance" ;
  fro-usc:hasId "idd04f5afc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04f5afd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "idd04f5afd-0c74-11e6-aa53-e455a13f2ad9" ;
