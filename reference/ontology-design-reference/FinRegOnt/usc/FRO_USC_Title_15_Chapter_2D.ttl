  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-3> ;
  fro-usc:hasHeading "Investment advisers who need not be registered" ;
  fro-usc:hasId "idd04f5b60-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/b" ;
  fro-usc:hasNumberText "(b)" ;
