  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fc6-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fc7-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fca-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fcb-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fcc-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fcd-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fce-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fd6-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fda-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fde-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fdf-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fe0-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fe8-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fe9-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03c6fea-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2> ;
  fro-usc:hasHeading "Definitions" ;
  fro-usc:hasId "idd039fe82-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-3-2-2> ;
.
usc-t15-ch2D:idd039fe83-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-3> ;
  fro-usc:hasContentText "“Advisory board” means a board, whether elected or appointed, which is distinct from the board of directors or board of trustees, of an investment company, and which is composed solely of persons who do not serve such company in any other capacity, whether or not the functions of such board are such as to render its members “directors” within the definition of that term, which board has advisory functions as to investments but has no power to determine that any security or other investment shall be purchased or sold by such company." ;
  fro-usc:hasId "idd039fe83-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd039fe84-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-4> ;
  fro-usc:hasContentText "“Affiliated company” means a company which is an affiliated person." ;
  fro-usc:hasId "idd039fe84-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd039fe85-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-5> ;
  fro-usc:hasContentText "“Affiliated person” of another person means (A) any person directly or indirectly owning, controlling, or holding with power to vote, 5 per centum or more of the outstanding voting securities of such other person; (B) any person 5 per centum or more of whose outstanding voting securities are directly or indirectly owned, controlled, or held with power to vote, by such other person; (C) any person directly or indirectly controlling, controlled by, or under common control with, such other person; (D) any officer, director, partner, copartner, or employee of such other person; (E) if such other person is an investment company, any investment adviser thereof or any member of an advisory board thereof; and (F) if such other person is an unincorporated investment company not having a board of directors, the depositor thereof." ;
  fro-usc:hasId "idd039fe85-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd039fe86-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-6> ;
  fro-usc:hasContentText "“Assignment” includes any direct or indirect transfer or hypothecation of a contract or chose in action by the assignor, or of a controlling block of the assignor’s outstanding voting securities by a security holder of the assignor; but does not include an assignment of partnership interests incidental to the death or withdrawal of a minority of the members of the partnership having only a minority interest in the partnership business or to the admission to the partnership of one or more members who, after such admission, shall be only a minority of the members and shall have only a minority interest in the business." ;
  fro-usc:hasId "idd039fe86-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd039fe87-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-7> ;
  fro-usc:hasContentText "“Bank” means (A) a depository institution (as defined in section 1813 of title 12 ) or a branch or agency of a foreign bank (as such terms are defined in section 3101 of title 12 ), (B) a member bank of the Federal Reserve System, (C) any other banking institution or trust company, whether incorporated or not, doing business under the laws of any State or of the United States, a substantial portion of the business of which consists of receiving deposits or exercising fiduciary powers similar to those permitted to national banks under the authority of the Comptroller of the Currency, and which is supervised and examined by State or Federal authority having supervision over banks, and which is not operated for the purpose of evading the provisions of this subchapter, and (D) a receiver, conservator, or other liquidating agent of any institution or firm included in clauses (A), (B), or (C) of this paragraph." ;
  fro-usc:hasId "idd039fe87-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813" ;
  fro-usc:hasReferenceText "/us/usc/t12/s3101" ;
.
usc-t15-ch2D:idd039fe88-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-8> ;
  fro-usc:hasContentText "The term “broker” has the same meaning as given in section 3 of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c ], except that such term does not include any person solely by reason of the fact that such person is an underwriter for one or more investment companies." ;
  fro-usc:hasId "idd039fe88-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c" ;
.
usc-t15-ch2D:idd039fe89-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-9> ;
  fro-usc:hasContentText "“Commission” means the Securities and Exchange Commission." ;
  fro-usc:hasId "idd039fe89-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/7" ;
  fro-usc:hasNumberText "(7)" ;
.
usc-t15-ch2D:idd039fe8a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-10> ;
  fro-usc:hasContentText "“Company” means a corporation, a partnership, an association, a joint-stock company, a trust, a fund, or any organized group of persons whether incorporated or not; or any receiver, trustee in a case under title 11 or similar official or any liquidating agent for any of the foregoing, in his capacity as such." ;
  fro-usc:hasId "idd039fe8a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/8" ;
  fro-usc:hasNumberText "(8)" ;
.
usc-t15-ch2D:idd039fe8b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-11> ;
  fro-usc:hasContentText "“Control” means the power to exercise a controlling influence over the management or policies of a company, unless such power is solely the result of an official position with such company." ;
  fro-usc:hasId "idd039fe8b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/9" ;
  fro-usc:hasNumberText "(9)" ;
.
usc-t15-ch2D:idd039fe8c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-12> ;
  fro-usc:hasContentText "“Convicted” includes a verdict, judgment, or plea of guilty, or a finding of guilt on a plea of nolo contendere, if such verdict, judgment, plea, or finding has not been reversed, set aside, or withdrawn, whether or not sentence has been imposed." ;
  fro-usc:hasId "idd039fe8c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/10" ;
  fro-usc:hasNumberText "(10)" ;
.
usc-t15-ch2D:idd039fe8d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-13> ;
  fro-usc:hasContentText "The term “dealer” has the same meaning as given in the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], but does not include an insurance company or investment company." ;
  fro-usc:hasId "idd039fe8d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/11" ;
  fro-usc:hasNumberText "(11)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd039fe8e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-14> ;
  fro-usc:hasContentText "“Director” means any director of a corporation or any person performing similar functions with respect to any organization, whether incorporated or unincorporated, including any natural person who is a member of a board of trustees of a management company created as a common-law trust." ;
  fro-usc:hasId "idd039fe8e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/12" ;
  fro-usc:hasNumberText "(12)" ;
.
usc-t15-ch2D:idd039fe8f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-15> ;
  fro-usc:hasContentText "“Employees’ securities company” means any investment company or similar issuer all of the outstanding securities of which (other than short-term paper) are beneficially owned (A) by the employees or persons on retainer of a single employer or of two or more employers each of which is an affiliated company of the other, (B) by former employees of such employer or employers, (C) by members of the immediate family of such employees, persons on retainer, or former employees, (D) by any two or more of the foregoing classes of persons, or (E) by such employer or employers together with any one or more of the foregoing classes of persons." ;
  fro-usc:hasId "idd039fe8f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/13" ;
  fro-usc:hasNumberText "(13)" ;
.
usc-t15-ch2D:idd039fe90-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-16> ;
  fro-usc:hasContentText "“Exchange” means any organization, association, or group of persons, whether incorporated or unincorporated, which constitutes, maintains, or provides a market place or facilities for bringing together purchasers and sellers of securities or for otherwise performing with respect to securities the functions commonly performed by a stock exchange as that term is generally understood, and includes the market place and the market facilities maintained by such exchange." ;
  fro-usc:hasId "idd039fe90-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/14" ;
  fro-usc:hasNumberText "(14)" ;
.
usc-t15-ch2D:idd039fe91-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-17> ;
  fro-usc:hasContentText "“Face-amount certificate” means any certificate, investment contract, or other security which represents an obligation on the part of its issuer to pay a stated or determinable sum or sums at a fixed or determinable date or dates more than twenty-four months after the date of issuance, in consideration of the payment of periodic installments of a stated or determinable amount (which security shall be known as a face-amount certificate of the “installment type”); or any security which represents a similar obligation on the part of a face-amount certificate company, the consideration for which is the payment of a single lump sum (which security shall be known as a “fully paid” face-amount certificate)." ;
  fro-usc:hasId "idd039fe91-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/15" ;
  fro-usc:hasNumberText "(15)" ;
.
usc-t15-ch2D:idd039fe92-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-18> ;
  fro-usc:hasContentText "“Government security” means any security issued or guaranteed as to principal or interest by the United States, or by a person controlled or supervised by and acting as an instrumentality of the Government of the United States pursuant to authority granted by the Congress of the United States; or any certificate of deposit for any of the foregoing." ;
  fro-usc:hasId "idd039fe92-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/16" ;
  fro-usc:hasNumberText "(16)" ;
.
usc-t15-ch2D:idd039fe93-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 19 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-19> ;
  fro-usc:hasContentText "“Insurance company” means a company which is organized as an insurance company, whose primary and predominant business activity is the writing of insurance or the reinsuring of risks underwritten by insurance companies, and which is subject to supervision by the insurance commissioner or a similar official or agency of a State; or any receiver or similar official or any liquidating agent for such a company, in his capacity as such." ;
  fro-usc:hasId "idd039fe93-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/17" ;
  fro-usc:hasNumberText "(17)" ;
.
usc-t15-ch2D:idd03c6f94-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 20 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-20> ;
  fro-usc:hasContentText "“Interstate commerce” means trade, commerce, transportation, or communication among the several States, or between any foreign country and any State, or between any State and any place or ship outside thereof." ;
  fro-usc:hasId "idd03c6f94-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/18" ;
  fro-usc:hasNumberText "(18)" ;
.
usc-t15-ch2D:idd03c6f95-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 21 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-21> ;
  fro-usc:hasId "idd03c6f95-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/19" ;
  fro-usc:hasNumberText "(19)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-3-2-21-1> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-3-2-21-4> ;
  lkif-mereo:component usc-t15-ch2D:idd03c6f96-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fa4-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c6f96-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-21-2> ;
  fro-usc:hasId "idd03c6f96-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/19/A" ;
