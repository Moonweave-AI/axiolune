  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-2> ;
  fro-usc:hasHeading "Findings" ;
  fro-usc:hasId "idd039fe6e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-2-2-2> ;
.
usc-t15-ch2D:idd039fe6f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-2-3> ;
  fro-usc:hasContentText "the securities issued by such companies, which constitute a substantial part of all securities publicly offered, are distributed, purchased, paid for, exchanged, transferred, redeemed, and repurchased by use of the mails and means and instrumentalities of interstate commerce, and in the case of the numerous companies which issue redeemable securities this process of distribution and redemption is continuous;" ;
  fro-usc:hasId "idd039fe6f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd039fe70-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-2-4> ;
  fro-usc:hasContentText "the principal activities of such companies—investing, reinvesting, and trading in securities—are conducted by use of the mails and means and instrumentalities of interstate commerce, including the facilities of national securities exchanges, and constitute a substantial part of all transactions effected in the securities markets of the Nation;" ;
  fro-usc:hasId "idd039fe70-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd039fe71-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-2-5> ;
  fro-usc:hasContentText "such companies customarily invest and trade in securities issued by, and may dominate and control or otherwise affect the policies and management of, companies engaged in business in interstate commerce;" ;
  fro-usc:hasId "idd039fe71-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd039fe72-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-2-6> ;
  fro-usc:hasContentText "such companies are media for the investment in the national economy of a substantial part of the national savings and may have a vital effect upon the flow of such savings into the capital markets; and" ;
  fro-usc:hasId "idd039fe72-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd039fe73-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-2-7> ;
  fro-usc:hasContentText "the activities of such companies, extending over many States, their use of the instrumentalities of interstate commerce and the wide geographic distribution of their security holders, make difficult, if not impossible, effective State regulation of such companies in the interest of investors." ;
  fro-usc:hasId "idd039fe73-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/a/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd039fe74-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd039fe75-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd039fe76-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd039fe77-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd039fe78-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd039fe79-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd039fe7a-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd039fe7b-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd039fe7c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-3> ;
  fro-usc:hasHeading "Policy" ;
  fro-usc:hasId "idd039fe74-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-2-3-2> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-2-3-11> ;
.
usc-t15-ch2D:idd039fe75-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-3-3> ;
  fro-usc:hasContentText "when investors purchase, pay for, exchange, receive dividends upon, vote, refrain from voting, sell, or surrender securities issued by investment companies without adequate, accurate, and explicit information, fairly presented, concerning the character of such securities and the circumstances, policies, and financial responsibility of such companies and their management;" ;
  fro-usc:hasId "idd039fe75-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd039fe76-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-3-4> ;
  fro-usc:hasContentText "when investment companies are organized, operated, managed, or their portfolio securities are selected, in the interest of directors, officers, investment advisers, depositors, or other affiliated persons thereof, in the interest of underwriters, brokers, or dealers, in the interest of special classes of their security holders, or in the interest of other investment companies or persons engaged in other lines of business, rather than in the interest of all classes of such companies’ security holders;" ;
  fro-usc:hasId "idd039fe76-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd039fe77-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-3-5> ;
  fro-usc:hasContentText "when investment companies issue securities containing inequitable or discriminatory provisions, or fail to protect the preferences and privileges of the holders of their outstanding securities;" ;
  fro-usc:hasId "idd039fe77-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd039fe78-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-3-6> ;
  fro-usc:hasContentText "when the control of investment companies is unduly concentrated through pyramiding or inequitable methods of control, or is inequitably distributed, or when investment companies are managed by irresponsible persons;" ;
  fro-usc:hasId "idd039fe78-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd039fe79-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-3-7> ;
  fro-usc:hasContentText "when investment companies, in keeping their accounts, in maintaining reserves, and in computing their earnings and the asset value of their outstanding securities, employ unsound or misleading methods, or are not subjected to adequate independent scrutiny;" ;
  fro-usc:hasId "idd039fe79-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd039fe7a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-3-8> ;
  fro-usc:hasContentText "when investment companies are reorganized, become inactive, or change the character of their business, or when the control or management thereof is transferred, without the consent of their security holders;" ;
  fro-usc:hasId "idd039fe7a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/b/6" ;
  fro-usc:hasNumberText "(6)" ;
.
usc-t15-ch2D:idd039fe7b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-3-9> ;
  fro-usc:hasContentText "when investment companies by excessive borrowing and the issuance of excessive amounts of senior securities increase unduly the speculative character of their junior securities; or" ;
  fro-usc:hasId "idd039fe7b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/b/7" ;
  fro-usc:hasNumberText "(7)" ;
.
usc-t15-ch2D:idd039fe7c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-3-10> ;
  fro-usc:hasContentText "when investment companies operate without adequate assets or reserves." ;
  fro-usc:hasId "idd039fe7c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–1/b/8" ;
  fro-usc:hasNumberText "(8)" ;
.
usc-t15-ch2D:idd039fe7d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "idd039fe7d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/stat/54/789" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title I, § 1, 54 Stat. 789 .)" ;
.
usc-t15-ch2D:idd039fe7f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd039fe7f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Section 79z–4 of this title , referred to in text, was repealed by Pub. L. 109–58, title XII , § 1263, Aug. 8, 2005 , 119 Stat. 974 ." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/109/58/tXII" ;
  fro-usc:hasReferenceText "/us/stat/119/974" ;
  fro-usc:hasReferenceText "/us/usc/t15/s79z–4" ;
.
usc-t15-ch2D:idd039fe80-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-2-5-1> ;
  fro-usc:hasHeading "Transfer of Functions" ;
  fro-usc:hasId "idd039fe80-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For transfer of functions of Securities and Exchange Commission, with certain exceptions, to Chairman of such Commission, see Reorg. Plan No. 10 of 1950, §§ 1, 2, eff. May 24, 1950 , 15 F.R. 3175, 64 Stat. 1265 , set out under section 78d of this title ." ;
  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
