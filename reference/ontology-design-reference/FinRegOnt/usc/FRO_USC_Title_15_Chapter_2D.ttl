usc-t15-ch2D:idd03c6fb1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-21-3-8> ;
  fro-usc:hasContentText "any natural person whom the Commission by order shall have determined to be an interested person by reason of having had at any time since the beginning of the last two completed fiscal years of such investment company a material business or professional relationship with such investment adviser or principal underwriter or with the principal executive officer or any controlling person of such investment adviser or principal underwriter." ;
  fro-usc:hasId "idd03c6fb1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/19/B/vii" ;
  fro-usc:hasNumberText "(vii)" ;
.
usc-t15-ch2D:idd03c6fb2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 22 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-22> ;
  fro-usc:hasContentText "“Investment adviser” of an investment company means (A) any person (other than a bona fide officer, director, trustee, member of an advisory board, or employee of such company, as such) who pursuant to contract with such company regularly furnishes advice to such company with respect to the desirability of investing in, purchasing or selling securities or other property, or is empowered to determine what securities or other property shall be purchased or sold by such company, and (B) any other person who pursuant to contract with a person described in clause (A) of this paragraph regularly performs substantially all of the duties undertaken by such person described in said clause (A); but does not include (i) a person whose advice is furnished solely through uniform publications distributed to subscribers thereto, (ii) a person who furnishes only statistical and other factual information, advice regarding economic factors and trends, or advice as to occasional transactions in specific securities, but without generally furnishing advice or making recommendations regarding the purchase or sale of securities, (iii) a company furnishing such services at cost to one or more investment companies, insurance companies, or other financial institutions, (iv) any person the character and amount of whose compensation for such services must be approved by a court, or (v) such other persons as the Commission may by rules and regulations or order determine not to be within the intent of this definition." ;
  fro-usc:hasId "idd03c6fb2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/20" ;
  fro-usc:hasNumberText "(20)" ;
.
usc-t15-ch2D:idd03c6fb3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 23 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-23> ;
  fro-usc:hasContentText "“Investment banker” means any person engaged in the business of underwriting securities issued by other persons, but does not include an investment company, any person who acts as an underwriter in isolated transactions but not as a part of a regular business, or any person solely by reason of the fact that such person is an underwriter for one or more investment companies." ;
  fro-usc:hasId "idd03c6fb3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/21" ;
  fro-usc:hasNumberText "(21)" ;
.
usc-t15-ch2D:idd03c6fb4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 24 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-24> ;
  fro-usc:hasContentText "“Issuer” means every person who issues or proposes to issue any security, or has outstanding any security which it has issued." ;
  fro-usc:hasId "idd03c6fb4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/22" ;
  fro-usc:hasNumberText "(22)" ;
.
usc-t15-ch2D:idd03c6fb5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 25 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-25> ;
  fro-usc:hasContentText "“Lend” includes a purchase coupled with an agreement by the vendor to repurchase; “borrow” includes a sale coupled with a similar agreement." ;
  fro-usc:hasId "idd03c6fb5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/23" ;
  fro-usc:hasNumberText "(23)" ;
.
usc-t15-ch2D:idd03c6fb6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 26 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-26> ;
  fro-usc:hasContentText "“Majority-owned subsidiary” of a person means a company 50 per centum or more of the outstanding voting securities of which are owned by such person, or by a company which, within the meaning of this paragraph, is a majority-owned subsidiary of such person." ;
  fro-usc:hasId "idd03c6fb6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/24" ;
  fro-usc:hasNumberText "(24)" ;
.
usc-t15-ch2D:idd03c6fb7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 27 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-27> ;
  fro-usc:hasContentText "“Means or instrumentality of interstate commerce” includes any facility of a national securities exchange." ;
  fro-usc:hasId "idd03c6fb7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/25" ;
  fro-usc:hasNumberText "(25)" ;
.
usc-t15-ch2D:idd03c6fb8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 28 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-28> ;
  fro-usc:hasContentText "“National securities exchange” means an exchange registered under section 6 of the Securities Exchange Act of 1934 [ 15 U.S.C. 78f ]." ;
  fro-usc:hasId "idd03c6fb8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/26" ;
  fro-usc:hasNumberText "(26)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78f" ;
.
usc-t15-ch2D:idd03c6fb9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 29 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-29> ;
  fro-usc:hasContentText "“Periodic payment plan certificate” means (A) any certificate, investment contract, or other security providing for a series of periodic payments by the holder, and representing an undivided interest in certain specified securities or in a unit or fund of securities purchased wholly or partly with the proceeds of such payments, and (B) any security the issuer of which is also issuing securities of the character described in clause (A) of this paragraph and the holder of which has substantially the same rights and privileges as those which holders of securities of the character described in said clause (A) have upon completing the periodic payments for which such securities provide." ;
  fro-usc:hasId "idd03c6fb9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/27" ;
  fro-usc:hasNumberText "(27)" ;
.
usc-t15-ch2D:idd03c6fba-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 30 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-30> ;
  fro-usc:hasContentText "“Person” means a natural person or a company." ;
  fro-usc:hasId "idd03c6fba-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/28" ;
  fro-usc:hasNumberText "(28)" ;
.
usc-t15-ch2D:idd03c6fbb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 31 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-31> ;
  fro-usc:hasContentText "“Principal underwriter” of or for any investment company other than a closed-end company, or of any security issued by such a company, means any underwriter who as principal purchases from such company, or pursuant to contract has the right (whether absolute or conditional) from time to time to purchase from such company, any such security for distribution, or who as agent for such company sells or has the right to sell any such security to a dealer or to the public or both, but does not include a dealer who purchases from such company through a principal underwriter acting as agent for such company. “Principal underwriter” of or for a closed-end company or any issuer which is not an investment company, or of any security issued by such a company or issuer, means any underwriter who, in connection with a primary distribution of securities, (A) is in privity of contract with the issuer or an affiliated person of the issuer; (B) acting alone or in concert with one or more other persons, initiates or directs the formation of an underwriting syndicate; or (C) is allowed a rate of gross commission, spread, or other profit greater than the rate allowed another underwriter participating in the distribution." ;
  fro-usc:hasId "idd03c6fbb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/29" ;
  fro-usc:hasNumberText "(29)" ;
.
usc-t15-ch2D:idd03c6fbc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 32 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-32> ;
  fro-usc:hasContentText "“Promoter” of a company or a proposed company means a person who, acting alone or in concert with other persons, is initiating or directing, or has within one year initiated or directed, the organization of such company." ;
  fro-usc:hasId "idd03c6fbc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/30" ;
  fro-usc:hasNumberText "(30)" ;
.
usc-t15-ch2D:idd03c6fbd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 33 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-33> ;
  fro-usc:hasContentText "“Prospectus”, as used in section 80a–22 of this title , means a written prospectus intended to meet the requirements of section 10(a) of the Securities Act of 1933 [ 15 U.S.C. 77j(a) ] and currently in use. As used elsewhere, “prospectus” means a prospectus as defined in the Securities Act of 1933 [ 15 U.S.C. 77a et seq.]." ;
  fro-usc:hasId "idd03c6fbd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/31" ;
  fro-usc:hasNumberText "(31)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77j/a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–22" ;
.
usc-t15-ch2D:idd03c6fbe-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 34 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-34> ;
  fro-usc:hasContentText "“Redeemable security” means any security, other than short-term paper, under the terms of which the holder, upon its presentation to the issuer or to a person designated by the issuer, is entitled (whether absolutely or only out of surplus) to receive approximately his proportionate share of the issuer’s current net assets, or the cash equivalent thereof." ;
  fro-usc:hasId "idd03c6fbe-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/32" ;
  fro-usc:hasNumberText "(32)" ;
.
usc-t15-ch2D:idd03c6fbf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 35 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-35> ;
  fro-usc:hasContentText "“Reorganization” means (A) a reorganization under the supervision of a court of competent jurisdiction; (B) a merger or consolidation; (C) a sale of 75 per centum or more in value of the assets of a company; (D) a restatement of the capital of a company, or an exchange of securities issued by a company for any of its own outstanding securities; (E) a voluntary dissolution or liquidation of a company; (F) a recapitalization or other procedure or transaction which has for its purpose the alteration, modification, or elimination of any of the rights, preferences, or privileges of any class of securities issued by a company, as provided in its charter or other instrument creating or defining such rights, preferences, and privileges; (G) an exchange of securities issued by a company for outstanding securities issued by another company or companies, preliminary to and for the purpose of effecting or consummating any of the foregoing; or (H) any exchange of securities by a company which is not an investment company for securities issued by a registered investment company." ;
  fro-usc:hasId "idd03c6fbf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/33" ;
  fro-usc:hasNumberText "(33)" ;
.
usc-t15-ch2D:idd03c6fc0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 36 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-36> ;
  fro-usc:hasContentText "“Sale”, “sell”, “offer to sell”, or “offer for sale” includes every contract of sale or disposition of, attempt or offer to dispose of, or solicitation of an offer to buy, a security or interest in a security, for value. Any security given or delivered with, or as a bonus on account of, any purchase of securities or any other thing, shall be conclusively presumed to constitute a part of the subject of such purchase and to have been sold for value." ;
  fro-usc:hasId "idd03c6fc0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/34" ;
  fro-usc:hasNumberText "(34)" ;
.
usc-t15-ch2D:idd03c6fc1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 37 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-37> ;
  fro-usc:hasContentText "“Sales load” means the difference between the price of a security to the public and that portion of the proceeds from its sale which is received and invested or held for investment by the issuer (or in the case of a unit investment trust, by the depositor or trustee), less any portion of such difference deducted for trustee’s or custodian’s fees, insurance premiums, issue taxes, or administrative expenses or fees which are not properly chargeable to sales or promotional activities. In the case of a periodic payment plan certificate, “sales load” includes the sales load on any investment company securities in which the payments made on such certificate are invested, as well as the sales load on the certificate itself." ;
  fro-usc:hasId "idd03c6fc1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/35" ;
  fro-usc:hasNumberText "(35)" ;
.
usc-t15-ch2D:idd03c6fc2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 38 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-38> ;
  fro-usc:hasContentText "“Security” means any note, stock, treasury stock, security future, bond, debenture, evidence of indebtedness, certificate of interest or participation in any profit-sharing agreement, collateral-trust certificate, preorganization certificate or subscription, transferable share, investment contract, voting-trust certificate, certificate of deposit for a security, fractional undivided interest in oil, gas, or other mineral rights, any put, call, straddle, option, or privilege on any security (including a certificate of deposit) or on any group or index of securities (including any interest therein or based on the value thereof), or any put, call, straddle, option, or privilege entered into on a national securities exchange relating to foreign currency, or, in general, any interest or instrument commonly known as a “security”, or any certificate of interest or participation in, temporary or interim certificate for, receipt for, guarantee of, or warrant or right to subscribe to or purchase, any of the foregoing." ;
  fro-usc:hasId "idd03c6fc2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/36" ;
  fro-usc:hasNumberText "(36)" ;
.
usc-t15-ch2D:idd03c6fc3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 39 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-39> ;
  fro-usc:hasContentText "“Separate account” means an account established and maintained by an insurance company pursuant to the laws of any State or territory of the United States, or of Canada or any province thereof, under which income, gains and losses, whether or not realized, from assets allocated to such account, are, in accordance with the applicable contract, credited to or charged against such account without regard to other income, gains, or losses of the insurance company." ;
  fro-usc:hasId "idd03c6fc3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/37" ;
  fro-usc:hasNumberText "(37)" ;
.
usc-t15-ch2D:idd03c6fc4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 40 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-40> ;
  fro-usc:hasContentText "“Short-term paper” means any note, draft, bill of exchange, or banker’s acceptance payable on demand or having a maturity at the time of issuance of not exceeding nine months, exclusive of days of grace, or any renewal thereof payable on demand or having a maturity likewise limited; and such other classes of securities, of a commercial rather than an investment character, as the Commission may designate by rules and regulations." ;
  fro-usc:hasId "idd03c6fc4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/38" ;
  fro-usc:hasNumberText "(38)" ;
.
usc-t15-ch2D:idd03c6fc5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 41 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-41> ;
  fro-usc:hasContentText "“State” means any State of the United States, the District of Columbia, Puerto Rico, the Virgin Islands, or any other possession of the United States." ;
  fro-usc:hasId "idd03c6fc5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/39" ;
  fro-usc:hasNumberText "(39)" ;
.
usc-t15-ch2D:idd03c6fc6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 42 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-42> ;
  fro-usc:hasContentText "“Underwriter” means any person who has purchased from an issuer with a view to, or sells for an issuer in connection with, the distribution of any security, or participates or has a direct or indirect participation in any such undertaking, or participates or has a participation in the direct or indirect underwriting of any such undertaking; but such term shall not include a person whose interest is limited to a commission from an underwriter or dealer not in excess of the usual and customary distributor’s or seller’s commission. As used in this paragraph the term “issuer” shall include, in addition to an issuer, any person directly or indirectly controlling or controlled by the issuer, or any person under direct or indirect common control with the issuer. When the distribution of the securities in respect of which any person is an underwriter is completed such person shall cease to be an underwriter in respect of such securities or the issuer thereof." ;
  fro-usc:hasId "idd03c6fc6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/40" ;
  fro-usc:hasNumberText "(40)" ;
.
usc-t15-ch2D:idd03c6fc7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 43 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-43> ;
  fro-usc:hasId "idd03c6fc7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/41" ;
  fro-usc:hasNumberText "(41)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-3-2-43-1> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-3-2-43-4> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-3-2-43-5> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-3-2-43-6> ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fc8-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fc9-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c6fc8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-43-2> ;
  fro-usc:hasContentText "as used in sections 80a–3, 80a–5, and 80a–12 of this title, (i) with respect to securities owned at the end of the last preceding fiscal quarter for which market quotations are readily available, the market value at the end of such quarter; (ii) with respect to other securities and assets owned at the end of the last preceding fiscal quarter, fair value at the end of such quarter, as determined in good faith by the board of directors; and (iii) with respect to securities and other assets acquired after the end of the last preceding fiscal quarter, the cost thereof; and" ;
  fro-usc:hasId "idd03c6fc8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/41/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd03c6fc9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-43-3> ;
  fro-usc:hasContentText "as used elsewhere in this subchapter, (i) with respect to securities for which market quotations are readily available, the market value of such securities; and (ii) with respect to other securities and assets, fair value as determined in good faith by the board of directors;" ;
  fro-usc:hasId "idd03c6fc9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/41/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd03c6fca-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 44 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-44> ;
  fro-usc:hasContentText "“Voting security” means any security presently entitling the owner or holder thereof to vote for the election of directors of a company. A specified percentage of the outstanding voting securities of a company means such amount of its outstanding voting securities as entitles the holder or holders thereof to cast said specified percentage of the aggregate votes which the holders of all the outstanding voting securities of such company are entitled to cast. The vote of a majority of the outstanding voting securities of a company means the vote, at the annual or a special meeting of the security holders of such company duly called, (A) of 67 per centum or more of the voting securities present at such meeting, if the holders of more than 50 per centum of the outstanding voting securities of such company are present or represented by proxy; or (B) of more than 50 per centum of the outstanding voting securities of such company, whichever is the less." ;
  fro-usc:hasId "idd03c6fca-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/42" ;
  fro-usc:hasNumberText "(42)" ;
.
usc-t15-ch2D:idd03c6fcb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 45 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-45> ;
  fro-usc:hasContentText "“Wholly-owned subsidiary” of a person means a company 95 per centum or more of the outstanding voting securities of which are owned by such person, or by a company which, within the meaning of this paragraph, is a wholly-owned subsidiary of such person." ;
  fro-usc:hasId "idd03c6fcb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/43" ;
  fro-usc:hasNumberText "(43)" ;
.
usc-t15-ch2D:idd03c6fcc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 46 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-46> ;
  fro-usc:hasContentText "“Securities Act of 1933” [ 15 U.S.C. 77a et seq.], “Securities Exchange Act of 1934” [ 15 U.S.C. 78a et seq.], and “Trust Indenture Act of 1939” [ 15 U.S.C. 77aaa et seq.] mean those acts, respectively, as heretofore or hereafter amended." ;
  fro-usc:hasId "idd03c6fcc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/44" ;
  fro-usc:hasNumberText "(44)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77aaa" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd03c6fcd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 47 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-47> ;
  fro-usc:hasContentText "“Savings and loan association” means a savings and loan association, building and loan association, cooperative bank, homestead association, or similar institution, which is supervised and examined by State or Federal authority having supervision over any such institution, and a receiver, conservator, or other liquidating agent of any such institution." ;
  fro-usc:hasId "idd03c6fcd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/45" ;
  fro-usc:hasNumberText "(45)" ;
.
usc-t15-ch2D:idd03c6fce-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 48 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-48> ;
  fro-usc:hasId "idd03c6fce-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/46" ;
  fro-usc:hasNumberText "(46)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-3-2-48-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fcf-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fd0-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fd1-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c6fcf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-48-2> ;
  fro-usc:hasContentText "is organized under the laws of, and has its principal place of business in, any State or States;" ;
  fro-usc:hasId "idd03c6fcf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/46/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd03c6fd0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-48-3> ;
  fro-usc:hasContentText "is neither an investment company as defined in section 80a–3 of this title (other than a small business investment company which is licensed by the Small Business Administration to operate under the Small Business Investment Act of 1958 [ 15 U.S.C. 661 et seq.] and which is a wholly-owned subsidiary of the business development company) nor a company which would be an investment company except for the exclusion from the definition of investment company in section 80a–3(c) of this title ; and" ;
  fro-usc:hasId "idd03c6fd0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/46/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s661" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c" ;
.
usc-t15-ch2D:idd03c6fd1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-48-4> ;
  fro-usc:hasId "idd03c6fd1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/46/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-3-2-48-4-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fd2-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fd3-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fd4-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fd5-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c6fd2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-48-4-2> ;
  fro-usc:hasContentText "it does not have any class of securities with respect to which a member of a national securities exchange, broker, or dealer may extend or maintain credit to or for a customer pursuant to rules or regulations adopted by the Board of Governors of the Federal Reserve System under section 7 of the Securities Exchange Act of 1934 [ 15 U.S.C. 78g ];" ;
  fro-usc:hasId "idd03c6fd2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/46/C/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78g" ;
.
usc-t15-ch2D:idd03c6fd3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-48-4-3> ;
  fro-usc:hasContentText "it is controlled by a business development company, either alone or as part of a group acting together, and such business development company in fact exercises a controlling influence over the management or policies of such eligible portfolio company and, as a result of such control, has an affiliated person who is a director of such eligible portfolio company;" ;
  fro-usc:hasId "idd03c6fd3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/46/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd03c6fd4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-48-4-4> ;
  fro-usc:hasContentText "it has total assets of not more than $4,000,000, and capital and surplus (shareholders’ equity less retained earnings) of not less than $2,000,000, except that the Commission may adjust such amounts by rule, regulation, or order to reflect changes in 1 or more generally accepted indices or other indicators for small businesses; or" ;
  fro-usc:hasId "idd03c6fd4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/46/C/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
usc-t15-ch2D:idd03c6fd5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-48-4-5> ;
  fro-usc:hasContentText "it meets such other criteria as the Commission may, by rule, establish as consistent with the public interest, the protection of investors, and the purposes fairly intended by the policy and provisions of this subchapter." ;
  fro-usc:hasId "idd03c6fd5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/46/C/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
usc-t15-ch2D:idd03c6fd6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 49 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-49> ;
  fro-usc:hasId "idd03c6fd6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/47" ;
  fro-usc:hasNumberText "(47)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-3-2-49-1> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-3-2-49-5> ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fd7-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fd8-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fd9-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c6fd7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-49-2> ;
  fro-usc:hasContentText "any arrangement whereby a business development company, through its directors, officers, employees, or general partners, offers to provide, and, if accepted, does so provide, significant guidance and counsel concerning the management, operations, or business objectives and policies of a portfolio company;" ;
  fro-usc:hasId "idd03c6fd7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/47/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd03c6fd8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-49-3> ;
  fro-usc:hasContentText "the exercise by a business development company of a controlling influence over the management or policies of a portfolio company by the business development company acting individually or as part of a group acting together which controls such portfolio company; or" ;
  fro-usc:hasId "idd03c6fd8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/47/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd03c6fd9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-49-4> ;
  fro-usc:hasContentText "with respect to a small business investment company licensed by the Small Business Administration to operate under the Small Business Investment Act of 1958 [ 15 U.S.C. 661 et seq.], the making of loans to a portfolio company." ;
  fro-usc:hasId "idd03c6fd9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/47/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s661" ;
.
usc-t15-ch2D:idd03c6fda-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 50 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-50> ;
  fro-usc:hasId "idd03c6fda-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/48" ;
  fro-usc:hasNumberText "(48)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-3-2-50-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fdb-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fdc-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fdd-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c6fdb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-50-2> ;
  fro-usc:hasContentText "is organized under the laws of, and has its principal place of business in, any State or States;" ;
  fro-usc:hasId "idd03c6fdb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/48/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd03c6fdc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-50-3> ;
  fro-usc:hasContentText "is operated for the purpose of making investments in securities described in paragraphs (1) through (3) of section 80a–54(a) of this title , and makes available significant managerial assistance with respect to the issuers of such securities, provided that a business development company must make available significant managerial assistance only with respect to the companies which are treated by such business development company as satisfying the 70 per centum of the value of its total assets condition of section 80a–54 of this title ; and provided further that a business development company need not make available significant managerial assistance with respect to any company described in paragraph (46)(C)(iii), or with respect to any other company that meets such criteria as the Commission may by rule, regulation, or order permit, as consistent with the public interest, the protection of investors, and the purposes of this subchapter; and" ;
  fro-usc:hasId "idd03c6fdc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/48/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–54" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–54/a" ;
.
usc-t15-ch2D:idd03c6fdd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-50-4> ;
  fro-usc:hasContentText "has elected pursuant to section 80a–53(a) of this title to be subject to the provisions of sections 80a–54 through 80a–64 of this title." ;
  fro-usc:hasId "idd03c6fdd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/48/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–53/a" ;
.
usc-t15-ch2D:idd03c6fde-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 51 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-51> ;
  fro-usc:hasContentText "“Foreign securities authority” means any foreign government or any governmental body or regulatory organization empowered by a foreign government to administer or enforce its laws as they relate to securities matters." ;
  fro-usc:hasId "idd03c6fde-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/49" ;
  fro-usc:hasNumberText "(49)" ;
.
usc-t15-ch2D:idd03c6fdf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 52 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-52> ;
  fro-usc:hasContentText "“Foreign financial regulatory authority” means any (A) foreign securities authority, (B) other governmental body or foreign equivalent of a self-regulatory organization empowered by a foreign government to administer or enforce its laws relating to the regulation of fiduciaries, trusts, commercial lending, insurance, trading in contracts of sale of a commodity for future delivery, or other instruments traded on or subject to the rules of a contract market, board of trade or foreign equivalent, or other financial activities, or (C) membership organization a function of which is to regulate the participation of its members in activities listed above." ;
  fro-usc:hasId "idd03c6fdf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/50" ;
  fro-usc:hasNumberText "(50)" ;
.
usc-t15-ch2D:idd03c6fe0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 53 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-53> ;
  fro-usc:hasId "idd03c6fe0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/51" ;
  fro-usc:hasNumberText "(51)" ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fe1-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fe6-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fe7-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c6fe1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-53-1> ;
  fro-usc:hasId "idd03c6fe1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/51/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-3-2-53-1-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fe2-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fe3-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fe4-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fe5-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c6fe2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-53-1-2> ;
  fro-usc:hasContentText "any natural person (including any person who holds a joint, community property, or other similar shared ownership interest in an issuer that is excepted under section 80a–3(c)(7) of this title with that person’s qualified purchaser spouse) who owns not less than $5,000,000 in investments, as defined by the Commission;" ;
  fro-usc:hasId "idd03c6fe2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/51/A/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/7" ;
.
usc-t15-ch2D:idd03c6fe3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-53-1-3> ;
  fro-usc:hasContentText "any company that owns not less than $5,000,000 in investments and that is owned directly or indirectly by or for 2 or more natural persons who are related as siblings or spouse (including former spouses), or direct lineal descendants by birth or adoption, spouses of such persons, the estates of such persons, or foundations, charitable organizations, or trusts established by or for the benefit of such persons;" ;
  fro-usc:hasId "idd03c6fe3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/51/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd03c6fe4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-53-1-4> ;
  fro-usc:hasContentText "any trust that is not covered by clause (ii) and that was not formed for the specific purpose of acquiring the securities offered, as to which the trustee or other person authorized to make decisions with respect to the trust, and each settlor or other person who has contributed assets to the trust, is a person described in clause (i), (ii), or (iv); or" ;
  fro-usc:hasId "idd03c6fe4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/51/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
usc-t15-ch2D:idd03c6fe5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-53-1-5> ;
  fro-usc:hasContentText "any person, acting for its own account or the accounts of other qualified purchasers, who in the aggregate owns and invests on a discretionary basis, not less than $25,000,000 in investments." ;
  fro-usc:hasId "idd03c6fe5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/51/A/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
usc-t15-ch2D:idd03c6fe6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-53-2> ;
  fro-usc:hasContentText "The Commission may adopt such rules and regulations applicable to the persons and trusts specified in clauses (i) through (iv) of subparagraph (A) as it determines are necessary or appropriate in the public interest or for the protection of investors." ;
  fro-usc:hasId "idd03c6fe6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/51/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd03c6fe7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-53-3> ;
  fro-usc:hasContentText "The term “qualified purchaser” does not include a company that, but for the exceptions provided for in paragraph (1) or (7) of section 80a–3(c) of this title , would be an investment company (hereafter in this paragraph referred to as an “excepted investment company”), unless all beneficial owners of its outstanding securities (other than short-term paper), determined in accordance with section 80a–3(c)(1)(A) of this title , that acquired such securities on or before April 30, 1996 (hereafter in this paragraph referred to as “pre-amendment beneficial owners”), and all pre-amendment beneficial owners of the outstanding securities (other than short-term paper) of any excepted investment company that, directly or indirectly, owns any outstanding securities of such excepted investment company, have consented to its treatment as a qualified purchaser. Unanimous consent of all trustees, directors, or general partners of a company or trust referred to in clause (ii) or (iii) of subparagraph (A) shall constitute consent for purposes of this subparagraph." ;
  fro-usc:hasId "idd03c6fe7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/51/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/1/A" ;
.
usc-t15-ch2D:idd03c6fe8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 54 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-54> ;
  fro-usc:hasContentText "The terms “security future” and “narrow-based security index” have the same meanings as provided in section 3(a)(55) of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c(a)(55) ]." ;
  fro-usc:hasId "idd03c6fe8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/52" ;
  fro-usc:hasNumberText "(52)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c/a/55" ;
.
usc-t15-ch2D:idd03c6fe9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 55 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-55> ;
  fro-usc:hasContentText "The term “credit rating agency” has the same meaning as in section 3 of the Securities Exchange Act of 1934 [ 15 U.S.C. 78c ]." ;
  fro-usc:hasId "idd03c6fe9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/53" ;
  fro-usc:hasNumberText "(53)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c" ;
.
usc-t15-ch2D:idd03c6fea-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 56 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-56> ;
  fro-usc:hasContentText "The terms “commodity pool”, “commodity pool operator”, “commodity trading advisor”, “major swap participant”, “swap”, “swap dealer”, and “swap execution facility” have the same meanings as in section 1a of title 7 ." ;
  fro-usc:hasId "idd03c6fea-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/54" ;
  fro-usc:hasNumberText "(54)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1a" ;
.
usc-t15-ch2D:idd03c6feb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-3> ;
  fro-usc:hasContentText "No provision in this subchapter shall apply to, or be deemed to include, the United States, a State, or any political subdivision of a State, or any agency, authority, or instrumentality of any one or more of the foregoing, or any corporation which is wholly owned directly or indirectly by any one or more of the foregoing, or any officer, agent, or employee of any of the foregoing acting as such in the course of his official duty, unless such provision makes specific reference thereto." ;
  fro-usc:hasHeading "Applicability to government" ;
  fro-usc:hasId "idd03c6feb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd03c6fec-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-4> ;
  fro-usc:hasContentText "Whenever pursuant to this subchapter the Commission is engaged in rulemaking and is required to consider or determine whether an action is consistent with the public interest, the Commission shall also consider, in addition to the protection of investors, whether the action will promote efficiency, competition, and capital formation." ;
  fro-usc:hasHeading "Consideration of promotion of efficiency, competition, and capital formation" ;
  fro-usc:hasId "idd03c6fec-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/c" ;
  fro-usc:hasNumberText "(c)" ;
.
