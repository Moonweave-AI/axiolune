  fro-usc:hasContentText "is registered or licensed as such in the State in which it maintains its principal office and place of business; and" ;
  fro-usc:hasId "idd058f8d6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–18a/b/1" ;
