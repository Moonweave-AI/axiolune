usc-t15-ch2D:idd058f8b4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-19-3-3> ;
  fro-usc:hasContentText "conduct within the United States that constitutes significant steps in furtherance of the violation, even if the violation is committed by a foreign adviser and involves only foreign investors; or" ;
  fro-usc:hasId "idd058f8b4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–14/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd058f8b5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-19-3-4> ;
  fro-usc:hasContentText "conduct occurring outside the United States that has a foreseeable substantial effect within the United States." ;
  fro-usc:hasId "idd058f8b5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–14/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
