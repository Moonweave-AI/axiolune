  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0485641-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-27> ;
  fro-usc:hasHeading "Reorganization plans; reports by Commission" ;
  fro-usc:hasId "idd045e637-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–25" ;
  fro-usc:hasNumberText "§ 80a–25." ;
  lkif-mereo:component usc-t15-ch2D:idd048563c-0c74-11e6-aa53-e455a13f2ad9 ;
