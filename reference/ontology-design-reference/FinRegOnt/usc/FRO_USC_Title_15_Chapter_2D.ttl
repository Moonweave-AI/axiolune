  fro-usc:hasReferenceText "/us/pl/95/598/tIII" ;
  fro-usc:hasReferenceText "/us/stat/54/826" ;
  fro-usc:hasReferenceText "/us/stat/84/1424" ;
  fro-usc:hasReferenceText "/us/stat/92/2676" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 ; Pub. L. 95–598, title III , § 310(c), Nov. 6, 1978 , 92 Stat. 2676 .) , title I, § 25, 54 Stat. 826 ; Pub. L. 91–547 , § 14, Dec. 14, 1970 , 84 Stat. 1424" ;
.
usc-t15-ch2D:idd048563e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-27-7-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd048563e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1970—Subsec. (c). Pub. L. 91–547 substituted “that any such plan is not fair and equitable to all security holders” for “any such plan to be grossly unfair or to constitute gross misconduct or gross abuse of trust on the part of the officers, directors, or investment advisers of such registered company or other sponsors of such plan”." ;
  fro-usc:hasNoteText "1978—Subsec. (d). Pub. L. 95–598 substituted “title 11” for “the Bankruptcy Act of 1898, as amended”." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
  fro-usc:hasReferenceText "/us/pl/95/598" ;
.
