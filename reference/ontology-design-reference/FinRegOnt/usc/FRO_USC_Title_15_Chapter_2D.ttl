usc-t15-ch2D:idd04aa0b4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0b5-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0b6-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-2> ;
  fro-usc:hasHeading "Maintenance of records" ;
  fro-usc:hasId "idd04aa0b4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd04aa0b5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-2-2> ;
  fro-usc:hasContentText "Each registered investment company, and each underwriter, broker, dealer, or investment adviser that is a majority-owned subsidiary of such a company, shall maintain and preserve such records (as defined in section 78c(a)(37) of this title ) for such period or periods as the Commission, by rules and regulations, may prescribe as necessary or appropriate in the public interest or for the protection of investors. Each investment adviser that is not a majority-owned subsidiary of, and each depositor of any registered investment company, and each principal underwriter for any registered investment company other than a closed-end company, shall maintain and preserve for such period or periods as the Commission shall prescribe by rules and regulations, such records as are necessary or appropriate to record such person’s transactions with such registered company. Each person having custody or use of the securities, deposits, or credits of a registered investment company shall maintain and preserve all records that relate to the custody or use by such person of the securities, deposits, or credits of the registered investment company for such period or periods as the Commission, by rule or regulation, may prescribe, as necessary or appropriate in the public interest or for the protection of investors." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd04aa0b5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78c/a/37" ;
.
usc-t15-ch2D:idd04aa0b6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-2-3> ;
  fro-usc:hasHeading "Minimizing compliance burden" ;
  fro-usc:hasId "idd04aa0b6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-32-2-3-2> ;
  lkif-mereo:component usc-t15-ch2D:idd04aa0b7-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa0b8-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa0b9-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa0ba-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa0b7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-2-3-3> ;
  fro-usc:hasContentText "feasible alternatives that minimize the recordkeeping burdens on subject persons;" ;
  fro-usc:hasId "idd04aa0b7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04aa0b8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-2-3-4> ;
  fro-usc:hasContentText "the necessity of such records in view of the public benefits derived from the independent scrutiny of such records through Commission examination;" ;
  fro-usc:hasId "idd04aa0b8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04aa0b9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-2-3-5> ;
  fro-usc:hasContentText "the costs associated with maintaining the information that would be required to be reflected in such records; and" ;
  fro-usc:hasId "idd04aa0b9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/a/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd04aa0ba-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-2-3-6> ;
  fro-usc:hasContentText "the effects that a proposed recordkeeping requirement would have on internal compliance policies and procedures." ;
  fro-usc:hasId "idd04aa0ba-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/a/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
usc-t15-ch2D:idd04aa0bb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0bc-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0bd-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0be-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0bf-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-3> ;
  fro-usc:hasHeading "Examinations of records" ;
  fro-usc:hasId "idd04aa0bb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04aa0bc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-3-2> ;
  fro-usc:hasContentText "All records required to be maintained and preserved in accordance with subsection (a) shall be subject at any time and from time to time to such reasonable periodic, special, and other examinations by the Commission, or any member or representative thereof, as the Commission may prescribe." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd04aa0bc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04aa0bd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-3-3> ;
  fro-usc:hasContentText "For purposes of examinations referred to in paragraph (1), any subject person shall make available to the Commission or its representatives any copies or extracts from such records as may be prepared without undue effort, expense, or delay as the Commission or its representatives may reasonably request." ;
  fro-usc:hasHeading "Availability" ;
  fro-usc:hasId "idd04aa0bd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04aa0be-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-3-4> ;
  fro-usc:hasContentText "The Commission shall exercise its authority under this subsection with due regard for the benefits of internal compliance policies and procedures and the effective implementation and operation thereof." ;
  fro-usc:hasHeading "Commission action" ;
  fro-usc:hasId "idd04aa0be-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd04aa0bf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-3-5> ;
  fro-usc:hasHeading "Records of persons with custody or use" ;
  fro-usc:hasId "idd04aa0bf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/b/4" ;
  fro-usc:hasNumberText "(4)" ;
  lkif-mereo:component usc-t15-ch2D:idd04aa0c0-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa0c1-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa0c0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-3-5-2> ;
  fro-usc:hasContentText "Records of persons having custody or use of the securities, deposits, or credits of a registered investment company that relate to such custody or use, are subject at any time, or from time to time, to such reasonable periodic, special, or other examinations and other information and document requests by representatives of the Commission, as the Commission deems necessary or appropriate in the public interest or for the protection of investors." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd04aa0c0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/b/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04aa0c1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-3-5-3> ;
  fro-usc:hasContentText "Any person that is subject to regulation and examination by a Federal financial institution regulatory agency (as such term is defined under section 212(c)(2) of title 18 ) may satisfy any examination request, information request, or document request described under subparagraph (A), by providing to the Commission a detailed listing, in writing, of the securities, deposits, or credits of the registered investment company within the custody or use of such person." ;
  fro-usc:hasHeading "Certain persons subject to other regulation" ;
  fro-usc:hasId "idd04aa0c1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/b/4/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t18/s212/c/2" ;
.
usc-t15-ch2D:idd04aa0c2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-4> ;
  fro-usc:hasContentText "The Commission may, in the public interest or for the protection of investors, issue rules and regulations providing for a reasonable degree of uniformity in the accounting policies and principles to be followed by registered investment companies in maintaining their accounting records and in preparing financial statements required pursuant to this subchapter." ;
  fro-usc:hasHeading "Regulatory authority" ;
  fro-usc:hasId "idd04aa0c2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd04aa0c3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-5> ;
  fro-usc:hasContentText "The Commission, upon application made by any registered investment company, may by order exempt a specific transaction or transactions from the provisions of any rule or regulation made pursuant to subsection (e), if the Commission finds that such rule or regulation should not reasonably be applied to such transaction." ;
  fro-usc:hasHeading "Exemption authority" ;
  fro-usc:hasId "idd04aa0c3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–30/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd04aa0c4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "idd04aa0c4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/104/290/tII" ;
  fro-usc:hasReferenceText "/us/pl/105/353/tIII" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIX" ;
  fro-usc:hasReferenceText "/us/pl/111/257" ;
  fro-usc:hasReferenceText "/us/stat/110/3430" ;
  fro-usc:hasReferenceText "/us/stat/112/3237" ;
  fro-usc:hasReferenceText "/us/stat/124/1858" ;
  fro-usc:hasReferenceText "/us/stat/124/2646" ;
  fro-usc:hasReferenceText "/us/stat/54/838" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 ; Pub. L. 105–353, title III , § 301(c)(6), Nov. 3, 1998 , 112 Stat. 3237 ; Pub. L. 111–203, title IX , §§ 929I(b), 929Q(a), July 21, 2010 , 124 Stat. 1858 , 1865; Pub. L. 111–257 , § 1(b), Oct. 5, 2010 , 124 Stat. 2646 .) , title I, § 31, 54 Stat. 838 ; Pub. L. 104–290, title II , § 207, Oct. 11, 1996 , 110 Stat. 3430" ;
.
usc-t15-ch2D:idd04aa0c6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-32-7-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04aa0c6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1996—Subsecs. (a), (b). Pub. L. 104–290 , § 207(1), added subsecs. (a) and (b) and struck out former subsecs. (a) and (b) which read as follows:" ;
  fro-usc:hasNoteText "1998—Subsec. (f). Pub. L. 105–353 substituted “subsection (e)” for “subsection (c)”." ;
  fro-usc:hasNoteText "2010—Subsec. (a)(1). Pub. L. 111–203 , § 929Q(a)(1), inserted at end “Each person having custody or use of the securities, deposits, or credits of a registered investment company shall maintain and preserve all records that relate to the custody or use by such person of the securities, deposits, or credits of the registered investment company for such period or periods as the Commission, by rule or regulation, may prescribe, as necessary or appropriate in the public interest or for the protection of investors.”" ;
  fro-usc:hasNoteText "Pub. L. 111–203 , § 929I(b)(1), added subsec. (c) and struck out former subsec. (c). Prior to amendment, text read as follows: “Notwithstanding any other provision of law, the Commission shall not be compelled to disclose any internal compliance or audit records, or information contained therein, provided to the Commission under this section. Nothing in this subsection shall authorize the Commission to withhold information from the Congress or prevent the Commission from complying with a request for information from any other Federal department or agency requesting the information for purposes within the scope of the jurisdiction of that department or agency, or complying with an order of a court of the United States in an action brought by the United States or the Commission. For purposes of section 552 of title 5 , this section shall be considered a statute described in subsection (b)(3)(B) of such section 552.”" ;
  fro-usc:hasNoteText "Pub. L. 111–203 , § 929I(b)(2), (3), redesignated subsec. (e) as (d) and struck out former subsec. (d) which defined “internal compliance policies and procedures” and “internal compliance and audit record” for purposes of this section." ;
  fro-usc:hasNoteText "Pub. L. 111–203 , § 929I(b)(3), redesignated subsec. (f) as (e). Former subsec. (e) redesignated (d)." ;
  fro-usc:hasNoteText "Subsec. (b)(4). Pub. L. 111–203 , § 929Q(a)(2), added par. (4)." ;
  fro-usc:hasNoteText "Subsec. (c). Pub. L. 111–257 redesignated subsec. (d) as (c) and struck out former subsec. (c). Prior to amendment, text of subsec. (c) read as follows: “Notwithstanding any other provision of law, the Commission shall not be compelled to disclose any records or information provided to the Commission under this section, or records or information based upon or derived from such records or information, if such records or information have been obtained by the Commission for use in furtherance of the purposes of this subchapter, including surveillance, risk assessments, or other regulatory and oversight activities. Nothing in this subsection authorizes the Commission to withhold information from the Congress or prevent the Commission from complying with a request for information from any other Federal department or agency requesting the information for purposes within the scope of jurisdiction of that department or agency, or complying with an order of a court of the United States in an action brought by the United States or the Commission. For purposes of section 552 of title 5 , this section shall be considered a statute described in subsection (b)(3)(B) of such section 552. Collection of information pursuant to this section shall be an administrative action involving an agency against specific individuals or agencies pursuant to section 3518(c)(1) of title 44 .”" ;
  fro-usc:hasNoteText "Subsec. (d). Pub. L. 111–257 , § 1(b)(2), redesignated subsec. (e) as (d). Former subsec. (d) redesignated (c)." ;
  fro-usc:hasNoteText "Subsec. (e). Pub. L. 104–290 , § 207(2), (4), redesignated subsec. (c) as (e) and inserted heading." ;
  fro-usc:hasNoteText "Subsec. (e). Pub. L. 111–257 , § 1(b)(2), redesignated subsec. (e) as (d)." ;
  fro-usc:hasNoteText "Subsec. (f). Pub. L. 104–290 , § 207(2), (5), redesignated subsec. (d) as (f) and inserted heading." ;
  fro-usc:hasNoteText "Subsec. (f). Pub. L. 111–203 , § 929I(b)(3), redesignated subsec. (f) as (e)." ;
  fro-usc:hasNoteText "Subsecs. (c), (d). Pub. L. 104–290 , § 207(3), added subsecs. (c) and (d). Former subsecs. (c) and (d) redesignated (e) and (f), respectively." ;
  fro-usc:hasNoteText "“(a) Every registered investment company, and every underwriter, broker, dealer, or investment adviser which is a majority-owned subsidiary of such a company, shall maintain and preserve for such period or periods as the Commission may prescribe by rules and regulations, such accounts, books, and other documents as constitute the record forming the basis for financial statements required to be filed pursuant to section 80a–29 of this title , and of the auditor’s certificates relating thereto. Every investment adviser not a majority-owned subsidiary of, and every depositor of any registered investment company, and every principal underwriter for any registered investment company other than a closed-end company, shall maintain and preserve for such period or periods as the Commission shall prescribe by rules and regulations, such accounts, books, and other documents as are necessary or appropriate to record such person’s transactions with such registered company." ;
  fro-usc:hasNoteText "“(b) All accounts, books, and other records, required to be maintained and preserved by any person pursuant to subsection (a) of this section, shall be subject at any time and from time to time to such reasonable periodic, special, and other examinations by the Commission, or any member or representative thereof, as the Commission may prescribe. Any such person shall furnish to the Commission, within such reasonable time as the Commission may prescribe, copies of or extracts from such rec­ords which may be prepared without undue effort, expense, or delay, as the Commission may by order require.”" ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/104/290" ;
  fro-usc:hasReferenceText "/us/pl/105/353" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/257" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–29" ;
  fro-usc:hasReferenceText "/us/usc/t44/s3518/c/1" ;
  fro-usc:hasReferenceText "/us/usc/t5/s552" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd04856a3-0c74-11e6-aa53-e455a13f2ad9 ;
.
