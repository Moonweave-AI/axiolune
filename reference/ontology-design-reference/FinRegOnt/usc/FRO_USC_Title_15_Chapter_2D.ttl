usc-t15-ch2D:idd04d119e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-2-3-3-2-2> ;
  fro-usc:hasContentText "the greatest number of equity securities of such issuer and securities convertible into or exchangeable for such securities; and" ;
  fro-usc:hasId "idd04d119e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–54/a/1/B/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
usc-t15-ch2D:idd04d119f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-2-3-3-2-3> ;
  fro-usc:hasContentText "the greatest amount of debt securities of such issuer," ;
  fro-usc:hasId "idd04d119f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–54/a/1/B/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
usc-t15-ch2D:idd04d11a0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-2-3-3-4> ;
  fro-usc:hasContentText "the business development company is one of the 20 largest holders of record of such issuer’s outstanding voting securities;" ;
  fro-usc:hasId "idd04d11a0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–54/a/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
