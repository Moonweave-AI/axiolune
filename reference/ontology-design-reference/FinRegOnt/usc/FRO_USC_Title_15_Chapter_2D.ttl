  fro-usc:hasContentText "to withhold information from Congress, upon an agreement of confidentiality; or" ;
  fro-usc:hasId "idd05686fc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/8/A" ;
