  fro-usc:hasSourceCreditText "( Pub. L. 104–62 , § 6, Dec. 8, 1995 , 109 Stat. 685 .)" ;
.
usc-t15-ch2D:idd03eb955-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-7-0> ;
  fro-usc:hasHeading "Codification" ;
  fro-usc:hasId "idd03eb955-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Section was enacted as part of the Philanthropy Protection Act of 1995, and not as part of the Investment Company Act of 1940 which comprises this subchapter." ;
  fro-usc:hasNoteTopic "codification" ;
.
usc-t15-ch2D:idd03eb956-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-7-1> ;
  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "idd03eb956-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Section applicable as defense to any claim in administrative and judicial actions pending on or commenced after Dec. 8, 1995 , that any person, security, interest, or participation of type described in Pub. L. 104–62 is subject to the Securities Act of 1933, the Securities Exchange Act of 1934, the Investment Company Act of 1940, the Investment Advisers Act of 1940, or any State statute or regulation preempted as provided in this section, except as specifically provided in such statutes, see section 7 of Pub. L. 104–62 , set out as an Effective Date of 1995 Amendment note under section 77c of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/104/62" ;
  fro-usc:hasReferenceText "/us/pl/104/62/s7" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77c" ;
.
usc-t15-ch2D:idd03eb957-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb958-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb959-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb95a-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd03eb95d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-6> ;
  fro-usc:hasHeading "Classification of investment companies" ;
  fro-usc:hasId "idd03eb957-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–4" ;
  fro-usc:hasNumberText "§ 80a–4." ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-6-2> ;
  lkif-mereo:component usc-t15-ch2D:idd03eb95b-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03eb958-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-6-3> ;
  fro-usc:hasContentText "“Face-amount certificate company” means an investment company which is engaged or proposes to engage in the business of issuing face-amount certificates of the installment type, or which has been engaged in such business and has any such certificate outstanding." ;
  fro-usc:hasId "idd03eb958-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–4/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd03eb959-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-6-4> ;
  fro-usc:hasContentText "“Unit investment trust” means an investment company which (A) is organized under a trust indenture, contract of custodianship or agency, or similar instrument, (B) does not have a board of directors, and (C) issues only redeemable securities, each of which represents an undivided interest in a unit of specified securities; but does not include a voting trust." ;
  fro-usc:hasId "idd03eb959-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–4/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd03eb95a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-6-5> ;
  fro-usc:hasContentText "“Management company” means any investment company other than a face-amount certificate company or a unit investment trust." ;
  fro-usc:hasId "idd03eb95a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–4/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd03eb95b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "idd03eb95b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/stat/54/799" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title I, § 4, 54 Stat. 799 .)" ;
.
usc-t15-ch2D:idd03eb95d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-6-7-0> ;
  fro-usc:hasHeading "Transfer of Functions" ;
  fro-usc:hasId "idd03eb95d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For transfer of functions of Securities and Exchange Commission, with certain exceptions, to Chairman of such Commission, see Reorg. Plan No. 10 of 1950, §§ 1, 2, eff. May 24, 1950 , 15 F.R. 3175, 64 Stat. 1265 , set out under section 78d of this title ." ;
  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
usc-t15-ch2D:idd03eb95e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
