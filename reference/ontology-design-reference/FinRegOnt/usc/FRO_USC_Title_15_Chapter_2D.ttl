  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-4-16-9-5> ;
.
usc-t15-ch2D:idd058f89b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-9-3> ;
  fro-usc:hasContentText "the enforcement authority of the Commission with respect to such violations provided under this subchapter; and" ;
  fro-usc:hasId "idd058f89b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/i/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd058f89c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-9-4> ;
  fro-usc:hasContentText "the enforcement authority of the Commission with respect to violations of the standard of conduct applicable to a broker or dealer providing personalized investment advice about securities to a retail customer under the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], including the authority to impose sanctions for such violations, and" ;
  fro-usc:hasId "idd058f89c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/i/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
