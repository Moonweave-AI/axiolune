usc-t15-ch2D:idd0543df9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-4-3> ;
  fro-usc:hasContentText "the amount of assets under management and use of leverage, including off-balance-sheet leverage;" ;
  fro-usc:hasId "idd0543df9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd0543dfa-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-4-4> ;
  fro-usc:hasContentText "counterparty credit risk exposure;" ;
  fro-usc:hasId "idd0543dfa-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd0543dfb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-4-5> ;
  fro-usc:hasContentText "trading and investment positions;" ;
  fro-usc:hasId "idd0543dfb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd0543dfc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-4-6> ;
  fro-usc:hasContentText "valuation policies and practices of the fund;" ;
  fro-usc:hasId "idd0543dfc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/3/D" ;
  fro-usc:hasNumberText "(D)" ;
.
usc-t15-ch2D:idd0543dfd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-4-7> ;
  fro-usc:hasContentText "types of assets held;" ;
  fro-usc:hasId "idd0543dfd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/3/E" ;
  fro-usc:hasNumberText "(E)" ;
.
usc-t15-ch2D:idd0543dfe-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-4-8> ;
  fro-usc:hasContentText "side arrangements or side letters, whereby certain investors in a fund obtain more favorable rights or entitlements than other investors;" ;
  fro-usc:hasId "idd0543dfe-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/3/F" ;
  fro-usc:hasNumberText "(F)" ;
.
usc-t15-ch2D:idd0543dff-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-4-9> ;
  fro-usc:hasContentText "trading practices; and" ;
  fro-usc:hasId "idd0543dff-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/3/G" ;
  fro-usc:hasNumberText "(G)" ;
.
usc-t15-ch2D:idd0543e00-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-4-10> ;
  fro-usc:hasContentText "such other information as the Commission, in consultation with the Council, determines is necessary and appropriate in the public interest and for the protection of investors or for the assessment of systemic risk, which may include the establishment of different reporting requirements for different classes of fund advisers, based on the type or size of private fund being advised." ;
  fro-usc:hasId "idd0543e00-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/3/H" ;
  fro-usc:hasNumberText "(H)" ;
.
usc-t15-ch2D:idd05686f1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-5> ;
  fro-usc:hasContentText "An investment adviser registered under this subchapter shall maintain such records of private funds advised by the investment adviser for such period or periods as the Commission, by rule, may prescribe as necessary and appropriate in the public interest and for the protection of investors, or for the assessment of systemic risk." ;
  fro-usc:hasHeading "Maintenance of records" ;
  fro-usc:hasId "idd05686f1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd05686f2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-6> ;
  fro-usc:hasContentText "The Commission shall issue rules requiring each investment adviser to a private fund to file reports containing such information as the Commission deems necessary and appropriate in the public interest and for the protection of investors or for the assessment of systemic risk." ;
  fro-usc:hasHeading "Filing of records" ;
  fro-usc:hasId "idd05686f2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd05686f3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-7> ;
  fro-usc:hasHeading "Examination of records" ;
  fro-usc:hasId "idd05686f3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/6" ;
  fro-usc:hasNumberText "(6)" ;
  lkif-mereo:component usc-t15-ch2D:idd05686f4-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd05686f7-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd05686f4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-7-2> ;
  fro-usc:hasHeading "Periodic and special examinations" ;
  fro-usc:hasId "idd05686f4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/6/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-6-3-7-2-2> ;
  lkif-mereo:component usc-t15-ch2D:idd05686f5-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd05686f6-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd05686f5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-7-2-3> ;
  fro-usc:hasContentText "shall conduct periodic inspections of the records of private funds maintained by an investment adviser registered under this subchapter in accordance with a schedule established by the Commission; and" ;
  fro-usc:hasId "idd05686f5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/6/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd05686f6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-7-2-4> ;
  fro-usc:hasContentText "may conduct at any time and from time to time such additional, special, and other examinations as the Commission may prescribe as necessary and appropriate in the public interest and for the protection of investors, or for the assessment of systemic risk." ;
  fro-usc:hasId "idd05686f6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/6/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd05686f7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-7-3> ;
  fro-usc:hasContentText "An investment adviser registered under this subchapter shall make available to the Commission any copies or extracts from such records as may be prepared without undue effort, expense, or delay, as the Commission or its representatives may reasonably request." ;
  fro-usc:hasHeading "Availability of records" ;
  fro-usc:hasId "idd05686f7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/6/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd05686f8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-8> ;
  fro-usc:hasHeading "Information sharing" ;
  fro-usc:hasId "idd05686f8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/7" ;
  fro-usc:hasNumberText "(7)" ;
  lkif-mereo:component usc-t15-ch2D:idd05686f9-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd05686fa-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd05686f9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-8-2> ;
  fro-usc:hasContentText "The Commission shall make available to the Council copies of all reports, documents, records, and information filed with or provided to the Commission by an investment adviser under this subsection as the Council may consider necessary for the purpose of assessing the systemic risk posed by a private fund." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd05686f9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/7/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd05686fa-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-6-3-8-3> ;
  fro-usc:hasContentText "The Council shall maintain the confidentiality of information received under this paragraph in all such reports, documents, records, and information, in a manner consistent with the level of confidentiality established for the Commission pursuant to paragraph (8). The Council shall be exempt from section 552 of title 5 with respect to any information in any report, document, record, or information made available, to the Council under this subsection.”. 1" ;
  fro-usc:hasHeading "Confidentiality" ;
  fro-usc:hasId "idd05686fa-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/7/B" ;
  fro-usc:hasNumberText "(B)" ;
