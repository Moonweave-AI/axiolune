  fro-usc:hasReferenceText "/us/stat/84/1422" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 ; Pub. L. 99–514 , § 2, Oct. 22, 1986 , 100 Stat. 2095 .) , title I, § 19, 54 Stat. 821 ; Pub. L. 91–547 , § 11, Dec. 14, 1970 , 84 Stat. 1422" ;
.
usc-t15-ch2D:idd045e5e9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-21-5-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd045e5e9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1970— Pub. L. 91–547 designated existing provisions as subsec. (a) and added subsec. (b)." ;
  fro-usc:hasNoteText "1986—Subsec. (b). Pub. L. 99–514 substituted “Internal Revenue Code of 1986” for “Internal Revenue Code of 1954”, which for purposes of codification was translated as “title 26” thus requiring no change in text." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
  fro-usc:hasReferenceText "/us/pl/99/514" ;
.
