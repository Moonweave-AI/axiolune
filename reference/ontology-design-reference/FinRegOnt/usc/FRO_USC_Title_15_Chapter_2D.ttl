usc-t15-ch2D:idd043749a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-19-2-3> ;
  fro-usc:hasContentText "knowingly to sell any security or other property to such registered company or to any company controlled by such registered company, unless such sale involves solely (A) securities of which the buyer is the issuer, (B) securities of which the seller is the issuer and which are part of a general offering to the holders of a class of its securities, or (C) securities deposited with the trustee of a unit investment trust or periodic payment plan by the depositor thereof;" ;
  fro-usc:hasId "idd043749a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–17/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd043749b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-19-2-4> ;
  fro-usc:hasContentText "knowingly to purchase from such registered company, or from any company controlled by such registered company, any security or other property (except securities of which the seller is the issuer);" ;
  fro-usc:hasId "idd043749b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–17/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd043749c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-19-2-5> ;
  fro-usc:hasContentText "to borrow money or other property from such registered company or from any company controlled by such registered company (unless the borrower is controlled by the lender) except as permitted in section 80a–21(b) of this title ; or" ;
  fro-usc:hasId "idd043749c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–17/a/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–21/b" ;
.
usc-t15-ch2D:idd043749d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-19-2-6> ;
  fro-usc:hasContentText "to loan money or other property to such registered company, or to any company controlled by such registered company, in contravention of such rules, regulations, or orders as the Commission may, after consultation with and taking into consideration the views of the Federal banking agencies (as defined in section 1813 of title 12 ), prescribe or issue consistent with the protection of investors." ;
  fro-usc:hasId "idd043749d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–17/a/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813" ;
.
