  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04aa0dc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1970— Pub. L. 91–547 inserted provision for party acting in representative capacity and substituted provisions for prompt filing with the Commission of copies of all pleadings, verdicts, judgments, settlements, compromises, or discontinuances served or filed in suits by a registered investment company or a security holder thereof against an officer, director, investment adviser, trustee, or depositor of such company and of copies of motions, transcripts, or other documents if the Commission requests them for prior requirement that registered companies and their affiliated persons who are defendants in derivative suits involving an alleged breach of official duty transmit to the Commission copies of the pleadings and the record in such actions after a settlement or compromise of the action has been approved by a court of competent jurisdiction or a verdict or final judgment on the merits has been rendered, Commission use of information, and nondisclosure of identity of persons." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
.
usc-t15-ch2D:idd04aa0dd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-34-6-1> ;
  fro-usc:hasHeading "Effective Date of 1970 Amendment" ;
  fro-usc:hasId "idd04aa0dd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Amendment by Pub. L. 91–547 effective Dec. 14, 1970 , see section 30 of Pub. L. 91–547 , set out as a note under section 80a–52 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
  fro-usc:hasReferenceText "/us/pl/91/547/s30" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–52" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd04d118a-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa0de-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-34-6-2> ;
  fro-usc:hasHeading "Transfer of Functions" ;
  fro-usc:hasId "idd04aa0de-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For transfer of functions of Securities and Exchange Commission, with certain exceptions, to Chairman of such Commission, see Reorg. Plan No. 10 of 1950, §§ 1, 2, eff. May 24, 1950 , 15 F.R. 3175, 64 Stat. 1265 , set out under section 78d of this title ." ;
  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
usc-t15-ch2D:idd04aa0df-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0e0-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0e1-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 35 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa0e4-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-35> ;
  fro-usc:hasHeading "Destruction and falsification of reports and records" ;
  fro-usc:hasId "idd04aa0df-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–33" ;
  fro-usc:hasNumberText "§ 80a–33." ;
  lkif-mereo:component usc-t15-ch2D:idd04aa0e2-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa0e0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-35-2> ;
  fro-usc:hasContentText "It shall be unlawful for any person, except as permitted by rule, regulation, or order of the Commission, willfully to destroy, mutilate, or alter any account, book, or other document the preservation of which has been required pursuant to section 80a–30(a) or 80a–31(c) of this title." ;
  fro-usc:hasHeading "Willful destruction" ;
  fro-usc:hasId "idd04aa0e0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–33/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd04aa0e1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-35-3> ;
  fro-usc:hasContentText "It shall be unlawful for any person to make any untrue statement of a material fact in any registration statement, application, report, account, record, or other document filed or transmitted pursuant to this subchapter or the keeping of which is required pursuant to section 80a–30 (a) of this title. It shall be unlawful for any person so filing, transmitting, or keeping any such document to omit to state therein any fact necessary in order to prevent the statements made therein, in the light of the circumstances under which they were made, from being materially misleading. For the purposes of this subsection, any part of any such document which is signed or certified by an accountant or auditor in his capacity as such shall be deemed to be made, filed, transmitted, or kept by such accountant or auditor, as well as by the person filing, transmitting, or keeping the complete document." ;
  fro-usc:hasHeading "Untrue statements or omissions" ;
  fro-usc:hasId "idd04aa0e1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–33/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04aa0e2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
