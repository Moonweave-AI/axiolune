  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-3-2-21-2-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c6f97-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6f98-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6f99-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6f9a-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6f9b-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6f9f-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c6fa3-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c6f97-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-21-2-2> ;
  fro-usc:hasContentText "any affiliated person of such company," ;
  fro-usc:hasId "idd03c6f97-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/19/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd03c6f98-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-21-2-3> ;
  fro-usc:hasContentText "any member of the immediate family of any natural person who is an affiliated person of such company," ;
  fro-usc:hasId "idd03c6f98-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/19/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd03c6f99-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-3-2-21-2-4> ;
  fro-usc:hasContentText "any interested person of any investment adviser of or principal underwriter for such company," ;
  fro-usc:hasId "idd03c6f99-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–2/a/19/A/iii" ;
