  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
usc-t15-ch2D:idd058f8bd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f8be-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f8bf-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 20 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8c2-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-20> ;
  fro-usc:hasHeading "Validity of contracts" ;
  fro-usc:hasId "idd058f8bd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–15" ;
  fro-usc:hasNumberText "§ 80b–15." ;
  lkif-mereo:component usc-t15-ch2D:idd058f8c0-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd058f8be-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-20-2> ;
  fro-usc:hasContentText "Any condition, stipulation, or provision binding any person to waive compliance with any provision of this subchapter or with any rule, regulation, or order thereunder shall be void." ;
  fro-usc:hasHeading "Waiver of compliance as void" ;
  fro-usc:hasId "idd058f8be-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–15/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd058f8bf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-20-3> ;
  fro-usc:hasContentText "Every contract made in violation of any provision of this subchapter and every contract heretofore or hereafter made, the performance of which involves the violation of, or the continuance of any relationship or practice in violation of any provision of this subchapter, or any rule, regulation, or order thereunder, shall be void (1) as regards the rights of any person who, in violation of any such provision, rule, regulation, or order, shall have made or engaged in the performance of any such contract, and (2) as regards the rights of any person who, not being a party to such contract, shall have acquired any right thereunder with actual knowledge of the facts by reason of which the making or performance of such contract was in violation of any such provision." ;
  fro-usc:hasHeading "Rights affected by invalidity" ;
  fro-usc:hasId "idd058f8bf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–15/b" ;
  fro-usc:hasNumberText "(b)" ;
.
