usc-t15-ch2D:idd04d1191-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-55-2-3> ;
  fro-usc:hasContentText "has a class of its equity securities registered under section 78 l of this title; or" ;
  fro-usc:hasId "idd04d1191-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–53/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04d1192-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-55-2-4> ;
  fro-usc:hasContentText "has filed a registration statement pursuant to section 78 l of this title for a class of its equity securities." ;
  fro-usc:hasId "idd04d1192-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–53/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04d1193-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-55-3> ;
  fro-usc:hasContentText "The Commission may, by rule, prescribe the form and manner in which notification of election under this section shall be given. A business development company shall be deemed to be subject to sections 80a–54 through 80a–64 of this title upon receipt by the Commission of such notification of election." ;
  fro-usc:hasHeading "Form and manner of notification; effect" ;
  fro-usc:hasId "idd04d1193-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–53/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04d1194-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-55-4> ;
  fro-usc:hasContentText "Whenever the Commission finds, on its own motion or upon application, that a business development company which has filed a notification of election pursuant to subsection (a) of this section has ceased to engage in business, the Commission shall so declare by order revoking such company’s election. Any business development company may voluntarily withdraw its election under subsection (a) by filing a notice of withdrawal of election with the Commission, in a form and manner which the Commission may, by rule, prescribe. Such withdrawal shall be effective immediately upon receipt by the Commission." ;
  fro-usc:hasHeading "Revocation or withdrawal of election" ;
  fro-usc:hasId "idd04d1194-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–53/c" ;
  fro-usc:hasNumberText "(c)" ;
.
