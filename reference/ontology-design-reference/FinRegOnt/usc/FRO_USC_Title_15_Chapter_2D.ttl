.
usc-t15-ch2D:idd04d118d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-54-4-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04d118d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1987— Pub. L. 100–181 struck out at end of first sentence “:  Provided, however , That any such face-amount certificate company may register prior to said date, as provided by section 80a–8 of this title , and such registration shall not operate to change or affect said effective date as to any such company or any face-amount certificates issued by it”." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–8" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd03eb9a2-0c74-11e6-aa53-e455a13f2ad9 ;
.
