  fro-usc:hasHeading "Effective Date" ;
  fro-usc:hasId "idd0543def-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Section effective 270 days after Oct. 11, 1996 , see section 308(a) of Pub. L. 104–290 , as amended, set out as an Effective Date of 1996 Amendment note under section 80b–2 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDate" ;
  fro-usc:hasReferenceText "/us/pl/104/290/s308/a" ;
