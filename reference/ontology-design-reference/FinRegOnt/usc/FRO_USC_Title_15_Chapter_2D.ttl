  fro-usc:hasReferenceText "/us/stat/54/802" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 .) , title I, § 7, 54 Stat. 802 ; Pub. L. 104–62 , § 2(b), Dec. 8, 1995 , 109 Stat. 683" ;
.
usc-t15-ch2D:idd03eb99f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-8-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd03eb99f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1995—Subsec. (e). Pub. L. 104–62 added subsec. (e)." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/104/62" ;
.
usc-t15-ch2D:idd03eb9a0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-8-1> ;
  fro-usc:hasHeading "Effective Date of 1995 Amendment" ;
  fro-usc:hasId "idd03eb9a0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Amendment by Pub. L. 104–62 , set out as a note under section 77c of this title . applicable as defense to any claim in administrative and judicial actions pending on or commenced after Dec. 8, 1995 , that any person, security, interest, or participation of type described in Pub. L. 104–62 is subject to the Securities Act of 1933, the Securities Exchange Act of 1934, the Investment Company Act of 1940, the Investment Advisers Act of 1940, or any State statute or regulation preempted as provided in section 80a–3a of this title , except as specifically provided in such statutes, see section 7 of Pub. L. 104–62" ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/104/62" ;
  fro-usc:hasReferenceText "/us/pl/104/62/s7" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77c" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3a" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd03eb948-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03eb9a1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-8-2> ;
  fro-usc:hasHeading "Transfer of Functions" ;
  fro-usc:hasId "idd03eb9a1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For transfer of functions of Securities and Exchange Commission, with certain exceptions, to Chairman of such Commission, see Reorg. Plan No. 10 of 1950, §§ 1, 2, eff. May 24, 1950 , 15 F.R. 3175, 64 Stat. 1265 , set out under section 78d of this title ." ;
  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
usc-t15-ch2D:idd03eb9a2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb9a3-0c74-11e6-aa53-e455a13f2ad9 ;
