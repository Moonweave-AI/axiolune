  fro-usc:hasReferenceText "/us/stat/94/2280" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title I, § 56, as added Pub. L. 96–477, title I § 105, Oct. 21, 1980 , 94 Stat. 2280 .)" ;
.
