usc-t15-ch2D:idd03eb98a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-9-2> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd03eb98a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1959—Subsec. (a)(1). Pub. L. 86–70 struck out reference to Alaska." ;
  fro-usc:hasNoteText "1960—Subsec. (a)(1). Pub. L. 86–624 struck out reference to Hawaii." ;
  fro-usc:hasNoteText "1978—Subsec. (a)(2). Pub. L. 95–598 substituted “a case under title 11” for “bankruptcy”." ;
  fro-usc:hasNoteText "1980—Subsec. (f). Pub. L. 96–477 added subsec. (f)." ;
  fro-usc:hasNoteText "1987—Subsec. (a)(1). Pub. L. 100–181 , § 608(1), struck out reference to Canal Zone." ;
  fro-usc:hasNoteText "1996—Subsec. (a)(5). Pub. L. 104–290 , § 501, added par. (5)." ;
  fro-usc:hasNoteText "2010—Subsec. (a)(5)(A)(iv)(I). Pub. L. 111–203 substituted “meets such standards of credit-worthiness as the Commission shall adopt” for “is rated investment grade by not less than 1 nationally recognized statistical rating organization”." ;
  fro-usc:hasNoteText "Subsec. (a)(2) to (5). Pub. L. 100–181 , § 608(2), redesignated former pars. (3) to (5) as (2) to (4), and struck out former par. (2) which read as follows: “Any company for which, in a proceeding in any court of the United States or of a State, a receiver, trustee in a case under title 11, or similar officer had been appointed or elected prior to the effective date of this subchapter, and every such officer so appointed or elected prior to the effective date of this subchapter; but such exemption shall continue only so long as (A) the conduct of such company’s business remains subject to the supervision of such court or officer thereof, and (B) such company does not sell exclusively for cash any security of which it is the issuer, except short-term paper and ordinary receiver’s or trustee’s certificates.”" ;
  fro-usc:hasNoteText "Subsec. (d)(1). Pub. L. 104–290 , § 502, substituted “$10,000,000, or such other amount as the Commission may set by rule, regulation, or order” for “$100,000”." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
  fro-usc:hasReferenceText "/us/pl/104/290" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/86/624" ;
  fro-usc:hasReferenceText "/us/pl/86/70" ;
  fro-usc:hasReferenceText "/us/pl/95/598" ;
  fro-usc:hasReferenceText "/us/pl/96/477" ;
.
