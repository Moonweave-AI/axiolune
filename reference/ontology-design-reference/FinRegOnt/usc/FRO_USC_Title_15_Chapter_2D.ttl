usc-t15-ch2D:idd04856a4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-2> ;
  fro-usc:hasContentText "Every registered investment company shall file annually with the Commission such information, documents, and reports as investment companies having securities registered on a national securities exchange are required to file annually pursuant to section 13(a) of the Securities Exchange Act of 1934 [ 15 U.S.C. 78m(a) ] and the rules and regulations issued thereunder." ;
  fro-usc:hasHeading "Annual report by company" ;
  fro-usc:hasId "idd04856a4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–29/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78m/a" ;
.
usc-t15-ch2D:idd04856a5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
