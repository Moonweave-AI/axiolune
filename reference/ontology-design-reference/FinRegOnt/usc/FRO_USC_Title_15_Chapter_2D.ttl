.
usc-t15-ch2D:idd04d1203-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-3-2> ;
  fro-usc:hasId "idd04d1203-0c74-11e6-aa53-e455a13f2ad9" ;
