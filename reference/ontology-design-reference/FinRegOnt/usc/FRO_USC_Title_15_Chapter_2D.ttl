  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5> ;
  fro-usc:hasHeading "Protection of philanthropy under State law" ;
  fro-usc:hasId "idd03eb948-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3a" ;
  fro-usc:hasNumberText "§ 80a–3a." ;
  lkif-mereo:component usc-t15-ch2D:idd03eb953-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03eb949-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-2> ;
  fro-usc:hasContentText "A security issued by or any interest or participation in any pooled income fund, collective trust fund, collective investment fund, or similar fund that is excluded from the definition of an investment company under section 80a–3(c)(10)(B) of this title , and the offer or sale thereof, shall be exempt from any statute or regulation of a State that requires registration or qualification of securities." ;
  fro-usc:hasHeading "Registration requirements" ;
  fro-usc:hasId "idd03eb949-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3a/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/10/B" ;
.
usc-t15-ch2D:idd03eb94a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb94b-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb94c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb94d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-5-3> ;
  fro-usc:hasHeading "Treatment of charitable organizations" ;
