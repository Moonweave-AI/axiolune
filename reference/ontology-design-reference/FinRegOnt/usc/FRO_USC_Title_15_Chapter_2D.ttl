  lkif-mereo:component usc-t15-ch2D:idd056872a-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0568729-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-3-4-2> ;
  fro-usc:hasContentText "an investment company registered under subchapter I of this chapter, or" ;
  fro-usc:hasId "idd0568729-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/b/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd056872a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-3-4-3> ;
  fro-usc:hasContentText "any other person (except a trust, governmental plan, collective trust fund, or separate account referred to in section 80a–3(c)(11) of this title ), provided that the contract relates to the investment of assets in excess of $1 million," ;
  fro-usc:hasId "idd056872a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/b/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/11" ;
.
usc-t15-ch2D:idd056872b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-3-5> ;
  fro-usc:hasContentText "apply with respect to any investment advisory contract between an investment adviser and a business development company, as defined in this subchapter, if (A) the compensation provided for in such contract does not exceed 20 per centum of the realized capital gains upon the funds of the business development company over a specified period or as of definite dates, computed net of all realized capital losses and unrealized capital depreciation, and the condition of section 80a–60(a)(3)(B)(iii) of this title is satisfied, and (B) the business development company does not have outstanding any option, warrant, or right issued pursuant to section 80a–60(a)(3)(B) of this title and does not have a profit-sharing plan described in section 80a–56(n) of this title ;" ;
  fro-usc:hasId "idd056872b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/b/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–56/n" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–60/a/3/B" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–60/a/3/B/iii" ;
.
usc-t15-ch2D:idd056872c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-3-6> ;
  fro-usc:hasContentText "apply to an investment advisory contract with a company excepted from the definition of an investment company under section 80a–3(c)(7) of this title ; or" ;
  fro-usc:hasId "idd056872c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/b/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/7" ;
.
usc-t15-ch2D:idd056872d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-3-7> ;
  fro-usc:hasContentText "apply to an investment advisory contract with a person who is not a resident of the United States." ;
  fro-usc:hasId "idd056872d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd056872e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-4> ;
  fro-usc:hasContentText "For purposes of paragraph (2) of subsection (b), the point from which increases and decreases in compensation are measured shall be the fee which is paid or earned when the investment performance of such company or fund is equivalent to that of the index or other measure of performance, and an index of securities prices shall be deemed appropriate unless the Commission by order shall determine otherwise." ;
  fro-usc:hasHeading "Measurement of changes in compensation" ;
  fro-usc:hasId "idd056872e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd056872f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-5> ;
  fro-usc:hasContentText "As used in paragraphs (2) and (3) of subsection (a), “investment advisory contract” means any contract or agreement whereby a person agrees to act as investment adviser to or to manage any investment or trading account of another person other than an investment company registered under subchapter I of this chapter." ;
  fro-usc:hasHeading "“Investment advisory contract” defined" ;
  fro-usc:hasId "idd056872f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd0568730-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-6> ;
  fro-usc:hasContentText "The Commission, by rule or regulation, upon its own motion, or by order upon application, may conditionally or unconditionally exempt any person or transaction, or any class or classes of persons or transactions, from subsection (a)(1), if and to the extent that the exemption relates to an investment advisory contract with any person that the Commission determines does not need the protections of subsection (a)(1), on the basis of such factors as financial sophistication, net worth, knowledge of and experience in financial matters, amount of assets under management, relationship with a registered investment adviser, and such other factors as the Commission determines are consistent with this section. With respect to any factor used in any rule or regulation by the Commission in making a determination under this subsection, if the Commission uses a dollar amount test in connection with such factor, such as a net asset threshold, the Commission shall, by order, not later than 1 year after July 21, 2010 , and every 5 years thereafter, adjust for the effects of inflation on such test. Any such adjustment that is not a multiple of $100,000 shall be rounded to the nearest multiple of $100,000." ;
  fro-usc:hasHeading "Exempt persons and transactions" ;
  fro-usc:hasId "idd0568730-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/e" ;
  fro-usc:hasNumberText "(e)" ;
.
usc-t15-ch2D:idd0568731-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-7> ;
  fro-usc:hasContentText "The Commission, by rule, may prohibit, or impose conditions or limitations on the use of, agreements that require customers or clients of any investment adviser to arbitrate any future dispute between them arising under the Federal securities laws, the rules and regulations thereunder, or the rules of a self-regulatory organization if it finds that such prohibition, imposition of conditions, or limitations are in the public interest and for the protection of investors." ;
  fro-usc:hasHeading "Authority to restrict mandatory pre-dispute arbitration" ;
  fro-usc:hasId "idd0568731-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/f" ;
  fro-usc:hasNumberText "(f)" ;
.
usc-t15-ch2D:idd0568732-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-usc:hasId "idd0568732-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/100/181/tVII" ;
  fro-usc:hasReferenceText "/us/pl/104/290/tII" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIV" ;
  fro-usc:hasReferenceText "/us/pl/86/750" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
  fro-usc:hasReferenceText "/us/pl/96/477/tII" ;
  fro-usc:hasReferenceText "/us/stat/101/1263" ;
  fro-usc:hasReferenceText "/us/stat/110/3436" ;
  fro-usc:hasReferenceText "/us/stat/124/1579" ;
  fro-usc:hasReferenceText "/us/stat/54/852" ;
  fro-usc:hasReferenceText "/us/stat/74/887" ;
  fro-usc:hasReferenceText "/us/stat/84/1432" ;
  fro-usc:hasReferenceText "/us/stat/94/2290" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 ; Pub. L. 91–547 , § 25, Dec. 14, 1970 , 84 Stat. 1432 ; Pub. L. 96–477, title II , § 203, Oct. 21, 1980 , 94 Stat. 2290 ; Pub. L. 100–181, title VII , § 703, Dec. 4, 1987 , 101 Stat. 1263 ; Pub. L. 104–290, title II , title II, § 205, 54 Stat. 852 , § 210, Oct. 11, 1996 , 110 Stat. 3436 ; Pub. L. 111–203, title IV , § 418, title IX, §§ 921(b), 928, July 21, 2010 , 124 Stat. 1579 , 1841, 1852.) ; Pub. L. 86–750 , § 7, Sept. 13, 1960 , 74 Stat. 887" ;
.
usc-t15-ch2D:idd0568734-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-9-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd0568734-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1960— Pub. L. 86–750 substituted “unless exempt from registration pursuant to” for “registered under”." ;
  fro-usc:hasNoteText "1970— Pub. L. 91–547 substituted reference to section “80b–3(b)” for “80b–3” of this title in first sentence, redesignated as second sentence former third sentence, designating existing provisions as cl. (A) and adding cl. (B) and items (i) and (ii) and provision respecting compensation based on asset value of company or fund under management averaged over a specified period in relation to investment record of an index of securities or such other measure of investment performance specified by Commission rules, regulations, or orders, inserted third sentence provision respecting point from which compensation is to be measured, substituted in fourth, formerly third, sentence “paragraphs (2) and (3) of this section” for “this section” and in definition of “investment advisory contract” the words “account of another person other than an investment company registered under subchapter I of this chapter” for “account for a person other than an investment company”." ;
  fro-usc:hasNoteText "1980— Pub. L. 96–477 provided that par. (1) of this section was not to apply with respect to any investment advisory contract between an investment adviser and a business development company so long as the compensation provided for in such contract did not exceed 20 per cent of the realized capital gains upon the funds of the business development company and such business development company did not have outstanding any option, warrant, or right issued pursuant to section 80a–60(a)(3)(B) of this title and did not have a profit-sharing plan." ;
  fro-usc:hasNoteText "1987— Pub. L. 100–181 completely revised and expanded provisions on investment advisory contracts, changing structure of section from a single unlettered paragraph to one consisting of four subsections lettered (a) to (d)." ;
  fro-usc:hasNoteText "1996—Subsec. (b)(4), (5). Pub. L. 104–290 , § 210(1), added pars. (4) and (5)." ;
  fro-usc:hasNoteText "2010—Subsec. (a). Pub. L. 111–203 , § 928, in introductory provisions, substituted “registered or required to be registered with the Commission” for “, unless exempt from registration pursuant to section 80b–3(b) of this title ,” and struck out “make use of the mails or any means or instrumentality of interstate commerce, directly or indirectly, to” after “shall” and “to” after “in any way”." ;
  fro-usc:hasNoteText "Subsec. (e). Pub. L. 104–290 , § 210(2), added subsec. (e)." ;
  fro-usc:hasNoteText "Subsec. (e). Pub. L. 111–203 , § 418, inserted at end “With respect to any factor used in any rule or regulation by the Commission in making a determination under this subsection, if the Commission uses a dollar amount test in connection with such factor, such as a net asset threshold, the Commission shall, by order, not later than 1 year after July 21, 2010 , and every 5 years thereafter, adjust for the effects of inflation on such test. Any such adjustment that is not a multiple of $100,000 shall be rounded to the nearest multiple of $100,000.”" ;
  fro-usc:hasNoteText "Subsec. (f). Pub. L. 111–203 , § 921(b), added subsec. (f)." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
  fro-usc:hasReferenceText "/us/pl/104/290" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/86/750" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
  fro-usc:hasReferenceText "/us/pl/96/477" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–60/a/3/B" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3/b" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd04d1202-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd04f5b60-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0568735-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-9-1> ;
  fro-usc:hasHeading "Effective Date of 2010 Amendment" ;
  fro-usc:hasId "idd0568735-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Amendment by section 418 of Pub. L. 111–203 effective 1 year after July 21, 2010 , except that any investment adviser may, at the discretion of the investment adviser, register with the Commission under the Investment Advisers Act of 1940 during that 1-year period, subject to the rules of the Commission, and except as otherwise provided, see section 419 of Pub. L. 111–203 , set out as a note under section 80b–2 of this title ." ;
  fro-usc:hasNoteText "Amendment by sections 921(b) and 928 of Pub. L. 111–203 effective 1 day after July 21, 2010 , except as otherwise provided, see section 4 of Pub. L. 111–203 , set out as an Effective Date note under section 5301 of Title 12 , Banks and Banking." ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s4" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s418" ;
