  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s4" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
.
usc-t15-ch2D:idd04d1180-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-51-4-3> ;
  fro-usc:hasHeading "Transfer of Functions" ;
  fro-usc:hasId "idd04d1180-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For transfer of functions of Securities and Exchange Commission, with certain exceptions, to Chairman of such Commission, see Reorg. Plan No. 10 of 1950, §§ 1, 2, eff. May 24, 1950 , 15 F.R. 3175, 64 Stat. 1265 , set out under section 78d of this title ." ;
  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
usc-t15-ch2D:idd04d1181-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 52 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-52> ;
  fro-usc:hasContentText "If any provision of this subchapter or any provision incorporated in this subchapter by reference, or the application of any such provision to any person or circumstances, shall be held invalid, the remainder of this subchapter and the application of any such provision to person or circumstances other than those as to which it is held invalid shall not be affected thereby." ;
  fro-usc:hasHeading "Separability" ;
  fro-usc:hasId "idd04d1181-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–50" ;
  fro-usc:hasNumberText "§ 80a–50." ;
  lkif-mereo:component usc-t15-ch2D:idd04d1182-0c74-11e6-aa53-e455a13f2ad9 ;
.
