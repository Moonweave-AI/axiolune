usc-t15-ch2D:idd058f8a8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f8a9-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f8aa-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8ad-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8ae-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8af-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8b0-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-18> ;
  fro-usc:hasHeading "Court review of orders" ;
  fro-usc:hasId "idd058f8a8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–13" ;
  fro-usc:hasNumberText "§ 80b–13." ;
  lkif-mereo:component usc-t15-ch2D:idd058f8ab-0c74-11e6-aa53-e455a13f2ad9 ;
