  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa113-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa114-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-39> ;
  fro-usc:hasHeading "Rules, regulations, and orders" ;
  fro-usc:hasId "idd04aa10b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–37" ;
  fro-usc:hasNumberText "§ 80a–37." ;
  lkif-mereo:component usc-t15-ch2D:idd04aa10f-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa10c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-39-2> ;
  fro-usc:hasContentText "The Commission shall have authority from time to time to make, issue, amend, and rescind such rules and regulations and such orders as are necessary or appropriate to the exercise of the powers conferred upon the Commission elsewhere in this subchapter, including rules and regulations defining accounting, technical, and trade terms used in this subchapter, and prescribing the form or forms in which information required in registration statements, applications, and reports to the Commission shall be set forth. For the purposes of its rules or regulations the Commission may classify persons, securities, and other matters within its jurisdiction and prescribe different requirements for different classes of persons, securities, or matters." ;
  fro-usc:hasHeading "Powers of Commission" ;
  fro-usc:hasId "idd04aa10c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–37/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd04aa10d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-39-3> ;
  fro-usc:hasContentText "The Commission, by such rules and regulations or order as it deems necessary or appropriate in the public interest or for the protection of investors, may authorize the filing of any information or documents required to be filed with the Commission under this subchapter, subchapter II of this chapter, the Securities Act of 1933 [ 15 U.S.C. 77a et seq.], the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], or the Trust Indenture Act of 1939 [ 15 U.S.C. 77aaa et seq.], by incorporating by reference any information or documents theretofore or concurrently filed with the Commission under this subchapter or any of such Acts." ;
  fro-usc:hasHeading "Filing of information and documents" ;
  fro-usc:hasId "idd04aa10d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–37/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77aaa" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd04aa10e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-39-4> ;
  fro-usc:hasContentText "No provision of this subchapter imposing any liability shall apply to any act done or omitted in good faith in conformity with any rule, regulation, or order of the Commission, notwithstanding that such rule, regulation, or order may, after such act or omission, by amended or rescinded or be determined by judicial or other authority to be invalid for any reason." ;
  fro-usc:hasHeading "Good faith conformance with rules, regulations, and orders" ;
  fro-usc:hasId "idd04aa10e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–37/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd04aa10f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "idd04aa10f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIX" ;
  fro-usc:hasReferenceText "/us/stat/124/1936" ;
  fro-usc:hasReferenceText "/us/stat/54/841" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 .) , title I, § 38, 54 Stat. 841 ; Pub. L. 111–203, title IX , § 986(c)(3), July 21, 2010 , 124 Stat. 1936" ;
.
usc-t15-ch2D:idd04aa111-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-39-6-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd04aa111-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Securities Act of 1933, referred to in subsec. (b), is act May 27, 1933, ch. 38, title I , 48 Stat. 74 , which is classified generally to subchapter I (§ 77a et seq.) of chapter 2A of this title. For complete classification of this Act to the Code, see section 77a of this title and Tables." ;
  fro-usc:hasNoteText "The Securities Exchange Act of 1934, referred to in subsec. (b), is act June 6, 1934, ch. 404 , 48 Stat. 881 , which is classified principally to chapter 2B (§ 78a et seq.) of this title. For complete classification of this Act to the Code, see section 78a of this title and Tables." ;
  fro-usc:hasNoteText "The Trust Indenture Act of 1939, referred to in subsec. (b), is title III of act May 27, 1933, ch. 38 , as added Aug. 3, 1939, ch. 411 , 53 Stat. 1149 , which is classified generally to subchapter III (§ 77aaa et seq.) of chapter 2A of this title. For complete classification of this Act to the Code, see section 77aaa of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1933-05-27/ch38" ;
  fro-usc:hasReferenceText "/us/act/1933-05-27/ch38/tI" ;
  fro-usc:hasReferenceText "/us/act/1934-06-06/ch404" ;
  fro-usc:hasReferenceText "/us/act/1939-08-03/ch411" ;
  fro-usc:hasReferenceText "/us/stat/48/74" ;
  fro-usc:hasReferenceText "/us/stat/48/881" ;
  fro-usc:hasReferenceText "/us/stat/53/1149" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77aaa" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd04aa112-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-39-6-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04aa112-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "2010—Subsec. (b). Pub. L. 111–203 struck out “the Public Utility Holding Company Act of 1935,” after “the Securities Exchange Act of 1934,”." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
.
usc-t15-ch2D:idd04aa113-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-39-6-2> ;
  fro-usc:hasHeading "Effective Date of 2010 Amendment" ;
  fro-usc:hasId "idd04aa113-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Amendment by Pub. L. 111–203 effective 1 day after July 21, 2010 , except as otherwise provided, see section 4 of Pub. L. 111–203 , set out as an Effective Date note under section 5301 of Title 12 , Banks and Banking." ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s4" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
.
usc-t15-ch2D:idd04aa114-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-39-6-3> ;
  fro-usc:hasHeading "Transfer of Functions" ;
  fro-usc:hasId "idd04aa114-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For transfer of functions of Securities and Exchange Commission, with certain exceptions, to Chairman of such Commission, see Reorg. Plan No. 10 of 1950, §§ 1, 2, eff. May 24, 1950 , 15 F.R. 3175, 64 Stat. 1265 , set out under section 78d of this title ." ;
  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
usc-t15-ch2D:idd04aa115-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 40 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa118-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04aa119-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-40> ;
  fro-usc:hasContentText "Subject to the provisions of chapter 15 of title 44 and regulations prescribed under the authority thereof, the rules and regulations of the Commission under this subchapter, and amendments thereof, shall be effective upon publication in the manner which the Commission shall prescribe, or upon such later date as may be provided in such rules and regulations." ;
  fro-usc:hasHeading "Procedure for issuance of rules and regulations" ;
  fro-usc:hasId "idd04aa115-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–38" ;
  fro-usc:hasNumberText "§ 80a–38." ;
  lkif-mereo:component usc-t15-ch2D:idd04aa116-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa116-0c74-11e6-aa53-e455a13f2ad9
