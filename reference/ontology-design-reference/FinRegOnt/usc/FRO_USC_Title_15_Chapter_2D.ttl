.
usc-t15-ch2D:idd04d1204-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-3-2-1> ;
  fro-usc:hasContentText "in the case of warrants, options, or rights issued to any officer or employee of such business development company (including any officer or employee who is also a director of such company), such securities satisfy the conditions in clauses (i), (iii), and (iv) of subparagraph (A); or (II) in the case of warrants, options, or rights issued to any director of such business development company who is not also an officer or employee of such company, or to any general partner in such company, the proposal to issue such securities satisfies the conditions in clauses (i) and (iii) of subparagraph (A), is authorized by the shareholders or partners of such company, and is approved by order of the Commission, upon application, on the basis that the terms of the proposal are fair and reasonable and do not involve overreaching of such company or its shareholders or partners;" ;
  fro-usc:hasId "idd04d1204-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/B/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
usc-t15-ch2D:idd04d1205-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-3-3> ;
  fro-usc:hasContentText "such securities are not transferable except for disposition by gift, will, or intestacy;" ;
  fro-usc:hasId "idd04d1205-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd04d1206-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-3-4> ;
  fro-usc:hasContentText "no investment adviser of such business development company receives any compensation described in section 80b–5(a)(1) of this title , except to the extent permitted by paragraph (1) or (2) of section 80b–5(b) of this title ; and" ;
  fro-usc:hasId "idd04d1206-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/B/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–5/a/1" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–5/b" ;
.
usc-t15-ch2D:idd04d1207-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-3-5> ;
  fro-usc:hasContentText "such business development company does not have a profit-sharing plan described in section 80a–56(n) of this title ; and" ;
  fro-usc:hasId "idd04d1207-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/B/iv" ;
  fro-usc:hasNumberText "(iv)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–56/n" ;
.
usc-t15-ch2D:idd04f5af8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-4> ;
  fro-usc:hasId "idd04f5af8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-62-2-5-4-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04f5af9-0c74-11e6-aa53-e455a13f2ad9 ;
