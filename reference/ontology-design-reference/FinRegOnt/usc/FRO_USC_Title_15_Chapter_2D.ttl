  fro-usc:hasReferenceText "/us/stat/124/1578" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title II, § 224, as added Pub. L. 111–203, title IV , § 414, July 21, 2010 , 124 Stat. 1578 .)" ;
.
usc-t15-ch2D:idd058f8ea-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-26-4-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd058f8ea-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Commodity Exchange Act, referred to in text, is act Sept. 21, 1922, ch. 369 , 42 Stat. 998 , which is classified generally to chapter 1 (§ 1 et seq.) of Title 7, Agriculture. For complete classification of this Act to the Code, see section 1 of Title 7 and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1922-09-21/ch369" ;
  fro-usc:hasReferenceText "/us/stat/42/998" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
