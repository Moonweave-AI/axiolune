  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0412b1a-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0412b1b-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12> ;
  fro-usc:hasHeading "Affiliations or interest of directors, officers, and employees" ;
  fro-usc:hasId "idd0412afb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10" ;
  fro-usc:hasNumberText "§ 80a–10." ;
  lkif-mereo:component usc-t15-ch2D:idd0412b15-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412afc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-2> ;
  fro-usc:hasContentText "No registered investment company shall have a board of directors more than 60 per centum of the members of which are persons who are interested persons of such registered company." ;
  fro-usc:hasHeading "Interested persons of company who may serve on board of directors" ;
  fro-usc:hasId "idd0412afc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd0412afd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412afe-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412aff-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b00-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-3> ;
  fro-usc:hasHeading "Employment and use of directors, officers, etc., as regular broker, principal underwriter, or investment banker" ;
  fro-usc:hasId "idd0412afd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-12-3-2> ;
.
usc-t15-ch2D:idd0412afe-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-3-3> ;
  fro-usc:hasContentText "employ as regular broker any director, officer, or employee of such registered company, or any person of which any such director, officer, or employee is an affiliated person, unless a majority of the board of directors of such registered company shall be persons who are not such brokers or affiliated persons of any of such brokers;" ;
  fro-usc:hasId "idd0412afe-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0412aff-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-3-4> ;
  fro-usc:hasContentText "use as a principal underwriter of securities issued by it any director, officer, or employee of such registered company or any person of which any such director, officer, or employee is an interested person, unless a majority of the board of directors of such registered company shall be persons who are not such principal underwriters or interested persons of any of such principal underwriters; or" ;
  fro-usc:hasId "idd0412aff-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0412b00-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-3-5> ;
  fro-usc:hasContentText "have as director, officer, or employee any investment banker, or any affiliated person of an investment banker, unless a majority of the board of directors of such registered company shall be persons who are not investment bankers or affiliated persons of any investment banker. For the purposes of this paragraph, a person shall not be deemed an affiliated person of an investment banker solely by reason of the fact that he is an affiliated person of a company of the character described in section 80a–12(d)(3)(A) and (B) of this title." ;
  fro-usc:hasId "idd0412b00-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0412b01-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-4> ;
  fro-usc:hasContentText "No registered investment company shall have a majority of its board of directors consisting of persons who are officers, directors, or employees of any one bank (together with its affiliates and subsidiaries) or any one bank holding company (together with its affiliates and subsidiaries) (as such terms are defined in section 1841 of title 12 , any registered investment company had a majority of its directors consisting of persons who are directors, officers, or employees of any one bank, such company may continue to have the same percentage of its board of directors consisting of persons who are directors, officers, or employees of such bank. ) or any one savings and loan holding company, together with its affiliates and subsidiaries (as such terms are defined in section 1467a of title 12 ),, 1 except that, if on March 15, 1940" ;
  fro-usc:hasHeading "Officers, directors, or employees of one bank or bank holding company as majority of board of directors of company; exceptions" ;
  fro-usc:hasId "idd0412b01-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1467a" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1841" ;
.
usc-t15-ch2D:idd0412b02-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b03-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b04-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b05-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b06-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b07-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b08-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b09-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b0a-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-5> ;
  fro-usc:hasHeading "Exception to limitation of number of interested persons who may serve on board of directors" ;
  fro-usc:hasId "idd0412b02-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-12-5-2> ;
.
usc-t15-ch2D:idd0412b03-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-5-3> ;
  fro-usc:hasContentText "such investment company is an open-end company;" ;
  fro-usc:hasId "idd0412b03-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0412b04-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-5-4> ;
  fro-usc:hasContentText "such investment adviser is registered under subchapter II of this chapter and is engaged principally in the business of rendering investment supervisory services as defined in subchapter II;" ;
  fro-usc:hasId "idd0412b04-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0412b05-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-5-5> ;
  fro-usc:hasContentText "no sales load is charged on securities issued by such investment company;" ;
  fro-usc:hasId "idd0412b05-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0412b06-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-5-6> ;
  fro-usc:hasContentText "any premium over net asset value charged by such company upon the issuance of any such security, plus any discount from net asset value charged on redemption thereof, shall not in the aggregate exceed 2 per centum;" ;
  fro-usc:hasId "idd0412b06-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/d/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd0412b07-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-5-7> ;
  fro-usc:hasContentText "no sales or promotion expenses are incurred by such registered company; but expenses incurred in complying with laws regulating the issue or sale of securities shall not be deemed sales or promotion expenses;" ;
  fro-usc:hasId "idd0412b07-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/d/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd0412b08-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-5-8> ;
  fro-usc:hasContentText "such investment adviser is the only investment adviser to such investment company, and such investment adviser does not receive a management fee exceeding 1 per centum per annum of the value of such company’s net assets averaged over the year or taken as of a definite date or dates within the year;" ;
  fro-usc:hasId "idd0412b08-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/d/6" ;
  fro-usc:hasNumberText "(6)" ;
.
usc-t15-ch2D:idd0412b09-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-5-9> ;
  fro-usc:hasContentText "all executive salaries and executive expenses and office rent of such investment company are paid by such investment adviser; and" ;
  fro-usc:hasId "idd0412b09-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/d/7" ;
  fro-usc:hasNumberText "(7)" ;
.
usc-t15-ch2D:idd0412b0a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-5-10> ;
  fro-usc:hasContentText "such investment company has only one class of securities outstanding, each unit of which has equal voting rights with every other unit." ;
  fro-usc:hasId "idd0412b0a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/d/8" ;
  fro-usc:hasNumberText "(8)" ;
.
usc-t15-ch2D:idd0412b0b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b0c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b0d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b0e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-6> ;
  fro-usc:hasHeading "Death, disqualification, or resignation of directors as suspension of limitation provisions" ;
  fro-usc:hasId "idd0412b0b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-12-6-2> ;
.
usc-t15-ch2D:idd0412b0c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-6-3> ;
  fro-usc:hasContentText "for a period of thirty days if the vacancy or vacancies may be filled by action of the board of directors;" ;
  fro-usc:hasId "idd0412b0c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0412b0d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-6-4> ;
  fro-usc:hasContentText "for a period of sixty days if a vote of stockholders is required to fill the vacancy or vacancies; or" ;
  fro-usc:hasId "idd0412b0d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0412b0e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-6-5> ;
  fro-usc:hasContentText "for such longer period as the Commission may prescribe, by rules and regulations upon its own motion or by order upon application, as not inconsistent with the protection of investors." ;
  fro-usc:hasId "idd0412b0e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0412b0f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-7> ;
  fro-usc:hasContentText "No registered investment company shall knowingly purchase or otherwise acquire, during the existence of any underwriting or selling syndicate, any security (except a security of which such company is the issuer) a principal underwriter of which is an officer, director, member of an advisory board, investment adviser, or employee of such registered company, or is a person (other than a company of the character described in section 80a–12(d)(3)(A) and (B) of this title) of which any such officer, director, member of an advisory board, investment adviser, or employee is an affiliated person, unless in acquiring such security such registered company is itself acting as a principal underwriter for the issuer. The Commission, by rules and regulations upon its own motion or by order upon application, may conditionally or unconditionally exempt any transaction or classes of transactions from any of the provisions of this subsection, if and to the extent that such exemption is consistent with the protection of investors." ;
  fro-usc:hasHeading "Officer, director, etc., of company acting as principal underwriter of security acquired by company" ;
  fro-usc:hasId "idd0412b0f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/f" ;
  fro-usc:hasNumberText "(f)" ;
.
usc-t15-ch2D:idd0412b10-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-8> ;
  fro-usc:hasContentText "In the case of a registered investment company which has an advisory board, such board, as a distinct entity, shall be subject to the same restrictions as to its membership as are imposed upon a board of directors by this section." ;
  fro-usc:hasHeading "Advisory boards; restrictions on membership" ;
  fro-usc:hasId "idd0412b10-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/g" ;
  fro-usc:hasNumberText "(g)" ;
.
usc-t15-ch2D:idd0412b11-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b12-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b13-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b14-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-9> ;
  fro-usc:hasHeading "Application of section to unincorporated registered management companies" ;
  fro-usc:hasId "idd0412b11-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/h" ;
  fro-usc:hasNumberText "(h)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-12-9-2> ;
.
usc-t15-ch2D:idd0412b12-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-9-3> ;
  fro-usc:hasContentText "the provisions of subsection (a), as modified by subsection (e), shall apply to the board of directors of the depositor of such company;" ;
  fro-usc:hasId "idd0412b12-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/h/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0412b13-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-9-4> ;
  fro-usc:hasContentText "the provisions of subsections (b) and (c), as modified by subsection (e), shall apply to the board of directors of the depositor and of every investment adviser of such company; and" ;
  fro-usc:hasId "idd0412b13-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/h/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0412b14-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-12-9-5> ;
  fro-usc:hasContentText "the provisions of subsection (f) shall apply to purchases and other acquisitions for the account of such company of securities a principal underwriter of which is the depositor or an investment adviser of such company, or an affiliated person of such depositor or investment adviser." ;
  fro-usc:hasId "idd0412b14-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–10/h/3" ;
  fro-usc:hasNumberText "(3)" ;
.
