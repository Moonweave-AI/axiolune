usc-t15-ch2D:idd058f869-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-13-9-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd058f869-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1960—Subsec. (e). Pub. L. 86–750 inserted “, is engaged,” after “has engaged” wherever appearing, and inserted provisions relating to aiders and abettors." ;
  fro-usc:hasNoteText "1970—Subsec. (d). Pub. L. 91–452 struck out subsec. (d) which related to immunity from prosecution of any individual compelled to testify or produce evidence, documentary or otherwise, after claiming his privilege against self-incrimination." ;
  fro-usc:hasNoteText "1987—Subsecs. (d), (e). Pub. L. 100–181 redesignated subsec. (e) as (d)." ;
  fro-usc:hasNoteText "1990—Subsec. (e). Pub. L. 101–429 added subsec. (e)." ;
  fro-usc:hasNoteText "2002—Subsec. (e)(3)(A). Pub. L. 107–204 inserted “, except as otherwise provided in section 7246 of this title ” before period at end." ;
  fro-usc:hasNoteText "2010—Subsec. (e)(3)(A). Pub. L. 111–203 , § 923(a)(3), inserted “and section 78u–6 of this title ” after “ section 7246 of this title ”." ;
  fro-usc:hasNoteText "Subsec. (f). Pub. L. 111–203 , § 929N, added subsec. (f)." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
  fro-usc:hasReferenceText "/us/pl/101/429" ;
  fro-usc:hasReferenceText "/us/pl/107/204" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/86/750" ;
  fro-usc:hasReferenceText "/us/pl/91/452" ;
  fro-usc:hasReferenceText "/us/usc/t15/s7246" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78u–6" ;
.
