  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-62-2-2> ;
.
usc-t15-ch2D:idd04d11fa-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-3> ;
  fro-usc:hasContentText "The asset coverage requirements of section 80a–18(a)(1)(A) and (B) of this title applicable to business development companies shall be 200 per centum." ;
  fro-usc:hasId "idd04d11fa-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04d11fb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-4> ;
  fro-usc:hasContentText "Notwithstanding section 80a–18(c) of this title , a business development company may issue more than one class of senior security representing indebtedness." ;
  fro-usc:hasId "idd04d11fb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–18/c" ;
.
