usc-t15-ch2D:idd0437455-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-4-2-3> ;
  fro-usc:hasContentText "conduct or have direct investments in business operations in Sudan described in section 3(d) of the Sudan Accountability and Divestment Act of 2007 ( 50 U.S.C. 1701 note); or" ;
  fro-usc:hasId "idd0437455-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/c/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t50/s1701" ;
.
usc-t15-ch2D:idd0437456-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-4-2-4> ;
  fro-usc:hasContentText "engage in investment activities in Iran described in section 8532(c) of title 22 ." ;
  fro-usc:hasId "idd0437456-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–13/c/1/B" ;
