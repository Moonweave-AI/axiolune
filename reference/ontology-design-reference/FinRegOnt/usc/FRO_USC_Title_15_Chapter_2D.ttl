  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-2> ;
  fro-usc:hasHeading "Prohibited actions for registered investment companies" ;
  fro-usc:hasId "idd043744d-0c74-11e6-aa53-e455a13f2ad9" ;
