  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-2-5-3> ;
  fro-usc:hasContentText "issued by an issuer pursuant to or in consummation of such a plan or arrangement; or" ;
  fro-usc:hasId "idd04d11a4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–54/a/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04d11a5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-2-5-4> ;
  fro-usc:hasContentText "issued by an issuer that, immediately prior to the purchase of such issuer’s securities by the business development company, was not in bankruptcy proceedings but was unable to meet its obligations as they came due without material assistance other than conventional lending or financing arrangements;" ;
  fro-usc:hasId "idd04d11a5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–54/a/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd04d11a6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-2-6> ;
  fro-usc:hasContentText "securities of eligible portfolio companies purchased from any person in transactions not involving any public offering, if there is no ready market for such securities and if immediately prior to such purchase the business development company owns at least 60 per centum of the outstanding equity securities of such issuer (giving effect to all securities presently convertible into or exchangeable for equity securities of such issuer as if such securities were so converted or exchanged);" ;
  fro-usc:hasId "idd04d11a6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–54/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd04d11a7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-2-7> ;
  fro-usc:hasContentText "securities received in exchange for or distributed on or with respect to securities described in paragraphs (1) through (4) of this subsection, or pursuant to the exercise of options, warrants, or rights relating to securities described in such paragraphs;" ;
  fro-usc:hasId "idd04d11a7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–54/a/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd04d11a8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-2-8> ;
  fro-usc:hasContentText "cash, cash items, Government securities, or high quality debt securities maturing in one year or less from the time of investment in such high quality debt securities; and" ;
  fro-usc:hasId "idd04d11a8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–54/a/6" ;
  fro-usc:hasNumberText "(6)" ;
.
usc-t15-ch2D:idd04d11a9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-2-9> ;
  fro-usc:hasContentText "office furniture and equipment, interests in real estate and leasehold improvements and facilities maintained to conduct the business operations of the business development company, deferred organization and operating expenses, and other noninvestment assets necessary and appropriate to its operations as a business development company, including notes of indebtedness of directors, officers, employees, and general partners held by a business development company as payment for securities of such company issued in connection with an executive compensation plan described in section 80a–56(j) of this title ." ;
  fro-usc:hasId "idd04d11a9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–54/a/7" ;
  fro-usc:hasNumberText "(7)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–56/j" ;
.
usc-t15-ch2D:idd04d11aa-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-3> ;
  fro-usc:hasContentText "For purposes of this section, the value of a business development company’s assets shall be determined as of the date of the most recent financial statements filed by such company with the Commission pursuant to section 78m of this title , and shall be determined no less frequently than annually." ;
  fro-usc:hasHeading "Valuation of assets" ;
  fro-usc:hasId "idd04d11aa-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–54/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78m" ;
.
usc-t15-ch2D:idd04d11ab-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "idd04d11ab-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/100/181/tVI" ;
  fro-usc:hasReferenceText "/us/pl/104/290/tV" ;
  fro-usc:hasReferenceText "/us/pl/96/477/tI" ;
  fro-usc:hasReferenceText "/us/stat/101/1263" ;
  fro-usc:hasReferenceText "/us/stat/110/3446" ;
  fro-usc:hasReferenceText "/us/stat/94/2278" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , § 626, Dec. 4, 1987 , 101 Stat. 1263 ; Pub. L. 104–290, title V , § 505, Oct. 11, 1996 , 110 Stat. 3446 .) , title I, § 55, as added Pub. L. 96–477, title I , § 105, Oct. 21, 1980 , 94 Stat. 2278 ; amended Pub. L. 100–181, title VI" ;
.
usc-t15-ch2D:idd04d11ad-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd04d11ad-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Securities Act of 1933, referred to in subsec. (a)(1), is act May 27, 1933, ch. 38, title I , 48 Stat. 74 , as amended, which is classified generally to subchapter I (§ 77a et seq.) of chapter 2A of this title. For complete classification of this Act to the Code, see section 77a of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1933-05-27/ch38/tI" ;
  fro-usc:hasReferenceText "/us/stat/48/74" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
.
usc-t15-ch2D:idd04d11ae-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-56-5-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04d11ae-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1987—Subsec. (a)(1)(B). Pub. L. 100–181 substituted “described in section” for “described in sections”." ;
  fro-usc:hasNoteText "1996—Subsec. (a)(1)(A). Pub. L. 104–290 substituted “from any person” for “or from any person” and inserted before semicolon “, or from any other person, subject to such rules and regulations as the Commission may prescribe as necessary or appropriate in the public interest or for the protection of investors”." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
  fro-usc:hasReferenceText "/us/pl/104/290" ;
.
usc-t15-ch2D:idd04d11af-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11b0-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11b1-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 57 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-57> ;
  fro-usc:hasHeading "Qualifications of directors" ;
  fro-usc:hasId "idd04d11af-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–55" ;
  fro-usc:hasNumberText "§ 80a–55." ;
  lkif-mereo:component usc-t15-ch2D:idd04d11b2-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11b0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-57-2> ;
  fro-usc:hasContentText "A majority of a business development company’s directors or general partners shall be persons who are not interested persons of such company." ;
  fro-usc:hasHeading "Non-interested persons" ;
  fro-usc:hasId "idd04d11b0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–55/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd04d11b1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-57-3> ;
  fro-usc:hasContentText "If, by reason of the death, disqualification, or bona fide resignation of any director or general partner, a business development company does not meet the requirements of subsection (a) of this section, or the requirements of section 80a–15(f)(1) of this title with respect to directors, the operation of such provisions shall be suspended for a period of 90 days or for such longer period as the Commission may prescribe, upon its own motion or by order upon application, as not inconsistent with the protection of investors." ;
  fro-usc:hasHeading "Vacancies; suspension of provisions" ;
  fro-usc:hasId "idd04d11b1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–55/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–15/f/1" ;
.
usc-t15-ch2D:idd04d11b2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "idd04d11b2-0c74-11e6-aa53-e455a13f2ad9" ;
