  fro-usc:hasHeading "Commission confidentiality of reports" ;
  fro-usc:hasId "idd05686fb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–4/b/8" ;
  fro-usc:hasNumberText "(8)" ;
