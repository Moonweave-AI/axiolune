  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 ; Pub. L. 91–547 , § 10, Dec. 14, 1970 , 84 Stat. 1421 ; Pub. L. 85–699, title III , § 317, formerly § 319, Aug. 21, 1958 , as added Pub. L. 92–595 , § 2(g), Oct. 27, 1972 , 86 Stat. 1316 , renumbered § 317, Pub. L. 104–208, div. D, title II , § 208(h)(1)(E), Sept. 30, 1996 , title I, § 18, 54 Stat. 817 , 110 Stat. 3009–747 ; Pub. L. 94–29 , § 28(4), June 4, 1975 , 89 Stat. 165 ; Pub. L. 100–181, title VI , § 613, Dec. 4, 1987 , 101 Stat. 1261 ; Pub. L. 105–353, title III , § 301(c)(4), Nov. 3, 1998 , 112 Stat. 3236 ; Pub. L. 85–699, title III .) , § 307(c), Aug. 21, 1958 , 72 Stat. 694" ;
.
usc-t15-ch2D:idd045e5dd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-20-14-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd045e5dd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Small Business Investment Act of 1958, referred to in subsec. (k), is Pub. L. 85–699 , Aug. 21, 1958 , 72 Stat. 689 , as amended, which is classified principally to chapter 14B (§ 661 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 661 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/85/699" ;
  fro-usc:hasReferenceText "/us/stat/72/689" ;
  fro-usc:hasReferenceText "/us/usc/t15/s661" ;
.
usc-t15-ch2D:idd045e5de-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-20-14-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd045e5de-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1958—Subsec. (k). Pub. L. 85–699 added subsec. (k)." ;
  fro-usc:hasNoteText "1970—Subsec. (f)(2). Pub. L. 91–547 substituted “That (A)” and “or (B) the” for “(A) That” and “or (B) that the” and inserted provision for purpose of insuring fair and equitable treatment of the holders of the outstanding voting securities of each class or series of stock of such company, that the Commission may by rule, regulation, or order direct that any matter required to be submitted to the holders of the outstanding voting securities of such company shall not be deemed to have been effectively acted upon unless approved by the holders of such percentage (not exceeding a majority) of the outstanding voting securities of each class or series of stock affected by such matter as shall be prescribed in such rule, regulation, or order." ;
  fro-usc:hasNoteText "1972—Subsec. (k). Section 319 of Pub. L. 85–699 , as added by Pub. L. 92–595 , inserted provision that subsec. (a)(2) shall not apply to companies operating under the Small Business Investment Act of 1958, so long as such class of senior security shall be held or guaranteed by the Small Business Administration." ;
  fro-usc:hasNoteText "1975—Subsec. (i). Pub. L. 94–29 substituted “ section 80a–16(c) of this title ” for “ section 80a–16(b) of this title ”." ;
  fro-usc:hasNoteText "1987—Subsec. (e). Pub. L. 100–181 redesignated pars. (2) and (3) as (1) and (2), respectively, and struck out former par. (1) which read as follows: “pursuant to any firm contract to purchase or sell entered into prior to March 15, 1940 ;”." ;
  fro-usc:hasNoteText "1998—Subsec. (e)(2). Pub. L. 105–353 substituted “paragraph (1) of this subsection” for “subsection (e)(2) of this section” in introductory provisions." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
  fro-usc:hasReferenceText "/us/pl/105/353" ;
  fro-usc:hasReferenceText "/us/pl/85/699" ;
  fro-usc:hasReferenceText "/us/pl/85/699/s319" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
  fro-usc:hasReferenceText "/us/pl/92/595" ;
  fro-usc:hasReferenceText "/us/pl/94/29" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–16/b" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–16/c" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd0437490-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd045e5df-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
