usc-t15-ch2D:idd03eb991-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-2-3> ;
  fro-usc:hasContentText "offer for sale, sell, or deliver after sale, by the use of the mails or any means or instrumentality of interstate commerce, any security or any interest in a security, whether the issuer of such security is such investment company or another person; or offer for sale, sell, or deliver after sale any such security or interest, having reason to believe that such security or interest will be made the subject of a public offering by use of the mails or any means or instrumentality of interstate commerce;" ;
  fro-usc:hasId "idd03eb991-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd03eb992-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-2-4> ;
  fro-usc:hasContentText "purchase, redeem, retire, or otherwise acquire or attempt to acquire, by use of the mails or any means or instrumentality of interstate commerce, any security or any interest in a security, whether the issuer of such security is such investment company or another person;" ;
  fro-usc:hasId "idd03eb992-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd03eb993-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-2-5> ;
  fro-usc:hasContentText "control any investment company which does any of the acts enumerated in paragraphs (1) and (2) of this subsection;" ;
  fro-usc:hasId "idd03eb993-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd03eb994-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-2-6> ;
  fro-usc:hasContentText "engage in any business in interstate commerce; or" ;
  fro-usc:hasId "idd03eb994-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd03eb995-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-9-2-7> ;
  fro-usc:hasContentText "control any company which is engaged in any business in interstate commerce." ;
  fro-usc:hasId "idd03eb995-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–7/a/5" ;
  fro-usc:hasNumberText "(5)" ;
.
