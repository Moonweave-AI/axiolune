usc-t15-ch2D:idd04aa0e7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-2-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd04aa0e7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–34/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-36-2-2-2> ;
  lkif-mereo:component usc-t15-ch2D:idd04aa0e8-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa0e9-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04aa0ea-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04aa0e8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-2-2-3> ;
  fro-usc:hasContentText "has been guaranteed, sponsored, recommended, or approved by the United States, or any agency, instrumentality or officer of the United States;" ;
  fro-usc:hasId "idd04aa0e8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–34/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04aa0e9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-2-2-4> ;
  fro-usc:hasContentText "has been insured by the Federal Deposit Insurance Corporation; or" ;
  fro-usc:hasId "idd04aa0e9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–34/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04aa0ea-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-2-2-5> ;
  fro-usc:hasContentText "is guaranteed by or is otherwise an obligation of any bank or insured depository institution." ;
  fro-usc:hasId "idd04aa0ea-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–34/a/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd04aa0eb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-2-3> ;
  fro-usc:hasContentText "Any person issuing or selling the securities of a registered investment company that is advised by, or sold through, a bank shall prominently disclose that an investment in the company is not insured by the Federal Deposit Insurance Corporation or any other government agency. The Commission may, after consultation with and taking into consideration the views of the Federal banking agencies (as defined in section 1813 of title 12 ), adopt rules and regulations, and issue orders, consistent with the protection of investors, prescribing the manner in which the disclosure under this paragraph shall be provided." ;
  fro-usc:hasHeading "Disclosures" ;
  fro-usc:hasId "idd04aa0eb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–34/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813" ;
.
usc-t15-ch2D:idd04aa0ec-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-2-4> ;
  fro-usc:hasContentText "The terms “insured depository institution” and “appropriate Federal banking agency” have the same meanings as given in section 1813 of title 12 ." ;
  fro-usc:hasHeading "Definitions" ;
  fro-usc:hasId "idd04aa0ec-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–34/a/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t12/s1813" ;
.
usc-t15-ch2D:idd04aa0ed-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-3> ;
  fro-usc:hasContentText "It shall be unlawful for any person registered under any section of this subchapter, to represent or imply in any manner whatsoever that such person has been sponsored, recommended, or approved, or that his abilities or qualifications have in any respect been passed upon by the United States or any agency or officer thereof." ;
  fro-usc:hasHeading "Unlawful representation of sponsorship by United States or agency thereof" ;
  fro-usc:hasId "idd04aa0ed-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–34/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04aa0ee-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-4> ;
  fro-usc:hasContentText "No provision of subsection (a) or (b) shall be construed to prohibit a statement that a person or security is registered under this chapter, the Securities Act of 1933 [ 15 U.S.C. 77a et seq.], or the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], if such statement is true in fact and if the effect of such registration is not misrepresented." ;
  fro-usc:hasHeading "Statement of registration under securities provisions" ;
  fro-usc:hasId "idd04aa0ee-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–34/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd04aa0ef-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-5> ;
  fro-usc:hasContentText "It shall be unlawful for any registered investment company to adopt as a part of the name or title of such company, or of any securities of which it is the issuer, any word or words that the Commission finds are materially deceptive or misleading. The Commission is authorized, by rule, regulation, or order, to define such names or titles as are materially deceptive or misleading." ;
  fro-usc:hasHeading "Deceptive or misleading names" ;
  fro-usc:hasId "idd04aa0ef-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–34/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd04aa0f0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "idd04aa0f0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/104/290/tII" ;
  fro-usc:hasReferenceText "/us/pl/106/102/tII" ;
  fro-usc:hasReferenceText "/us/stat/110/3432" ;
  fro-usc:hasReferenceText "/us/stat/113/1398" ;
  fro-usc:hasReferenceText "/us/stat/54/840" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 ; Pub. L. 106–102, title II , § 214, Nov. 12, 1999 , 113 Stat. 1398 .) , title I, § 35, 54 Stat. 840 ; Pub. L. 104–290, title II , § 208, Oct. 11, 1996 , 110 Stat. 3432" ;
.
usc-t15-ch2D:idd04aa0f2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd04aa0f2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Securities Act of 1933, referred to in subsec. (c), is act May 27, 1933, ch. 38, title I , 48 Stat. 74 , which is classified generally to subchapter I (§ 77a et seq.) of chapter 2A of this title. For complete classification of this Act to the Code, see section 77a of this title and Tables." ;
  fro-usc:hasNoteText "The Securities Exchange Act of 1934, referred to in subsec. (c), is act June 6, 1934, ch. 404 , 48 Stat. 881 , which is classified principally to chapter 2B (§ 78a et seq.) of this title. For complete classification of this Act to the Code, see section 78a of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1933-05-27/ch38/tI" ;
  fro-usc:hasReferenceText "/us/act/1934-06-06/ch404" ;
  fro-usc:hasReferenceText "/us/stat/48/74" ;
  fro-usc:hasReferenceText "/us/stat/48/881" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd04aa0f3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-7-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04aa0f3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1996—Subsec. (d). Pub. L. 104–290 inserted heading and amended text generally. Prior to amendment, text read as follows: “It shall be unlawful for any registered investment company hereafter to adopt as a part of the name or title of such company, or of any security of which it is the issuer, any word or words which the Commission finds and by order declares to be deceptive or misleading. The Commission is authorized to bring an action in the proper district court of the United States or United States court of any Territory or other place subject to the jurisdiction of the United States alleging that the name or title of any registered investment company, or of any security which it has issued, is materially deceptive or misleading. If the court finds that the Commission’s allegations in this respect, taking into consideration the history of the investment company and the length of time which it may have used any such name or title, are established, the court shall enjoin such investment company from continuing to use any such name or title.”" ;
  fro-usc:hasNoteText "1999—Subsec. (a). Pub. L. 106–102 inserted heading and amended text of subsec. (a) generally. Prior to amendment, text read as follows: “It shall be unlawful for any person, in issuing or selling any security of which a registered investment company is the issuer, to represent or imply in any manner whatsoever that such security or company has been guaranteed, sponsored, recommended, or approved by the United States or any agency or officer thereof.”" ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/104/290" ;
  fro-usc:hasReferenceText "/us/pl/106/102" ;
.
usc-t15-ch2D:idd04aa0f4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-36-7-2> ;
  fro-usc:hasHeading "Effective Date of 1999 Amendment" ;
  fro-usc:hasId "idd04aa0f4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Amendment by Pub. L. 106–102 effective 18 months after Nov. 12, 1999 , see section 225 of Pub. L. 106–102 , set out as a note under section 77c of this title ." ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/106/102" ;
  fro-usc:hasReferenceText "/us/pl/106/102/s225" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77c" ;
.
usc-t15-ch2D:idd04aa0f5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
