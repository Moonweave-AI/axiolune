usc-t15-ch2D:idd0412acc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-2-2-3> ;
  fro-usc:hasContentText "has willfully violated any provision of the Securities Act of 1933 [ 15 U.S.C. 77a et seq.], the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], subchapter II of this chapter, or this subchapter, or the rules or regulations thereunder;" ;
  fro-usc:hasId "idd0412acc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/1/A/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd0412acd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-2-2-4> ;
  fro-usc:hasContentText "has willfully aided, abetted, counseled, commanded, induced, or procured such a violation by any other person; or" ;
  fro-usc:hasId "idd0412acd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/1/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0412ace-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-2-2-5> ;
  fro-usc:hasContentText "has willfully made or caused to be made in any registration statement, application, or report required to be filed with the Commission under this subchapter, any statement which was, at the time and in the light of the circumstances under which it was made, false or misleading with respect to any material fact, or has omitted to state in any such registration statement, application, or report any material fact which was required to be stated therein;  1" ;
  fro-usc:hasId "idd0412ace-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/1/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
usc-t15-ch2D:idd0412acf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-2-3> ;
  fro-usc:hasHeading "Cease-and-desist proceedings" ;
  fro-usc:hasId "idd0412acf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-11-5-2-3-2> ;
  lkif-mereo:component usc-t15-ch2D:idd0412ad0-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412ad1-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412ad0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-2-3-3> ;
  fro-usc:hasContentText "is violating or has violated any provision of this subchapter, or any rule or regulation issued under this subchapter; or" ;
  fro-usc:hasId "idd0412ad0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/1/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd0412ad1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-2-3-4> ;
  fro-usc:hasContentText "is or was a cause of the violation of any provision of this subchapter, or any rule or regulation issued under this subchapter." ;
  fro-usc:hasId "idd0412ad1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0412ad2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-3> ;
  fro-usc:hasHeading "Maximum amount of penalty" ;
  fro-usc:hasId "idd0412ad2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component usc-t15-ch2D:idd0412ad3-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412ad4-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412ad5-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412ad3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-3-2> ;
  fro-usc:hasContentText "The maximum amount of penalty for each act or omission described in paragraph (1) shall be $5,000 for a natural person or $50,000 for any other person." ;
  fro-usc:hasHeading "First tier" ;
  fro-usc:hasId "idd0412ad3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd0412ad4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-3-3> ;
  fro-usc:hasContentText "Notwithstanding subparagraph (A), the maximum amount of penalty for each such act or omission shall be $50,000 for a natural person or $250,000 for any other person if the act or omission described in paragraph (1) involved fraud, deceit, manipulation, or deliberate or reckless disregard of a regulatory requirement." ;
  fro-usc:hasHeading "Second tier" ;
  fro-usc:hasId "idd0412ad4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd0412ad5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-3-4> ;
  fro-usc:hasHeading "Third tier" ;
  fro-usc:hasId "idd0412ad5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/2/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-11-5-3-4-2> ;
  lkif-mereo:component usc-t15-ch2D:idd0412ad6-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412ad7-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412ad6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-3-4-3> ;
  fro-usc:hasContentText "the act or omission described in paragraph (1) involved fraud, deceit, manipulation, or deliberate or reckless disregard of a regulatory requirement; and" ;
  fro-usc:hasId "idd0412ad6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/2/C/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd0412ad7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-3-4-4> ;
  fro-usc:hasContentText "such act or omission directly or indirectly resulted in substantial losses or created a significant risk of substantial losses to other persons or resulted in substantial pecuniary gain to the person who committed the act or omission." ;
  fro-usc:hasId "idd0412ad7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/2/C/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0412ad8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-4> ;
  fro-usc:hasHeading "Determination of public interest" ;
  fro-usc:hasId "idd0412ad8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-11-5-4-2> ;
  lkif-mereo:component usc-t15-ch2D:idd0412ad9-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412ada-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412adb-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412adc-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412add-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412ade-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412ad9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-4-3> ;
  fro-usc:hasContentText "whether the act or omission for which such penalty is assessed involved fraud, deceit, manipulation, or deliberate or reckless disregard of a regulatory requirement;" ;
  fro-usc:hasId "idd0412ad9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd0412ada-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-4-4> ;
  fro-usc:hasContentText "the harm to other persons resulting either directly or indirectly from such act or omission;" ;
  fro-usc:hasId "idd0412ada-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd0412adb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-4-5> ;
  fro-usc:hasContentText "the extent to which any person was unjustly enriched, taking into account any restitution made to persons injured by such behavior;" ;
  fro-usc:hasId "idd0412adb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd0412adc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-4-6> ;
  fro-usc:hasContentText "whether such person previously has been found by the Commission, another appropriate regulatory agency, or a self-regulatory organization to have violated the Federal securities laws, State securities laws, or the rules of a self-regulatory organization, has been enjoined by a court of competent jurisdiction from violations of such laws or rules, or has been convicted by a court of competent jurisdiction of violations of such laws or of any felony or misdemeanor described in section 80b–3(e)(2) of this title ;" ;
  fro-usc:hasId "idd0412adc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/3/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3/e/2" ;
.
usc-t15-ch2D:idd0412add-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-4-7> ;
  fro-usc:hasContentText "the need to deter such person and other persons from committing such acts or omissions; and" ;
  fro-usc:hasId "idd0412add-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/3/E" ;
  fro-usc:hasNumberText "(E)" ;
.
usc-t15-ch2D:idd0412ade-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-4-8> ;
  fro-usc:hasContentText "such other matters as justice may require." ;
  fro-usc:hasId "idd0412ade-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/3/F" ;
  fro-usc:hasNumberText "(F)" ;
.
usc-t15-ch2D:idd0412adf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-5> ;
  fro-usc:hasContentText "In any proceeding in which the Commission may impose a penalty under this section, a respondent may present evidence of the respondent’s ability to pay such penalty. The Commission may, in its discretion, consider such evidence in determining whether such penalty is in the public interest. Such evidence may relate to the extent of such person’s ability to continue in business and the collectability of a penalty, taking into account any other claims of the United States or third parties upon such person’s assets and the amount of such person’s assets." ;
  fro-usc:hasHeading "Evidence concerning ability to pay" ;
  fro-usc:hasId "idd0412adf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd0412ae0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-6> ;
  fro-usc:hasContentText "In any proceeding in which the Commission may impose a penalty under this section, the Commission may enter an order requiring accounting and disgorgement, including reasonable interest. The Commission is authorized to adopt rules, regulations, and orders concerning payments to investors, rates of interest, periods of accrual, and such other matters as it deems appropriate to implement this subsection." ;
  fro-usc:hasHeading "Authority to enter order requiring accounting and disgorgement" ;
  fro-usc:hasId "idd0412ae0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/e" ;
  fro-usc:hasNumberText "(e)" ;
.
usc-t15-ch2D:idd0412ae1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ae2-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ae3-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ae4-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ae7-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412aee-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7> ;
  fro-usc:hasHeading "Cease-and-desist proceedings" ;
  fro-usc:hasId "idd0412ae1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f" ;
  fro-usc:hasNumberText "(f)" ;
.
usc-t15-ch2D:idd0412ae2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-2> ;
  fro-usc:hasContentText "If the Commission finds, after notice and opportunity for hearing, that any person is violating, has violated, or is about to violate any provision of this subchapter, or any rule or regulation thereunder, the Commission may publish its findings and enter an order requiring such person, and any other person that is, was, or would be a cause of the violation, due to an act or omission the person knew or should have known would contribute to such violation, to cease and desist from committing or causing such violation and any future violation of the same provision, rule, or regulation. Such order may, in addition to requiring a person to cease and desist from committing or causing a violation, require such person to comply, or to take steps to effect compliance, with such provision, rule, or regulation, upon such terms and conditions and within such time as the Commission may specify in such order. Any such order may, as the Commission deems appropriate, require future compliance or steps to effect future compliance, either permanently or for such period of time as the Commission may specify, with such provision, rule, or regulation with respect to any security, any issuer, or any other person." ;
  fro-usc:hasHeading "Authority of Commission" ;
  fro-usc:hasId "idd0412ae2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0412ae3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-3> ;
  fro-usc:hasContentText "The notice instituting proceedings pursuant to paragraph (1) shall fix a hearing date not earlier than 30 days nor later than 60 days after service of the notice unless an earlier or a later date is set by the Commission with the consent of any respondent so served." ;
  fro-usc:hasHeading "Hearing" ;
  fro-usc:hasId "idd0412ae3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0412ae4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-4> ;
  fro-usc:hasHeading "Temporary order" ;
  fro-usc:hasId "idd0412ae4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/3" ;
  fro-usc:hasNumberText "(3)" ;
  lkif-mereo:component usc-t15-ch2D:idd0412ae5-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412ae6-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412ae5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-4-2> ;
  fro-usc:hasContentText "Whenever the Commission determines that the alleged violation or threatened violation specified in the notice instituting proceedings pursuant to paragraph (1), or the continuation thereof, is likely to result in significant dissipation or conversion of assets, significant harm to investors, or substantial harm to the public interest, including, but not limited to, losses to the Securities Investor Protection Corporation, prior to the completion of the proceeding, the Commission may enter a temporary order requiring the respondent to cease and desist from the violation or threatened violation and to take such action to prevent the violation or threatened violation and to prevent dissipation or conversion of assets, significant harm to investors, or substantial harm to the public interest as the Commission deems appropriate pending completion of such proceedings. Such an order shall be entered only after notice and opportunity for a hearing, unless the Commission, notwithstanding section 80a–39(a) of this title , determines that notice and hearing prior to entry would be impracticable or contrary to the public interest. A temporary order shall become effective upon service upon the respondent and, unless set aside, limited, or suspended by the Commission or a court of competent jurisdiction, shall remain effective and enforceable pending the completion of the proceedings." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd0412ae5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/3/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–39/a" ;
.
usc-t15-ch2D:idd0412ae6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-4-3> ;
  fro-usc:hasContentText "This paragraph shall apply only to a respondent that acts, or, at the time of the alleged misconduct acted, as a broker, dealer, investment adviser, investment company, municipal securities dealer, government securities broker, government securities dealer, or transfer agent, or is, or was at the time of the alleged misconduct, an associated person of, or a person seeking to become associated with, any of the foregoing." ;
  fro-usc:hasHeading "Applicability" ;
  fro-usc:hasId "idd0412ae6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/3/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd0412ae7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-5> ;
  fro-usc:hasHeading "Review of temporary orders" ;
  fro-usc:hasId "idd0412ae7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/4" ;
  fro-usc:hasNumberText "(4)" ;
  lkif-mereo:component usc-t15-ch2D:idd0412ae8-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412ae9-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412aec-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412aed-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412ae8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-5-2> ;
  fro-usc:hasContentText "At any time after the respondent has been served with a temporary cease-and-desist order pursuant to paragraph (3), the respondent may apply to the Commission to have the order set aside, limited, or suspended. If the respondent has been served with a temporary cease-and-desist order entered without a prior Commission hearing, the respondent may, within 10 days after the date on which the order was served, request a hearing on such application and the Commission shall hold a hearing and render a decision on such application at the earliest possible time." ;
  fro-usc:hasHeading "Commission review" ;
  fro-usc:hasId "idd0412ae8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd0412ae9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-5-3> ;
  fro-usc:hasHeading "Judicial review" ;
  fro-usc:hasId "idd0412ae9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/4/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-11-7-5-3-2> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-11-7-5-3-5> ;
  lkif-mereo:component usc-t15-ch2D:idd0412aea-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412aeb-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412aea-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-5-3-3> ;
  fro-usc:hasContentText "10 days after the date the respondent was served with a temporary cease-and-desist order entered with a prior Commission hearing, or" ;
  fro-usc:hasId "idd0412aea-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/4/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd0412aeb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-5-3-4> ;
  fro-usc:hasContentText "10 days after the Commission renders a decision on an application and hearing under subparagraph (A), with respect to any temporary cease-and-desist order entered without a prior Commission hearing," ;
  fro-usc:hasId "idd0412aeb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/4/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0412aec-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-5-4> ;
  fro-usc:hasContentText "The commencement of proceedings under subparagraph (B) of this paragraph shall not, unless specifically ordered by the court, operate as a stay of the Commission’s order." ;
  fro-usc:hasHeading "No automatic stay of temporary order" ;
  fro-usc:hasId "idd0412aec-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/4/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd0412aed-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-5-5> ;
  fro-usc:hasContentText "Section 80a–42 of this title shall not apply to a temporary order entered pursuant to this section." ;
  fro-usc:hasHeading "Exclusive review" ;
  fro-usc:hasId "idd0412aed-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/4/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–42" ;
.
usc-t15-ch2D:idd0412aee-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-7-6> ;
  fro-usc:hasContentText "In any cease-and-desist proceeding under subsection (f)(1), the Commission may enter an order requiring accounting and disgorgement, including reasonable interest. The Commission is authorized to adopt rules, regulations, and orders concerning payments to investors, rates of interest, periods of accrual, and such other matters as it deems appropriate to implement this subsection." ;
  fro-usc:hasHeading "Authority to enter order requiring accounting and disgorgement" ;
  fro-usc:hasId "idd0412aee-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/f/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd0412aef-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-8> ;
  fro-usc:hasContentText "For the purposes of this section, the term “investment adviser” includes a corporate or other trustee performing the functions of an investment adviser." ;
  fro-usc:hasHeading "Corporate or other trustees performing functions of investment advisers" ;
  fro-usc:hasId "idd0412aef-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/g" ;
  fro-usc:hasNumberText "(g)" ;
.
