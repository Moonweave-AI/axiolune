usc-t15-ch2D:idd043745d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-6-0> ;
  fro-usc:hasHeading "Amendment of Section" ;
  fro-usc:hasId "idd043745d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For termination of amendment by section 12 of Pub. L. 110–174 , see Termination Date of 2007 Amendment note below." ;
  fro-usc:hasNoteText "For termination of subsection (c)(1)(B) of this section, see section 8551(a) of Title 22 , Foreign Relations and Intercourse." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/110/174/s12" ;
  fro-usc:hasReferenceText "/us/usc/t22/s8551/a" ;
.
usc-t15-ch2D:idd043745e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-6-1> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd043745e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Section 3(d) of the Sudan Accountability and Divestment Act of 2007, referred to in subsec. (c)(1)(A), is section 3(d) of Pub. L. 110–174 , which is set out in a note under section 1701 of Title 50 , War and National Defense." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/110/174/s3/d" ;
  fro-usc:hasReferenceText "/us/usc/t50/s1701" ;
.
usc-t15-ch2D:idd043745f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-15-6-2> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd043745f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1970—Subsec. (a)(3). Pub. L. 91–547 , § 3(d), prohibited deviation from any investment policy which is changeable only if authorized by shareholder vote, substituted “section 8(b)(3)” for “section 8(b)(2)”, and in the latter deviation provision struck out “fundamental” before “policy”." ;
  fro-usc:hasNoteText "1975—Subsec. (b). Pub. L. 94–29 substituted “ section 80a–16(c) of this title ” for “subsection (b) of section 80a–16 of this title ”." ;
  fro-usc:hasNoteText "2007—Subsec. (c). Pub. L. 110–174 , §§ 4(a), 12, temporarily added subsec. (c). See Termination Date of 2007 Amendment note below." ;
  fro-usc:hasNoteText "2010—Subsec. (c)(1). Pub. L. 111–195 , § 203(a), amended par. (1) generally. Prior to amendment, text read as follows: “Notwithstanding any other provision of Federal or State law, no person may bring any civil, criminal, or administrative action against any registered investment company, or any employee, officer, director, or investment adviser thereof, based solely upon the investment company divesting from, or avoiding investing in, securities issued by persons that the investment company determines, using credible information that is available to the public, conduct or have direct investments in business operations in Sudan described in section 3(d) of the Sudan Accountability and Divestment Act of 2007.”" ;
  fro-usc:hasNoteText "Subsec. (b). Pub. L. 91–547 , § 2(b), substituted reference to “paragraph (42)” for “paragraph (40)”." ;
  fro-usc:hasNoteText "Subsec. (c)(2)(A). Pub. L. 111–195 , § 205(b)(1), amended subpar. (A) generally. Prior to amendment, text read as follows: “Paragraph (1) does not prevent a person from bringing an action based on a breach of a fiduciary duty owed to that person with respect to a divestment or non-investment decision, other than as described in paragraph (1).”" ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/110/174" ;
  fro-usc:hasReferenceText "/us/pl/111/195" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
  fro-usc:hasReferenceText "/us/pl/94/29" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–16" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–16/c" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd043748d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd0437490-0c74-11e6-aa53-e455a13f2ad9 ;
.
