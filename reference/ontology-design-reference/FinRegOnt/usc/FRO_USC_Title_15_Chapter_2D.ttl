.
usc-t15-ch2D:idd0568723-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-2-3> ;
  fro-usc:hasContentText "provides for compensation to the investment adviser on the basis of a share of capital gains upon or capital appreciation of the funds or any portion of the funds of the client;" ;
  fro-usc:hasId "idd0568723-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0568724-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-2-4> ;
  fro-usc:hasContentText "fails to provide, in substance, that no assignment of such contract shall be made by the investment adviser without the consent of the other party to the contract; or" ;
  fro-usc:hasId "idd0568724-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0568725-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-8-2-5> ;
  fro-usc:hasContentText "fails to provide, in substance, that the investment adviser, if a partnership, will notify the other party to the contract of any change in the membership of such partnership within a reasonable time after such change." ;
  fro-usc:hasId "idd0568725-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–5/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0568726-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0568727-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0568728-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd056872b-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd056872c-0c74-11e6-aa53-e455a13f2ad9 ;
