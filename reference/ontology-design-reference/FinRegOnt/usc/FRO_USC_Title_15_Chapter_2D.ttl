  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2> ;
  fro-usc:hasHeading "Exceptions for business development company" ;
  fro-usc:hasId "idd04d11f9-0c74-11e6-aa53-e455a13f2ad9" ;
