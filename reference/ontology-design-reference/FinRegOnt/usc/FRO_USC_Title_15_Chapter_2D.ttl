  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f8a3-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16> ;
  fro-usc:hasHeading "Rules, regulations, and orders of Commission" ;
  fro-usc:hasId "idd058f88c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11" ;
  fro-usc:hasNumberText "§ 80b–11." ;
  lkif-mereo:component usc-t15-ch2D:idd058f89d-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd058f88d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-2> ;
  fro-usc:hasContentText "The Commission shall have authority from time to time to make, issue, amend, and rescind such rules and regulations and such orders as are necessary or appropriate to the exercise of the functions and powers conferred upon the Commission elsewhere in this subchapter, including rules and regulations defining technical, trade, and other terms used in this subchapter, except that the Commission may not define the term “client” for purposes of paragraphs (1) and (2) of section 80b–6 of this title to include an investor in a private fund managed by an investment adviser, if such private fund has entered into an advisory contract with such adviser. For the purposes of its rules or regulations the Commission may classify persons and matters within its jurisdiction and prescribe different requirements for different classes of persons or matters." ;
  fro-usc:hasHeading "Power of Commission" ;
  fro-usc:hasId "idd058f88d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–6" ;
.
usc-t15-ch2D:idd058f88e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-3> ;
  fro-usc:hasContentText "Subject to the provisions of chapter 15 of title 44 and regulations prescribed under the authority thereof, the rules and regulations of the Commission under this subchapter, and amendments thereof, shall be effective upon publication in the manner which the Commission shall prescribe, or upon such later date as may be provided in such rules and regulations." ;
  fro-usc:hasHeading "Effective date of regulations" ;
  fro-usc:hasId "idd058f88e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd058f88f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-4> ;
  fro-usc:hasContentText "Orders of the Commission under this subchapter shall be issued only after appropriate notice and opportunity for hearing. Notice to the parties to a proceeding before the Commission shall be given by personal service upon each party or by registered mail or certified mail or confirmed telegraphic notice to the party’s last known business address. Notice to interested persons, if any, other than parties may be given in the same manner or by publication in the Federal Register." ;
  fro-usc:hasHeading "Orders of Commission after notice and hearing; type of notice" ;
  fro-usc:hasId "idd058f88f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd058f890-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-5> ;
  fro-usc:hasContentText "No provision of this subchapter imposing any liability shall apply to any act done or omitted in good faith in conformity with any rule, regulation, or order of the Commission, notwithstanding that such rule, regulation, or order may, after such act or omission, be amended or rescinded or be determined by judicial or other authority to be invalid for any reason." ;
  fro-usc:hasHeading "Good faith compliance with rules and regulations" ;
  fro-usc:hasId "idd058f890-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd058f891-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-6> ;
  fro-usc:hasContentText "The Commission and the Commodity Futures Trading Commission shall, after consultation with the Council but not later than 12 months after July 21, 2010 , jointly promulgate rules to establish the form and content of the reports required to be filed with the Commission under subsection  1 80b–4(b) of this title and with the Commodity Futures Trading Commission by investment advisers that are registered both under this subchapter and the Commodity Exchange Act [ 7 U.S.C. 1 et seq.]." ;
  fro-usc:hasHeading "Disclosure rules on private funds" ;
  fro-usc:hasId "idd058f891-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
usc-t15-ch2D:idd058f892-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f893-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f894-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-7> ;
  fro-usc:hasHeading "Standard of conduct" ;
  fro-usc:hasHeading " " ;
  fro-usc:hasId "idd058f892-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/g" ;
  fro-usc:hasNumberText "(g)" ;
.
usc-t15-ch2D:idd058f893-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-7-2> ;
  fro-usc:hasContentText "The Commission may promulgate rules to provide that the standard of conduct for all brokers, dealers, and investment advisers, when providing personalized investment advice about securities to retail customers (and such other customers as the Commission may by rule provide), shall be to act in the best interest of the customer without regard to the financial or other interest of the broker, dealer, or investment adviser providing the advice. In accordance with such rules, any material conflicts of interest shall be disclosed and may be consented to by the customer. Such rules shall provide that such standard of conduct shall be no less stringent than the standard applicable to investment advisers under section 80b–6(1) and (2) of this title when providing personalized investment advice about securities, except the Commission shall not ascribe a meaning to the term “customer” that would include an investor in a private fund managed by an investment adviser, where such private fund has entered into an advisory contract with such adviser. The receipt of compensation based on commission or fees shall not, in and of itself, be considered a violation of such standard applied to a broker, dealer, or investment adviser." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd058f893-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/g/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd058f894-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-7-3> ;
  fro-usc:hasHeading "Retail customer defined" ;
  fro-usc:hasId "idd058f894-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/g/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-16-7-3-2> ;
  lkif-mereo:component usc-t15-ch2D:idd058f895-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd058f896-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd058f895-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-7-3-3> ;
  fro-usc:hasContentText "receives personalized investment advice about securities from a broker, dealer, or investment adviser; and" ;
  fro-usc:hasId "idd058f895-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/g/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd058f896-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-7-3-4> ;
  fro-usc:hasContentText "uses such advice primarily for personal, family, or household purposes." ;
  fro-usc:hasId "idd058f896-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/g/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd058f897-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f898-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f899-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-8> ;
  fro-usc:hasHeading "Other matters" ;
  fro-usc:hasId "idd058f897-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/h" ;
  fro-usc:hasNumberText "(h)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-16-8-2> ;
.
usc-t15-ch2D:idd058f898-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-8-3> ;
  fro-usc:hasContentText "facilitate the provision of simple and clear disclosures to investors regarding the terms of their relationships with brokers, dealers, and investment advisers, including any material conflicts of interest; and" ;
  fro-usc:hasId "idd058f898-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/h/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd058f899-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-8-4> ;
  fro-usc:hasContentText "examine and, where appropriate, promulgate rules prohibiting or restricting certain sales practices, conflicts of interest, and compensation schemes for brokers, dealers, and investment advisers that the Commission deems contrary to the public interest and the protection of investors." ;
  fro-usc:hasId "idd058f899-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/h/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd058f89a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f89b-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f89c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-16-9> ;
  fro-usc:hasHeading "Harmonization of enforcement" ;
  fro-usc:hasId "idd058f89a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–11/i" ;
  fro-usc:hasNumberText "(i)" ;
