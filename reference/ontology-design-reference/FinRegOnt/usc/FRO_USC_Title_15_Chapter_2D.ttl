usc-t15-ch2D:idd0412af5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-10-3> ;
