  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-5-2-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd0412acb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/d/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-11-5-2-2-2> ;
  lkif-mereo:component usc-t15-ch2D:idd0412acc-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412acd-0c74-11e6-aa53-e455a13f2ad9 ;
