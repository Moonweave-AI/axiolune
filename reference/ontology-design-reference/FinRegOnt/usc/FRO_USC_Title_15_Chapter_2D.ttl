usc-t15-ch2D:idd045e612-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e613-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e614-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e615-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 25 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd045e61b-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-25> ;
  fro-usc:hasHeading "Closed-end companies" ;
  fro-usc:hasId "idd045e612-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–23" ;
  fro-usc:hasNumberText "§ 80a–23." ;
  lkif-mereo:component usc-t15-ch2D:idd045e619-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd045e613-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-25-2> ;
  fro-usc:hasContentText "No registered closed-end company shall issue any of its securities (1) for services; or (2) for property other than cash or securities (including securities of which such registered company is the issuer), except as a dividend or distribution to its security holders or in connection with a reorganization." ;
  fro-usc:hasHeading "Issuance of securities" ;
  fro-usc:hasId "idd045e613-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–23/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd045e614-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-25-3> ;
  fro-usc:hasContentText "No registered closed-end company shall sell any common stock of which it is the issuer at a price below the current net asset value of such stock, exclusive of any distributing commission or discount (which net asset value shall be determined as of a time within forty-eight hours, excluding Sundays and holidays, next preceding the time of such determination), except (1) in connection with an offering to the holders of one or more classes of its capital stock; (2) with the consent of a majority of its common stockholders; (3) upon conversion of a convertible security in accordance with its terms; (4) upon the exercise of any warrant outstanding on August 22, 1940 , or issued in accordance with the provisions of section 80a–18(d) of this title ; or (5) under such other circumstances as the Commission may permit by rules and regulations or orders for the protection of investors." ;
  fro-usc:hasHeading "Sale of common stock at price below current net asset value" ;
  fro-usc:hasId "idd045e614-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–23/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–18/d" ;
.
usc-t15-ch2D:idd045e615-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e616-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e617-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd045e618-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-25-4> ;
  fro-usc:hasHeading "Purchase of securities of which it is issuer; exceptions" ;
  fro-usc:hasId "idd045e615-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–23/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-25-4-2> ;
.
usc-t15-ch2D:idd045e616-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-25-4-3> ;
  fro-usc:hasContentText "on a securities exchange or such other open market as the Commission may designate by rules and regulations or orders: Provided , That if such securities are stock, such registered company shall, within the preceding six months, have informed stockholders of its intention to purchase stock of such class by letter or report addressed to stockholders of such class; or" ;
  fro-usc:hasId "idd045e616-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–23/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd045e617-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-25-4-4> ;
  fro-usc:hasContentText "pursuant to tenders, after reasonable opportunity to submit tenders given to all holders of securities of the class to be purchased; or" ;
  fro-usc:hasId "idd045e617-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–23/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd045e618-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-25-4-5> ;
  fro-usc:hasContentText "under such other circumstances as the Commission may permit by rules and regulations or orders for the protection of investors in order to insure that such purchases are made in a manner or on a basis which does not unfairly discriminate against any holders of the class or classes of securities to be purchased." ;
  fro-usc:hasId "idd045e618-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–23/c/3" ;
  fro-usc:hasNumberText "(3)" ;
.
