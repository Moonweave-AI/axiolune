  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11bf-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-4> ;
  fro-usc:hasHeading "Exemption orders" ;
  fro-usc:hasId "idd04d11bc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-58-4-2> ;
.
usc-t15-ch2D:idd04d11bd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-4-3> ;
  fro-usc:hasContentText "the terms of the proposed transaction, including the consideration to be paid or received, are reasonable and fair and do not involve overreaching of the business development company or its shareholders or partners on the part of any person concerned;" ;
  fro-usc:hasId "idd04d11bd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04d11be-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-4-4> ;
  fro-usc:hasContentText "the proposed transaction is consistent with the policy of the business development company as recited in the filings made by such company with the Commission under the Securities Act of 1933 [ 15 U.S.C. 77a et seq.], its registration statement and reports filed under the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], and its reports to shareholders or partners; and" ;
  fro-usc:hasId "idd04d11be-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd04d11bf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-4-5> ;
  fro-usc:hasContentText "the proposed transaction is consistent with the general purposes of this subchapter." ;
  fro-usc:hasId "idd04d11bf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/c/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd04d11c0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11c1-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11c2-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11c3-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11c4-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-5> ;
  fro-usc:hasHeading "Transactions involving noncontrolling shareholders or affiliated persons" ;
  fro-usc:hasId "idd04d11c0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-58-5-2> ;
.
usc-t15-ch2D:idd04d11c1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-5-3> ;
  fro-usc:hasContentText "knowingly to sell any security or other property to such business development company or to any company controlled by such business development company, unless such sale involves solely (A) securities of which the buyer is the issuer, or (B) securities of which the seller is the issuer and which are part of a general offering to the holders of a class of its securities;" ;
  fro-usc:hasId "idd04d11c1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04d11c2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-5-4> ;
  fro-usc:hasContentText "knowingly to purchase from such business development company or from any company controlled by such business development company, any security or other property (except securities of which the seller is the issuer);" ;
  fro-usc:hasId "idd04d11c2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04d11c3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-5-5> ;
  fro-usc:hasContentText "knowingly to borrow money or other property from such business development company or from any company controlled by such business development company (unless the borrower is controlled by the lender), except as permitted in section 80a–21(b) of this title ; or" ;
  fro-usc:hasId "idd04d11c3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/d/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–21/b" ;
.
usc-t15-ch2D:idd04d11c4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-5-6> ;
  fro-usc:hasContentText "knowingly to effect any transaction in which such business development company or a company controlled by such business development company is a joint or a joint and several participant with such affiliated person in contravention of such rules and regulations as the Commission may prescribe for the purpose of limiting or preventing participation by such business development company or controlled company on a basis less advantageous than that of such affiliated person, except that nothing contained in this paragraph shall be deemed to preclude any person from acting as manager of any underwriting syndicate or other group in which such business development company or controlled company is a participant and receiving compensation therefor." ;
  fro-usc:hasId "idd04d11c4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/d/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd04d11c5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11c6-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11c7-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-6> ;
  fro-usc:hasHeading "Noncontrolling shareholders or affiliated persons; executive officer" ;
  fro-usc:hasId "idd04d11c5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-58-6-2> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-58-6-5> ;
.
usc-t15-ch2D:idd04d11c6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-6-3> ;
  fro-usc:hasContentText "Any person (A) who is, within the meaning of section 80a–2(a)(3)(A) of this title , an affiliated person of a business development company, (B) who is an executive officer or a director of, or general partner in, any such affiliated person, or (C) who directly or indirectly either controls, is controlled by, or is under common control with, such affiliated person." ;
  fro-usc:hasId "idd04d11c6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/e/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–2/a/3/A" ;
.
usc-t15-ch2D:idd04d11c7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-6-4> ;
  fro-usc:hasContentText "Any person who is an affiliated person of a director, officer, employee, investment adviser, member of an advisory board or promoter of, principal underwriter for, general partner in, or an affiliated person of any person directly or indirectly either controlling or under common control with a business development company (except the business development company itself and any person who, if it were not directly or indirectly controlled by the business development company, would not be directly or indirectly under the control of a person who controls the business development company)." ;
  fro-usc:hasId "idd04d11c7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04d11c8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11c9-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11ca-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11cb-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-7> ;
  fro-usc:hasHeading "Approval of proposed transactions" ;
  fro-usc:hasId "idd04d11c8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/f" ;
  fro-usc:hasNumberText "(f)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-58-7-2> ;
.
usc-t15-ch2D:idd04d11c9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-7-3> ;
  fro-usc:hasContentText "the terms thereof, including the consideration to be paid or received, are reasonable and fair to the shareholders or partners of the business development company and do not involve overreaching of such company or its shareholders or partners on the part of any person concerned;" ;
  fro-usc:hasId "idd04d11c9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/f/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04d11ca-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-7-4> ;
  fro-usc:hasContentText "the proposed transaction is consistent with the interests of the shareholders or partners of the business development company and is consistent with the policy of such company as recited in filings made by such company with the Commission under the Securities Act of 1933 [ 15 U.S.C. 77a et seq.], its registration statement and reports filed under the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], and its reports to shareholders or partners; and" ;
  fro-usc:hasId "idd04d11ca-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/f/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd04d11cb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-7-5> ;
  fro-usc:hasContentText "the directors or general partners record in their minutes and preserve in their records, for such periods as if such records were required to be maintained pursuant to section 80a–30(a) of this title , a description of such transaction, their findings, the information or materials upon which their findings were based, and the basis therefor." ;
  fro-usc:hasId "idd04d11cb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/f/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–30/a" ;
.
usc-t15-ch2D:idd04d11cc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-8> ;
  fro-usc:hasContentText "Notwithstanding subsection (a) or (d), a person may, in the ordinary course of business, sell to or purchase from any company merchandise or may enter into a lessor-lessee relationship with any person and furnish the services incident thereto." ;
  fro-usc:hasHeading "Transactions in the ordinary course of business" ;
  fro-usc:hasId "idd04d11cc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/g" ;
  fro-usc:hasNumberText "(g)" ;
.
usc-t15-ch2D:idd04d11cd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-9> ;
  fro-usc:hasContentText "The directors of or general partners in any business development company shall adopt, and periodically review and update as appropriate, procedures reasonably designed to ensure that reasonable inquiry is made, prior to the consummation of any transaction in which such business development company or a company controlled by such business development company proposes to participate, with respect to the possible involvement in the transaction of persons described in subsections (b) and (e) of this section." ;
  fro-usc:hasHeading "Inquiry procedures" ;
  fro-usc:hasId "idd04d11cd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/h" ;
  fro-usc:hasNumberText "(h)" ;
.
usc-t15-ch2D:idd04d11ce-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-10> ;
  fro-usc:hasContentText "Until the adoption by the Commission of rules or regulations under subsections (a) and (d) of this section, the rules and regulations of the Commission under subsections (a) and (d) of section 80a–17 of this title applicable to registered closed-end investment companies shall be deemed to apply to transactions subject to subsections (a) and (d) of this section. Any rules or regulations adopted by the Commission to implement this section shall be no more restrictive than the rules or regulations adopted by the Commission under subsections (a) and (d) of section 80a–17 of this title that are applicable to all registered closed-end investment companies." ;
  fro-usc:hasHeading "Rules and regulations of Commission" ;
  fro-usc:hasId "idd04d11ce-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–17" ;
.
usc-t15-ch2D:idd04d11cf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11d0-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11d1-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-11> ;
  fro-usc:hasHeading "Warrants, options, and rights to purchase voting securities; loans to facilitate executive compensation plans" ;
  fro-usc:hasId "idd04d11cf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/j" ;
  fro-usc:hasNumberText "(j)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-58-11-2> ;
.
usc-t15-ch2D:idd04d11d0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-11-3> ;
  fro-usc:hasContentText "acquire warrants, options, and rights to purchase voting securities of such business development company, and securities issued upon the exercise or conversion thereof, pursuant to an executive compensation plan offered by such company which meets the requirements of section 80a–60(a)(3)(B) of this title ; and" ;
  fro-usc:hasId "idd04d11d0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/j/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–60/a/3/B" ;
.
usc-t15-ch2D:idd04d11d1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-11-4> ;
  fro-usc:hasId "idd04d11d1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/j/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-58-11-4-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04d11d2-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11d3-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11d4-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11d5-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11d6-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11d2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-11-4-2> ;
  fro-usc:hasContentText "has a term of not more than ten years;" ;
  fro-usc:hasId "idd04d11d2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/j/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04d11d3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-11-4-3> ;
  fro-usc:hasContentText "becomes due within a reasonable time, not to exceed sixty days, after the termination of such person’s employment or service;" ;
  fro-usc:hasId "idd04d11d3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/j/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04d11d4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-11-4-4> ;
  fro-usc:hasContentText "bears interest at no less than the prevailing rate applicable to 90-day United States Treasury bills at the time the loan is made;" ;
  fro-usc:hasId "idd04d11d4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/j/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd04d11d5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-11-4-5> ;
  fro-usc:hasContentText "at all times is fully collateralized (such collateral may include any securities issued by such business development company); and" ;
  fro-usc:hasId "idd04d11d5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/j/2/D" ;
  fro-usc:hasNumberText "(D)" ;
.
usc-t15-ch2D:idd04d11d6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-11-4-6> ;
  fro-usc:hasId "idd04d11d6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/j/2/E" ;
  fro-usc:hasNumberText "(E)" ;
  lkif-mereo:component usc-t15-ch2D:idd04d11d7-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11d8-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11d7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-11-4-6-1> ;
  fro-usc:hasContentText "in the case of a loan to any officer or employee of such business development company (including any officer or employee who is also a director of such company), is approved by the required majority (as defined in subsection ( o )) of the directors of or general partners in such company on the basis that the loan is in the best interests of such company and its shareholders or partners; or" ;
  fro-usc:hasId "idd04d11d7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/j/2/E/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd04d11d8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-11-4-6-2> ;
  fro-usc:hasContentText "in the case of a loan to any director of such business development company who is not also an officer or employee of such company, or to any general partner in such company, is approved by order of the Commission, upon application, on the basis that the terms of the loan are fair and reasonable and do not involve overreaching of such company or its shareholders or partners." ;
  fro-usc:hasId "idd04d11d8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/j/2/E/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd04d11d9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11da-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11db-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-12> ;
  fro-usc:hasHeading "Restriction on brokerage commissions" ;
  fro-usc:hasId "idd04d11d9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/k" ;
  fro-usc:hasNumberText "(k)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-58-12-2> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-58-12-5> ;
.
usc-t15-ch2D:idd04d11da-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-12-3> ;
  fro-usc:hasContentText "acting as agent, to accept from any source any compensation (other than a regular salary or wages from the business development company) for the purchase or sale of any property to or for such business development company or any controlled company thereof, except in the course of such person’s business as an underwriter or broker; or" ;
  fro-usc:hasId "idd04d11da-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/k/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04d11db-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-12-4> ;
  fro-usc:hasId "idd04d11db-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/k/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-58-12-4-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04d11dc-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11dd-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11de-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11dc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-12-4-2> ;
  fro-usc:hasContentText "the usual and customary broker’s commission if the sale is effected on a securities exchange;" ;
  fro-usc:hasId "idd04d11dc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/k/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04d11dd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-12-4-3> ;
  fro-usc:hasContentText "2 per centum of the sales price if the sale is effected in connection with a secondary distribution of such securities; or" ;
  fro-usc:hasId "idd04d11dd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/k/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04d11de-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-12-4-4> ;
  fro-usc:hasContentText "1 per centum of the purchase or sale price of such securities if the sale is otherwise effected," ;
  fro-usc:hasId "idd04d11de-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/k/2/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd04d11df-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11e0-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11e1-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-13> ;
  fro-usc:hasHeading "Persons subject to brokerage commission restrictions" ;
  fro-usc:hasId "idd04d11df-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/l" ;
  fro-usc:hasNumberText "(l)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-58-13-2> ;
.
usc-t15-ch2D:idd04d11e0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-13-3> ;
  fro-usc:hasContentText "Any affiliated person of a business development company." ;
  fro-usc:hasId "idd04d11e0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/l/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04d11e1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-13-4> ;
  fro-usc:hasId "idd04d11e1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/l/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component usc-t15-ch2D:idd04d11e2-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11e3-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11e4-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11e2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-13-4-1> ;
  fro-usc:hasContentText "Any person who is, within the meaning of section 80a–2(a)(3)(B), (C), or (D) of this title, an affiliated person or any director, officer, employee, or member of an advisory board of the business development company." ;
  fro-usc:hasId "idd04d11e2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/l/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04d11e3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-13-4-2> ;
  fro-usc:hasContentText "Any person who is, within the meaning of section 82a–2(a)(3)(A), (B), (C), or (D) of this title, an affiliated person of any investment adviser of, general partner in, or person directly or indirectly either controlling, controlled by, or under common control with, the business development company." ;
  fro-usc:hasId "idd04d11e3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/l/2/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04d11e4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-13-4-3> ;
  fro-usc:hasContentText "Any person who is, within the meaning of section 80a–2(a)(3)(C) of this title , an affiliated person of any person who is an affiliated person of the business development company within the meaning of section 80a–2(a)(3)(A) of this title ." ;
  fro-usc:hasId "idd04d11e4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/l/2/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–2/a/3/A" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–2/a/3/C" ;
.
usc-t15-ch2D:idd04d11e5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-14> ;
  fro-usc:hasContentText "For purposes of subsections (a) and (d), a person who is a director, officer, or employee of a party to a transaction and who receives his usual and ordinary fee or salary for usual and customary services as a director, officer, or employee from such party shall not be deemed to have a financial interest or to participate in the transaction solely by reason of his receipt of such fee or salary." ;
  fro-usc:hasHeading "Receipt of fee or salary from transaction participant" ;
  fro-usc:hasId "idd04d11e5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/m" ;
  fro-usc:hasNumberText "(m)" ;
.
usc-t15-ch2D:idd04d11e6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11e7-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d11ec-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-15> ;
  fro-usc:hasHeading "Profit-sharing plans" ;
  fro-usc:hasId "idd04d11e6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/n" ;
  fro-usc:hasNumberText "(n)" ;
.
usc-t15-ch2D:idd04d11e7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-15-2> ;
  fro-usc:hasId "idd04d11e7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/n/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-58-15-2-1> ;
  lkif-mereo:component usc-t15-ch2D:idd04d11e8-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11eb-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11e8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-15-2-2> ;
  fro-usc:hasId "idd04d11e8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/n/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  lkif-mereo:component usc-t15-ch2D:idd04d11e9-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd04d11ea-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11e9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-15-2-2-1> ;
  fro-usc:hasContentText "in the case of a profit-sharing plan for officers and employees of the business development company (including any officer or employee who is also a director of such company), such profit-sharing plan is approved by the required majority (as defined in subsection ( o )) of the directors of or general partners in such company on the basis that such plan is reasonable and fair to the shareholders or partners of such company, does not involve overreaching of such company or its shareholders or partners on the part of any person concerned, and is consistent with the interests of the shareholders or partners of such company; or" ;
  fro-usc:hasId "idd04d11e9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/n/1/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd04d11ea-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-15-2-2-2> ;
  fro-usc:hasContentText "in the case of a profit-sharing plan which includes one or more directors of the business development company who are not also officers or employees of such company, or one or more general partners in such company, such profit-sharing plan is approved by order of the Commission, upon application, on the basis that such plan is reasonable and fair to the shareholders or partners of such company, does not involve overreaching of such company or its shareholders or partners on the part of any person concerned, and is consistent with the interests of the shareholders or partners of such company; and" ;
  fro-usc:hasId "idd04d11ea-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/n/1/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd04d11eb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-15-2-3> ;
  fro-usc:hasContentText "the aggregate amount of benefits which would be paid or accrued under such plan shall not exceed 20 per centum of the business development company’s net income after taxes in any fiscal year." ;
  fro-usc:hasId "idd04d11eb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/n/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd04d11ec-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-15-3> ;
  fro-usc:hasContentText "This subsection may not be used where the business development company has outstanding any stock option, warrant, or right issued as part of an executive compensation plan, including a plan pursuant to section 80a–60(a)(3)(B) of this title , or has an investment adviser registered or required to be registered under subchapter II of this chapter." ;
  fro-usc:hasId "idd04d11ec-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/n/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–60/a/3/B" ;
.
usc-t15-ch2D:idd04d11ed-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-16> ;
  fro-usc:hasContentText "The term “required majority”, when used with respect to the approval of a proposed transaction, plan, or arrangement, means both a majority of a business development company’s directors or general partners who have no financial interest in such transaction, plan, or arrangement and a majority of such directors or general partners who are not interested persons of such company." ;
  fro-usc:hasHeading "Required majority for approval of proposed transactions" ;
  fro-usc:hasId "idd04d11ed-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–56/o" ;
  fro-usc:hasNumberText "(o)" ;
.
usc-t15-ch2D:idd04d11ee-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-usc:hasId "idd04d11ee-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/100/181/tVI" ;
  fro-usc:hasReferenceText "/us/pl/96/477/tI" ;
  fro-usc:hasReferenceText "/us/stat/101/1263" ;
  fro-usc:hasReferenceText "/us/stat/94/2280" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , § 627, Dec. 4, 1987 , 101 Stat. 1263 .) , title I, § 57, as added Pub. L. 96–477, title I , § 105, Oct. 21, 1980 , 94 Stat. 2280 ; amended Pub. L. 100–181, title VI" ;
.
usc-t15-ch2D:idd04d11f0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-18-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd04d11f0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Securities Act of 1933, referred to in subsecs. (c)(2) and (f)(2), is act May 27, 1933, ch. 38, title I , 48 Stat. 74 , as amended, which is classified generally to subchapter I (§ 77a et seq.) of chapter 2A of this title. For complete classification of this Act to the Code, see section 77a of this title and Tables." ;
  fro-usc:hasNoteText "The Securities Exchange Act of 1934, referred to in subsecs. (c)(2) and (f)(2), is act June 6, 1934, ch. 404 , 48 Stat. 881 , as amended, which is classified principally to chapter 2B (§ 78a et seq.) of this title. For complete classification of this Act to the Code, see section 78a of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1933-05-27/ch38/tI" ;
  fro-usc:hasReferenceText "/us/act/1934-06-06/ch404" ;
  fro-usc:hasReferenceText "/us/stat/48/74" ;
  fro-usc:hasReferenceText "/us/stat/48/881" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd04d11f1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-58-18-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04d11f1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1987—Subsec. (i). Pub. L. 100–181 substituted “subsections (a) and (d) of section 80a–17 of this title ” for “sections 80a–17(a) and (d) of this title” in two places." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–17" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd0437498-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11f2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 59 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-59> ;
  fro-usc:hasContentText "No business development company shall, unless authorized by the vote of a majority of its outstanding voting securities or partnership interests, change the nature of its business so as to cease to be, or to withdraw its election as, a business development company." ;
  fro-usc:hasHeading "Changes in investment policy" ;
  fro-usc:hasId "idd04d11f2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–57" ;
  fro-usc:hasNumberText "§ 80a–57." ;
  lkif-mereo:component usc-t15-ch2D:idd04d11f3-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11f3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "idd04d11f3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/96/477/tI" ;
  fro-usc:hasReferenceText "/us/stat/94/2285" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title I, § 58, as added Pub. L. 96–477, title I , § 105, Oct. 21, 1980 , 94 Stat. 2285 .)" ;
.
usc-t15-ch2D:idd04d11f4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 60 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-60> ;
  fro-usc:hasContentText "Notwithstanding the exemption set forth in section 80–6(f) of this title , sections 80a–1, 80a–2, 80a–3, 80a–4, 80a–5, 80a–6, 80a–9, 80a–10(f), 80a–15(a), (c), and (f), 80a–16(b), 80a–17(f) through (j), 80a–19(a), 80a–20(b), 80a–31(a) and (c), 80a–32 through 80a–46, and 80a–48 through 80a–52 of this title shall apply to a business development company to the same extent as if it were a registered closed-end investment company." ;
  fro-usc:hasHeading "Incorporation of subchapter provisions" ;
  fro-usc:hasId "idd04d11f4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–58" ;
  fro-usc:hasNumberText "§ 80a–58." ;
  lkif-mereo:component usc-t15-ch2D:idd04d11f5-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11f5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-usc:hasId "idd04d11f5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/96/477/tI" ;
  fro-usc:hasReferenceText "/us/stat/94/2285" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title I, § 59, as added Pub. L. 96–477, title I , § 105, Oct. 21, 1980 , 94 Stat. 2285 .)" ;
.
usc-t15-ch2D:idd04d11f6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 61 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-61> ;
  fro-usc:hasContentText "Notwithstanding the exemption set forth in section 80a–6(f) of this title , section 80a–12 of this title shall apply to a business development company to the same extent as if it were a registered closed-end investment company, except that the Commission shall not prescribe any rule, regulation, or order pursuant to section 80a–12(a)(1) of this title governing the circumstances in which a business development company may borrow from a bank in order to purchase any security." ;
  fro-usc:hasHeading "Functions and activities of business development companies" ;
  fro-usc:hasId "idd04d11f6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–59" ;
  fro-usc:hasNumberText "§ 80a–59." ;
  lkif-mereo:component usc-t15-ch2D:idd04d11f7-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d11f7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
