  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-3-2> ;
  fro-usc:hasContentText "Beneficial ownership by a company shall be deemed to be beneficial ownership by one person, except that, if the company owns 10 per centum or more of the outstanding voting securities of the issuer, and is or, but for the exception provided for in this paragraph or paragraph (7), would be an investment company, the beneficial ownership shall be deemed to be that of the holders of such company’s outstanding securities (other than short-term paper)." ;
  fro-usc:hasId "idd03c7008-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd03c7009-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-3-3> ;
  fro-usc:hasContentText "Beneficial ownership by any person who acquires securities or interests in securities of an issuer described in the first sentence of this paragraph shall be deemed to be beneficial ownership by the person from whom such transfer was made, pursuant to such rules and regulations as the Commission shall prescribe as necessary or appropriate in the public interest and consistent with the protection of investors and the purposes fairly intended by the policy and provisions of this subchapter, where the transfer was caused by legal separation, divorce, death, or other involuntary event." ;
  fro-usc:hasId "idd03c7009-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd03c700a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-4> ;
  fro-usc:hasId "idd03c700a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component usc-t15-ch2D:idd03c700b-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c700c-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c700b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-4-1> ;
  fro-usc:hasContentText "Any person primarily engaged in the business of underwriting and distributing securities issued by other persons, selling securities to customers, acting as broker, and acting as market intermediary, or any one or more of such activities, whose gross income normally is derived principally from such business and related activities." ;
  fro-usc:hasId "idd03c700b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/2/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd03c700c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-4-2> ;
  fro-usc:hasId "idd03c700c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-4-4-4-2-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c700d-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c700e-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c700d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-4-2-2> ;
  fro-usc:hasContentText "the term “market intermediary” means any person that regularly holds itself out as being willing contemporaneously to engage in, and that is regularly engaged in, the business of entering into transactions on both sides of the market for a financial contract or one or more such financial contracts; and" ;
  fro-usc:hasId "idd03c700d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/2/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd03c700e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-4-2-3> ;
  fro-usc:hasId "idd03c700e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/2/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-4-4-4-2-3-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c700f-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c7010-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c7011-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c700f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-4-2-3-2> ;
  fro-usc:hasContentText "takes the form of an individually negotiated contract, agreement, or option to buy, sell, lend, swap, or repurchase, or other similar individually negotiated transaction commonly entered into by participants in the financial markets;" ;
  fro-usc:hasId "idd03c700f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/2/B/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
usc-t15-ch2D:idd03c7010-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-4-2-3-3> ;
  fro-usc:hasContentText "is in respect of securities, commodities, currencies, interest or other rates, other measures of value, or any other financial or economic interest similar in purpose or function to any of the foregoing; and" ;
  fro-usc:hasId "idd03c7010-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/2/B/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
usc-t15-ch2D:idd03c7011-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-4-2-3-4> ;
  fro-usc:hasContentText "is entered into in response to a request from a counter party for a quotation, or is otherwise entered into and structured to accommodate the objectives of the counter party to such arrangement." ;
  fro-usc:hasId "idd03c7011-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/2/B/ii/III" ;
  fro-usc:hasNumberText "(III)" ;
.
usc-t15-ch2D:idd03c7012-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-5> ;
  fro-usc:hasId "idd03c7012-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-4-4-5-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c7013-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c7014-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c7017-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c7013-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-5-2> ;
  fro-usc:hasContentText "such fund is employed by the bank solely as an aid to the administration of trusts, estates, or other accounts created and maintained for a fiduciary purpose;" ;
  fro-usc:hasId "idd03c7013-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/3/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd03c7014-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-5-3> ;
  fro-usc:hasId "idd03c7014-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/3/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-4-4-5-3-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c7015-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c7016-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c7015-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-5-3-2> ;
  fro-usc:hasContentText "advertised; or" ;
  fro-usc:hasId "idd03c7015-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/3/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd03c7016-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-5-3-3> ;
  fro-usc:hasContentText "offered for sale to the general public; and" ;
  fro-usc:hasId "idd03c7016-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/3/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd03c7017-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-5-4> ;
  fro-usc:hasContentText "fees and expenses charged by such fund are not in contravention of fiduciary principles established under applicable Federal or State law." ;
  fro-usc:hasId "idd03c7017-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/3/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd03c7018-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-6> ;
  fro-usc:hasContentText "Any person substantially all of whose business is confined to making small loans, industrial banking, or similar businesses." ;
  fro-usc:hasId "idd03c7018-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd03c7019-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-7> ;
  fro-usc:hasContentText "Any person who is not engaged in the business of issuing redeemable securities, face-amount certificates of the installment type or periodic payment plan certificates, and who is primarily engaged in one or more of the following businesses: (A) Purchasing or otherwise acquiring notes, drafts, acceptances, open accounts receivable, and other obligations representing part or all of the sales price of merchandise, insurance, and services; (B) making loans to manufacturers, wholesalers, and retailers of, and to prospective purchasers of, specified merchandise, insurance, and services; and (C) purchasing or otherwise acquiring mortgages and other liens on and interests in real estate." ;
  fro-usc:hasId "idd03c7019-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd03c701a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-8> ;
  fro-usc:hasContentText "Any company primarily engaged, directly or through majority-owned subsidiaries, in one or more of the businesses described in paragraphs (3), (4), and (5) of this subsection, or in one or more of such businesses (from which not less than 25 per centum of such company’s gross income during its last fiscal year was derived) together with an additional business or businesses other than investing, reinvesting, owning, holding, or trading in securities." ;
  fro-usc:hasId "idd03c701a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/6" ;
  fro-usc:hasNumberText "(6)" ;
.
usc-t15-ch2D:idd03c701b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9> ;
  fro-usc:hasId "idd03c701b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7" ;
  fro-usc:hasNumberText "(7)" ;
  lkif-mereo:component usc-t15-ch2D:idd03c701c-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c701d-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c7024-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c7025-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03eb916-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c701c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-1> ;
  fro-usc:hasContentText "Any issuer, the outstanding securities of which are owned exclusively by persons who, at the time of acquisition of such securities, are qualified purchasers, and which is not making and does not at that time propose to make a public offering of such securities. Securities that are owned by persons who received the securities from a qualified purchaser as a gift or bequest, or in a case in which the transfer was caused by legal separation, divorce, death, or other involuntary event, shall be deemed to be owned by a qualified purchaser, subject to such rules, regulations, and orders as the Commission may prescribe as necessary or appropriate in the public interest or for the protection of investors." ;
  fro-usc:hasId "idd03c701c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd03c701d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-2> ;
  fro-usc:hasId "idd03c701d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-4-4-9-2-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c701e-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c7021-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c701e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-2-2> ;
  fro-usc:hasId "idd03c701e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/B/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-4-4-9-2-2-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c701f-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c7020-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c701f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-2-2-2> ;
  fro-usc:hasContentText "such persons acquired any portion of the securities of such issuer on or before September 1, 1996 ; and" ;
  fro-usc:hasId "idd03c701f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/B/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
usc-t15-ch2D:idd03c7020-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-2-2-3> ;
  fro-usc:hasContentText "at the time at which such persons initially acquired the securities of such issuer, the issuer was excepted by paragraph (1); and" ;
  fro-usc:hasId "idd03c7020-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/B/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
usc-t15-ch2D:idd03c7021-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-2-3> ;
  fro-usc:hasId "idd03c7021-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-4-4-9-2-3-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03c7022-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03c7023-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03c7022-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-2-3-2> ;
  fro-usc:hasContentText "such issuer has disclosed to each beneficial owner, as determined under paragraph (1), that future investors will be limited to qualified purchasers, and that ownership in such issuer is no longer limited to not more than 100 persons; and" ;
  fro-usc:hasId "idd03c7022-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/B/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
usc-t15-ch2D:idd03c7023-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-2-3-3> ;
  fro-usc:hasContentText "concurrently with or after such disclosure, such issuer has provided each beneficial owner, as determined under paragraph (1), with a reasonable opportunity to redeem any part or all of their interests in the issuer, notwithstanding any agreement to the contrary between the issuer and such persons, for that person’s proportionate share of the issuer’s net assets." ;
  fro-usc:hasId "idd03c7023-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/B/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
usc-t15-ch2D:idd03c7024-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-3> ;
  fro-usc:hasContentText "Each person that elects to redeem under subparagraph (B)(ii)(II) shall receive an amount in cash equal to that person’s proportionate share of the issuer’s net assets, unless the issuer elects to provide such person with the option of receiving, and such person agrees to receive, all or a portion of such person’s share in assets of the issuer. If the issuer elects to provide such persons with such an opportunity, disclosure concerning such opportunity shall be made in the disclosure required by subparagraph (B)(ii)(I)." ;
  fro-usc:hasId "idd03c7024-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd03c7025-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-4> ;
  fro-usc:hasContentText "An issuer that is excepted under this paragraph shall nonetheless be deemed to be an investment company for purposes of the limitations set forth in subparagraphs (A)(i) and (B)(i) of section 80a–12(d)(1) of this title relating to the purchase or other acquisition by such issuer of any security issued by any registered investment company and the sale of any security issued by any registered open-end investment company to any such issuer." ;
  fro-usc:hasId "idd03c7025-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–12/d/1" ;
.
usc-t15-ch2D:idd03eb916-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-9-5> ;
  fro-usc:hasContentText "For purposes of determining compliance with this paragraph and paragraph (1), an issuer that is otherwise excepted under this paragraph and an issuer that is otherwise excepted under paragraph (1) shall not be treated by the Commission as being a single issuer for purposes of determining whether the outstanding securities of the issuer excepted under paragraph (1) are beneficially owned by not more than 100 persons or whether the outstanding securities of the issuer excepted under this paragraph are owned by persons that are not qualified purchasers. Nothing in this subparagraph shall be construed to establish that a person is a bona fide qualified purchaser for purposes of this paragraph or a bona fide beneficial owner for purposes of paragraph (1)." ;
  fro-usc:hasId "idd03eb916-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/7/E" ;
  fro-usc:hasNumberText "(E)" ;
.
usc-t15-ch2D:idd03eb917-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-10> ;
  fro-usc:hasContentText "[Repealed] Pub. L. 111–203, title IX , § 986(c)(2), July 21, 2010 , 124 Stat. 1936 ." ;
  fro-usc:hasId "idd03eb917-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/8" ;
  fro-usc:hasNumberText "(8)" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIX" ;
  fro-usc:hasReferenceText "/us/stat/124/1936" ;
.
usc-t15-ch2D:idd03eb918-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-4-4-11> ;
  fro-usc:hasContentText "Any person substantially all of whose business consists of owning or holding oil, gas, or other mineral royalties or leases, or fractional interests therein, or certificates of interest or participation in or investment contracts relative to such royalties, leases, or fractional interests." ;
  fro-usc:hasId "idd03eb918-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–3/c/9" ;
  fro-usc:hasNumberText "(9)" ;
.
