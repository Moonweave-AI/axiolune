usc-t15-ch2D:idd0485677-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-10-3-2> ;
  fro-usc:hasContentText "such contract is a redeemable security; and" ;
  fro-usc:hasId "idd0485677-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/i/2/A" ;
