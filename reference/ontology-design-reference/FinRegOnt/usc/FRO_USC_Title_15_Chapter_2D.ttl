  fro-usc:hasReferenceText "/us/pl/111/203/tIX" ;
  fro-usc:hasReferenceText "/us/pl/96/477/tI" ;
  fro-usc:hasReferenceText "/us/stat/110/3446" ;
  fro-usc:hasReferenceText "/us/stat/124/1934" ;
  fro-usc:hasReferenceText "/us/stat/94/2286" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , § 506, Oct. 11, 1996 , 110 Stat. 3446 ; Pub. L. 111–203, title IX , § 985(d)(5), July 21, 2010 , 124 Stat. 1934 .) , title I, § 61, as added Pub. L. 96–477, title I , § 105, Oct. 21, 1980 , 94 Stat. 2286 ; amended Pub. L. 104–290, title V" ;
.
usc-t15-ch2D:idd04f5aff-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-5-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd04f5aff-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Small Business Investment Act of 1958, referred to in subsec. (a)(4), is Pub. L. 85–699 , Aug. 21, 1958 , 72 Stat. 689 ), as amended, which is classified principally to chapter 14B (§ 661 et seq.) of this title. For complete classification of this Act to the Code, see Short Title note set out under section 661 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/pl/85/699" ;
  fro-usc:hasReferenceText "/us/stat/72/689" ;
  fro-usc:hasReferenceText "/us/usc/t15/s661" ;
.
usc-t15-ch2D:idd04f5b00-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-5-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04f5b00-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1996—Subsec. (a)(2). Pub. L. 104–290 , § 506(1), substituted a period for “if such business development company does not have outstanding any publicly held indebtedness, and all such securities of each class are—" ;
  fro-usc:hasNoteText "2010—Subsec. (a)(3)(B)(iii). Pub. L. 111–203 substituted “ section 80b–5(a)(1) of this title ” for “paragraph (1) of section 80b–5 of this title ” and “paragraph (1) or (2) of section 80b–5(b) of this title ” for “clause (A) or (B) of that section”." ;
  fro-usc:hasNoteText "Subsec. (a)(3)(A)(ii). Pub. L. 104–290 , § 506(2)(C), struck out “senior” before “securities”." ;
  fro-usc:hasNoteText "Subsec. (a)(3)(A). Pub. L. 104–290 , § 506(2)(A), (B), inserted “accompanied by securities,” after “of such company,” and struck out “senior securities representing indebtedness accompanied by” before “warrants, options, or rights”." ;
  fro-usc:hasNoteText "Subsec. (a)(3)(C). Pub. L. 104–290 , § 506(3), added subpar. (C)." ;
  fro-usc:hasNoteText "“(A) privately held or guaranteed by the Small Business Administration, or banks, insurance companies, or other institutional investors; and" ;
  fro-usc:hasNoteText "“(B) not intended to be publicly distributed.”" ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/104/290" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–5" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–5/a/1" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–5/b" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd0568721-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd0568726-0c74-11e6-aa53-e455a13f2ad9 ;
.
