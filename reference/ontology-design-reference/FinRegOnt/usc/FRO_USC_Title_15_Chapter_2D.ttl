  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-18-4-5> ;
  fro-usc:hasContentText "afford to such applicants access to a list of the names and addresses of all shareholders as recorded on the books of the trust; or" ;
  fro-usc:hasId "idd0437491-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–16/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0437492-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-18-4-6> ;
  fro-usc:hasContentText "inform such applicants as to the approximate number of shareholders of record, and the approximate cost of mailing to them the proposed communication and form of request." ;
  fro-usc:hasId "idd0437492-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–16/c/2" ;
  fro-usc:hasNumberText "(2)" ;
.
