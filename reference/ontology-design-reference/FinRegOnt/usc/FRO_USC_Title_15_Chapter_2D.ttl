usc-t15-ch2D:idd04f5b6f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-3-9-2> ;
  fro-usc:hasContentText "small business investment companies that are licensees under the Small Business Investment Act of 1958 [ 15 U.S.C. 661 et seq.];" ;
  fro-usc:hasId "idd04f5b6f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/b/7/A" ;
