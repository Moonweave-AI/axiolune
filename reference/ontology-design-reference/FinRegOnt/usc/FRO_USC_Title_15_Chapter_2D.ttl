  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–2" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd04f5b21-0c74-11e6-aa53-e455a13f2ad9 ;
.
