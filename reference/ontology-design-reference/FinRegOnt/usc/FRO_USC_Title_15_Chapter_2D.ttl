.
usc-t15-ch2D:idd045e623-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-26-3-5> ;
  fro-usc:hasContentText "any registered face-amount certificate company." ;
  fro-usc:hasId "idd045e623-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–24/b/3" ;
