  fro-leg-ref:divided_by usc-t15-ch2D:idd0485662-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485663-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-2> ;
  fro-usc:hasHeading "Sale of certificates; restrictions" ;
  fro-usc:hasId "idd048565d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-29-2-2> ;
.
usc-t15-ch2D:idd048565e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-2-3> ;
  fro-usc:hasContentText "the sales load on such certificate exceeds 9 per centum of the total payments to be made thereon;" ;
  fro-usc:hasId "idd048565e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd048565f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-2-4> ;
  fro-usc:hasContentText "more than one-half of any of the first twelve monthly payments thereon, or their equivalent, is deducted for sales load;" ;
  fro-usc:hasId "idd048565f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0485660-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-2-5> ;
  fro-usc:hasContentText "the amount of sales load deducted from any one of such first payments exceeds proportionately the amount deducted from any other such payment, or the amount deducted from any subsequent payment exceeds proportionately the amount deducted from any other subsequent payment;" ;
  fro-usc:hasId "idd0485660-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0485661-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-2-6> ;
  fro-usc:hasContentText "the first payment on such certificate is less than $20, or any subsequent payment is less than $10;" ;
  fro-usc:hasId "idd0485661-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd0485662-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-2-7> ;
  fro-usc:hasContentText "if such registered company is a management company, the proceeds of such certificate or the securities in which such proceeds are invested are subject to management fees (other than fees for administrative services of the character described in clause (C), paragraph (2), of section 80a–26(a) of this title ) exceeding such reasonable amount as the Commission may prescribe, whether such fees are payable to such company or to investment advisers thereof; or" ;
  fro-usc:hasId "idd0485662-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/a/5" ;
  fro-usc:hasNumberText "(5)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–26/a" ;
.
usc-t15-ch2D:idd0485663-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-2-8> ;
  fro-usc:hasContentText "if such registered company is a unit investment trust the assets of which are securities issued by a management company, the depositor of or principal underwriter for such trust, or any affiliated person of such depositor or underwriter, is to receive from such management company or any affiliated person thereof any fee or payment on account of payments on such certificate exceeding such reasonable amount as the Commission may prescribe." ;
  fro-usc:hasId "idd0485663-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/a/6" ;
  fro-usc:hasNumberText "(6)" ;
.
usc-t15-ch2D:idd0485664-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-3> ;
  fro-usc:hasContentText "If it appears to the Commission, upon application or otherwise, that smaller companies are subjected to relatively higher operating costs and that in order to make due allowance therefor it is necessary or appropriate in the public interest and consistent with the protection of investors that a provision or provisions of paragraph (1), (2), or (3) of subsection (a) relative to sales load be relaxed in the case of certain registered investment companies issuing periodic payment plan certificates, or certain specified classes of such companies, the Commission is authorized by rules and regulations or order to grant any such company or class of companies appropriate qualified exemptions from the provisions of said paragraphs." ;
  fro-usc:hasHeading "Exemptions" ;
  fro-usc:hasId "idd0485664-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd0485665-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485666-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485667-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-4> ;
  fro-usc:hasHeading "Sale of certificates; requirements" ;
  fro-usc:hasId "idd0485665-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-29-4-2> ;
.
usc-t15-ch2D:idd0485666-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-4-3> ;
  fro-usc:hasContentText "such certificate is a redeemable security; and" ;
  fro-usc:hasId "idd0485666-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/c/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0485667-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-4-4> ;
  fro-usc:hasContentText "the proceeds of all payments on such certificate (except such amounts as are deducted for sales load) are deposited with a trustee or custodian having the qualifications prescribed in paragraph (1) of section 80a–26(a) of this title for the trustees of unit investment trusts, and are held by such trustee or custodian under an indenture or agreement containing, in substance, the provisions required by paragraphs (2) and (3) of section 80a–26(a) of this title for the trust indentures of unit investment trusts." ;
  fro-usc:hasId "idd0485667-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/c/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–26/a" ;
.
usc-t15-ch2D:idd0485668-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-5> ;
  fro-usc:hasContentText "Notwithstanding subsection (a) of this section, it shall be unlawful for any registered investment company issuing periodic payment plan certificates, or for any depositor of or underwriter for such company, to sell any such certificate unless the certificate provide that the holder thereof may surrender the certificate at any time within the first eighteen months after the issuance of the certificate and receive in payment thereof, in cash, the sum of (1) the value of his account, and (2) an amount, from such underwriter or depositor, equal to that part of the excess paid for sales loading which is over 15 per centum of the gross payments made by the certificate holder. The Commission may make rules and regulations applicable to such underwriters and depositors specifying such reserve requirements as it deems necessary or appropriate in order for such underwriters and depositors to carry out the obligations to refund sales charges required by this subsection." ;
  fro-usc:hasHeading "Surrender of certificates; regulations" ;
  fro-usc:hasId "idd0485668-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd0485669-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-6> ;
  fro-usc:hasContentText "With respect to any periodic payment plan certificate sold subject to the provisions of subsection (d) of this section, the registered investment company issuing such periodic payment plan certificate, or any depositor of or underwriter for such company, shall in writing (1) inform each certificate holder who has missed three payments or more, within thirty days following the expiration of fifteen months after the issuance of the certificate, or, if any such holder has missed one payment or more after such period of fifteen months but prior to the expiration of eighteen months after the issuance of the certificate, at any time prior to the expiration of such eighteen-month period, of his right to surrender his certificate as specified in subsection (d) of this section, and (2) inform the certificate holder of (A) the value of the holder’s account as of the time the written notice was given to such holder, and (B) the amount to which he is entitled as specified in subsection (d) of this section. The Commission may make rules specifying the method, form, and contents of the notice required by this subsection." ;
  fro-usc:hasHeading "Refund privileges; notice; rules" ;
  fro-usc:hasId "idd0485669-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/e" ;
  fro-usc:hasNumberText "(e)" ;
.
usc-t15-ch2D:idd048566a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-7> ;
  fro-usc:hasContentText "With respect to any periodic payment plan (other than a plan under which the amount of sales load deducted from any payment thereon does not exceed 9 per centum of such payment), the custodian bank for such plan shall mail to each certificate holder, within sixty days after the issuance of the certificate, a statement of charges to be deducted from the projected payments on the certificate and a notice of his right of withdrawal as specified in this section. The Commission may make rules specifying the method, form, and contents of the notice required by this subsection. The certificate holder may within forty-five days of the mailing of the notice specified in this subsection surrender his certificate and receive in payment thereof, in cash, the sum of (1) the value of his account, and (2) an amount, from the underwriter or depositor, equal to the difference between the gross payments made and the net amount invested. The Commission may make rules and regulations applicable to underwriters and depositors of companies issuing any such certificate specifying such reserve requirements as it deems necessary or appropriate in order for such underwriters and depositors to carry out the obligations to refund sales charges required by this subsection." ;
  fro-usc:hasHeading "Charges, statement; rules; surrender of certificates; regulations" ;
  fro-usc:hasId "idd048566a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/f" ;
  fro-usc:hasNumberText "(f)" ;
.
usc-t15-ch2D:idd048566b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-8> ;
  fro-usc:hasContentText "Notwithstanding the provisions of subsections (a) and (d), a registered investment company issuing periodic payment plan certificates may elect, by written notice to the Commission, to be governed by the provisions of subsection (h) rather than the provisions of subsections (a) and (d) of this section." ;
  fro-usc:hasHeading "Governing provisions; election" ;
  fro-usc:hasId "idd048566b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/g" ;
  fro-usc:hasNumberText "(g)" ;
.
usc-t15-ch2D:idd048566c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd048566d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd048566e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd048566f-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485670-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485671-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485672-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485673-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-9> ;
  fro-usc:hasHeading "Sale of certificates; restrictions" ;
  fro-usc:hasId "idd048566c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/h" ;
  fro-usc:hasNumberText "(h)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-29-9-2> ;
.
usc-t15-ch2D:idd048566d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-9-3> ;
  fro-usc:hasContentText "the sales load on such certificate exceeds 9 per centum of the total payments to be made thereon;" ;
  fro-usc:hasId "idd048566d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/h/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd048566e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-9-4> ;
  fro-usc:hasContentText "more than 20 per centum of any payment thereon is deducted for sales load, or an average of more than 16 per centum is deducted for sales load from the first forty-eight monthly payments thereon, or their equivalent;" ;
  fro-usc:hasId "idd048566e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/h/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd048566f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-9-5> ;
  fro-usc:hasContentText "the amount of sales load deducted from any one of the first twelve monthly payments, the thirteenth through twenty-fourth monthly payments, the twenty-fifth through thirty-sixth monthly payments, or the thirty-seventh through forty-eighth monthly payments, or their equivalents, respectively, exceeds proportionately the amount deducted from any other such payment, or the amount deducted from any subsequent payment exceeds proportionately the amount deducted from any other subsequent payment;" ;
  fro-usc:hasId "idd048566f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/h/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0485670-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-9-6> ;
  fro-usc:hasContentText "the deduction for sales load on the excess of the payment or payments in any month over the minimum monthly payment, or its equivalent, to be made on the certificate exceeds the sales load applicable to payments subsequent to the first forty-eight monthly payments or their equivalent;" ;
  fro-usc:hasId "idd0485670-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/h/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd0485671-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-9-7> ;
  fro-usc:hasContentText "the first payment on such certificate is less than $20, or any subsequent payment is less than $10;" ;
  fro-usc:hasId "idd0485671-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/h/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd0485672-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-9-8> ;
  fro-usc:hasContentText "if such registered company is a management company, the proceeds of such certificate or the securities in which such proceeds are invested are subject to management fees (other than fees for administrative services of the character described in clause (C) of paragraph (2) of section 80a–26(a) of this title ) exceeding such reasonable amount as the Commission may prescribe, whether such fees are payable to such company or to investment advisers thereof; or" ;
  fro-usc:hasId "idd0485672-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/h/6" ;
  fro-usc:hasNumberText "(6)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–26/a" ;
.
usc-t15-ch2D:idd0485673-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-9-9> ;
  fro-usc:hasContentText "if such registered company is a unit investment trust the assets of which are securities issued by a management company, the depositor of or principal underwriter for such trust, or any affiliated person of such depositor or underwriter, is to receive from such management company or any affiliated person thereof any fee or payment on account of payments on such certificate exceeding such reasonable amount as the Commission may prescribe." ;
  fro-usc:hasId "idd0485673-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/h/7" ;
  fro-usc:hasNumberText "(7)" ;
.
usc-t15-ch2D:idd0485674-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485675-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0485676-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-10> ;
  fro-usc:hasHeading "Applicability to registered separate account funding variable insurance contracts" ;
  fro-usc:hasId "idd0485674-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd0485675-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-10-2> ;
  fro-usc:hasContentText "This section does not apply to any registered separate account funding variable insurance contracts, or to the sponsoring insurance company and principal underwriter of such account, except as provided in paragraph (2)." ;
  fro-usc:hasId "idd0485675-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–27/i/1" ;
  fro-usc:hasNumberText "(1)" ;
.
