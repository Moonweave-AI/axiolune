  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-24-3-4> ;
  fro-usc:hasContentText "is in compliance with the applicable books and records requirements of the State in which it maintains its principal office and place of business." ;
  fro-usc:hasId "idd058f8d7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–18a/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
