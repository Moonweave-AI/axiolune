  fro-usc:hasHeading "Issuance or sale of certificates" ;
  fro-usc:hasId "idd0485684-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–28/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-30-2-2> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-30-2-5> ;
