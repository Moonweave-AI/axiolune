  fro-usc:hasReferenceText "/us/stat/94/2278" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , § 625, Dec. 4, 1987 , 101 Stat. 1262 .) , title I, § 54, as added Pub. L. 96–477, title I , § 105, Oct. 21, 1980 , 94 Stat. 2278 ; amended Pub. L. 100–181, title VI" ;
.
