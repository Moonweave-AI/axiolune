  fro-usc:hasNumberText "(2)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-29-10-3-1> ;
  lkif-mereo:component usc-t15-ch2D:idd0485677-0c74-11e6-aa53-e455a13f2ad9 ;
