  fro-usc:hasReferenceText "/us/stat/85/487" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 ; Pub. L. 92–165 , Nov. 23, 1971 , 85 Stat. 487 ; Pub. L. 104–290, title II , § 205(b), Oct. 11, 1996 , 110 Stat. 3429 ; Pub. L. 109–290 , § 4(a), (b), Sept. 29, 2006 , 120 Stat. 1318 , 1319.) , title I, § 27, 54 Stat. 829 ; Pub. L. 91–547 , § 16, Dec. 14, 1970 , 84 Stat. 1424" ;
.
usc-t15-ch2D:idd0485680-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-29-13-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd0485680-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1970—Subsecs. (d) to (h). Pub. L. 91–547 added subsecs. (d) to (h)." ;
  fro-usc:hasNoteText "1971—Subsec. (f). Pub. L. 92–165 inserted “(other than a plan under which the amount of sales load deducted from any payment thereon does not exceed 9 per centum of such payment)”." ;
  fro-usc:hasNoteText "1996—Subsec. (i). Pub. L. 104–290 added subsec. (i)." ;
  fro-usc:hasNoteText "2006—Subsec. (i)(2)(B). Pub. L. 109–290 , § 4(b), substituted “section 80a–26(f)” for “section 80a–26(e)” in two places." ;
  fro-usc:hasNoteText "Subsec. (j). Pub. L. 109–290 , § 4(a), added subsec. (j)." ;
  fro-usc:hasNoteTopic "amendments" ;
