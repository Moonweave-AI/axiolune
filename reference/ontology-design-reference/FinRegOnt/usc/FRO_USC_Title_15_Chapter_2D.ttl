usc-t15-ch2D:idd04d1164-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d1165-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d1166-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 48 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04d116c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-48> ;
  fro-usc:hasHeading "Validity of contracts" ;
  fro-usc:hasId "idd04d1164-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–46" ;
  fro-usc:hasNumberText "§ 80a–46." ;
  lkif-mereo:component usc-t15-ch2D:idd04d116a-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d1165-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-48-2> ;
  fro-usc:hasContentText "Any condition, stipulation, or provision binding any person to waive compliance with any provision of this subchapter or with any rule, regulation, or order thereunder shall be void." ;
  fro-usc:hasHeading "Waiver of compliance as void" ;
  fro-usc:hasId "idd04d1165-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–46/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd04d1166-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d1167-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d1168-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d1169-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-48-3> ;
  fro-usc:hasHeading "Equitable results; rescission; severance" ;
  fro-usc:hasId "idd04d1166-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–46/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04d1167-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-48-3-2> ;
  fro-usc:hasContentText "A contract that is made, or whose performance involves, a violation of this subchapter, or of any rule, regulation, or order thereunder, is unenforceable by either party (or by a nonparty to the contract who acquired a right under the contract with knowledge of the facts by reason of which the making or performance violated or would violate any provision of this subchapter or of any rule, regulation, or order thereunder) unless a court finds that under the circumstances enforcement would produce a more equitable result than nonenforcement and would not be inconsistent with the purposes of this subchapter." ;
  fro-usc:hasId "idd04d1167-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–46/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04d1168-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-48-3-3> ;
  fro-usc:hasContentText "To the extent that a contract described in paragraph (1) has been performed, a court may not deny rescission at the instance of any party unless such court finds that under the circumstances the denial of rescission would produce a more equitable result than its grant and would not be inconsistent with the purposes of this subchapter." ;
  fro-usc:hasId "idd04d1168-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–46/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04d1169-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-48-3-4> ;
  fro-usc:hasContentText "This subsection shall not apply (A) to the lawful portion of a contract to the extent that it may be severed from the unlawful portion of the contract, or (B) to preclude recovery against any person for unjust enrichment." ;
  fro-usc:hasId "idd04d1169-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–46/b/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd04d116a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-usc:hasId "idd04d116a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/96/477/tI" ;
  fro-usc:hasReferenceText "/us/stat/54/845" ;
  fro-usc:hasReferenceText "/us/stat/94/2277" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 .) , title I, § 47, 54 Stat. 845 ; Pub. L. 96–477, title I , § 104, Oct. 21, 1980 , 94 Stat. 2277" ;
.
usc-t15-ch2D:idd04d116c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-48-5-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04d116c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1980—Subsec. (b). Pub. L. 96–477 provided that a contract whose terms violated this subchapter or any rule, regulation, or order thereunder would be unenforceable by either party or by a nonparty to the contract who acquired a right under such contract with knowledge of the facts by reason of which the making or performance of the contract would violate this subchapter, struck out provisions declaring such contracts void as regards the rights of the violators or nonparties to the contract with actual knowledge of its illegality, authorized the court to enforce such contracts where the court found that under the circumstances enforcement would produce a more equitable result than nonenforcement and such enforcement would not be inconsistent with the purposes of this subchapter, authorized the same two-part test to save from rescission any portions of such contracts which had been performed, and provided that subsec. (b) was not to apply to a lawful portion of a contract to the extent it could be severed from an unlawful portion of such contract, or to preclude recovery against any person for unjust enrichment." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/96/477" ;
.
usc-t15-ch2D:idd04d116d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d116e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d116f-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04d1170-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 49 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04d1173-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04d1174-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-49> ;
  fro-usc:hasHeading "Liability of controlling persons; preventing compliance with subchapter" ;
  fro-usc:hasId "idd04d116d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–47" ;
  fro-usc:hasNumberText "§ 80a–47." ;
  lkif-mereo:component usc-t15-ch2D:idd04d1171-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd04d116e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-49-2> ;
  fro-usc:hasContentText "It shall be unlawful for any person, directly or indirectly, to cause to be done any act or thing through or by means of any other person which it would be unlawful for such person to do under the provisions of this subchapter or any rule, regulation, or order thereunder." ;
  fro-usc:hasHeading "Procurement" ;
  fro-usc:hasId "idd04d116e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–47/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd04d116f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-49-3> ;
  fro-usc:hasContentText "For purposes of any action brought by the Commission under subsection (d) or (e) of section 80a–41 of this title , any person that knowingly or recklessly provides substantial assistance to another person in violation of a provision of this subchapter, or of any rule or regulation issued under this subchapter, shall be deemed to be in violation of such provision to the same extent as the person to whom such assistance is provided." ;
  fro-usc:hasHeading "Substantially assisting a violation" ;
  fro-usc:hasId "idd04d116f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–47/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–41" ;
.
usc-t15-ch2D:idd04d1170-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-49-4> ;
  fro-usc:hasContentText "It shall be unlawful for any person without just cause to hinder, delay, or obstruct the making, filing, or keeping of any information, document, report, record, or account required to be made, filed, or kept under any provision of this subchapter or any rule, regulation, or order thereunder." ;
  fro-usc:hasHeading "Obstructing compliance" ;
  fro-usc:hasId "idd04d1170-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–47/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd04d1171-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "idd04d1171-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIX" ;
  fro-usc:hasReferenceText "/us/stat/124/1861" ;
  fro-usc:hasReferenceText "/us/stat/54/846" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 .) , title I, § 48, 54 Stat. 846 ; Pub. L. 111–203, title IX , § 929M(b), July 21, 2010 , 124 Stat. 1861" ;
.
usc-t15-ch2D:idd04d1173-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-49-6-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04d1173-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "2010—Subsecs. (b), (c). Pub. L. 111–203 added subsec. (b) and redesignated former subsec. (b) as (c)." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
.
usc-t15-ch2D:idd04d1174-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-49-6-1> ;
  fro-usc:hasHeading "Effective Date of 2010 Amendment" ;
  fro-usc:hasId "idd04d1174-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Amendment by Pub. L. 111–203 effective 1 day after July 21, 2010 , except as otherwise provided, see section 4 of Pub. L. 111–203 , set out as an Effective Date note under section 5301 of Title 12 , Banks and Banking." ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s4" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
.
usc-t15-ch2D:idd04d1175-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 50 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04d1178-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd04d1179-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-50> ;
  fro-usc:hasContentText "Any person who willfully violates any provision of this subchapter or of any rule, regulation, or order hereunder, or any person who willfully in any registration statement, application, report, account, record, or other document filed or transmitted pursuant to this subchapter or the keeping of which is required pursuant to section 80a–30(a) of this title makes any untrue statement of a material fact or omits to state any material fact necessary in order to prevent the statements made therein from being materially misleading in the light of the circumstances under which they were made, shall upon conviction be fined not more than $10,000 or imprisoned not more than five years, or both; but no person shall be convicted under this section for the violation of any rule, regulation, or order if he proves that he had no actual knowledge of such rule, regulation, or order." ;
  fro-usc:hasHeading "Penalties" ;
  fro-usc:hasId "idd04d1175-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–48" ;
  fro-usc:hasNumberText "§ 80a–48." ;
  lkif-mereo:component usc-t15-ch2D:idd04d1176-0c74-11e6-aa53-e455a13f2ad9 ;
.
