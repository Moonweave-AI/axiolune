.
usc-t15-ch2D:idd04d11fe-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-2-2> ;
  fro-usc:hasContentText "such warrants, options, or rights expire by their terms within ten years;" ;
  fro-usc:hasId "idd04d11fe-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd04d11ff-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-2-3> ;
  fro-usc:hasContentText "such warrants, options, or rights are not separately transferable unless no class of such warrants, options, or rights and the securities accompanying them has been publicly distributed;" ;
  fro-usc:hasId "idd04d11ff-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd04d1200-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-2-4> ;
  fro-usc:hasContentText "the exercise or conversion price is not less than the current market value at the date of issuance, or if no such market value exists, the current net asset value of such voting securities; and" ;
  fro-usc:hasId "idd04d1200-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
usc-t15-ch2D:idd04d1201-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-62-2-5-2-5> ;
  fro-usc:hasContentText "the proposal to issue such securities is authorized by the shareholders or partners of such business development company, and such issuance is approved by the required majority (as defined in section 80a–56( o ) of this title) of the directors of or general partners in such company on the basis that such issuance is in the best interests of such company and its shareholders or partners;" ;
  fro-usc:hasId "idd04d1201-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–60/a/3/A/iv" ;
  fro-usc:hasNumberText "(iv)" ;
.
