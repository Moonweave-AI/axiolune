usc-t15-ch2D:idd04aa0ca-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0cb-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0cc-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0cd-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd04aa0ce-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-33-2> ;
  fro-usc:hasHeading "Selection of accountant" ;
  fro-usc:hasId "idd04aa0ca-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–31/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-33-2-2> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-33-2-7> ;
.
usc-t15-ch2D:idd04aa0cb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-33-2-3> ;
  fro-usc:hasContentText "such accountant shall have been selected at a meeting held within thirty days before or after the beginning of the fiscal year or before the annual meeting of stockholders in that year by the vote, cast in person, of a majority of those members of the board of directors who are not interested persons of such registered company;" ;
  fro-usc:hasId "idd04aa0cb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–31/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd04aa0cc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-33-2-4> ;
  fro-usc:hasContentText "such selection shall have been submitted for ratification or rejection at the next succeeding annual meeting of stockholders if such meeting be held, except that any vacancy occurring between annual meetings, due to the death or resignation of the accountant, may be filled by the vote of a majority of those members of the board of directors who are not interested persons of such registered company, cast in person at a meeting called for the purpose of voting on such action;" ;
  fro-usc:hasId "idd04aa0cc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–31/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd04aa0cd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-33-2-5> ;
  fro-usc:hasContentText "the employment of such accountant shall have been conditioned upon the right of the company by vote of a majority of the outstanding voting securities at any meeting called for the purpose to terminate such employment forthwith without any penalty; and" ;
  fro-usc:hasId "idd04aa0cd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–31/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd04aa0ce-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-33-2-6> ;
  fro-usc:hasContentText "such certificate or report of such accountant shall be addressed both to the board of directors of such registered company and to the security holders thereof." ;
  fro-usc:hasId "idd04aa0ce-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–31/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd04aa0cf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-33-3> ;
  fro-usc:hasContentText "No registered management company or registered face-amount certificate company shall file with the Commission any financial statement in the preparation of which the controller or other principal accounting officer or employee of such company participated, unless such controller, officer or employee was selected, either by vote of the holders of such company’s voting securities at the last annual meeting of such security holders, or by the board of directors of such company." ;
  fro-usc:hasHeading "Selection of controller or other principal accounting officer" ;
  fro-usc:hasId "idd04aa0cf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–31/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd04aa0d0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-33-4> ;
  fro-usc:hasContentText "The Commission is authorized, by rules and regulations or order in the public interest or for the protection of investors, to require accountants and auditors to keep reports, work sheets, and other documents and papers relating to registered investment companies for such period or periods as the Commission may prescribe, and to make the same available for inspection by the Commission or any member or representative thereof." ;
  fro-usc:hasHeading "Reports of accountants and auditors" ;
  fro-usc:hasId "idd04aa0d0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–31/c" ;
  fro-usc:hasNumberText "(c)" ;
.
