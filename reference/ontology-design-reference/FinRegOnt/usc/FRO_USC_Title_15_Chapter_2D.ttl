  fro-usc:hasReferenceText "/us/stat/54/853" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , title II, § 207, 54 Stat. 853 .)" ;
.
usc-t15-ch2D:idd0568748-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-11-4-0> ;
  fro-usc:hasHeading "Transfer of Functions" ;
  fro-usc:hasId "idd0568748-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For transfer of functions of Securities and Exchange Commission, with certain exceptions, to Chairman of such Commission, see Reorg. Plan No. 10 of 1950, §§ 1, 2, eff. May 24, 1950 , 15 F.R. 3175, 64 Stat. 1265 , set out under section 78d of this title ." ;
  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
usc-t15-ch2D:idd0568749-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd056874a-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f84b-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f84c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd058f84d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f850-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f851-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd058f852-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-12> ;
  fro-usc:hasHeading "General prohibitions" ;
  fro-usc:hasId "idd0568749-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–8" ;
  fro-usc:hasNumberText "§ 80b–8." ;
  lkif-mereo:component usc-t15-ch2D:idd058f84e-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd056874a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-12-2> ;
  fro-usc:hasContentText "It shall be unlawful for any person registered under section 80b–3 of this title to represent or imply in any manner whatsoever that such person has been sponsored, recommended, or approved, or that his abilities or qualifications have in any respect been passed upon by the United States or any agency or any officer thereof." ;
  fro-usc:hasHeading "Representations of sponsorship by United States or agency thereof" ;
  fro-usc:hasId "idd056874a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–8/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3" ;
.
usc-t15-ch2D:idd058f84b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-12-3> ;
  fro-usc:hasContentText "No provision of subsection (a) shall be construed to prohibit a statement that a person is registered under this subchapter or under the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], if such statement is true in fact and if the effect of such registration is not misrepresented." ;
  fro-usc:hasHeading "Statement of registration under Securities Exchange Act of 1934 provisions" ;
  fro-usc:hasId "idd058f84b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–8/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd058f84c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-12-4> ;
  fro-usc:hasContentText "It shall be unlawful for any person registered under section 80b–3 of this title to represent that he is an investment counsel or to use the name “investment counsel” as descriptive of his business unless (1) his or its principal business consists of acting as investment adviser, and (2) a substantial part of his or its business consists of rendering investment supervisory services." ;
  fro-usc:hasHeading "Use of name “investment counsel” as descriptive of business" ;
  fro-usc:hasId "idd058f84c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–8/c" ;
  fro-usc:hasNumberText "(c)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3" ;
.
usc-t15-ch2D:idd058f84d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-12-5> ;
  fro-usc:hasContentText "It shall be unlawful for any person indirectly, or through or by any other person, to do any act or thing which it would be unlawful for such person to do directly under the provisions of this subchapter or any rule or regulation thereunder." ;
  fro-usc:hasHeading "Use of indirect means to do prohibited act" ;
  fro-usc:hasId "idd058f84d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–8/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd058f84e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "idd058f84e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/86/750" ;
  fro-usc:hasReferenceText "/us/stat/54/853" ;
  fro-usc:hasReferenceText "/us/stat/74/887" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 .) , title II, § 208, 54 Stat. 853 ; Pub. L. 86–750 , §§ 10, 11, Sept. 13, 1960 , 74 Stat. 887" ;
.
usc-t15-ch2D:idd058f850-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-12-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd058f850-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Securities Exchange Act of 1934, referred to in subsec. (b), is act June 6, 1934, ch. 404 , 48 Stat. 881 , which is classified principally to chapter 2B (§ 78a et seq.) of this title. For complete classification of this Act to the Code, see section 78a of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1934-06-06/ch404" ;
  fro-usc:hasReferenceText "/us/stat/48/881" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd058f851-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-12-7-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd058f851-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1960— Pub. L. 86–750 , § 10, substituted “General prohibitions” for “Unlawful representations” in section catchline." ;
  fro-usc:hasNoteText "Subsec. (c). Pub. L. 86–750 , § 11(a), authorized representation as an investment counsel if person’s principal business consisted of acting as investment adviser, and a substantial part of the business was rendering investment supervisory services, and struck out the requirements that the person be primarily engaged in rendering investment supervisory services, or that his registration application state that the person is, or is about to become engaged primarily in rendering investment advisory services." ;
  fro-usc:hasNoteText "Subsec. (d). Pub. L. 86–750 , § 11(b), added subsec. (d)." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/86/750" ;
.
