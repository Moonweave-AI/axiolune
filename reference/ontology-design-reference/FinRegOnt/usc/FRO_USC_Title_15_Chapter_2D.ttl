  fro-leg-ref:refers_toNote usc-t15-ch2D:idd045e5fc-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-23> ;
  fro-usc:hasHeading "Loans by management companies" ;
  fro-usc:hasId "idd045e5f7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–21" ;
  fro-usc:hasNumberText "§ 80a–21." ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-23-2> ;
  lkif-mereo:component usc-t15-ch2D:idd045e5fa-0c74-11e6-aa53-e455a13f2ad9 ;
