  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb962-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb965-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd03eb968-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd03eb969-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-7> ;
  fro-usc:hasHeading "Subclassification of management companies" ;
  fro-usc:hasId "idd03eb95e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–5" ;
  fro-usc:hasNumberText "§ 80a–5." ;
  lkif-mereo:component usc-t15-ch2D:idd03eb966-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03eb95f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb960-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb961-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-7-2> ;
  fro-usc:hasHeading "Open-end and closed-end companies" ;
  fro-usc:hasId "idd03eb95f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–5/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-7-2-2> ;
.
usc-t15-ch2D:idd03eb960-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-7-2-3> ;
  fro-usc:hasContentText "“Open-end company” means a management company which is offering for sale or has outstanding any redeemable security of which it is the issuer." ;
  fro-usc:hasId "idd03eb960-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–5/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd03eb961-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-7-2-4> ;
  fro-usc:hasContentText "“Closed-end company” means any management company other than an open-end company." ;
  fro-usc:hasId "idd03eb961-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–5/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd03eb962-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb963-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb964-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-7-3> ;
  fro-usc:hasHeading "Diversified and non-diversified companies" ;
  fro-usc:hasId "idd03eb962-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–5/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-7-3-2> ;
.
usc-t15-ch2D:idd03eb963-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-7-3-3> ;
  fro-usc:hasContentText "“Diversified company” means a management company which meets the following requirements: At least 75 per centum of the value of its total assets is represented by cash and cash items (including receivables), Government securities, securities of other investment companies, and other securities for the purposes of this calculation limited in respect of any one issuer to an amount not greater in value than 5 per centum of the value of the total assets of such management company and to not more than 10 per centum of the outstanding voting securities of such issuer." ;
  fro-usc:hasId "idd03eb963-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–5/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd03eb964-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-7-3-4> ;
  fro-usc:hasContentText "“Non-diversified company” means any management company other than a diversified company." ;
  fro-usc:hasId "idd03eb964-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–5/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd03eb965-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-7-4> ;
  fro-usc:hasContentText "A registered diversified company which at the time of its qualification as such meets the requirements of paragraph (1) of subsection (b) shall not lose its status as a diversified company because of any subsequent discrepancy between the value of its various investments and the requirements of said paragraph, so long as any such discrepancy existing immediately after its acquisition of any security or other property is neither wholly nor partly the result of such acquisition." ;
  fro-usc:hasHeading "Loss of status as diversified company" ;
  fro-usc:hasId "idd03eb965-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–5/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd03eb966-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
