  fro-usc:hasNumberText "(F)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-14-5-2-6-1> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-14-5-2-6-4> ;
  lkif-mereo:component usc-t15-ch2D:idd0412b3e-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412b3f-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412b3e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-6-2> ;
  fro-usc:hasContentText "immediately after such purchase or acquisition not more than 3 per centum of the total outstanding stock of such issuer is owned by such registered investment company and all affiliated persons of such registered investment company; and" ;
  fro-usc:hasId "idd0412b3e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/F/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd0412b3f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-6-3> ;
  fro-usc:hasContentText "such registered investment company has not offered or sold after January 1, 1971 , and is not proposing to offer or sell any security issued by it through a principal underwriter or otherwise at a public offering price which includes a sales load of more than 1½ per centum." ;
  fro-usc:hasId "idd0412b3f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/F/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0412b40-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-7> ;
  fro-usc:hasId "idd0412b40-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/G" ;
  fro-usc:hasNumberText "(G)" ;
  lkif-mereo:component usc-t15-ch2D:idd0412b41-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412b49-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412b41-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-7-1> ;
  fro-usc:hasId "idd0412b41-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/G/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-14-5-2-7-1-1> ;
  lkif-mereo:component usc-t15-ch2D:idd0412b42-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412b43-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412b44-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412b47-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412b48-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412b42-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-7-1-2> ;
  fro-usc:hasContentText "the acquired company and the acquiring company are part of the same group of investment companies;" ;
  fro-usc:hasId "idd0412b42-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/G/i/I" ;
  fro-usc:hasNumberText "(I)" ;
.
usc-t15-ch2D:idd0412b43-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-7-1-3> ;
  fro-usc:hasContentText "the securities of the acquired company, securities of other registered open-end investment companies and registered unit investment trusts that are part of the same group of investment companies, Government securities, and short-term paper are the only investments held by the acquiring company;" ;
  fro-usc:hasId "idd0412b43-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/G/i/II" ;
  fro-usc:hasNumberText "(II)" ;
.
usc-t15-ch2D:idd0412b44-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-7-1-4> ;
  fro-usc:hasId "idd0412b44-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/G/i/III" ;
  fro-usc:hasNumberText "(III)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-14-5-2-7-1-4-1> ;
.
usc-t15-ch2D:idd0412b45-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Item ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-7-1-4-2> ;
  fro-usc:hasId "idd0412b45-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/G/i/III/aa" ;
  fro-usc:hasNumberText "(aa)" ;
.
usc-t15-ch2D:idd0412b46-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Item ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-7-1-4-3> ;
  fro-usc:hasId "idd0412b46-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/G/i/III/bb" ;
  fro-usc:hasNumberText "(bb)" ;
.
usc-t15-ch2D:idd0412b47-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-7-1-5> ;
  fro-usc:hasContentText "the acquired company has a policy that prohibits it from acquiring any securities of registered open-end investment companies or registered unit investment trusts in reliance on this subparagraph or subparagraph (F); and" ;
  fro-usc:hasId "idd0412b47-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/G/i/IV" ;
  fro-usc:hasNumberText "(IV)" ;
.
usc-t15-ch2D:idd0412b48-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-7-1-6> ;
  fro-usc:hasContentText "such acquisition is not in contravention of such rules and regulations as the Commission may from time to time prescribe with respect to acquisitions in accordance with this subparagraph, as necessary and appropriate for the protection of investors." ;
  fro-usc:hasId "idd0412b48-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/G/i/V" ;
  fro-usc:hasNumberText "(V)" ;
.
usc-t15-ch2D:idd0412b49-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-7-2> ;
  fro-usc:hasContentText "For purposes of this subparagraph, the term “group of investment companies” means any 2 or more registered investment companies that hold themselves out to investors as related companies for purposes of investment and investor services." ;
  fro-usc:hasId "idd0412b49-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/G/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0412b4a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-8> ;
  fro-usc:hasContentText "For the purposes of this paragraph, the value of an investment company’s total assets shall be computed as of the time of a purchase or acquisition or as closely thereto as is reasonably possible." ;
  fro-usc:hasId "idd0412b4a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/H" ;
  fro-usc:hasNumberText "(H)" ;
.
usc-t15-ch2D:idd0412b4b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-9> ;
  fro-usc:hasContentText "In any action brought to enforce the provisions of this paragraph, the Commission may join as a party the issuer of any security purchased or otherwise acquired in violation of this paragraph, and the court may issue any order with respect to such issuer as may be necessary or appropriate for the enforcement of the provisions of this paragraph." ;
  fro-usc:hasId "idd0412b4b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/I" ;
  fro-usc:hasNumberText "(I)" ;
.
usc-t15-ch2D:idd0412b4c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-10> ;
  fro-usc:hasContentText "The Commission, by rule or regulation, upon its own motion or by order upon application, may conditionally or unconditionally exempt any person, security, or transaction, or any class or classes of persons, securities, or transactions from any provision of this paragraph, if and to the extent that such exemption is consistent with the public interest and the protection of investors." ;
  fro-usc:hasId "idd0412b4c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/J" ;
  fro-usc:hasNumberText "(J)" ;
.
usc-t15-ch2D:idd0412b4d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-3> ;
  fro-usc:hasContentText "It shall be unlawful for any registered investment company and any company or companies controlled by such registered investment company to purchase or otherwise acquire any security (except a security received as a dividend or as a result of a plan of reorganization of any company, other than a plan devised for the purpose of evading the provisions of this paragraph) issued by any insurance company of which such registered investment company and any company or companies controlled by such registered company do not, at the time of such purchase or acquisition, own in the aggregate at least 25 per centum of the total outstanding voting stock, if such registered company and any company or companies controlled by it own in the aggregate, or as a result of such purchase or acquisition will own in the aggregate, more than 10 per centum of the total outstanding voting stock of such insurance company." ;
  fro-usc:hasId "idd0412b4d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0412b4e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-4> ;
  fro-usc:hasContentText "It shall be unlawful for any registered investment company and any company or companies controlled by such registered investment company to purchase or otherwise acquire any security issued by or any other interest in the business of any person who is a broker, a dealer, is engaged in the business of underwriting, or is either an investment adviser of an investment company or an investment adviser registered under subchapter II of this chapter, unless (A) such person is a corporation all the outstanding securities of which (other than short-term paper, securities representing bank loans, and directors’ qualifying shares) are, or after such acquisition will be, owned by one or more registered investment companies; and (B) such person is primarily engaged in the business of underwriting and distributing securities issued by other persons, selling securities to customers, or any one or more of such or related activities, and the gross income of such person normally is derived principally from such business or related activities." ;
  fro-usc:hasId "idd0412b4e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd043743f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0437440-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0437441-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0437442-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-6> ;
  fro-usc:hasHeading "Acquisition of securities issued by corporations in business of underwriting, furnishing capital to industry, etc." ;
  fro-usc:hasId "idd043743f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-14-6-2> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-14-6-6> ;
.
usc-t15-ch2D:idd0437440-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-6-3> ;
  fro-usc:hasContentText "That the securities issued by such corporation (other than short-term paper and securities representing bank loans) shall consist solely of one class of common stock and shall have been originally issued or sold for investment to registered investment companies only;" ;
  fro-usc:hasId "idd0437440-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/e/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0437441-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-6-4> ;
  fro-usc:hasContentText "That the aggregate cost of the securities of such corporation purchased by such registered investment company does not exceed 5 per centum of the value of the total assets of such registered company at the time of any purchase or acquisition of such securities; and" ;
  fro-usc:hasId "idd0437441-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/e/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0437442-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-6-5> ;
  fro-usc:hasContentText "That the aggregate paid-in capital and surplus of such corporation does not exceed $100,000,000." ;
  fro-usc:hasId "idd0437442-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/e/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0437443-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-7> ;
  fro-usc:hasContentText "Notwithstanding any provisions of this chapter, any registered face-amount certificate company may organize not more than two face-amount certificate companies and acquire and own all or any part of the capital stock thereof only if such stock is acquired and held for investment: Provided . Nothing contained in this subsection shall be deemed to prevent the sale of any such stock to any other person if the original purchase was made by such registered face-amount certificate company in good faith for investment and not for resale. , That the aggregate cost to such registered company of all such stock so acquired shall not exceed six times the amount of the minimum capital stock requirement provided in subdivision (1) of subsection (a) of section 80a–28 of this title for a face-amount company organized on or after March 15, 1940 : And provided further , That the aggregate cost to such registered company of all such capital stock issued by face-amount certificate companies organized or otherwise created under laws other than the laws of the United States or any State thereof shall not exceed twice the amount of the minimum capital stock requirement provided in subdivision (1) of subsection (a) of said section 80a–28 for a company organized on or after March 15, 1940" ;
  fro-usc:hasHeading "Organization and ownership by one registered face-amount certificate company of all or part of capital stock of not more than two other face-amount certificate companies; limitations" ;
  fro-usc:hasId "idd0437443-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/f" ;
  fro-usc:hasNumberText "(f)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–28" ;
.
usc-t15-ch2D:idd0437444-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-8> ;
  fro-usc:hasContentText "Notwithstanding the provisions of this section any registered investment company and any company or companies controlled by such registered company may purchase or otherwise acquire from another investment company or any company or companies controlled by such registered company more than 10 per centum of the total outstanding voting stock of any insurance company owned by any such company or companies, or may acquire the securities of any insurance company if the Commission by order determines that such acquisition is in the public interest because the financial condition of such insurance company will be improved as a result of such acquisition or any plan contemplated as a result thereof. This section shall not be deemed to prohibit the promotion of a new insurance company or the acquisition of the securities of any newly created insurance company by a registered investment company, alone or with other persons. Nothing contained in this section shall in any way affect or derogate from the powers of any insurance commissioner or similar official or agency of the United States or any State, or to affect the right under State law of any insurance company to acquire securities of any other insurance company or insurance companies." ;
  fro-usc:hasHeading "Exceptions to limitation on ownership by investment company of securities of insurance com­pany" ;
  fro-usc:hasId "idd0437444-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/g" ;
  fro-usc:hasNumberText "(g)" ;
.
