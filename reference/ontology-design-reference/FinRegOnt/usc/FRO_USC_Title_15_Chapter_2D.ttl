  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-4-10-2-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd051cc9c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3/i/1/A" ;
