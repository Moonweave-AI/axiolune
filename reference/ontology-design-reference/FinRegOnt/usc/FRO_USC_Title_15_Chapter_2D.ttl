.
usc-t15-ch2D:idd056871f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-7-4-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd056871f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Securities Exchange Act of 1934, referred to in text, is act June 6, 1934, ch. 404 , 48 Stat. 881 , which is classified principally to chapter 2B (§ 78a et seq.) of this title. For complete classification of this Act to the Code, see section 78a of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
