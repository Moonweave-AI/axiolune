.
usc-t15-ch2D:idd0412b2f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-1-2> ;
  fro-usc:hasContentText "more than 3 per centum of the total outstanding voting stock of the acquired company;" ;
  fro-usc:hasId "idd0412b2f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd0412b30-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-1-3> ;
  fro-usc:hasContentText "securities issued by the acquired company having an aggregate value in excess of 5 per centum of the value of the total assets of the acquiring company; or" ;
  fro-usc:hasId "idd0412b30-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0412b31-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-1-4> ;
  fro-usc:hasContentText "securities issued by the acquired company and all other investment companies (other than treasury stock of the acquiring company) having an aggregate value in excess of 10 per centum of the value of the total assets of the acquiring company." ;
  fro-usc:hasId "idd0412b31-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
.
usc-t15-ch2D:idd0412b32-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-2> ;
  fro-usc:hasId "idd0412b32-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-14-5-2-2-1> ;
  lkif-mereo:component usc-t15-ch2D:idd0412b33-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412b34-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412b33-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-2-2> ;
  fro-usc:hasContentText "more than 3 per centum of the total outstanding voting stock of the acquired company is owned by the acquiring company and any company or companies controlled by it; or" ;
  fro-usc:hasId "idd0412b33-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd0412b34-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-2-3> ;
  fro-usc:hasContentText "more than 10 per centum of the total outstanding voting stock of the acquired company is owned by the acquiring company and other investment companies and companies controlled by them." ;
  fro-usc:hasId "idd0412b34-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0412b35-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-3> ;
  fro-usc:hasContentText "It shall be unlawful for any investment company (the “acquiring company”) and any company or companies controlled by the acquiring company to purchase or otherwise acquire any security issued by a registered closed-end investment company, if immediately after such purchase or acquisition the acquiring company, other investment companies having the same investment adviser, and companies controlled by such investment companies, own more than 10 per centum of the total outstanding voting stock of such closed-end company." ;
  fro-usc:hasId "idd0412b35-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd0412b36-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-4> ;
  fro-usc:hasContentText "The provisions of this paragraph shall not apply to a security received as a dividend or as a result of an offer of exchange approved pursuant to section 80a–11 of this title or of a plan of reorganization of any company (other than a plan devised for the purpose of evading the foregoing provisions)." ;
  fro-usc:hasId "idd0412b36-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/D" ;
  fro-usc:hasNumberText "(D)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–11" ;
.
usc-t15-ch2D:idd0412b37-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-5> ;
  fro-usc:hasId "idd0412b37-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/E" ;
  fro-usc:hasNumberText "(E)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-14-5-2-5-1> ;
  lkif-mereo:component usc-t15-ch2D:idd0412b38-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412b39-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412b3a-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412b38-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-5-2> ;
  fro-usc:hasContentText "the depositor of, or principal underwriter for, such investment company is a broker or dealer registered under the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], or a person controlled by such a broker or dealer;" ;
  fro-usc:hasId "idd0412b38-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/E/i" ;
  fro-usc:hasNumberText "(i)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
.
usc-t15-ch2D:idd0412b39-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-5-3> ;
  fro-usc:hasContentText "such security is the only investment security held by such investment company (or such securities are the only investment securities held by such investment company, if such investment company is a registered unit investment trust that issues two or more classes or series of securities, each of which provides for the accumulation of shares of a different investment company); and" ;
  fro-usc:hasId "idd0412b39-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d/1/E/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd0412b3a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5-2-5-4> ;
  fro-usc:hasId "idd0412b3a-0c74-11e6-aa53-e455a13f2ad9" ;
