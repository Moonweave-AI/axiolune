usc-t15-ch2D:idd04aa108-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-37-6-4> ;
  fro-usc:hasHeading "Transfer of Functions" ;
  fro-usc:hasId "idd04aa108-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "For transfer of functions of Securities and Exchange Commission, with certain exceptions, to Chairman of such Commission, see Reorg. Plan No. 10 of 1950, §§ 1, 2, eff. May 24, 1950 , 15 F.R. 3175, 64 Stat. 1265 , set out under section 78d of this title ." ;
  fro-usc:hasNoteTopic "transferOfFunctions" ;
  fro-usc:hasReferenceText "/us/stat/64/1265" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78d" ;
.
usc-t15-ch2D:idd04aa109-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:hasSequenceNumber 38 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-38> ;
  fro-usc:hasContentText "Whoever steals, unlawfully abstracts, unlawfully and willfully converts to his own use or to the use of another, or embezzles any of the moneys, funds, securities, credits, property, or assets of any registered investment company shall be deemed guilty of a crime, and upon conviction thereof shall be subject to the penalties provided in section 80a–48 of this title . A judgment of conviction or acquittal on the merits under the laws of any State shall be a bar to any prosecution under this section for the same act or acts." ;
  fro-usc:hasHeading "Larceny and embezzlement" ;
  fro-usc:hasId "idd04aa109-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–36" ;
  fro-usc:hasNumberText "§ 80a–36." ;
  lkif-mereo:component usc-t15-ch2D:idd04aa10a-0c74-11e6-aa53-e455a13f2ad9 ;
.
