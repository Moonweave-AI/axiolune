.
usc-t15-ch2D:idd0412b26-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b27-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b28-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b29-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-2> ;
  fro-usc:hasHeading "Purchase of securities on margin; joint trading accounts; short sales of securities; exceptions" ;
  fro-usc:hasId "idd0412b26-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-14-2-2> ;
.
usc-t15-ch2D:idd0412b27-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-2-3> ;
  fro-usc:hasContentText "to purchase any security on margin, except such short-term credits as are necessary for the clearance of transactions;" ;
  fro-usc:hasId "idd0412b27-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0412b28-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-2-4> ;
  fro-usc:hasContentText "to participate on a joint or a joint and several basis in any trading account in securities, except in connection with an underwriting in which such registered company is a participant; or" ;
  fro-usc:hasId "idd0412b28-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/a/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0412b29-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-2-5> ;
  fro-usc:hasContentText "to effect a short sale of any security, except in connection with an underwriting in which such registered company is a participant." ;
  fro-usc:hasId "idd0412b29-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0412b2a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-3> ;
  fro-usc:hasContentText "It shall be unlawful for any registered open-end company (other than a company complying with the provisions of section 80a–10(d) of this title ) to act as a distributor of securities of which it is the issuer, except through an underwriter, in contravention of such rules and regulations as the Commission may prescribe as necessary or appropriate in the public interest or for the protection of investors." ;
  fro-usc:hasHeading "Distribution by investment company of securities of which it is issuer" ;
  fro-usc:hasId "idd0412b2a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–10/d" ;
.
usc-t15-ch2D:idd0412b2b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-4> ;
  fro-usc:hasContentText "It shall be unlawful for any registered diversified company to make any commitment as underwriter, if immediately thereafter the amount of its outstanding underwriting commitments, plus the value of its investments in securities of issuers (other than investment companies) of which it owns more than 10 per centum of the outstanding voting securities, exceeds 25 per centum of the value of its total assets." ;
  fro-usc:hasHeading "Limitations on commitments as underwriter" ;
  fro-usc:hasId "idd0412b2b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd0412b2c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b2d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b4d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b4e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-14-5> ;
  fro-usc:hasHeading "Limitations on acquisition by investment companies of securities of other specific businesses" ;
  fro-usc:hasId "idd0412b2c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–12/d" ;
  fro-usc:hasNumberText "(d)" ;
.
