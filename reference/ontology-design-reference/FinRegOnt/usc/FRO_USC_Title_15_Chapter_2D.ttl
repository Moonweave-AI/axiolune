.
usc-t15-ch2D:idd04d1178-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-50-4-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd04d1178-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1975— Pub. L. 94–29 substituted “or imprisoned not more than five years” for “or imprisoned not more than two years”." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/94/29" ;
.
usc-t15-ch2D:idd04d1179-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-50-4-1> ;
  fro-usc:hasHeading "Effective Date of 1975 Amendment" ;
