  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-24-7-2> ;
  fro-usc:hasHeading "Effective Date of 1996 Amendment" ;
  fro-usc:hasId "idd058f8e2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Amendment by Pub. L. 104–290 effective 270 days after Oct. 11, 1996 , see section 308(a) of Pub. L. 104–290 , as amended, set out as a note under section 80b–2 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
