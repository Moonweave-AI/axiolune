.
usc-t15-ch2D:idd0543de4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-3-2-3> ;
  fro-usc:hasContentText "that is registered under section 80b–3 of this title as an investment adviser, or that is a supervised person of such person, except that a State may license, register, or otherwise qualify any investment adviser representative who has a place of business located within that State;" ;
  fro-usc:hasId "idd0543de4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/b/1/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3" ;
.
usc-t15-ch2D:idd0543de5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-3-2-4> ;
  fro-usc:hasContentText "that is not registered under section 80b–3 of this title because that person is excepted from the definition of an investment adviser under section 80b–2(a)(11) of this title ; or" ;
  fro-usc:hasId "idd0543de5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/b/1/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–2/a/11" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3" ;
.
usc-t15-ch2D:idd0543de6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-3-2-5> ;
  fro-usc:hasContentText "that is not registered under section 80b–3 of this title because that person is exempt from registration as provided in subsection (b)(7) of such section, or is a supervised person of such person." ;
  fro-usc:hasId "idd0543de6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/b/1/C" ;
  fro-usc:hasNumberText "(C)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3" ;
.
usc-t15-ch2D:idd0543de7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-3-3> ;
  fro-usc:hasContentText "Nothing in this subsection shall prohibit the securities commission (or any agency or office performing like functions) of any State from investigating and bringing enforcement actions with respect to fraud or deceit against an investment adviser or person associated with an investment adviser." ;
  fro-usc:hasHeading "Limitation" ;
  fro-usc:hasId "idd0543de7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/b/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd0543de8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-4> ;
  fro-usc:hasContentText "Notwithstanding subsection (a), the Commission, by rule or regulation upon its own motion, or by order upon application, may permit the registration with the Commission of any person or class of persons to which the application of subsection (a) would be unfair, a burden on interstate commerce, or otherwise inconsistent with the purposes of this section." ;
  fro-usc:hasHeading "Exemptions" ;
  fro-usc:hasId "idd0543de8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd0543de9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-5> ;
  fro-usc:hasContentText "Upon request of the securities commissioner (or any agency or officer performing like functions) of any State, the Commission may provide such training, technical assistance, or other reasonable assistance in connection with the regulation of investment advisers by the State." ;
  fro-usc:hasHeading "State assistance" ;
  fro-usc:hasId "idd0543de9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/d" ;
  fro-usc:hasNumberText "(d)" ;
.
usc-t15-ch2D:idd0543dea-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-usc:hasId "idd0543dea-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/104/290/tIII" ;
  fro-usc:hasReferenceText "/us/pl/109/290" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIV" ;
  fro-usc:hasReferenceText "/us/pl/114/94/dG/tLXXIV" ;
  fro-usc:hasReferenceText "/us/stat/110/3437" ;
  fro-usc:hasReferenceText "/us/stat/120/1321" ;
  fro-usc:hasReferenceText "/us/stat/124/1576" ;
  fro-usc:hasReferenceText "/us/stat/129/1786" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 , § 7(b)(1), Sept. 29, 2006 , 120 Stat. 1321 ; Pub. L. 111–203, title IV , § 410, July 21, 2010 , 124 Stat. 1576 ; Pub. L. 114–94, div. G, title LXXIV , § 74003, Dec. 4, 2015 , 129 Stat. 1786 .) , title II, § 203A, as added Pub. L. 104–290, title III , § 303(a), Oct. 11, 1996 , 110 Stat. 3437 ; amended Pub. L. 109–290" ;
.
usc-t15-ch2D:idd0543dec-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-7-0> ;
  fro-usc:hasHeading "References in Text" ;
  fro-usc:hasId "idd0543dec-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "The Investment Company Act of 1940, referred to in subsec. (a)(2)(A), is title I of act Aug. 22, 1940, ch. 686 , 54 Stat. 789 , which is classified generally to subchapter I (§ 80a–1 et seq.) of this chapter. For complete classification of this Act to the Code, see section 80a–51 of this title and Tables." ;
  fro-usc:hasNoteTopic "referencesInText" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/stat/54/789" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–51" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd04d1183-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0543ded-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-7-1> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd0543ded-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "2006—Subsecs. (d), (e). Pub. L. 109–290 redesignated subsec. (e) as (d) and struck out heading and text of former subsec. (d). Text read as follows: “The Commission may, by rule, require an investment adviser—" ;
  fro-usc:hasNoteText "2010—Subsec. (a)(2), (3). Pub. L. 111–203 added par. (2) and redesignated former par. (2) as (3)." ;
  fro-usc:hasNoteText "2015—Subsec. (b)(1)(C). Pub. L. 114–94 added subpar. (C)." ;
  fro-usc:hasNoteText "“(1) to file with the Commission any fee, application, report, or notice required by this subchapter or by the rules issued under this subchapter through any entity designated by the Commission for that purpose; and" ;
  fro-usc:hasNoteText "“(2) to pay the reasonable costs associated with such filing.”" ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/109/290" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/114/94" ;
.
usc-t15-ch2D:idd0543dee-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-7-2> ;
  fro-usc:hasHeading "Effective Date of 2010 Amendment" ;
  fro-usc:hasId "idd0543dee-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Amendment by Pub. L. 111–203 effective 1 year after July 21, 2010 , except that any investment adviser may, at the discretion of the investment adviser, register with the Commission under the Investment Advisers Act of 1940 during that 1-year period, subject to the rules of the Commission, and except as otherwise provided, see section 419 of Pub. L. 111–203 , set out as a note under section 80b–2 of this title ." ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s419" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–2" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd04f5b21-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0543def-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 3 ;
