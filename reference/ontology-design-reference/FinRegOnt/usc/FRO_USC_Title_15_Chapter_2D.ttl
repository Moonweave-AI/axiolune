usc-t15-ch2D:idd0485658-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-28-9-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd0485658-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1970—Subsecs. (b) to (d). Pub. L. 91–547 added subsec. (b), redesignated former subsec. (b) as (c), struck out “at the effective date of this subchapter” before “comply”, substituted “contract of agreement” for “contract or agreement”, and redesignated former subsec. (c) as (d)." ;
  fro-usc:hasNoteText "1987—Subsec. (b). Pub. L. 100–181 , § 618, substituted “intended” for “intend”." ;
  fro-usc:hasNoteText "1996—Subsec. (e). Pub. L. 104–290 added subsec. (e)." ;
  fro-usc:hasNoteText "1999—Subsecs. (b) to (f). Pub. L. 106–102 added subsec. (b) and redesignated former subsecs. (b) to (e) as (c) to (f), respectively." ;
  fro-usc:hasNoteText "Subsec. (c). Pub. L. 100–181 , § 619, substituted “contract or agreement” for “contract of agreement”." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/100/181" ;
  fro-usc:hasReferenceText "/us/pl/104/290" ;
  fro-usc:hasReferenceText "/us/pl/106/102" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
.
