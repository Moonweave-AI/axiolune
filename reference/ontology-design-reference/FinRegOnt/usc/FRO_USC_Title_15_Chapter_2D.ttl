usc-t15-ch2D:idd04aa0d8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-34-3> ;
  fro-usc:hasContentText "is delivered to such company or party defendant, such document shall be filed with the Commission not later than ten days after the receipt thereof; or" ;
  fro-usc:hasId "idd04aa0d8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–32/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd04aa0d9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-34-4> ;
  fro-usc:hasContentText "is filed in such court or delivered by such company or party defendant, such documents shall be filed with the Commission not later than five days after such filing or delivery." ;
  fro-usc:hasId "idd04aa0d9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–32/B" ;
  fro-usc:hasNumberText "(B)" ;
.
