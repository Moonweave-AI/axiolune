usc-t15-ch2D:idd0412aba-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412abb-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412abc-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412abd-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-2> ;
  fro-usc:hasHeading "Persons deemed ineligible for service with investment companies, etc.; investment adviser" ;
  fro-usc:hasId "idd0412aba-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-11-2-2> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-11-2-6> ;
.
usc-t15-ch2D:idd0412abb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-2-3> ;
  fro-usc:hasContentText "any person who within 10 years has been convicted of any felony or misdemeanor involving the purchase or sale of any security or arising out of such person’s conduct as an underwriter, broker, dealer, investment adviser, municipal securities dealer, government securities broker, government securities dealer, bank, transfer agent, credit rating agency, or entity or person required to be registered under the Commodity Exchange Act [ 7 U.S.C. 1 et seq.], or as an affiliated person, salesman, or employee of any investment company, bank, insurance company, or entity or person required to be registered under the Commodity Exchange Act;" ;
  fro-usc:hasId "idd0412abb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/a/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
usc-t15-ch2D:idd0412abc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-2-4> ;
  fro-usc:hasContentText "any person who, by reason of any misconduct, is permanently or temporarily enjoined by order, judgment, or decree of any court of competent jurisdiction from acting as an underwriter, broker, dealer, investment adviser, municipal securities dealer, government securities broker, government securities dealer, bank, transfer agent, credit rating agency, or entity or person required to be registered under the Commodity Exchange Act [ 7 U.S.C. 1 et seq.], or as an affiliated person, salesman, or employee of any investment company, bank, insurance company, or entity or person required to be registered under the Commodity Exchange Act, or from engaging in or continuing any conduct or practice in connection with any such activity or in connection with the purchase or sale of any security; or" ;
  fro-usc:hasId "idd0412abc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
usc-t15-ch2D:idd0412abd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-2-5> ;
  fro-usc:hasContentText "a company any affiliated person of which is ineligible, by reason of paragraph (1) or (2) of this subsection, to serve or act in the foregoing capacities." ;
  fro-usc:hasId "idd0412abd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0412abe-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412abf-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ac0-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ac1-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ac2-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ac6-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ac7-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-3> ;
  fro-usc:hasHeading "Certain persons serving investment companies; administrative action of Commission" ;
  fro-usc:hasId "idd0412abe-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/b" ;
  fro-usc:hasNumberText "(b)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-11-3-2> ;
.
usc-t15-ch2D:idd0412abf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-3-3> ;
  fro-usc:hasContentText "has willfully made or caused to be made in any registration statement, application or report filed with the Commission under this subchapter any statement which was at the time and in the light of the circumstances under which it was made false or misleading with respect to any material fact, or has omitted to state in any such registration statement, application, or report any material fact which was required to be stated therein;" ;
  fro-usc:hasId "idd0412abf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/b/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd0412ac0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-3-4> ;
  fro-usc:hasContentText "has willfully violated any provision of the Securities Act of 1933 [ 15 U.S.C. 77a et seq.], or of the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], or of subchapter II of this chapter, or of this subchapter, or of the Commodity Exchange Act [ 7 U.S.C. 1 et seq.], or of any rule or regulation under any of such statutes;" ;
  fro-usc:hasId "idd0412ac0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/b/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
usc-t15-ch2D:idd0412ac1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-3-5> ;
  fro-usc:hasContentText "has willfully aided, abetted, counseled, commanded, induced, or procured the violation by any other person of the Securities Act of 1933 [ 15 U.S.C. 77a et seq.], or of the Securities Exchange Act of 1934 [ 15 U.S.C. 78a et seq.], or of subchapter II of this chapter, or of this subchapter, or of the Commodity Exchange Act [ 7 U.S.C. 1 et seq.], or of any rule or regulation under any of such statutes;" ;
  fro-usc:hasId "idd0412ac1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/b/3" ;
  fro-usc:hasNumberText "(3)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77a" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78a" ;
  fro-usc:hasReferenceText "/us/usc/t7/s1" ;
.
usc-t15-ch2D:idd0412ac2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-3-6> ;
  fro-usc:hasId "idd0412ac2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/b/4" ;
  fro-usc:hasNumberText "(4)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-11-3-6-1> ;
  lkif-mereo:component usc-t15-ch2D:idd0412ac3-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412ac4-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0412ac5-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412ac3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-3-6-2> ;
  fro-usc:hasContentText "made or caused to be made in any application for registration or report required to be filed with a foreign securities authority, or in any proceeding before a foreign securities authority with respect to registration, any statement that was at the time and in light of the circumstances under which it was made false or misleading with respect to any material fact, or has omitted to state in any application or report to a foreign securities authority any material fact that is required to be stated therein;" ;
  fro-usc:hasId "idd0412ac3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/b/4/A" ;
  fro-usc:hasNumberText "(A)" ;
.
usc-t15-ch2D:idd0412ac4-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-3-6-3> ;
  fro-usc:hasContentText "violated any foreign statute or regulation regarding transactions in securities or contracts of sale of a commodity for future delivery traded on or subject to the rules of a contract market or any board of trade; or" ;
  fro-usc:hasId "idd0412ac4-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/b/4/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd0412ac5-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-3-6-4> ;
  fro-usc:hasContentText "aided, abetted, counseled, commanded, induced, or procured the violation by any other person of any foreign statute or regulation regarding transactions in securities or contracts of sale of a commodity for future delivery traded on or subject to the rules of a contract market or any board of trade;" ;
  fro-usc:hasId "idd0412ac5-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/b/4/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd0412ac6-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-3-7> ;
  fro-usc:hasContentText "within 10 years has been convicted by a foreign court of competent jurisdiction of a crime, however denominated by the laws of the relevant foreign government, that is substantially equivalent to an offense set forth in paragraph (1) of subsection (a); or" ;
  fro-usc:hasId "idd0412ac6-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/b/5" ;
  fro-usc:hasNumberText "(5)" ;
.
usc-t15-ch2D:idd0412ac7-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-3-8> ;
  fro-usc:hasContentText "by reason of any misconduct, is temporarily or permanently enjoined by any foreign court of competent jurisdiction from acting in any of the capacities, set forth in paragraph (2) of subsection (a), or a substantially equivalent foreign capacity, or from engaging in or continuing any conduct or practice in connection with any such activity or in connection with the purchase or sale of any security." ;
  fro-usc:hasId "idd0412ac7-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/b/6" ;
  fro-usc:hasNumberText "(6)" ;
.
usc-t15-ch2D:idd0412ac8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-11-4> ;
  fro-usc:hasContentText "Any person who is ineligible, by reason of subsection (a), to serve or act in the capacities enumerated in such subsection, may file with the Commission an application for an exemption from the provisions of such subsection. The Commission shall by order grant such application, either unconditionally or on an appropriate temporary or other conditional basis, if it is established that the prohibitions of such subsection (a) as applied to such person, are unduly or disproportionately severe or that the conduct of such person has been such as not to make it against the public interest or protection of investors to grant such application." ;
  fro-usc:hasHeading "Application of ineligible person for exemption" ;
  fro-usc:hasId "idd0412ac8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–9/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd0412ac9-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412aca-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ad2-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412ad8-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412adf-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 5 ;
