  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-31-3> ;
  fro-usc:hasHeading "Semi-annual or quarterly filing of information; copies of periodic or interim reports sent to security holders" ;
  fro-usc:hasId "idd04856a5-0c74-11e6-aa53-e455a13f2ad9" ;
