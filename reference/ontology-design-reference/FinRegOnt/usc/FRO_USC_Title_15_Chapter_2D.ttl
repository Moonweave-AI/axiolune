usc-t15-ch2D:idd03eb96b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb96c-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb96d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb96e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb96f-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb970-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2> ;
  fro-usc:hasHeading "Exemption of specified investment companies" ;
  fro-usc:hasId "idd03eb96b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a" ;
  fro-usc:hasNumberText "(a)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-8-2-2> ;
.
usc-t15-ch2D:idd03eb96c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-3> ;
  fro-usc:hasContentText "Any company organized or otherwise created under the laws of and having its principal office and place of business in Puerto Rico, the Virgin Islands, or any other possession of the United States; but such exemption shall terminate if any security of which such company is the issuer is offered for sale or sold after the effective date of this subchapter, by such company or an underwriter therefor, to a resident of any State other than the State in which such company is organized." ;
  fro-usc:hasId "idd03eb96c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd03eb96d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-4> ;
  fro-usc:hasContentText "Any company which since the effective date of this subchapter or within five years prior to such date has been reorganized under the supervision of a court of competent jurisdiction, if (A) such company was not an investment company at the commencement of such reorganization proceedings, (B) at the conclusion of such proceedings all outstanding securities of such company were owned by creditors of such company or by persons to whom such securities were issued on account of creditors’ claims, and (C) more than 50 per centum of the voting securities of such company, and securities representing more than 50 per centum of the net asset value of such company, are currently owned beneficially by not more than twenty-five persons; but such exemption shall terminate if any security of which such company is the issuer is offered for sale or sold to the public after the conclusion of such proceedings by the issuer or by or through any underwriter. For the purposes of this paragraph, any new company organized as part of the reorganization shall be deemed the same company as its predecessor; and beneficial ownership shall be determined in the manner provided in section 80a–3(c)(1) of this title ." ;
  fro-usc:hasId "idd03eb96d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/1" ;
.
usc-t15-ch2D:idd03eb96e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-5> ;
  fro-usc:hasContentText "Any issuer as to which there is outstanding a writing filed with the Commission by the Federal Savings and Loan Insurance Corporation stating that exemption of such issuer from the provisions of this subchapter is consistent with the public interest and the protection of investors and is necessary or appropriate by reason of the fact that such issuer holds or proposes to acquire any assets or any product of any assets which have been segregated (A) from assets of any company which at the filing of such writing is an insured institution within the meaning of section 1724(a)  1 of title 12, or (B) as a part of or in connection with any plan for or condition to the insurance of accounts of any company by said corporation or the conversion of any company into a Federal savings and loan association. Any such writing shall expire when canceled by a writing similarly filed or at the expiration of two years after the date of its filing, whichever first occurs; but said corporation may, nevertheless, before, at, or after the expiration of any such writing file another writing or writings with respect to such issuer." ;
  fro-usc:hasId "idd03eb96e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd03eb96f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-6> ;
  fro-usc:hasContentText "Any company which prior to March 15, 1940 , was and now is a wholly-owned subsidiary of a registered face-amount certificate company and was prior to said date and now is organized and operating under the insurance laws of any State and subject to supervision and examination by the insurance commissioner thereof, and which prior to March 15, 1940 , was and now is engaged, subject to such laws, in business substantially all of which consists of issuing and selling only to residents of such State and investing the proceeds from, securities providing for or representing participations or interests in intangible assets consisting of mortgages or other liens on real estate or notes or bonds secured thereby or in a fund or deposit of mortgages or other liens on real estate or notes or bonds secured thereby or having outstanding such securities so issued and sold." ;
  fro-usc:hasId "idd03eb96f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/4" ;
  fro-usc:hasNumberText "(4)" ;
.
usc-t15-ch2D:idd03eb970-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7> ;
  fro-usc:hasId "idd03eb970-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5" ;
  fro-usc:hasNumberText "(5)" ;
  lkif-mereo:component usc-t15-ch2D:idd03eb971-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03eb978-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03eb979-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03eb97a-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03eb97b-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03eb971-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-1> ;
  fro-usc:hasId "idd03eb971-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-8-2-7-1-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03eb972-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03eb973-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03eb974-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03eb975-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03eb972-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-1-2> ;
  fro-usc:hasContentText "the organizational documents of the company state that the activities of the company are limited to the promotion of economic, business, or industrial development in the State through the provision of financial or managerial assistance to enterprises doing business, or proposing to do business, in that State, and such other activities that are incidental or necessary to carry out that purpose;" ;
  fro-usc:hasId "idd03eb972-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/A/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd03eb973-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-1-3> ;
  fro-usc:hasContentText "immediately following each sale of the securities of the company by the company or any underwriter for the company, not less than 80 percent of the securities of the company being offered in such sale, on a class-by-class basis, are held by persons who reside or who have a substantial business presence in that State;" ;
  fro-usc:hasId "idd03eb973-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/A/ii" ;
  fro-usc:hasNumberText "(ii)" ;
.
usc-t15-ch2D:idd03eb974-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-1-4> ;
  fro-usc:hasContentText "the securities of the company are sold, or proposed to be sold, by the company or by any underwriter for the company, solely to accredited investors, as that term is defined in section 77b(a)(15) of this title , or to such other persons that the Commission, as necessary or appropriate in the public interest and consistent with the protection of investors, may permit by rule, regulation, or order; and" ;
  fro-usc:hasId "idd03eb974-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/A/iii" ;
  fro-usc:hasNumberText "(iii)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s77b/a/15" ;
.
usc-t15-ch2D:idd03eb975-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-1-5> ;
  fro-usc:hasId "idd03eb975-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/A/iv" ;
  fro-usc:hasNumberText "(iv)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-8-2-7-1-5-1> ;
  lkif-mereo:component usc-t15-ch2D:idd03eb976-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd03eb977-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd03eb976-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-1-5-2> ;
  fro-usc:hasContentText "any debt security that meets such standards of credit-worthiness as the Commission shall adopt; or" ;
  fro-usc:hasId "idd03eb976-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/A/iv/I" ;
  fro-usc:hasNumberText "(I)" ;
.
usc-t15-ch2D:idd03eb977-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-1-5-3> ;
  fro-usc:hasContentText "any security issued by a registered open-end investment company that is required by its investment policies to invest not less than 65 percent of its total assets in securities described in subclause (I) or securities that are determined by such registered open-end investment company to be comparable in quality to securities described in subclause (I)." ;
  fro-usc:hasId "idd03eb977-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/A/iv/II" ;
  fro-usc:hasNumberText "(II)" ;
.
usc-t15-ch2D:idd03eb978-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-2> ;
  fro-usc:hasContentText "Notwithstanding the exemption provided by this paragraph, section 80a–9 of this title (and, to the extent necessary to enforce section 80a–9 of this title , sections 80a–37 through 80a–50 of this title) shall apply to a company described in this paragraph as if the company were an investment company registered under this subchapter." ;
  fro-usc:hasId "idd03eb978-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–9" ;
.
usc-t15-ch2D:idd03eb979-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-3> ;
  fro-usc:hasContentText "Any company proposing to rely on the exemption provided by this paragraph shall file with the Commission a notification stating that the company intends to do so, in such form and manner as the Commission may prescribe by rule." ;
  fro-usc:hasId "idd03eb979-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/C" ;
  fro-usc:hasNumberText "(C)" ;
.
usc-t15-ch2D:idd03eb97a-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-4> ;
  fro-usc:hasContentText "Any company meeting the requirements of this paragraph may rely on the exemption provided by this paragraph upon filing with the Commission the notification required by subparagraph (C), until such time as the Commission determines by order that such reliance is not in the public interest or is not consistent with the protection of investors." ;
  fro-usc:hasId "idd03eb97a-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/D" ;
  fro-usc:hasNumberText "(D)" ;
.
usc-t15-ch2D:idd03eb97b-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-2-7-5> ;
  fro-usc:hasContentText "The exemption provided by this paragraph may be subject to such additional terms and conditions as the Commission may by rule, regulation, or order determine are necessary or appropriate in the public interest or for the protection of investors." ;
  fro-usc:hasId "idd03eb97b-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/a/5/E" ;
  fro-usc:hasNumberText "(E)" ;
.
usc-t15-ch2D:idd03eb97c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-3> ;
  fro-usc:hasContentText "Upon application by any employees’ security company, the Commission shall by order exempt such company from the provisions of this subchapter and of the rules and regulations hereunder, if and to the extent that such exemption is consistent with the protection of investors. In determining the provisions to which such an order of exemption shall apply, the Commission shall give due weight, among other things, to the form of organization and the capital structure of such company, the persons by whom its voting securities, evidences of indebtedness, and other securities are owned and controlled, the prices at which securities issued by such company are sold and the sales load thereon, the disposition of the proceeds of such sales, the character of the securities in which such proceeds are invested, and any relationship between such company and the issuer of any such security." ;
  fro-usc:hasHeading "Exemption of employees’ security company upon application; matters considered" ;
  fro-usc:hasId "idd03eb97c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd03eb97d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-4> ;
  fro-usc:hasContentText "The Commission, by rules and regulations upon its own motion, or by order upon application, may conditionally or unconditionally exempt any person, security, or transaction, or any class or classes of persons, securities, or transactions, from any provision or provisions of this subchapter or of any rule or regulation thereunder, if and to the extent that such exemption is necessary or appropriate in the public interest and consistent with the protection of investors and the purposes fairly intended by the policy and provisions of this subchapter." ;
  fro-usc:hasHeading "Exemption of persons, securities or any class or classes of persons as necessary and appropriate in public interest" ;
  fro-usc:hasId "idd03eb97d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd03eb97e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb97f-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb980-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb981-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-5> ;
  fro-usc:hasHeading "Exemption of closed-end investment companies" ;
  fro-usc:hasId "idd03eb97e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/d" ;
  fro-usc:hasNumberText "(d)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-8-5-2> ;
.
usc-t15-ch2D:idd03eb97f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-5-3> ;
  fro-usc:hasContentText "the aggregate sums received by such company from the sale of all its outstanding securities, plus the aggregate offering price of all securities of which such company is the issuer and which it proposes to offer for sale, do not exceed $10,000,000, or such other amount as the Commission may set by rule, regulation, or order;" ;
  fro-usc:hasId "idd03eb97f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/d/1" ;
  fro-usc:hasNumberText "(1)" ;
.
usc-t15-ch2D:idd03eb980-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-5-4> ;
  fro-usc:hasContentText "no security of which such company is the issuer has been or is proposed to be sold by such company or any underwriter therefor, in connection with a public offering, to any person who is not a resident of the State under the laws of which such company is organized or otherwise created; and" ;
  fro-usc:hasId "idd03eb980-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/d/2" ;
  fro-usc:hasNumberText "(2)" ;
.
usc-t15-ch2D:idd03eb981-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-5-5> ;
  fro-usc:hasContentText "such exemption is not contrary to the public interest or inconsistent with the protection of investors." ;
  fro-usc:hasId "idd03eb981-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/d/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd03eb982-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-6> ;
  fro-usc:hasContentText "If, in connection with any rule, regulation, or order under this section exempting any investment company from any provision of section 80a–7 of this title , the Commission deems it necessary or appropriate in the public interest or for the protection of investors that certain specified provisions of this subchapter pertaining to registered investment companies shall be applicable in respect of such company, the provisions so specified shall apply to such company, and to other persons in their transactions and relations with such company, as though such company were a registered investment company." ;
  fro-usc:hasHeading "Application of certain specified provisions of subchapter to otherwise exempt companies" ;
  fro-usc:hasId "idd03eb982-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/e" ;
  fro-usc:hasNumberText "(e)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–7" ;
.
usc-t15-ch2D:idd03eb983-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb984-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd03eb985-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-7> ;
  fro-usc:hasHeading "Exemption of closed-end company treated as business development company" ;
  fro-usc:hasId "idd03eb983-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/f" ;
  fro-usc:hasNumberText "(f)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-3-8-7-2> ;
  fro-usc:refers_toContinuation <fro-usc-t15-ch2D:r-1-0-4-3-8-7-5> ;
.
usc-t15-ch2D:idd03eb984-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-7-3> ;
  fro-usc:hasContentText "elects to be treated as a business development company pursuant to section 80a–53 of this title ; or" ;
  fro-usc:hasId "idd03eb984-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/f/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–53" ;
.
usc-t15-ch2D:idd03eb985-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-8-7-4> ;
  fro-usc:hasContentText "would be excluded from the definition of an investment company by section 80a–3(c)(1) of this title , except that it presently proposes to make a public offering of its securities as a business development company, and has notified the Commission, in a form and manner which the Commission may, by rule, prescribe, that it intends in good faith to file, within 90 days, a notification of election to become subject to the provisions of sections 80a–54 through 80a–64 of this title," ;
  fro-usc:hasId "idd03eb985-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–6/f/2" ;
  fro-usc:hasNumberText "(2)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–3/c/1" ;
.
usc-t15-ch2D:idd03eb986-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-usc:hasId "idd03eb986-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/100/181/tVI" ;
  fro-usc:hasReferenceText "/us/pl/104/290/tV" ;
  fro-usc:hasReferenceText "/us/pl/111/203/tIX" ;
