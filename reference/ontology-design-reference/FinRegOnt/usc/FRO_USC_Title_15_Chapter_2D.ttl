  fro-usc:hasContentText "For purposes of this section, the term “appropriate Federal banking agency” shall have the same meaning as given in section 1813 of title 12 ." ;
  fro-usc:hasHeading "Definition" ;
  fro-usc:hasId "idd058f887-0c74-11e6-aa53-e455a13f2ad9" ;
