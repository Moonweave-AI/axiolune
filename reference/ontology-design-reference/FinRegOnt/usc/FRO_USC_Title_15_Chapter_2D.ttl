  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-15-2-2-2-2> ;
  fro-usc:hasContentText "bank holding company or savings and loan holding company;" ;
  fro-usc:hasId "idd058f880-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–10a/a/1/A/i" ;
