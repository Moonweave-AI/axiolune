usc-t15-ch2D:idd0412b1c-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Section ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b1d-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b1e-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0412b1f-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0412b22-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0412b23-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:refers_toNote usc-t15-ch2D:idd0412b24-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-13> ;
  fro-usc:hasHeading "Offers to exchange securities" ;
  fro-usc:hasId "idd0412b1c-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–11" ;
  fro-usc:hasNumberText "§ 80a–11." ;
  lkif-mereo:component usc-t15-ch2D:idd0412b20-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0412b1d-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-13-2> ;
  fro-usc:hasContentText "It shall be unlawful for any registered open-end company or any principal underwriter for such a company to make or cause to be made an offer to the holder of a security of such company or of any other open-end investment company to exchange his security for a security in the same or another such company on any basis other than the relative net asset values of the respective securities to be exchanged, unless the terms of the offer have first been submitted to and approved by the Commission or are in accordance with such rules and regulations as the Commission may have prescribed in respect of such offers which are in effect at the time such offer is made. For the purposes of this section, (A) an offer by a principal underwriter means an offer communicated to holders of securities of a class or series but does not include an offer made by such principal underwriter to an individual investor in the course of a retail business conducted by such principal underwriter, and (B) the net asset value means the net asset value which is in effect for the purpose of determining the price at which the securities, or class or series of securities involved, are offered for sale to the public either (1) at the time of the receipt by the offeror of the acceptance of the offer or (2) at such later times as is specified in the offer." ;
  fro-usc:hasHeading "Approval by Commission for exchanges of securities on basis other than relative net asset value" ;
  fro-usc:hasId "idd0412b1d-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–11/a" ;
  fro-usc:hasNumberText "(a)" ;
.
usc-t15-ch2D:idd0412b1e-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-13-3> ;
  fro-usc:hasContentText "The provisions of this section shall not apply to any offer made pursuant to any plan of reorganization, which is submitted to and requires the approval of the holders of at least a majority of the outstanding shares of the class or series to which the security owned by the offeree belongs." ;
  fro-usc:hasHeading "Application of section to offers pursuant to plan of reorganization" ;
  fro-usc:hasId "idd0412b1e-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–11/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd0412b1f-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-13-4> ;
  fro-usc:hasContentText "The provisions of subsection (a) shall be applicable, irrespective of the basis of exchange, (1) to any offer of exchange of any security of a registered open-end company for a security of a registered unit investment trust or registered face-amount certificate company; and (2) to any type of offer of exchange of the securities of registered unit investment trusts or registered face-amount certificate companies for the securities of any other investment company." ;
  fro-usc:hasHeading "Application of section to specific exchange offers" ;
  fro-usc:hasId "idd0412b1f-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80a–11/c" ;
  fro-usc:hasNumberText "(c)" ;
.
usc-t15-ch2D:idd0412b20-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_SourceCredit ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-usc:hasId "idd0412b20-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasReferenceText "/us/act/1940-08-22/ch686" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
  fro-usc:hasReferenceText "/us/stat/54/808" ;
  fro-usc:hasReferenceText "/us/stat/84/1417" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 .) , title I, § 11, 54 Stat. 808 ; Pub. L. 91–547 , § 6, Dec. 14, 1970 , 84 Stat. 1417" ;
.
usc-t15-ch2D:idd0412b22-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-3-13-6-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd0412b22-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1970—Subsec. (b). Pub. L. 91–547 struck out item (1) designation of existing provisions and item (2) provision for nonapplication of this section to any offer made pursuant to the right of conversion, at the option of the holder, from one class or series into another class or series of securities issued by the same company upon such terms as are specified in the charter, certificate of incorporation, articles of association, by-laws, or trust indenture subject to which the securities to be converted were issued or are to be issued." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/91/547" ;
.
