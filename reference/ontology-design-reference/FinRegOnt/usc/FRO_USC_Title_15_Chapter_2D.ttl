usc-t15-ch2D:idd0543dd8-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-2-2-3> ;
  fro-usc:hasContentText "has assets under management of not less than $25,000,000, or such higher amount as the Commission may, by rule, deem appropriate in accordance with the purposes of this subchapter; or" ;
  fro-usc:hasId "idd0543dd8-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/a/1/A" ;
  fro-usc:hasNumberText "(A)" ;
.
