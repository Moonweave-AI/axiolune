usc-t15-ch2D:idd058f8e0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-24-7-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd058f8e0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1996— Pub. L. 104–290 substituted “regulation” for “control” in section catchline and amended text generally, designating existing provisions as subsec. (a), inserting heading, and adding subsecs. (b) to (d)." ;
  fro-usc:hasNoteText "1998—Subsec. (b)(2). Pub. L. 105–353 substituted “principal” for “principle”." ;
  fro-usc:hasNoteText "2010—Subsecs. (b), (c). Pub. L. 111–203 substituted “principal office and place of business” for “principal place of business” wherever appearing." ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/104/290" ;
  fro-usc:hasReferenceText "/us/pl/105/353" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
.
