  fro-usc:hasReferenceText "/us/stat/124/2646" ;
  fro-usc:hasReferenceText "/us/stat/54/854" ;
  fro-usc:hasReferenceText "/us/stat/74/887" ;
  fro-usc:hasSourceCreditText "( Aug. 22, 1940, ch. 686 ; Pub. L. 101–550, title II , § 202(b)(2), Nov. 15, 1990 , 104 Stat. 2715 ; Pub. L. 111–203, title IV , § 405, title IX, § 929I(c), July 21, 2010 , 124 Stat. 1574 , 1858; Pub. L. 111–257 , § 1(c), Oct. 5, 2010 , 124 Stat. 2646 .) , title II, § 210, 54 Stat. 854 ; Pub. L. 86–750 , § 13, Sept. 13, 1960 , 74 Stat. 887" ;
.
usc-t15-ch2D:idd058f877-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-14-6-0> ;
  fro-usc:hasHeading "Amendments" ;
  fro-usc:hasId "idd058f877-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "1960—Subsec. (b). Pub. L. 86–750 inserted “, or any member, officer, or employee thereof,” after “the Commission”, and inserted proscription against disclosing information to any person not a member, officer, or employee of the Commission." ;
  fro-usc:hasNoteText "1990—Subsec. (b). Pub. L. 101–550 substituted “subsections (c) and (d) of section 80b–9 of this title and section 78x(c) of this title ” for “subsections (c) and (e) of section 80b–9 of this title ”." ;
  fro-usc:hasNoteText "2010—Subsec. (c). Pub. L. 111–203 , § 405, inserted “or for purposes of assessment of potential systemic risk” before period at end." ;
  fro-usc:hasNoteText "Pub. L. 111–203 , § 929I(c), added subsec. (d)." ;
  fro-usc:hasNoteText "Subsec. (d). Pub. L. 111–257 .” struck out subsec. (d). Text read as follows: “Notwithstanding any other provision of law, the Commission shall not be compelled to disclose any records or information provided to the Commission under section 80b–4 of this title , or records or information based upon or derived from such records or information, if such records or information have been obtained by the Commission for use in furtherance of the purposes of this subchapter, including surveillance, risk assessments, or other regulatory and oversight activities. Nothing in this subsection authorizes the Commission to withhold information from the Congress or prevent the Commission from complying with a request for information from any other Federal department or agency requesting the information for purposes within the scope of jurisdiction of that department or agency, or complying with an order of a court of the United States in an action brought by the United States or the Commission. For purposes of section 552 of title 5 , this subsection shall be considered a statute described in subsection (b)(3)(B) of such section 552. Collection of information pursuant to section 80b–4 of this title shall be an administrative action involving an agency against specific individuals or agencies pursuant to section 3518(c)(1) of title 44" ;
  fro-usc:hasNoteTopic "amendments" ;
  fro-usc:hasReferenceText "/us/pl/101/550" ;
  fro-usc:hasReferenceText "/us/pl/111/203" ;
  fro-usc:hasReferenceText "/us/pl/111/257" ;
  fro-usc:hasReferenceText "/us/pl/86/750" ;
  fro-usc:hasReferenceText "/us/usc/t15/s78x/c" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–4" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–9" ;
  fro-usc:hasReferenceText "/us/usc/t44/s3518/c/1" ;
  fro-usc:hasReferenceText "/us/usc/t5/s552" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd0543df1-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd058f853-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd058f878-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Note ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-14-6-1> ;
  fro-usc:hasHeading "Effective Date of 2010 Amendment" ;
  fro-usc:hasId "idd058f878-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasNoteText "Amendment by section 405 of Pub. L. 111–203 effective 1 year after July 21, 2010 , except that any investment adviser may, at the discretion of the investment adviser, register with the Commission under the Investment Advisers Act of 1940 during that 1-year period, subject to the rules of the Commission, and except as otherwise provided, see section 419 of Pub. L. 111–203 , set out as a note under section 80b–2 of this title ." ;
  fro-usc:hasNoteText "Amendment by section 929I(c) of Pub. L. 111–203 effective 1 day after July 21, 2010 , except as otherwise provided, see section 4 of Pub. L. 111–203 , set out as an Effective Date note under section 5301 of Title 12 , Banks and Banking." ;
  fro-usc:hasNoteTopic "effectiveDateOfAmendment" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s4" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s405" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s419" ;
  fro-usc:hasReferenceText "/us/pl/111/203/s929I/c" ;
  fro-usc:hasReferenceText "/us/usc/t12/s5301" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–2" ;
  fro-usc:refers_toLevel usc-t15-ch2D:idd04f5b21-0c74-11e6-aa53-e455a13f2ad9 ;
.
