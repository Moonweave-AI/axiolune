  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-2-2-4> ;
  fro-usc:hasContentText "is an adviser to an investment company registered under subchapter I of this chapter." ;
  fro-usc:hasId "idd0543dd9-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/a/1/B" ;
  fro-usc:hasNumberText "(B)" ;
.
usc-t15-ch2D:idd0543dda-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-2-3> ;
  fro-usc:hasHeading "Treatment of mid-sized investment advisers" ;
  fro-usc:hasId "idd0543dda-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/a/2" ;
  fro-usc:hasNumberText "(2)" ;
  lkif-mereo:component usc-t15-ch2D:idd0543ddb-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0543ddc-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0543ddb-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-2-3-2> ;
  fro-usc:hasContentText "No investment adviser described in subparagraph (B) shall register under section 80b–3 of this title , unless the investment adviser is an adviser to an investment company registered under the Investment Company Act of 1940 [ 15 U.S.C. 80a–1 et seq.], or a company which has elected to be a business development company pursuant to section 54 of the Investment Company Act of 1940 [ 15 U.S.C. 80a–53 ], and has not withdrawn the election, except that, if by effect of this paragraph an investment adviser would be required to register with 15 or more States, then the adviser may register under section 80b–3 of this title ." ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd0543ddb-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/a/2/A" ;
  fro-usc:hasNumberText "(A)" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–1" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80a–53" ;
  fro-usc:hasReferenceText "/us/usc/t15/s80b–3" ;
.
usc-t15-ch2D:idd0543ddc-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subparagraph ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-2-3-3> ;
  fro-usc:hasHeading "Covered persons" ;
  fro-usc:hasId "idd0543ddc-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/a/2/B" ;
  fro-usc:hasNumberText "(B)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-5-2-3-3-2> ;
  lkif-mereo:component usc-t15-ch2D:idd0543ddd-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0543dde-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0543ddd-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-2-3-3-3> ;
  fro-usc:hasContentText "is required to be registered as an investment adviser with the securities commissioner (or any agency or office performing like functions) of the State in which it maintains its principal office and place of business and, if registered, would be subject to examination as an investment adviser by any such commissioner, agency, or office; and" ;
  fro-usc:hasId "idd0543ddd-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/a/2/B/i" ;
  fro-usc:hasNumberText "(i)" ;
.
usc-t15-ch2D:idd0543dde-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Clause ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-2-3-3-4> ;
  fro-usc:hasId "idd0543dde-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/a/2/B/ii" ;
  fro-usc:hasNumberText "(ii)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-5-2-3-3-4-1> ;
  lkif-mereo:component usc-t15-ch2D:idd0543ddf-0c74-11e6-aa53-e455a13f2ad9 ;
  lkif-mereo:component usc-t15-ch2D:idd0543de0-0c74-11e6-aa53-e455a13f2ad9 ;
.
usc-t15-ch2D:idd0543ddf-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-2-3-3-4-2> ;
  fro-usc:hasContentText "the amount specified under subparagraph (A) of paragraph (1), as such amount may have been adjusted by the Commission pursuant to that subparagraph; and" ;
  fro-usc:hasId "idd0543ddf-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/a/2/B/ii/I" ;
  fro-usc:hasNumberText "(I)" ;
.
usc-t15-ch2D:idd0543de0-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subclause ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-2-3-3-4-3> ;
  fro-usc:hasContentText "$100,000,000, or such higher amount as the Commission may, by rule, deem appropriate in accordance with the purposes of this subchapter." ;
  fro-usc:hasId "idd0543de0-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/a/2/B/ii/II" ;
  fro-usc:hasNumberText "(II)" ;
.
usc-t15-ch2D:idd0543de1-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-2-4> ;
  fro-usc:hasContentText "For purposes of this subsection, the term “assets under management” means the securities portfolios with respect to which an investment adviser provides continuous and regular supervisory or management services." ;
  fro-usc:hasHeading "“Assets under management” defined" ;
  fro-usc:hasId "idd0543de1-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/a/3" ;
  fro-usc:hasNumberText "(3)" ;
.
usc-t15-ch2D:idd0543de2-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Subsection ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0543de3-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:divided_by usc-t15-ch2D:idd0543de7-0c74-11e6-aa53-e455a13f2ad9 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-3> ;
  fro-usc:hasHeading "Advisers subject to Commission authority" ;
  fro-usc:hasId "idd0543de2-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/b" ;
  fro-usc:hasNumberText "(b)" ;
.
usc-t15-ch2D:idd0543de3-0c74-11e6-aa53-e455a13f2ad9
  rdf:type fro-usc:USC_Paragraph ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-ref:hasSourceInstance <http://finregont.com/fro/usc/USC-2015-title15-chapter2D.ttl#r-1-0-4-4-5-3-2> ;
  fro-usc:hasHeading "In general" ;
  fro-usc:hasId "idd0543de3-0c74-11e6-aa53-e455a13f2ad9" ;
  fro-usc:hasIdentifierText "/us/usc/t15/s80b–3a/b/1" ;
  fro-usc:hasNumberText "(1)" ;
  fro-usc:refers_toChapeau <fro-usc-t15-ch2D:r-1-0-4-4-5-3-2-2> ;
  lkif-mereo:component usc-t15-ch2D:idd0543de4-0c74-11e6-aa53-e455a13f2ad9 ;
