# baseURI: http://finregont.com/fro/xbrl/enum/extensible-enumerations.ttl
# imports: http://finregont.com/fro/xbrl/instance.ttl
# prefix: extensible-enumerations

@prefix dct: <http://purl.org/dc/terms/> .
@prefix extensible-enumerations: <http://finregont.com/fro/xbrl/enum/extensible-enumerations.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/enum/extensible-enumerations.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description "An RDF/OWL version of the XBRL extensible enumerations. The ontology add a subclass of XBRL instance non-numeric item attributes."^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL taxonomy: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:comment "enumerationItemType specializes QNameItemType. The content of a fact of this type MUST be a QName denoting an xbrl concept in the xbrli:item substitution group and which appears in the domain of enumeration values identified by the attributes on the enumerationItemType."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  owl:imports <http://finregont.com/fro/xbrl/instance.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2014/extensible-enumerations"^^xsd:string ;
.
extensible-enumerations:EnumerationItemType
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2014/extensible-enumerations#enumerationItemType" ;
  rdfs:label "Enumeration item type"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/instance.ttl#NonNumericItemAttrs> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/instance.ttl#QNameItemType> ;
.
extensible-enumerations:contextRefValue
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "http://xbrl.org/2014/extensible-enumerations#contextRef" ;
  rdfs:label "context ref value"^^xsd:string ;
.
extensible-enumerations:id
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "http://xbrl.org/2014/extensible-enumerations#id" ;
  rdfs:label "id"^^xsd:string ;
.
