xlink:ArcType-type
  rdf:type owl:Class ;
  rdfs:comment "Enumeration of values for the type attribute"^^xsd:string ;
  rdfs:label "Arc type-type"^^xsd:string ;
  rdfs:subClassOf dtype:EnumeratedValue ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
