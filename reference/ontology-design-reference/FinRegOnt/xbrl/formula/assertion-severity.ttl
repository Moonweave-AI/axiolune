# baseURI: http://finregont.com/fro/xbrl/formula/assertion-severity.ttl
# imports: http://finregont.com/fro/xbrl/XLink.ttl
# prefix: assertion-severity

@prefix assertion-severity: <http://finregont.com/fro/xbrl/formula/assertion-severity.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/formula/assertion-severity.ttl>
  rdf:type owl:Ontology ;
  <http://purl.org/dc/terms/creator> "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  <http://purl.org/dc/terms/description> "An RDF/OWL version of the XBRL assertion severity schema file. An assertion is either satisfied or not satisfied. The severity lets the taxonomy assigns a level of importance to the assertion. There are 3 ontology classes for this purpose: Error, OK and Warning."^^xsd:string ;
  <http://purl.org/dc/terms/rights> "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  <http://purl.org/dc/terms/rights> "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL formula assertion severity schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL formula: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.xbrl.org/Specification/assertion-severity/REC-2016-04-19/assertion-severity-REC-2016-04-19.html> ;
  owl:imports <http://finregont.com/fro/xbrl/XLink.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2016/assertion-severity"^^xsd:string ;
.
assertion-severity:Error
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2016/assertion-severity#error" ;
  rdfs:label "Error"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#ResourceType> ;
.
assertion-severity:Ok
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2016/assertion-severity#ok" ;
  rdfs:label "Ok"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#ResourceType> ;
.
assertion-severity:Warning
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2016/assertion-severity#warning" ;
  rdfs:label "Warning"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#ResourceType> ;
.
<http://www.w3.org/2004/02/skos/core#prefLabel>
  rdf:type owl:AnnotationProperty ;
  rdfs:label "pref label"^^xsd:string ;
.
