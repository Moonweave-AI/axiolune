# baseURI: http://finregont.com/fro/xbrl/formula/custom-function.ttl
# imports: http://finregont.com/fro/xbrl/formula/variable.ttl
# imports: http://finregont.com/fro/xbrl/generic/generic.ttl
# prefix: custom-function

@prefix custom-function: <http://finregont.com/fro/xbrl/formula/custom-function.ttl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/formula/custom-function.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description """An RDF/OWL version of the XBRL formula schema file. A XBRL formula specifies validations based on XBRL instance facts and generation of derived data as output XBRL instance facts. Variables schema allows the taxonomy to include custom function calls. However these depend on the XBRL processor's execution. The custom function schema extends this functionality by defining a syntax to define the implementation. 
The ontology defines Implementation, Input and Step classes."""^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL custom function schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL formula: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.xbrl.org/specification/customfunctionimplementation/rec-2011-10-24/customfunctionimplementation-rec-2011-10-24.html> ;
  owl:imports <http://finregont.com/fro/xbrl/formula/variable.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/generic/generic.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2010/custom-function"^^xsd:string ;
.
custom-function:Implementation
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2010/custom-function#implementation" ;
  rdfs:label "Implementation"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource.type> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "0"^^xsd:int ;
      owl:allValuesFrom custom-function:Implementation-input ;
      owl:onProperty custom-function:inputRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "1"^^xsd:int ;
      owl:allValuesFrom custom-function:Implementation-step ;
      owl:onProperty custom-function:stepRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "2"^^xsd:int ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#Expression> ;
      owl:onProperty custom-function:outputRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty custom-function:outputRef ;
    ] ;
.
custom-function:Implementation-input
  rdf:type owl:Class ;
  rdfs:label "Implementation-input"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#QName> ;
      owl:onProperty custom-function:nameRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty custom-function:nameRef ;
    ] ;
.
custom-function:Implementation-step
  rdf:type owl:Class ;
  rdfs:label "Implementation-step"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Expression> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#QName> ;
      owl:onProperty custom-function:nameRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty custom-function:nameRef ;
    ] ;
.
custom-function:inputRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2010/custom-function#input" ;
  rdfs:label "input ref"^^xsd:string ;
.
custom-function:nameRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2010/custom-function#name" ;
  rdfs:label "name ref"^^xsd:string ;
.
custom-function:outputRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2010/custom-function#output" ;
  rdfs:label "output ref"^^xsd:string ;
.
custom-function:stepRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2010/custom-function#step" ;
  rdfs:label "step ref"^^xsd:string ;
.
<http://www.w3.org/2004/02/skos/core#prefLabel>
  rdf:type owl:AnnotationProperty ;
  rdfs:label "pref label"^^xsd:string ;
.
