# baseURI: http://finregont.com/fro/xbrl/formula/relative.ttl
# imports: http://finregont.com/fro/xbrl/formula/variable.ttl
# imports: http://finregont.com/fro/xbrl/generic/generic.ttl
# prefix: relative

@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix relative: <http://finregont.com/fro/xbrl/formula/relative.ttl#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/formula/relative.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description """An RDF/OWL version of the XBRL formula schema file. A XBRL formula specifies validations based on XBRL instance facts and generation of derived data as output XBRL instance facts. The Relative filter matches facts based on the aspect of a particular other fact.
The ontology defines the Relative Filter class as a subclass of Variable Resource."""^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL relative filter schema (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL formula: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.xbrl.org/specification/relativefilters/rec-2009-06-22/relativefilters-rec-2009-06-22.html> ;
  owl:imports <http://finregont.com/fro/xbrl/formula/variable.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/generic/generic.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2008/filter/relative"^^xsd:string ;
.
relative:RelativeFilter
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/filter/relative#relativeFilter" ;
  rdfs:label "Relative filter"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Filter> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#QName> ;
      owl:onProperty relative:variableRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty relative:variableRef ;
    ] ;
.
relative:variableRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2008/filter/relative#variable" ;
  rdfs:label "variable ref"^^xsd:string ;
.
<http://www.w3.org/2004/02/skos/core#prefLabel>
  rdf:type owl:AnnotationProperty ;
  rdfs:label "pref label"^^xsd:string ;
.
