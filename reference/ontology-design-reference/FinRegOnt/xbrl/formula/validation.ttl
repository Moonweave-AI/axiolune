# baseURI: http://finregont.com/fro/xbrl/formula/validation.ttl
# imports: http://finregont.com/fro/xbrl/formula/variable.ttl
# imports: http://finregont.com/fro/xbrl/generic/generic.ttl
# prefix: validation

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix validation: <http://finregont.com/fro/xbrl/formula/validation.ttl#> .
@prefix validation1: <http://xbrl.org/2008/validation#> .
@prefix validation2: <http://xbrl.org/2008/validation#> .
@prefix validation3: <http://xbrl.org/2008/validation#> .
@prefix variable: <http://xbrl.org/2008/variable#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/formula/validation.ttl>
  rdf:type owl:Ontology ;
  <http://purl.org/dc/terms/creator> "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  <http://purl.org/dc/terms/description> "An RDF/OWL version of the XBRL validation schema file. A XBRL formula specifies validations based on XBRL instance facts and generation of derived data as output XBRL instance facts. Validation specifies complex business rules as sets of assertions. The ontology defines classes for Assertion and Assertion Sets."^^xsd:string ;
  <http://purl.org/dc/terms/rights> "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  <http://purl.org/dc/terms/rights> "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL validation schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL formula: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.xbrl.org/specification/validation/rec-2009-06-22/validation-rec-2009-06-22.html> ;
  owl:imports <http://finregont.com/fro/xbrl/formula/variable.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/generic/generic.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2010/message/validation"^^xsd:string ;
.
validation:Assertion
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/validation#assertion" ;
  rdfs:label "Assertion"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/validation.ttl#Assertion.type> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
.
<http://finregont.com/fro/xbrl/formula/validation.ttl#Assertion.type>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/validation#assertion.type" ;
  rdfs:label "Assertion.type"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource.type> ;
.
<http://finregont.com/fro/xbrl/formula/validation.ttl#Assertion.variableSet.type>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/validation#assertion.variableSet.type" ;
  rdfs:label "Assertion.variable set.type"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource.type> ;
.
validation:AssertionSet
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/validation#assertionSet" ;
  rdfs:label "Assertion set"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/validation.ttl#AssertionSet.type> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
.
<http://finregont.com/fro/xbrl/formula/validation.ttl#AssertionSet.type>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/validation#assertionSet.type" ;
  rdfs:label "Assertion set.type"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource.type> ;
.
validation:VariableSetAssertion
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/validation#variableSetAssertion" ;
  rdfs:label "Variable set assertion"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/validation.ttl#Assertion.variableSet.type> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#VariableSet> ;
.
<http://www.w3.org/2004/02/skos/core#prefLabel>
  rdf:type owl:AnnotationProperty ;
  rdfs:label "pref label"^^xsd:string ;
.
