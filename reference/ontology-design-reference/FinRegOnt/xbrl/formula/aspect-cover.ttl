# baseURI: http://finregont.com/fro/xbrl/formula/aspect-cover.ttl
# imports: http://finregont.com/fro/xbrl/formula/variable.ttl
# imports: http://finregont.com/fro/xbrl/generic/generic.ttl
# prefix: aspect-cover

@prefix aspect-cover: <http://finregont.com/fro/xbrl/formula/aspect-cover.ttl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dtype: <http://www.linkedmodel.org/schema/dtype#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/formula/aspect-cover.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description "An RDF/OWL version of the XBRL formula schema file. A XBRL formula specifies validations based on XBRL instance facts and generation of derived data as output XBRL instance facts. The formula ontology provides classes and properties instance ontologies that include formula. Aspect filters cover aspects that govern implicit filtering and sub-partition of sequences of facts in an XBRL instance."^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL formula schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL formula: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.xbrl.org/specification/aspectcoverfilters/rec-2011-10-24/aspectcoverfilters-rec-2011-10-24.html> ;
  owl:imports <http://finregont.com/fro/xbrl/formula/variable.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/generic/generic.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2010/filter/aspect-cover"^^xsd:string ;
.
aspect-cover:AC_all
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "0"^^xsd:nonNegativeInteger ;
  dtype:value "all"^^xsd:token ;
  rdfs:label "all"^^xsd:string ;
.
aspect-cover:AC_complete-scenario
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "7"^^xsd:nonNegativeInteger ;
  dtype:value "complete-scenario"^^xsd:token ;
  rdfs:label "complete-scenario"^^xsd:string ;
.
aspect-cover:AC_complete-segment
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "6"^^xsd:nonNegativeInteger ;
  dtype:value "complete-segment"^^xsd:token ;
  rdfs:label "complete-segment"^^xsd:string ;
.
aspect-cover:AC_concept
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "1"^^xsd:nonNegativeInteger ;
  dtype:value "concept"^^xsd:token ;
  rdfs:label "concept"^^xsd:string ;
.
aspect-cover:AC_dimensions
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "10"^^xsd:nonNegativeInteger ;
  dtype:value "dimensions"^^xsd:token ;
  rdfs:label "dimensions"^^xsd:string ;
.
aspect-cover:AC_entity-identifier
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "2"^^xsd:nonNegativeInteger ;
  dtype:value "entity-identifier"^^xsd:token ;
  rdfs:label "entity-identifier"^^xsd:string ;
.
aspect-cover:AC_location
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "3"^^xsd:nonNegativeInteger ;
  dtype:value "location"^^xsd:token ;
  rdfs:label "location"^^xsd:string ;
.
aspect-cover:AC_non-XDT-scenario
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "9"^^xsd:nonNegativeInteger ;
  dtype:value "non-XDT-scenario"^^xsd:token ;
  rdfs:label "non-XDT-scenario"^^xsd:string ;
.
aspect-cover:AC_non-XDT-segment
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "8"^^xsd:nonNegativeInteger ;
  dtype:value "non-XDT-segment"^^xsd:token ;
  rdfs:label "non-XDT-segment"^^xsd:string ;
.
aspect-cover:AC_period
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "4"^^xsd:nonNegativeInteger ;
  dtype:value "period"^^xsd:token ;
  rdfs:label "period"^^xsd:string ;
.
aspect-cover:AC_unit
  rdf:type aspect-cover:AspectCover-aspect ;
  dtype:order "5"^^xsd:nonNegativeInteger ;
  dtype:value "unit"^^xsd:token ;
  rdfs:label "unit"^^xsd:string ;
.
aspect-cover:AspectCover
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2010/filter/aspect-cover#aspectCover" ;
  rdfs:label "Aspect cover"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Filter> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource.type> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "0"^^xsd:int ;
      owl:allValuesFrom aspect-cover:AspectCover-aspect ;
      owl:onProperty aspect-cover:aspectRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "1"^^xsd:int ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/aspect-cover.ttl#Dimension.model> ;
      owl:onProperty aspect-cover:dimensionRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "2"^^xsd:int ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/aspect-cover.ttl#Dimension.model> ;
      owl:onProperty aspect-cover:excludeDimensionRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty aspect-cover:aspectRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty aspect-cover:dimensionRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty aspect-cover:excludeDimensionRef ;
    ] ;
.
aspect-cover:AspectCover-aspect
  rdf:type owl:Class ;
  rdfs:label "Aspect cover-aspect"^^xsd:string ;
  rdfs:subClassOf aspect-cover:EnumeratedValue ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      owl:allValuesFrom xsd:token ;
      owl:onProperty dtype:value ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty dtype:value ;
    ] ;
  owl:oneOf (
      aspect-cover:AC_all
      aspect-cover:AC_complete-scenario
      aspect-cover:AC_complete-segment
      aspect-cover:AC_concept
      aspect-cover:AC_dimensions
      aspect-cover:AC_entity-identifier
      aspect-cover:AC_location
      aspect-cover:AC_non-XDT-scenario
      aspect-cover:AC_non-XDT-segment
      aspect-cover:AC_period
      aspect-cover:AC_unit
    ) ;
.
<http://finregont.com/fro/xbrl/formula/aspect-cover.ttl#Dimension.model>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2010/filter/aspect-cover#dimension.model" ;
  rdfs:label "Dimension.model"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "0"^^xsd:int ;
      owl:allValuesFrom xsd:QName ;
      owl:onProperty aspect-cover:qname ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "1"^^xsd:int ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#Expression> ;
      owl:onProperty aspect-cover:qnameExpressionRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty aspect-cover:qname ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty aspect-cover:qnameExpressionRef ;
    ] ;
.
aspect-cover:EnumeratedValue
  rdf:type owl:Class ;
  rdfs:label "Enumerated value"^^xsd:string ;
  rdfs:subClassOf dtype:EnumeratedValue ;
.
aspect-cover:aspectRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2010/filter/aspect-cover#aspect" ;
  rdfs:label "aspect ref"^^xsd:string ;
.
aspect-cover:dimensionRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2010/filter/aspect-cover#dimension" ;
  rdfs:label "dimension ref"^^xsd:string ;
.
aspect-cover:excludeDimensionRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2010/filter/aspect-cover#excludeDimension" ;
  rdfs:label "exclude dimension ref"^^xsd:string ;
.
aspect-cover:qname
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "http://xbrl.org/2010/filter/aspect-cover#qname" ;
  rdfs:label "qname"^^xsd:string ;
.
aspect-cover:qnameExpressionRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2010/filter/aspect-cover#qnameExpression" ;
  rdfs:label "qname expression ref"^^xsd:string ;
.
<http://finregont.com/fro/xbrl/linkbase.ttl>
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description "An RDF/OWL version of the XBRL formula schema file. A XBRL formula specifies validations based on XBRL instance facts and generation of derived data as output XBRL instance facts. The formula ontology provides classes and properties instance ontologies that include formula."^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL formula schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL formula: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
.
<http://www.w3.org/2004/02/skos/core#prefLabel>
  rdf:type owl:AnnotationProperty ;
  rdfs:label "pref label"^^xsd:string ;
.
