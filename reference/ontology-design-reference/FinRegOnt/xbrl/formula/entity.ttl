# baseURI: http://finregont.com/fro/xbrl/formula/entity.ttl
# imports: http://finregont.com/fro/xbrl/formula/variable.ttl
# imports: http://finregont.com/fro/xbrl/generic/generic.ttl
# prefix: entity

@prefix entity: <http://finregont.com/fro/xbrl/formula/entity.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/formula/entity.ttl>
  rdf:type owl:Ontology ;
  <http://purl.org/dc/terms/creator> "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  <http://purl.org/dc/terms/description> "An RDF/OWL version of the XBRL entity XSD file. A XBRL formula specifies validations based on XBRL instance facts and generation of derived data as output XBRL instance facts. The entity ontology extends Variable with filters for entity identifier. It defines classes for specific and regular expression identifier filters."^^xsd:string ;
  <http://purl.org/dc/terms/rights> "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  <http://purl.org/dc/terms/rights> "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL entity schema (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL formula: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.xbrl.org/specification/entityfilters/rec-2009-06-22/entityfilters-rec-2009-06-22.html> ;
  owl:imports <http://finregont.com/fro/xbrl/formula/variable.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/generic/generic.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2008/filter/entity"^^xsd:string ;
.
entity:Identifier
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/filter/entity#identifier" ;
  rdfs:label "Identifier"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Filter> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource.type> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#Expression> ;
      owl:onProperty entity:testRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty entity:testRef ;
    ] ;
.
entity:RegexpIdentifier
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/filter/entity#regexpIdentifier" ;
  rdfs:label "Regexp identifier"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Filter> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource.type> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty entity:pattern ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty entity:pattern ;
    ] ;
.
entity:RegexpScheme
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/filter/entity#regexpScheme" ;
  rdfs:label "Regexp scheme"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Filter> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource.type> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty entity:pattern ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty entity:pattern ;
    ] ;
.
entity:SpecificIdentifier
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/filter/entity#specificIdentifier" ;
  rdfs:label "Specific identifier"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Filter> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource.type> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#Expression> ;
      owl:onProperty entity:schemeRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#Expression> ;
      owl:onProperty entity:valueRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty entity:schemeRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty entity:valueRef ;
    ] ;
.
entity:SpecificScheme
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/filter/entity#specificScheme" ;
  rdfs:label "Specific scheme"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Filter> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource.type> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#Expression> ;
      owl:onProperty entity:schemeRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty entity:schemeRef ;
    ] ;
.
entity:pattern
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "http://xbrl.org/2008/filter/entity#pattern" ;
  rdfs:label "pattern"^^xsd:string ;
.
entity:schemeRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2008/filter/entity#scheme" ;
  rdfs:label "scheme ref"^^xsd:string ;
.
entity:testRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2008/filter/entity#test" ;
  rdfs:label "test ref"^^xsd:string ;
.
entity:valueRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2008/filter/entity#value" ;
  rdfs:label "value ref"^^xsd:string ;
.
<http://www.w3.org/2004/02/skos/core#prefLabel>
  rdf:type owl:AnnotationProperty ;
  rdfs:label "pref label"^^xsd:string ;
.
