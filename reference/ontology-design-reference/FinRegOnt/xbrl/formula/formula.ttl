# baseURI: http://finregont.com/fro/xbrl/formula/formula.ttl
# imports: http://finregont.com/fro/xbrl/formula/variable.ttl
# imports: http://finregont.com/fro/xbrl/generic/generic.ttl
# prefix: formula

@prefix dct: <http://purl.org/dc/terms/> .
@prefix dtype: <http://www.linkedmodel.org/schema/dtype#> .
@prefix formula: <http://finregont.com/fro/xbrl/formula/formula.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/formula/formula.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description "An RDF/OWL version of the XBRL formula schema file. A XBRL formula specifies validations based on XBRL instance facts and generation of derived data as output XBRL instance facts. The formula ontology provides classes and properties instance ontologies that include formula."^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL formula schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL formula: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.xbrl.org/specification/formula/rec-2009-06-22/formula-rec-2009-06-22.html> ;
  owl:imports <http://finregont.com/fro/xbrl/formula/variable.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/generic/generic.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2008/formula, http://xbrl.org/2008/formula, http://xbrl.org/2008/formula, http://xbrl.org/2008/formula"^^xsd:string ;
.
formula:A_scenario
  rdf:type <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.occ.aspect.type-occ> ;
  dtype:order "1"^^xsd:nonNegativeInteger ;
  dtype:value "scenario"^^xsd:token ;
  rdfs:label "A scenario"^^xsd:string ;
.
formula:A_segment
  rdf:type <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.occ.aspect.type-occ> ;
  dtype:order "0"^^xsd:nonNegativeInteger ;
  dtype:value "segment"^^xsd:token ;
  rdfs:label "A segment"^^xsd:string ;
.
<http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.aspect>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/formula#abstract.aspect" ;
  rdfs:label "Abstract.aspect"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.aspect.type> ;
.
<http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.aspect.type>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/formula#abstract.aspect.type" ;
  rdfs:label "Abstract.aspect.type"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#QName> ;
      owl:onProperty formula:sourceRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty formula:sourceRef ;
    ] ;
.
<http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.dimension.aspect>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/formula#abstract.dimension.aspect" ;
  rdfs:label "Abstract.dimension.aspect"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.aspect> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.dimension.aspect.type> ;
.
<http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.dimension.aspect.type>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/formula#abstract.dimension.aspect.type" ;
  rdfs:label "Abstract.dimension.aspect.type"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.aspect.type> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom xsd:QName ;
      owl:onProperty formula:dimension ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty formula:dimension ;
    ] ;
.
<http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.occ.aspect>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/formula#abstract.occ.aspect" ;
  rdfs:label "Abstract.occ.aspect"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.aspect> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.occ.aspect.type> ;
.
<http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.occ.aspect.type>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/formula#abstract.occ.aspect.type" ;
  rdfs:label "Abstract.occ.aspect.type"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.aspect.type> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.occ.aspect.type-occ> ;
      owl:onProperty formula:occRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty formula:occRef ;
    ] ;
.
<http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.occ.aspect.type-occ>
  rdf:type owl:Class ;
  rdfs:label "Abstract.occ.aspect.type-occ"^^xsd:string ;
  rdfs:subClassOf formula:EnumeratedValue ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      owl:allValuesFrom xsd:token ;
      owl:onProperty dtype:value ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty dtype:value ;
    ] ;
  owl:oneOf (
      formula:A_scenario
      formula:A_segment
    ) ;
.
formula:Aspects
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/formula#aspects" ;
  rdfs:label "Aspects"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "0"^^xsd:int ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/formula.ttl#Abstract.aspect> ;
      owl:onProperty <http://finregont.com/fro/xbrl/formula/formula.ttl#abstract.aspectRef> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#QName> ;
      owl:onProperty formula:sourceRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty formula:sourceRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:minCardinality "1"^^xsd:int ;
      owl:onProperty <http://finregont.com/fro/xbrl/formula/formula.ttl#abstract.aspectRef> ;
    ] ;
.
formula:EntityIdentifier
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/formula#entityIdentifier" ;
  rdfs:label "Entity identifier"^^xsd:string ;
