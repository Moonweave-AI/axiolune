formula:Formula
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/formula#formula" ;
  rdfs:label "Formula"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#VariableSet> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/formula/variable.ttl#VariableSet.type> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "0"^^xsd:int ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#Expression> ;
      owl:onProperty formula:precisionRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "1"^^xsd:int ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#Expression> ;
      owl:onProperty formula:decimalsRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "2"^^xsd:int ;
      owl:allValuesFrom formula:Aspects ;
      owl:onProperty formula:aspectsRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#Expression> ;
      owl:onProperty formula:valueRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/formula/variable.ttl#QName> ;
      owl:onProperty formula:sourceRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty formula:decimalsRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty formula:precisionRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
