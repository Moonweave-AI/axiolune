  rdfs:subClassOf <http://finregont.com/fro/xbrl/w3/MathML.ttl#Definition.attrib> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/w3/MathML.ttl#Cn.attlist-baseDatatype> ;
      owl:onProperty MathML:base ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/w3/MathML.ttl#Cn.attlist-type> ;
      owl:onProperty MathML:typeRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
