    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty dtype:value ;
    ] ;
  owl:oneOf (
      MathML:T_bold
      MathML:T_bold-fraktur
      MathML:T_bold-italic
      MathML:T_bold-sans-serif
      MathML:T_bold-script
      MathML:T_double-struck
      MathML:T_fraktur
      MathML:T_italic
      MathML:T_monospace
      MathML:T_normal
      MathML:T_sans-serif
      MathML:T_sans-serif-bold-italic
      MathML:T_sans-serif-italic
      MathML:T_script
    ) ;
.
