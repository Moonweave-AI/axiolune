<http://finregont.com/fro/xbrl/w3/MathML.ttl#Cn.attlist-baseDatatype>
  rdf:type rdfs:Datatype ;
  rdfs:label "Cn.attlist-base datatype"^^xsd:string ;
  rdfs:subClassOf xsd:positiveInteger ;
  owl:equivalentClass [
      rdf:type rdfs:Datatype ;
      owl:onDatatype xsd:positiveInteger ;
      owl:withRestrictions (
          [
            xsd:maxInclusive "36"^^xsd:positiveInteger ;
          ]
          [
            xsd:minInclusive "2"^^xsd:positiveInteger ;
          ]
        ) ;
    ] ;
.
<http://finregont.com/fro/xbrl/w3/MathML.ttl#Cn.attlist-type>
  rdf:type owl:Class ;
  rdfs:label "Cn.attlist-type"^^xsd:string ;
  rdfs:subClassOf MathML:EnumeratedValue ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      owl:allValuesFrom xsd:NMTOKEN ;
      owl:onProperty dtype:value ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty dtype:value ;
    ] ;
  owl:oneOf (
      MathML:C_complex-cartesian
      MathML:C_complex-polar
      MathML:C_constant
      MathML:C_e-notation
      MathML:C_integer
      MathML:C_rational
      MathML:C_real
    ) ;
