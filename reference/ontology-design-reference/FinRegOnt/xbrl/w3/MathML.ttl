<http://finregont.com/fro/xbrl/w3/MathML.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the W3 design)"^^xsd:string ;
  dct:description """An RDF/OWL version of W3 MathML schema. Mathematical Markup Language (MathML) is an application of XML for describing mathematical notations and capturing both its structure and content.
The ontology defines classes and properties for content, definition, matrix, operators, presentation and annotation."""^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  dct:rights "http://www.w3.org/Consortium/Legal/2015/doc-license"^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL table schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL taxonomy: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:comment """This is an XML Schema module for the statistical operators of content MathML.
  Author: Stéphane Dalmas, INRIA."""^^xsd:string ;
  rdfs:isDefinedBy <http://www.w3.org/TR/MathML3/> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  owl:imports <http://topbraid.org/sxml> ;
  owl:imports <http://www.linkedmodel.org/schema/dtype> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://www.w3.org/1998/Math/MathML"^^xsd:string ;
.
