MathML:Mpadded
  rdf:type owl:Class ;
  sxml:tag "http://www.w3.org/1998/Math/MathML#mpadded" ;
  rdfs:label "Mpadded"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/w3/MathML.ttl#Mpadded.type> ;
.
MathML:Mpadded-spaceDatatype
  rdf:type rdfs:Datatype ;
  rdfs:label "Mpadded-space datatype"^^xsd:string ;
  rdfs:subClassOf xsd:string ;
  owl:equivalentClass [
      rdf:type rdfs:Datatype ;
      owl:onDatatype xsd:string ;
      owl:withRestrictions (
          [
            xsd:pattern "(\\+|-)?([0-9]+|[0-9]*\\.[0-9]+)(((%?) *(width|lspace|height|depth))|(em|ex|px|in|cm|mm|pt|pc))"^^xsd:string ;
          ]
        ) ;
    ] ;
.
MathML:Mpadded-width-spaceDatatype
  rdf:type rdfs:Datatype ;
  rdfs:label "Mpadded-width-space datatype"^^xsd:string ;
  rdfs:subClassOf xsd:string ;
  owl:equivalentClass [
      rdf:type rdfs:Datatype ;
      owl:onDatatype xsd:string ;
      owl:withRestrictions (
          [
            xsd:pattern "((\\+|-)?([0-9]+|[0-9]*\\.[0-9]+)(((%?) *(width|lspace|height|depth)?)|(width|lspace|height|depth)|(em|ex|px|in|cm|mm|pt|pc)))|((veryverythin|verythin|thin|medium|thick|verythick|veryverythick)mathspace)|0"^^xsd:string ;
          ]
        ) ;
    ] ;
.
<http://finregont.com/fro/xbrl/w3/MathML.ttl#Mpadded.attlist>
  rdf:type owl:Class ;
  sxml:tag "http://www.w3.org/1998/Math/MathML#mpadded.attlist" ;
  rdfs:label "Mpadded.attlist"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/w3/MathML.ttl#Common.attrib> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom MathML:Mpadded-spaceDatatype ;
      owl:onProperty MathML:depth ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom MathML:Mpadded-spaceDatatype ;
      owl:onProperty MathML:height ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom MathML:Mpadded-spaceDatatype ;
      owl:onProperty MathML:lspace ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom MathML:Mpadded-width-spaceDatatype ;
      owl:onProperty MathML:width ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:depth ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:height ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:lspace ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:width ;
    ] ;
.
<http://finregont.com/fro/xbrl/w3/MathML.ttl#Mpadded.type>
  rdf:type owl:Class ;
  sxml:tag "http://www.w3.org/1998/Math/MathML#mpadded.type" ;
