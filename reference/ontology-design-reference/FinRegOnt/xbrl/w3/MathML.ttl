<http://finregont.com/fro/xbrl/w3/MathML.ttl#Operator.attrib-form>
  rdf:type owl:Class ;
  rdfs:label "Operator.attrib-form"^^xsd:string ;
  rdfs:subClassOf MathML:EnumeratedValue ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty dtype:value ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty dtype:value ;
    ] ;
  owl:oneOf (
      MathML:O_infix
      MathML:O_postfix
      MathML:O_prefix
    ) ;
