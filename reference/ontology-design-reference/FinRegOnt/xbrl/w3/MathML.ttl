<http://finregont.com/fro/xbrl/w3/MathML.ttl#Token-style.attrib>
  rdf:type owl:Class ;
  sxml:tag "http://www.w3.org/1998/Math/MathML#Token-style.attrib" ;
  rdfs:label "Token-style.attrib"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/w3/MathML.ttl#Token-style.attrib-mathsizeDatatype> ;
      owl:onProperty MathML:mathsize ;
    ] ;
  rdfs:subClassOf [
