      owl:onProperty MathML:mathbackground ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty MathML:mathcolor ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:mathbackground ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:mathcolor ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:mathsize ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:mathvariantRef ;
    ] ;
.
<http://finregont.com/fro/xbrl/w3/MathML.ttl#Token-style.attrib-mathsizeDatatype>
  rdf:type rdfs:Datatype ;
  rdfs:label "Token-style.attrib-mathsize datatype"^^xsd:string ;
  rdfs:subClassOf xsd:anySimpleType ;
  owl:equivalentClass [
      rdf:type rdfs:Datatype ;
      owl:onDatatype xsd:anySimpleType ;
    ] ;
.
<http://finregont.com/fro/xbrl/w3/MathML.ttl#Token-style.attrib-mathvariant>
  rdf:type owl:Class ;
  rdfs:label "Token-style.attrib-mathvariant"^^xsd:string ;
  rdfs:subClassOf MathML:EnumeratedValue ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
