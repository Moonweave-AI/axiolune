<http://finregont.com/fro/xbrl/w3/MathML.ttl#Table-alignment.attrib>
  rdf:type owl:Class ;
  sxml:tag "http://www.w3.org/1998/Math/MathML#Table-alignment.attrib" ;
  rdfs:label "Table-alignment.attrib"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      dtype:defaultValue "baseline"^^xsd:string ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/w3/MathML.ttl#Table-alignment.attrib-rowalignDatatype> ;
      owl:onProperty MathML:rowalign ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      dtype:defaultValue "center"^^xsd:string ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/w3/MathML.ttl#Table-alignment.attrib-columnalignDatatype> ;
      owl:onProperty MathML:columnalign ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty MathML:groupalign ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:columnalign ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:groupalign ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty MathML:rowalign ;
    ] ;
.
<http://finregont.com/fro/xbrl/w3/MathML.ttl#Table-alignment.attrib-columnalignDatatype>
  rdf:type rdfs:Datatype ;
  rdfs:label "Table-alignment.attrib-columnalign datatype"^^xsd:string ;
  rdfs:subClassOf xsd:string ;
  owl:equivalentClass [
      rdf:type rdfs:Datatype ;
      owl:onDatatype xsd:string ;
      owl:withRestrictions (
          [
            xsd:pattern "(left|center|right)( left| center| right)*"^^xsd:string ;
          ]
        ) ;
    ] ;
.
<http://finregont.com/fro/xbrl/w3/MathML.ttl#Table-alignment.attrib-rowalignDatatype>
  rdf:type rdfs:Datatype ;
  rdfs:label "Table-alignment.attrib-rowalign datatype"^^xsd:string ;
  rdfs:subClassOf xsd:string ;
  owl:equivalentClass [
      rdf:type rdfs:Datatype ;
      owl:onDatatype xsd:string ;
      owl:withRestrictions (
          [
            xsd:pattern "(top|bottom|center|baseline|axis)( top| bottom| center| baseline| axis)*"^^xsd:string ;
          ]
        ) ;
    ] ;
.
