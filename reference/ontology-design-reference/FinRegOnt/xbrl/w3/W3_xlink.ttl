<http://finregont.com/fro/xbrl/w3/W3_xlink.ttl>
  rdf:type owl:Ontology ;
  <http://purl.org/dc/elements/1.1/description> "XLink attribute specification"^^xsd:string ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the W3 design)"^^xsd:string ;
  dct:description """An RDF/OWL version of W3 XLink. This specification defines the XML Linking Language (XLink), which allows elements to be inserted into XML documents in order to create and describe links between resources. It uses XML syntax to create structures that can describe links similar to the simple unidirectional hyperlinks of today's HTML, as well as more sophisticated links.
The ontology defines classes, properties and individuals for Locator, Resource, Type and Arc."""^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  dct:rights "http://www.w3.org/Consortium/Legal/2015/doc-license"^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the W3 schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL taxonomy: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <http://www.w3.org/standards/xml/> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.w3.org/TR/xlink/> ;
  owl:imports <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl> ;
  owl:imports <http://topbraid.org/sxml> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://www.w3.org/1999/xlink"^^xsd:string ;
.
