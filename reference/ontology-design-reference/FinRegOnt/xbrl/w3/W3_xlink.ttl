w3-xlink:ActuateEnum
  rdf:type owl:Class ;
  <http://purl.org/dc/elements/1.1/description> "Enumeration of values for the actuate attribute"^^xsd:string ;
  sxml:tag "http://www.w3.org/1999/xlink#actuateEnum" ;
  rdfs:label "Actuate enum"^^xsd:string ;
  rdfs:subClassOf w3-xlink:EnumeratedValue ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:string ;
      owl:onProperty dtype:value ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty dtype:value ;
    ] ;
  owl:equivalentClass [
      rdf:type owl:Class ;
      owl:oneOf [
          rdf:type rdf:List ;
          rdf:first w3-xlink:AE_none ;
          rdf:rest [
              rdf:type rdf:List ;
              rdf:first w3-xlink:AE_onLoad ;
              rdf:rest [
                  rdf:type rdf:List ;
                  rdf:first w3-xlink:AE_onRequest ;
                  rdf:rest [
                      rdf:type rdf:List ;
                      rdf:first w3-xlink:AE_other ;
                      rdf:rest () ;
                    ] ;
                ] ;
            ] ;
        ] ;
    ] ;
.
