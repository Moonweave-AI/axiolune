  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#floatItemType" ;
  rdfs:label "Float item type"^^xsd:string ;
  rdfs:subClassOf instance:NumericItemAttrs ;
  rdfs:subClassOf [
