instance:DateTimeItemType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#dateTimeItemType" ;
  rdfs:label "Date time item type"^^xsd:string ;
  rdfs:subClassOf instance:NonNumericItemAttrs ;
