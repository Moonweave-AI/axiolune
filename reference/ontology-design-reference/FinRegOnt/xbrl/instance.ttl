instance:IntItemType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#intItemType" ;
  rdfs:label "Int item type"^^xsd:string ;
  rdfs:subClassOf instance:NumericItemAttrs ;
  rdfs:subClassOf [
