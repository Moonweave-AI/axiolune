instance:PrecisionTypeDatatype
  rdf:type rdfs:Datatype ;
  rdf:type owl:Class ;
  rdfs:comment """This type is used to specify the value of the 
      precision attribute on numeric items.  It consists 
      of the union of nonNegativeInteger and \"INF\" (used 
      to signify infinite precision or \"exact value\")."""^^xsd:string ;
  rdfs:label "Precision type datatype"^^xsd:string ;
  rdfs:subClassOf xsd:anySimpleType ;
