instance:EssentialNumericItemAttrs
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#essentialNumericItemAttrs" ;
  rdfs:comment "Attributes for all numeric items (fractional and non-fractional)."^^xsd:string ;
  rdfs:label "Essential numeric item attrs"^^xsd:string ;
  rdfs:subClassOf instance:ItemAttrs ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:IDREF ;
      owl:onProperty instance:unitRefValue ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:unitRefValue ;
    ] ;
.
instance:FactAttrs
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#factAttrs" ;
  rdfs:comment "Attributes for all items and tuples."^^xsd:string ;
  rdfs:label "Fact attrs"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:ID ;
      owl:onProperty instance:id ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:id ;
    ] ;
.
