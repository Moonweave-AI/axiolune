# baseURI: http://finregont.com/fro/xbrl/instance.ttl
# imports: http://finregont.com/fro/xbrl/linkbase.ttl
# prefix: instance

@prefix dct: <http://purl.org/dc/terms/> .
@prefix instance: <http://finregont.com/fro/xbrl/instance.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/instance.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description "An RDF/OWL version of the XBRL instance. The instance ontology provides context and attribute classes for XBRL instances."^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "Elements to use for facts in instances"^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL taxonomy: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  owl:imports <http://finregont.com/fro/xbrl/linkbase.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://www.xbrl.org/2003/instance"^^xsd:string ;
.
instance:AnyURIItemType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#anyURIItemType" ;
  rdfs:label "Any URIItem type"^^xsd:string ;
  rdfs:subClassOf instance:NonNumericItemAttrs ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:anyURI ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
.
instance:Base64BinaryItemType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#base64BinaryItemType" ;
  rdfs:label "Base64Binary item type"^^xsd:string ;
  rdfs:subClassOf instance:NonNumericItemAttrs ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:base64Binary ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
.
instance:BooleanItemType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#booleanItemType" ;
  rdfs:label "Boolean item type"^^xsd:string ;
  rdfs:subClassOf instance:NonNumericItemAttrs ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:boolean ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
.
instance:ByteItemType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#byteItemType" ;
  rdfs:label "Byte item type"^^xsd:string ;
  rdfs:subClassOf instance:NumericItemAttrs ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:byte ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
.
instance:Context
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#context" ;
  rdfs:comment "Used for an island of context to which facts can be related."^^xsd:string ;
  rdfs:label "Context"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:ContextEntityType ;
      owl:onProperty instance:entityRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:ContextPeriodType ;
      owl:onProperty instance:periodRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:ContextScenarioType ;
      owl:onProperty instance:scenarioRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:ID ;
      owl:onProperty instance:id ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:entityRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:id ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:periodRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:scenarioRef ;
    ] ;
.
instance:ContextEntityType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#contextEntityType" ;
  rdfs:comment """The type for the entity element, used to describe the reporting entity.
      Note that the scheme attribute is required and cannot be empty."""^^xsd:string ;
  rdfs:label "Context entity type"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:ContextEntityType-identifier ;
      owl:onProperty instance:identifierRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:Segment ;
      owl:onProperty instance:segmentRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:identifierRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:segmentRef ;
    ] ;
.
instance:ContextEntityType-identifier
  rdf:type owl:Class ;
  rdfs:label "Context entity type-identifier"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:ContextEntityType-identifier-schemeDatatype ;
      owl:onProperty instance:scheme ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:token ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:scheme ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
.
instance:ContextEntityType-identifier-schemeDatatype
  rdf:type rdfs:Datatype ;
  rdf:type owl:Class ;
  rdfs:label "Context entity type-identifier-scheme datatype"^^xsd:string ;
  rdfs:subClassOf xsd:anyURI ;
.
instance:ContextPeriodType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#contextPeriodType" ;
  rdfs:comment "The type for the period element, used to describe the reporting date info."^^xsd:string ;
  rdfs:label "Context period type"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:ContextPeriodType-forever ;
      owl:onProperty instance:foreverRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:DateUnionDatatype ;
      owl:onProperty instance:endDate ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:DateUnionDatatype ;
      owl:onProperty instance:instant ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:DateUnionDatatype ;
      owl:onProperty instance:startDate ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:endDate ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:foreverRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:instant ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:startDate ;
    ] ;
.
instance:ContextPeriodType-forever
  rdf:type owl:Class ;
  rdfs:label "Context period type-forever"^^xsd:string ;
.
instance:ContextScenarioType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#contextScenarioType" ;
  rdfs:comment "Used for the scenario under which fact have been reported."^^xsd:string ;
  rdfs:label "Context scenario type"^^xsd:string ;
.
instance:DateItemType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#dateItemType" ;
  rdfs:label "Date item type"^^xsd:string ;
  rdfs:subClassOf instance:NonNumericItemAttrs ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
