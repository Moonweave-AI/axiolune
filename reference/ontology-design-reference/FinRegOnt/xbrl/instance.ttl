    ] ;
.
instance:DateUnionDatatype
  rdf:type rdfs:Datatype ;
  rdf:type owl:Class ;
  rdfs:comment "The union of the date and dateTime simple types."^^xsd:string ;
  rdfs:label "Date union datatype"^^xsd:string ;
  rdfs:subClassOf xsd:anySimpleType ;
.
instance:DecimalItemType
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#decimalItemType" ;
  rdfs:label "Decimal item type"^^xsd:string ;
  rdfs:subClassOf instance:NumericItemAttrs ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom xsd:decimal ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty <http://finregont.com/fro/dtype/SCHEMA_dtype-v1.2.ttl#value> ;
    ] ;
.
instance:DecimalsTypeDatatype
  rdf:type rdfs:Datatype ;
  rdf:type owl:Class ;
  rdfs:comment """This type is used to specify the value of the decimals attribute 
      on numeric items.  It consists of the union of integer and \"INF\" 
      (used to signify that a number is expressed to an infinite number 
      of decimal places or \"exact value\")."""^^xsd:string ;
  rdfs:label "Decimals type datatype"^^xsd:string ;
  rdfs:subClassOf xsd:anySimpleType ;
.
instance:DenominatorDatatype
  rdf:type rdfs:Datatype ;
  rdf:type owl:Class ;
  rdfs:label "Denominator datatype"^^xsd:string ;
  rdfs:subClassOf instance:NonZeroDecimalDatatype ;
.
instance:Divide
  rdf:type owl:Class ;
  sxml:tag "http://www.xbrl.org/2003/instance#divide" ;
  rdfs:comment "Element used to represent division in units"^^xsd:string ;
  rdfs:label "Divide"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:MeasuresType ;
      owl:onProperty instance:unitDenominatorRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:allValuesFrom instance:MeasuresType ;
      owl:onProperty instance:unitNumeratorRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:unitDenominatorRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      owl:onProperty instance:unitNumeratorRef ;
    ] ;
.
