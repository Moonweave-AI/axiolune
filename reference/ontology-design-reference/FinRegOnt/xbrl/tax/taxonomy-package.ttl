      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom xsd:anyURI ;
      owl:onProperty taxon-pkg:href ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty taxon-pkg:href ;
    ] ;
.
taxon-pkg:DocumentationGroup
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2016/taxonomy-package#documentationGroup" ;
  rdfs:label "Documentation group"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "0"^^xsd:int ;
      owl:allValuesFrom taxon-pkg:StringType ;
      owl:onProperty taxon-pkg:nameRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "1"^^xsd:int ;
      owl:allValuesFrom taxon-pkg:StringType ;
      owl:onProperty taxon-pkg:descriptionRef ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
