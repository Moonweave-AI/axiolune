# baseURI: http://finregont.com/fro/xbrl/table/filter-axis.ttl
# imports: http://finregont.com/fro/xbrl/table/table.ttl
# imports: http://topbraid.org/sxsd
# prefix: filter-axis

@prefix composite: <http://www.topbraid.org/2007/05/composite.owl#> .
@prefix filter-axis: <http://finregont.com/fro/xbrl/table/filter-axis.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix sxsd: <http://topbraid.org/sxsd#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/linkbase.ttl#arcroleType>
  rdf:type owl:Class ;
  sxml:element <http://finregont.com/fro/xbrl/linkbase.ttl#arcroleType> ;
  rdfs:label "link:arcroleType" ;
.
<http://finregont.com/fro/xbrl/linkbase.ttl#definition>
  rdf:type owl:Class ;
  sxml:element <http://finregont.com/fro/xbrl/linkbase.ttl#definition> ;
  rdfs:label "link:definition" ;
.
<http://finregont.com/fro/xbrl/linkbase.ttl#usedOn>
  rdf:type owl:Class ;
  sxml:element <http://finregont.com/fro/xbrl/linkbase.ttl#usedOn> ;
  rdfs:label "link:usedOn" ;
.
<http://finregont.com/fro/xbrl/table/filter-axis.ttl>
  rdf:type owl:Ontology ;
  <http://purl.org/dc/terms/creator> "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  <http://purl.org/dc/terms/description> "An RDF/OWL version of XBRL table. The Table Linkbase provides a mechanism for taxonomy authors to define a tabular layout of facts. The resulting tables can be used for both presentation and data entry."^^xsd:string ;
  <http://purl.org/dc/terms/rights> "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  <http://purl.org/dc/terms/rights> "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL table schema file (filter-axis.xsd). The source XSD is from the EIOPA Solvency taxonomy package. XBRL specification shows filter-axis as depreciated, but we keep it for consitency with Eurofiling.  (rdfs:seeAlso)"^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.eurofiling.info/solvencyII/index.shtml> ;
  rdfs:seeAlso <https://eiopa.europa.eu/regulation-supervision/insurance/reporting-format> ;
  rdfs:seeAlso <https://specifications.xbrl.org/work-product-index-table-linkbase-table-linkbase-1.0.html> ;
  owl:imports <http://finregont.com/fro/xbrl/table/table.ttl> ;
  owl:imports <http://topbraid.org/sxsd> ;
.
filter-axis:Document
  rdf:type sxml:Document ;
  sxml:root filter-axis:r ;
.
filter-axis:arcroleURI-linkarcroleType
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "arcroleURI" ;
  rdfs:domain <http://finregont.com/fro/xbrl/linkbase.ttl#arcroleType> ;
  rdfs:label "arcroleURI" ;
.
filter-axis:cyclesAllowed-linkarcroleType
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "cyclesAllowed" ;
  rdfs:domain <http://finregont.com/fro/xbrl/linkbase.ttl#arcroleType> ;
  rdfs:label "cyclesAllowed" ;
.
filter-axis:id-element
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "id" ;
  rdfs:domain sxsd:Element ;
  rdfs:label "id" ;
.
filter-axis:id-linkarcroleType
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "id" ;
  rdfs:domain <http://finregont.com/fro/xbrl/linkbase.ttl#arcroleType> ;
  rdfs:label "id" ;
.
filter-axis:mixed-complexContent
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "mixed" ;
  rdfs:domain sxsd:ComplexContent ;
  rdfs:label "mixed" ;
.
filter-axis:r
  rdf:type sxsd:Schema ;
  filter-axis:xmlns-schema "http://www.w3.org/2001/XMLSchema" ;
  sxml:prefix "gen"^^xsd:string ;
  sxml:prefix "link"^^xsd:string ;
  sxml:prefix "table"^^xsd:string ;
  sxsd:elementFormDefault "qualified" ;
  sxsd:targetNamespace "http://xbrl.org/2011/table" ;
  composite:child filter-axis:r-0 ;
  composite:child filter-axis:r-1 ;
  composite:child filter-axis:r-2 ;
  composite:child filter-axis:r-3 ;
  composite:child filter-axis:r-4 ;
.
filter-axis:r-0
  rdf:type sxsd:Annotation ;
  composite:child filter-axis:r-0-0 ;
  composite:index "0"^^xsd:int ;
.
filter-axis:r-0-0
  rdf:type xsd:appinfo ;
  composite:child filter-axis:r-0-0-0 ;
  composite:index "0"^^xsd:int ;
.
filter-axis:r-0-0-0
  rdf:type <http://finregont.com/fro/xbrl/linkbase.ttl#arcroleType> ;
  filter-axis:arcroleURI-linkarcroleType "http://xbrl.org/arcrole/2011/axis-filter" ;
  filter-axis:cyclesAllowed-linkarcroleType "undirected" ;
  filter-axis:id-linkarcroleType "axis-filter" ;
  composite:child filter-axis:r-0-0-0-0 ;
  composite:child filter-axis:r-0-0-0-1 ;
  composite:index "0"^^xsd:int ;
.
filter-axis:r-0-0-0-0
  rdf:type <http://finregont.com/fro/xbrl/linkbase.ttl#definition> ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "filter applied to filter axis"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "0"^^xsd:int ;
.
filter-axis:r-0-0-0-1
  rdf:type <http://finregont.com/fro/xbrl/linkbase.ttl#usedOn> ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "table:axisFilterArc"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "1"^^xsd:int ;
.
filter-axis:r-1
  rdf:type sxsd:Import ;
  sxsd:namespace "http://xbrl.org/2008/generic" ;
  sxsd:schemaLocation "http://www.xbrl.org/2008/generic-link.xsd" ;
  composite:index "1"^^xsd:int ;
.
filter-axis:r-2
  rdf:type sxsd:ComplexType ;
  sxsd:name "filterAxis.type" ;
  composite:child filter-axis:r-2-0 ;
  composite:index "2"^^xsd:int ;
.
filter-axis:r-2-0
  rdf:type sxsd:ComplexContent ;
  filter-axis:mixed-complexContent "true" ;
  composite:child filter-axis:r-2-0-0 ;
  composite:index "0"^^xsd:int ;
.
filter-axis:r-2-0-0
  rdf:type sxsd:Extension ;
  sxsd:base "table:openAxis.type" ;
  composite:index "0"^^xsd:int ;
.
filter-axis:r-3
  rdf:type sxsd:Element ;
  filter-axis:id-element "xml-filter-axis" ;
  sxsd:name "filterAxis" ;
  sxsd:substitutionGroup "table:openAxis" ;
  sxsd:type "table:filterAxis.type" ;
  composite:index "3"^^xsd:int ;
.
filter-axis:r-4
  rdf:type sxsd:Element ;
  filter-axis:id-element "xml-axis-filter-arc" ;
  sxsd:name "axisFilterArc" ;
  sxsd:substitutionGroup "gen:arc" ;
  composite:child filter-axis:r-4-0 ;
  composite:index "4"^^xsd:int ;
.
filter-axis:r-4-0
  rdf:type sxsd:ComplexType ;
  composite:child filter-axis:r-4-0-0 ;
  composite:index "0"^^xsd:int ;
.
filter-axis:r-4-0-0
  rdf:type sxsd:ComplexContent ;
  composite:child filter-axis:r-4-0-0-0 ;
  composite:index "0"^^xsd:int ;
.
filter-axis:r-4-0-0-0
  rdf:type sxsd:Extension ;
  sxsd:base "gen:genericArcType" ;
  composite:child filter-axis:r-4-0-0-0-0 ;
  composite:index "0"^^xsd:int ;
.
filter-axis:r-4-0-0-0-0
  rdf:type sxsd:Attribute ;
  sxsd:name "complement" ;
  sxsd:type "boolean" ;
  sxsd:use "required" ;
  composite:index "0"^^xsd:int ;
.
filter-axis:xmlns-schema
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "xmlns" ;
  rdfs:domain sxsd:Schema ;
  rdfs:label "xmlns" ;
.
xsd:appinfo
  rdf:type owl:Class ;
  sxml:element xsd:appinfo ;
  rdfs:label "appinfo" ;
.
