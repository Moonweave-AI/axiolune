# baseURI: http://finregont.com/fro/xbrl/cube/xbrldt.ttl
# imports: http://finregont.com/fro/xbrl/instance.ttl
# prefix: xbrldt

@prefix dct: <http://purl.org/dc/terms/> .
@prefix instance: <http://finregont.com/fro/xbrl/instance.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xbrldt: <http://finregont.com/fro/xbrl/cube/xbrldt.ttl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/cube/xbrldt.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description "An RDF/OWL version of the XBRL hypercube. The ontology adds dimension item, enumerated values, context elements and hypercube items to XBRL instance."^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. adaptation for RDF/OWL in this OWL file only. "^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL taxonomy: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  owl:imports <http://finregont.com/fro/xbrl/instance.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2005/xbrldt"^^xsd:string ;
.
xbrldt:CET_scenario
  rdf:type xbrldt:contextElementType ;
  <http://www.linkedmodel.org/schema/dtype#order> "1"^^xsd:nonNegativeInteger ;
  <http://www.linkedmodel.org/schema/dtype#value> "scenario"^^xsd:token ;
  rdfs:label "scenario"^^xsd:string ;
.
xbrldt:CET_segment
  rdf:type xbrldt:contextElementType ;
  <http://www.linkedmodel.org/schema/dtype#order> "0"^^xsd:nonNegativeInteger ;
  <http://www.linkedmodel.org/schema/dtype#value> "segment"^^xsd:token ;
  rdfs:label "segment"^^xsd:string ;
.
xbrldt:EnumeratedValue
  rdf:type owl:Class ;
  rdfs:label "Enumerated value"^^xsd:string ;
  rdfs:subClassOf <http://www.linkedmodel.org/schema/dtype#EnumeratedValue> ;
.
xbrldt:contextElementType
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2005/xbrldt#contextElementType" ;
  rdfs:label "Context element type"^^xsd:string ;
  rdfs:subClassOf xbrldt:EnumeratedValue ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      owl:allValuesFrom xsd:token ;
      owl:onProperty <http://www.linkedmodel.org/schema/dtype#value> ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty <http://www.linkedmodel.org/schema/dtype#value> ;
    ] ;
  owl:oneOf (
      xbrldt:CET_scenario
      xbrldt:CET_segment
    ) ;
.
xbrldt:dimensionItem
  rdf:type owl:Class ;
  instance:periodType "duration"^^xsd:string ;
  sxml:tag "http://xbrl.org/2005/xbrldt#dimensionItem" ;
  rdfs:label "Dimension item"^^xsd:string ;
  rdfs:subClassOf instance:Item ;
  rdfs:subClassOf instance:StringItemType ;
.
xbrldt:hypercubeItem
  rdf:type owl:Class ;
  instance:periodType "duration"^^xsd:string ;
  sxml:tag "http://xbrl.org/2005/xbrldt#hypercubeItem" ;
  rdfs:label "Hypercube item"^^xsd:string ;
  rdfs:subClassOf instance:Item ;
  rdfs:subClassOf instance:StringItemType ;
.
instance:periodType
  rdf:type owl:AnnotationProperty ;
  rdfs:label "period type"^^xsd:string ;
.
<http://www.w3.org/2004/02/skos/core#prefLabel>
  rdf:type owl:AnnotationProperty ;
  rdfs:label "pref label"^^xsd:string ;
.
