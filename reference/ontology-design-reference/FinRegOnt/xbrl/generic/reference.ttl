# baseURI: http://finregont.com/fro/xbrl/generic/reference.ttl
# imports: http://finregont.com/fro/xbrl/linkbase.ttl
# prefix: reference

@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reference: <http://finregont.com/fro/xbrl/generic/reference.ttl#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/generic/reference.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description """An RDF/OWL version of the XBRL generic reference. 
This specification is an extension of the XBRL Specification [XBRL 2.1]. It specifies syntax for references that are more flexible than those defined in the XBRL Specification. Generic references can be used to associate a reference with any element.
The ontology defines Reference as a subclass of XLink Resource-type."""^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL reference schema file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL taxonomy: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.xbrl.org/specification/genericreferences/rec-2009-06-22/genericreferences-rec-2009-06-22+corrected-errata-2011-03-21.html> ;
  owl:imports <http://finregont.com/fro/xbrl/linkbase.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2008/reference"^^xsd:string ;
.
reference:Reference
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/reference#reference" ;
  rdfs:label "Reference"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Resource> ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#ResourceType> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "0"^^xsd:int ;
      rdfs:comment "Definition of the reference  part element - for use in reference  resources."^^xsd:string ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/linkbase.ttl#Part> ;
      owl:onProperty reference:partRef ;
    ] ;
.
reference:partRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2008/reference#part" ;
  rdfs:label "part ref"^^xsd:string ;
.
<http://www.w3.org/2004/02/skos/core#prefLabel>
  rdf:type owl:AnnotationProperty ;
  rdfs:label "pref label"^^xsd:string ;
.
