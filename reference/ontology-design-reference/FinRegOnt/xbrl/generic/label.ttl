# baseURI: http://finregont.com/fro/xbrl/generic/label.ttl
# imports: http://finregont.com/fro/xbrl/XLink.ttl
# imports: http://topbraid.org/sxml
# imports: http://www.linkedmodel.org/schema/dtype
# prefix: label

@prefix XLink: <http://finregont.com/fro/xbrl/XLink.ttl#> .
@prefix label: <http://finregont.com/fro/xbrl/generic/label.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/generic/label.ttl>
  rdf:type owl:Ontology ;
  <http://purl.org/dc/terms/creator> "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  <http://purl.org/dc/terms/description> """Generic Label is an extension of the XBRL Specification [XBRL 2.1]. It specifies syntax for labels that are more flexible. Generic labels can be used to associate a label with any element. Generic labels provide a syntactic foundation for XBRL extension specifications.
The ontology defines Lable as a subclass of XLink Resource-type."""^^xsd:string ;
  <http://purl.org/dc/terms/rights> "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  <http://purl.org/dc/terms/rights> "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL label file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL taxonomy: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.xbrl.org/specification/genericlabels/rec-2011-10-24/genericlabels-rec-2011-10-24.html> ;
  owl:imports <http://finregont.com/fro/xbrl/XLink.ttl> ;
  owl:imports <http://topbraid.org/sxml> ;
  owl:imports <http://www.linkedmodel.org/schema/dtype> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2008/label"^^xsd:string ;
.
label:label
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/label#label" ;
  rdfs:label "Label"^^xsd:string ;
  rdfs:subClassOf XLink:Resource ;
  rdfs:subClassOf XLink:ResourceType ;
.
<http://www.w3.org/2004/02/skos/core#prefLabel>
  rdf:type owl:AnnotationProperty ;
  rdfs:label "pref label"^^xsd:string ;
.
