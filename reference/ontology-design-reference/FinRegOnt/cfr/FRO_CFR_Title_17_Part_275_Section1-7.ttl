<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-0>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[30 FR 4129, Mar. 30, 1965]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.0-3"^^xsd:string ;
  fro-cfr:hasSectionSubject "References to rules and regulations."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-0> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-0-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "rules and regulations"^^xsd:string ;
  fro-cfr:hasParagraphText "The term"^^xsd:string ;
  fro-cfr:hasParagraphText "refers to all rules and regulations adopted by the Commission pursuant to the Act, including the forms for registration and reports and the accompanying instructions thereto."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-0> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-0-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[41 FR 39019, Sept. 14, 1976, as amended at 44 FR 4666, Jan. 23, 1979; 47 FR 58239, Dec. 30, 1982; 68 FR 42248, July 17, 2003; 76 FR 71877, Nov. 21, 2011]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.0-4"^^xsd:string ;
  fro-cfr:hasSectionSubject "General requirements of papers and applications."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1> ;
  fro-leg-ref:refers_toNote <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-5> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-10>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Verification of applications and statements of fact."^^xsd:string ;
  fro-cfr:hasParagraphText "(d)"^^xsd:string ;
  fro-cfr:hasParagraphText "Every application for an order under any provision of the Act, for which a form with instructions is not specifically prescribed and every amendment to such application, and every statement of fact formally filed in support of, or in opposition to, any application or declaration shall be verified by the person executing the same. An instrument executed on behalf of a corporation shall be verified in substantially the following form, but suitable changes may be made in such form for other kinds of companies and for individuals:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-10> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-11-0>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "State of __________________ County of __________, SS:______"^^xsd:string ;
  fro-leg-ref:hasSequenceNumber 0 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-11-0> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-11-1>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "The undersigned being duly sworn deposes and says that he has duly executed the attached __________ dated _____, 19__, for and on behalf of ____________ (Name of company); that he is the ________ (Title of officer) of such company; and that all action by stockholders, directors, and other bodies necessary to authorize deponent to execute and file such instrument has been taken. Deponent further says that he is familiar with such instrument, and the contents thereof, and that the facts therein set forth are true to the best of his knowledge, information and belief."^^xsd:string ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-11-1> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-11-4>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "Subscribed and sworn to before me a __________ (Title of officer) this _____ day of _____, 19__."^^xsd:string ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-11-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-11-5>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "official seal"^^xsd:string ;
  fro-cfr:hasParagraphText "["^^xsd:string ;
  fro-cfr:hasParagraphText "]"^^xsd:string ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-11-5> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-11-6>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "My commission expires______"^^xsd:string ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-11-6> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-12>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Statement of grounds for application."^^xsd:string ;
  fro-cfr:hasParagraphText "(e)"^^xsd:string ;
  fro-cfr:hasParagraphText "Each application should contain a brief statement of the reasons why the applicant is deemed to be entitled to the action requested with a reference to the provisions of the Act and of the rules and regulations under which application is made."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-12> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-13>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Name and address."^^xsd:string ;
  fro-cfr:hasParagraphText "(f)"^^xsd:string ;
  fro-cfr:hasParagraphText "Every application shall contain the name and address of each applicant and the name and address of any person to whom any applicant wishes any question regarding the application to be directed."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-13> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-14>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Proposed notice."^^xsd:string ;
  fro-cfr:hasParagraphText "(g)"^^xsd:string ;
  fro-cfr:hasParagraphText "A proposed notice of the proceeding initiated by the filing of the application shall accompany each application as an exhibit thereto and, if necessary, shall be modified to reflect any amendments to such application."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-14> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-15>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Definition of application."^^xsd:string ;
  fro-cfr:hasParagraphText "(h)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of this rule, an “application” means any application for an order of the Commission under the Act other than an application for registration as an investment adviser."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-15> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-16>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(i) The manually signed original (or in the case of duplicate original) one duplicate originals of all registrations, applications, statements, reports, or other documents filed under the Investment Advisers Act of 1940, as amended, shall be numbered sequentially (in addition to any internal numbering which otherwise may be present) by handwritten, typed, printed, or other legible form of notation from the facing page of the document through the last page of that document and any exhibits or attachments thereto. Further, the total number of pages contained in a numbered original shall be set forth on the first page of the document."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-16> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Filings."^^xsd:string ;
  fro-cfr:hasParagraphText "(1) All papers required to be filed with the Commission shall, unless otherwise provided by the rules and regulations, be delivered through the mails or otherwise to the Securities and Exchange Commission, Washington, DC 20549. Except as otherwise provided by the rules and regulations, such papers shall be deemed to have been filed with the Commission on the date when they are actually received by it."^^xsd:string ;
  fro-cfr:hasParagraphText "(a)"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-3>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) All filings required to be made electronically with the Investment Adviser Registration Depository (“IARD”) shall, unless otherwise provided by the rules and regulations in this part, be deemed to have been filed with the Commission upon acceptance by the IARD. Filings required to be made through the IARD on a day that the IARD is closed shall be considered timely filed with the Commission if filed with the IARD no later than the following business day."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-3> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-4>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(3) Filings required to be made through the IARD during the period in December of each year that the IARD is not available for submission of filings shall be considered timely filed with the Commission if filed with the IARD no later than the following January 7."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-5>
  rdf:type fro-cfr:CFR_Note ;
  fro-cfr:hasNoteText "Each year the IARD shuts down to filers for several days during the end of December to process renewals of state notice filings and registrations. During this period, advisers are not able to submit filings through the IARD. Check the Commission's Web site at"^^xsd:string ;
  fro-cfr:hasNoteText "for the dates of the annual IARD shutdown."^^xsd:string ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-5-1>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "http://www.sec.gov/iard"^^xsd:string ;
  fro-cfr:hasParagraphText "Each year the IARD shuts down to filers for several days during the end of December to process renewals of state notice filings and registrations. During this period, advisers are not able to submit filings through the IARD. Check the Commission's Web site at"^^xsd:string ;
  fro-cfr:hasParagraphText "for the dates of the annual IARD shutdown."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-5> ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-5-1> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-6>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Formal specifications respecting applications."^^xsd:string ;
  fro-cfr:hasParagraphText "(b)"^^xsd:string ;
  fro-cfr:hasParagraphText "Every application for an order under any provision of the Act, for which a form with instructions is not specifically prescribed, and every amendment to such application, shall be filed in quintuplicate. One copy shall be signed by the applicant, but the other four copies may have facsimile or typed signatures. Such applications shall be on paper no larger than 8"^^xsd:string ;
  fro-cfr:hasParagraphText "inches wide and, if the application is bound, it should be bound on the left side. All typewritten or printed matter (including deficits in financial statements) should be set forth in black so as to permit photocopying and microfilming."^^xsd:string ;
  fro-cfr:hasParagraphText "×11 inches in size. The left margin should be at least 1"^^xsd:string ;
  fro-cfr:hasParagraphText "×11 inches in size. To the extent that the reduction of larger documents would render them illegible, those documents may be filed on paper larger than 8"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-6> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-7>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Authorization respecting applications."^^xsd:string ;
  fro-cfr:hasParagraphText "(1) Every application for an order under any provision of the Act, for which a form with instructions is not specifically prescribed and which is executed by a corporation, partnership, or other company and filed with the Commission, shall contain a concise statement of the applicable provisions of the articles of incorporation, bylaws, or similar documents, relating to the right of the person signing and filing such application to take such action on behalf of the applicant, and a statement that all such requirements have been complied with and that the person"^^xsd:string ;
  fro-cfr:hasParagraphText "(c)"^^xsd:string ;
  fro-cfr:hasParagraphText "signing and filing the same is fully authorized to do so. If such authorization is dependent on resolutions of stockholders, directors, or other bodies, such resolutions shall be attached as an exhibit to, or the pertinent provisions thereof shall be quoted in, the application."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-7> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-8>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) If an amendment to any such application shall be filed, such amendment shall contain a similar statement or, in lieu thereof, shall state that the authorization described in the original application is applicable to the individual who signs such amendment and that such authorization still remains in effect."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-8> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1-9>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(3) When any such application or amendment is signed by an agent or attorney, the power of attorney evidencing his authority to sign shall contain similar statements and shall be filed with the Commission."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-1> ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-1-9> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-10>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[40 FR 38159, Aug. 27, 1975]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.206(3)-1"^^xsd:string ;
  fro-cfr:hasSectionSubject "Exemption of investment advisers registered as broker-dealers in connection with the provision of certain investment advisory services."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-10> ;
  fro-leg-ref:refers_toNote <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-10-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-10-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Provided, however,"^^xsd:string ;
  fro-cfr:hasParagraphText "(a) An investment adviser which is a broker or dealer registered pursuant to section 15 of the Securities Exchange Act of 1934 shall be exempt from section 206(3) in connection with any transaction in relation to which such broker or dealer is acting as an investment adviser solely (1) by means of publicly distributed written materials or publicly made oral statements; (2) by means of written materials or oral statements which do not purport to meet the objectives or needs of specific individuals or accounts; (3) through the issuance of statistical information containing no expressions of opinion as to the investment merits of a particular security; or (4) any combination of the foregoing services:"^^xsd:string ;
  fro-cfr:hasParagraphText "That such materials and oral statements include a statement that if the purchaser of the advisory communication uses the services of the adviser in connection with a sale or purchase of a security which is a subject of such communication, the adviser may act as principal for its own account or as agent for another person."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-10> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-10-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-10-3>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(b) For the purpose of this Rule, publicly distributed written materials are those which are distributed to 35 or more persons who pay for such materials, and publicly made oral statements are those made simultaneously to 35 or more persons who pay for access to such statements."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-10> ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-10-3> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-10-4>
  rdf:type fro-cfr:CFR_Note ;
  fro-cfr:hasNoteText "The requirement that the investment adviser disclose that it may act as principal or agent for another person in the sale or purchase of a security that is the subject of investment advice does not relieve the investment adviser of any disclosure obligation which, depending upon the nature of the relationship between the investment adviser and the client, may be imposed by subparagraphs (1) or (2) of section 206 or the other provisions of the federal securities laws."^^xsd:string ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-10-4-1>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "The requirement that the investment adviser disclose that it may act as principal or agent for another person in the sale or purchase of a security that is the subject of investment advice does not relieve the investment adviser of any disclosure obligation which, depending upon the nature of the relationship between the investment adviser and the client, may be imposed by subparagraphs (1) or (2) of section 206 or the other provisions of the federal securities laws."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-10-4> ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-10-4-1> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[41 FR 39020, Sept. 14, 1976, as amended at 61 FR 49962, Sept. 24, 1996]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.0-5"^^xsd:string ;
  fro-cfr:hasSectionSubject "Procedure with respect to applications and other matters."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "The procedure hereinbelow set forth will be followed with respect to any proceeding initiated by the filing of an application, or upon the Commission's own motion, pursuant to any section of"^^xsd:string ;
  fro-cfr:hasParagraphText "the Act or any rule or regulation thereunder, unless in the particular case a different procedure is provided:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-2-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2-3>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Federal Register"^^xsd:string ;
  fro-cfr:hasParagraphText "(a) Notice of the initiation of the proceeding will be published in the"^^xsd:string ;
  fro-cfr:hasParagraphText "and will indicate the earliest date upon which an order disposing of the matter may be entered. The notice will also provide that any interested person may, within the period of time specified therein, submit to the Commission in writing any facts bearing upon the desirability of a hearing on the matter and may request that a hearing be held, stating his reasons therefor and the nature of his interest in the matter."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2> ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-2-3> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2-4>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(b) An order disposing of the matter will be issued as of course following the expiration of the period of time referred to in paragraph (a) of this section, unless the Commission thereafter orders a hearing on the matter."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2> ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-2-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2-5>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(c) The Commission will order a hearing on the matter, if it appears that a hearing is necessary or appropriate in the public interest or for the protection of investors, (1) upon the request of any interested person or (2) upon its own motion."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2> ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-2-5> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2-6>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Definition of application."^^xsd:string ;
  fro-cfr:hasParagraphText "(d)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of this rule, an “application” means any application for an order of the Commission under the Act other than an application for registration as an investment adviser."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-2> ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-2-6> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[41 FR 39020, Sept. 14, 1976, as amended at 60 FR 32825, June 23, 1995]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.0-6"^^xsd:string ;
  fro-cfr:hasSectionSubject "Incorporation by reference in applications."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-3> ;
  fro-leg-ref:refers_toNote <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3-8> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(a) A person filing an application may, subject to the limitations of § 228.10(f) and § 229.10(d) of this chapter, incorporate by reference as an exhibit to such application any document or part thereof, including any financial statement or part thereof, previously or concurrently filed with the Commission pursuant to any act administered by the Commission. The incorporation may be made whether the matter incorporated was filed by such applicant or any other person. If any modification has occurred in the text of any such document since the filing thereof, the applicant shall file with the reference a statement containing the text of any such modification and the date thereof. If the number of copies of any document previously or concurrently filed with the Commission is less than the number required to be filed with the application which incorporates such document, the applicant shall file therewith as many additional copies of the document as may be necessary to meet the requirements of the application."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-3-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3-3>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(b) Notwithstanding paragraph (a) of this section, a certificate of an independent public accountant or accountants previously or concurrently filed may not be incorporated by reference in any application unless the written consent of the accountant or accountants to such incorporation is filed with the application."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3> ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-3-3> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3-4>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(c) In each case of incorporation by reference, the matter incorporated shall be clearly identified in the reference. An express statement shall be made to the effect that the specified matter is incorporated in the application at the particular place where the information is required."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3> ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-3-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3-5>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(d) Notwithstanding paragraph (a) of this section, no application shall incorporate by reference any exhibit or financial statement which (1) has been withdrawn, or (2) was filed under any act administered by the Commission in connection with a registration which has ceased to be effective, or (3) is contained in an application for registration, registration statement, or report subject, at the time of the incorporation by reference, to pending proceedings under section 8(b) (15 U.S.C. 77a-8(b)) or 8(d) (15 U.S.C. 77a-8(d)) of the Securities Act of 1933 (15 U.S.C. 77a-1 et seq.), section 8(e) (15 U.S.C. 80a-8(e)) of the Investment Company Act of 1940, section 15(b)(4)(A) (15 U.S.C. 78a-15(b)(4)(A)) of the Securities Exchange Act of 1934 (15 U.S.C. 78a-1 et seq.), section 203(e)(1) (15 U.S.C. 80b-3(e)(1)) of the Investment Advisers Act of 1940 or to an order entered under any of those sections."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3> ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-3-5> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3-6>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(e) Notwithstanding paragraph (a) of this section, the Commission may refuse to permit incorporation by reference in any case in which in its judgment such incorporation would render an application incomplete, unclear, or confusing."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3> ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-3-6> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3-7>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Definition of Application."^^xsd:string ;
  fro-cfr:hasParagraphText "(f)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of this rule, an “application” means any application for an order of the Commission under the Act other than an application for registration as an investment adviser."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3> ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-3-7> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3-8>
  rdf:type fro-cfr:CFR_Note ;
  fro-cfr:hasNoteText "Prior to incorporating by reference any document as an exhibit to an application, applicants are advised to review § 228.10(f) and § 229.10(d) of this chapter as in effect at the time the application is filed to determine whether such incorporation by reference would be permissible under that rule."^^xsd:string ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3-8-1>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "Prior to incorporating by reference any document as an exhibit to an application, applicants are advised to review § 228.10(f) and § 229.10(d) of this chapter as in effect at the time the application is filed to determine whether such incorporation by reference would be permissible under that rule."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-3-8> ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-3-8-1> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[63 FR 35515, June 30, 1998, as amended at 65 FR 57448, Sept. 22, 2000; 76 FR 43011, July 19, 2011]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.0-7"^^xsd:string ;
  fro-cfr:hasSectionSubject "Small entities under the Investment Advisers Act for purposes of the Regulatory Flexibility Act."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-10>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(B) Has the power to sell or direct the sale of 25 percent or more of a class of the corporation's voting securities."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-10> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-11>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(ii) A person is presumed to control a partnership if the person has the right to receive upon dissolution, or has contributed, 25 percent or more of the capital of the partnership."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-11> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-12>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(iii) A person is presumed to control a limited liability company (LLC) if the person:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-12> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-13>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(A) Directly or indirectly has the right to vote 25 percent or more of a class of the interests of the LLC;"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-13> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-14>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(B) Has the right to receive upon dissolution, or has contributed, 25 percent or more of the capital of the LLC; or"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-14> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-15>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(C) Is an elected manager of the LLC."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-15> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-16>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(iv) A person is presumed to control a trust if the person is a trustee or managing agent of the trust."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-16> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-17>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Total assets"^^xsd:string ;
  fro-cfr:hasParagraphText "(2)"^^xsd:string ;
  fro-cfr:hasParagraphText "means the total assets as shown on the balance sheet of the investment adviser or other person described above under paragraph (a)(3) of this section, or the balance sheet of the investment adviser or such other person with its subsidiaries consolidated, whichever is larger."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-17> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "small business"^^xsd:string ;
  fro-cfr:hasParagraphEnumText "small organization"^^xsd:string ;
  fro-cfr:hasParagraphText "(a) For purposes of Commission rulemaking in accordance with the provisions of Chapter Six of the Administrative Procedure Act (5 U.S.C. 601 et seq.) and unless otherwise defined for purposes of a particular rulemaking proceeding, the term"^^xsd:string ;
  fro-cfr:hasParagraphText "for purposes of the Investment Advisers Act of 1940 shall mean an investment adviser that:"^^xsd:string ;
  fro-cfr:hasParagraphText "or"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-3>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(1) Has assets under management, as defined under Section 203A(a)(3) of the Act (15 U.S.C. 80b-3a(a)(2)) and reported on its annual updating amendment to Form ADV (17 CFR 279.1), of less than $25 million, or such higher amount as the Commission may by rule deem appropriate under Section 203A(a)(1)(A) of the Act (15 U.S.C. 80b-3a(a)(1)(A));"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-3> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-4>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) Did not have total assets of $5 million or more on the last day of the most recent fiscal year; and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-5>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(3) Does not control, is not controlled by, and is not under common control with another investment adviser that has assets under management of $25 million or more (or such higher amount as the Commission may deem appropriate), or any person (other than a natural person) that had total assets of $5 million or more on the last day of the most recent fiscal year."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-5> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-6>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(b) For purposes of this section:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-6> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-7>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Control"^^xsd:string ;
  fro-cfr:hasParagraphText "(1)"^^xsd:string ;
  fro-cfr:hasParagraphText "means the power, directly or indirectly, to direct the management or policies of a person, whether through ownership of securities, by contract, or otherwise."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-7> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-8>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(i) A person is presumed to control a corporation if the person:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-8> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4-9>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(A) Directly or indirectly has the right to vote 25 percent or more of a class of the corporation's voting securities; or"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-4> ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-4-9> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[65 FR 57448, Sept. 22, 2000; 65 FR 81737, Dec. 27, 2000; 68 FR 42248, July 17, 2003; 73 FR 4694, Jan. 28, 2008; 75 FR 49267, Aug. 12, 2010; 76 FR 43011, July 19, 2011]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.203-1"^^xsd:string ;
  fro-cfr:hasSectionSubject "Application for investment adviser registration."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-5> ;
  fro-leg-ref:refers_toNote <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-11-1>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Federal Register"^^xsd:string ;
  fro-cfr:hasParagraphEnumText "www.fdsys.gov"^^xsd:string ;
  fro-cfr:hasParagraphText "."^^xsd:string ;
  fro-cfr:hasParagraphText "For"^^xsd:string ;
  fro-cfr:hasParagraphText "citations affecting Form ADV, see the List of CFR Sections Affected, which appears in the Finding Aids section of the printed volume and at"^^xsd:string ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-5-11-1> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Form ADV."^^xsd:string ;
  fro-cfr:hasParagraphText "(a)"^^xsd:string ;
  fro-cfr:hasParagraphText "Subject to paragraph (b), to apply for registration with the Commission as an investment adviser, you must complete Form ADV [17 CFR 279.1] by following the instructions in the form and you must file Part 1A of Form ADV and the firm brochure(s) required by Part 2A of Form ADV electronically with the Investment Adviser Registration Depository (IARD) unless you have received a hardship exemption under § 275.203-3. You are not required to file with the Commission the brochure supplements required by Part 2B of Form ADV."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-5-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-3>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Transition to electronic filing."^^xsd:string ;
  fro-cfr:hasParagraphText "(b)"^^xsd:string ;
  fro-cfr:hasParagraphText "If you apply for registration after January 1, 2011, you must file a brochure(s) that satisfies the requirements of Part 2A of Form ADV electronically with the IARD, unless you have received a continuing hardship exemption under § 275.203-3."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5> ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-5-3> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-4>
  rdf:type fro-cfr:CFR_Note ;
  fro-cfr:hasNoteText ". If you are not required to deliver a brochure to any clients, you are not required to prepare or file a brochure with the Commission. If you are not required to deliver a brochure supplement to any clients for any particular supervised person, you are not required to prepare a brochure supplement for that supervised person."^^xsd:string ;
  fro-cfr:hasNoteText "Information on how to file with the IARD is available on the Commission's Web site at"^^xsd:string ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-4-1>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "http://www.sec.gov/iard"^^xsd:string ;
  fro-cfr:hasParagraphText ". If you are not required to deliver a brochure to any clients, you are not required to prepare or file a brochure with the Commission. If you are not required to deliver a brochure supplement to any clients for any particular supervised person, you are not required to prepare a brochure supplement for that supervised person."^^xsd:string ;
  fro-cfr:hasParagraphText "Information on how to file with the IARD is available on the Commission's Web site at"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-4> ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-5-4-1> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-5>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "When filed."^^xsd:string ;
  fro-cfr:hasParagraphText "(c)"^^xsd:string ;
  fro-cfr:hasParagraphText "Each Form ADV is considered filed with the Commission upon acceptance by the IARD."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5> ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-5-5> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-6>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Filing fees."^^xsd:string ;
  fro-cfr:hasParagraphText "(d)"^^xsd:string ;
  fro-cfr:hasParagraphText "You must pay FINRA (the operator of the IARD) a filing fee. The Commission has approved the amount of the filing fee. No portion of the filing fee is refundable. Your completed application for registration will not be accepted by FINRA, and thus will not be considered filed with the Commission, until you have paid the filing fee."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5> ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-5-6> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-7>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "“Private adviser” transition rule."^^xsd:string ;
  fro-cfr:hasParagraphText "(e)"^^xsd:string ;
  fro-cfr:hasParagraphText "If you are exempt from registration with"^^xsd:string ;
  fro-cfr:hasParagraphText "the Commission as an investment adviser under, and are not registered in reliance on, section 203(b)(3) of the Act (15 U.S.C. 80b-3(b)(3)) on July 20, 2011, you are exempt from registration with the Commission as an investment adviser until March 30, 2012, provided that you:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5> ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-5-7> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-8>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(1) During the course of the preceding twelve months, have had fewer than fifteen clients; and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5> ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-5-8> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5-9>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) Neither hold yourself out generally to the public as an investment adviser nor act as an investment adviser to any investment company registered under the Investment Company Act of 1940 (15 U.S.C. 80a), or a company which has elected to be a business development company pursuant to section 54 of that Act (15 U.S.C. 80a-54) and has not withdrawn its election."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-5> ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-5-9> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[76 FR 39702, July 6, 2011]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.203(l)-1"^^xsd:string ;
  fro-cfr:hasSectionSubject "Venture capital fund defined."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6> ;
  fro-leg-ref:refers_toNote <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-27> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-10>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) Prior to December 31, 2010, has sold securities to one or more investors that are not related persons, as defined in § 275.206(4)-2(d)(7), of any investment adviser of the private fund; and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-10> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-11>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(3) Does not sell any securities to (including accepting any committed capital from) any person after July 21, 2011."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-11> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-12>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Definitions."^^xsd:string ;
  fro-cfr:hasParagraphText "(c)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of this section:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-12> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-13>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Committed capital"^^xsd:string ;
  fro-cfr:hasParagraphText "(1)"^^xsd:string ;
  fro-cfr:hasParagraphText "means any commitment pursuant to which a person is obligated to:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-13> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-14>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(i) Acquire an interest in the private fund; or"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-14> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-15>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(ii) Make capital contributions to the private fund."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-15> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-16>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Equity security"^^xsd:string ;
  fro-cfr:hasParagraphText "(2)"^^xsd:string ;
  fro-cfr:hasParagraphText "has the same meaning as in section 3(a)(11) of the Securities Exchange Act of 1934 (15 U.S.C. 78c(a)(11)) and § 240.3a11-1 of this chapter."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-16> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-17>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Qualifying investment"^^xsd:string ;
  fro-cfr:hasParagraphText "(3)"^^xsd:string ;
  fro-cfr:hasParagraphText "means:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-17> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-18>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(i) An equity security issued by a qualifying portfolio company that has been acquired directly by the private fund from the qualifying portfolio company;"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-18> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-19>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(ii) Any equity security issued by a qualifying portfolio company in exchange for an equity security issued by the qualifying portfolio company described in paragraph (c)(3)(i) of this section; or"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 19 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-19> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Venture capital fund defined."^^xsd:string ;
  fro-cfr:hasParagraphText "(a)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of section 203(l) of the Act (15 U.S.C. 80b-3(l)), a venture capital fund is any private fund that:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-20>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "equity security"^^xsd:string ;
  fro-cfr:hasParagraphText "(iii) Any equity security issued by a company of which a qualifying portfolio company is a majority-owned subsidiary, as defined in section 2(a)(24) of the Investment Company Act of 1940 (15 U.S.C. 80a-2(a)(24)), or a predecessor, and is acquired by the private fund in exchange for an"^^xsd:string ;
  fro-cfr:hasParagraphText "described in paragraph (c)(3)(i) or (c)(3)(ii) of this section."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 20 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-20> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-21>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Qualifying portfolio company"^^xsd:string ;
  fro-cfr:hasParagraphText "(4)"^^xsd:string ;
  fro-cfr:hasParagraphText "means any company that:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 21 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-21> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-22>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(i) At the time of any investment by the private fund, is not reporting or foreign traded and does not control, is not controlled by or under common control with another company, directly or indirectly, that is reporting or foreign traded;"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 22 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-22> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-23>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(ii) Does not borrow or issue debt obligations in connection with the private fund's investment in such company and distribute to the private fund the proceeds of such borrowing or issuance in exchange for the private fund's investment; and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 23 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-23> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-24>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(iii) Is not an investment company, a private fund, an issuer that would be an investment company but for the exemption provided by § 270.3a-7 of this chapter, or a commodity pool."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 24 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-24> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-25>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Reporting or foreign traded"^^xsd:string ;
  fro-cfr:hasParagraphText "(5)"^^xsd:string ;
  fro-cfr:hasParagraphText "means, with respect to a company, being subject to the reporting requirements under section 13 or 15(d) of the Securities Exchange Act of 1934 (15 U.S.C. 78m or 78o(d)), or having a security listed or traded on any exchange or organized market operating in a foreign jurisdiction."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 25 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-25> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-26>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Short-term holdings"^^xsd:string ;
  fro-cfr:hasParagraphText "(6)"^^xsd:string ;
  fro-cfr:hasParagraphText "means cash and cash equivalents, as defined in § 270.2a51-1(b)(7)(i) of this chapter, U.S. Treasuries with a remaining maturity of 60 days or less, and shares of an open-end management investment company registered under section 8 of the Investment Company Act of 1940 (15 U.S.C. 80a-8) that is regulated as a money market fund under § 270.2a-7 of this chapter."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 26 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-26> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-27>
  rdf:type fro-cfr:CFR_Note ;
  fro-cfr:hasNoteText "For purposes of this section, an investment adviser may treat as a private fund any issuer formed under the laws of a jurisdiction other than the United States that has not offered or sold its securities in the United States or to U.S. persons in a manner inconsistent with being a private fund, provided that the adviser treats the issuer as a private fund under the Act (15 U.S.C. 80b) and the rules thereunder for all purposes."^^xsd:string ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-27-1>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "For purposes of this section, an investment adviser may treat as a private fund any issuer formed under the laws of a jurisdiction other than the United States that has not offered or sold its securities in the United States or to U.S. persons in a manner inconsistent with being a private fund, provided that the adviser treats the issuer as a private fund under the Act (15 U.S.C. 80b) and the rules thereunder for all purposes."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-27> ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-27-1> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-3>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(1) Represents to investors and potential investors that it pursues a venture capital strategy;"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-3> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-4>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) Immediately after the acquisition of any asset, other than qualifying investments or short-term holdings, holds no more than 20 percent of the amount of the fund's aggregate capital contributions and uncalled committed capital in assets (other than short-term holdings) that are not qualifying investments, valued at cost or fair value, consistently applied by the fund;"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-5>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(3) Does not borrow, issue debt obligations, provide guarantees or otherwise incur leverage, in excess of 15 percent of the private fund's aggregate capital contributions and uncalled committed capital, and any such borrowing, indebtedness, guarantee or leverage is for a non-renewable term of no longer than 120 calendar days, except that any guarantee by the private fund of a qualifying portfolio company's obligations up to the amount of the value of the private fund's investment in the qualifying portfolio company is not subject to the 120 calendar day limit;"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-5> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-6>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(4) Only issues securities the terms of which do not provide a holder with any right, except in extraordinary circumstances, to withdraw, redeem or require the repurchase of such securities but may entitle holders to receive distributions made to all holders pro rata; and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-6> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-7>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(5) Is not registered under section 8 of the Investment Company Act of 1940 (15 U.S.C. 80a-8), and has not elected to be treated as a business development company pursuant to section 54 of that Act (15 U.S.C. 80a-53)."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-7> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-8>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Certain pre-existing venture capital funds."^^xsd:string ;
  fro-cfr:hasParagraphText "(b)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of section 203(l) of the Act (15 U.S.C. 80b-3(l)) and in addition to any venture capital fund as set forth in paragraph (a) of this section, a venture capital fund also includes any private fund that:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-8> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6-9>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(1) Has represented to investors and potential investors at the time of the offering of the private fund's securities that it pursues a venture capital strategy;"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-6> ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-6-9> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[76 FR 39703, July 6, 2011]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.203(m)-1"^^xsd:string ;
  fro-cfr:hasSectionSubject "Private fund adviser exemption."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7> ;
  fro-leg-ref:refers_toNote <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-18> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-10>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Assets under management"^^xsd:string ;
  fro-cfr:hasParagraphText "(1)"^^xsd:string ;
  fro-cfr:hasParagraphText "means the regulatory assets under management as determined under Item 5.F of Form ADV (§ 279.1 of this chapter)."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-10> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-11>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Place of business"^^xsd:string ;
  fro-cfr:hasParagraphText "(2)"^^xsd:string ;
  fro-cfr:hasParagraphText "has the same meaning as in § 275.222-1(a)."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-11> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-12>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Principal office and place of business"^^xsd:string ;
  fro-cfr:hasParagraphText "(3)"^^xsd:string ;
  fro-cfr:hasParagraphText "adviser direct, control, and coordinate the activities of the investment adviser."^^xsd:string ;
  fro-cfr:hasParagraphText "of an investment adviser means the executive office of the investment adviser from which the officers, partners, or managers of the investment"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-12> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-13>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Private fund assets"^^xsd:string ;
  fro-cfr:hasParagraphText "(4)"^^xsd:string ;
  fro-cfr:hasParagraphText "means the investment adviser's assets under management attributable to a qualifying private fund."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-13> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-14>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Qualifying private fund"^^xsd:string ;
  fro-cfr:hasParagraphText "(5)"^^xsd:string ;
  fro-cfr:hasParagraphText "means any private fund that is not registered under section 8 of the Investment Company Act of 1940 (15 U.S.C. 80a-8) and has not elected to be treated as a business development company pursuant to section 54 of that Act (15 U.S.C. 80a-53). For purposes of this section, an investment adviser may treat as a private fund an issuer that qualifies for an exclusion from the definition of an “investment company,” as defined in section 3 of the Investment Company Act of 1940 (15 U.S.C. 80a-3), in addition to those provided by section 3(c)(1) or 3(c)(7) of that Act (15 U.S.C. 80a-3(c)(1) or 15 U.S.C. 80a-3(c)(7)), provided that the investment adviser treats the issuer as a private fund under the Act (15 U.S.C. 80b) and the rules thereunder for all purposes."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-14> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-15>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Related person"^^xsd:string ;
  fro-cfr:hasParagraphText "(6)"^^xsd:string ;
  fro-cfr:hasParagraphText "has the same meaning as in § 275.206(4)-2(d)(7)."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-15> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-16>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "United States"^^xsd:string ;
  fro-cfr:hasParagraphText "(7)"^^xsd:string ;
  fro-cfr:hasParagraphText "has the same meaning as in § 230.902(l) of this chapter."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-16> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-17>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "United States person"^^xsd:string ;
  fro-cfr:hasParagraphText "(8)"^^xsd:string ;
  fro-cfr:hasParagraphText "means any person that is a U.S. person as defined in § 230.902(k) of this chapter, except that any discretionary account or similar account that is held for the benefit of a United States person by a dealer or other professional fiduciary is a United States person if the dealer or professional fiduciary is a related person of the investment adviser relying on this section and is not organized, incorporated, or (if an individual) resident in the United States."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-17> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-18>
  rdf:type fro-cfr:CFR_Note ;
  fro-cfr:hasNoteText "A client will not be considered a United States person if the client was not a United States person at the time of becoming a client."^^xsd:string ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-18-1>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "A client will not be considered a United States person if the client was not a United States person at the time of becoming a client."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-18> ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-18-1> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "United States investment advisers."^^xsd:string ;
  fro-cfr:hasParagraphText "(a)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of section 203(m) of the Act (15 U.S.C. 80b-3(m)), an investment adviser with its principal office and place of business in the United States is exempt from the requirement to register under section 203 of the Act if the investment adviser:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-3>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(1) Acts solely as an investment adviser to one or more qualifying private funds; and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-3> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-4>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) Manages private fund assets of less than $150 million."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-5>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Non-United States investment advisers."^^xsd:string ;
  fro-cfr:hasParagraphText "(b)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of section 203(m) of the Act (15 U.S.C. 80b-3(m)), an investment adviser with its principal office and place of business outside of the United States is exempt from the requirement to register under section 203 of the Act if:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-5> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-6>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(1) The investment adviser has no client that is a United States person except for one or more qualifying private funds; and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-6> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-7>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) All assets managed by the investment adviser at a place of business in the United States are solely attributable to private fund assets, the total value of which is less than $150 million."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-7> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-8>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Frequency of Calculations."^^xsd:string ;
  fro-cfr:hasParagraphText "(c)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of this section, calculate private fund assets annually, in accordance with General Instruction 15 to Form ADV (§ 279.1 of this chapter)."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-8> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7-9>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Definitions."^^xsd:string ;
  fro-cfr:hasParagraphText "(d)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of this section:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-7> ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-7-9> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[62 FR 28134, May 22, 1997, as amended at 63 FR 39715, July 24, 1998; 69 FR 72088, Dec. 10, 2004; 76 FR 43012, July 19, 2011]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.203A-3"^^xsd:string ;
  fro-cfr:hasSectionSubject "Definitions."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-10>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(i) “Excepted person” means a natural person who is a qualified client as described in § 275.205-3(d)(1)."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-10> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-11>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(ii) “Impersonal investment advice” means investment advisory services provided by means of written material or oral statements that do not purport"^^xsd:string ;
  fro-cfr:hasParagraphText "to meet the objectives or needs of specific individuals or accounts."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-11> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-12>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(4) Supervised persons may rely on the definition of “client” in § 275.202(a)(30)-1 to identify clients for purposes of paragraph (a)(1) of this section, except that supervised persons need not count clients that are not residents of the United States."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-12> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-13>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Place of business."^^xsd:string ;
  fro-cfr:hasParagraphText "(b)"^^xsd:string ;
  fro-cfr:hasParagraphText "“Place of business” of an investment adviser representative means:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-13> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-14>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(1) An office at which the investment adviser representative regularly provides investment advisory services, solicits, meets with, or otherwise communicates with clients; and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-14> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-15>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) Any other location that is held out to the general public as a location at which the investment adviser representative provides investment advisory services, solicits, meets with, or otherwise communicates with clients."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-15> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-16>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Principal office and place of business."^^xsd:string ;
  fro-cfr:hasParagraphText "(c)"^^xsd:string ;
  fro-cfr:hasParagraphText "“Principal office and place of business” of an investment adviser means the executive office of the investment adviser from which the officers, partners, or managers of the investment adviser direct, control, and coordinate the activities of the investment adviser."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-16> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-17>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Assets under management."^^xsd:string ;
  fro-cfr:hasParagraphText "(d)"^^xsd:string ;
  fro-cfr:hasParagraphText "Determine “assets under management” by calculating the securities portfolios with respect to which an investment adviser provides continuous and regular supervisory or management services as reported on the investment adviser's Form ADV (17 CFR 279.1)."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-17> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-18>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "State securities authority."^^xsd:string ;
  fro-cfr:hasParagraphText "(e)"^^xsd:string ;
  fro-cfr:hasParagraphText "“State securities authority” means the securities commissioner or commission (or any agency, office or officer performing like functions) of any State."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-18> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "For purposes of section 203A of the Act (15 U.S.C. 80b-3a) and the rules thereunder:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-3>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Investment adviser representative."^^xsd:string ;
  fro-cfr:hasParagraphText "(a)(1)"^^xsd:string ;
  fro-cfr:hasParagraphText "“Investment adviser representative” of an investment adviser means a supervised person of the investment adviser:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-3> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-4>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(i) Who has more than five clients who are natural persons (other than excepted persons described in paragraph (a)(3)(i) of this section); and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 4 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-5>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(ii) More than ten percent of whose clients are natural persons (other than excepted persons described in paragraph (a)(3)(i) of this section)."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-5> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-6>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) Notwithstanding paragraph (a)(1) of this section, a supervised person is not an investment adviser representative if the supervised person:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-6> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-7>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(i) Does not on a regular basis solicit, meet with, or otherwise communicate with clients of the investment adviser; or"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-7> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-8>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(ii) Provides only impersonal investment advice."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-8> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8-9>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(3) For purposes of this section:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-8> ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-8-9> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9>
  rdf:type fro-cfr:CFR_Section ;
  fro-cfr:hasSectionCitation "[76 FR 71174, Nov. 16, 2011]"^^xsd:string ;
  fro-cfr:hasSectionNumber "§ 275.204(b)-1"^^xsd:string ;
  fro-cfr:hasSectionSubject "Reporting by investment advisers to private funds."^^xsd:string ;
  fro-leg-ref:divides fro-cfr:CFR_Title-17_Part-275 ;
  fro-leg-ref:hasSequenceNumber 9 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9> ;
  fro-leg-ref:refers_toNote <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-4> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-10>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Temporary hardship exemption."^^xsd:string ;
  fro-cfr:hasParagraphText "(1) If you have unanticipated technical difficulties that prevent you from submitting Form PF on a timely basis through the Form PF filing system, you may request a temporary hardship exemption from the requirements of this section to file electronically."^^xsd:string ;
  fro-cfr:hasParagraphText "(f)"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 10 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-10> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-11>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(2) To request a temporary hardship exemption, you must:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 11 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-11> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-12>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(i) Complete and file in paper format, in accordance with the instructions to Form PF, Item A of Section 1a and Section 5 of Form PF, checking the box in Section 1a indicating that you are requesting a temporary hardship exemption, no later than one business day after the electronic Form PF filing was due; and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 12 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-12> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-13>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(ii) Submit the filing that is the subject of the Form PF paper filing in electronic format with the Form PF filing system no later than seven business days after the filing was due."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 13 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-13> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-14>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(3) The temporary hardship exemption will be granted when you file Item A of Section 1a and Section 5 of Form PF, checking the box in Section 1a indicating that you are requesting a temporary hardship exemption."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 14 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-14> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-15>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(4) The hardship exemptions available under § 275.203-3 do not apply to Form PF."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 15 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-15> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-16>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Definitions."^^xsd:string ;
  fro-cfr:hasParagraphText "(g)"^^xsd:string ;
  fro-cfr:hasParagraphText "For purposes of this section:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 16 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-16> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-17>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Assets under management"^^xsd:string ;
  fro-cfr:hasParagraphText "(1)"^^xsd:string ;
  fro-cfr:hasParagraphText "means the regulatory assets under management as determined under Item 5.F of Form ADV (§ 279.1 of this chapter)."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 17 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-17> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-18>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Private fund assets"^^xsd:string ;
  fro-cfr:hasParagraphText "(2)"^^xsd:string ;
  fro-cfr:hasParagraphText "means the investment adviser's assets under management attributable to private funds."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 18 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-18> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-2>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Reporting by investment advisers to private funds on Form PF."^^xsd:string ;
  fro-cfr:hasParagraphText "(a)"^^xsd:string ;
  fro-cfr:hasParagraphText "If you are an investment adviser registered or required to be registered under section 203 of the Act (15 U.S.C. 80b-3), you act as an investment adviser to one or"^^xsd:string ;
  fro-cfr:hasParagraphText "more private funds and, as of the end of your most recently completed fiscal year, you managed private fund assets of at least $150 million, you must complete and file a report on Form PF (17 CFR 279.9) by following the instructions in the Form, which specify the information that an investment adviser must provide. Your initial report on Form PF is due no later than the last day on which your next update would be timely in accordance with paragraph (e) if you had previously filed the Form; provided that you are not required to file Form PF with respect to any fiscal quarter or fiscal year ending prior to the date on which your registration becomes effective."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 2 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-2> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-3>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Electronic filing."^^xsd:string ;
  fro-cfr:hasParagraphText "(b)"^^xsd:string ;
  fro-cfr:hasParagraphText "You must file Form PF electronically with the Form PF filing system on the Investment Adviser Registration Depository (IARD)."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 3 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-3> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-4>
  rdf:type fro-cfr:CFR_Note ;
  fro-cfr:hasNoteText "Information on how to file Form PF is available on the Commission's Web site at"^^xsd:string ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-4-1>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "http://www.sec.gov/iard."^^xsd:string ;
  fro-cfr:hasParagraphText "Information on how to file Form PF is available on the Commission's Web site at"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-4> ;
  fro-leg-ref:hasSequenceNumber 1 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-4-1> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-5>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "When filed."^^xsd:string ;
  fro-cfr:hasParagraphText "(c)"^^xsd:string ;
  fro-cfr:hasParagraphText "Each Form PF is considered filed with the Commission upon acceptance by the Form PF filing system."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 5 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-5> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-6>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Filing fees."^^xsd:string ;
  fro-cfr:hasParagraphText "(d)"^^xsd:string ;
  fro-cfr:hasParagraphText "You must pay the operator of the Form PF filing system a filing fee as required by the instructions to Form PF. The Commission has approved the amount of the filing fee. No portion of the filing fee is refundable. Your completed Form PF will not be accepted by the operator of the Form PF filing system, and thus will not be considered filed with the Commission, until you have paid the filing fee."^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 6 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-6> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-7>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphEnumText "Updates to Form PF."^^xsd:string ;
  fro-cfr:hasParagraphText "(e)"^^xsd:string ;
  fro-cfr:hasParagraphText "You must file an updated Form PF:"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 7 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-7> ;
.
<http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9-8>
  rdf:type fro-cfr:CFR_Parapraph ;
  fro-cfr:hasParagraphText "(1) At least annually, no later than the date specified in the instructions to Form PF; and"^^xsd:string ;
  fro-leg-ref:divides <http://finregont.com/fro/cfr/FRO_CFR_Title_17_Part_275.ttl#r-1-9> ;
  fro-leg-ref:hasSequenceNumber 8 ;
  fro-leg-ref:hasSourceInstance <http://finregont.com/fro/cfr/CFR-2012-title17-vol3-part275.ttl#r-1-9-8> ;
