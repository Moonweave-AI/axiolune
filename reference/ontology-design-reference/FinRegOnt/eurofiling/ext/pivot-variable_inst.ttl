<http://finregont.com/fro/eurofiling/ext/pivot-variable_inst.xml>
  rdf:type owl:Ontology ;
  owl:imports <http://finregont.com/fro/eurofiling/ext/ef_filing-indicators.ttl> ;
  owl:imports <http://finregont.com/fro/eurofiling/ext/model.ttl> ;
  owl:imports <http://finregont.com/fro/eurofiling/ext/pivot-variable.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/cube/xbrldt.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/formula/aspect-cover.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/formula/tuple.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/generic/generic.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/table/table.ttl> ;
  owl:imports <http://topbraid.org/sxml> ;
.
pivot-variable-inst:Document
  rdf:type sxml:Document ;
  sxml:root pivot-variable-inst:r ;
.
pivot-variable-inst:arcroleURI-linkarcroleRef
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "arcroleURI" ;
  rdfs:label "arcroleURI" ;
.
pivot-variable-inst:bindAsSequence-variablefactVariable
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "bindAsSequence" ;
  rdfs:label "bindAsSequence" ;
.
pivot-variable-inst:complement-variablevariableFilterArc
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "complement" ;
  rdfs:label "complement" ;
.
pivot-variable-inst:cover-variablevariableFilterArc
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "cover" ;
  rdfs:label "cover" ;
.
pivot-variable-inst:id-tfparentFilter
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "id" ;
  rdfs:label "id" ;
.
pivot-variable-inst:id-variablefactVariable
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "id" ;
  rdfs:label "id" ;
.
pivot-variable-inst:matches-variablefactVariable
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "matches" ;
  rdfs:label "matches" ;
.
pivot-variable-inst:order-variablevariableFilterArc
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "order" ;
  rdfs:label "order" ;
.
pivot-variable-inst:r
  rdf:type linkbase:linkbase ;
  sxml:prefix "acf"^^xsd:string ;
  sxml:prefix "find"^^xsd:string ;
  sxml:prefix "gen"^^xsd:string ;
  sxml:prefix "link"^^xsd:string ;
  sxml:prefix "tf"^^xsd:string ;
  sxml:prefix "variable"^^xsd:string ;
  sxml:prefix "xbrli"^^xsd:string ;
  sxml:prefix "xfi"^^xsd:string ;
  sxml:prefix "xlink"^^xsd:string ;
  sxml:prefix "xs"^^xsd:string ;
  sxml:prefix "xsi"^^xsd:string ;
  composite:child pivot-variable-inst:r-0 ;
  composite:child pivot-variable-inst:r-1 ;
  xsi:schemaLocation-linklinkbase "http://www.xbrl.org/2003/linkbase http://www.xbrl.org/2003/xbrl-linkbase-2003-12-31.xsd http://xbrl.org/2008/generic http://www.xbrl.org/2008/generic-link.xsd http://xbrl.org/2008/variable http://www.xbrl.org/2008/variable.xsd http://xbrl.org/2008/filter/tuple http://www.xbrl.org/2008/tuple-filter.xsd http://xbrl.org/2010/filter/aspect-cover http://xbrl.org/2010/aspect-cover-filter.xsd" ;
.
pivot-variable-inst:r-0
  rdf:type linkbase:arcroleRef ;
  pivot-variable-inst:arcroleURI-linkarcroleRef "http://xbrl.org/arcrole/2008/variable-filter" ;
  composite:index "0"^^xsd:int ;
  xlink:href-linkarcroleRef "http://www.xbrl.org/2008/variable.xsd#variable-filter" ;
  xlink:type-linkarcroleRef "simple" ;
.
pivot-variable-inst:r-1
  rdf:type generic:Link ;
  composite:child pivot-variable-inst:r-1-0 ;
  composite:child pivot-variable-inst:r-1-1 ;
  composite:child pivot-variable-inst:r-1-2 ;
  composite:child pivot-variable-inst:r-1-3 ;
  composite:child pivot-variable-inst:r-1-4 ;
  composite:index "1"^^xsd:int ;
  xlink:role-genlink "http://www.xbrl.org/2003/role/link" ;
  xlink:type-genlink "extended" ;
.
pivot-variable-inst:r-1-0
  rdf:type variable:FactVariable ;
  pivot-variable-inst:bindAsSequence-variablefactVariable "true" ;
  pivot-variable-inst:id-variablefactVariable "pivot-var" ;
  pivot-variable-inst:matches-variablefactVariable "true" ;
  composite:index "0"^^xsd:int ;
  xlink:label-variablefactVariable "pivot-var" ;
  xlink:type-variablefactVariable "resource" ;
.
pivot-variable-inst:r-1-1
  rdf:type tuple:ParentFilter ;
  pivot-variable-inst:id-tfparentFilter "find-tuple-filter" ;
  composite:child pivot-variable-inst:r-1-1-0 ;
  composite:index "1"^^xsd:int ;
  xlink:label-tfparentFilter "find-tuple-filter" ;
  xlink:type-tfparentFilter "resource" ;
.
pivot-variable-inst:r-1-1-0
  rdf:type tuple:parent ;
  composite:child pivot-variable-inst:r-1-1-0-0 ;
  composite:index "0"^^xsd:int ;
.
pivot-variable-inst:r-1-1-0-0
  rdf:type xsd:QName ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "find:fIndicators"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "0"^^xsd:int ;
.
pivot-variable-inst:r-1-2
  rdf:type aspect-cover:AspectCover ;
  composite:child pivot-variable-inst:r-1-2-0 ;
  composite:index "2"^^xsd:int ;
  xlink:label-acfaspectCover "all-cover-filter" ;
  xlink:type-acfaspectCover "resource" ;
.
pivot-variable-inst:r-1-2-0
  rdf:type vaem:Aspect ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "all"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "0"^^xsd:int ;
.
pivot-variable-inst:r-1-3
  rdf:type variable:VariableFilterArc ;
  pivot-variable-inst:complement-variablevariableFilterArc "false" ;
  pivot-variable-inst:cover-variablevariableFilterArc "true" ;
  pivot-variable-inst:order-variablevariableFilterArc "1" ;
  composite:index "3"^^xsd:int ;
  xlink:arcrole-variablevariableFilterArc "http://xbrl.org/arcrole/2008/variable-filter" ;
  xlink:from-variablevariableFilterArc "pivot-var" ;
  xlink:to-variablevariableFilterArc "find-tuple-filter" ;
  xlink:type-variablevariableFilterArc "arc" ;
.
pivot-variable-inst:r-1-4
  rdf:type variable:VariableFilterArc ;
  pivot-variable-inst:complement-variablevariableFilterArc "false" ;
  pivot-variable-inst:cover-variablevariableFilterArc "true" ;
  pivot-variable-inst:order-variablevariableFilterArc "2" ;
  composite:index "4"^^xsd:int ;
  xlink:arcrole-variablevariableFilterArc "http://xbrl.org/arcrole/2008/variable-filter" ;
  xlink:from-variablevariableFilterArc "pivot-var" ;
  xlink:to-variablevariableFilterArc "all-cover-filter" ;
  xlink:type-variablevariableFilterArc "arc" ;
.
tuple:parent
  rdf:type owl:Class ;
  sxml:element tuple:parent ;
  rdfs:label "tf:parent" ;
.
