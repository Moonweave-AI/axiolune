fin-strategy:FactorObservation a owl:Class;
    rdfs:comment "Factor Observation, is a temporal and provenanced observation that records the value of one factor version for one factor subject, observation period, and run context, used for managing revisions through a stable logical identity plus knowledge-time closure, with an optional link to the prior exact fact version. The factor subject is generalized beyond a single instrument via the FactorSubject role family so that macro, sector, country, market-breadth, curve, and portfolio factors are not forced to masquerade as instruments; the observation period is a structured ObservationPeriod rather than a free-text key; and the run context is part of the stable logical key so that observations of the same factor and subject in different runs do not collide.";
    rdfs:label "Factor Observation";
    rdfs:subClassOf _:r_09a1769c74e9d66fb0e89522, _:r_1c41c07a1d4b128e5bb3528c, _:r_1dc5e35e1e80d9f7b4fd54b3, _:r_26dc3bcb6e6444158f65465e, _:r_352af54a0e22ade01493ac37, _:r_39e5a2c6dac4919235f68a39, _:r_3cab5af6830483583e5c16c6, _:r_43f48c264bf82525387382ff, _:r_4f9d91ba8cb5ffe66ec1e000, _:r_59c409b7f16a366abf62c41f, _:r_61ceabc73d0d4e16ddbd93c3, _:r_6393bcc9b22b4bfda802d496, _:r_66ef55dfccdf5eba43438b1e, _:r_742431b0a16c73bb2604acdf, _:r_76abe37f9473c476af95e585, _:r_7bc07eeaa5d67dab3e46d586, _:r_909ea673b9ea0ea8dc27dfc1, _:r_9491b904502631ce4ae7598a, _:r_950da0a306279199212c95f5, _:r_9630fa7a221e16124a85a517, _:r_99ef3ff5b2ad376a1e706a67, _:r_9ce4a1b4a76b3db33aaadb63, _:r_abc590a9ce991776df755780, _:r_b6f406f69e15fde3318da5b8, _:r_b7d5704d402cf5a2905deee3, _:r_baed5c9f2937f8fb0f24915f, _:r_be681aec1fac656344385f5d, _:r_bf5c6daa25c67a41f112e574, _:r_c2977ea0eeedec5166ba229b, _:r_da6bb40020864968eba32bfd, _:r_ea72297feb1d50cf4fdcca76, _:r_ec1a22a66fdb924020e8d65f, _:r_fde54d2f886129a248450d5a, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
