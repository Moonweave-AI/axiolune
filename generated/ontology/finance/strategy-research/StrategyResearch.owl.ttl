    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-strategy:SimulatedPortfolioState a owl:Class;
    rdfs:comment "Simulated Portfolio State, is a temporal and provenanced fact that records one simulated portfolio state resulting from a sequence of SimulatedFill facts under a MarketSimulationPolicy, used for expressing the fill-to-portfolio-state step of a simulated trading chain.";
