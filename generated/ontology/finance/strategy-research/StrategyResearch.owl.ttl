    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-strategy:StrategyDeployment a owl:Class;
    rdfs:comment "Strategy Deployment, is a versioned specification of one deployment of a strategy to live trading, used for backing the live run-context kind with a deployment lifecycle governed by promotion, monitoring, suspension, and rollback decisions.";
