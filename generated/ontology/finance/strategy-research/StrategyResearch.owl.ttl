    rdfs:label "Simulated Fill logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-strategy:SimulatedOrder a owl:Class;
    rdfs:comment "Simulated Order, is a temporal and provenanced fact that records one simulated order produced by a backtest decision under a MarketSimulationPolicy, used for expressing the Decision-to-order step of a simulated trading chain; it references the orders-execution module's order semantics without re-defining them.";
    rdfs:label "Simulated Order";
    rdfs:subClassOf _:r_39e9c13abca84162b2cbee9a, _:r_74f93327e818c6d2dba98251, _:r_96656d1601fe5b7627103852, _:r_aa036138a739dd13fb980317, _:r_b2af7ed2b8c27549b5365b27, _:r_c56b0e1ac0d833619eb1f21e, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
