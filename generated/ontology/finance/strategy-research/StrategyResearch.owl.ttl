<https://axiolune.ai/ontology/finance/strategy-research> a owl:Ontology;
    rdfs:comment "Strategy and Research, is a finance ontology module that defines versioned specifications for research questions, hypotheses, protocols, factors, signals, strategies, backtests, simulated trading, performance measurement, attribution, and live deployment governance, used for providing typed business semantics for quantitative research, strategy definition, simulation, and deployment together with an optional reproducibility-evidence profile that locks executable implementation, input and output contracts, runtime, tool lock, and source artifact evidence under a single authority.";
    rdfs:label "Strategy and Research";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/instruments>, <https://axiolune.ai/ontology/finance/market-data>, <https://axiolune.ai/ontology/finance/market-structure>, <https://axiolune.ai/ontology/finance/orders-execution>, <https://axiolune.ai/ontology/finance/portfolio-positions>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/strategy-research/1.1.0>.
