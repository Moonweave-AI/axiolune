fin-strategy:AttributionMethod a owl:Class;
    rdfs:comment "Attribution Method, is a versioned specification of the attribution method used to decompose a performance result into contributions, covering the component type, aggregation scope, and reconciliation and residual rule, used for making an attribution explain a performance result rather than only carry a number.";
    rdfs:label "Attribution Method";
    rdfs:subClassOf _:r_1eca4db25fda116fe2be1366, _:r_362fa0d01a07917edf9ba502, _:r_541224cc39b9d9f05b9cc538, _:r_67f9a564e9745aa6e6e583e3, _:r_69e6f7ef0db118ec31781c92, _:r_7fc868f984bfd1ecbe97bc58, _:r_870029ecb62ecf890e1fb896, _:r_94229c10bb5946c17ec33231, _:r_d8d8c8f401e4e11426ac2c31, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
