    rdfs:comment "Simulated Order Identifier, is a source-scoped stable identifier of one SimulatedOrder, used for uniquely referring to a simulated order within its scope.";
    rdfs:label "simulated order identifier";
    rdfs:range xsd:string.
fin-strategy:simulatedPortfolioStateDigest a owl:DatatypeProperty;
    rdfs:comment "Simulated Portfolio State Digest, is the SHA-256 digest of the immutable simulated portfolio state, used for byte-level verification of the portfolio-state content.";
    rdfs:label "simulated portfolio state digest";
    rdfs:range xsd:string.
fin-strategy:simulatedPortfolioStateFill a owl:ObjectProperty;
    rdfs:comment "Simulated Portfolio State Fill, is a relationship from a SimulatedPortfolioState to the exact SimulatedFill versions that produced it, used for binding a simulated portfolio state to its contributing fills.";
    rdfs:domain fin-strategy:SimulatedPortfolioState;
    rdfs:label "simulated portfolio state fill";
    rdfs:range fin-strategy:SimulatedFill.
fin-strategy:simulatedPortfolioStateId a owl:DatatypeProperty;
    rdfs:comment "Simulated Portfolio State Identifier, is a source-scoped stable identifier of one SimulatedPortfolioState, used for uniquely referring to a simulated portfolio state within its scope.";
    rdfs:label "simulated portfolio state identifier";
    rdfs:range xsd:string.
fin-strategy:simulatedReturnSeriesDigest a owl:DatatypeProperty;
    rdfs:comment "Simulated Return Series Digest, is the SHA-256 digest of the immutable simulated return series, used for byte-level verification of the return-series content.";
    rdfs:label "simulated return series digest";
    rdfs:range xsd:string.
fin-strategy:simulatedReturnSeriesId a owl:DatatypeProperty;
    rdfs:comment "Simulated Return Series Identifier, is a source-scoped stable identifier of one SimulatedReturnSeries, used for uniquely referring to a simulated return series within its scope.";
    rdfs:label "simulated return series identifier";
    rdfs:range xsd:string.
fin-strategy:simulatedReturnSeriesState a owl:ObjectProperty;
    rdfs:comment "Simulated Return Series State, is a functional relationship from a SimulatedReturnSeries to the exact SimulatedPortfolioState versions it derives from, used for binding a simulated return series to its portfolio states.";
    rdfs:domain fin-strategy:SimulatedReturnSeries;
    rdfs:label "simulated return series state";
    rdfs:range fin-strategy:SimulatedPortfolioState.
fin-strategy:simulationFrom a owl:DatatypeProperty;
    rdfs:comment "Simulation From, is the inclusive lower bound of a BacktestRun's historical simulation interval, used for defining the start time of the backtest simulation.";
    rdfs:label "simulation from";
    rdfs:range xsd:dateTimeStamp.
fin-strategy:simulationTo a owl:DatatypeProperty;
    rdfs:comment "Simulation To, is the exclusive upper bound of a BacktestRun's historical simulation interval, used for defining the end time of the backtest simulation.";
    rdfs:label "simulation to";
    rdfs:range xsd:dateTimeStamp.
fin-strategy:slippageAssumptionDigest a owl:DatatypeProperty;
    rdfs:comment "Slippage Assumption Digest, is the SHA-256 digest of the immutable slippage-assumption artifact, used for byte-level verification of the slippage-assumption content.";
    rdfs:label "slippage assumption digest";
    rdfs:range xsd:string.
fin-strategy:slippageAssumptionRef a owl:DatatypeProperty;
    rdfs:comment "Slippage Assumption Reference, is the IRI of the immutable slippage-assumption artifact used by a BacktestRun, used for pointing to the artifact that locks the slippage model.";
    rdfs:label "slippage assumption reference";
    rdfs:range xsd:anyURI.
fin-strategy:sourceAttributionId a owl:DatatypeProperty;
    rdfs:comment "Source Attribution Identifier, is a source-scoped stable identifier of one PositionAttribution logical identity, used for uniquely referring to an attribution within its scope.";
    rdfs:label "source attribution identifier";
    rdfs:range xsd:string.
fin-strategy:sourceFactorId a owl:DatatypeProperty;
    rdfs:comment "Source Factor Identifier, is a non-empty source identifier stable across revisions within one factor, instrument, run, and reporting-period scope, used for uniquely referring to a factor observation within that scope.";
    rdfs:label "source factor identifier";
    rdfs:range xsd:string.
fin-strategy:sourcePerformanceId a owl:DatatypeProperty;
    rdfs:comment "Source Performance Identifier, is a source-scoped stable identifier of one PerformanceObservation logical identity, used for uniquely referring to a performance observation within its scope.";
    rdfs:label "source performance identifier";
    rdfs:range xsd:string.
fin-strategy:sourceRunEventId a owl:DatatypeProperty;
    rdfs:comment "Source Run Event Identifier, is a source-scoped stable identifier of one BacktestStatusEvent, used for uniquely referring to a status event within its run scope.";
    rdfs:label "source run event identifier";
    rdfs:range xsd:string.
fin-strategy:sourceSignalId a owl:DatatypeProperty;
    rdfs:comment "Source Signal Identifier, is a non-empty source identifier unique within one generator and run logical scope, used for uniquely referring to a signal within that scope.";
    rdfs:label "source signal identifier";
    rdfs:range xsd:string.
fin-strategy:statisticalTestPlanRef a owl:DatatypeProperty;
    rdfs:comment "Statistical Test Plan Reference, is the IRI of the immutable statistical test plan that would falsify or support a hypothesis, used for binding a hypothesis to its falsifiability plan.";
    rdfs:label "statistical test plan reference";
    rdfs:range xsd:anyURI.
fin-strategy:statisticalTestResultId a owl:DatatypeProperty;
    rdfs:comment "Statistical Test Result Identifier, is a source-scoped stable identifier of one StatisticalTestResult, used for uniquely referring to a statistical test result within its scope.";
    rdfs:label "statistical test result identifier";
    rdfs:range xsd:string.
fin-strategy:statusSequence a owl:DatatypeProperty;
    rdfs:comment "Status Sequence, is a non-negative source ordering key for BacktestStatusEvent facts, used for ordering status events by their occurrence sequence.";
    rdfs:label "status sequence";
    rdfs:range xsd:integer.
fin-strategy:stockBorrowPolicyRef a owl:DatatypeProperty;
    rdfs:comment "Stock Borrow Policy Reference, is the IRI of the immutable stock-borrow policy artifact of a market simulation policy, used for pointing to the artifact that defines the stock-borrow model.";
    rdfs:label "stock borrow policy reference";
    rdfs:range xsd:anyURI.
fin-strategy:strategyDeploymentId a owl:DatatypeProperty;
    rdfs:comment "Strategy Deployment Identifier, is an authority-scoped stable identifier of a StrategyDeployment logical identity, used for uniquely referring to a strategy deployment within a single authority scope.";
    rdfs:label "strategy deployment identifier";
    rdfs:range xsd:string.
fin-strategy:strategyDescription a owl:DatatypeProperty;
    rdfs:comment "Strategy Description, is an optional human-readable description of a StrategyDefinition objective, used for stating the strategy's intent and objective in natural language.";
    rdfs:label "strategy description";
    rdfs:range xsd:string.
fin-strategy:strategyExecutionIntent a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Strategy Execution Intent, is a functional relationship from a StrategyDefinition to an optional exact ExecutionIntent version, used for binding the strategy's execution step.";
    rdfs:domain fin-strategy:StrategyDefinition;
    rdfs:label "strategy execution intent";
    rdfs:range fin-strategy:ExecutionIntent.
fin-strategy:strategyExecutionPackageDigest a owl:DatatypeProperty;
    rdfs:comment "Strategy Execution Package Digest, is the SHA-256 digest of the immutable strategy execution package, used for byte-level verification of the package content.";
    rdfs:label "strategy execution package digest";
    rdfs:range xsd:string.
fin-strategy:strategyExecutionPackageId a owl:DatatypeProperty;
    rdfs:comment "Strategy Execution Package Identifier, is an authority-scoped stable identifier of a StrategyExecutionPackage logical identity, used for uniquely referring to a strategy execution package within a single authority scope.";
    rdfs:label "strategy execution package identifier";
    rdfs:range xsd:string.
fin-strategy:strategyMandateKind a owl:ObjectProperty;
    rdfs:comment "Strategy Mandate Kind, is a reviewed member recording the mandate kind of a strategy, used for classifying strategies by mandate such as index tracking, execution algorithm, market making, arbitrage, option hedging, event-driven, or rule-based.";
    rdfs:label "strategy mandate kind";
    rdfs:range fin-strategy:StrategyMandateKind.
fin-strategy:strategyObjective a owl:DatatypeProperty;
    rdfs:comment "Strategy Objective, is an optional human-readable statement of a strategy's investment objective, used for expressing the strategy's intent beyond a factor consumer.";
    rdfs:label "strategy objective";
    rdfs:range xsd:string.
fin-strategy:strategyPortfolioConstruction a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Strategy Portfolio Construction, is a functional relationship from a StrategyDefinition to an optional exact PortfolioConstructionPolicy version, used for binding the strategy's construction step.";
    rdfs:domain fin-strategy:StrategyDefinition;
    rdfs:label "strategy portfolio construction";
    rdfs:range fin-strategy:PortfolioConstructionPolicy.
fin-strategy:strategyRebalance a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Strategy Rebalance, is a functional relationship from a StrategyDefinition to an optional exact RebalancePolicy version, used for binding the strategy's rebalance step.";
    rdfs:domain fin-strategy:StrategyDefinition;
    rdfs:label "strategy rebalance";
    rdfs:range fin-strategy:RebalancePolicy.
fin-strategy:strategyRiskConstraint a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Strategy Risk Constraint, is a functional relationship from a StrategyDefinition to an optional exact RiskConstraintPolicy version, used for binding the strategy's risk-control step.";
    rdfs:domain fin-strategy:StrategyDefinition;
    rdfs:label "strategy risk constraint";
    rdfs:range fin-strategy:RiskConstraintPolicy.
fin-strategy:strategyUniverse a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Strategy Universe, is a functional relationship from a StrategyDefinition to an optional exact UniverseDefinition version, used for binding the strategy's investable universe.";
    rdfs:domain fin-strategy:StrategyDefinition;
    rdfs:label "strategy universe";
    rdfs:range fin-strategy:UniverseDefinition.
fin-strategy:survivorshipPolicyRef a owl:DatatypeProperty;
    rdfs:comment "Survivorship Policy Reference, is the IRI of the immutable survivorship policy artifact of a market simulation policy, used for pointing to the artifact that defines the survivorship-bias handling model.";
    rdfs:label "survivorship policy reference";
    rdfs:range xsd:anyURI.
fin-strategy:suspensionPolicyRef a owl:DatatypeProperty;
    rdfs:comment "Suspension Policy Reference, is the IRI of the immutable suspension policy artifact of a market simulation policy, used for pointing to the artifact that defines the suspension model.";
    rdfs:label "suspension policy reference";
    rdfs:range xsd:anyURI.
fin-strategy:targetExposureDirection a owl:ObjectProperty;
    rdfs:comment "Target Exposure Direction, is a reviewed member recording the exposure direction conveyed by a signal, used for expressing the exposure-direction dimension distinct from the action-intent dimension.";
    rdfs:label "target exposure direction";
    rdfs:range fin-strategy:TargetExposureDirection.
fin-strategy:targetWeight a owl:ObjectProperty;
    rdfs:comment "Target Weight, is an optional Quantity target weight conveyed by a signal, used for expressing the target portfolio weight dimension of a signal.";
    rdfs:label "target weight";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-strategy:taxPolicyRef a owl:DatatypeProperty;
    rdfs:comment "Tax Policy Reference, is the IRI of the immutable tax policy artifact of a market simulation policy, used for pointing to the artifact that defines the tax model.";
    rdfs:label "tax policy reference";
    rdfs:range xsd:anyURI.
fin-strategy:testStatistic a owl:ObjectProperty;
    rdfs:comment "Test Statistic, is an optional Quantity test statistic of a statistical test, used for recording the test statistic value.";
    rdfs:label "test statistic";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-strategy:testWindowFrom a owl:DatatypeProperty;
    rdfs:comment "Test Window From, is the inclusive lower bound of a walk-forward fold's test window, used for defining the start of the out-of-sample test window.";
    rdfs:label "test window from";
    rdfs:range xsd:dateTimeStamp.
fin-strategy:testWindowTo a owl:DatatypeProperty;
    rdfs:comment "Test Window To, is the exclusive upper bound of a walk-forward fold's test window, used for defining the end of the out-of-sample test window.";
    rdfs:label "test window to";
    rdfs:range xsd:dateTimeStamp.
fin-strategy:toolLockDigest a owl:DatatypeProperty;
    rdfs:comment "Tool Lock Digest, is the SHA-256 digest of the immutable tool-lock record, used for byte-level verification of the tool-lock record content.";
    rdfs:label "tool lock digest";
    rdfs:range xsd:string.
fin-strategy:toolLockRef a owl:DatatypeProperty;
    rdfs:comment "Tool Lock Reference, is the IRI of the immutable tool-lock record used by an executable definition, used for pointing to the record that locks the execution tool version.";
    rdfs:label "tool lock reference";
    rdfs:range xsd:anyURI.
fin-strategy:trainingWindowFrom a owl:DatatypeProperty;
    rdfs:comment "Training Window From, is the inclusive lower bound of a walk-forward fold's training window, used for defining the start of the training window.";
    rdfs:label "training window from";
    rdfs:range xsd:dateTimeStamp.
fin-strategy:trainingWindowTo a owl:DatatypeProperty;
    rdfs:comment "Training Window To, is the exclusive upper bound of a walk-forward fold's training window, used for defining the end of the training window.";
    rdfs:label "training window to";
    rdfs:range xsd:dateTimeStamp.
fin-strategy:universeDefinitionId a owl:DatatypeProperty;
    rdfs:comment "Universe Definition Identifier, is an authority-scoped stable identifier of a UniverseDefinition logical identity, used for uniquely referring to a universe definition within a single authority scope.";
    rdfs:label "universe definition identifier";
    rdfs:range xsd:string.
fin-strategy:universeEligibilityRuleDigest a owl:DatatypeProperty;
    rdfs:comment "Universe Eligibility Rule Digest, is the SHA-256 digest of the immutable universe-eligibility rule artifact, used for byte-level verification of the eligibility-rule content.";
    rdfs:label "universe eligibility rule digest";
    rdfs:range xsd:string.
fin-strategy:universeEligibilityRuleRef a owl:DatatypeProperty;
    rdfs:comment "Universe Eligibility Rule Reference, is the IRI of the immutable universe-eligibility rule artifact, used for pointing to the artifact that defines the eligibility rules.";
    rdfs:label "universe eligibility rule reference";
    rdfs:range xsd:anyURI.
fin-strategy:usesFactor a owl:ObjectProperty;
    rdfs:comment "Uses Factor, is a relationship from a StrategyDefinition version to each exact FactorDefinition version on which it depends, used for modeling the strategy's factor dependencies as explicit exact-version bindings. The dependency is optional; a factor-strategy profile enforces at least one factor, so that strategies which do not depend on predefined factors (index tracking, execution algorithms, market making, arbitrage, option hedging, event-driven, or rule-based strategies) are not forced to declare a spurious factor.";
    rdfs:domain fin-strategy:StrategyDefinition;
    rdfs:label "uses factor";
    rdfs:range fin-strategy:FactorDefinition.
fin-strategy:valuationConventionId a owl:DatatypeProperty;
    rdfs:comment "Valuation Convention Identifier, is an authority-scoped stable identifier of a ValuationConvention logical identity, used for uniquely referring to a valuation convention within a single authority scope.";
    rdfs:label "valuation convention identifier";
    rdfs:range xsd:string.
fin-strategy:walkForwardAnchorAt a owl:DatatypeProperty;
    rdfs:comment "Walk-Forward Anchor At, is an optional instant at which a walk-forward fold is anchored, used for ordering folds in a walk-forward sequence.";
    rdfs:label "walk-forward anchor at";
    rdfs:range xsd:dateTimeStamp.
fin-strategy:walkForwardFoldId a owl:DatatypeProperty;
    rdfs:comment "Walk-Forward Fold Identifier, is an authority-scoped stable identifier of a WalkForwardFold logical identity, used for uniquely referring to a walk-forward fold within a single authority scope.";
    rdfs:label "walk-forward fold identifier";
    rdfs:range xsd:string.
