fin-strategy:StrategyDefinition a owl:Class;
    rdfs:comment "Strategy Definition, is a signal generator specification that defines one trading or allocation strategy together with its objective, mandate, universe, portfolio construction, rebalance, risk, and execution intent, used for modeling the strategy as an investment decision rule rather than merely a factor consumer, and for modeling each factor dependency as an explicit exact-version relation rather than an implicit source-code import. The factor dependency is optional; a factor-strategy profile enforces at least one factor.";
    rdfs:label "Strategy Definition";
    rdfs:subClassOf _:r_09ba769725825a95625671b6, _:r_1b3bc363c7ef30beed0f3eb0, _:r_44d80188fcc05823c2a413f1, _:r_4753ca7f7fea98e95e7493d3, _:r_5175f482cff0cadcd792e065, _:r_5f108daf3855405e2947cebd, _:r_7dfc38ce4aa902fd51f35b20, _:r_862271d7181bf0a849b132de, _:r_8ad55ad661eb74b0d79129dc, _:r_902c8f92988f92a361050419, _:r_91e82f2c835d4940671b639c, _:r_91ea579a922c6072312e725c, _:r_9b1d9adcaa5629857b3819b2, _:r_ace0b20c0c92addf647a299b, _:r_c12a84f55a465cf20aaaabd9, _:r_c7f0edcf347e7f05e9305edc, _:r_c9a5548585ade54a6317572f, _:r_d97761af9e8aba3711764f1e, _:r_fec0372bf35d3806388e01cb, fin-strategy:SignalGenerator, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
