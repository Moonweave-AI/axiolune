fin-strategy:BacktestRun a owl:Class;
    rdfs:comment "Backtest Run, is a run context that applies one exact strategy version to a half-open historical interval, used for locking immutable configuration such as capital, costs, slippage, fills, and benchmark, and for binding an exact StrategyExecutionPackage whose strategy, executable implementation, factor-dependency closure, and input contract must be mutually consistent; mutable run state is excluded and recorded separately by status facts, and simulated trading is recorded by SimulatedOrder, SimulatedFill, SimulatedPortfolioState, and SimulatedReturnSeries facts under a MarketSimulationPolicy. The audit-grade configuration digests are profile-scoped under ValidatedReproducibleRun.";
    rdfs:label "Backtest Run";
    rdfs:subClassOf _:r_0204eaa5af6deab64f289c27, _:r_0ef3b0097128090cabfab063, _:r_0fecaa67ba6dfade55136466, _:r_1860e5bbd644518d653bf9da, _:r_236e48e291fe319e99080db3, _:r_266826e7049dfd2829fbcd43, _:r_2acc74f4f0aeb7b1db37ce0e, _:r_2ba038faaa1c7fe236231c0d, _:r_3af662b40eae4f10ded9217b, _:r_3f42c095c3f51490c630fd93, _:r_3f56b2313d47801e443ec856, _:r_4cc9eaa4364bac6b67ecb7be, _:r_572b66c0a34b351695d1637d, _:r_5ebf8dcd112351b08400a57e, _:r_769848ca9c224b36f71010c1, _:r_80b0b9e78d9c3ba9bae59053, _:r_942e2bd28547095ac5127f72, _:r_9ca13d7dfb38350cdb3bef44, _:r_a21366f53451baf14fd51ea7, _:r_a3a6c959a6d78ff010fab6d9, _:r_a7726e33842a77736231571a, _:r_a8a4a82c19a2dc4420112ffa, _:r_aef00496612d0d31096f21f4, _:r_b0ac489c9919a51f837e9913, _:r_b79844bc8e72466f6c0b0a6b, _:r_bc20a93185b8b394de24bdb6, _:r_d6ad6c8dd6954e35365f73a6, _:r_d7ea141a41f5ff723489b0fa, _:r_dbb4ea6c08fc79b1a1896c33, _:r_e3befca02122a3637eb18078, _:r_e74d7e96ea4c28a84f103777, _:r_ecf37f36c19e6e9c027afd92, _:r_f3a807b497e3643e5dc964bc, _:r_f43d857432a58b44b29a9c75, _:r_ff0b7a3feb9088bf385a1375, fin-strategy:RunContext, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
