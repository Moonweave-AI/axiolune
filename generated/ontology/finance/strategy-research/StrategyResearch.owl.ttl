fin-strategy:SignalGenerator a owl:Class;
    rdfs:comment "Signal Generator, is an abstract versioned specification that generates research signals or strategy decisions under a single authority, used as the common base type of FactorDefinition and StrategyDefinition. The audit-grade executable evidence (implementation, input and output contracts, runtime, tool lock, and source artifact) is carried as optional profile-scoped attributes governed by the ValidatedReproducibleRun profile.";
    rdfs:label "Signal Generator";
    rdfs:subClassOf _:r_00c4ecd3ad1331d6566bfd66, _:r_175916283f7b7f289fefa671, _:r_447add90de41f626b685d7d7, _:r_48dc46452a6e2919dcd8bf57, _:r_4e7b98ae3c66c329f38688e7, _:r_52ed3519362bd67cca1f0308, _:r_5335bb749bcefb39974871ba, _:r_5806b7965b2a190df0cc6704, _:r_59080f65c24f32ad86f58bc2, _:r_6c30f594da3eae825b7ac267, _:r_825a31e7b04882c889149bd8, _:r_87a36d4d3786070fde91713d, _:r_ada69bf89527007c50043bef, _:r_b10593be616950364d8f11e8, _:r_b2337bba7a5b5b3eb168587b, _:r_b80e03a417bab3888972c87e, _:r_bbf1aa449f8b7577f520b5df, _:r_bfb5e9bb08da4cbd2b018683, _:r_d77c8afa229bff0eced2b5dd, _:r_dc585fd16965d9de5e79f4d3, _:r_f7c927cd8b2e2c269ce84aad, _:r_fa335ed9864aeb699aa92526, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
fin-strategy:SimulatedFill a owl:Class;
    rdfs:comment "Simulated Fill, is a temporal and provenanced fact that records one simulated fill of a SimulatedOrder under a MarketSimulationPolicy, used for expressing the order-to-fill step of a simulated trading chain.";
    rdfs:label "Simulated Fill";
    rdfs:subClassOf _:r_0ad4807cfb019335c217febd, _:r_39110e77cc90b83b873ba532, _:r_6c00d23ee0a5d36b4352025f, _:r_b25f4e79852a5841fdd7aa01, _:r_e4dba484618343ad59c9e031, _:r_f33857f568395881d436278d, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
