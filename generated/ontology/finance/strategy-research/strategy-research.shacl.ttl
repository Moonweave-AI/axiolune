fin-strategy:FactorObservationShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_pat_knowledgeFrom.
