    sh:maxCount 1.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_pat_availableTo.
fin-strategy:PerformanceObservationShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-strategy:PerformanceObservationShape sh:sparql _:sparql_valid_PerformanceObservation.
_:sparql_valid_PerformanceObservation sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-strategy:PerformanceObservationShape sh:sparql _:sparql_knowledge_PerformanceObservation.
_:sparql_knowledge_PerformanceObservation sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-strategy:PerformanceObservationShape sh:sparql _:sparql_available_PerformanceObservation.
_:sparql_available_PerformanceObservation sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_pat_source.
fin-strategy:PerformanceObservationShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
fin-strategy:FactorObservationShape a sh:NodeShape;
    sh:targetClass fin-strategy:FactorObservation;
    sh:name "Factor Observation";
    sh:description "revision-aware observation of a factor value for an instrument and reporting period, with publication (knowledge) time distinct from period and availability time (Qlib PIT model)";
    sh:property fin-strategy:FactorObservationShape_hasFactorPeriod.
fin-strategy:FactorObservationShape_hasFactorPeriod a sh:PropertyShape;
    sh:path fin-strategy:hasFactorPeriod;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_hasFactorValue.
fin-strategy:FactorObservationShape_hasFactorValue a sh:PropertyShape;
    sh:path fin-strategy:hasFactorValue;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_observesFactor.
fin-strategy:FactorObservationShape_observesFactor a sh:PropertyShape;
    sh:path fin-strategy:observesFactor;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class fin-strategy:FactorDefinition.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_observedInstrument.
fin-strategy:FactorObservationShape_observedInstrument a sh:PropertyShape;
    sh:path fin-strategy:observedInstrument;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_nextRevision.
fin-strategy:FactorObservationShape_nextRevision a sh:PropertyShape;
    sh:path fin-strategy:nextRevision;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-strategy:FactorObservation.
