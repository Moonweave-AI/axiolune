@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-strategy: <https://axiolune.ai/ontology/finance/strategy-research/>.

fin-strategy:SignalDirectionShape a sh:NodeShape;
    sh:targetClass fin-strategy:SignalDirection;
    sh:in ("Long" "Short" "Neutral" "Exit");
    sh:name "Signal Direction".
fin-strategy:FactorCategoryShape a sh:NodeShape;
    sh:targetClass fin-strategy:FactorCategory;
    sh:in ("Fundamental" "Technical" "Alternative" "Macro" "Statistical" "Sentiment");
    sh:name "Factor Category".
fin-strategy:BacktestStatusShape a sh:NodeShape;
    sh:targetClass fin-strategy:BacktestStatus;
    sh:in ("Pending" "Running" "Completed" "Failed" "Canceled");
    sh:name "Backtest Status".
fin-strategy:FactorDefinitionShape a sh:NodeShape;
    sh:targetClass fin-strategy:FactorDefinition;
    sh:name "Factor Definition";
    sh:description "specification of a quantitative factor including its calculation logic, input requirements, universe scope, and validity conditions";
    sh:property fin-strategy:FactorDefinitionShape_hasFactorName.
fin-strategy:FactorDefinitionShape_hasFactorName a sh:PropertyShape;
    sh:path fin-strategy:hasFactorName;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-strategy:FactorDefinitionShape sh:property fin-strategy:FactorDefinitionShape_hasFactorCategory.
fin-strategy:FactorDefinitionShape_hasFactorCategory a sh:PropertyShape;
    sh:path fin-strategy:hasFactorCategory;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Fundamental" "Technical" "Alternative" "Macro" "Statistical" "Sentiment").
fin-strategy:FactorDefinitionShape sh:property fin-strategy:FactorDefinitionShape_hasFactorFormula.
fin-strategy:FactorDefinitionShape_hasFactorFormula a sh:PropertyShape;
    sh:path fin-strategy:hasFactorFormula;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-strategy:StrategyDefinitionShape a sh:NodeShape;
    sh:targetClass fin-strategy:StrategyDefinition;
    sh:name "Strategy Definition";
    sh:description "specification of a trading strategy including its logic, parameters, universe, risk controls, and execution rules";
    sh:property fin-strategy:StrategyDefinitionShape_hasStrategyName.
fin-strategy:StrategyDefinitionShape_hasStrategyName a sh:PropertyShape;
    sh:path fin-strategy:hasStrategyName;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-strategy:StrategyDefinitionShape sh:property fin-strategy:StrategyDefinitionShape_hasStrategyDescription.
fin-strategy:StrategyDefinitionShape_hasStrategyDescription a sh:PropertyShape;
    sh:path fin-strategy:hasStrategyDescription;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-strategy:SignalShape a sh:NodeShape;
    sh:targetClass fin-strategy:Signal;
    sh:name "Signal";
    sh:description "point-in-time trading signal generated by a factor or strategy for a specific instrument with directional bias, strength, and validity period";
    sh:property fin-strategy:SignalShape_hasSignalDirection.
fin-strategy:SignalShape_hasSignalDirection a sh:PropertyShape;
    sh:path fin-strategy:hasSignalDirection;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Long" "Short" "Neutral" "Exit").
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_hasSignalStrength.
fin-strategy:SignalShape_hasSignalStrength a sh:PropertyShape;
    sh:path fin-strategy:hasSignalStrength;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_generatedByFactor.
fin-strategy:SignalShape_generatedByFactor a sh:PropertyShape;
    sh:path fin-strategy:generatedByFactor;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-strategy:FactorDefinition.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_generatedByStrategy.
fin-strategy:SignalShape_generatedByStrategy a sh:PropertyShape;
    sh:path fin-strategy:generatedByStrategy;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-strategy:StrategyDefinition.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_signalForInstrument.
fin-strategy:SignalShape_signalForInstrument a sh:PropertyShape;
    sh:path fin-strategy:signalForInstrument;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_pat_validFrom.
fin-strategy:SignalShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_pat_knowledgeFrom.
fin-strategy:SignalShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_pat_availableFrom.
fin-strategy:SignalShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_pat_validTo.
fin-strategy:SignalShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_pat_knowledgeTo.
fin-strategy:SignalShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_pat_availableTo.
fin-strategy:SignalShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-strategy:SignalShape sh:sparql _:sparql_valid_Signal.
_:sparql_valid_Signal sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-strategy:SignalShape sh:sparql _:sparql_knowledge_Signal.
_:sparql_knowledge_Signal sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-strategy:SignalShape sh:sparql _:sparql_available_Signal.
_:sparql_available_Signal sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_pat_source.
fin-strategy:SignalShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
fin-strategy:BacktestRunShape a sh:NodeShape;
    sh:targetClass fin-strategy:BacktestRun;
    sh:name "Backtest Run";
    sh:description "execution of a strategy definition over historical data with specified parameters, date range, initial capital, and resulting performance metrics";
    sh:property fin-strategy:BacktestRunShape_hasBacktestStatus.
fin-strategy:BacktestRunShape_hasBacktestStatus a sh:PropertyShape;
    sh:path fin-strategy:hasBacktestStatus;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Pending" "Running" "Completed" "Failed" "Canceled").
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_hasStartDate.
fin-strategy:BacktestRunShape_hasStartDate a sh:PropertyShape;
    sh:path fin-strategy:hasStartDate;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:dateTime.
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_hasEndDate.
fin-strategy:BacktestRunShape_hasEndDate a sh:PropertyShape;
    sh:path fin-strategy:hasEndDate;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:dateTime.
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_hasInitialCapital.
fin-strategy:BacktestRunShape_hasInitialCapital a sh:PropertyShape;
    sh:path fin-strategy:hasInitialCapital;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_backtestsStrategy.
fin-strategy:BacktestRunShape_backtestsStrategy a sh:PropertyShape;
    sh:path fin-strategy:backtestsStrategy;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class fin-strategy:StrategyDefinition.
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_usedPortfolio.
fin-strategy:BacktestRunShape_usedPortfolio a sh:PropertyShape;
    sh:path fin-strategy:usedPortfolio;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/portfolio-positions/Portfolio>.
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_pat_source.
fin-strategy:BacktestRunShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
fin-strategy:PerformanceObservationShape a sh:NodeShape;
    sh:targetClass fin-strategy:PerformanceObservation;
    sh:name "Performance Observation";
    sh:description "point-in-time or period-aggregate performance metrics for a backtest run or live strategy including returns, drawdown, Sharpe ratio, and other statistics";
    sh:property fin-strategy:PerformanceObservationShape_hasCumulativeReturn.
fin-strategy:PerformanceObservationShape_hasCumulativeReturn a sh:PropertyShape;
    sh:path fin-strategy:hasCumulativeReturn;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_hasMaxDrawdown.
fin-strategy:PerformanceObservationShape_hasMaxDrawdown a sh:PropertyShape;
    sh:path fin-strategy:hasMaxDrawdown;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_hasSharpeRatio.
fin-strategy:PerformanceObservationShape_hasSharpeRatio a sh:PropertyShape;
    sh:path fin-strategy:hasSharpeRatio;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_observedInBacktest.
fin-strategy:PerformanceObservationShape_observedInBacktest a sh:PropertyShape;
    sh:path fin-strategy:observedInBacktest;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class fin-strategy:BacktestRun.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_observedForStrategy.
fin-strategy:PerformanceObservationShape_observedForStrategy a sh:PropertyShape;
    sh:path fin-strategy:observedForStrategy;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-strategy:StrategyDefinition.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_pat_validFrom.
fin-strategy:PerformanceObservationShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_pat_knowledgeFrom.
fin-strategy:PerformanceObservationShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_pat_availableFrom.
fin-strategy:PerformanceObservationShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_pat_validTo.
fin-strategy:PerformanceObservationShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_pat_knowledgeTo.
fin-strategy:PerformanceObservationShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
