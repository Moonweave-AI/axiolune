fin-strategy:FactorObservationShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_pat_knowledgeTo.
fin-strategy:FactorObservationShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_pat_availableTo.
fin-strategy:FactorObservationShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-strategy:FactorObservationShape sh:sparql _:sparql_valid_FactorObservation.
_:sparql_valid_FactorObservation sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-strategy:FactorObservationShape sh:sparql _:sparql_knowledge_FactorObservation.
_:sparql_knowledge_FactorObservation sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-strategy:FactorObservationShape sh:sparql _:sparql_available_FactorObservation.
