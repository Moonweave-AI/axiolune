fin-strategy:BacktestRunShape a sh:NodeShape;
    sh:description "Backtest Run, is a run context that applies one exact strategy version to a half-open historical interval, used for locking immutable configuration such as capital, costs, slippage, fills, and benchmark, and for binding an exact StrategyExecutionPackage whose strategy, executable implementation, factor-dependency closure, and input contract must be mutually consistent; mutable run state is excluded and recorded separately by status facts, and simulated trading is recorded by SimulatedOrder, SimulatedFill, SimulatedPortfolioState, and SimulatedReturnSeries facts under a MarketSimulationPolicy. The audit-grade configuration digests are profile-scoped under ValidatedReproducibleRun.";
    sh:name "Backtest Run";
    sh:property <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/03c7fa3555f486017f66e895>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/16aeaed80c07621212409dc3>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/2ac22ba2db0856191fd64462>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/51062bbafbde6e3a7158229d>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/77300d7b435d5059fa40d597>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/8d7b7950e9ff0ffa841e5645>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/8fb72f11a4af4405efd9648e>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/9295fc8140751183696c161d>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/b1c4b4a729b6def59c56cbd7>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/b6887f7f57d86e06da00a764>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/cfc8567197c9698a6661870c>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/d44d98af69f770aca6b7a96a>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/attribute/fc3c018017e751f646a02e96>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/strategy-research/BacktestRun/shape/tempo