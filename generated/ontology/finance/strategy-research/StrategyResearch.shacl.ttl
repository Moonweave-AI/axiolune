fin-strategy:PerformanceObservationShape a sh:NodeShape;
    sh:description "Performance Observation, is a temporal and provenanced observation that binds one MetricDefinition, RunContext, and CalculationContext and carries a single Money or Quantity value, used for preserving the logical identity through knowledge-time corrections and closing prior availability through separate immutable closure evidence. The observation optionally references a PerformanceMeasurementPeriod, ReturnSeriesSnapshot, ValuationConvention, PerformanceSubject, and BenchmarkSpecification so that the measurement period, subject, return series, valuation convention, and benchmark are explicit and queryable.";
    sh:name "Performance Observation";
    sh:property <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/attribute/429eb0cd7918d3a1ab25aa31>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/attribute/44e18a7020db76cd083564e9>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/attribute/8f0e3bc1b41db47eac9b6184>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/participant-role-performanceBenchmark/85a61209253f81cac7efb15c>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/participant-role-performanceCalculationContext/f86d5d6b13f90480cf3181bf>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/participant-role-performanceMeasurementPeriod/47fc629c5733285ec66f68b0>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/participant-role-performanceMetric/feecf4bb6a688334dd52d2ca>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/participant-role-performanceReturnSeries/caa8632910887fbec135bd5e>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/participant-role-performanceRunContext/db83ec8c354886f8ea9171ec>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/participant-role-performanceSubject/b916621b6c365f15d1c0e6a0>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/participant-role-performanceValuationConvention/f3430986768390f552066464>, <https://axiolune.ai/ontology/finance/strategy-research/PerformanceObservation/shape/participant-role-supersedesPerformanceVersion/5