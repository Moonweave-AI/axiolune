fin-strategy:FactorDefinitionShape a sh:NodeShape;
    sh:description "Factor Definition, is a signal generator specification that defines one quantitative factor together with its executable expression and value contract, used for characterizing the factor itself rather than storing its computed observations. Its subject is generalized beyond a single instrument via the FactorSubject role family on FactorObservation, and its category is split into input provenance and construction method.";
    sh:name "Factor Definition";
    sh:property <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/attribute/10ecab5410d0d555a6a695f7>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/attribute/347b527b66da8977b905b55f>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/attribute/4a82628ea89cb63e2c2d8917>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/attribute/ea1488f2845de46c8be8040b>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/attribute/f8eba91a07e9aafb22e6da0c>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/strategy-research/FactorDefinition/shape/temporal/f0f2f601393d100a35dc2429>;
