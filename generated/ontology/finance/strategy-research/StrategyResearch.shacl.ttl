fin-strategy:CalculationContextShape a sh:NodeShape;
    sh:description "Calculation Context, is a versioned calculation context that fixes the metric calculation frequency, annualization, risk-free rate, window, confidence, and result-affecting policies, used for freezing the complete parameter policy as an immutable snapshot to enable reproducible performance comparison. The market calendar, time zone, session anchor, maximum staleness, and fill-value marking are exposed as a queryable CalendarAnchoringPolicy rather than a hard-coded universal axiom, and the benchmark is expressed via a versioned BenchmarkSpecification.";
    sh:name "Calculation Context";
    sh:property <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/1b2662c382a50f593a5d8039>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/1c2e4591ac84cc0af900e0a9>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/28342f65c9100b978e1120b3>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/5a1293b27ec4e91697ffd726>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/61a7bf95cbcaaa6dc52163ed>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/77300d7b435d5059fa40d597>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/89dde182b019d68b6885bf19>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/abd60fbe0cb4b45b410fb520>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/bcb0921bfe1c4e9f4638f20e>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/c41d31a474086a640c460149>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/f16539c0d1871a2ed14a7f81>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/attribute/fc3c018017e751f646a02e96>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/strategy-research/CalculationContext/sha