fin-strategy:RunContextShape a sh:NodeShape;
    sh:description "Run Context, is a versioned execution context that fixes the identity of one research, backtest, or live run together with its input snapshots, used for locking parameters, ontology, mappings, calendar, compiler, and PIT validation requests to ensure reproducibility. The strict prior-completed input context and passed PIT request are profile-scoped under ValidatedReproducibleRun; run timing is split into planned, started, scheduled, and completed instants so a planned run need not assert an actual start.";
    sh:name "Run Context";
    sh:property <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/096abc3263f5dbba3f97bf93>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/2b4989595478fef8ffb8d141>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/35b2e9311514bc57e867c0ba>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/3cb5d804553d9d42d55896ce>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/57a2760d61f991708a966e1d>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/61cb0c9fdb3ff3691f024a7d>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/63738b25422bcd1b821729c2>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/68ea4fe1c46a69a2c2ac14a7>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/6a92a167866d34ab776d0fcc>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/73ba4d92ec27255e00700f8f>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/8ab3e191c8800593d7eb8824>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/8e7a3ddbff873baac9db6dd9>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/96aec76996b8ac40c2a49a03>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/98bc01af7e4d482addc18047>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/ac69ef6d396a8bcfd2216953>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/b0909d8081b52763c0110f8f>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/b590a7db68cec9bc6e778cc8>, <https://axiolune.ai/ontology/finance/strategy-research/RunContext/shape/attribute/bc18bed2f6bdaa04b7a6589f>, <htt