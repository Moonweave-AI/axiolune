fin-strategy:ResearchRunShape a sh:NodeShape;
    sh:description "Research Run, is a run context that evaluates one exact signal-generator version against a research question, hypothesis, protocol, and dataset snapshot, used for producing reproducible and falsifiable research conclusions under locked mappings, tools, parameters, and seed. The research question, dataset, and output contract are exposed as typed business objects (ResearchQuestion, DatasetSnapshot) with their digests retained as evidence; sample partitioning, walk-forward folds, model selection, and statistical test results are recorded by their own facts.";
    sh:name "Research Run";
    sh:property <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/attribute/03c7fa3555f486017f66e895>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/attribute/2bd5adefa3f034dc691d6463>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/attribute/5a2fc0a28e796747563b384d>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/attribute/701fe5b11b71f04d53072e90>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/attribute/909004206b6470f8b6c4300f>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/attribute/aeacb9ea5f2ad1e494216e6a>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/strategy-research/ResearchRun/shape/temporal/f0f2f601393d100a35dc2429>;
