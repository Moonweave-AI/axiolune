fin-orders:OrderIntentLifecycleEventShape a sh:NodeShape;
    sh:description "An Order Intent Lifecycle Event is an immutable internal lifecycle event bound to an exact OrderIntent version but not to any ExternalOrder or OrderEventStream, used to record pre-submission internal transitions such as intent initialization, pre-submission denial, internal emulation, and emulated-order release before a provider order exists. It shares the OrderEventKind and OrderLifecycleState vocabularies with the external OrderLifecycleEvent but does not carry provider event identifiers, source order keys, raw provider status codes, or applied provider mappings.";
    sh:name "Order Intent Lifecycle Event";
    sh:property <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/attribute/59c8d6039497b4c684b8690d>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/attribute/5f73a32a7389f13cdf073373>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/attribute/cd82a5509f1948ed765435a8>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/imported-attribute/0b2d4e9529783b5f9048a1d1>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/participant-role-intentEventEmitter/31b7520317bc841236b3613f>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/participant-role-intentLifecycleOrderIntent/720cf92957964cf619f8aaaf>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLifecycleEvent/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axi