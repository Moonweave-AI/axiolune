_:temporal_valid_interval_2ccc5e4108e8f1bdd40566b8 a sh:SPARQLConstraint;
    sh:message "validFrom must occur strictly before validTo";
    sh:select "SELECT $this ?path\nWHERE {\n  $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?validFrom ;\n        <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?validTo .\n  BIND(<https://axiolune.ai/ontology/meta/patterns/attributes/validTo> AS ?path)\n  FILTER (STRDT(STR(?validFrom), <http://www.w3.org/2001/XMLSchema#dateTime>) >= STRDT(STR(?validTo), <http://www.w3.org/2001/XMLSchema#dateTime>))\n}".
