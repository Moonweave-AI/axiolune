fin-orders:MatchedTradeShape a sh:NodeShape;
    sh:description "A Matched Trade is an immutable bilateral trade fact that links two account-side executions (or one execution to its known counterparty) when bilateral evidence is sufficient, used to record the real two-sided economic trade with both contra roles required and a disclosure status. It is absent for anonymous order-book fills or client-side reports that cannot supply bilateral facts; those remain as single-sided Executions.";
    sh:name "Matched Trade";
    sh:property <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/attribute/94c11a30af4decdbcd76f319>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/attribute/b7bfbf22b1d39d8490f488e2>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/imported-attribute/0b2d4e9529783b5f9048a1d1>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/participant-role-matchedContraAccount/2db2c1c68d40ddbbb2de9661>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/participant-role-matchedContraExecution/e42831951208ea06f83efdcb>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/participant-role-matchedContraParty/c4ebc449466481cd49e8260d>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/participant-role-matchedExecution/ac9de500f1dbb111725b6d70>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/orders-execution/MatchedTrade/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/orders-exe