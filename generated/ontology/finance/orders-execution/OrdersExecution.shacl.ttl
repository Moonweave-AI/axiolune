fin-orders:OrderLifecycleEventShape a sh:NodeShape;
    sh:description "An External Order Lifecycle Event is an immutable provider event that occurs in one exact event stream version and is bound to an exact ExternalOrder, used for determining its identity and occurrence order from the provider event identifier and source order key, recording the resulting canonical lifecycle state, and tracing the raw provider status code and the exact applied status mapping and transition profile versions. Pre-submission internal lifecycle events (Initialized, Denied, Emulated, Released) that have no provider order or stream are modeled by OrderIntentLifecycleEvent, not by this external event type.";
    sh:name "External Order Lifecycle Event";
    sh:property <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/attribute/59c8d6039497b4c684b8690d>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/attribute/5f73a32a7389f13cdf073373>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/attribute/92343bf33579cfdd4e9f9eaa>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/attribute/ca9427371007f9c6642aaae3>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/attribute/cd82a5509f1948ed765435a8>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/attribute/e51c897ba876509d3b19b008>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/imported-attribute/0b2d4e9529783b5f9048a1d1>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/participant-role-eventStream/fa657e77133b2b88bf39c95a>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/participant-role-externalOrder/d29846d5619c778d724c4ddc>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/participant-role-fillSnapshot/4bee6d39f715cdd9b48c4e78>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLifecycleEvent/shape/participant-role-orde