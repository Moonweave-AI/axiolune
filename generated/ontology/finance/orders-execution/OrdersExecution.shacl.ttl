fin-orders:AllocationLineShape a sh:NodeShape;
    sh:description "An Allocation Line is an immutable allocation target line expressing one account's share of a source execution, used to model post-execution allocation, average-price allocation, and bunched-order back-allocation together with an ExecutionAllocation, while detailed allocation and clearing semantics remain in post-trade-operations.";
    sh:name "Allocation Line";
