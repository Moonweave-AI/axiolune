fin-orders:OrderRouteShape a sh:NodeShape;
    sh:description "An Order Route is an immutable routing fact that connects a parent OrderIntent (or parent route) to a child ExternalOrder or child intent via a destination, routed quantity, route time, and route status/reason, used to express venue-neutral, smart-order-router, best-execution, multi-child, and broker-decides-venue delegation without forcing the parent intent to bind a single listing or OTC context before provider acceptance.";
    sh:name "Order Route";
