fin-orders:OrderIntentLineageShape a sh:NodeShape;
    sh:description "Immutable, source-evidenced routing transformation fact connecting exact source OrderIntent versions to exact result OrderIntent versions. A split has exactly one source and at least two results; an aggregation has at least two sources and exactly one result. The closed endpoint sets, their counts, their framed digests, and the transformation key digest are version content. Its provenance artifact is the authenticated selected-graph inventory, closing the exact lineage-version set, count, framed digest, PIT request, and selection scope used by validation. Lineage expresses domain provenance only and does not represent account reservation, order submission, or any external side effect.";
    sh:name "Order Intent Lineage";
    sh:property <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/attribute/28e9cb01257b6df760209c90>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/attribute/599c92dbaf646344399facb9>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/attribute/77b90819276483dae69c98b1>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/attribute/8391b42470f94d4e7ec29374>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/attribute/e7c198dd206966bd8ecd7fc1>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/attribute/ef05ba399617d9f9ef754568>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/participant-role-resultOrderIntent/70d11c1de7e2ba3423abdbb1>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/participant-role-sourceOrderIntent/33903ce1f88698a58d2d2b55>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/orders-execution/OrderIntentLineage/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.