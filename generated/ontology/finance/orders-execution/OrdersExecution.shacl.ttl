fin-orders:OrderLegShape a sh:NodeShape;
    sh:description "An Order Leg is an optional single-leg component of a multi-leg order intent, used as an extension point for multi-leg instruments (FX swap, strategies) whose full multi-leg semantics are completed via a cross-module follow-up gated on the instruments QuotationConvention (ADR-021). In v1.1.0 a single-instrument order carries no OrderLeg and remains described directly on the OrderIntent.";
    sh:name "Order Leg";
    sh:property <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/attribute/ace30ba03a2cb472ba378366>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/attribute/b81c13b5bd359c6994fc8d88>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/orders-execution/OrderLeg/shape/temporal/f0f2f601393d100a35dc2429>;
