@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-post-trade: <https://axiolune.ai/ontology/finance/post-trade-operations/>.

fin-post-trade:CorporateActionTypeShape a sh:NodeShape;
    sh:targetClass fin-post-trade:CorporateActionType;
    sh:in ("Dividend" "Split" "Merger" "Spinoff" "RightsIssue" "Delisting");
    sh:name "Corporate Action Type".
fin-post-trade:SettlementStatusShape a sh:NodeShape;
    sh:targetClass fin-post-trade:SettlementStatus;
    sh:in ("Pending" "Settled" "Failed" "Canceled");
    sh:name "Settlement Status".
fin-post-trade:ReconciliationStatusShape a sh:NodeShape;
    sh:targetClass fin-post-trade:ReconciliationStatus;
    sh:in ("Matched" "Break" "Investigating" "Resolved");
    sh:name "Reconciliation Status".
fin-post-trade:CorporateActionEventShape a sh:NodeShape;
    sh:targetClass fin-post-trade:CorporateActionEvent;
    sh:name "Corporate Action Event";
    sh:description "scheduled or announced corporate action affecting instrument holders with ex-date, record date, payment date, and impact details";
    sh:property fin-post-trade:CorporateActionEventShape_hasActionType.
fin-post-trade:CorporateActionEventShape_hasActionType a sh:PropertyShape;
    sh:path fin-post-trade:hasActionType;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Dividend" "Split" "Merger" "Spinoff" "RightsIssue" "Delisting").
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_hasExDate.
fin-post-trade:CorporateActionEventShape_hasExDate a sh:PropertyShape;
    sh:path fin-post-trade:hasExDate;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:dateTime.
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_hasPaymentDate.
fin-post-trade:CorporateActionEventShape_hasPaymentDate a sh:PropertyShape;
    sh:path fin-post-trade:hasPaymentDate;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:dateTime.
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_affectsInstrument.
fin-post-trade:CorporateActionEventShape_affectsInstrument a sh:PropertyShape;
    sh:path fin-post-trade:affectsInstrument;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_announcedBy.
fin-post-trade:CorporateActionEventShape_announcedBy a sh:PropertyShape;
    sh:path fin-post-trade:announcedBy;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/Issuer>.
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_pat_validFrom.
fin-post-trade:CorporateActionEventShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_pat_knowledgeFrom.
fin-post-trade:CorporateActionEventShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_pat_availableFrom.
fin-post-trade:CorporateActionEventShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_pat_validTo.
fin-post-trade:CorporateActionEventShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_pat_knowledgeTo.
fin-post-trade:CorporateActionEventShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_pat_availableTo.
fin-post-trade:CorporateActionEventShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-post-trade:CorporateActionEventShape sh:sparql _:sparql_valid_CorporateActionEvent.
_:sparql_valid_CorporateActionEvent sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-post-trade:CorporateActionEventShape sh:sparql _:sparql_knowledge_CorporateActionEvent.
_:sparql_knowledge_CorporateActionEvent sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-post-trade:CorporateActionEventShape sh:sparql _:sparql_available_CorporateActionEvent.
_:sparql_available_CorporateActionEvent sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-post-trade:CorporateActionEventShape sh:property fin-post-trade:CorporateActionEventShape_pat_source.
fin-post-trade:CorporateActionEventShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
fin-post-trade:SettlementInstructionShape a sh:NodeShape;
