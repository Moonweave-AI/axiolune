fin-post-trade:ReconciliationBreakShape sh:property fin-post-trade:ReconciliationBreakShape_hasBreakAmount.
fin-post-trade:ReconciliationBreakShape_hasBreakAmount a sh:PropertyShape;
    sh:path fin-post-trade:hasBreakAmount;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
