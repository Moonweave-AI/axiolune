fin-post-trade:SettlementInstructionShape sh:property fin-post-trade:SettlementInstructionShape_pat_availableFrom.
fin-post-trade:SettlementInstructionShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
