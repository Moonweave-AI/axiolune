    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/post-trade-operations/AbsenceProofKind/value/deterministicSideAbsence> a owl:NamedIndividual, skos:Concept, fin-post-trade:AbsenceProofKind;
    rdfs:comment "a completed universe probe proves the side is absent; required by the strict profile";
    skos:inScheme <https://axiolune.ai/ontology/finance/post-trade-operations/AbsenceProofKind/scheme>;
    skos:notation "deterministicSideAbsence";
    skos:prefLabel "Deterministic side absence";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/post-trade-operations/AbsenceProofKind/value/incompleteSourceCoverage> a owl:NamedIndividual, skos:Concept, fin-post-trade:AbsenceProofKind;
    rdfs:comment "the query returned no rows and source coverage is provably incomplete";
    skos:inScheme <https://axiolune.ai/ontology/finance/post-trade-operations/AbsenceProofKind/scheme>;
    skos:notation "incompleteSourceCoverage";
    skos:prefLabel "Incomplete source coverage";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/post-trade-operations/AbsenceProofKind/value/unknownCoverage> a owl:NamedIndividual, skos:Concept, fin-post-trade:AbsenceProofKind;
    rdfs:comment "the query returned no rows but source coverage is unknown";
    skos:inScheme <https://axiolune.ai/ontology/finance/post-trade-operations/AbsenceProofKind/scheme>;
    skos:notation "unknownCoverage";
    skos:prefLabel "Unknown coverage";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
