fin-post-trade:SettlementInstruction a owl:Class;
    rdfs:comment "The settlement instruction is an authority-scoped instruction that fixes the distinct securities endpoint Parties, settlement method, date, system, and location, the exact calendar, and the leg set. The Simple DvP/FoP Settlement Profile locks the leg set to exactly one security leg (FOP) or one reciprocal security and cash leg (DVP); the generic core permits multi-leg, multi-currency, fee/tax-leg, and netted structures via additional profiles. Confirmation, affirmation, clearing, novation, and netting are out of scope and are exposed only as optional traceability hooks.";
    rdfs:label "Settlement Instruction";
    rdfs:subClassOf _:r_009c7124271cdb27289f12f9, _:r_04a79b8b859e296d703c2066, _:r_0e8ea181a00f423eceacb760, _:r_1680f07e0d4b80e3a67ca162, _:r_17749297980cf1c3b3fd6dfb, _:r_1cbef69ebd303958f77bb935, _:r_1e9e824a50caf147ebdd5f1a, _:r_1f75a49af28b8e0216b1d9f4, _:r_2a8a0e9c0e91fb7d153baed6, _:r_2d869cdeefe8225693b6f130, _:r_3c816e95b0a0e0809f9de0d1, _:r_3f6765bde5f1fb4259f2d7ea, _:r_762a75c14ba06c5e3a6b0363, _:r_8957a19ab06a5ad752dea0bd, _:r_895d71cae513d1852b64fe0a, _:r_8c081afd7eb2090a97004adf, _:r_8f149f166afb56d76c9639fc, _:r_9ac57fdcd72058c85c056c89, _:r_9cc0dc90b7c14de9a7e110b1, _:r_ad9c1f371ba0f1b2d9059649, _:r_b131a9e3ac47600359a195e6, _:r_b7cd54adfdc5db161750b803, _:r_b8543032023090b273d450a4, _:r_c8e329eef442d83f2662055c, _:r_cad51abbceb20504ba21df1f, _:r_d31f01ab1011ece9244f5729, _:r_e1ef64e9d9a252993100d73f, _:r_e62480dd50a48a51076d4f0e, _:r_e8c0fad0ad4d7444bff95966, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
