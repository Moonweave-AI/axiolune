fin-post-trade:absenceProbeDigest a owl:DatatypeProperty;
    rdfs:comment "The absence probe digest is a digest of the exact absence probe bytes and result contract, used for locking the contents and result convention of an absence probe.";
    rdfs:label "absence probe digest";
    rdfs:range xsd:string.
fin-post-trade:absenceProbeRef a owl:DatatypeProperty;
    rdfs:comment "The absence probe reference is an absolute IRI of a completed versioned absence probe, used for pointing to the probe that proves a position is absent.";
    rdfs:label "absence probe reference";
    rdfs:range xsd:anyURI.
fin-post-trade:absenceProofKind a owl:ObjectProperty;
    rdfs:comment "The absence-proof kind is a closed classification of a missing-side assertion as deterministic side absence, unknown coverage, or incomplete source coverage, used for distinguishing a proven business absence from a no-result query whose coverage is unknown.";
    rdfs:label "absence-proof kind";
    rdfs:range fin-post-trade:AbsenceProofKind.
fin-post-trade:actualSettlementInstant a owl:DatatypeProperty;
    rdfs:comment "The actual settlement instant is the point in time at which the asset movement actually occurred, distinct from the instructed, reported, and finality times.";
    rdfs:label "actual settlement instant";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:adjustmentCostBasisEffectRef a owl:DatatypeProperty;
    rdfs:comment "The adjustment cost-basis-effect reference is an optional reference to a cost-basis effect of a corporate action adjustment, used for tracing cost-basis impact.";
    rdfs:label "adjustment cost-basis-effect reference";
    rdfs:range xsd:anyURI.
fin-post-trade:adjustmentLotEffectRef a owl:DatatypeProperty;
    rdfs:comment "The adjustment lot-effect reference is an optional reference to a lot-level effect of a corporate action adjustment, used for tracing lot impact.";
    rdfs:label "adjustment lot-effect reference";
    rdfs:range xsd:anyURI.
fin-post-trade:adjustmentMovementEvidenceRef a owl:DatatypeProperty;
    rdfs:comment "The adjustment movement evidence reference is a member IRI of the complete exact completed-movement evidence set supporting an adjustment, used for pointing to each movement evidence item an adjustment relies on.";
    rdfs:label "adjustment movement evidence reference";
    rdfs:range xsd:anyURI.
fin-post-trade:adjustmentPortfolioEffectRef a owl:DatatypeProperty;
    rdfs:comment "The adjustment portfolio-effect reference is an optional reference to a portfolio-level effect of a corporate action adjustment, used for tracing portfolio impact beyond cash and quantity summaries.";
    rdfs:label "adjustment portfolio-effect reference";
    rdfs:range xsd:anyURI.
fin-post-trade:adjustmentPositionEffectRef a owl:DatatypeProperty;
    rdfs:comment "The adjustment position-effect reference is an optional reference to a position-level effect of a corporate action adjustment, used for tracing position impact.";
    rdfs:label "adjustment position-effect reference";
    rdfs:range xsd:anyURI.
fin-post-trade:affirmationRef a owl:DatatypeProperty;
    rdfs:comment "The affirmation reference is an optional traceability hook to an affirmation fact modeled in a peer module, used for linking a settlement instruction to its affirmation without modeling affirmation here.";
    rdfs:label "affirmation reference";
    rdfs:range xsd:anyURI.
fin-post-trade:allocatedMoney a owl:ObjectProperty;
    rdfs:comment "The allocated money is the optional MonetaryAmount allocated from a cash or fee or tax leg to an economic account, used for characterizing the cash dimension of a settlement leg allocation.";
    rdfs:label "allocated money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:allocatedQuantity a owl:ObjectProperty;
    rdfs:comment "The allocated quantity is a strictly positive Execution Quantity allocated to one security SettlementLeg, used for characterizing how an execution's quantity is assigned to that leg.";
    rdfs:label "allocated quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:allocationAssetKind a owl:ObjectProperty;
    rdfs:comment "The allocation asset kind is a closed classification of a settlement leg allocation as cash, security, fee, or tax, used for characterizing the asset dimension a leg allocation applies to.";
    rdfs:label "allocation asset kind";
    rdfs:range fin-post-trade:SettlementLegAllocationAssetKind.
fin-post-trade:allocationBasis a owl:DatatypeProperty;
    rdfs:comment "The allocation basis is an optional description of the rule or rationale under which a settlement leg allocation was derived, used for evidencing the allocation.";
    rdfs:label "allocation basis";
    rdfs:range xsd:string.
fin-post-trade:allocationClosureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "The allocation closure probe digest is a digest of the exact allocation closure probe bytes and result, used for locking the contents and result of an allocation closure probe.";
    rdfs:label "allocation closure probe digest";
    rdfs:range xsd:string.
fin-post-trade:allocationClosureProbeRef a owl:DatatypeProperty;
    rdfs:comment "The allocation closure probe reference is an absolute IRI of the completed allocation-set closure probe, used for pointing to the probe that proves the allocation set is complete.";
    rdfs:label "allocation closure probe reference";
    rdfs:range xsd:anyURI.
fin-post-trade:allocationCount a owl:DatatypeProperty;
    rdfs:comment "The allocation count is the count of the complete exact allocation set in economic mode, used for verifying the completeness of the economic allocation set.";
    rdfs:label "allocation count";
    rdfs:range xsd:integer.
fin-post-trade:allocationFxConversionRef a owl:DatatypeProperty;
    rdfs:comment "The allocation FX conversion reference is an optional reference to an FX rate application used to convert the allocated amount across currencies, used for evidencing cross-currency allocation.";
    rdfs:label "allocation FX conversion reference";
    rdfs:range xsd:anyURI.
fin-post-trade:allocationResidualMoney a owl:ObjectProperty;
    rdfs:comment "The allocation residual money is the optional unallocated MonetaryAmount remainder of a cash, fee, or tax leg after partial allocation, used for characterizing allocation residuals.";
    rdfs:label "allocation residual money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:allocationResidualQuantity a owl:ObjectProperty;
    rdfs:comment "The allocation residual quantity is the optional unallocated Quantity remainder of a security leg after partial allocation, used for characterizing allocation residuals.";
    rdfs:label "allocation residual quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:allocationRoundingPolicyRef a owl:DatatypeProperty;
    rdfs:comment "The allocation rounding-policy reference is an optional reference to the rounding policy applied when deriving the allocated amount, used for evidencing allocation rounding.";
    rdfs:label "allocation rounding-policy reference";
    rdfs:range xsd:anyURI.
fin-post-trade:allocationVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "The allocation version-set digest is a section-5.8 digest of the complete sorted allocation version IRI set, used for locking the contents of the economic allocation set.";
    rdfs:label "allocation version-set digest";
    rdfs:range xsd:string.
fin-post-trade:amendedSettlementDate a owl:DatatypeProperty;
    rdfs:comment "The amended settlement date is the settlement date after a rescheduling or amendment, used for distinguishing the amended from the original settlement date.";
    rdfs:label "amended settlement date";
    rdfs:range xsd:date.
fin-post-trade:announcementDate a owl:DatatypeProperty;
    rdfs:comment "The announcement date is a market-calendar date on which the action was announced, used for marking the point at which the event was publicly disclosed.";
    rdfs:label "announcement date";
    rdfs:range xsd:date.
fin-post-trade:assessmentInputVersionCount a owl:DatatypeProperty;
    rdfs:comment "The assessment input version count is the count of the complete exact-version input set used by a distribution assessment, used for verifying the completeness of the input set.";
    rdfs:label "assessment input version count";
    rdfs:range xsd:integer.
fin-post-trade:assessmentInputVersionRef a owl:DatatypeProperty;
    rdfs:comment "The assessment input version reference is a member of the complete sorted exact-version input set used by a distribution assessment, used for pointing to each input version that participates in the calculation.";
    rdfs:label "assessment input version reference";
    rdfs:range xsd:anyURI.
fin-post-trade:assessmentInputVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "The assessment input version-set digest is a section-5.8 digest of the complete sorted exact-version input set used by a distribution assessment, used for locking the contents of the input set.";
    rdfs:label "assessment input version-set digest";
    rdfs:range xsd:string.
fin-post-trade:assessmentPercentage a owl:DatatypeProperty;
    rdfs:comment "The assessment percentage is a strictly positive candidate-specific distribution percentage produced after locked calculation or official input, used for characterizing the distribution ratio for that candidate.";
    rdfs:label "assessment percentage";
    rdfs:range xsd:decimal.
fin-post-trade:atomicCompletionEvidenceDigest a owl:DatatypeProperty;
    rdfs:comment "The atomic completion evidence digest is a digest of the exact DVP group completion evidence, used for locking the contents of the DVP atomic-completion evidence.";
    rdfs:label "atomic completion evidence digest";
    rdfs:range xsd:string.
fin-post-trade:atomicCompletionEvidenceRef a owl:DatatypeProperty;
    rdfs:comment "The atomic completion evidence reference is an absolute IRI proving both DVP legs completed atomically, used for pointing to the evidence that a DVP settlement completed atomically.";
    rdfs:label "atomic completion evidence reference";
    rdfs:range xsd:anyURI.
fin-post-trade:atomicGroupId a owl:DatatypeProperty;
    rdfs:comment "The atomic group identifier is a provider-scoped identifier that groups the complete DVP or FOP settlement-leg set, used for binding the legs that must complete atomically into one group.";
    rdfs:label "atomic group identifier";
    rdfs:range xsd:string.
fin-post-trade:authorityScopedId a owl:DatatypeProperty;
    rdfs:comment "The authority-scoped identifier is a non-empty identifier unique within the exact source-authority logical identity, used for uniquely referring to one object within its source authority.";
    rdfs:label "authority-scoped identifier";
    rdfs:range xsd:string.
fin-post-trade:bookDate a owl:DatatypeProperty;
    rdfs:comment "The book date is the optional accounting book date of an external statement entry, distinct from its value date, used for separating book and value timing.";
    rdfs:label "book date";
    rdfs:range xsd:date.
fin-post-trade:bridgeValidFrom a owl:DatatypeProperty;
    rdfs:comment "The bridge valid-from date is the optional date from which a custody settlement account bridge is effective, used for time-scoping the bridge.";
    rdfs:label "bridge valid-from";
    rdfs:range xsd:date.
fin-post-trade:bridgeValidTo a owl:DatatypeProperty;
    rdfs:comment "The bridge valid-to date is the optional date until which a custody settlement account bridge is effective, used for time-scoping the bridge.";
    rdfs:label "bridge valid-to";
    rdfs:range xsd:date.
fin-post-trade:candidateClosureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "The candidate closure probe digest is a digest of the exact candidate-closure probe bytes and result, used for locking the contents and result of a candidate closure probe.";
    rdfs:label "candidate closure probe digest";
    rdfs:range xsd:string.
fin-post-trade:candidateClosureProbeRef a owl:DatatypeProperty;
    rdfs:comment "The candidate closure probe reference is an absolute IRI of the completed election-candidate closure probe, used for pointing to the probe that proves the candidate set is complete.";
    rdfs:label "candidate closure probe reference";
    rdfs:range xsd:anyURI.
fin-post-trade:candidateElectionCount a owl:DatatypeProperty;
    rdfs:comment "The candidate election count is the count of the complete exact timely candidate set, used for verifying the completeness of the timely candidate set.";
    rdfs:label "candidate election count";
    rdfs:range xsd:integer.
fin-post-trade:candidateElectionSetDigest a owl:DatatypeProperty;
    rdfs:comment "The candidate election-set digest is a section-5.8 digest of the complete sorted candidate version IRI set, used for locking the contents of the timely candidate set.";
    rdfs:label "candidate election-set digest";
    rdfs:range xsd:string.
fin-post-trade:canonicalizationDigest a owl:DatatypeProperty;
    rdfs:comment "The canonicalization digest is a digest of the Money and Quantity canonicalization contract, used for locking the value-normalization conventions.";
    rdfs:label "canonicalization digest";
    rdfs:range xsd:string.
fin-post-trade:cashCalculatedInput a owl:DatatypeProperty;
    rdfs:comment "The cash calculated input is a branch marker that is true when the distribution percentage is computed as cash per unit divided by a reviewed reference price, used for flagging the cash-kind calculation input source.";
    rdfs:label "cash calculated input";
    rdfs:range xsd:boolean.
fin-post-trade:cashDelta a owl:ObjectProperty;
    rdfs:comment "The cash delta is a signed Money adjustment from the beneficiary account perspective, used for characterizing the cash increase or decrease caused by an adjustment.";
    rdfs:label "cash delta";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:cashEffectiveDate a owl:DatatypeProperty;
    rdfs:comment "The cash effective date is the resolved market-calendar date of the cash component, used for marking the date the cash part of an adjustment becomes effective.";
    rdfs:label "cash effective date";
    rdfs:range xsd:date.
fin-post-trade:cashPerUnit a owl:ObjectProperty;
    rdfs:comment "The cash per unit is a strictly positive Money amount distributed for each entitled unit, used for characterizing the cash amount owed per unit in a cash dividend.";
    rdfs:label "cash per unit";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:clearingRef a owl:DatatypeProperty;
    rdfs:comment "The clearing reference is an optional traceability hook to a clearing obligation or CCP relationship modeled in a peer module, used for linking a settlement instruction to clearing without modeling clearing here.";
    rdfs:label "clearing reference";
    rdfs:range xsd:anyURI.
fin-post-trade:comparisonCurrencyAlphaCode a owl:DatatypeProperty;
    rdfs:comment "The comparison currency alpha code is exactly three uppercase ASCII letters forming the cash asset identity of a canonical reconciliation key, used for characterizing the currency of a cash comparison key.";
    rdfs:label "comparison currency alpha code";
    rdfs:range xsd:string.
fin-post-trade:comparisonCurrencyScale a owl:DatatypeProperty;
    rdfs:comment "The comparison currency scale is a non-negative currency minor-unit or locked decimal-scale contract that forms the cash unit identity of a canonical reconciliation key, used for characterizing the precision of a cash comparison key.";
    rdfs:label "comparison currency scale";
    rdfs:range xsd:integer.
fin-post-trade:comparisonKeyDigest a owl:DatatypeProperty;
    rdfs:comment "The comparison-key digest is a tagged JCS digest of the complete canonical settlement comparison key, used for locking the matching key used in reconciliation.";
    rdfs:label "comparison-key digest";
    rdfs:range xsd:string.
fin-post-trade:comparisonQuantityUnit a owl:DatatypeProperty;
    rdfs:comment "The comparison quantity unit is an absolute controlled Quantity-unit IRI forming the security unit identity of a canonical reconciliation key, used for characterizing the quantity unit of a security comparison key.";
    rdfs:label "comparison quantity unit";
    rdfs:range xsd:anyURI.
fin-post-trade:confirmationRef a owl:DatatypeProperty;
    rdfs:comment "The confirmation reference is an optional traceability hook to a trade-confirmation fact modeled in a peer module, used for linking a settlement instruction to its confirmation without modeling confirmation here.";
    rdfs:label "confirmation reference";
    rdfs:range xsd:anyURI.
fin-post-trade:coveragePeriodEnd a owl:DatatypeProperty;
    rdfs:comment "The coverage-period end is the optional end date of the period covered by an external settlement statement, used for characterizing multi-day statement coverage.";
    rdfs:label "coverage-period end";
    rdfs:range xsd:date.
fin-post-trade:coveragePeriodStart a owl:DatatypeProperty;
    rdfs:comment "The coverage-period start is the optional start date of the period covered by an external settlement statement, used for characterizing multi-day statement coverage.";
    rdfs:label "coverage-period start";
    rdfs:range xsd:date.
fin-post-trade:coverageUnknownReason a owl:DatatypeProperty;
    rdfs:comment "The coverage-unknown reason is an optional description of why source coverage could not be established for a no-result query, used for evidencing an incomplete source coverage assertion.";
    rdfs:label "coverage-unknown reason";
    rdfs:range xsd:string.
fin-post-trade:crossMismatchDimension a owl:ObjectProperty;
    rdfs:comment "The cross-side mismatch dimension is the sorted set of dimensions that differ across internal projections and external statement lines in a non-empty bucket, used for characterizing the per-dimension differences of values across both sides.";
    rdfs:label "cross-side mismatch dimension";
    rdfs:range fin-post-trade:MismatchDimension.
fin-post-trade:crossSideValueRelation a owl:ObjectProperty;
    rdfs:comment "The cross-side value relation is an allEqual or mismatch relation that holds when both duplicate-bucket sides are non-empty, used for characterizing whether the two sides of a duplicate bucket agree.";
    rdfs:label "cross-side value relation";
    rdfs:range fin-post-trade:CrossSideValueRelation.
fin-post-trade:cumEntitlementEnd a owl:DatatypeProperty;
    rdfs:comment "The cum-entitlement end is the exclusive end instant of the due-bill qualifying execution interval, used for bounding the end of the qualifying execution window for due-bill trades.";
    rdfs:label "cum-entitlement end";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:cumEntitlementStart a owl:DatatypeProperty;
    rdfs:comment "The cum-entitlement start is the inclusive start instant of the due-bill qualifying execution interval, used for bounding the start of the qualifying execution window for due-bill trades.";
    rdfs:label "cum-entitlement start";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:deadlineCutoffContractDigest a owl:DatatypeProperty;
    rdfs:comment "The deadline/cutoff contract digest is a digest of the election deadline and cutoff semantics, used for locking the rules that govern deadline judgement.";
    rdfs:label "deadline/cutoff contract digest";
    rdfs:range xsd:string.
fin-post-trade:deadlineInclusive a owl:DatatypeProperty;
    rdfs:comment "The deadline inclusive flag is a marker that is true exactly when a candidate received at the cutoff instant remains timely, used for characterizing whether the cutoff includes its endpoint.";
    rdfs:label "deadline inclusive";
    rdfs:range xsd:boolean.
fin-post-trade:defaultLapse a owl:DatatypeProperty;
    rdfs:comment "The default lapse is a result branch marker that is true when a probe proves the candidate set is empty at or after the deadline, used for flagging that an election defaults to lapse because no candidate was timely.";
    rdfs:label "default lapse";
    rdfs:range xsd:boolean.
fin-post-trade:dispositionKind a owl:ObjectProperty;
    rdfs:comment "The disposition kind is a closed classification of a finding-level reconciliation disposition as accepted, investigated, corrected, waived, escalated, reopened, or externally pending, used for characterizing the resolution workflow.";
    rdfs:label "disposition kind";
    rdfs:range fin-post-trade:ReconciliationDispositionKind.
fin-post-trade:dueBillObligationCount a owl:DatatypeProperty;
    rdfs:comment "The due-bill obligation count is the count of the complete exact-version obligation set, used for verifying the completeness of the due-bill obligation set.";
    rdfs:label "due-bill obligation count";
    rdfs:range xsd:integer.
fin-post-trade:dueBillObligationSetDigest a owl:DatatypeProperty;
    rdfs:comment "The due-bill obligation-set digest is a section-5.8 digest of the complete sorted obligation version IRI set, used for locking the contents of the due-bill obligation set.";
    rdfs:label "due-bill obligation-set digest";
    rdfs:range xsd:string.
fin-post-trade:duplicateFinding a owl:DatatypeProperty;
    rdfs:comment "The duplicate finding is a branch marker that is true when either exact side count exceeds one, used for flagging that a key bucket contains duplicates.";
    rdfs:label "duplicate finding";
    rdfs:range xsd:boolean.
fin-post-trade:duplicateSide a owl:ObjectProperty;
    rdfs:comment "The duplicate side is a closed internal, external, or both duplicate side, used for characterizing which side or sides a duplicate occurs on.";
    rdfs:label "duplicate side";
    rdfs:range fin-post-trade:DuplicateSide.
fin-post-trade:economicAccountAllocationMode a owl:DatatypeProperty;
    rdfs:comment "The economic-account allocation mode is a case branch marker that is true when the case projects under complete economic allocation, used for flagging that the internal projection takes the economic-account-allocation perspective.";
    rdfs:label "economic-account allocation mode";
    rdfs:range xsd:boolean.
fin-post-trade:effectiveDate a owl:DatatypeProperty;
    rdfs:comment "The effective date is a market-calendar date on which a security change takes effect, used for marking the point at which a split or successor-security change actually becomes effective.";
    rdfs:label "effective date";
    rdfs:range xsd:date.
fin-post-trade:electedQuantity a owl:ObjectProperty;
    rdfs:comment "The elected quantity is a strictly positive exercised successor-security Quantity, forbidden for decline or lapse, used for characterizing the quantity actually exercised in an election.";
    rdfs:label "elected quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:electionDeadline a owl:DatatypeProperty;
    rdfs:comment "The election deadline is a market-calendar deadline for a rights election under explicit cutoff semantics, used for bounding the last day by which an election must be received.";
    rdfs:label "election deadline";
    rdfs:range xsd:date.
fin-post-trade:electionDeadlineCutoff a owl:DatatypeProperty;
    rdfs:comment "The election deadline cutoff is an explicit policy-scope instant against which a provider's receivedAt is compared, used for judging whether an election is timely.";
    rdfs:label "election deadline cutoff";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:electionDeadlineCutoffSource a owl:DatatypeProperty;
    rdfs:comment "The election-deadline cutoff source is an optional reference to the authority or market practice that defines the election deadline cutoff, used for evidencing the derivation of the policy cutoff from the event date.";
    rdfs:label "election-deadline cutoff source";
    rdfs:range xsd:anyURI.
fin-post-trade:electionDeadlineTimezone a owl:DatatypeProperty;
    rdfs:comment "The election-deadline timezone is the optional timezone in which an event-level election deadline date is interpreted, used for deriving the policy cutoff instant without ambiguity.";
    rdfs:label "election-deadline timezone";
    rdfs:range xsd:string.
fin-post-trade:electionDecision a owl:ObjectProperty;
    rdfs:comment "The election decision is a member of the closed classification that indicates whether the holder exercises or explicitly declines the rights election, used for characterizing the decision recorded in an election.";
    rdfs:label "election decision";
    rdfs:range fin-post-trade:ElectionDecision.
fin-post-trade:electionEquivalenceField a owl:DatatypeProperty;
    rdfs:comment "The election equivalence field is an absolute ontology-field IRI included in deterministic election-candidate equivalence, used for naming the field used to judge candidate equivalence.";
    rdfs:label "election equivalence field";
    rdfs:range xsd:anyURI.
fin-post-trade:electionPolicyAuthority a owl:ObjectProperty;
    rdfs:comment "The election policy authority is a Party version that issues the election-provider policy identity, used for pointing to the authority publisher behind the election policy.";
    rdfs:domain fin-post-trade:CorporateActionElectionProviderPolicy;
    rdfs:label "election policy authority";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
fin-post-trade:electionPolicyEventAuthority a owl:ObjectProperty;
    rdfs:comment "The election policy event authority is a logical event authority whose scope is normalized by the policy, used for binding the election policy to the event-authority scope it governs.";
    rdfs:domain fin-post-trade:CorporateActionElectionProviderPolicy;
    rdfs:label "election policy event authority";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-post-trade:electionPolicyPrecedenceEdge a owl:ObjectProperty;
    rdfs:comment "The election policy precedence edge is an exact traversable typed precedence edge closed by a given policy version, used for reaching the acyclic precedence graph governed by that policy.";
    rdfs:domain fin-post-trade:CorporateActionElectionProviderPolicy;
    rdfs:label "election policy precedence edge";
    rdfs:range fin-post-trade:CorporateActionElectionProviderPrecedenceEdge.
fin-post-trade:electionPolicyProviderMember a owl:ObjectProperty;
    rdfs:comment "The election policy provider member is an exact traversable provider-member fact closed by a given policy version, used for reaching the eligible provider members governed by that policy.";
    rdfs:domain fin-post-trade:CorporateActionElectionProviderPolicy;
    rdfs:label "election policy provider member";
    rdfs:range fin-post-trade:CorporateActionElectionProviderMember.
fin-post-trade:electionPolicyProviderNormalization a owl:ObjectProperty;
    rdfs:comment "The election policy provider normalization is an exact traversable raw-to-logical provider mapping closed by a given policy version, used for reaching the normalization mappings governed by that policy.";
    rdfs:domain fin-post-trade:CorporateActionElectionProviderPolicy;
    rdfs:label "election policy provider normalization";
    rdfs:range fin-post-trade:CorporateActionElectionProviderNormalization.
fin-post-trade:eligibleProviderCount a owl:DatatypeProperty;
    rdfs:comment "The eligible provider count is the count of traversable provider-member facts closed by the policy version, used for verifying the completeness of the eligible provider set.";
    rdfs:label "eligible provider count";
    rdfs:range xsd:integer.
fin-post-trade:eligibleProviderSetDigest a owl:DatatypeProperty;
    rdfs:comment "The eligible-provider set digest is a digest of the sorted eligible election-provider logical IRI set, used for locking the eligible provider set recognized by a policy.";
    rdfs:label "eligible-provider set digest";
    rdfs:range xsd:string.
fin-post-trade:eligibleQuantity a owl:ObjectProperty;
    rdfs:comment "The eligible quantity is the record Quantity plus incoming obligations minus outgoing obligations, used for characterizing the holding quantity actually eligible for entitlement computation.";
    rdfs:label "eligible quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:entitledCash a owl:ObjectProperty;
    rdfs:comment "The entitled cash is the cash-dividend Money computed from the eligible Quantity and the cash per unit, used for characterizing the cash amount an entitlement is owed.";
    rdfs:label "entitled cash";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:entitlementPivot a owl:DatatypeProperty;
    rdfs:comment "The entitlement pivot is an explicit instant at which record position and account roles are evaluated, used for fixing the point-in-time position and roles taken in entitlement computation.";
    rdfs:label "entitlement pivot";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:entitlementRatio a owl:DatatypeProperty;
    rdfs:comment "The entitlement ratio is a strictly positive dimensionless rights entitlement per affected-security unit, used for characterizing how many rights each share receives.";
    rdfs:label "entitlement ratio";
    rdfs:range xsd:decimal.
fin-post-trade:entryDirection a owl:ObjectProperty;
    rdfs:comment "The statement entry direction is a closed debit or credit direction from the focal-account perspective, used for characterizing whether a statement line is a debit or credit to the focal account.";
    rdfs:label "statement entry direction";
    rdfs:range fin-post-trade:StatementEntryDirection.
fin-post-trade:entryIsCorrection a owl:DatatypeProperty;
    rdfs:comment "The entry-is-correction flag indicates that an external statement entry is a correction of a prior entry, used for distinguishing corrections from originals.";
    rdfs:label "entry is correction";
    rdfs:range xsd:boolean.
fin-post-trade:entryIsReversal a owl:DatatypeProperty;
    rdfs:comment "The entry-is-reversal flag indicates that an external statement entry is a reversal of a prior entry, used for distinguishing reversals from originals.";
    rdfs:label "entry is reversal";
    rdfs:range xsd:boolean.
fin-post-trade:equivalenceFieldsDigest a owl:DatatypeProperty;
    rdfs:comment "The equivalence-fields digest is a digest of the exact candidate equivalence field contract, used for locking the field set used in equivalence judgement.";
    rdfs:label "equivalence-fields digest";
    rdfs:range xsd:string.
fin-post-trade:eventScopeDigest a owl:DatatypeProperty;
    rdfs:comment "The event scope digest is a digest of the event authority, kind, and scope controlled by a provider policy, used for locking the event range the policy covers.";
    rdfs:label "event scope digest";
    rdfs:range xsd:string.
fin-post-trade:evidenceSetDigest a owl:DatatypeProperty;
    rdfs:comment "The evidence-set digest is a digest of the sorted exact evidence version set supporting a finding, used for locking the evidence set on which a finding relies.";
    rdfs:label "evidence-set digest";
    rdfs:range xsd:string.
fin-post-trade:exDate a owl:DatatypeProperty;
    rdfs:comment "The ex date is a market-calendar date from which the security trades without the entitlement, used for marking the point at which a buyer no longer receives the entitlement.";
    rdfs:label "ex date";
    rdfs:range xsd:date.
fin-post-trade:executionOnlyQualification a owl:DatatypeProperty;
    rdfs:comment "The execution-only qualification is a branch marker that is true when the winning resolution permits execution-only qualification, used for flagging that a due-bill may qualify on execution alone rather than settlement evidence.";
    rdfs:label "execution-only qualification";
    rdfs:range xsd:boolean.
fin-post-trade:expectedSide a owl:ObjectProperty;
    rdfs:comment "The expected reconciliation side is a closed internal or external side proven absent, used for characterizing the side that should have been present but is empty in a missing-side assertion.";
    rdfs:label "expected reconciliation side";
    rdfs:range fin-post-trade:ReconciliationSide.
fin-post-trade:externalClaimId a owl:DatatypeProperty;
    rdfs:comment "The external claim identifier is an authority-scoped immutable external claim identifier, used for referring to a locked external-claim source declaration.";
    rdfs:label "external claim identifier";
    rdfs:range xsd:string.
fin-post-trade:externalCount a owl:DatatypeProperty;
    rdfs:comment "The external count is the exact number of external StatementLine versions in the key bucket, used for characterizing how many items the key bucket has on the external side.";
    rdfs:label "external count";
    rdfs:range xsd:integer.
fin-post-trade:externalDuplicateValueRelation a owl:ObjectProperty;
    rdfs:comment "The external duplicate value relation is an identical or conflicting relation among external duplicate values, used for characterizing whether the external-side duplicate values agree.";
    rdfs:label "external duplicate value relation";
    rdfs:range fin-post-trade:DuplicateValueRelation.
fin-post-trade:externalMismatchDimension a owl:ObjectProperty;
    rdfs:comment "The external mismatch dimension is the sorted set of dimensions that differ among external statement lines in a duplicate bucket, used for characterizing the per-dimension differences of external-side duplicate values.";
    rdfs:label "external mismatch dimension";
    rdfs:range fin-post-trade:MismatchDimension.
fin-post-trade:fieldMappingDigest a owl:DatatypeProperty;
    rdfs:comment "The field mapping digest is a digest of the exact provider field-normalization mapping, used for locking the convention that maps provider fields to canonical fields.";
    rdfs:label "field mapping digest";
    rdfs:range xsd:string.
fin-post-trade:finalityInstant a owl:DatatypeProperty;
    rdfs:comment "The finality instant is the point in time at which legal or system settlement finality is achieved, distinct from the reported observation time and the knowledge/availability pivots.";
    rdfs:label "finality instant";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:finalityKind a owl:ObjectProperty;
    rdfs:comment "The finality kind is a closed classification of settlement finality as provisional, unconditional, or irrevocable, used for characterizing the legal or system finality status distinct from a source-reported settled status.";
    rdfs:label "finality kind";
    rdfs:range fin-post-trade:SettlementFinalityKind.
fin-post-trade:finalityProviderEventId a owl:DatatypeProperty;
    rdfs:comment "The finality provider event id is the provider-scoped identifier of a settlement finality event, used for distinguishing finality records within a provider scope.";
    rdfs:label "finality provider event id";
    rdfs:range xsd:string.
fin-post-trade:finalityRuleBasisRef a owl:DatatypeProperty;
    rdfs:comment "The finality rule-basis reference is an optional reference to the rule or law under which settlement finality is achieved, used for evidencing the finality basis.";
    rdfs:label "finality rule-basis reference";
    rdfs:range xsd:anyURI.
fin-post-trade:finalitySystem a owl:DatatypeProperty;
    rdfs:comment "The finality system is the settlement system under whose rules finality is achieved, used for characterizing the finality context. The string form is a source representation; an authority-scoped identifier form is optional.";
    rdfs:label "finality system";
    rdfs:range xsd:string.
fin-post-trade:findingKind a owl:ObjectProperty;
    rdfs:comment "The reconciliation finding kind is a closed matched, valueMismatch, duplicate, or missingSide result, used for characterizing the specific category of a reconciliation finding.";
    rdfs:label "reconciliation finding kind";
    rdfs:range fin-post-trade:ReconciliationFindingKind.
fin-post-trade:findingStage a owl:ObjectProperty;
    rdfs:comment "The processing finding stage is a closed schedule, entitlement, or due-bill processing stage, used for characterizing which stage of corporate-action processing a finding occurs in.";
    rdfs:label "processing finding stage";
    rdfs:range fin-post-trade:ProcessingFindingStage.
fin-post-trade:findingSubjectDigest a owl:DatatypeProperty;
    rdfs:comment "The finding-subject digest is a tagged JCS digest with domain axiolune-reconciliation-finding-subject-v1 NUL over the strict RFC-001 object {schemaVersion:\"1.0\", variant, internalVersionIris, externalVersionIris, missingSideAssertionVersionIri?}; the optional field is omitted, never null, outside missing-side and composite duplicate rows, and case/comparison-key fields are not members of this digest domain, used for locking the subject contents a reconciliation finding carries.";
    rdfs:label "finding-subject digest";
    rdfs:range xsd:string.
fin-post-trade:formulaDigest a owl:DatatypeProperty;
    rdfs:comment "The formula digest is a SHA-256 digest of the canonical bytes that define the calculation formula, used for locking the specific formula applied to the distribution percentage.";
    rdfs:label "formula digest";
    rdfs:range xsd:string.
fin-post-trade:fromDirectAccount a owl:DatatypeProperty;
    rdfs:comment "The from direct account is a branch marker that is true when the from economic account equals the security-leg from account, used for flagging that the from endpoint needs no custody bridge.";
    rdfs:label "from direct account";
    rdfs:range xsd:boolean.
fin-post-trade:fulfilledMoney a owl:ObjectProperty;
    rdfs:comment "The fulfilled Money is the canonical sum of completed, de-duplicated Money transfers, used for characterizing the cash amount by which an obligation has been fulfilled.";
    rdfs:label "fulfilled Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:fulfilledQuantity a owl:ObjectProperty;
    rdfs:comment "The fulfilled Quantity is the canonical sum of completed, de-duplicated Quantity transfers, used for characterizing the security quantity by which an obligation has been fulfilled.";
    rdfs:label "fulfilled Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:fulfilledSubscriptionCash a owl:ObjectProperty;
    rdfs:comment "The fulfilled subscription cash total is a canonical completed cash sum, including the canonical zero for an empty set, used for characterizing the total cash a subscription obligation has fulfilled.";
    rdfs:label "fulfilled subscription cash total";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:fulfilledSubscriptionMoney a owl:ObjectProperty;
    rdfs:comment "The fulfilled subscription Money is a positive subscription cash payment amount, used for characterizing the cash paid by a single subscription fulfillment.";
    rdfs:label "fulfilled subscription Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:fulfilledSubscriptionQuantity a owl:ObjectProperty;
    rdfs:comment "The fulfilled subscription Quantity is a positive successor-security delivery Quantity, used for characterizing the securities delivered by a single subscription fulfillment.";
    rdfs:label "fulfilled subscription Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:fulfilledSubscriptionSecurity a owl:ObjectProperty;
    rdfs:comment "The fulfilled subscription security total is a canonical completed successor-security Quantity sum, including zero, used for characterizing the total securities a subscription obligation has delivered.";
    rdfs:label "fulfilled subscription security total";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:fulfillmentOccurrenceTime a owl:DatatypeProperty;
    rdfs:comment "The fulfillment occurrence time is an explicit instant of completed subscription movement evidence, used for marking when a subscription fulfillment occurs.";
    rdfs:label "fulfillment occurrence time";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:fulfillmentResult a owl:ObjectProperty;
    rdfs:comment "The fulfillment result is a closed unfulfilled, partially fulfilled, or fully fulfilled closure result, used for giving the final fulfillment state of an obligation.";
    rdfs:label "fulfillment result";
    rdfs:range fin-post-trade:FulfillmentResult.
fin-post-trade:implementationDigest a owl:DatatypeProperty;
    rdfs:comment "The implementation digest is a digest of the executable implementation bytes, used for locking the implementation version that performs the calculation.";
    rdfs:label "implementation digest";
    rdfs:range xsd:string.
fin-post-trade:inputContractDigest a owl:DatatypeProperty;
    rdfs:comment "The input contract digest is a digest of a versioned executable input contract, used for locking the executable input agreement of a calculation.";
    rdfs:label "input contract digest";
    rdfs:range xsd:string.
fin-post-trade:internalCount a owl:DatatypeProperty;
    rdfs:comment "The internal count is the exact number of internal Projection versions in the key bucket, used for characterizing how many items the key bucket has on the internal side.";
    rdfs:label "internal count";
    rdfs:range xsd:integer.
fin-post-trade:internalDuplicateValueRelation a owl:ObjectProperty;
    rdfs:comment "The internal duplicate value relation is an identical or conflicting relation among internal duplicate values, used for characterizing whether the internal-side duplicate values agree.";
    rdfs:label "internal duplicate value relation";
    rdfs:range fin-post-trade:DuplicateValueRelation.
fin-post-trade:internalMismatchDimension a owl:ObjectProperty;
    rdfs:comment "The internal mismatch dimension is the sorted set of dimensions that differ among internal projections in a duplicate bucket, used for characterizing the per-dimension differences of internal-side duplicate values.";
    rdfs:label "internal mismatch dimension";
    rdfs:range fin-post-trade:MismatchDimension.
fin-post-trade:internalProjectionMode a owl:ObjectProperty;
    rdfs:comment "The internal projection mode is a closed settlement-account or economic-account-allocation mode, used for characterizing how the internal side of a reconciliation aggregates comparison values.";
    rdfs:label "internal projection mode";
    rdfs:range fin-post-trade:InternalProjectionMode.
fin-post-trade:internalSourceVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "The internal-source version-set digest is a digest of the exact leg, allocation, and bridge tuple set feeding one projection, used for locking the internal source set a projection relies on.";
    rdfs:label "internal-source version-set digest";
    rdfs:range xsd:string.
fin-post-trade:matchBasis a owl:DatatypeProperty;
    rdfs:comment "The match basis is an optional description of the rule or rationale under which a reconciliation match group was formed, used for evidencing non-strict matches.";
    rdfs:label "match basis";
    rdfs:range xsd:string.
fin-post-trade:matchCardinality a owl:ObjectProperty;
    rdfs:comment "The match cardinality is a closed classification of a reconciliation match group as one-to-one, one-to-many, many-to-one, or many-to-many, used for characterizing the matching shape under a non-strict profile.";
    rdfs:label "match cardinality";
    rdfs:range fin-post-trade:MatchCardinality.
fin-post-trade:matchGroupSubjectDigest a owl:DatatypeProperty;
    rdfs:comment "The match-group subject digest is a tagged digest locking the exact internal and external member versions grouped as one logical business fact, used for locking the subject contents a reconciliation match group carries.";
    rdfs:label "match-group subject digest";
    rdfs:range xsd:string.
fin-post-trade:matchedFinding a owl:DatatypeProperty;
    rdfs:comment "The matched finding is a branch marker that is true when the comparison is one-to-one and equal, used for flagging that a key bucket is fully matched.";
    rdfs:label "matched finding";
    rdfs:range xsd:boolean.
fin-post-trade:maximumRightsQuantity a owl:ObjectProperty;
    rdfs:comment "The maximum rights quantity is the maximum successor-security Quantity eligible for rights exercise, used for capping the upper bound an exercise must not exceed.";
    rdfs:label "maximum rights quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:mismatchDimension a owl:ObjectProperty;
    rdfs:comment "The mismatch dimension is a closed typed dimension that explains a value mismatch, used for characterizing which dimension a value difference arises in.";
    rdfs:label "mismatch dimension";
    rdfs:range fin-post-trade:MismatchDimension.
fin-post-trade:missingSideFinding a owl:DatatypeProperty;
    rdfs:comment "The missing-side finding is a branch marker that is true when the comparison is one-to-zero or zero-to-one, used for flagging that one side of a key bucket is missing.";
    rdfs:label "missing-side finding";
    rdfs:range xsd:boolean.
fin-post-trade:movementEvidenceCount a owl:DatatypeProperty;
    rdfs:comment "The movement-evidence count is the count of the complete exact movement evidence set supporting an adjustment, used for verifying the completeness of an adjustment's evidence set.";
    rdfs:label "movement-evidence count";
    rdfs:range xsd:integer.
fin-post-trade:movementEvidenceDigest a owl:DatatypeProperty;
    rdfs:comment "The movement evidence digest is a digest of exact movement evidence bytes or a fact-version set, used for locking the contents of movement evidence.";
    rdfs:label "movement evidence digest";
    rdfs:range xsd:string.
fin-post-trade:movementEvidenceRef a owl:DatatypeProperty;
    rdfs:comment "The movement evidence reference is an absolute IRI of exact transfer, settlement, or account-adjustment evidence, used for pointing to the evidence that proves an asset has moved.";
    rdfs:label "movement evidence reference";
    rdfs:range xsd:anyURI.
fin-post-trade:movementEvidenceSetDigest a owl:DatatypeProperty;
    rdfs:comment "The movement-evidence set digest is a section-5.8 IRI-set digest of the complete exact movement evidence set supporting an adjustment, used for locking the movement evidence set an adjustment relies on.";
    rdfs:label "movement-evidence set digest";
    rdfs:range xsd:string.
fin-post-trade:nettingSetRef a owl:DatatypeProperty;
    rdfs:comment "The netting-set reference is an optional traceability hook to a netting set modeled in a peer module, used for linking a settlement instruction to its netting context without modeling netting here.";
    rdfs:label "netting-set reference";
    rdfs:range xsd:anyURI.
fin-post-trade:nonTransferableDirectSubscription a owl:DatatypeProperty;
    rdfs:comment "The non-transferable direct subscription is a marker that is true only for the supported non-transferable direct-subscription rights profile, used for flagging that the right cannot be traded on the secondary market.";
    rdfs:label "non-transferable direct subscription";
    rdfs:range xsd:boolean.
fin-post-trade:normalizedProviderKey a owl:DatatypeProperty;
    rdfs:comment "The normalized provider key is a non-empty canonical provider key shared by one membership and its raw-key mappings, used for characterizing the canonical provider identifier after normalization.";
    rdfs:label "normalized provider key";
    rdfs:range xsd:string.
fin-post-trade:normalizedSettlementReference a owl:DatatypeProperty;
    rdfs:comment "The normalized settlement reference is a strictly comparator-normalized settlement reference for which fuzzy guessing is forbidden, used for serving as the deterministic matching key in reconciliation.";
    rdfs:label "normalized settlement reference";
    rdfs:range xsd:string.
fin-post-trade:numericTolerance a owl:DatatypeProperty;
    rdfs:comment "The numeric tolerance is a numeric comparison tolerance constrained to canonical zero by the reconciliation profile, used for bounding the zero-tolerance comparison in settlement reconciliation.";
    rdfs:label "numeric tolerance";
    rdfs:range xsd:decimal.
fin-post-trade:obligationClosureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "The obligation closure probe digest is a digest of the exact obligation closure probe bytes and result, used for locking the contents and result of an obligation closure probe.";
    rdfs:label "obligation closure probe digest";
    rdfs:range xsd:string.
fin-post-trade:obligationClosureProbeRef a owl:DatatypeProperty;
    rdfs:comment "The obligation closure probe reference is an absolute IRI of the completed obligation-set closure probe, used for pointing to the probe that proves the obligation set is complete.";
    rdfs:label "obligation closure probe reference";
    rdfs:range xsd:anyURI.
fin-post-trade:obligationMoney a owl:ObjectProperty;
    rdfs:comment "The obligation Money benefit is a strictly positive Money benefit owed under a cash-dividend obligation, used for characterizing the cash amount an obligation is to transfer.";
    rdfs:label "obligation Money benefit";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:obligationQuantity a owl:ObjectProperty;
    rdfs:comment "The obligation quantity is a strictly positive affected-security Quantity that generates the due-bill benefit, used for characterizing the security quantity on which an obligation is based.";
    rdfs:label "obligation quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:obligationQuantityBenefit a owl:ObjectProperty;
    rdfs:comment "The obligation Quantity benefit is a strictly positive Quantity benefit owed under a split or rights obligation, used for characterizing the security quantity an obligation is to transfer.";
    rdfs:label "obligation Quantity benefit";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:officialArtifactDigest a owl:DatatypeProperty;
    rdfs:comment "The official artifact digest is a SHA-256 digest of the official percentage artifact, used for locking the contents of the official source artifact.";
    rdfs:label "official artifact digest";
    rdfs:range xsd:string.
fin-post-trade:officialArtifactRef a owl:DatatypeProperty;
    rdfs:comment "The official artifact reference is an absolute IRI of the authority artifact that supplies an official percentage, used for pointing to the official source artifact for the distribution ratio.";
    rdfs:label "official artifact reference";
    rdfs:range xsd:anyURI.
fin-post-trade:officialPercentageInput a owl:DatatypeProperty;
    rdfs:comment "The official percentage input is a branch marker that is true when the distribution percentage uses a locked authority-supplied value, used for flagging the official-source input.";
    rdfs:label "official percentage input";
    rdfs:range xsd:boolean.
fin-post-trade:optionAllocationRatio a owl:ObjectProperty;
    rdfs:comment "The option allocation ratio is the optional ratio of the elected quantity allocated to this option, used for characterizing partial allocations.";
    rdfs:label "option allocation ratio";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:optionAmendmentOfRef a owl:DatatypeProperty;
    rdfs:comment "The option amendment-of reference is an optional reference to the prior option version that this option amends or withdraws, used for tracing the option lifecycle.";
    rdfs:label "option amendment-of reference";
    rdfs:range xsd:anyURI.
fin-post-trade:optionConsiderationCash a owl:ObjectProperty;
    rdfs:comment "The option consideration cash is the optional cash-per-unit consideration offered by a corporate action option, used for characterizing a cash-consideration option.";
    rdfs:label "option consideration cash";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:optionConsiderationSplitRatio a owl:ObjectProperty;
    rdfs:comment "The option consideration split ratio is the optional split-ratio consideration offered by a corporate action option, used for characterizing a split-consideration option.";
    rdfs:label "option consideration split ratio";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:optionConsiderationSubscriptionPrice a owl:ObjectProperty;
    rdfs:comment "The option consideration subscription price is the optional subscription-price consideration offered by a corporate action option, used for characterizing a subscription-consideration option.";
    rdfs:label "option consideration subscription price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:optionElectionDeadline a owl:DatatypeProperty;
    rdfs:comment "The option election deadline is the optional date by which an election for this option must be submitted, used for characterizing the option's election window.";
    rdfs:label "option election deadline";
    rdfs:range xsd:date.
fin-post-trade:optionIsDefault a owl:DatatypeProperty;
    rdfs:comment "The option-is-default flag indicates whether this option is the default applied when no election is submitted, used for distinguishing the default option from voluntary options.";
    rdfs:label "option is default";
    rdfs:range xsd:boolean.
fin-post-trade:optionKind a owl:ObjectProperty;
    rdfs:comment "The option kind is a closed classification of a corporate action option as a default option, voluntary election, withdrawal, amendment, or partial allocation, used for characterizing the option lifecycle.";
    rdfs:label "option kind";
    rdfs:range fin-post-trade:CorporateActionOptionKind.
fin-post-trade:originalSettlementDate a owl:DatatypeProperty;
    rdfs:comment "The original settlement date is the settlement date originally instructed, before any amendment, used for distinguishing the original from the amended settlement date.";
    rdfs:label "original settlement date";
    rdfs:range xsd:date.
fin-post-trade:outputContractDigest a owl:DatatypeProperty;
    rdfs:comment "The output contract digest is a digest of a versioned executable output contract, used for locking the executable output agreement of a calculation.";
    rdfs:label "output contract digest";
    rdfs:range xsd:string.
fin-post-trade:paymentDate a owl:DatatypeProperty;
    rdfs:comment "The payment date is a market-calendar date on which a cash benefit is due, used for marking the day a cash dividend should be paid.";
    rdfs:label "payment date";
    rdfs:range xsd:date.
fin-post-trade:precedenceEdgeCount a owl:DatatypeProperty;
    rdfs:comment "The precedence edge count is the count of traversable typed precedence edges closed by the policy version, used for verifying the completeness of the precedence graph.";
    rdfs:label "precedence edge count";
    rdfs:range xsd:integer.
fin-post-trade:precedenceGraphDigest a owl:DatatypeProperty;
    rdfs:comment "The precedence graph digest is a digest of the explicit acyclic provider precedence graph, used for locking the precedence structure that arbitrates election conflicts.";
    rdfs:label "precedence graph digest";
    rdfs:range xsd:string.
fin-post-trade:processingFindingKind a owl:ObjectProperty;
    rdfs:comment "The processing finding kind is a member of the closed corporate-action processing failure classification, used for characterizing the specific category of a processing failure.";
    rdfs:label "processing finding kind";
    rdfs:range fin-post-trade:CorporateActionProcessingFindingKind.
fin-post-trade:profileScopeDigest a owl:DatatypeProperty;
    rdfs:comment "The profile-scope digest is a tagged digest locking the exact set of profile-scoped constraints and locked values under which an implementation profile is active, used for distinguishing the active profile from the generic core.";
    rdfs:label "profile-scope digest";
    rdfs:range xsd:string.
fin-post-trade:projectedMoney a owl:ObjectProperty;
    rdfs:comment "The projected Money is the canonical Money value of a settlement-account cash projection, used for characterizing the cash comparison value projected on the internal side.";
    rdfs:label "projected Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:projectedQuantity a owl:ObjectProperty;
    rdfs:comment "The projected Quantity is the canonical Quantity value of a security leg or economic allocation group, used for characterizing the security comparison value projected on the internal side.";
    rdfs:label "projected Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:projectionEconomicAllocationMode a owl:DatatypeProperty;
    rdfs:comment "The economic-allocation projection is a projection branch marker that is true when the projection is the sum of complete focal-account allocations, used for flagging that the projection takes the economic-allocation perspective.";
    rdfs:label "economic-allocation projection";
    rdfs:range xsd:boolean.
fin-post-trade:projectionSettlementAccountMode a owl:DatatypeProperty;
    rdfs:comment "The settlement-account projection is a projection branch marker that is true when the projection is one complete SettlementLeg value, used for flagging that the projection takes the settlement-account perspective.";
    rdfs:label "settlement-account projection";
    rdfs:range xsd:boolean.
fin-post-trade:providerEventId a owl:DatatypeProperty;
    rdfs:comment "The provider event identifier is a source-scoped immutable status event identifier, used for uniquely referring to one status event within its source scope.";
    rdfs:label "provider event identifier";
    rdfs:range xsd:string.
fin-post-trade:providerLegId a owl:DatatypeProperty;
    rdfs:comment "The provider leg identifier is an instruction-provider-scoped immutable leg identifier, used for uniquely referring to one settlement leg within its provider scope.";
    rdfs:label "provider leg identifier";
    rdfs:range xsd:string.
fin-post-trade:providerMemberVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "The provider-member version-set digest is a section-5.8 digest of the complete sorted exact provider-member fact version IRI set, used for locking the contents of the provider-member set.";
    rdfs:label "provider-member version-set digest";
    rdfs:range xsd:string.
fin-post-trade:providerNormalizationCount a owl:DatatypeProperty;
    rdfs:comment "The provider normalization count is the count of traversable raw-to-logical provider mappings closed by the policy version, used for verifying the completeness of the normalization mapping set.";
    rdfs:label "provider normalization count";
    rdfs:range xsd:integer.
fin-post-trade:providerNormalizationDigest a owl:DatatypeProperty;
    rdfs:comment "The provider normalization digest is a digest of the provider identifier and decision normalization mappings, used for locking the provider normalization rules.";
    rdfs:label "provider normalization digest";
    rdfs:range xsd:string.
fin-post-trade:qualificationResult a owl:ObjectProperty;
    rdfs:comment "The qualification result is a closed eligible or ineligible due-bill qualification result, used for giving the verdict of a due-bill trade qualification.";
    rdfs:label "qualification result";
    rdfs:range fin-post-trade:DueBillQualificationResult.
fin-post-trade:qualifiedDueBillQuantity a owl:ObjectProperty;
    rdfs:comment "The qualified due-bill quantity is a strictly positive allocated Quantity that qualifies inside the resolved interval, used for characterizing the due-bill quantity confirmed as qualifying.";
    rdfs:label "qualified due-bill quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:quantityDelta a owl:ObjectProperty;
    rdfs:comment "The quantity delta is the security Quantity change computed under the selected split or rights contract, used for characterizing the increase or decrease in holding quantity caused by an entitlement.";
    rdfs:label "quantity delta";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:quantityEffectiveDate a owl:DatatypeProperty;
    rdfs:comment "The quantity effective date is the resolved market-calendar date of the security component, used for marking the date the security part of an adjustment becomes effective.";
    rdfs:label "quantity effective date";
    rdfs:range xsd:date.
fin-post-trade:receivedAt a owl:DatatypeProperty;
    rdfs:comment "The received-at instant is an explicit instant at which the election provider received the decision, used for judging whether an election was received in time before its deadline.";
    rdfs:label "received at";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:reconciliationAsOfAvailable a owl:DatatypeProperty;
    rdfs:comment "The reconciliation availability-time pivot is an availability-time instant at which internal settlement facts are selected for reconciliation, used for fixing the availability-time point taken for reconciliation.";
    rdfs:label "reconciliation availability-time pivot";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:reconciliationAsOfKnowledge a owl:DatatypeProperty;
    rdfs:comment "The reconciliation knowledge-time pivot is a knowledge-time instant at which internal settlement facts are selected for reconciliation, used for fixing the knowledge-time point taken for reconciliation.";
    rdfs:label "reconciliation knowledge-time pivot";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:reconciliationAsOfValid a owl:DatatypeProperty;
    rdfs:comment "The reconciliation valid-time pivot is a valid-time instant at which internal settlement facts are selected for reconciliation, used for fixing the valid-time point taken for reconciliation.";
    rdfs:label "reconciliation valid-time pivot";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:reconciliationDate a owl:DatatypeProperty;
    rdfs:comment "The reconciliation date is a market-calendar business date selected by the case, used for marking the business day a reconciliation targets.";
    rdfs:label "reconciliation date";
    rdfs:range xsd:date.
fin-post-trade:reconciliationScope a owl:ObjectProperty;
    rdfs:comment "The reconciliation scope is a member of the closed classification that defines the account, date, and settlement-system boundary of a ReconciliationCase, used for characterizing the dimensional range a reconciliation case covers.";
    rdfs:label "reconciliation scope";
    rdfs:range fin-post-trade:ReconciliationScope.
fin-post-trade:reconciliationStatus a owl:ObjectProperty;
    rdfs:comment "The reconciliation status is a closed open, investigating, resolved, or closed-no-action workflow state, used for characterizing the lifecycle stage of a reconciliation case.";
    rdfs:label "reconciliation status";
    rdfs:range fin-post-trade:ReconciliationStatus.
fin-post-trade:recordDate a owl:DatatypeProperty;
    rdfs:comment "The record date is a market-calendar date at which the record position is evaluated, used for determining who is recognized as holder at the entitlement pivot.";
    rdfs:label "record date";
    rdfs:range xsd:date.
fin-post-trade:recordPositionEvidenceDigest a owl:DatatypeProperty;
    rdfs:comment "The record-position evidence digest is a tagged JCS digest of the exact snapshot or proven-zero evidence branch, used for locking the position evidence on which an entitlement relies.";
    rdfs:label "record-position evidence digest";
    rdfs:range xsd:string.
fin-post-trade:recordPositionQuantity a owl:ObjectProperty;
    rdfs:comment "The record-position quantity is the exact snapshot Quantity or canonical zero Quantity before due-bill adjustment, used for recording the original holding quantity on which entitlement computation is based.";
    rdfs:label "record-position quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:referenceNormalizationDigest a owl:DatatypeProperty;
    rdfs:comment "The reference normalization digest is a digest of the reviewed settlement-reference normalization mapping, used for locking the rules that normalize references during reconciliation.";
    rdfs:label "reference normalization digest";
    rdfs:range xsd:string.
fin-post-trade:remainingMoney a owl:ObjectProperty;
    rdfs:comment "The remaining Money is the Money amount still due after subtracting the fulfilled Money from the obligation Money, used for characterizing the cash an obligation has yet to fulfill.";
    rdfs:label "remaining Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:remainingQuantity a owl:ObjectProperty;
    rdfs:comment "The remaining Quantity is the obligation Quantity benefit minus the fulfilled Quantity, used for characterizing the security quantity an obligation has yet to fulfill.";
    rdfs:label "remaining Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:remedialAction a owl:DatatypeProperty;
    rdfs:comment "The remedial action is an optional description of the corrective action taken to resolve a reconciliation finding, used for evidencing the resolution.";
    rdfs:label "remedial action";
    rdfs:range xsd:string.
fin-post-trade:resolvedAnnouncementDate a owl:DatatypeProperty;
    rdfs:comment "The resolved announcement date is the announcement date selected by the winning schedule rule, used for recording the announcement date fixed by schedule resolution.";
    rdfs:label "resolved announcement date";
    rdfs:range xsd:date.
fin-post-trade:resolvedEffectiveDate a owl:DatatypeProperty;
    rdfs:comment "The resolved effective date is the optional effective date selected by the winning schedule rule, used for recording the effective date fixed by schedule resolution.";
    rdfs:label "resolved effective date";
    rdfs:range xsd:date.
fin-post-trade:resolvedElectionDeadline a owl:DatatypeProperty;
    rdfs:comment "The resolved election deadline is the optional election deadline selected by the winning schedule rule, used for recording the election deadline fixed by schedule resolution.";
    rdfs:label "resolved election deadline";
    rdfs:range xsd:date.
fin-post-trade:resolvedExDate a owl:DatatypeProperty;
    rdfs:comment "The resolved ex date is the ex date selected by the winning schedule rule, used for recording the ex date fixed by schedule resolution.";
    rdfs:label "resolved ex date";
    rdfs:range xsd:date.
fin-post-trade:resolvedPaymentDate a owl:DatatypeProperty;
    rdfs:comment "The resolved payment date is the optional payment date selected by the winning schedule rule, used for recording the payment date fixed by schedule resolution.";
    rdfs:label "resolved payment date";
    rdfs:range xsd:date.
fin-post-trade:resolvedRecordDate a owl:DatatypeProperty;
    rdfs:comment "The resolved record date is the record date selected by the winning schedule rule, used for recording the record date fixed by schedule resolution.";
    rdfs:label "resolved record date";
    rdfs:range xsd:date.
fin-post-trade:rightsCalculatedInput a owl:DatatypeProperty;
    rdfs:comment "The rights calculated input is a branch marker that is true when the distribution percentage is computed from a rights ratio and subscription price, used for flagging the rights-kind calculation input source.";
    rdfs:label "rights calculated input";
    rdfs:range xsd:boolean.
fin-post-trade:roundingPolicyDigest a owl:DatatypeProperty;
    rdfs:comment "The rounding policy digest is a digest of the exact precision and rounding policy, used for locking the precision and rounding rules applied to a calculation result.";
    rdfs:label "rounding policy digest";
    rdfs:range xsd:string.
fin-post-trade:runtimeDigest a owl:DatatypeProperty;
    rdfs:comment "The runtime digest is a SHA-256 digest of the locked execution runtime used to evaluate the calculation, used for locking the execution environment.";
    rdfs:label "runtime digest";
    rdfs:range xsd:string.
fin-post-trade:scopeConsistencyDigest a owl:DatatypeProperty;
    rdfs:comment "The scope consistency digest is a digest of the normalized equality proof for event and request scopes and pivots, used for locking the scope consistency of an evaluation input.";
    rdfs:label "scope consistency digest";
    rdfs:range xsd:string.
fin-post-trade:selectedDecline a owl:DatatypeProperty;
    rdfs:comment "The selected decline is a result branch marker that is true when a decline is selected, used for flagging that election resolution selected a decline.";
    rdfs:label "selected decline";
    rdfs:range xsd:boolean.
fin-post-trade:selectedExercise a owl:DatatypeProperty;
    rdfs:comment "The selected exercise is a result branch marker that is true when an exercise is selected, used for flagging that election resolution selected an exercise.";
    rdfs:label "selected exercise";
    rdfs:range xsd:boolean.
fin-post-trade:selfElection a owl:DatatypeProperty;
    rdfs:comment "The self election is a branch marker that is true when the electing Party equals the entitlement beneficiary Party, used for flagging an election made by the entitlement holder itself.";
    rdfs:label "self election";
    rdfs:range xsd:boolean.
fin-post-trade:settlementAccountMode a owl:DatatypeProperty;
    rdfs:comment "The settlement-account mode is a case branch marker that is true when the case projects directly from a settlement leg, used for flagging that the internal projection takes the settlement-account perspective.";
    rdfs:label "settlement-account mode";
    rdfs:range xsd:boolean.
fin-post-trade:settlementAssetKind a owl:ObjectProperty;
    rdfs:comment "The settlement asset kind is a closed cash or security comparison-key asset kind, used for characterizing whether a comparison key corresponds to cash or to a security.";
    rdfs:label "settlement asset kind";
    rdfs:range fin-post-trade:SettlementAssetKind.
fin-post-trade:settlementCalendarKind a owl:ObjectProperty;
    rdfs:comment "The settlement-calendar kind is a closed classification of a settlement calendar role as a trading calendar, a settlement-system calendar, or a payment-system calendar, used for distinguishing calendar types beyond the single TradingCalendar.";
    rdfs:label "settlement-calendar kind";
    rdfs:range fin-post-trade:SettlementCalendarKind.
fin-post-trade:settlementDate a owl:DatatypeProperty;
    rdfs:comment "The settlement date is a market-calendar settlement date under the exact TradingCalendar version, used for marking the market day a settlement should complete.";
    rdfs:label "settlement date";
    rdfs:range xsd:date.
fin-post-trade:settlementLegMoney a owl:ObjectProperty;
    rdfs:comment "The settlement-leg Money is a strictly positive Money amount transferred by a cash leg, used for characterizing the cash amount a cash leg moves.";
    rdfs:label "settlement-leg Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:settlementLegQuantity a owl:ObjectProperty;
    rdfs:comment "The settlement-leg Quantity is a strictly positive Quantity transferred by a security leg, used for characterizing the security quantity a security leg moves.";
    rdfs:label "settlement-leg Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:settlementLocation a owl:DatatypeProperty;
    rdfs:comment "The settlement location is a normalized settlement location identifier under the locked source contract, used for characterizing the location at which a settlement occurs.";
    rdfs:label "settlement location";
    rdfs:range xsd:string.
fin-post-trade:settlementLocationIdentifierRef a owl:DatatypeProperty;
    rdfs:comment "The settlement-location identifier reference is an optional authority-scoped identifier for the settlement location, complementing the source string settlementLocation, used for stable cross-source identity. The string form is retained as the source representation.";
    rdfs:label "settlement-location identifier reference";
    rdfs:range xsd:anyURI.
fin-post-trade:settlementMethod a owl:ObjectProperty;
    rdfs:comment "The settlement method is a closed delivery-versus-payment or free-of-payment method, used for characterizing whether a settlement settles as DVP or FOP.";
    rdfs:label "settlement method";
    rdfs:range fin-post-trade:SettlementMethod.
fin-post-trade:settlementStatus a owl:ObjectProperty;
    rdfs:comment "The settlement status is a closed instructed, matched, settled, cancelled, or failed state, used for characterizing the current stage of a settlement.";
    rdfs:label "settlement status";
    rdfs:range fin-post-trade:SettlementStatus.
fin-post-trade:settlementSystem a owl:DatatypeProperty;
    rdfs:comment "The settlement system is a normalized settlement system identifier under the locked source contract, used for characterizing which settlement system a settlement occurs in.";
    rdfs:label "settlement system";
    rdfs:range xsd:string.
fin-post-trade:settlementSystemIdentifierRef a owl:DatatypeProperty;
    rdfs:comment "The settlement-system identifier reference is an optional authority-scoped identifier for the settlement system, complementing the source string settlementSystem, used for stable cross-source identity. The string form is retained as the source representation.";
    rdfs:label "settlement-system identifier reference";
    rdfs:range xsd:anyURI.
fin-post-trade:sourceEventId a owl:DatatypeProperty;
    rdfs:comment "The source event identifier is an authority-scoped immutable corporate-action event identifier, used for uniquely referring to one corporate-action event within its source authority.";
    rdfs:label "source event identifier";
    rdfs:range xsd:string.
fin-post-trade:sourceOrderKey a owl:DatatypeProperty;
    rdfs:comment "The source order key is a normalized non-negative provider ordering key, used for ordering status events by their source sequence.";
    rdfs:label "source order key";
    rdfs:range xsd:integer.
fin-post-trade:sourceProviderKey a owl:DatatypeProperty;
    rdfs:comment "The source provider key is a non-empty authority-scoped raw provider identifier consumed by one normalization mapping, used for characterizing the original provider identifier before normalization.";
    rdfs:label "source provider key";
    rdfs:range xsd:string.
fin-post-trade:sourceRecordDigest a owl:DatatypeProperty;
    rdfs:comment "The source record digest is a digest of the exact provider record bytes, used for locking the contents of an election's original record.";
    rdfs:label "source record digest";
    rdfs:range xsd:string.
fin-post-trade:sourceRecordRef a owl:DatatypeProperty;
    rdfs:comment "The source record reference is an absolute IRI of the immutable provider election record, used for pointing to the original provider record of an election.";
    rdfs:label "source record reference";
    rdfs:range xsd:anyURI.
fin-post-trade:sourceSchemaDigest a owl:DatatypeProperty;
    rdfs:comment "The source schema digest is a digest of the exact provider statement schema, used for locking the structural convention of an external statement.";
    rdfs:label "source schema digest";
    rdfs:range xsd:string.
fin-post-trade:sourceSnapshotDigest a owl:DatatypeProperty;
    rdfs:comment "The source snapshot digest is a digest of the immutable external statement snapshot, used for locking the contents of an external statement snapshot.";
    rdfs:label "source snapshot digest";
    rdfs:range xsd:string.
fin-post-trade:sourceSnapshotRef a owl:DatatypeProperty;
    rdfs:comment "The source snapshot reference is an absolute IRI of immutable external statement source bytes, used for pointing to the original bytes of an external statement.";
    rdfs:label "source snapshot reference";
    rdfs:range xsd:anyURI.
fin-post-trade:splitCalculatedInput a owl:DatatypeProperty;
    rdfs:comment "The split calculated input is a branch marker that is true when the distribution percentage is computed from a split ratio, used for flagging the split-kind calculation input source.";
    rdfs:label "split calculated input";
    rdfs:range xsd:boolean.
fin-post-trade:splitRatio a owl:DatatypeProperty;
    rdfs:comment "The split ratio is a strictly positive dimensionless stock-split ratio, used for characterizing how many post-split shares result from each pre-split share.";
    rdfs:label "split ratio";
    rdfs:range xsd:decimal.
fin-post-trade:statementAsOfTime a owl:DatatypeProperty;
    rdfs:comment "The statement as-of time is the optional point in time at which an external settlement statement is asserted, used for characterizing the statement snapshot instant.";
    rdfs:label "statement as-of time";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:statementDate a owl:DatatypeProperty;
    rdfs:comment "The statement date is a business date to which the provider's immutable external statement snapshot applies, used for marking the date an external statement covers.";
    rdfs:label "statement date";
    rdfs:range xsd:date.
fin-post-trade:statementFocalAccount a owl:ObjectProperty;
    rdfs:comment "The statement focal account is a logical financial account covered by an external settlement statement, used for bounding the central account the statement addresses.";
    rdfs:domain fin-post-trade:ExternalSettlementStatement;
    rdfs:label "statement focal account";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/FinancialAccount/LogicalIdentity>.
fin-post-trade:statementLineMoney a owl:ObjectProperty;
    rdfs:comment "The statement-line Money is a strictly positive external cash statement value, used for characterizing the cash amount of an external statement line.";
    rdfs:label "statement-line Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:statementLineQuantity a owl:ObjectProperty;
    rdfs:comment "The statement-line Quantity is a strictly positive external security statement value, used for characterizing the security quantity of an external statement line.";
    rdfs:label "statement-line Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:statementProvider a owl:ObjectProperty;
    rdfs:comment "The statement provider is a provider Party version that issues an external settlement statement, used for pointing to the publishing source of an external statement.";
    rdfs:domain fin-post-trade:ExternalSettlementStatement;
    rdfs:label "statement provider";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
fin-post-trade:statementType a owl:ObjectProperty;
    rdfs:comment "The statement type is a closed classification of an external settlement statement as a holdings statement, a transactions statement, or a pending-settlement statement, used for characterizing the statement coverage beyond a single-day single-account flow.";
    rdfs:label "statement type";
    rdfs:range fin-post-trade:ExternalSettlementStatementType.
fin-post-trade:statusAtomicGroupId a owl:DatatypeProperty;
    rdfs:comment "The status atomic-group identifier is an atomic group subject used only by a group-level status event, used for binding a group-level status event to its atomic group.";
    rdfs:label "status atomic-group identifier";
    rdfs:range xsd:string.
fin-post-trade:subscriptionCash a owl:ObjectProperty;
    rdfs:comment "The subscription cash is an exact Money debit equal to the elected Quantity times the subscription price, used for characterizing the total cash payable for a rights exercise.";
    rdfs:label "subscription cash";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:subscriptionCashDueDate a owl:DatatypeProperty;
    rdfs:comment "The subscription cash due date is the resolved date for the rights subscription cash leg, used for marking the day the subscription cash is due.";
    rdfs:label "subscription cash due date";
    rdfs:range xsd:date.
fin-post-trade:subscriptionClosureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "The subscription closure probe digest is a digest of the exact subscription closure probe bytes and result, used for locking the contents and result of a subscription closure probe.";
    rdfs:label "subscription closure probe digest";
    rdfs:range xsd:string.
fin-post-trade:subscriptionClosureProbeRef a owl:DatatypeProperty;
    rdfs:comment "The subscription closure probe reference is an absolute IRI of the completed subscription-fulfillment closure probe, used for pointing to the probe that proves the subscription fulfillment set is complete.";
    rdfs:label "subscription closure probe reference";
    rdfs:range xsd:anyURI.
fin-post-trade:subscriptionFulfillmentAssetKind a owl:ObjectProperty;
    rdfs:comment "The subscription fulfillment asset kind is a closed cash-payment or security-delivery selector, used for characterizing which leg a subscription fulfillment belongs to.";
    rdfs:label "subscription fulfillment asset kind";
    rdfs:range fin-post-trade:SubscriptionFulfillmentAssetKind.
fin-post-trade:subscriptionFulfillmentCount a owl:DatatypeProperty;
    rdfs:comment "The subscription fulfillment count is the count of the complete exact current subscription fulfillment set, used for verifying the completeness of the subscription fulfillment set.";
    rdfs:label "subscription fulfillment count";
    rdfs:range xsd:integer.
fin-post-trade:subscriptionFulfillmentSetDigest a owl:DatatypeProperty;
    rdfs:comment "The subscription fulfillment-set digest is a section-5.8 digest of the sorted current fulfillment version set, used for locking the contents of the current subscription fulfillment set.";
    rdfs:label "subscription fulfillment-set digest";
    rdfs:range xsd:string.
fin-post-trade:subscriptionPrice a owl:ObjectProperty;
    rdfs:comment "The subscription price is a strictly positive Money amount due for each exercised successor-security unit, used for characterizing the amount payable per unit when exercising a rights issue.";
    rdfs:label "subscription price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:successorDeliveryDate a owl:DatatypeProperty;
    rdfs:comment "The successor delivery date is the resolved date for the rights successor-security delivery leg, used for marking the day the successor security is to be delivered.";
    rdfs:label "successor delivery date";
    rdfs:range xsd:date.
fin-post-trade:toDirectAccount a owl:DatatypeProperty;
    rdfs:comment "The to direct account is a branch marker that is true when the to economic account equals the security-leg to account, used for flagging that the to endpoint needs no custody bridge.";
    rdfs:label "to direct account";
    rdfs:range xsd:boolean.
fin-post-trade:transferClosureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "The transfer closure probe digest is a digest of the exact transfer-closure probe bytes and result, used for locking the contents and result of a transfer closure probe.";
    rdfs:label "transfer closure probe digest";
    rdfs:range xsd:string.
fin-post-trade:transferClosureProbeRef a owl:DatatypeProperty;
    rdfs:comment "The transfer closure probe reference is an absolute IRI of the completed current-transfer closure probe, used for pointing to the probe that proves the current transfer set is complete.";
    rdfs:label "transfer closure probe reference";
    rdfs:range xsd:anyURI.
fin-post-trade:transferCount a owl:DatatypeProperty;
    rdfs:comment "The transfer count is the count of the complete exact current transfer set, used for verifying the completeness of the current transfer set.";
    rdfs:label "transfer count";
    rdfs:range xsd:integer.
fin-post-trade:transferMoney a owl:ObjectProperty;
    rdfs:comment "The transfer Money is a Money asset recorded by one due-bill transfer, used for characterizing the cash amount moved by a transfer.";
    rdfs:label "transfer Money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-post-trade:transferQuantity a owl:ObjectProperty;
    rdfs:comment "The transfer Quantity is a Quantity asset recorded by one due-bill transfer, used for characterizing the security quantity moved by a transfer.";
    rdfs:label "transfer Quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-post-trade:transferState a owl:ObjectProperty;
    rdfs:comment "The transfer state is a closed pending, completed, failed, or cancelled transfer state, used for characterizing the current result of a transfer attempt.";
    rdfs:label "transfer state";
    rdfs:range fin-post-trade:DueBillTransferState.
fin-post-trade:transferTime a owl:DatatypeProperty;
    rdfs:comment "The transfer time is an explicit occurrence instant of the transfer record, used for marking when a due-bill transfer occurs.";
    rdfs:label "transfer time";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:transferVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "The transfer version-set digest is a section-5.8 digest of the complete sorted current transfer version IRI set, used for locking the contents of the current transfer set.";
    rdfs:label "transfer version-set digest";
    rdfs:range xsd:string.
fin-post-trade:upstreamCustodyBridgeRef a owl:DatatypeProperty;
    rdfs:comment "The upstream custody-bridge reference is an optional self-reference to the next upstream custody bridge in a global-custodian to sub-custodian to CSD chain, used for modeling multi-hop custody beyond a single bridge.";
    rdfs:label "upstream custody-bridge reference";
    rdfs:range xsd:anyURI.
fin-post-trade:valuationPivot a owl:DatatypeProperty;
    rdfs:comment "The valuation pivot is an explicit instant used by the reviewed price-selection function, used for fixing which point-in-time reference price is taken when computing the distribution percentage.";
    rdfs:label "valuation pivot";
    rdfs:range xsd:dateTimeStamp.
fin-post-trade:valueDate a owl:DatatypeProperty;
    rdfs:comment "The value date is the optional value date of an external statement entry, distinct from its book date, used for separating book and value timing.";
    rdfs:label "value date";
    rdfs:range xsd:date.
fin-post-trade:valueMismatchFinding a owl:DatatypeProperty;
    rdfs:comment "The value-mismatch finding is a branch marker that is true when the comparison is one-to-one but unequal, used for flagging that a key bucket has a value difference.";
    rdfs:label "value-mismatch finding";
    rdfs:range xsd:boolean.
fin-post-trade:waiverRef a owl:DatatypeProperty;
    rdfs:comment "The waiver reference is an optional reference to a documented waiver authorizing a reconciliation finding to be waived, used for evidencing a waived disposition.";
    rdfs:label "waiver reference";
    rdfs:range xsd:anyURI.
fin-post-trade:zeroPositionQuantity a owl:ObjectProperty;
    rdfs:comment "The zero position quantity is a canonical zero Quantity in the affected-security unit, used for explicitly expressing the absence of a holding in the zero-position branch.";
    rdfs:label "zero position quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
