fin-post-trade:SimpleDvpFopSettlementProfile a owl:Class;
    rdfs:comment "The simple DvP/FoP settlement profile is an optional implementation profile that locks a settlement instruction to exactly one security leg for free-of-payment or one reciprocal security and cash leg for delivery-versus-payment, with distinct deliverer and receiver Parties and consistent date/system/location and calendar across legs. It is the first concrete profile of the generic settlement core and is not a universal post-trade invariant; multi-leg, multi-currency, fee/tax-leg, PvP, DvD, and netted structures are admitted by the generic core under additional profiles.";
    rdfs:label "Simple DvP/FoP Settlement Profile";
    rdfs:subClassOf _:r_29c3b9c70233c7ddb6e687e7, _:r_5472ee8ec4f9ed03f9404ad1, _:r_80ff72acbc4d8b1e62b84a3f, _:r_92297a99316ebbc1e07e8052, _:r_9740a9da38c9145b5347b559, _:r_aa7d1c51eb463063caeb74cd, _:r_e05e23764b71a221d7b8721e, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/LogicalIdentity> a owl:Class;
