fin-post-trade:SettlementStatusEvent a owl:Class;
    rdfs:comment "The settlement status event is an immutable ordered provider status event for exactly one instruction atomic group or exact leg, carrying DVP atomic-completion evidence and a closed transition state, used for recording status progression across the settlement lifecycle.";
    rdfs:label "Settlement Status Event";
