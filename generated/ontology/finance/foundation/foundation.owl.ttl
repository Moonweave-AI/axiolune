fin-foundation:BusinessCalendar a owl:Class;
    rdfs:comment "Business Calendar, is a thin calendar interface that defines a sequence of business days for a jurisdiction, intended to be specialized by domain modules such as market-structure's TradingCalendar";
    rdfs:label "Business Calendar";
