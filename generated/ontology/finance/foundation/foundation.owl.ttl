fin-foundation:AuthorityRoleAssignment a owl:Class;
    rdfs:comment "Authority Role Assignment, is a temporal fact that assigns one organization a reviewed authority role under a given scheme release, with a validity interval and evidence, used for expressing real-world governance divisions such as registration authority, maintenance agency, and assigning authority";
    rdfs:label "Authority Role Assignment";
    rdfs:subClassOf _:r_1d9aea66d82cd86100377d92, _:r_99719138757c36a5a691aa7a, _:r_9e3ff24372cbd488e66ffa03, _:r_a7c69afdbe541fc16e02b943, _:r_b43e7d1974e7430ecc263f6d, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
