    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-foundation:Currency a owl:Class;
    rdfs:comment "Currency, is a financial foundation type that serves as a unit of valuation and settlement, defined per ISO 4217 by the relevant monetary authority, used for uniformly referencing canonical currencies in concepts such as monetary amounts and exchange rates";
    rdfs:label "Currency";
    rdfs:subClassOf _:r_038591910e04dd8882a36758, _:r_f175b805a0eb0b9de547faa7, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>, <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/Currency>.
