    rdfs:range xsd:string.
fin-foundation:iso4217PublicationListCategory a owl:ObjectProperty;
    rdfs:comment "ISO 4217 Publication List Category, is a reviewed list-category member that classifies an ISO 4217 publication as current currency & funds, fund codes, or historical, used for distinguishing which SIX-maintained list a publication belongs to";
    rdfs:label "ISO 4217 Publication List Category";
    rdfs:range fin-foundation:ISO4217ListCategory.
fin-foundation:iso4217PublicationSourceRef a owl:DatatypeProperty;
    rdfs:comment "ISO 4217 Publication Source Reference, is the absolute IRI of the locked publication artifact supporting a registry publication, used for providing a traceable credential for the publication";
    rdfs:label "ISO 4217 Publication Source Reference";
    rdfs:range xsd:anyURI.
fin-foundation:iso4217RegistryAuthority a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "ISO 4217 Registry Authority, is a direct logical reference from a registry entry to the identifier authority that owns the registry assertion, used for establishing the registry accountability of an entry";
    rdfs:domain fin-foundation:ISO4217RegistryEntry;
    rdfs:label "ISO 4217 Registry Authority";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/IdentifierAuthority/LogicalIdentity>.
fin-foundation:iso4217RegistrySourceRef a owl:DatatypeProperty;
    rdfs:comment "ISO 4217 Registry Source Reference, is the absolute IRI of the locked registry artifact and locator record supporting an entry version, used for providing a traceable credential for the entry";
    rdfs:label "ISO 4217 Registry Source Reference";
    rdfs:range xsd:anyURI.
fin-foundation:leiLexicalValue a owl:DatatypeProperty;
    rdfs:comment "LEI Lexical Value, is a canonical lexical value validated by the referenced LEI identifier type definition, used for carrying the canonical string of an LEI";
    rdfs:label "LEI Lexical Value";
    rdfs:range fin-foundation:LEI.
fin-foundation:localIdentifierLexicalValue a owl:DatatypeProperty;
    rdfs:comment "Local Identifier Lexical Value, is a non-empty canonical local identifier lexical value interpreted only together with its identifier scheme, used for carrying the string of a local identifier";
    rdfs:label "Local Identifier Lexical Value";
    rdfs:range fin-foundation:LocalIdentifier.
fin-foundation:micLexicalValue a owl:DatatypeProperty;
    rdfs:comment "MIC Lexical Value, is a canonical lexical value validated by the referenced MIC identifier type definition, used for carrying the canonical string of a MIC";
    rdfs:label "MIC Lexical Value";
    rdfs:range fin-foundation:MIC.
fin-foundation:registryEntryPublication a owl:ObjectProperty;
    rdfs:comment "Registry Entry Publication, is a relation linking an ISO 4217 registry entry to the publication snapshot it belongs to, used for distinguishing which list (current, fund, historical) an entry comes from";
    rdfs:domain fin-foundation:ISO4217RegistryEntry;
    rdfs:label "Registry Entry Publication";
    rdfs:range fin-foundation:ISO4217RegistryPublication.
fin-foundation:schemeHasRelease a owl:ObjectProperty;
    rdfs:comment "Scheme Has Release, is a relation linking a stable identifier scheme to one of its versioned releases, used for separating scheme identity from rule versioning";
    rdfs:domain fin-foundation:IdentifierScheme;
    rdfs:label "Scheme Has Release";
    rdfs:range fin-foundation:IdentifierSchemeRelease.
