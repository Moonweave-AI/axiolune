<https://axiolune.ai/ontology/finance/foundation> a owl:Ontology;
    rdfs:comment "Financial Foundation, is a domain module that defines shared vocabulary for identity, identifiers, currency, jurisdiction, and party, used for providing a common identity and classification basis across all finance domain modules";
    rdfs:label "Financial Foundation";
    owl:imports <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/foundation/2.0.0>.
fin-foundation:AccountType a owl:Class;
