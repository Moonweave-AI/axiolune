fin-risk:RiskLimitComparisonPolicyShape a sh:NodeShape;
    sh:description "A Risk Limit Comparison Policy, is the policy that governs how a bucketed or scalar measurement is compared against a bucketed or scalar limit — comparison operator, direction, per-bucket vs aggregate, key alignment, missing-bucket handling, tolerance, rounding, and unit/currency conversion — used so that bucket-set vs bucket-set comparison is well-defined rather than collapsing to a scalar value<=threshold rule.";
    sh:name "Risk Limit Comparison Policy";
    sh:property <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/attribute/335e69db0e6f21b0b5c878b2>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/attribute/3d5cec9451b65a15b929fe99>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/attribute/4d4b576a17bfd0a8113065d2>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/attribute/a2d9f0569f357d4509120c0b>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/attribute/e46d1c3d710acfe395446707>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/attribute/f8dc95bbe7e0cf0755f1797a>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/risk/RiskLimitComparisonPolicy/shape/temporal/f0f2f601393d100a35dc2429>;
