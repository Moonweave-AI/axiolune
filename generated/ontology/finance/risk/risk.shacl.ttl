fin-risk:RiskFactorShape a sh:NodeShape;
    sh:description "A Risk Factor, is an identifiable risk driver that a risk measure is sensitive to, used to state which factor universe moves a result independently of a single computed number. It is distinct from the strategy-research FactorDefinition (a research signal generator); a RiskFactor is a risk-management concept and references a research factor only optionally via riskFactorResearchRef.";
    sh:name "Risk Factor";
    sh:property <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/attribute/8cb413129d61c72013844ef1>, <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/attribute/94100ff1c4544097c139dc12>, <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/attribute/c50c5954db8b1b284ffba1bc>, <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/risk/RiskFactor/shape/temporal/f0f2f601393d100a35dc2429>;
