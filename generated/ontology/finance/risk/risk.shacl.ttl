fin-risk:RiskMeasurementShape a sh:NodeShape;
    sh:description "A Risk Measurement, is a point-in-time result for one exact risk-measure definition and at least one explicit portfolio, account, position, or RiskScopeSnapshot scope that carries exactly one Money, Quantity, or RiskBucketSet representation, used to record a computed risk number. A measurementStatus distinguishes preliminary, incomplete, revised, failed, estimated, and validated results, so non-audit-grade numbers are expressible; the strictly-prior input-context evidence (inputContextRef, inputContextRecordDigest, inputContextCompleted) is mandatory only when the ValidatedReproducibleRiskMeasurement profile is active. Optional roles link the result to its RiskMeasureSpecification, RiskInputSet, RiskCalculationContext, RiskScopeSnapshot, driving RiskFactor(s), and RiskExposure(s), so that \"what drove the result\" is queryable rather than hidden in a digest.";
    sh:name "Risk Measurement";
    sh:property <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/attribute/3f2e3386dcfa5537fa8c3364>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/attribute/74e9bc6b81cb0bf7f15845a2>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/attribute/f6783285a76142e816b183a2>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/attribute/f8cd91ec6e073f18c1cc883a>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/imported-attribute/7164a36a63b804569283e7fb>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/imported-attribute/9b634b38293544ecdb3cffe9>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/imported-attribute/b6736a3c6f6620b9123b5aef>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/participant-role-measurementAccount/f672c5cb67e911ea7a4ebd5b>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/participant-role-measurementBucketSet/9859402b7b5bbda895167b16>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/participant-role-measurementCalculationContext/4dfc97a28728fe8a25a266fb>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/participant-role-measurementDefinition/8605a5dfe88dd32e5c651f67>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/participant-role-measurementInputSet/f238e77e53f857cddb18162d>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/participant-role-measurementMarketDataStream/119f4b6a79f6e16d9b2b1828>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/participant-role-measurementPortfolio/2d0e7193a96ae0bf7ad0d018>, <https://axiolune.ai/ontology/finance/risk/RiskMeasurement/shape/participant-role-measurementPositi