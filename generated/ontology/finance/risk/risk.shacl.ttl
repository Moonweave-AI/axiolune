fin-risk:RiskScopeDefinitionShape a sh:NodeShape;
    sh:description "A Risk Scope Definition, is a policy or business scope (desk, strategy, legal entity, fund, counterparty, netting set, asset class, or combination) that a risk limit is anchored to, used to express scope as a stable governance object rather than as an ad-hoc per-measurement tuple. It is distinct from a RiskScopeSnapshot, which freezes the concrete members at an as-of.";
    sh:name "Risk Scope Definition";
    sh:property <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/attribute/03843dc3b593d99c012a55cc>, <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/attribute/947b1149f0f42bc08024ac31>, <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/attribute/a360fba06464c97be249031b>, <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/risk/RiskScopeDefinition/shape/temporal/f0f2f601393d100a35dc2429>;
