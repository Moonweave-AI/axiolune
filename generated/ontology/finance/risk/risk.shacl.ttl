fin-risk:ScenarioDefinitionShape a sh:NodeShape;
    sh:description "A Scenario Definition, is a versioned specification of a stress or what-if scenario that fixes its shock parameters independently of any stress-test run or resulting measurement, used to make a scenario reusable and reproducible across multiple runs. It carries typed ScenarioShock members (shock type, target, magnitude, unit, propagation), a scenario category, a baseline-state reference, and a narrative, so that the scenario states what it shocks and how — not only that it has a digest. The shockParameterDigest is the digest of the canonical shock-parameter payload; the sourceArtifactDigest is the digest of the original source document, linked by an explicit extraction/canonicalization relation rather than a vague \"matches\" claim.";
    sh:name "Scenario Definition";
    sh:property <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/attribute/04998ca7ae3fbf2150c2bb3f>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/attribute/0caeb17a5bd18e12f56d8343>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/attribute/33d2ab761101cc768632fbfc>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/attribute/88764d5625de7fcfcecaaae9>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/attribute/90ba377cf9b3e86b20719331>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/attribute/cbcd3074c4302edf8ae63e05>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/attribute/fc14e47a098ff25772e4f4c5>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/risk/ScenarioDefinition/shape/temporal/f0f2f601393d100a35dc2429>;
