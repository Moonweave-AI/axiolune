fin-risk:RiskMeasureSpecificationShape a sh:NodeShape;
    sh:description "A Risk Measure Specification, is the business semantics of a risk measure — its measure kind (VaR, ES, sensitivity, PFE, liquidity gap, concentration, probability, ratio, capital requirement, other), model purpose, loss convention, aggregation method, risk-factor universe, and valuation method — used to anchor limits to a stable business concept so that a code upgrade does not implicitly force every business limit to be re-approved. It is distinct from CalculationProfile (the method/parameters) and ImplementationVersion (the executable + digest).";
    sh:name "Risk Measure Specification";
    sh:property <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/attribute/351773b0038d49247857339c>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/attribute/6e8f0e1007155ad195034820>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/attribute/71c16a605e2d86aa7c29b85a>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/attribute/9bd8a98b001c24d6725242b2>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/attribute/a77ede043ab0f25860241631>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/attribute/b2b8b139af9f037a0da7f36e>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/attribute/b9ca0df8289ba7ab51e765a7>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/attribute/c985a33436268819b1b42421>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/risk/RiskMeasureSpecification/shape/temporal/f0f2f601393d100a35dc2429>;
