fin-risk:RiskLimitRuleShape a sh:NodeShape;
    sh:description "A Risk Limit Rule, is the governed rule a risk limit enforces — an optional lower and/or upper threshold, a comparison operator and basis, a tolerance and rounding policy, a warning/soft/hard severity, and a lifecycle (effective/suspended/superseded) — used so that a limit is not hardcoded to a single upper bound and can express lower bounds, bands, absolute-value limits, two-sided sensitivities, utilization, concentration ratios, and temporary waivers. The single-value<=threshold comparison remains the first concrete profile.";
    sh:name "Risk Limit Rule";
    sh:property <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/attribute/0c4138b10baef9de628c1a8f>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/attribute/10486ad352e583a28b4fc79e>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/attribute/1ca9b9e134ed855e4f0020fe>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/attribute/3104f54d49c1d430e9828070>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/attribute/52acdcb3f7e5316a5b1179e7>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/attribute/5598a16ddc7a42d57db3568a>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/attribute/a0770207a1197caf82030723>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/attribute/ba2318185f5bd88ae93e19be>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/attribute/cb0545cff4b14fc450318a6a>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/risk/RiskLimitRule/shape/temporal/f0f2f601393d100a35dc2429>;
    sh:sparql _:temporal_valid_interval_8a80678e74da4081742315aa;
    sh:targetClass fin-risk:RiskLimitRule.
fin-risk:RiskLimitShape a sh:NodeShape;
    sh:description "A Risk Limit, is an approved temporal and provenanced threshold fact that binds one exact RiskMeasureDefinition version, at least one explicit scope (a RiskScopeDefinition and/or legacy Portfolio/Account/Position), an owner, exactly one Money, Quantity, or bucket-set representation, and an optional RiskLimitRule and RiskLimitComparisonPolicy, used to set a governed risk threshold that subsequent measurements are evaluated against. The single-value upper threshold remains the first concrete profile; a RiskLimitRule generalizes to lower/upper bounds, bands, absolute-value, two-sided, utilization, and concentration limits. A lifecycle (effective/suspended/superseded) separates approval from effectiveness, and approvedBy is modeled as a typed Party role consistent with limitOwner rather than a bare uri.";
    sh:name "Risk Limit";
    sh:property <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/attribute/087257eb7f1ca26adeddb347>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/attribute/28d781608d0114978aefe982>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/attribute/69b0a99cfdf29ab9d8d226f0>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/attribute/8599c86db71e17434fa68319>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/attribute/bb8946b35a7ec08033ecea8d>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/attribute/bd84f76d753f53894b0182e0>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/attribute/d08c1741f18035b12a97fca3>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/attribute/dd48adcede278d739894717d>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/attribute/ebacffb58cffe71227920ce9>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/attribute/feee112c68b8d789b152fd53>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/participant-role-approver/da88de5de246acb50772caaf>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/participant-role-limitAccount/ea753f034fc064240232cddc>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/participant-role-limitAppetite/6c11a284d67f9ba5cfc42300>, <https://axiolune.ai/ontology/finance/risk/RiskLimit/shape/participant-role-limitBucketSet/282b2921a8aedff3e589d6e4>, <https://axiolune.ai/ontology/finance/