fin-risk:RiskCategoryShape a sh:NodeShape;
    sh:description "A Risk Category, is a classification of the kind of risk being managed, used to distinguish market, credit, liquidity, operational, concentration, model, and other extensible risk families so that measures, limits, exposures, and scenarios can be categorized rather than treated as undifferentiated risk. Full regulatory frameworks per category are explicitly out of scope; the category is a typed tag, not a rule set.";
    sh:name "Risk Category";
    sh:property <https://axiolune.ai/ontology/finance/risk/RiskCategory/shape/attribute/c985d99340c67cb8b4a8f1e5>, <https://axiolune.ai/ontology/finance/risk/RiskCategory/shape/attribute/e218a715c8042d1a4b4eb571>, <https://axiolune.ai/ontology/finance/risk/RiskCategory/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/RiskCategory/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/RiskCategory/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/risk/RiskCategory/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/risk/RiskCategory/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/risk/RiskCategory/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/risk/RiskCategory/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/risk/RiskCategory/shape/temporal/f0f2f601393d100a35dc2429>;
