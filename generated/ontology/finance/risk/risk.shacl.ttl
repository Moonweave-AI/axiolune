fin-risk:ImplementationVersionShape a sh:NodeShape;
    sh:description "An Implementation Version, is a versioned executable implementation of a calculation method together with its content digest, used to fix the true identity of the algorithm implementation by content fingerprint to support point-in-time reproducibility independently of a version label. This separates the executable from the methodology (RiskMeasureSpecification) and the method profile (CalculationProfile).";
    sh:name "Implementation Version";
    sh:property <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/attribute/1f851c867f69578d37df446c>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/attribute/6b875553f3fd22f126ba0437>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/attribute/864fb57485427d52c3a492aa>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/attribute/b402e9d48f4ee36816d9e75b>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/risk/ImplementationVersion/shape/temporal/f0f2f601393d100a35dc2429>;
