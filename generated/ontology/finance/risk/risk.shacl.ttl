fin-risk:RiskExposureShape a sh:NodeShape;
    sh:description "A Risk Exposure, is the risk an institution bears at a scope to a risk factor or category with a magnitude kind, used to state \"what risk is borne, driven by what, at which scope\" independently of a single computed number, so that exposure is a first-class concept rather than an implicit by-product of a measurement.";
    sh:name "Risk Exposure";
    sh:property <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/attribute/6b88ea84fe2cfadaa81bc685>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/attribute/d180c63cb9b1a877313ef2cb>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/participant-role-exposureCategory/25101f8b7cb861c74172554c>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/participant-role-exposureFactor/be83a64f3e95ed12a950ff82>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/participant-role-exposureScope/c2b367dc3e56ab003032887e>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/risk/RiskExposure/shape/temporal/f0f2f601393d100a35dc2429>;
