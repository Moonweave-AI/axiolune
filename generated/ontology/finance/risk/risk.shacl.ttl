fin-risk:StressTestRunShape a sh:NodeShape;
    sh:description "A Stress Test Run, is a completed stress test that applies one exact ScenarioDefinition version to a portfolio scope and records the output RiskMeasurement version produced by the run, used to bind the scenario, the shocked holdings, and the output result in a replayable way. It carries a run authority in its logical key, an exact RiskScopeSnapshot or RiskInputSet whose members were shocked, an optional baseline measurement, one or more stressed measurements, and a ScenarioApplicationEvidence role proving the output's input context was actually shocked by the scenario. The run's contract requires the output's generating context to equal the run's, the output's scope to match the stress scope, and the measure definition's scenarioRef to equal the run's exact ScenarioDefinition.";
    sh:name "Stress Test Run";
    sh:property <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/attribute/26ed724be552fae0277141cb>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/attribute/34f4fbccf014d2ab97917552>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/imported-attribute/9b634b38293544ecdb3cffe9>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/participant-role-stressRunApplicationEvidence/b257397adab1f969ee1d9f56>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/participant-role-stressRunBaseline/25b0fa24b0e9d22b1c3e4318>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/participant-role-stressRunInputSet/9e3750a8d89e2a94dcda45a4>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/participant-role-stressRunOutput/6ad0207cbdadc998db5a0d56>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/participant-role-stressRunPortfolio/67db2c7d1a443ffa589e47d5>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/participant-role-stressRunScenario/717a94fbbceabc632e348677>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/participant-role-stressRunScopeSnapshot/7c6ebdf14d20a5824e5ec249>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/risk/StressTestRun/shape/temporal/f0f2f601393d100a35dc2429>;
