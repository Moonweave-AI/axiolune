    rdfs:label "Instrument Classification Assertion logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentClassificationAssertion/role/classificationScheme> a owl:ObjectProperty;
    rdfs:comment "logical IdentifierScheme identity governing the classification";
    rdfs:domain fin-instruments:InstrumentClassificationAssertion;
    rdfs:label "classification scheme";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/IdentifierScheme>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentClassificationAssertion/role/classifiedInstrument> a owl:ObjectProperty;
    rdfs:comment "exact FinancialInstrument version being classified";
    rdfs:domain fin-instruments:InstrumentClassificationAssertion;
    rdfs:label "classified instrument";
    rdfs:range fin-instruments:FinancialInstrument.
fin-instruments:InstrumentIssuance a owl:Class;
    rdfs:comment "Instrument Issuance, is a temporal issuance fact that links one exact Security version to its exact issuer LegalEntity version and optionally to its exact originating SecurityOffering version, used to record the issuance relationship by which a security is brought into existence.";
    rdfs:label "Instrument Issuance";
    rdfs:subClassOf _:r_03c0d274ca019e91806a43fa, _:r_8837e22b05f98a9be722a804, _:r_9d97fd7b475bec13e8c6d06f, _:r_a10eeb07b88721a48ffc5b12, _:r_a830618fdb0f347eb3454737, _:r_bcbe743f90aabeeeccafba84, _:r_c46c0fd5338d71d9e22ca001, _:r_d5a98d4e83a5153b2870af54, _:r_d93d92652d4b77d6a12a9cb4, _:r_f6a504ea4bc6ad20c6871527, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentIssuance/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Instrument Issuance versions.";
    rdfs:label "Instrument Issuance logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentIssuance/role/issuedSecurity> a owl:ObjectProperty;
    rdfs:comment "exact Security version brought into existence by this issuance";
    rdfs:domain fin-instruments:InstrumentIssuance;
    rdfs:label "Issued Security";
    rdfs:range fin-instruments:Security.
<https://axiolune.ai/ontology/finance/instruments/InstrumentIssuance/role/issuer> a owl:ObjectProperty;
    rdfs:comment "exact LegalEntity version acting as issuer in this issuance fact";
    rdfs:domain fin-instruments:InstrumentIssuance;
    rdfs:label "Issuer";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/LegalEntity>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentIssuance/role/originatingOffering> a owl:ObjectProperty;
    rdfs:comment "optional exact SecurityOffering version from which this issuance originates";
    rdfs:domain fin-instruments:InstrumentIssuance;
    rdfs:label "Originating Offering";
    rdfs:range fin-instruments:SecurityOffering.
fin-instruments:InstrumentListing a owl:Class;
    rdfs:comment "Instrument Listing, is a nameable versioned object recording the listing of a financial instrument on a specific trading facility, used to record which instrument is listed on which venue, under which venue-listing identifier scheme and value.";
    rdfs:label "Instrument Listing";
    rdfs:subClassOf _:r_072ccda83c6ca3a6d90bf418, _:r_1ee3904d0d1ef85096229a19, _:r_215b71e1b22dc50c9911eb7e, _:r_2a565e5e305cc81cda96a94c, _:r_419adc17f2f74ba1b58638c9, _:r_8202a702d09abb87ef6b150f, _:r_83a596a6b0dc662c1265fcb5, _:r_85dd654ffc83ec87b8654ec9, _:r_87c3613a0e22c99a5618b61a, _:r_89f07102bbeb3a845764605f, _:r_8f5598d427e9daf2ccecb2d2, _:r_9d7d9e1c13101dbdd4fa8b5c, _:r_abb03216bf1e5b4bb8be33d4, _:r_ce18b914e63301a1c7c90de7, _:r_ceb36999bc4c9e440ac773e5, <https://axiolune.ai/ontology/finance/foundation/IdentifiableSubject>, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentListing/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Instrument Listing versions.";
    rdfs:label "Instrument Listing logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-instruments:QuotationConvention a owl:Class;
    rdfs:comment "Quotation Convention, is an abstract quotation expression profile that governs how a price is quoted for a financial instrument, intended as the common parent of all quotation profiles so that future types such as yield, par, and notional-scaled quotations can be added without breaking downstream references";
    rdfs:label "Quotation Convention";
    rdfs:subClassOf _:r_9411b6195ff733ef45b6fcfa, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
fin-instruments:QuotationKind a owl:Class;
    rdfs:comment "Quotation Kind, is a closed controlled vocabulary admitting only direct unit price, used to provide a classification scheme of quotation methods for direct unit-price quotation contracts.";
    rdfs:label "Quotation Kind";
    owl:oneOf _:l_673408412bbbd88cf770e9fd_0.
<https://axiolune.ai/ontology/finance/instruments/QuotationKind/scheme> a skos:ConceptScheme;
    skos:prefLabel "Quotation Kind";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/instruments/QuotationKind/value/directUnitPrice> a owl:NamedIndividual, skos:Concept, fin-instruments:QuotationKind;
    rdfs:comment "quotation kind expressing one quote-currency amount per one denominator Quantity unit";
    skos:inScheme <https://axiolune.ai/ontology/finance/instruments/QuotationKind/scheme>;
    skos:notation "directUnitPrice";
    skos:prefLabel "Direct Unit Price";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-instruments:Security a owl:Class;
    rdfs:comment "Security, is a subclass of Financial Instrument that can be quoted and issued as a security, used to identify financial instruments admitted to the issuance and listing workflow and treated as securities.";
    rdfs:label "Security";
    rdfs:subClassOf _:r_7db5b79358220d1112a43a54, _:r_e3cb577c732131c3be963c66, fin-instruments:FinancialInstrument, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/instruments/Security/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Security versions.";
    rdfs:label "Security logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-instruments:SecurityOffering a owl:Class;
    rdfs:comment "Security Offering, is a temporal offering record class directed at one exact Security version, used to record the fact of an issuance offering, and kept distinct from formal issuance and venue listing.";
    rdfs:label "Security Offering";
    rdfs:subClassOf _:r_309ae84d9bf74a4de0a411bc, _:r_4d695794231e1dfc9d8d3849, _:r_5895a5d35115191c3c0dda79, _:r_940b1d0a5b4e8dae17477ebb, _:r_95ba6238724f9903802b795d, _:r_bd409db06da260f8de1e80e0, _:r_c238523c1ec2eadd2f35787a, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/instruments/SecurityOffering/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Security Offering versions.";
    rdfs:label "Security Offering logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-instruments:classificationCategory a owl:ObjectProperty;
    rdfs:comment "Classification Category, is a reviewed asset-level category member required on an instrument classification assertion, used for characterizing the top-level asset class of the classified instrument";
    rdfs:label "Classification Category";
    rdfs:range fin-instruments:CFICategory.
fin-instruments:classificationCode a owl:DatatypeProperty;
    rdfs:comment "Classification Code, is a non-empty code string assigned under a classification scheme (e.g., a 6-character CFI code per ISO 10962), used for carrying the classification value of an instrument";
    rdfs:label "Classification Code";
    rdfs:range xsd:string.
fin-instruments:classificationEffectiveFrom a owl:DatatypeProperty;
    rdfs:comment "Classification Effective From, is the inclusive date from which an instrument classification assertion comes into force, used to mark the start of the classification's valid interval";
    rdfs:label "Classification Effective From";
    rdfs:range xsd:date.
fin-instruments:classificationEffectiveTo a owl:DatatypeProperty;
    rdfs:comment "Classification Effective To, is the optional exclusive date at which an instrument classification assertion ceases to be in force, used to mark the end of the classification's valid interval";
    rdfs:label "Classification Effective To";
    rdfs:range xsd:date.
fin-instruments:contractMultiplier a owl:DatatypeProperty;
    rdfs:comment "Contract Multiplier, is a dimensionless multiplier constrained to decimal one by the direct-unit quotation profile, used to ensure scale consistency of unit-price quotations.";
    rdfs:label "Contract Multiplier";
    rdfs:range xsd:decimal.
fin-instruments:isAdmittedToTradingOn a owl:ObjectProperty;
    rdfs:comment "Is Admitted To Trading On, is a derived convenience relation from a FinancialInstrument to a TradingFacility, holding when the instrument has at least one point-in-time-eligible active listing at the given as-of time, used for indicating admission to trading rather than actual tradeability";
    rdfs:domain fin-instruments:FinancialInstrument;
    rdfs:label "Is Admitted To Trading On";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingFacility>.
fin-instruments:isTradedOn a owl:ObjectProperty;
    rdfs:comment "Is Traded On, is a derived convenience relation from a FinancialInstrument to a TradingFacility, used to derive where the instrument can be traded based on point-in-time-eligible active listings, and is never stored as an independent truth.";
    rdfs:domain fin-instruments:FinancialInstrument;
    rdfs:label "Is Traded On";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingFacility>.
fin-instruments:issuanceId a owl:DatatypeProperty;
    rdfs:comment "Issuance Identifier, is a non-empty source-scoped identifier for one logical InstrumentIssuance, used to uniquely denote a single instrument issuance within source data.";
    rdfs:label "Issuance Identifier";
    rdfs:range xsd:string.
fin-instruments:listedInstrument a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Listed Instrument, is a relation that links an InstrumentListing version to the exact FinancialInstrument version admitted by that listing, used to specify which financial instrument the listing admits.";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Listed Instrument";
    rdfs:range fin-instruments:FinancialInstrument.
fin-instruments:listingBusinessFrom a owl:DatatypeProperty;
    rdfs:comment "Listing Business From, is the inclusive business date from which an InstrumentListing comes into force, used to mark the business day on which a listing enters its valid state.";
    rdfs:label "Listing Business From";
    rdfs:range xsd:date.
fin-instruments:listingBusinessTo a owl:DatatypeProperty;
    rdfs:comment "Listing Business To, is the optional exclusive business date at which an InstrumentListing ceases to be in force, used to mark the business day on which a listing leaves its valid state.";
    rdfs:label "Listing Business To";
    rdfs:range xsd:date.
fin-instruments:listingFacility a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Listing Facility, is a relation that links an InstrumentListing version to the exact TradingFacility version at which it is listed, used to record the trading facility to which the listing belongs.";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Listing Facility";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingFacility>.
fin-instruments:listingIdentifierScheme a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Listing Identifier Scheme, is a direct identity slot relating an InstrumentListing to exactly one venue-listing IdentifierScheme logical identity, used to determine which identifier scheme the listing adopts.";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Listing Identifier Scheme";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/IdentifierScheme/LogicalIdentity>.
fin-instruments:listingIdentifierValue a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Listing Identifier Value, is a direct identity slot relating an InstrumentListing to exactly one LocalIdentifierValue logical identity governed by its listing scheme, used to determine the specific value the listing carries under that scheme.";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Listing Identifier Value";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/LocalIdentifierValue/LogicalIdentity>.
fin-instruments:listingQuoteCurrency a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Listing Quote Currency, is the sole stored relation from an InstrumentListing version to the Currency logical identity in which that listing is quoted, used to record the currency in which the listing is priced.";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Listing Quote Currency";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Currency/LogicalIdentity>.
fin-instruments:normalizationContractDigest a owl:DatatypeProperty;
    rdfs:comment "Normalization Contract Digest, is a lowercase SHA-256 digest authenticating the exact bytes of the quotation normalization contract, used to verify the integrity of the referenced normalization contract.";
    rdfs:label "Normalization Contract Digest";
    rdfs:range xsd:string.
fin-instruments:normalizationContractRef a owl:DatatypeProperty;
    rdfs:comment "Normalization Contract Reference, is the absolute IRI of the immutable normalization contract used to materialize quotation semantics, used to anchor the normalization definition on which the quotation rests.";
    rdfs:label "Normalization Contract Reference";
    rdfs:range xsd:anyURI.
fin-instruments:offeredSecurity a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Offered Security, is a relation that links a SecurityOffering version to the exact Security version it offers, used to specify which Security version the offering is directed at.";
    rdfs:domain fin-instruments:SecurityOffering;
    rdfs:label "Offered Security";
    rdfs:range fin-instruments:Security.
fin-instruments:offeringId a owl:DatatypeProperty;
    rdfs:comment "Offering Identifier, is a non-empty source-scoped identifier for one logical SecurityOffering, used to uniquely denote a single security offering within source data.";
    rdfs:label "Offering Identifier";
    rdfs:range xsd:string.
fin-instruments:originatingOffering a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Originating Offering, is a relation that links an InstrumentListing version to its optional exact originating SecurityOffering version, used to trace which offering the listing originates from.";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Originating Offering";
    rdfs:range fin-instruments:SecurityOffering.
fin-instruments:quotationDenominatorUnit a owl:DatatypeProperty;
    rdfs:comment "Quotation Denominator Unit, is a controlled unit IRI denoting the single Quantity unit against which the direct price is quoted, used to determine the unit of measurement in which the price is expressed.";
    rdfs:label "Quotation Denominator Unit";
    rdfs:range xsd:anyURI.
fin-instruments:quotationInstrument a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Quotation Instrument, is a relation that links a DirectUnitPriceQuotationContract to its FinancialInstrument logical identity, used to specify which financial instrument the quotation is directed at.";
    rdfs:domain fin-instruments:DirectUnitPriceQuotationContract;
    rdfs:label "Quotation Instrument";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument/LogicalIdentity>.
fin-instruments:quotationKind a owl:ObjectProperty;
    rdfs:comment "Quotation Kind, is a closed-set quotation application classification value required on a direct unit-price contract, used to constrain the quotation method of that contract.";
    rdfs:label "Quotation Kind";
    rdfs:range fin-instruments:QuotationKind.
fin-instruments:quotationListingContext a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Quotation Listing Context, is a relation that links a quotation contract to its optional exact InstrumentListing context version, used to situate the quotation within a specific listing scene.";
    rdfs:domain fin-instruments:DirectUnitPriceQuotationContract;
    rdfs:label "Quotation Listing Context";
    rdfs:range fin-instruments:InstrumentListing.
fin-instruments:quotationOTCContext a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Quotation OTC Context, is a relation that links a quotation contract to its optional exact OTCTradingContext version, used to situate the quotation within a specific over-the-counter scene.";
    rdfs:domain fin-instruments:DirectUnitPriceQuotationContract;
    rdfs:label "Quotation OTC Context";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext>.
fin-instruments:quotationQuoteCurrency a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Quotation Quote Currency, is a relation that links a quotation contract to its exact quote Currency logical identity, used to record the currency in which the quotation is priced.";
    rdfs:domain fin-instruments:DirectUnitPriceQuotationContract;
    rdfs:label "Quotation Quote Currency";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Currency/LogicalIdentity>.
