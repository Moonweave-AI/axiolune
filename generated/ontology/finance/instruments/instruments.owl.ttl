fin-instruments:EquitySecurity a owl:Class;
    rdfs:comment "Equity Security, is a kind of Security that represents an ownership interest in an issuing entity or a pool of assets, used to identify tradable equity financial instruments in the market.";
    rdfs:label "Equity Security";
