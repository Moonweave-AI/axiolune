<https://axiolune.ai/ontology/finance/instruments> a owl:Ontology;
    rdfs:comment "instrument vocabulary for financial instruments, security offerings, issuance facts, independently referenceable listings, and the direct unit-price quotation contract admitted by the v0.3 equity slice";
    rdfs:label "Financial Instruments";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/market-structure>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/instruments/1.0.0>.
fin-instruments:DirectUnitPriceQuotationContract a owl:Class;
    rdfs:comment "versioned quotation application in which one instrument unit is priced directly as an amount of one quote currency for one controlled denominator Quantity-unit IRI in exactly one listing or OTC context";
    rdfs:label "Direct Unit Price Quotation Contract";
    rdfs:subClassOf _:r_08859595ec0ec7ea8bf1ae70, _:r_0efe7e0d3415667dcf693a75, _:r_21dab475a7da09907212bad4, _:r_23722e009ba7f6ea4f522ff3, _:r_2a54b341f00741a555246ecf, _:r_52a2c03e4199454db567d8cb, _:r_61cebb76a329a2b4f7697688, _:r_92214004d420c98d91fe1ad8, _:r_ab0231bab3f2e54fa947f4ec, _:r_ac7c1bf23b490cdabc9bba35, _:r_c2542ad52bc4d68e236ee239, _:r_c392999e3492da4a4503a033, _:r_c41ee2dca16e27578f2db872, _:r_d5d108222998218a3f70509e, _:r_ef4bfc790e673cb52900edea, _:r_f0325803981bded8c9ebb28c, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/instruments/DirectUnitPriceQuotationContract/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Direct Unit Price Quotation Contract versions.";
    rdfs:label "Direct Unit Price Quotation Contract logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-instruments:EquitySecurity a owl:Class;
    rdfs:comment "Security that represents an ownership interest in an entity or pool of assets";
    rdfs:label "Equity Security";
    rdfs:subClassOf _:r_8de2c0b5025a8139666361ca, _:r_d7437faabba669200609b485, fin-instruments:Security, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/instruments/EquitySecurity/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Equity Security versions.";
    rdfs:label "Equity Security logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-instruments:FinancialInstrument a owl:Class;
    rdfs:comment "identifiable financial contract that may be issued, offered, listed, observed, traded, or valued without conflating its identity with any particular listing";
    rdfs:label "Financial Instrument";
    rdfs:subClassOf _:r_8dff3197bee9cfb6970fe42a, _:r_b94c416bcb625bcbbf4375fc, <https://axiolune.ai/ontology/finance/foundation/IdentifiableSubject>, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/instruments/FinancialInstrument/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Financial Instrument versions.";
    rdfs:label "Financial Instrument logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-instruments:InstrumentIssuance a owl:Class;
    rdfs:comment "temporal issuance fact that links one exact Security version to its exact issuer LegalEntity version and optionally to its exact originating SecurityOffering version";
    rdfs:label "Instrument Issuance";
    rdfs:subClassOf _:r_03c0d274ca019e91806a43fa, _:r_8837e22b05f98a9be722a804, _:r_9d97fd7b475bec13e8c6d06f, _:r_a10eeb07b88721a48ffc5b12, _:r_a830618fdb0f347eb3454737, _:r_bcbe743f90aabeeeccafba84, _:r_c46c0fd5338d71d9e22ca001, _:r_d5a98d4e83a5153b2870af54, _:r_d93d92652d4b77d6a12a9cb4, _:r_f6a504ea4bc6ad20c6871527, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentIssuance/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Instrument Issuance versions.";
    rdfs:label "Instrument Issuance logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentIssuance/role/issuedSecurity> a owl:ObjectProperty;
    rdfs:comment "exact Security version brought into existence by this issuance";
    rdfs:domain fin-instruments:InstrumentIssuance;
    rdfs:label "Issued Security";
    rdfs:range fin-instruments:Security.
<https://axiolune.ai/ontology/finance/instruments/InstrumentIssuance/role/issuer> a owl:ObjectProperty;
    rdfs:comment "exact LegalEntity version acting as issuer in this issuance fact";
    rdfs:domain fin-instruments:InstrumentIssuance;
    rdfs:label "Issuer";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/LegalEntity>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentIssuance/role/originatingOffering> a owl:ObjectProperty;
    rdfs:comment "optional exact SecurityOffering version from which this issuance originates";
    rdfs:domain fin-instruments:InstrumentIssuance;
    rdfs:label "Originating Offering";
    rdfs:range fin-instruments:SecurityOffering.
fin-instruments:InstrumentListing a owl:Class;
    rdfs:comment "independently referenceable versioned listing whose logical identity is exactly the listing facility, venue-listing identifier scheme, and venue-listing identifier value logical identities";
    rdfs:label "Instrument Listing";
    rdfs:subClassOf _:r_072ccda83c6ca3a6d90bf418, _:r_1ee3904d0d1ef85096229a19, _:r_215b71e1b22dc50c9911eb7e, _:r_2a565e5e305cc81cda96a94c, _:r_419adc17f2f74ba1b58638c9, _:r_8202a702d09abb87ef6b150f, _:r_83a596a6b0dc662c1265fcb5, _:r_85dd654ffc83ec87b8654ec9, _:r_87c3613a0e22c99a5618b61a, _:r_89f07102bbeb3a845764605f, _:r_8f5598d427e9daf2ccecb2d2, _:r_9d7d9e1c13101dbdd4fa8b5c, _:r_abb03216bf1e5b4bb8be33d4, _:r_ce18b914e63301a1c7c90de7, _:r_ceb36999bc4c9e440ac773e5, <https://axiolune.ai/ontology/finance/foundation/IdentifiableSubject>, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentListing/LogicalIdentity> a owl:Class;
