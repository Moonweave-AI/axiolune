    rdfs:comment "Stable FactIdentity companion for immutable Financial Instrument versions.";
    rdfs:label "Financial Instrument logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-instruments:InstrumentClassificationAssertion a owl:Class;
    rdfs:comment "Instrument Classification Assertion, is a temporal fact asserting that a financial instrument is classified under a classification scheme (e.g. CFI) at a specific code, with a scheme release, an authority or source, and a valid-time interval, used for recording the classification of an instrument independently of its persistent identity";
    rdfs:label "Instrument Classification Assertion";
    rdfs:subClassOf _:r_292d2790b5ab83ba542cb2cc, _:r_38f09586b034ef637954845e, _:r_7a3099405acb80b3f7f5600f, _:r_7cd8b6cb5c05574f066351b7, _:r_81ed97e0b4069b46d5d4fb04, _:r_8a08f6a95160a45d3245771f, _:r_9704bb29ba0b623cb631ee44, _:r_9c8138c1a33ae685958b180e, _:r_af4b515ac7010fa125e83d20, _:r_b90f652734057d011156108c, _:r_beaced123fca6542767ecae7, _:r_c6f408fc14e69db7216211ed, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/instruments/InstrumentClassificationAssertion/LogicalIdentity> a owl:Class;
