<https://axiolune.ai/ontology/finance/instruments> a owl:Ontology;
    rdfs:comment "Financial Instruments, is a domain module in ontology engineering that defines the types of tradable financial instruments such as securities, equities, and listings, used to provide identifiable and classifiable typed definitions for tradable financial instruments.";
    rdfs:label "Financial Instruments";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/market-structure>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/instruments/2.0.0>.
fin-instruments:CFICategory a owl:Class;
    rdfs:comment "CFI Category, is a controlled vocabulary of ISO 10962 asset-level categories, used for classifying the top-level asset class of a financial instrument in an instrument classification assertion";
    rdfs:label "CFI Category";
    owl:oneOf _:l_1243a653fc93093950d15f42_0.
<https://axiolune.ai/ontology/finance/instruments/CFICategory/scheme> a skos:ConceptScheme;
    skos:prefLabel "CFI Category";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/instruments/CFICategory/value/debt> a owl:NamedIndividual, skos:Concept, fin-instruments:CFICategory;
    rdfs:comment "instruments representing claims on the issuer (ISO 10962 category D)";
    skos:inScheme <https://axiolune.ai/ontology/finance/instruments/CFICategory/scheme>;
    skos:notation "debt";
    skos:prefLabel "Debt";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/instruments/CFICategory/value/derivative> a owl:NamedIndividual, skos:Concept, fin-instruments:CFICategory;
    rdfs:comment "instruments whose value derives from an underlying (ISO 10962 category S for futures, O for options)";
    skos:inScheme <https://axiolune.ai/ontology/finance/instruments/CFICategory/scheme>;
    skos:notation "derivative";
    skos:prefLabel "Derivative";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/instruments/CFICategory/value/equity> a owl:NamedIndividual, skos:Concept, fin-instruments:CFICategory;
    rdfs:comment "instruments representing ownership interests (ISO 10962 category E)";
    skos:inScheme <https://axiolune.ai/ontology/finance/instruments/CFICategory/scheme>;
    skos:notation "equity";
    skos:prefLabel "Equity";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/instruments/CFICategory/value/fund> a owl:NamedIndividual, skos:Concept, fin-instruments:CFICategory;
    rdfs:comment "instruments representing collective investment vehicles (ISO 10962 category C)";
    skos:inScheme <https://axiolune.ai/ontology/finance/instruments/CFICategory/scheme>;
    skos:notation "fund";
    skos:prefLabel "Fund";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/instruments/CFICategory/value/other> a owl:NamedIndividual, skos:Concept, fin-instruments:CFICategory;
    rdfs:comment "instruments not falling into equity, debt, derivative, or fund categories";
    skos:inScheme <https://axiolune.ai/ontology/finance/instruments/CFICategory/scheme>;
    skos:notation "other";
    skos:prefLabel "Other";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-instruments:DirectUnitPriceQuotationContract a owl:Class;
    rdfs:comment "Direct Unit Price Quotation Contract, is a versioned quotation application class that expresses a quotation contract pricing a single controlled quantity unit directly in a given quote currency, used for listing or over-the-counter contexts.";
    rdfs:label "Direct Unit Price Quotation Contract";
