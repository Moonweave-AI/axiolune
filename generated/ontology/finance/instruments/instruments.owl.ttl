fin-instruments:contractMultiplier a owl:DatatypeProperty;
    rdfs:comment "dimensionless multiplier constrained to decimal one by the direct-unit quotation profile";
    rdfs:label "Contract Multiplier";
    rdfs:range xsd:decimal.
fin-instruments:isTradedOn a owl:ObjectProperty;
    rdfs:comment "derived convenience relation from a FinancialInstrument to a TradingFacility, computed only from PIT-eligible active listings and never stored as an independent truth";
    rdfs:domain fin-instruments:FinancialInstrument;
    rdfs:label "Is Traded On";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingFacility>.
fin-instruments:issuanceId a owl:DatatypeProperty;
    rdfs:comment "non-empty source-scoped identifier for one logical InstrumentIssuance";
    rdfs:label "Issuance Identifier";
    rdfs:range xsd:string.
fin-instruments:listedInstrument a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relates an InstrumentListing version to the exact FinancialInstrument version admitted by that listing";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Listed Instrument";
    rdfs:range fin-instruments:FinancialInstrument.
fin-instruments:listingBusinessFrom a owl:DatatypeProperty;
    rdfs:comment "inclusive business date from which an InstrumentListing is in force";
    rdfs:label "Listing Business From";
    rdfs:range xsd:date.
fin-instruments:listingBusinessTo a owl:DatatypeProperty;
    rdfs:comment "optional exclusive business date at which an InstrumentListing ceases to be in force";
    rdfs:label "Listing Business To";
    rdfs:range xsd:date.
fin-instruments:listingFacility a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relates an InstrumentListing version to the exact TradingFacility version at which it is listed";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Listing Facility";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingFacility>.
fin-instruments:listingIdentifierScheme a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "direct identity slot relating an InstrumentListing to exactly one venue-listing IdentifierScheme logical identity";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Listing Identifier Scheme";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/IdentifierScheme/LogicalIdentity>.
fin-instruments:listingIdentifierValue a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "direct identity slot relating an InstrumentListing to exactly one LocalIdentifierValue logical identity governed by its listing scheme";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Listing Identifier Value";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/LocalIdentifierValue/LogicalIdentity>.
fin-instruments:listingQuoteCurrency a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "sole stored relation from an InstrumentListing version to the Currency logical identity in which that listing is quoted";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Listing Quote Currency";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Currency/LogicalIdentity>.
fin-instruments:normalizationContractDigest a owl:DatatypeProperty;
    rdfs:comment "lowercase SHA-256 digest authenticating the exact quotation normalization contract bytes";
    rdfs:label "Normalization Contract Digest";
    rdfs:range xsd:string.
fin-instruments:normalizationContractRef a owl:DatatypeProperty;
    rdfs:comment "absolute IRI of the immutable normalization contract used to materialize quotation semantics";
    rdfs:label "Normalization Contract Reference";
    rdfs:range xsd:anyURI.
fin-instruments:offeredSecurity a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relates a SecurityOffering version to the exact Security version that it offers";
    rdfs:domain fin-instruments:SecurityOffering;
    rdfs:label "Offered Security";
    rdfs:range fin-instruments:Security.
fin-instruments:offeringId a owl:DatatypeProperty;
    rdfs:comment "non-empty source-scoped identifier for one logical SecurityOffering";
    rdfs:label "Offering Identifier";
    rdfs:range xsd:string.
fin-instruments:originatingOffering a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relates an InstrumentListing version to its optional exact originating SecurityOffering version";
    rdfs:domain fin-instruments:InstrumentListing;
    rdfs:label "Originating Offering";
    rdfs:range fin-instruments:SecurityOffering.
fin-instruments:quotationDenominatorUnit a owl:DatatypeProperty;
    rdfs:comment "absolute controlled unit IRI denoting the one Quantity unit against which direct price is quoted";
    rdfs:label "Quotation Denominator Unit";
    rdfs:range xsd:anyURI.
fin-instruments:quotationInstrument a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relates a DirectUnitPriceQuotationContract to its FinancialInstrument logical identity";
    rdfs:domain fin-instruments:DirectUnitPriceQuotationContract;
    rdfs:label "Quotation Instrument";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument/LogicalIdentity>.
fin-instruments:quotationKind a owl:ObjectProperty;
    rdfs:comment "closed quotation application member required on a direct unit-price contract";
    rdfs:label "Quotation Kind";
    rdfs:range fin-instruments:QuotationKind.
fin-instruments:quotationListingContext a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relates a quotation contract to its optional exact InstrumentListing context version";
    rdfs:domain fin-instruments:DirectUnitPriceQuotationContract;
    rdfs:label "Quotation Listing Context";
    rdfs:range fin-instruments:InstrumentListing.
fin-instruments:quotationOTCContext a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relates a quotation contract to its optional exact OTCTradingContext version";
    rdfs:domain fin-instruments:DirectUnitPriceQuotationContract;
    rdfs:label "Quotation OTC Context";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext>.
fin-instruments:quotationQuoteCurrency a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "relates a quotation contract to its exact quote Currency logical identity";
    rdfs:domain fin-instruments:DirectUnitPriceQuotationContract;
    rdfs:label "Quotation Quote Currency";
