    rdfs:range <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
<https://axiolune.ai/ontology/finance/market-data/TradeObservation/role/observedListing> a owl:ObjectProperty;
    rdfs:comment "exact listed-market context version used by the listed branch";
    rdfs:domain fin-market-data:TradeObservation;
    rdfs:label "observed listing";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/InstrumentListing>.
<https://axiolune.ai/ontology/finance/market-data/TradeObservation/role/observedOtcContext> a owl:ObjectProperty;
    rdfs:comment "exact OTCTradingContext version used by the OTC branch";
    rdfs:domain fin-market-data:TradeObservation;
    rdfs:label "observed OTC context";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/OTCTradingContext>.
<https://axiolune.ai/ontology/finance/market-data/TradeObservation/role/quotationContract> a owl:ObjectProperty;
    rdfs:comment "exact direct-unit quotation contract governing trade price and size";
    rdfs:domain fin-market-data:TradeObservation;
    rdfs:label "quotation contract";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/QuotationConvention>.
fin-market-data:UpdateAction a owl:Class;
    rdfs:comment "UpdateAction is a closed vocabulary that classifies the lifecycle action of a source market-data record, used for distinguishing new, change, delete, and correct actions";
    rdfs:label "Update Action";
    owl:oneOf _:l_9597d8c34c2ba1ed1bef2c79_0.
<https://axiolune.ai/ontology/finance/market-data/UpdateAction/scheme> a skos:ConceptScheme;
    skos:prefLabel "Update Action";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-data/UpdateAction/value/change> a owl:NamedIndividual, skos:Concept, fin-market-data:UpdateAction;
    rdfs:comment "source record is a revision or correction of an existing observation";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-data/UpdateAction/scheme>;
    skos:notation "change";
    skos:prefLabel "Change";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-data/UpdateAction/value/correct> a owl:NamedIndividual, skos:Concept, fin-market-data:UpdateAction;
    rdfs:comment "source record is a trade break or correction referencing a prior observation";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-data/UpdateAction/scheme>;
    skos:notation "correct";
    skos:prefLabel "Correct";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-data/UpdateAction/value/delete> a owl:NamedIndividual, skos:Concept, fin-market-data:UpdateAction;
    rdfs:comment "source record is a deletion or retraction of an existing observation";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-data/UpdateAction/scheme>;
    skos:notation "delete";
    skos:prefLabel "Delete";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-data/UpdateAction/value/new> a owl:NamedIndividual, skos:Concept, fin-market-data:UpdateAction;
    rdfs:comment "source record is a new observation or bar";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-data/UpdateAction/scheme>;
    skos:notation "new";
    skos:prefLabel "New";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-market-data:affectedSubjectDigest a owl:DatatypeProperty;
    rdfs:comment "affectedSubjectDigest is a digest over the unique exact-version IRI set of the affected observation versions, used for locking the subject set of a quality finding.";
    rdfs:label "Affected Subject Digest";
    rdfs:range xsd:string.
fin-market-data:askClosePrice a owl:ObjectProperty;
    rdfs:comment "askClosePrice is the ask-side monetary price last observed within a quote-bar aggregation window, used for recording the ask-side close price.";
    rdfs:label "Ask Close Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:askHighPrice a owl:ObjectProperty;
    rdfs:comment "askHighPrice is the highest ask-side monetary price within a quote-bar aggregation window, used for recording the ask-side high price.";
    rdfs:label "Ask High Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:askLowPrice a owl:ObjectProperty;
    rdfs:comment "askLowPrice is the lowest ask-side monetary price within a quote-bar aggregation window, used for recording the ask-side low price.";
    rdfs:label "Ask Low Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:askOpenPrice a owl:ObjectProperty;
    rdfs:comment "askOpenPrice is the ask-side monetary price first observed within a quote-bar aggregation window, used for recording the ask-side open price.";
    rdfs:label "Ask Open Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:askPrice a owl:ObjectProperty;
    rdfs:comment "askPrice is the monetary amount of the ask side of a complete quote observation, used for recording the sell-side quote at the observation time and belonging to the quote structure rather than a price kind.";
    rdfs:label "Ask Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:askSize a owl:ObjectProperty;
    rdfs:comment "askSize is the tradeable quantity corresponding to the observed ask price, used for recording the size of sell-side interest at the observation time.";
    rdfs:label "Ask Size";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:barAggregation a owl:ObjectProperty;
    rdfs:comment "barAggregation is a closed member that selects the aggregation kind of a bar, used for distinguishing time, tick, volume, notional, range, or renko aggregation.";
    rdfs:label "Bar Aggregation";
    rdfs:range fin-market-data:BarAggregation.
fin-market-data:barInterval a owl:DatatypeProperty;
    rdfs:comment "barInterval is a strictly positive duration required for time-bar aggregation, used for specifying the aggregation period of a time bar.";
    rdfs:label "Bar Interval";
    rdfs:range xsd:duration.
fin-market-data:barPriceBasis a owl:ObjectProperty;
    rdfs:comment "barPriceBasis is a closed discriminator that distinguishes the price semantics of a bar, used for separating trade OHLCV bars from paired bid-and-ask OHLC bars.";
    rdfs:label "Bar Price Basis";
    rdfs:range fin-market-data:BarPriceBasis.
fin-market-data:barSequence a owl:DatatypeProperty;
    rdfs:comment "barSequence is a non-negative sequence number of a non-time bar within a data stream, used for providing an order position for a non-time bar.";
    rdfs:label "Bar Sequence";
    rdfs:range xsd:integer.
fin-market-data:barSourceTimeZone a owl:DatatypeProperty;
    rdfs:comment "barSourceTimeZone is a canonical IANA time-zone identifier used for deriving aggregation boundaries, used for fixing the time-zone semantics of the source calendar.";
    rdfs:label "Bar Source Time Zone";
    rdfs:range xsd:string.
fin-market-data:barSpecificationCalendar a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "barSpecificationCalendar is a functional relation that links a BarSpecification to its source trading calendar, used for declaring the exact calendar version that governs its aggregation boundaries.";
    rdfs:domain fin-market-data:BarSpecification;
    rdfs:label "Bar Specification Calendar";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingCalendar>.
fin-market-data:barSpecificationId a owl:DatatypeProperty;
    rdfs:comment "barSpecificationId is a non-empty logical identifier scoped to a source data stream, used for uniquely identifying one bar specification within a data stream.";
    rdfs:label "Bar Specification Identifier";
    rdfs:range xsd:string.
fin-market-data:barSpecificationStream a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "barSpecificationStream is a functional relation that links a BarSpecification to its source data stream, used for declaring the exact source-contract version that the specification depends on.";
    rdfs:domain fin-market-data:BarSpecification;
    rdfs:label "Bar Specification Stream";
    rdfs:range fin-market-data:MarketDataStream.
fin-market-data:barThreshold a owl:ObjectProperty;
    rdfs:comment "barThreshold is a strictly positive quantity required for non-time-bar aggregation, used for specifying the trigger threshold of a non-time bar.";
    rdfs:label "Bar Threshold";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:barThresholdEventCount a owl:DatatypeProperty;
    rdfs:comment "BarThresholdEventCount is an optional positive integer threshold for event-count-aggregation bars, used when barThresholdKind is eventCount";
    rdfs:label "Bar Threshold Event Count";
    rdfs:range xsd:integer.
fin-market-data:barThresholdKind a owl:ObjectProperty;
    rdfs:comment "BarThresholdKind is an optional closed member that classifies the threshold type of a non-time bar, used for strongly typing the bar threshold by its dimension";
    rdfs:label "Bar Threshold Kind";
    rdfs:range fin-market-data:BarThresholdKind.
fin-market-data:barThresholdNotional a owl:ObjectProperty;
    rdfs:comment "BarThresholdNotional is an optional MonetaryAmount threshold for notional-aggregation bars, used when barThresholdKind is notional";
    rdfs:label "Bar Threshold Notional";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:barThresholdPriceRange a owl:ObjectProperty;
    rdfs:comment "BarThresholdPriceRange is an optional MonetaryAmount threshold for price-range-aggregation bars, used when barThresholdKind is priceRange or renkoBrick";
    rdfs:label "Bar Threshold Price Range";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:barTimestampConvention a owl:ObjectProperty;
    rdfs:comment "barTimestampConvention is a closed member stating whether the observedAt of a time bar denotes the interval start or the interval end, used for unifying the timestamp semantics of time bars.";
    rdfs:label "Bar Timestamp Convention";
    rdfs:range fin-market-data:BarTimestampConvention.
fin-market-data:bidClosePrice a owl:ObjectProperty;
    rdfs:comment "bidClosePrice is the bid-side monetary price last observed within a quote-bar aggregation window, used for recording the bid-side close price.";
    rdfs:label "Bid Close Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:bidHighPrice a owl:ObjectProperty;
    rdfs:comment "bidHighPrice is the highest bid-side monetary price within a quote-bar aggregation window, used for recording the bid-side high price.";
    rdfs:label "Bid High Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:bidLowPrice a owl:ObjectProperty;
    rdfs:comment "bidLowPrice is the lowest bid-side monetary price within a quote-bar aggregation window, used for recording the bid-side low price.";
    rdfs:label "Bid Low Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:bidOpenPrice a owl:ObjectProperty;
    rdfs:comment "bidOpenPrice is the bid-side monetary price first observed within a quote-bar aggregation window, used for recording the bid-side open price.";
    rdfs:label "Bid Open Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:bidPrice a owl:ObjectProperty;
    rdfs:comment "bidPrice is the monetary amount of the bid side of a complete quote observation, used for recording the buy-side quote at the observation time and belonging to the quote structure rather than a price kind.";
    rdfs:label "Bid Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:bidSize a owl:ObjectProperty;
    rdfs:comment "bidSize is the tradeable quantity corresponding to the observed bid price, used for recording the size of buy-side interest at the observation time.";
    rdfs:label "Bid Size";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:calculationDefinitionDigest a owl:DatatypeProperty;
    rdfs:comment "calculationDefinitionDigest is a digest of the calculation-definition bytes, used for verifying the consistency between the definition content and its reference.";
    rdfs:label "Calculation Definition Digest";
    rdfs:range xsd:string.
fin-market-data:calculationDefinitionRef a owl:DatatypeProperty;
    rdfs:comment "calculationDefinitionRef is an identifier for the immutable calculation definition used to derive a volume- or time-weighted price, used only for derived prices.";
    rdfs:label "Calculation Definition Reference";
    rdfs:range xsd:anyURI.
fin-market-data:calculationInputSetDigest a owl:DatatypeProperty;
    rdfs:comment "calculationInputSetDigest is a digest of the canonically selected input fact-version snapshots, used for invalidating the digest when the selected identity or payload drifts.";
    rdfs:label "Calculation Input Fact Set Digest";
    rdfs:range xsd:string.
fin-market-data:calculationRunDigest a owl:DatatypeProperty;
    rdfs:comment "calculationRunDigest is a digest of the calculation-run evidence bytes, used for verifying the consistency between the run evidence and its reference.";
    rdfs:label "Calculation Run Digest";
    rdfs:range xsd:string.
fin-market-data:calculationRunRef a owl:DatatypeProperty;
    rdfs:comment "calculationRunRef is an identifier for the evidence of one calculation run, used for locking the replayable evidence of inputs, window, definition, output, and recalculation policy.";
    rdfs:label "Calculation Run Reference";
    rdfs:range xsd:anyURI.
fin-market-data:firstContributingEventAt a owl:DatatypeProperty;
    rdfs:comment "firstContributingEventAt is the UTC instant at which the first source event occurs within a non-time bar, used for recording the earliest event boundary of the bar.";
    rdfs:label "First Contributing Event At";
    rdfs:range xsd:dateTimeStamp.
fin-market-data:fxRate a owl:ObjectProperty;
    rdfs:comment "fxRate is a strictly positive dimensionless quantity expressing the ratio of quote-currency units to one base-currency unit, used for recording the ratio value of an FX rate observation.";
    rdfs:label "FX Rate";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:fxRateConvention a owl:ObjectProperty;
    rdfs:comment "FXRateConvention is an optional closed member that classifies the settlement convention of an FX rate observation, used for distinguishing spot, forward, NDF, and swap";
    rdfs:label "FX Rate Convention";
    rdfs:range fin-market-data:FXRateConvention.
fin-market-data:fxRateKind a owl:ObjectProperty;
    rdfs:comment "FXRateKind is an optional closed member that classifies the nature of an FX rate observation, used for distinguishing tradeable, reference, fixing, and benchmark rates";
    rdfs:label "FX Rate Kind";
    rdfs:range fin-market-data:FXRateKind.
fin-market-data:fxValueDate a owl:DatatypeProperty;
    rdfs:comment "FXValueDate is an optional date for the settlement or value date of an FX rate, used for distinguishing spot, forward, and NDF value dates";
    rdfs:label "FX Value Date";
    rdfs:range xsd:date.
fin-market-data:intervalEnd a owl:DatatypeProperty;
    rdfs:comment "intervalEnd is the UTC instant at which a time-bar aggregation window ends, used for marking the right boundary of the bar as a half-open interval.";
    rdfs:label "Interval End";
    rdfs:range xsd:dateTimeStamp.
fin-market-data:intervalStart a owl:DatatypeProperty;
    rdfs:comment "intervalStart is the UTC instant at which a time-bar aggregation window starts, used for marking the left boundary of the bar as a half-open interval.";
    rdfs:label "Interval Start";
    rdfs:range xsd:dateTimeStamp.
fin-market-data:lastAskSize a owl:ObjectProperty;
    rdfs:comment "lastAskSize is the representative ask-side quantity preserved by a quote bar, used for recording the ask-side size at the end of the window.";
    rdfs:label "Last Ask Size";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:lastBidSize a owl:ObjectProperty;
    rdfs:comment "lastBidSize is the representative bid-side quantity preserved by a quote bar, used for recording the bid-side size at the end of the window.";
    rdfs:label "Last Bid Size";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:lastContributingEventAt a owl:DatatypeProperty;
    rdfs:comment "lastContributingEventAt is the UTC instant at which the last source event occurs within a non-time bar, used for recording the latest event boundary of the bar.";
    rdfs:label "Last Contributing Event At";
    rdfs:range xsd:dateTimeStamp.
fin-market-data:marketEventAt a owl:DatatypeProperty;
    rdfs:comment "MarketEventAt is an optional UTC instant recording the source-declared market event timestamp (e.g., execution time, quote time), distinct from the TemporalFact validFrom which is platform-assigned per business validity";
    rdfs:label "Market Event At";
    rdfs:range xsd:dateTimeStamp.
fin-market-data:observationIdFieldLocator a owl:ObjectProperty;
    rdfs:comment "observationIdFieldLocator is a locator structure that selects the observation-identifier field in a raw record, used for mapping a source field precisely to an observation identifier.";
    rdfs:label "Observation Identifier Field Locator";
    rdfs:range <https://axiolune.ai/ontology/meta/data-binding/structures/SourceLocator>.
fin-market-data:orderingTransformDigest a owl:DatatypeProperty;
    rdfs:comment "orderingTransformDigest is a digest of the ordering-transformation bytes, used for verifying the consistency between the ordering rule and its reference.";
    rdfs:label "Ordering Transformation Digest";
    rdfs:range xsd:string.
fin-market-data:orderingTransformRef a owl:DatatypeProperty;
    rdfs:comment "orderingTransformRef is an identifier that locks the normalization ordering rule of a data stream, used for pointing to a lossless, uniqueness-preserving ordering-tuple transformation.";
    rdfs:label "Ordering Transformation Reference";
    rdfs:range xsd:anyURI.
fin-market-data:priceKind a owl:ObjectProperty;
    rdfs:comment "priceKind is a closed member that annotates the semantic type of a price observation, used for classifying the price, with bid and ask excluded because they belong to the quote structure.";
    rdfs:label "Price Kind";
    rdfs:range fin-market-data:PriceKind.
fin-market-data:priceValue a owl:ObjectProperty;
    rdfs:comment "priceValue is the monetary amount of a price observation, used for carrying the sole quote-currency truth of the price.";
    rdfs:label "Price Value";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:providerObservationId a owl:DatatypeProperty;
    rdfs:comment "providerObservationId is the raw observation identifier selected by the source contract of a data stream, used for uniquely identifying one observation within the scope of the stream.";
    rdfs:label "Provider Observation Identifier";
    rdfs:range xsd:string.
fin-market-data:providerStreamId a owl:DatatypeProperty;
    rdfs:comment "providerStreamId is a non-empty identifier that forms part of the logical key of a data stream, used for uniquely distinguishing one stream within the scope of a given provider and source contract.";
    rdfs:label "Provider Stream Identifier";
    rdfs:range xsd:string.
fin-market-data:qualityFindingKind a owl:ObjectProperty;
    rdfs:comment "qualityFindingKind is a closed member that annotates the predicate type of a quality finding, used for declaring the exact judgment type that one quality finding executes.";
    rdfs:label "Quality Finding Kind";
    rdfs:range fin-market-data:MarketDataQualityFindingKind.
fin-market-data:sourceApiIdentifier a owl:DatatypeProperty;
    rdfs:comment "sourceApiIdentifier is a stable identifier for a data delivery interface, used for locating the delivery channel that a data stream corresponds to.";
    rdfs:label "Source API Identifier";
    rdfs:range xsd:string.
fin-market-data:sourceChannelId a owl:DatatypeProperty;
    rdfs:comment "SourceChannelId is an optional identifier for the data channel or feed partition under which a source record was produced, used for enriching observation identity with channel context";
    rdfs:label "Source Channel Identifier";
    rdfs:range xsd:string.
fin-market-data:sourceContractDigest a owl:DatatypeProperty;
    rdfs:comment "sourceContractDigest is a digest of the source-contract bytes, used for verifying the consistency between the contract content and its reference.";
    rdfs:label "Source Contract Digest";
    rdfs:range xsd:string.
fin-market-data:sourceContractRef a owl:DatatypeProperty;
    rdfs:comment "sourceContractRef is an identifier that locks the field mapping and normalization rules of a data stream, used for pointing to the immutable provider source contract.";
    rdfs:label "Source Contract Reference";
    rdfs:range xsd:anyURI.
fin-market-data:sourceOrderKey a owl:DatatypeProperty;
    rdfs:comment "sourceOrderKey is a non-negative integer from the provider sequence or the output of the ordering transformation, used for establishing a normalized order for each observation.";
    rdfs:label "Source Order Key";
    rdfs:range xsd:integer.
fin-market-data:sourceRecordRevisionMode a owl:ObjectProperty;
    rdfs:comment "sourceRecordRevisionMode is a closed member that declares the revision policy of a data stream, used for selecting between immutable-record and revisioned-record supply.";
    rdfs:label "Source Record Revision Mode";
    rdfs:range fin-market-data:SourceRecordRevisionMode.
fin-market-data:sourceRevisionFieldLocator a owl:ObjectProperty;
    rdfs:comment "sourceRevisionFieldLocator is a locator structure that selects the revision field in a raw record, used only by revisioned-record streams.";
    rdfs:label "Source Revision Field Locator";
    rdfs:range <https://axiolune.ai/ontology/meta/data-binding/structures/SourceLocator>.
fin-market-data:sourceRevisionOrder a owl:DatatypeProperty;
    rdfs:comment "sourceRevisionOrder is a non-negative provider-declared revision order used only under the revisioned-record policy, used for constraining the linear order of the revision chain.";
    rdfs:label "Source Revision Order";
    rdfs:range xsd:integer.
fin-market-data:sourceRevisionToken a owl:DatatypeProperty;
    rdfs:comment "sourceRevisionToken is a normalized provider revision value used only under the revisioned-record policy, used for distinguishing different revisions of the same record.";
    rdfs:label "Source Revision Token";
    rdfs:range xsd:string.
fin-market-data:sourceSchemaIdentifier a owl:DatatypeProperty;
    rdfs:comment "sourceSchemaIdentifier is a stable identifier for a source record schema, used for distinguishing different field-structure definitions.";
    rdfs:label "Source Schema Identifier";
    rdfs:range xsd:string.
fin-market-data:sourceSchemaVersion a owl:DatatypeProperty;
    rdfs:comment "sourceSchemaVersion is the exact provider schema version interpreted by the locked source contract, used for pinning the specific version of the field structure.";
    rdfs:label "Source Schema Version";
    rdfs:range xsd:string.
fin-market-data:sourceSessionId a owl:DatatypeProperty;
    rdfs:comment "SourceSessionId is an optional identifier for the trading session or trading day partition under which a source record was produced, used for enriching observation identity with session context";
    rdfs:label "Source Session Identifier";
    rdfs:range xsd:string.
fin-market-data:sourceTradeId a owl:DatatypeProperty;
    rdfs:comment "sourceTradeId is a provider-declared trade identifier, used as the final tiebreaker for canonical ordering and as a component of the logical key.";
    rdfs:label "Source Trade Identifier";
    rdfs:range xsd:string.
fin-market-data:streamProvider a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "streamProvider is a functional relation that links a MarketDataStream version to the Party that owns it, used for declaring the supply party and the boundary of responsibility for a data stream.";
    rdfs:domain fin-market-data:MarketDataStream;
    rdfs:label "Stream Provider";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-market-data:streamPurpose a owl:ObjectProperty;
    rdfs:comment "streamPurpose is a closed member that limits the kinds of records a data stream accepts, used for declaring the purpose contract at the data-stream level.";
    rdfs:label "Stream Purpose";
    rdfs:range fin-market-data:MarketDataStreamPurpose.
fin-market-data:tradeClosePrice a owl:ObjectProperty;
    rdfs:comment "tradeClosePrice is the monetary price of the last trade within a trade-bar aggregation window, used for recording the close price of the window.";
    rdfs:label "Trade Close Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:tradeHighPrice a owl:ObjectProperty;
    rdfs:comment "tradeHighPrice is the highest trade monetary price within a trade-bar aggregation window, used for recording the high price of the window.";
    rdfs:label "Trade High Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:tradeLowPrice a owl:ObjectProperty;
    rdfs:comment "tradeLowPrice is the lowest trade monetary price within a trade-bar aggregation window, used for recording the low price of the window.";
    rdfs:label "Trade Low Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:tradeOpenPrice a owl:ObjectProperty;
    rdfs:comment "tradeOpenPrice is the monetary price of the first trade within a trade-bar aggregation window, used for recording the open price of the window.";
    rdfs:label "Trade Open Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:tradePrice a owl:ObjectProperty;
    rdfs:comment "tradePrice is the monetary execution price reported by one trade observation, used for recording the actual traded price.";
    rdfs:label "Trade Price";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-market-data:tradeSize a owl:ObjectProperty;
    rdfs:comment "tradeSize is the strictly positive traded quantity reported by one trade observation, used for recording the actual traded size.";
    rdfs:label "Trade Size";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:tradeVolume a owl:ObjectProperty;
    rdfs:comment "tradeVolume is the aggregate traded quantity of all trades within a trade-bar aggregation window, used for recording the cumulative size of the window.";
    rdfs:label "Trade Volume";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-market-data:updateAction a owl:ObjectProperty;
    rdfs:comment "UpdateAction is an optional closed member that classifies the lifecycle action of a source market-data record, used for distinguishing new, change, delete, and correct actions";
    rdfs:label "Update Action";
    rdfs:range fin-market-data:UpdateAction.
