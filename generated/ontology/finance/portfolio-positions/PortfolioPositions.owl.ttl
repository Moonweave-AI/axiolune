<https://axiolune.ai/ontology/finance/portfolio-positions> a owl:Ontology;
    rdfs:comment "Portfolio and Positions, is a domain module that defines a generic semantic core for portfolios, holdings, position lots, valuation, cost basis, and reconciliation, plus an optional direct-unit-price, execution-driven-cost, strict-closure, and data-ingestion implementation profile. The generic core expresses portfolio state across custody, accounting, economic, and regulatory views with position scope, balance dimension, and lot lifecycle; the profile narrows the core to a concrete operating画像. The module is lot-aware and reconciliation-aware and separates domain facts from runtime/reproducibility evidence.";
    rdfs:label "Portfolio and Positions";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/instruments>, <https://axiolune.ai/ontology/finance/market-data>, <https://axiolune.ai/ontology/finance/orders-execution>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/portfolio-positions/1.1.0>.
fin-portfolio:BalanceDimension a owl:Class;
    rdfs:comment "Balance Dimension, is a closed classification of sub-balance buckets for a holding or position, used for expressing settled, pending, available, pledged, loaned, receivable, and payable quantities so that gross long, gross short, and net can be reported per bucket rather than collapsed into one signed number.";
    rdfs:label "Balance Dimension";
    owl:oneOf _:l_274f689fceb14df09ef03436_0.
