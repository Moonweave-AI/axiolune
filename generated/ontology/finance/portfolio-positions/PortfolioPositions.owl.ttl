    rdfs:range <https://axiolune.ai/ontology/finance/orders-execution/Fee>.
fin-portfolio:closureFeeAllocation a owl:ObjectProperty;
    rdfs:comment "Closure Fee Allocation, is a relationship from an allocation closure to every included exact fee allocation, used for encapsulating the set of fee-to-lot allocations.";
    rdfs:domain fin-portfolio:ExecutionLotAllocationClosure;
    rdfs:label "closure fee allocation";
    rdfs:range fin-portfolio:PositionLotFeeAllocation.
fin-portfolio:closureSelectedLot a owl:ObjectProperty;
    rdfs:comment "Closure Selected Lot, is a relationship to the exact PositionLot version explicitly selected by specific-identification evidence in an allocation closure, used for specific-identification scenarios other than FIFO and LIFO.";
    rdfs:domain fin-portfolio:ExecutionLotAllocationClosure;
    rdfs:label "closure selected lot";
    rdfs:range fin-portfolio:PositionLot.
fin-portfolio:comparisonFamily a owl:ObjectProperty;
    rdfs:comment "Comparison Family, is an attribute marking whether a ReconciliationComparison compares quantity or basis, used for selecting the comparison branch.";
    rdfs:label "comparison family";
    rdfs:range fin-portfolio:ComparisonFamily.
fin-portfolio:comparisonProfileRef a owl:DatatypeProperty;
    rdfs:comment "Comparison Profile Reference, is an immutable reference to the comparison profile governing a ReconciliationComparison, used for fixing the comparison rules.";
    rdfs:label "comparison profile reference";
    rdfs:range xsd:anyURI.
fin-portfolio:comparisonResult a owl:ObjectProperty;
    rdfs:comment "Comparison Result, is an attribute marking the outcome of a ReconciliationComparison (matched, break, ambiguous, not comparable), used so that matched is a comparison result rather than a standalone finding.";
    rdfs:label "comparison result";
    rdfs:range fin-portfolio:ReconciliationComparisonResult.
fin-portfolio:constituentKind a owl:ObjectProperty;
    rdfs:comment "Portfolio Constituent Kind, is an attribute marking the kind of a portfolio constituent (account, sub-portfolio, sleeve, explicit allocation), used so that a portfolio is not restricted to an account aggregation.";
    rdfs:label "portfolio constituent kind";
    rdfs:range fin-portfolio:PortfolioConstituentKind.
fin-portfolio:consumptionSelectionProbeDigest a owl:DatatypeProperty;
    rdfs:comment "Consumption Selection Probe Digest, is a hash digest of the completed eligible-lot and selection probe, used for detecting changes to the probe record.";
    rdfs:label "consumption selection probe digest";
    rdfs:range xsd:string.
fin-portfolio:consumptionSelectionProbeRef a owl:DatatypeProperty;
    rdfs:comment "Consumption Selection Probe Reference, is an immutable reference to the completed eligible-lot and deterministic consumption-selection probe, used for proving the selection has no omissions.";
    rdfs:label "consumption selection probe reference";
    rdfs:range xsd:anyURI.
fin-portfolio:conversionContextDigest a owl:DatatypeProperty;
    rdfs:comment "Conversion Context Digest, is a hash digest of the complete FX conversion context, used for detecting changes to the conversion context.";
    rdfs:label "conversion context digest";
    rdfs:range xsd:string.
fin-portfolio:conversionContextRef a owl:DatatypeProperty;
    rdfs:comment "Conversion Context Reference, is an immutable reference to the complete valuation FX conversion context, used for fixing the conversion prerequisites.";
    rdfs:label "conversion context reference";
    rdfs:range xsd:anyURI.
fin-portfolio:costBasisDefinitionAuthority a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Cost Basis Definition Authority, is a relationship to the logical Party whose namespace governs the stable cost-basis definition identifier, used for fixing the namespace attribution of the definition.";
    rdfs:domain fin-portfolio:CostBasisCalculationDefinition;
    rdfs:label "cost basis definition authority";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-portfolio:costBasisDefinitionBasisCurrency a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Cost Basis Definition Basis Currency, is a relationship to the single logical Currency in which a cost-basis definition groups opening gross, fee effects, and basis terms, used for unifying the currency after explicit FX conversion.";
    rdfs:domain fin-portfolio:CostBasisCalculationDefinition;
    rdfs:label "cost basis definition basis currency";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Currency/LogicalIdentity>.
fin-portfolio:costBasisDefinitionId a owl:DatatypeProperty;
    rdfs:comment "Cost Basis Definition Identifier, is a stable identifier of a cost-basis definition within the authority namespace, used for uniquely marking a single cost-basis specification.";
    rdfs:label "cost basis definition identifier";
    rdfs:range xsd:string.
fin-portfolio:costBasisDefinitionQuotationContract a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Cost Basis Definition Quotation Contract, is a relationship from a cost-basis definition to its exact direct-unit quotation input, used for fixing the quotation basis of cost-basis calculation.";
    rdfs:domain fin-portfolio:CostBasisCalculationDefinition;
    rdfs:label "cost basis definition quotation contract";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/DirectUnitPriceQuotationContract>.
fin-portfolio:costBasisMethod a owl:ObjectProperty;
    rdfs:comment "Cost Basis Method, is a reviewed cost-basis calculation method, used for fixing the calculation convention of the basis.";
    rdfs:label "cost basis method";
    rdfs:range fin-portfolio:CostBasisMethod.
fin-portfolio:coverageDigest a owl:DatatypeProperty;
    rdfs:comment "Coverage Digest, is a hash digest of the complete valuation-line coverage set in a summary, used for verifying the coverage closure.";
    rdfs:label "coverage digest";
    rdfs:range xsd:string.
fin-portfolio:coverageInclusionReason a owl:DatatypeProperty;
    rdfs:comment "Coverage Inclusion Reason, is an optional note recording why a valuation line is included in a summary coverage, used for auditability of the coverage closure.";
    rdfs:label "coverage inclusion reason";
    rdfs:range xsd:string.
fin-portfolio:coverageStatus a owl:ObjectProperty;
    rdfs:comment "Coverage Status, is an attribute marking whether a valuation summary coverage is complete, partial, or excludes members, used for stating the coverage closure result.";
    rdfs:label "coverage status";
    rdfs:range fin-portfolio:CoverageStatus.
fin-portfolio:crossRatePath a owl:DatatypeProperty;
    rdfs:comment "Cross-Rate Path Reference, is an optional reference to an ordered FXRateObservation chain used to derive a cross rate, used for multi-leg cross-currency conversions.";
    rdfs:label "cross-rate path reference";
    rdfs:range xsd:anyURI.
fin-portfolio:currencyPolicy a owl:DatatypeProperty;
    rdfs:comment "Currency Policy, is a canonical policy for grouping and aggregating by the basis currency, used for unifying the currency convention of cost basis.";
    rdfs:label "currency policy";
    rdfs:range xsd:string.
fin-portfolio:eligibleLotCount a owl:DatatypeProperty;
    rdfs:comment "Eligible Lot Count, is the cardinality of the complete exact eligible-lot version set, used for verifying the count of the eligible domain.";
    rdfs:label "eligible lot count";
    rdfs:range xsd:integer.
fin-portfolio:eligibleLotVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "Eligible Lot Version Set Digest, is a digest of the complete exact PositionLot version set eligible for consumption by one Execution, used for verifying the completeness of the eligible domain.";
    rdfs:label "eligible lot version set digest";
    rdfs:range xsd:string.
fin-portfolio:exclusionReason a owl:DatatypeProperty;
    rdfs:comment "Exclusion Reason, is an optional note recording why a valuation line is excluded from a summary coverage, used for auditability of the coverage closure.";
    rdfs:label "exclusion reason";
    rdfs:range xsd:string.
fin-portfolio:externalBasisId a owl:DatatypeProperty;
    rdfs:comment "External Basis Identifier, is a stable identifier of an external cost-basis observation within the source scope, used for uniquely marking a single external basis.";
    rdfs:label "external basis identifier";
    rdfs:range xsd:string.
fin-portfolio:externalBasisMappingStatus a owl:ObjectProperty;
    rdfs:comment "External Basis Mapping Status, is an optional attribute marking whether the external basis method is mapped, unknown, or unmapped to an internal calculation definition, used so that the internal definition is an optional mapping rather than a disguised external method.";
    rdfs:label "external basis mapping status";
    rdfs:range fin-portfolio:ExternalBasisMappingStatus.
fin-portfolio:externalBasisMethod a owl:DatatypeProperty;
    rdfs:comment "External Basis Method, is an optional attribute recording the basis method reported by the external source, used so that the external party may report its own method rather than be forced to the internal calculation definition.";
    rdfs:label "external basis method";
    rdfs:range xsd:string.
fin-portfolio:externalCostBasis a owl:ObjectProperty;
    rdfs:comment "External Cost Basis, is a source-provided Money basis retained independently from the execution-derived basis, used for recording externally reported cost.";
    rdfs:label "external cost basis";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:externalStatementDate a owl:DatatypeProperty;
    rdfs:comment "External Statement Date, is an optional date of the external statement an external cost-basis observation belongs to, used for grouping external observations by statement.";
    rdfs:label "external statement date";
    rdfs:range xsd:date.
fin-portfolio:feeAllocationCount a owl:DatatypeProperty;
    rdfs:comment "Fee Allocation Count, is the cardinality of the exact fee allocation version set, used for verifying the count of the fee allocation set.";
    rdfs:label "fee allocation count";
    rdfs:range xsd:integer.
fin-portfolio:feeAllocationVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "Fee Allocation Version Set Digest, is a digest of all exact PositionLotFeeAllocation versions in the closure, used for verifying the completeness of the fee allocation set.";
    rdfs:label "fee allocation version set digest";
    rdfs:range xsd:string.
fin-portfolio:feeClosureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "Fee Closure Probe Digest, is a hash digest of the completed Fee closure probe, used for detecting changes to the probe record.";
    rdfs:label "fee closure probe digest";
    rdfs:range xsd:string.
fin-portfolio:feeClosureProbeRef a owl:DatatypeProperty;
    rdfs:comment "Fee Closure Probe Reference, is an immutable reference to the completed Fee completeness probe, used for proving the fee set has no omissions.";
    rdfs:label "fee closure probe reference";
    rdfs:range xsd:anyURI.
fin-portfolio:feeCount a owl:DatatypeProperty;
    rdfs:comment "Fee Count, is the cardinality of the exact Fee version set, used for verifying the count of the fee set.";
    rdfs:label "fee count";
    rdfs:range xsd:integer.
fin-portfolio:feeTreatment a owl:ObjectProperty;
    rdfs:comment "Fee Treatment, is a branch attribute deciding whether a fee enters the basis, used for controlling how fees enter the opening basis.";
    rdfs:label "fee treatment";
    rdfs:range fin-portfolio:FeeTreatment.
fin-portfolio:feeVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "Fee Version Set Digest, is a digest of all exact Fee versions for one Execution, used for verifying the completeness of the fee set.";
    rdfs:label "fee version set digest";
    rdfs:range xsd:string.
fin-portfolio:findingKind a owl:ObjectProperty;
    rdfs:comment "Reconciliation Finding Kind, is an attribute marking the conclusion of a ReconciliationFinding (matched, quantity mismatch, basis mismatch, methodology difference, timing difference, ambiguous, not comparable, missing external, missing derived), used for typing the disposition-requiring result.";
    rdfs:label "reconciliation finding kind";
    rdfs:range fin-portfolio:ReconciliationFindingKind.
fin-portfolio:findingSeverity a owl:ObjectProperty;
    rdfs:comment "Finding Severity, is an attribute marking the severity of a ReconciliationFinding, used for prioritizing disposition.";
    rdfs:label "finding severity";
    rdfs:range fin-portfolio:FindingSeverity.
fin-portfolio:formulaDigest a owl:DatatypeProperty;
    rdfs:comment "Formula Digest, is a hash digest of the canonical valuation formula or implementation, used for locking the exact text of the calculation logic.";
    rdfs:label "formula digest";
    rdfs:range xsd:string.
fin-portfolio:fxConversionDirection a owl:ObjectProperty;
    rdfs:comment "FX Conversion Direction, is an attribute indicating base-to-quote or quote-to-base orientation, used for determining the application direction of the rate equation.";
    rdfs:label "FX conversion direction";
    rdfs:range fin-portfolio:FXConversionDirection.
fin-portfolio:fxPolicy a owl:DatatypeProperty;
    rdfs:comment "FX Policy, is a policy requiring an explicit PIT-eligible FX conversion when currencies differ, used for enforcing the auditability of cross-currency conversion.";
    rdfs:label "FX policy";
    rdfs:range xsd:string.
fin-portfolio:grossLongQuantity a owl:ObjectProperty;
    rdfs:comment "Gross Long Quantity, is an optional absolute non-negative long exposure quantity for a snapshot, used for reporting gross long separately from net so that a negative net does not erase the gross long truth.";
    rdfs:label "gross long quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-portfolio:grossShortQuantity a owl:ObjectProperty;
    rdfs:comment "Gross Short Quantity, is an optional absolute non-negative short exposure quantity for a snapshot, used for reporting gross short separately from net so that a positive net does not erase the gross short truth.";
    rdfs:label "gross short quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-portfolio:holdingQuantity a owl:ObjectProperty;
    rdfs:comment "Holding Quantity, is a non-negative quantity of an owned financial interest, used for recording the scale of a holding.";
    rdfs:label "holding quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-portfolio:implementationDigest a owl:DatatypeProperty;
    rdfs:comment "Implementation Digest, is a hash digest of the canonical calculation implementation bytes, used for locking the executable implementation.";
    rdfs:label "implementation digest";
    rdfs:range xsd:string.
fin-portfolio:inputContractDigest a owl:DatatypeProperty;
    rdfs:comment "Input Contract Digest, is a hash digest of a calculation input contract, used for fixing the input specification.";
    rdfs:label "input contract digest";
    rdfs:range xsd:string.
fin-portfolio:inputMoney a owl:ObjectProperty;
    rdfs:comment "Input Money, is a Money value before an exact FX conversion, used as the input amount of the conversion.";
    rdfs:label "input money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:lineCount a owl:DatatypeProperty;
    rdfs:comment "Line Count, is the cardinality of valuation lines in a portfolio valuation summary, used for verifying the coverage closure count.";
    rdfs:label "line count";
    rdfs:range xsd:integer.
fin-portfolio:lotAllocationKind a owl:ObjectProperty;
    rdfs:comment "Lot Allocation Kind, is an attribute distinguishing the opening or consumption branch, used for marking the nature of a lot allocation.";
    rdfs:label "lot allocation kind";
    rdfs:range fin-portfolio:PositionLotAllocationKind.
fin-portfolio:lotClosureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "Lot Closure Probe Digest, is a hash digest of the completed open-lot closure probe, used for detecting changes to the probe record.";
    rdfs:label "lot closure probe digest";
    rdfs:range xsd:string.
fin-portfolio:lotClosureProbeRef a owl:DatatypeProperty;
    rdfs:comment "Lot Closure Probe Reference, is an immutable reference to the completed open-lot completeness probe, used for proving the open-lot set has no omissions.";
    rdfs:label "lot closure probe reference";
    rdfs:range xsd:anyURI.
fin-portfolio:lotConsumptionPolicy a owl:ObjectProperty;
    rdfs:comment "Lot Consumption Policy, is a reviewed deterministic policy for selecting lots for consumption, used for specifying the consumption order such as FIFO or LIFO.";
    rdfs:label "lot consumption policy";
    rdfs:range fin-portfolio:LotConsumptionPolicy.
fin-portfolio:lotDiscriminator a owl:DatatypeProperty;
    rdfs:comment "Lot Discriminator, is a fixed discriminator that identifies one residual PositionLot within its identity context, used for uniquely distinguishing the lot. The openingRemainder value identifies an execution-derived opening-remainder lot; adjustedRemainder identifies a lot adjusted by a transformation; transferredLot identifies a lot sourced from a transfer.";
    rdfs:label "lot discriminator";
    rdfs:range xsd:string.
fin-portfolio:lotOpeningPolicy a owl:ObjectProperty;
    rdfs:comment "Lot Opening Policy, is a reviewed policy governing how an Execution opens residual position lots, used for constraining the opening approach.";
    rdfs:label "lot opening policy";
    rdfs:range fin-portfolio:LotOpeningPolicy.
fin-portfolio:lotSourceKind a owl:ObjectProperty;
    rdfs:comment "Lot Source Kind, is an optional attribute marking the source lineage of a PositionLot, used so that a lot is not forced to be execution-derived and may originate from transfer, opening balance, corporate action, or manual adjustment.";
    rdfs:label "lot source kind";
    rdfs:range fin-portfolio:PositionSourceKind.
fin-portfolio:mandateId a owl:DatatypeProperty;
    rdfs:comment "Mandate Identifier, is a stable identifier of a portfolio management mandate within the authority scope, used for uniquely marking a single management mandate.";
    rdfs:label "mandate identifier";
    rdfs:range xsd:string.
fin-portfolio:marketValue a owl:ObjectProperty;
    rdfs:comment "Market Value, is the Money output of the exact direct-unit valuation calculation, used for recording the market value of a valuation line.";
    rdfs:label "market value";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:membershipClosureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "Membership Closure Probe Digest, is a hash digest of the completed membership closure probe record, used for detecting changes to the probe record.";
    rdfs:label "membership closure probe digest";
    rdfs:range xsd:string.
fin-portfolio:membershipClosureProbeRef a owl:DatatypeProperty;
    rdfs:comment "Membership Closure Probe Reference, is an immutable reference to the completed member-account closure probe, used for proving the membership set has no omissions.";
    rdfs:label "membership closure probe reference";
    rdfs:range xsd:anyURI.
fin-portfolio:membershipCount a owl:DatatypeProperty;
    rdfs:comment "Membership Count, is the cardinality of the closed exact membership version set, used for verifying the count of the membership set.";
    rdfs:label "membership count";
    rdfs:range xsd:integer.
fin-portfolio:membershipId a owl:DatatypeProperty;
    rdfs:comment "Membership Identifier, is a stable identifier of a portfolio-account membership within the authority scope, used for uniquely marking a single membership.";
    rdfs:label "membership identifier";
    rdfs:range xsd:string.
fin-portfolio:membershipVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "Membership Version Set Digest, is a digest of the sorted unique exact membership version set, used for verifying the completeness of the membership set.";
    rdfs:label "membership version set digest";
    rdfs:range xsd:string.
fin-portfolio:openLotVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "Open Lot Version Set Digest, is a digest of the complete non-zero PositionLot exact-version set, used for verifying the completeness of the open-lot set.";
    rdfs:label "open lot version set digest";
    rdfs:range xsd:string.
fin-portfolio:openingCostBasis a owl:ObjectProperty;
    rdfs:comment "Signed Opening Cost Basis, is a signed Money basis after applying the exact fee, FX, precision, and rounding policy, used for recording the initial cost of a lot.";
    rdfs:label "signed opening cost basis";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:openingGross a owl:ObjectProperty;
    rdfs:comment "Opening Gross, is a positive Money gross computed from the allocated quantity and the exact execution price, used for recording the opening trade amount of a lot.";
    rdfs:label "opening gross";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:originalQuantity a owl:ObjectProperty;
    rdfs:comment "Original Signed Quantity, is a non-zero signed quantity opened by the opening Execution, used for recording the initial scale and direction of a lot.";
    rdfs:label "original signed quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-portfolio:outputContractDigest a owl:DatatypeProperty;
    rdfs:comment "Output Contract Digest, is a hash digest of a calculation output contract, used for fixing the output specification.";
    rdfs:label "output contract digest";
    rdfs:range xsd:string.
fin-portfolio:outputMoney a owl:ObjectProperty;
    rdfs:comment "Output Money, is a Money value after applying the declared FX direction and rounding policy, used for recording the conversion result.";
    rdfs:label "output money";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:portfolioId a owl:DatatypeProperty;
    rdfs:comment "Portfolio Identifier, is a stable identifier of a Portfolio within the authority scope, used for uniquely marking an investment portfolio.";
    rdfs:label "portfolio identifier";
    rdfs:range xsd:string.
fin-portfolio:portfolioIdentifyingAuthority a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Portfolio Identifying Authority, is a relationship to the logical Party whose namespace governs the stable portfolio identifier, used for forming the authority-scoped logical identity of a Portfolio so that the same portfolioId under two authorities remains unambiguous.";
    rdfs:domain fin-portfolio:Portfolio;
    rdfs:label "portfolio identifying authority";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-portfolio:portfolioName a owl:DatatypeProperty;
    rdfs:comment "Portfolio Name, is an optional human-readable display name of a Portfolio, used for display and retrieval.";
    rdfs:label "portfolio name";
    rdfs:range xsd:string.
fin-portfolio:portfolioObservationCompletenessContractDigest a owl:DatatypeProperty;
    rdfs:comment "Portfolio Observation Completeness Contract Digest, is a hash digest of the completeness contract, used for detecting changes to the completeness specification.";
    rdfs:label "portfolio observation completeness contract digest";
    rdfs:range xsd:string.
fin-portfolio:portfolioObservationCompletenessContractRef a owl:DatatypeProperty;
    rdfs:comment "Portfolio Observation Completeness Contract Reference, is an immutable reference that defines full, incremental, and partial snapshot completeness semantics, used for fixing the completeness specification.";
    rdfs:label "portfolio observation completeness contract reference";
    rdfs:range xsd:anyURI.
fin-portfolio:portfolioObservationPaginationContractDigest a owl:DatatypeProperty;
    rdfs:comment "Portfolio Observation Pagination Contract Digest, is a hash digest of the pagination contract, used for detecting changes to the pagination specification.";
    rdfs:label "portfolio observation pagination contract digest";
    rdfs:range xsd:string.
fin-portfolio:portfolioObservationPaginationContractRef a owl:DatatypeProperty;
    rdfs:comment "Portfolio Observation Pagination Contract Reference, is an immutable reference that defines page ordering, cursor, termination, and replay semantics, used for fixing the pagination specification.";
    rdfs:label "portfolio observation pagination contract reference";
    rdfs:range xsd:anyURI.
fin-portfolio:portfolioObservationSourceContractDigest a owl:DatatypeProperty;
    rdfs:comment "Portfolio Observation Source Contract Digest, is a hash digest of the source contract, used for detecting changes to the source specification.";
    rdfs:label "portfolio observation source contract digest";
    rdfs:range xsd:string.
fin-portfolio:portfolioObservationSourceContractRef a owl:DatatypeProperty;
    rdfs:comment "Portfolio Observation Source Contract Reference, is an immutable reference to the provider schema and source semantics contract, used for fixing the source specification.";
    rdfs:label "portfolio observation source contract reference";
    rdfs:range xsd:anyURI.
fin-portfolio:portfolioObservationStreamId a owl:DatatypeProperty;
    rdfs:comment "Portfolio Observation Stream Identifier, is an immutable stable identifier of an observation stream within the provider scope, used for uniquely marking a single data stream.";
    rdfs:label "portfolio observation stream identifier";
    rdfs:range xsd:string.
fin-portfolio:portfolioObservationStreamProvider a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Portfolio Observation Stream Provider, is a relationship to the logical Party that owns the namespace of a portfolio observation stream, used for defining the provider attribution of the data stream.";
    rdfs:domain fin-portfolio:PortfolioObservationStream;
    rdfs:label "portfolio observation stream provider";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-portfolio:portfolioReconciliationKind a owl:ObjectProperty;
    rdfs:comment "Portfolio Reconciliation Kind, is a typed result attribute of external-versus-derived comparison, used for marking the conclusion category of a reconciliation finding.";
    rdfs:label "portfolio reconciliation kind";
    rdfs:range fin-portfolio:PortfolioReconciliationKind.
fin-portfolio:positionQuantity a owl:ObjectProperty;
    rdfs:comment "Signed Position Quantity, is a signed quantity that serves as the sole directional truth for long, short, or flat, used for expressing exposure direction directly through positive, negative, or zero.";
    rdfs:label "signed position quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-portfolio:positionScope a owl:ObjectProperty;
    rdfs:comment "Position Scope, is an optional branch attribute marking the view (custody, accounting, economic, regulatory) under which a snapshot is observed, used so that one signed quantity is not overloaded across views.";
    rdfs:label "position scope";
    rdfs:range fin-portfolio:PositionScope.
fin-portfolio:positionSourceKind a owl:ObjectProperty;
    rdfs:comment "Position Source Kind, is a branch attribute distinguishing a snapshot as external-reported or execution-derived, used for marking the source lineage of a snapshot.";
    rdfs:label "position source kind";
    rdfs:range fin-portfolio:PositionSourceKind.
fin-portfolio:precisionPolicyDigest a owl:DatatypeProperty;
    rdfs:comment "Precision Policy Digest, is a hash digest of the exact rational and decimal precision policy, used for detecting changes to the precision specification.";
    rdfs:label "precision policy digest";
    rdfs:range xsd:string.
fin-portfolio:precisionPolicyRef a owl:DatatypeProperty;
    rdfs:comment "Precision Policy Reference, is an immutable reference to the exact rational and decimal precision policy, used for fixing the numeric precision specification.";
    rdfs:label "precision policy reference";
    rdfs:range xsd:anyURI.
fin-portfolio:quantityAdjustmentFactor a owl:ObjectProperty;
    rdfs:comment "Quantity Adjustment Factor, is an optional ratio applied to a lot's quantity by a LotAdjustment (e.g. 2-for-1 split), used for recording the magnitude of a transformation.";
    rdfs:label "quantity adjustment factor";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-portfolio:quoteTime a owl:DatatypeProperty;
    rdfs:comment "Quote Time, is an optional instant at which the FX rate was quoted, used for rate-staleness checks.";
    rdfs:label "quote time";
    rdfs:range xsd:dateTimeStamp.
fin-portfolio:rateDate a owl:DatatypeProperty;
    rdfs:comment "Rate Date, is an optional business date of the FX rate, used for value-date alignment.";
    rdfs:label "rate date";
    rdfs:range xsd:date.
fin-portfolio:rateFinality a owl:ObjectProperty;
    rdfs:comment "Rate Finality, is an optional attribute marking whether an FX rate is indicative, firm, or settled, used for distinguishing rate-application finality.";
    rdfs:label "rate finality";
    rdfs:range fin-portfolio:RateFinality.
fin-portfolio:rateSource a owl:DatatypeProperty;
    rdfs:comment "Rate Source Reference, is an optional reference to the source of the FX rate used by an FXConversion, used for auditability of the rate provenance.";
    rdfs:label "rate source reference";
    rdfs:range xsd:anyURI.
fin-portfolio:realizedCostBasis a owl:ObjectProperty;
    rdfs:comment "Realized Cost Basis, is the Money cost basis of the realized quantity, used for recording the cost side of a realized PnL.";
    rdfs:label "realized cost basis";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:realizedPnl a owl:ObjectProperty;
    rdfs:comment "Realized PnL, is the Money difference between realized proceeds and realized cost basis, used for recording the realized profit and loss of a lot closure.";
    rdfs:label "realized PnL";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:realizedProceeds a owl:ObjectProperty;
    rdfs:comment "Realized Proceeds, is the Money proceeds of the realized quantity, used for recording the proceeds side of a realized PnL.";
    rdfs:label "realized proceeds";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:realizedQuantity a owl:ObjectProperty;
    rdfs:comment "Realized Quantity, is a strictly positive quantity closed out by a LotRealization, used for recording the scale of a lot closure.";
    rdfs:label "realized quantity";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-portfolio:reconciliationCandidateGraphDigest a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Candidate Graph Digest, is a hash digest of the canonical candidate-graph artifact and its record-level digests, used for detecting changes to the candidate graph.";
    rdfs:label "reconciliation candidate graph digest";
    rdfs:range xsd:string.
fin-portfolio:reconciliationCandidateGraphRecordCount a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Candidate Graph Record Count, is the total count of canonical candidate records bound into the reconciliation candidate graph before PIT selection, used for verifying the size of the candidate graph.";
    rdfs:label "reconciliation candidate graph record count";
    rdfs:range xsd:integer.
fin-portfolio:reconciliationCandidateGraphRef a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Candidate Graph Reference, is an immutable reference to the canonical graph containing the complete external and derived candidate-record universe, used for fixing the complete candidate universe.";
    rdfs:label "reconciliation candidate graph reference";
    rdfs:range xsd:anyURI.
fin-portfolio:reconciliationClosureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Closure Probe Digest, is a hash digest of the completed reconciliation candidate-universe closure probe, used for detecting changes to the probe record.";
    rdfs:label "reconciliation closure probe digest";
    rdfs:range xsd:string.
fin-portfolio:reconciliationClosureProbeRef a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Closure Probe Reference, is an immutable reference to the completed probe that proves the exact candidate universe and role selection, used for proving the candidate domain has no omissions.";
    rdfs:label "reconciliation closure probe reference";
    rdfs:range xsd:anyURI.
fin-portfolio:reconciliationContextDigest a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Context Digest, is a hash digest of the exact comparison-context bytes for a reconciliation finding, used for detecting changes to the comparison context.";
    rdfs:label "reconciliation context digest";
    rdfs:range xsd:string.
fin-portfolio:reconciliationContextRef a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Context Reference, is an immutable reference to the exact comparison context for a reconciliation finding, used for fixing the comparison prerequisites.";
    rdfs:label "reconciliation context reference";
    rdfs:range xsd:anyURI.
fin-portfolio:reconciliationDerivedCandidateCount a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Derived Candidate Count, is the count of the complete PIT-eligible execution-derived candidate-version set for the selected family, subject, and derived source scope, used for verifying the count of the candidate domain.";
    rdfs:label "reconciliation derived candidate count";
    rdfs:range xsd:integer.
fin-portfolio:reconciliationDerivedCandidateVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Derived Candidate Version Set Digest, is a digest of the sorted complete PIT-eligible execution-derived candidate-version set for the selected family, subject, and source scope, used for verifying the completeness of the candidate domain.";
    rdfs:label "reconciliation derived candidate version set digest";
    rdfs:range xsd:string.
fin-portfolio:reconciliationDerivedOutputManifestDigest a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Derived Output Manifest Digest, is a hash digest of the completed derivation-run output manifest, used for detecting changes to the output manifest.";
    rdfs:label "reconciliation derived output manifest digest";
    rdfs:range xsd:string.
fin-portfolio:reconciliationDerivedOutputManifestRef a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Derived Output Manifest Reference, is an immutable reference to the completed derivation-run output manifest, used for fixing the derived output evidence.";
    rdfs:label "reconciliation derived output manifest reference";
    rdfs:range xsd:anyURI.
fin-portfolio:reconciliationDerivedSourceScopeRef a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Derived Source Scope Reference, is an immutable reference to the derivation run or namespace whose candidates are closed, used for fixing the derived source scope.";
    rdfs:label "reconciliation derived source scope reference";
    rdfs:range xsd:anyURI.
fin-portfolio:reconciliationExternalCandidateCount a owl:DatatypeProperty;
    rdfs:comment "Reconciliation External Candidate Count, is the count of the complete PIT-eligible external candidate-version set for the selected family, subject, and external source scope, used for verifying the count of the candidate domain.";
    rdfs:label "reconciliation external candidate count";
    rdfs:range xsd:integer.
fin-portfolio:reconciliationExternalCandidateVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "Reconciliation External Candidate Version Set Digest, is a digest of the sorted complete PIT-eligible external candidate-version set for the selected family, subject, and source scope, used for verifying the completeness of the candidate domain.";
    rdfs:label "reconciliation external candidate version set digest";
    rdfs:range xsd:string.
fin-portfolio:reconciliationExternalSnapshotManifestDigest a owl:DatatypeProperty;
    rdfs:comment "Reconciliation External Snapshot Manifest Digest, is a hash digest of the terminal external full-snapshot response manifest, used for detecting changes to the response manifest.";
    rdfs:label "reconciliation external snapshot manifest digest";
    rdfs:range xsd:string.
fin-portfolio:reconciliationExternalSnapshotManifestRef a owl:DatatypeProperty;
    rdfs:comment "Reconciliation External Snapshot Manifest Reference, is an immutable reference to the terminal complete-response manifest supplied under the external source contract, used for fixing the external response evidence.";
    rdfs:label "reconciliation external snapshot manifest reference";
    rdfs:range xsd:anyURI.
fin-portfolio:reconciliationExternalSourceScopeRef a owl:DatatypeProperty;
    rdfs:comment "Reconciliation External Source Scope Reference, is an immutable reference to the external observation stream or source namespace whose candidates are closed, used for fixing the external source scope.";
    rdfs:label "reconciliation external source scope reference";
    rdfs:range xsd:anyURI.
fin-portfolio:reconciliationQueryDefinitionDigest a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Query Definition Digest, is a hash digest of the exact candidate-selection query definition, used for detecting changes to the query definition.";
    rdfs:label "reconciliation query definition digest";
    rdfs:range xsd:string.
fin-portfolio:reconciliationQueryDefinitionRef a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Query Definition Reference, is an immutable reference to the exact family, scope, source, and three-axis PIT candidate-selection definition, used for fixing the selection query.";
    rdfs:label "reconciliation query definition reference";
    rdfs:range xsd:anyURI.
fin-portfolio:reconciliationQueryToolLockDigest a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Query Tool Lock Digest, is a hash digest of the candidate-selection implementation and dependency lock, used for detecting changes to the tool lock.";
    rdfs:label "reconciliation query tool lock digest";
    rdfs:range xsd:string.
fin-portfolio:reconciliationQueryToolLockRef a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Query Tool Lock Reference, is an immutable reference to the implementation and dependency lock used to execute the candidate-selection query, used for fixing the query tool.";
    rdfs:label "reconciliation query tool lock reference";
    rdfs:range xsd:anyURI.
fin-portfolio:reconciliationSubjectDigest a owl:DatatypeProperty;
    rdfs:comment "Reconciliation Subject Digest, is a digest of the exact kind-discriminated versions compared, used for uniquely identifying the reconciliation subject.";
    rdfs:label "reconciliation subject digest";
    rdfs:range xsd:string.
fin-portfolio:remainingCostBasis a owl:ObjectProperty;
    rdfs:comment "Remaining Cost Basis, is a Money basis remaining after all exact consumption allocations, used for recording the current cost of a lot.";
    rdfs:label "remaining cost basis";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:resolutionEvidence a owl:DatatypeProperty;
    rdfs:comment "Resolution Evidence Reference, is an immutable reference to the evidence supporting a ReconciliationResolution, used for proving the disposition.";
    rdfs:label "resolution evidence reference";
    rdfs:range xsd:anyURI.
fin-portfolio:resolutionKind a owl:ObjectProperty;
    rdfs:comment "Resolution Kind, is an attribute marking the disposition of a ReconciliationResolution (accepted, investigated, corrected, waived, escalated), used for recording the outcome of a break disposition.";
    rdfs:label "resolution kind";
    rdfs:range fin-portfolio:ResolutionKind.
fin-portfolio:resolutionNote a owl:DatatypeProperty;
    rdfs:comment "Resolution Note, is an optional free-text note recording the rationale of a ReconciliationResolution, used for auditability.";
    rdfs:label "resolution note";
    rdfs:range xsd:string.
fin-portfolio:roundingPolicyDigest a owl:DatatypeProperty;
    rdfs:comment "Rounding Policy Digest, is a hash digest of the exact rounding mode, scale, and stage policy, used for detecting changes to the rounding specification.";
    rdfs:label "rounding policy digest";
    rdfs:range xsd:string.
fin-portfolio:roundingPolicyRef a owl:DatatypeProperty;
    rdfs:comment "Rounding Policy Reference, is an immutable reference to the exact rounding mode, scale, and stage policy, used for fixing the rounding specification.";
    rdfs:label "rounding policy reference";
    rdfs:range xsd:anyURI.
fin-portfolio:runtimeDigest a owl:DatatypeProperty;
    rdfs:comment "Runtime Digest, is a hash digest of the calculation runtime environment, used for locking the execution environment.";
    rdfs:label "runtime digest";
    rdfs:range xsd:string.
fin-portfolio:sleeveId a owl:DatatypeProperty;
    rdfs:comment "Sleeve Identifier, is a stable identifier of a Sleeve within the portfolio scope, used for uniquely marking a management subdivision.";
    rdfs:label "sleeve identifier";
    rdfs:range xsd:string.
fin-portfolio:sleeveName a owl:DatatypeProperty;
    rdfs:comment "Sleeve Name, is an optional human-readable display name of a Sleeve, used for display and retrieval.";
    rdfs:label "sleeve name";
    rdfs:range xsd:string.
fin-portfolio:snapshotId a owl:DatatypeProperty;
    rdfs:comment "Snapshot Identifier, is a stable identifier of a holding or position snapshot within the source scope, used for uniquely marking a single snapshot.";
    rdfs:label "snapshot identifier";
    rdfs:range xsd:string.
fin-portfolio:snapshotPivotRef a owl:DatatypeProperty;
    rdfs:comment "Snapshot Pivot Reference, is an immutable reference to the exact three-axis snapshot pivot, used for fixing the PIT basis of a state closure.";
    rdfs:label "snapshot pivot reference";
    rdfs:range xsd:anyURI.
fin-portfolio:specificSelectionCount a owl:DatatypeProperty;
    rdfs:comment "Specific Selection Count, is the cardinality of the exact specific-identification selected-lot set, used for verifying the count of the selected set.";
    rdfs:label "specific selection count";
    rdfs:range xsd:integer.
fin-portfolio:specificSelectionDigest a owl:DatatypeProperty;
    rdfs:comment "Specific Selection Digest, is a hash digest of reviewed specific-identification instructions, used for detecting changes to the instructions.";
    rdfs:label "specific selection digest";
    rdfs:range xsd:string.
fin-portfolio:specificSelectionRef a owl:DatatypeProperty;
    rdfs:comment "Specific Selection Reference, is an immutable reference to reviewed specific-identification instructions, used for supporting the explicit designation of consumed lots.";
    rdfs:label "specific selection reference";
    rdfs:range xsd:anyURI.
fin-portfolio:specificSelectionVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "Specific Selection Version Set Digest, is a digest of the exact PositionLot versions selected by specific-identification evidence, used for verifying the completeness of the selected set.";
    rdfs:label "specific selection version set digest";
    rdfs:range xsd:string.
fin-portfolio:stateAllocationClosureProbeDigest a owl:DatatypeProperty;
    rdfs:comment "State Allocation Closure Probe Digest, is a hash digest of the completed lot-allocation closure probe, used for detecting changes to the probe record.";
    rdfs:label "state allocation closure probe digest";
    rdfs:range xsd:string.
fin-portfolio:stateAllocationClosureProbeRef a owl:DatatypeProperty;
    rdfs:comment "State Allocation Closure Probe Reference, is an immutable reference to the completed lot-allocation completeness probe, used for proving the allocation set has no omissions.";
    rdfs:label "state allocation closure probe reference";
    rdfs:range xsd:anyURI.
fin-portfolio:stateAllocationVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "State Allocation Version Set Digest, is a digest of all allocation exact versions used by a lot-state closure, used for verifying the completeness of the allocation set.";
    rdfs:label "state allocation version set digest";
    rdfs:range xsd:string.
fin-portfolio:stateExecutionClosureVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "State Execution Closure Version Set Digest, is a digest of all execution allocation closure exact versions used by lot state, used for verifying the completeness of the closure set.";
    rdfs:label "state execution closure version set digest";
    rdfs:range xsd:string.
fin-portfolio:statementPeriodRef a owl:DatatypeProperty;
    rdfs:comment "Statement Period Reference, is an optional reference to the statement or reporting period a snapshot belongs to, used for grouping snapshots by period in custody and accounting views.";
    rdfs:label "statement period reference";
    rdfs:range xsd:anyURI.
fin-portfolio:toolLockDigest a owl:DatatypeProperty;
    rdfs:comment "Tool Lock Digest, is a hash digest of the exact calculation tool lock bytes, used for detecting changes to the tool lock.";
    rdfs:label "tool lock digest";
    rdfs:range xsd:string.
fin-portfolio:toolLockRef a owl:DatatypeProperty;
    rdfs:comment "Tool Lock Reference, is an immutable reference to the exact calculation tool lock, used for fixing the execution tool version.";
    rdfs:label "tool lock reference";
    rdfs:range xsd:anyURI.
fin-portfolio:totalMarketValue a owl:ObjectProperty;
    rdfs:comment "Total Market Value, is the Money aggregate of all valuation lines in a portfolio valuation summary, used for the coverage closure total.";
    rdfs:label "total market value";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:unrealizedPnl a owl:ObjectProperty;
    rdfs:comment "Unrealized PnL, is a Money difference between the exact market value and the remaining cost basis, used for recording the floating profit and loss of an open position.";
    rdfs:label "unrealized PnL";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-portfolio:valuationDefinitionAuthority a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Valuation Definition Authority, is a relationship to the logical Party whose namespace governs the stable valuation definition identifier, used for fixing the namespace attribution of the definition.";
    rdfs:domain fin-portfolio:ValuationCalculationDefinition;
    rdfs:label "valuation definition authority";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
fin-portfolio:valuationDefinitionId a owl:DatatypeProperty;
    rdfs:comment "Valuation Definition Identifier, is a stable identifier of a valuation definition within the authority namespace, used for uniquely marking a single valuation specification.";
    rdfs:label "valuation definition identifier";
    rdfs:range xsd:string.
fin-portfolio:valuationDefinitionMethodFamily a owl:FunctionalProperty, owl:ObjectProperty;
    rdfs:comment "Valuation Definition Method Family, is a relationship from a valuation definition to its concrete ValuationMethodFamily profile, used for binding the previously global hard-locked direct-unit method to a profile so other profiles may coexist.";
    rdfs:domain fin-portfolio:ValuationCalculationDefinition;
    rdfs:label "valuation definition method family";
    rdfs:range fin-portfolio:ValuationMethodFamily.
fin-portfolio:valuationDefinitionQuotationContract a owl:ObjectProperty;
    rdfs:comment "Valuation Definition Quotation Contract, is a relationship from a valuation definition to every member of its closed exact-version direct-unit quotation input set, used for locking the valuation input collection.";
    rdfs:domain fin-portfolio:ValuationCalculationDefinition;
    rdfs:label "valuation definition quotation contract";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/DirectUnitPriceQuotationContract>.
fin-portfolio:valuationFinality a owl:ObjectProperty;
    rdfs:comment "Valuation Finality, is an optional attribute marking whether a valuation line is preliminary or final, used for staged valuation runs.";
    rdfs:label "valuation finality";
    rdfs:range fin-portfolio:ValuationFinality.
fin-portfolio:valuationMethod a owl:ObjectProperty;
    rdfs:comment "Valuation Method, is the sole reviewed method stored on a valuation definition, used for fixing the calculation convention of the valuation.";
    rdfs:label "valuation method";
    rdfs:range fin-portfolio:ValuationMethod.
fin-portfolio:valuationMethodFamilyId a owl:DatatypeProperty;
    rdfs:comment "Valuation Method Family Identifier, is a stable logical-identity identifier of a ValuationMethodFamily profile, used so that an abstract family may be referenced by a logical reference.";
    rdfs:label "valuation method family identifier";
    rdfs:range xsd:string.
fin-portfolio:valuationQuotationContractCount a owl:DatatypeProperty;
    rdfs:comment "Valuation Quotation Contract Count, is the exact number of quotation-contract versions in the valuation definition input closure, used for verifying the count of the input set.";
    rdfs:label "valuation quotation contract count";
    rdfs:range xsd:integer.
fin-portfolio:valuationQuotationContractVersionSetDigest a owl:DatatypeProperty;
    rdfs:comment "Valuation Quotation Contract Version Set Digest, is a digest over all exact quotation-contract versions in the valuation definition input closure, used for verifying the completeness of the input set.";
    rdfs:label "valuation quotation contract version-set digest";
    rdfs:range xsd:string.
fin-portfolio:valuationRunId a owl:DatatypeProperty;
    rdfs:comment "Valuation Run Identifier, is a stable identifier of a PortfolioValuation run header, used for uniquely marking a single valuation run.";
    rdfs:label "valuation run identifier";
    rdfs:range xsd:string.
fin-portfolio:valuationSubjectKind a owl:DatatypeProperty;
    rdfs:comment "Valuation Subject Kind, is an optional attribute marking what a valuation line values (holding, position, lot, cash, accrued), used for distinguishing valuation subjects in the coverage closure.";
    rdfs:label "valuation subject kind";
    rdfs:range xsd:string.
