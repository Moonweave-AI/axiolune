    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-structure:TradingFacility a owl:Class;
    rdfs:comment "Trading Facility, is an identifiable market facility concept that provides a common reference range for an operating trading venue or one of its market segments, used as the base class for venue identity in the market-structure ontology.";
    rdfs:label "Trading Facility";
    rdfs:subClassOf _:r_217954382ed58e200f6c7d9f, _:r_697f9b2892d1a438391a97cb, fin-market-structure:MICIdentifiedMarketInfrastructure, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
