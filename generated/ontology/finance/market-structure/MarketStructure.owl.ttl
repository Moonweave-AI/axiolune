<https://axiolune.ai/ontology/finance/market-structure/MICEntryType/value/OPRT> a owl:NamedIndividual, skos:Concept, fin-market-structure:MICEntryType;
    rdfs:comment "registry entry that identifies an operating-level MICIdentifiedMarketInfrastructure, which may be a TradingVenue or a TradeReportingFacility";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/MICEntryType/scheme>;
    skos:notation "OPRT";
    skos:prefLabel "Operating MIC";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/MICEntryType/value/SGMT> a owl:NamedIndividual, skos:Concept, fin-market-structure:MICEntryType;
    rdfs:comment "registry entry that identifies a MarketSegment (a section of a TradingVenue or a TradeReportingFacility) and refers to its operating MIC entry";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/MICEntryType/scheme>;
