    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-structure:TradingCalendarException a owl:Class;
    rdfs:comment "Trading Calendar Exception, is a timestamped exception fact, used to deterministically close or adjust one exact session occurrence without mutating its session template, characterizing holidays, temporary closures, or early and late session openings and closings.";
    rdfs:label "Trading Calendar Exception";
    rdfs:subClassOf _:r_06fd56af7ca8c9ee44c21f43, _:r_0fcf5520f461ea37288fba24, _:r_399cbdf970f507f01664046a, _:r_4ce701181d046e26ab027274, _:r_5c3a9913eb1b6530b014c1f7, _:r_8ad46b89aa9b507ed86a0c0b, _:r_92801014fe4bb8a7a9459a13, _:r_9a0d2b833be25710ddb46b77, _:r_b13d24261f99c7848861c472, _:r_b454cef4151b1b43f7d9ddbf, _:r_ce3a699c8e5a51ed2a82a055, _:r_e43c86838135b83197d13192, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
