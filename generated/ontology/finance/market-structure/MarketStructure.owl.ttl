    rdfs:label "Trading Schedule Override Notice logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/role/overrideAppliesToOccurrence> a owl:ObjectProperty;
    rdfs:comment "one or more exact TradingSessionOccurrence versions affected by the notice";
    rdfs:domain fin-market-structure:TradingScheduleOverrideNotice;
    rdfs:label "overridden occurrence";
    rdfs:range fin-market-structure:TradingSessionOccurrence.
<https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/role/overrideForCalendar> a owl:ObjectProperty;
    rdfs:comment "exact TradingCalendar version under which the override applies";
    rdfs:domain fin-market-structure:TradingScheduleOverrideNotice;
    rdfs:label "override calendar";
