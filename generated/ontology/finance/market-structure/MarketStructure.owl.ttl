    rdfs:comment "Market Structure, is a domain module in ontology engineering that defines market infrastructure identified by MIC, trading venues and their operating entities, trading sessions, trading calendars, and pre-announced schedule overrides, used to provide typed definitions for the stable organizational structure and temporal scheduling of trading. It does not carry one-off venue rules, tickers, real-time market status, OTC counterparty pairs, or provider source contracts, which belong to market-rules, instruments, market-data, orders-execution, or Layer 4 respectively.";
    rdfs:label "Market Structure";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/market-structure/1.1.0>.
fin-market-structure:CalendarExceptionKind a owl:Class;
    rdfs:comment "Calendar Exception Kind, is a closed classification controlled vocabulary of deterministic changes to scheduled session occurrences, used to provide a standard enumeration of holidays, closures, early and late opens and closes, extra sessions, and segmented interruptions and resumptions for calendar exceptions and schedule override notices.";
    rdfs:label "Calendar Exception Kind";
    owl:oneOf _:l_27cffa35654b1299995209db_0.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme> a skos:ConceptScheme;
    skos:prefLabel "Calendar Exception Kind";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/closure> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "calendar exception that removes the affected session occurrence for a non-holiday closure";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "closure";
    skos:prefLabel "Closure";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/earlyClose> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "calendar exception that shortens an occurrence by replacing its exclusive end instant with an earlier instant";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "earlyClose";
    skos:prefLabel "Early Close";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/earlyOpen> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "calendar exception that advances an occurrence by replacing its inclusive start instant with an earlier instant";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "earlyOpen";
    skos:prefLabel "Early Open";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/earlySession> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "legacy alias for earlyClose; retained for compatibility, replaced by earlyClose";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "earlySession";
    skos:prefLabel "Early Session (deprecated)";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/extraSession> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "calendar exception that adds a session occurrence not present in the template schedule";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "extraSession";
    skos:prefLabel "Extra Session";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/holiday> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "calendar exception that removes the affected session occurrence for a recognized holiday";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "holiday";
    skos:prefLabel "Holiday";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/lateClose> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "calendar exception that extends an occurrence by replacing its exclusive end instant with a later instant";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "lateClose";
    skos:prefLabel "Late Close";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/lateOpen> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "calendar exception that delays an occurrence by replacing its inclusive start instant with a later instant";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "lateOpen";
    skos:prefLabel "Late Open";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/lateSession> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "legacy alias for lateOpen; retained for compatibility, replaced by lateOpen";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "lateSession";
    skos:prefLabel "Late Session (deprecated)";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/segmentedInterrupt> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "calendar exception that interrupts a session occurrence for a sub-interval, used with a matching segmentedResume to model a trading halt within the session";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "segmentedInterrupt";
    skos:prefLabel "Segmented Interrupt";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/value/segmentedResume> a owl:NamedIndividual, skos:Concept, fin-market-structure:CalendarExceptionKind;
    rdfs:comment "calendar exception that resumes a previously interrupted session occurrence after a matching segmentedInterrupt";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/CalendarExceptionKind/scheme>;
    skos:notation "segmentedResume";
    skos:prefLabel "Segmented Resume";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-market-structure:DstOverlapPolicy a owl:Class;
    rdfs:comment "DST Overlap Policy, is a closed controlled vocabulary of the interpretation policy for local-clock instants that fall inside a DST gap or fold, used to make local-to-UTC materialization deterministic.";
    rdfs:label "DST Overlap Policy";
    owl:oneOf _:l_c4870cd055e54eecbc173e56_0.
<https://axiolune.ai/ontology/finance/market-structure/DstOverlapPolicy/scheme> a skos:ConceptScheme;
    skos:prefLabel "DST Overlap Policy";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/DstOverlapPolicy/value/earlierTime> a owl:NamedIndividual, skos:Concept, fin-market-structure:DstOverlapPolicy;
    rdfs:comment "ambiguous local instant is interpreted as the earlier of the two UTC instants";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/DstOverlapPolicy/scheme>;
    skos:notation "earlierTime";
    skos:prefLabel "Earlier Time";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/DstOverlapPolicy/value/invalid> a owl:NamedIndividual, skos:Concept, fin-market-structure:DstOverlapPolicy;
    rdfs:comment "local instant inside a DST gap is invalid and rejected";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/DstOverlapPolicy/scheme>;
    skos:notation "invalid";
    skos:prefLabel "Invalid";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-structure/DstOverlapPolicy/value/laterTime> a owl:NamedIndividual, skos:Concept, fin-market-structure:DstOverlapPolicy;
    rdfs:comment "ambiguous local instant is interpreted as the later of the two UTC instants";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/DstOverlapPolicy/scheme>;
    skos:notation "laterTime";
    skos:prefLabel "Later Time";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-market-structure:JurisdictionCalendarBinding a owl:Class;
    rdfs:comment "Jurisdiction Calendar Binding, is an explicit temporal binding between one logical Jurisdiction identity and one exact TradingCalendar version, used to materialize the relationship between a calendar and its governing jurisdiction to support audit and mapping slices.";
    rdfs:label "Jurisdiction Calendar Binding";
    rdfs:subClassOf _:r_4547b2f34dc138a340607f57, _:r_c2d7e18e1dbad2851cbea5fd, _:r_d1d499648556232094eff3b1, _:r_e3c52c77601b2e49abd1f859, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-structure/JurisdictionCalendarBinding/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Jurisdiction Calendar Binding versions.";
    rdfs:label "Jurisdiction Calendar Binding logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/market-structure/JurisdictionCalendarBinding/role/bindingCalendar> a owl:ObjectProperty;
    rdfs:comment "exact TradingCalendar version bound to the jurisdiction";
    rdfs:domain fin-market-structure:JurisdictionCalendarBinding;
    rdfs:label "binding calendar";
    rdfs:range fin-market-structure:TradingCalendar.
<https://axiolune.ai/ontology/finance/market-structure/JurisdictionCalendarBinding/role/bindingJurisdiction> a owl:ObjectProperty;
    rdfs:comment "logical Jurisdiction identity governed by the calendar";
    rdfs:domain fin-market-structure:JurisdictionCalendarBinding;
    rdfs:label "binding jurisdiction";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Jurisdiction>.
