    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-market-structure:MarketInfrastructureComponent a owl:Class;
    rdfs:comment "Market Infrastructure Component, is the abstract base class for a section or component of an operating market infrastructure entity, used to model the ISO 10383 \"section\" semantics (a part of a market, exchange, or reporting facility) as a component rather than as an independent facility, while allowing concrete components to share a facility supertype for reference range where useful.";
    rdfs:label "Market Infrastructure Component";
    rdfs:subClassOf _:r_2dd945b15a37c08806720517, _:r_3265089416c6358c373b7b94, _:r_44c87fa6cb72d8e3a6e8a01a, _:r_5dcef555462d6116237651d5, <https://axiolune.ai/ontology/finance/foundation/IdentifiableSubject>, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-structure/MarketInfrastructureComponent/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Market Infrastructure Component versions.";
    rdfs:label "Market Infrastructure Component logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-structure:MarketSegment a owl:Class;
    rdfs:comment "Market Segment, is a section or component of an operating market infrastructure entity (a trading venue or a trade reporting facility), modeled as a TradingFacility subtype for shared reference range but carrying its part-of semantics through the componentOf relation, used to characterize a subdomain divided by instrument type, regulation, or reporting section within the parent entity. The MarketSegment is a section, not an independent facility; it belongs to exactly one operating entity identified by the segment's marketSegmentVenue or componentOf relation.";
    rdfs:label "Market Segment";
    rdfs:subClassOf _:r_02e8a6749c88a36248bc8de1, _:r_1761704a1c4ea47b83bac292, _:r_887e8eb3bb43a014fce851c9, fin-market-structure:MarketInfrastructureComponent, fin-market-structure:TradingFacility, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-structure/MarketSegment/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Market Segment versions.";
    rdfs:label "Market Segment logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-structure:NonVenueMarketContext a owl:Class;
    rdfs:comment "Non-Venue Market Context, is a stable non-venue market context that characterizes the market-convention orientation of over-the-counter quoting without carrying provider source contracts, concrete currencies, counterparty pairs, or execution/reporting semantics, used to express only the stable structure that belongs in market-structure. Its logical identity is determined by the non-venue context identity and its market-convention orientation; provider attribution is a logical reference to a Party. Provider contract and source mapping belong to Layer 4, currencies and quotation convention to instruments, and counterparty/execution/reporting to orders-execution or post-trade-operations.";
    rdfs:label "Non-Venue Market Context";
    rdfs:subClassOf _:r_02763249dbfe71215f91e78c, _:r_04687476ae8f8e92c386d542, _:r_1bb37e7ffd24606413df2787, _:r_21e077286819df083488635f, _:r_669342614bc2e362b5249fa2, _:r_686f851584747dc795f61811, _:r_b0fee9e36fc23555e343af3a, _:r_b6f1eea2dd124e7281584297, _:r_c93fa3148f18ba69729f3c3b, _:r_e4522a442776a77687a30be9, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/market-structure/NonVenueMarketContext/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Non-Venue Market Context versions.";
    rdfs:label "Non-Venue Market Context logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-structure:OTCTradingContext a owl:Class;
    rdfs:comment "OTC Trading Context, is a non-listing trading context whose logical identity is determined by the source-provider logical IRI, the immutable source-contract IRI, and a provider-scoped context identifier, used to characterize the market-convention environment for over-the-counter quotes and executions. This type is deprecated as of v1.1.0 because it mixes provider source contract, quote/settlement currency, reporting facility, concrete counterparty pair, and execution semantics that are not stable market structure; it is replaced by NonVenueMarketContext for the stable non-venue structure, while the provider contract moves to Layer 4, currencies/convention to instruments, and counterparty/execution/reporting to orders-execution or post-trade-operations. The type is retained for IRI stability because market-data, instruments, and orders-execution reference it as an association range; its cross-module migration is deferred to a follow-up ADR.";
    rdfs:label "OTC Trading Context";
    rdfs:subClassOf _:r_032337a7bd0e91527fca9646, _:r_20030bd146f1520bf93997ef, _:r_41e3f7d04829064d50335a46, _:r_42e60b567651bc70a4ea9a71, _:r_44d23524e44a6322563febc8, _:r_76d35082d40c225a4bdfb9cb, _:r_78b29a958d63018993d270c2, _:r_7a9440012fb209f1b1506383, _:r_8ad8a440c05649043942987b, _:r_8c33f50b521b52f48bb2c72c, _:r_96d2efe003de74c69fbb39c9, _:r_bb4ccb82d9ab3f68a112c937, _:r_bc20c26c137e760cb37d6e72, _:r_bcc38949c819eddf958c313d, _:r_c9f0b2ddc992056a7b757690, _:r_d4773d559466b0d31d47ec92, _:r_ea31793512babe4dc2373c34, _:r_ef745027af8265cd2975d6af, _:r_f2b500c6f2c467747eae141d, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
