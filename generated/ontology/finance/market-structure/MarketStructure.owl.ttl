    rdfs:comment "Stable FactIdentity companion for immutable MIC Registry Entry versions.";
    rdfs:label "MIC Registry Entry logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-structure:MarketConvention a owl:Class;
    rdfs:comment "Market Convention, is a closed convention classification controlled vocabulary, used to orient direct quote-per-unit OTC contexts and provide a standard enumeration of over-the-counter quoting methods.";
    rdfs:label "Market Convention";
    owl:oneOf _:l_3a77ed4880d2b6e1fac7f97f_0.
<https://axiolune.ai/ontology/finance/market-structure/MarketConvention/scheme> a skos:ConceptScheme;
