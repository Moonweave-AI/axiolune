fin-market-structure:TradeReportingFacility a owl:Class;
    rdfs:comment "Trade Reporting Facility, is a market infrastructure entity to which trade reports are made but which does not itself operate a trading market, used to identify an approved publication arrangement, approved reporting mechanism, trade reporting facility, or comparable non-trading reporting infrastructure that an ISO 10383 Operating MIC may identify.";
    rdfs:label "Trade Reporting Facility";
    rdfs:subClassOf _:r_d42eccf46a62d50a01ce90c5, _:r_da9417f88a211f5b3722ce5b, fin-market-structure:MICIdentifiedMarketInfrastructure, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
