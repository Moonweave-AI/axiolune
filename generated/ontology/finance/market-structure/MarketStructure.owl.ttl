fin-market-structure:MICRegistryEntry a owl:Class;
    rdfs:comment "MIC Registry Entry, is a timestamped minimal MIC identity slice that binds a four-character MIC value and its entry kind to the exact market infrastructure version identified by that registry record, used to anchor the registration record to the underlying facility version. The entry carries optional ISO 10383 lifecycle fields (operational status, effective/expiry dates, replacement, market category) when available; it is an identity anchor, not a full ISO 10383 registry mirror.";
    rdfs:label "MIC Registry Entry";
    rdfs:subClassOf _:r_1a095df43aa2d0028da70407, _:r_1d934cf51c61bd007742fb68, _:r_5edd0e64f59fe6583094d8da, _:r_79bde2039365e89e8f42fd41, _:r_7acfb0586d3f590434f90bf2, _:r_824f2b7c50d6c706e314c64d, _:r_8f8520efcbe8f4d718f7b4fa, _:r_97e238c844eaba91b4d553d9, _:r_99d7cb441761adc4cd530fac, _:r_b276aa9b60db2f5fe9ce00d6, _:r_b3b87d754d69bd620c472e61, _:r_b425530c6d6d16497098c9f5, _:r_bff91a9ad3278e15f52013db, _:r_c8e8a9322f4e8ac317bd3869, _:r_ca2b9147b767065e09824282, _:r_d1e2f292db2117749b23dbc1, _:r_d2acbb2e5635ddc265db8b0f, _:r_db54a11232952a70f336a49b, _:r_ec60aac97ffc4a4231893af1, _:r_f2299f593ea4eb6b35b02c27, _:r_ff7f40645548741317e2f374, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
