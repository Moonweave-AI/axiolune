    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-structure:TradingCalendar a owl:Class;
    rdfs:comment "Trading Calendar, is an immutable calendar version maintained by an authority for one trading facility, jurisdiction, and IANA time zone, used to characterize the trading-day and non-trading-day arrangements of that facility under a specific time zone. It is the concrete specialization of the foundation BusinessCalendar interface for a trading facility and pins an optional IANA tzdb release together with a DST overlap policy for deterministic local-to-UTC materialization.";
    rdfs:label "Trading Calendar";
    rdfs:subClassOf _:r_02d9d59cefa266c97d962351, _:r_0d17538abe11d1798738bddc, _:r_2a68c0d9ef812f2d41cff4f0, _:r_30150ba027dd93ac06a97f3e, _:r_3fc8743c15a590fcd07b40ca, _:r_67ee0458f6fe18caa9467a59, _:r_72974fa4c2ed2b16d96b8af5, _:r_76c5ea7314bdd66306afd6e2, _:r_baaaa7cae59b8d024494b61a, _:r_be0f345c1c2e58cadd14084a, _:r_c9576f8c43df113d2ef09ac0, _:r_cd4006d935ae23d07b321b1c, _:r_d444dfff39edb84d9139d5fe, _:r_df9fedd8895045616e6f2d9d, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
