    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-structure:TradingScheduleOverrideNotice a owl:Class;
    rdfs:comment "Trading Schedule Override Notice, is a temporal provenance-bearing n-ary association that records one pre-announced schedule override applying to one or more exact TradingSessionOccurrence versions under one exact calendar and one exact facility, carrying an announcement order and a supersession order together with an optional replacement interval, used to separate the planned schedule from real-time status and to deterministically synthesize a single final effective interval or cancellation across multiple affected sessions.";
    rdfs:label "Trading Schedule Override Notice";
    rdfs:subClassOf _:r_0d5cf8e4688054d41da37043, _:r_1e1836250d43f0b42d8b068e, _:r_24f9dc11ef938985b8c9876f, _:r_31937572a273a6dc820e23dc, _:r_41d98a3faff21ce3ff7de98f, _:r_4215b45396ff8cdd56cbc167, _:r_565c0a4a8223f28265a29b64, _:r_6ddd45293aec05dfc780e879, _:r_8a8852d1ae4d79c6ae67f4ab, _:r_8acb343f0ba059d64e008a03, _:r_97e77b426a9b427a0afdd3da, _:r_af4d0ee1913233548e211c48, _:r_da0a52f1f7ee1e2750f84689, _:r_f1fb09a3377da8f82e2e5d70, _:r_fb09c7fd74508d8c72f60789, _:r_fed5db8bf02d46c4a8189067, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
