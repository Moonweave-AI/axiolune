fin-market-structure:MICIdentifiedMarketInfrastructure a owl:Class;
    rdfs:comment "MIC-Identified Market Infrastructure, is the abstract base class for any operating or reporting market infrastructure entity identifiable by an ISO 10383 Market Identifier Code, used to broaden the MIC target taxonomy beyond trading venues to include trade reporting facilities, approved publication arrangements, approved reporting mechanisms, and similar infrastructure while preserving a common reference range.";
    rdfs:label "MIC-Identified Market Infrastructure";
    rdfs:subClassOf _:r_d3df221c94dec65ce7a50191, _:r_fa2e0ea25e551649099796ee, <https://axiolune.ai/ontology/finance/foundation/IdentifiableSubject>, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
