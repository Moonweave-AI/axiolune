    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-market-structure:ScheduledTradingPhase a owl:Class;
    rdfs:comment "Scheduled Trading Phase, is a closed controlled vocabulary of the scheduled phases of a trading session, used to distinguish pre-open, opening auction, continuous trading, closing auction, post-close, maintenance, and reporting-only phases.";
    rdfs:label "Scheduled Trading Phase";
    owl:oneOf _:l_be674e7eec8498a8bb5ce23f_0.
