fin-market-structure:MICMarketCategory a owl:Class;
    rdfs:comment "MIC Market Category, is a closed controlled vocabulary of the ISO 10383 market category of the infrastructure identified by a MIC registry entry, used to record whether the identified infrastructure operates a trading market, reports trades, or performs another market function.";
    rdfs:label "MIC Market Category";
    owl:oneOf _:l_12f4596bf02f7c1f757f9e17_0.
