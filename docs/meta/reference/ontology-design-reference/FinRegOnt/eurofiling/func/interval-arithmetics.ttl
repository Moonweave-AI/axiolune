  composite:child [
      rdf:type sxml:Comment ;
      sxml:text "Funcion: \"iaf:multiply-two-elements\" => A partir de dos elementos, devuelve el par resultante de multiplicar el valor del primero por el segundo, y el mayor umbral posible resultado de la operacion."^^xsd:string ;
      composite:index "63"^^xsd:int ;
    ] ;
  composite:child [
