iaf:r-1-60-0
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#input> ;
  iaf:name-cfiinput "sequence" ;
  composite:index "0"^^xsd:int ;
.
iaf:r-1-60-1
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#input> ;
  iaf:name-cfiinput "count" ;
  composite:index "1"^^xsd:int ;
.
iaf:r-1-60-2
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#input> ;
  iaf:name-cfiinput "subtotalParam" ;
  composite:index "2"^^xsd:int ;
.
iaf:r-1-60-3
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "facts" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text """if (empty($sequence)) then (0) else
    one-or-more($sequence)"""^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "3"^^xsd:int ;
.
iaf:r-1-60-4
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "numberOfParams" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "count($facts)"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "4"^^xsd:int ;
.
iaf:r-1-60-5
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "subtotal" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "if ($count eq 1) then $facts[1] else $subtotalParam"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "5"^^xsd:int ;
.
iaf:r-1-60-6
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "multiply" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text """if($count lt $numberOfParams) then iaf:multiply-two-elements($subtotal,
    $facts[$count + 1]) else $subtotal"""^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "6"^^xsd:int ;
.
iaf:r-1-60-7
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "output" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text """if($count lt $numberOfParams) then iaf:multiply-recursive($sequence,
    ($count +1), $multiply) else $multiply"""^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "7"^^xsd:int ;
.
iaf:r-1-60-8
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#output> ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "$output"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "8"^^xsd:int ;
.
