  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#implementation> ;
  xlink:label-cfiimplementation "implementation_exp10" ;
  xlink:type-cfiimplementation "resource" ;
  composite:child iaf:r-1-88-0 ;
  composite:child iaf:r-1-88-1 ;
  composite:index "88"^^xsd:int ;
.
iaf:r-1-88-0
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#input> ;
  iaf:name-cfiinput "power" ;
  composite:index "0"^^xsd:int ;
.
iaf:r-1-88-1
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#output> ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "if ($power eq 0) then 1 else if ($power gt 0) then 10 * iaf-int:exp10($power - 1) else 1 div iaf-int:exp10(-$power)"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "1"^^xsd:int ;
.
