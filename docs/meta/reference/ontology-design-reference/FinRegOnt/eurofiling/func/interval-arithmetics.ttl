.
iaf:r-1-1-0
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#input> ;
  iaf:name-cfiinput "params" ;
  composite:index "0"^^xsd:int ;
.
iaf:r-1-1-1
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "facts" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "if (empty($params)) then (0) else one-or-more($params)"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "1"^^xsd:int ;
.
iaf:r-1-1-2
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "values" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "for $i in $facts return (iaf:splitValueThreshold($i)[1])"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "2"^^xsd:int ;
.
iaf:r-1-1-3
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "thresholds" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "for $i in $facts return (iaf:splitValueThreshold($i)[2])"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "3"^^xsd:int ;
.
iaf:r-1-1-4
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "sumValues" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "sum($values)"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "4"^^xsd:int ;
.
iaf:r-1-1-5
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "sumThresholds" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "sum($thresholds)"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "5"^^xsd:int ;
.
iaf:r-1-1-6
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "output" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "iaf:joinValueThreshold($sumValues, $sumThresholds)"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "6"^^xsd:int ;
.
iaf:r-1-1-7
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#output> ;
  composite:child [
      rdf:type sxml:TextNode ;
