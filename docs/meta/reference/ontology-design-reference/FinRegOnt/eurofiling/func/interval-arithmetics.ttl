  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#input> ;
  iaf:name-cfiinput "paramB" ;
  composite:index "1"^^xsd:int ;
.
iaf:r-1-84-2
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "valueA" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "iaf:splitValueThreshold($paramA)[1]"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "2"^^xsd:int ;
.
iaf:r-1-84-3
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "valueB" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "iaf:splitValueThreshold($paramB)[1]"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "3"^^xsd:int ;
.
iaf:r-1-84-4
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "thA" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "iaf:splitValueThreshold($paramA)[2]"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "4"^^xsd:int ;
.
iaf:r-1-84-5
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "thB" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "iaf:splitValueThreshold($paramB)[2]"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "5"^^xsd:int ;
.
iaf:r-1-84-6
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "absol" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "abs($valueA - $valueB)"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "6"^^xsd:int ;
.
iaf:r-1-84-7
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "sumTh" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "$thA + $thB"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "7"^^xsd:int ;
.
iaf:r-1-84-8
  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#output> ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "($valueA, $valueB, $thA, $thB, $absol, $sumTh)"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "8"^^xsd:int ;
.
