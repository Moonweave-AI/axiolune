  iaf:name-cfistep "item" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text "if (empty($input)) then 0 else $input"^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "1"^^xsd:int ;
