  rdf:type <http://finregont.com/fro/xbrl/formula/custom-function.ttl#step> ;
  iaf:name-cfistep "valorUmbral" ;
  composite:child [
      rdf:type sxml:TextNode ;
      sxml:text """if ($item instance of element() and empty($item[2])) then ($item,
    iaf-int:fact-threshold($item)) else (if (not($item instance of element()) and empty($item[2])
    and not(contains(string($item), \";\"))) then ($item, 0) else
    (xs:decimal(substring-before($item, \";\")), xs:decimal(substring-after($item, \";\"))))"""^^xsd:string ;
      composite:index "1"^^xsd:int ;
    ] ;
  composite:index "1"^^xsd:int ;
