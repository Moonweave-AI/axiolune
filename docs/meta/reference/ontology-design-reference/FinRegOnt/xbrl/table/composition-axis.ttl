# baseURI: http://finregont.com/fro/xbrl/table/composition-axis.ttl
# imports: http://finregont.com/fro/xbrl/generic/generic.ttl
# imports: http://finregont.com/fro/xbrl/table/table.ttl
# imports: http://topbraid.org/sxsd
# prefix: composition-axis

@prefix composite: <http://www.topbraid.org/2007/05/composite.owl#> .
@prefix composition-axis: <http://finregont.com/fro/xbrl/table/composition-axis.ttl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix sxsd: <http://topbraid.org/sxsd#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/table/composition-axis.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description "An RDF/OWL version of XBRL table composition-axis. The Table Linkbase provides a mechanism for taxonomy authors to define a tabular layout of facts. The resulting tables can be used for both presentation and data entry."^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL table composition XSD file (composition-axis.xsd). The source XSD is from the EIOPA Solvency taxonomy package. The schema may be depreciated, but we keep it for consitency with Eurofiling.  "^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  owl:imports <http://finregont.com/fro/xbrl/generic/generic.ttl> ;
  owl:imports <http://finregont.com/fro/xbrl/table/table.ttl> ;
  owl:imports <http://topbraid.org/sxsd> ;
.
composition-axis:Document
  rdf:type sxml:Document ;
  sxml:root composition-axis:r ;
.
composition-axis:id-element
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "id" ;
  rdfs:domain sxsd:Element ;
  rdfs:label "id" ;
.
composition-axis:r
  rdf:type sxsd:Schema ;
  composition-axis:xmlns-schema "http://www.w3.org/2001/XMLSchema" ;
  sxml:prefix "table"^^xsd:string ;
  sxsd:elementFormDefault "qualified" ;
  sxsd:targetNamespace "http://xbrl.org/2011/table" ;
  composite:child composition-axis:r-0 ;
.
composition-axis:r-0
  rdf:type sxsd:Element ;
  composition-axis:id-element "xml-composition-axis" ;
  sxsd:name "compositionAxis" ;
  sxsd:substitutionGroup "table:predefinedAxis" ;
  sxsd:type "table:predefinedAxis.type" ;
  composite:index "0"^^xsd:int ;
.
composition-axis:xmlns-schema
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "xmlns" ;
  rdfs:domain sxsd:Schema ;
  rdfs:label "xmlns" ;
.
