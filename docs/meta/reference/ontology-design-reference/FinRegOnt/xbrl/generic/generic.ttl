# baseURI: http://finregont.com/fro/xbrl/generic/generic.ttl
# imports: http://finregont.com/fro/xbrl/linkbase.ttl
# prefix: generic

@prefix dct: <http://purl.org/dc/terms/> .
@prefix generic: <http://finregont.com/fro/xbrl/generic/generic.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sxml: <http://topbraid.org/sxml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://finregont.com/fro/xbrl/generic/generic.ttl>
  rdf:type owl:Ontology ;
  dct:creator "Jurgen Ziemer (of this OWL adaptation - not the XBRL design)"^^xsd:string ;
  dct:description """An RDF/OWL version of the XBRL generic links schema. The XBRL specification aims to facilitate the creation of new kinds of metadata by providing additional concrete linking components, as well as guidance for the definition of custom linking components.
The ontology defines Generic Arc Type as a subclass of XLink Arc Type and Generic Links as a subclass of XLink Extended Type."""^^xsd:string ;
  dct:rights "Copyright  © 2002 XBRL International. All Rights Reserved. http://www.XBRL.org/legal/"^^xsd:string ;
  dct:rights "Jayzed Data Models Inc. (adaptation for RDF/OWL in this OWL file only)."^^xsd:string ;
  rdfs:comment "The ontology is a direct conversion of the XBRL generic XSD file (see owl:versionInfo). The purpose is bi-directional for RDF instance files that include an XBRL formula: To read XBRL data files into FinRegOnt and to create XBRL instance data files from the ontology."^^xsd:string ;
  rdfs:isDefinedBy <https://specifications.xbrl.org/specifications.html> ;
  rdfs:seeAlso <http://finregont.com/xbrl/> ;
  rdfs:seeAlso <http://www.xbrl.org/specification/gnl/rec-2009-06-22/gnl-rec-2009-06-22.html> ;
  owl:imports <http://finregont.com/fro/xbrl/linkbase.ttl> ;
  owl:versionInfo "Created with TopBraid Composer from the XML Schema(s) http://xbrl.org/2008/generic"^^xsd:string ;
.
generic:GenericArcType
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/generic#genericArcType" ;
  rdfs:label "Generic arc type"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#ArcType> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom xsd:ID ;
      owl:onProperty generic:id ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:maxCardinality "1"^^xsd:int ;
      owl:onProperty generic:id ;
    ] ;
.
generic:Link
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/generic#link" ;
  rdfs:label "Link"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Extended> ;
  rdfs:subClassOf generic:LinkTypeWithOpenAttrs ;
.
generic:LinkType
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/generic#linkType" ;
  rdfs:label "Link type"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#ExtendedType> ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "false"^^xsd:boolean ;
      sxml:order "0"^^xsd:int ;
      rdfs:comment """Concrete locator element.  The loc element is the 
      XLink locator element for all extended links in XBRL."""^^xsd:string ;
      owl:allValuesFrom <http://finregont.com/fro/xbrl/linkbase.ttl#loc> ;
      owl:onProperty generic:locRef ;
    ] ;
.
generic:LinkTypeWithOpenAttrs
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/generic#linkTypeWithOpenAttrs" ;
  rdfs:label "Link type with open attrs"^^xsd:string ;
  rdfs:subClassOf generic:LinkType ;
.
generic:arc
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/generic#arc" ;
  rdfs:label "Arc"^^xsd:string ;
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Arc> ;
  rdfs:subClassOf generic:GenericArcType ;
.
generic:id
  rdf:type owl:DatatypeProperty ;
  sxml:attribute "http://xbrl.org/2008/generic#id" ;
  rdfs:label "id"^^xsd:string ;
.
generic:locRef
  rdf:type owl:ObjectProperty ;
  sxml:tag "http://xbrl.org/2008/generic#loc" ;
  rdfs:label "loc ref"^^xsd:string ;
.
<http://finregont.com/fro/xbrl/linkbase.ttl#loc>
  rdfs:subClassOf <http://finregont.com/fro/xbrl/XLink.ttl#Locator> ;
.
