  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom xsd:boolean ;
      owl:onProperty variable:cover ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
