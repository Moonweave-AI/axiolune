variable:QNameDatatype
  rdf:type rdfs:Datatype ;
  rdfs:label "QName datatype"^^xsd:string ;
  rdfs:subClassOf xsd:Name ;
  owl:equivalentClass [
      rdf:type rdfs:Datatype ;
      owl:onDatatype xsd:Name ;
      owl:withRestrictions (
          [
            xsd:pattern "([^:]+:)?[^:]+"^^xsd:string ;
          ]
        ) ;
    ] ;
.
