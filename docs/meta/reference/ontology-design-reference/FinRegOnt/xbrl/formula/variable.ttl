      owl:onProperty variable:select ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom xsd:boolean ;
      owl:onProperty variable:bindAsSequence ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty variable:bindAsSequence ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty variable:select ;
    ] ;
.
<http://finregont.com/fro/xbrl/formula/variable.ttl#Naming.attribute.group>
  rdf:type owl:Class ;
  sxml:tag "http://xbrl.org/2008/variable#naming.attribute.group" ;
  rdfs:label "Naming.attribute.group"^^xsd:string ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      sxml:isAttribute "true"^^xsd:boolean ;
      owl:allValuesFrom variable:QNameDatatype ;
      owl:onProperty variable:name ;
    ] ;
  rdfs:subClassOf [
      rdf:type owl:Restriction ;
      owl:cardinality "1"^^xsd:int ;
      owl:onProperty variable:name ;
    ] ;
