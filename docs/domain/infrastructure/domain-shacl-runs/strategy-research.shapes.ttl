@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-strategy: <https://axiolune.ai/ontology/finance/strategy-research/>.

fin-strategy:SignalDirectionShape a sh:PropertyShape;
    sh:path fin-strategy:SignalDirection;
    sh:hasValue fin-strategy:SignalDirection_Long, fin-strategy:SignalDirection_Short, fin-strategy:SignalDirection_Neutral, fin-strategy:SignalDirection_Exit;
    sh:name "Signal Direction".
fin-strategy:FactorCategoryShape a sh:PropertyShape;
    sh:path fin-strategy:FactorCategory;
    sh:hasValue fin-strategy:FactorCategory_Fundamental, fin-strategy:FactorCategory_Technical, fin-strategy:FactorCategory_Alternative, fin-strategy:FactorCategory_Macro, fin-strategy:FactorCategory_Statistical, fin-strategy:FactorCategory_Sentiment;
    sh:name "Factor Category".
fin-strategy:BacktestStatusShape a sh:PropertyShape;
    sh:path fin-strategy:BacktestStatus;
    sh:hasValue fin-strategy:BacktestStatus_Pending, fin-strategy:BacktestStatus_Running, fin-strategy:BacktestStatus_Completed, fin-strategy:BacktestStatus_Failed, fin-strategy:BacktestStatus_Canceled;
    sh:name "Backtest Status".
fin-strategy:FactorDefinitionShape a sh:NodeShape;
    sh:targetClass fin-strategy:FactorDefinition;
    sh:name "Factor Definition";
    sh:description "specification of a quantitative factor including its calculation logic, input requirements, universe scope, and validity conditions";
    sh:property fin-strategy:FactorDefinitionShape_hasFactorName.
fin-strategy:FactorDefinitionShape_hasFactorName a sh:PropertyShape;
    sh:path fin-strategy:hasFactorName;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:FactorDefinitionShape sh:property fin-strategy:FactorDefinitionShape_hasFactorCategory.
fin-strategy:FactorDefinitionShape_hasFactorCategory a sh:PropertyShape;
    sh:path fin-strategy:hasFactorCategory;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:FactorDefinitionShape sh:property fin-strategy:FactorDefinitionShape_hasFactorFormula.
fin-strategy:FactorDefinitionShape_hasFactorFormula a sh:PropertyShape;
    sh:path fin-strategy:hasFactorFormula;
    sh:minCount 0;
    sh:maxCount 1.
fin-strategy:StrategyDefinitionShape a sh:NodeShape;
    sh:targetClass fin-strategy:StrategyDefinition;
    sh:name "Strategy Definition";
    sh:description "specification of a trading strategy including its logic, parameters, universe, risk controls, and execution rules";
    sh:property fin-strategy:StrategyDefinitionShape_hasStrategyName.
fin-strategy:StrategyDefinitionShape_hasStrategyName a sh:PropertyShape;
    sh:path fin-strategy:hasStrategyName;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:StrategyDefinitionShape sh:property fin-strategy:StrategyDefinitionShape_hasStrategyDescription.
fin-strategy:StrategyDefinitionShape_hasStrategyDescription a sh:PropertyShape;
    sh:path fin-strategy:hasStrategyDescription;
    sh:minCount 0;
    sh:maxCount 1.
fin-strategy:SignalShape a sh:NodeShape;
    sh:targetClass fin-strategy:Signal;
    sh:name "Signal";
    sh:description "point-in-time trading signal generated by a factor or strategy for a specific instrument with directional bias, strength, and validity period";
    sh:property fin-strategy:SignalShape_hasSignalDirection.
fin-strategy:SignalShape_hasSignalDirection a sh:PropertyShape;
    sh:path fin-strategy:hasSignalDirection;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_hasSignalStrength.
fin-strategy:SignalShape_hasSignalStrength a sh:PropertyShape;
    sh:path fin-strategy:hasSignalStrength;
    sh:minCount 0;
    sh:maxCount 1.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_generatedByFactor.
fin-strategy:SignalShape_generatedByFactor a sh:PropertyShape;
    sh:path fin-strategy:generatedByFactor;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-strategy:FactorDefinition.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_generatedByStrategy.
fin-strategy:SignalShape_generatedByStrategy a sh:PropertyShape;
    sh:path fin-strategy:generatedByStrategy;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-strategy:StrategyDefinition.
fin-strategy:SignalShape sh:property fin-strategy:SignalShape_signalForInstrument.
fin-strategy:SignalShape_signalForInstrument a sh:PropertyShape;
    sh:path fin-strategy:signalForInstrument;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-strategy:BacktestRunShape a sh:NodeShape;
    sh:targetClass fin-strategy:BacktestRun;
    sh:name "Backtest Run";
    sh:description "execution of a strategy definition over historical data with specified parameters, date range, initial capital, and resulting performance metrics";
    sh:property fin-strategy:BacktestRunShape_hasBacktestStatus.
fin-strategy:BacktestRunShape_hasBacktestStatus a sh:PropertyShape;
    sh:path fin-strategy:hasBacktestStatus;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_hasStartDate.
fin-strategy:BacktestRunShape_hasStartDate a sh:PropertyShape;
    sh:path fin-strategy:hasStartDate;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_hasEndDate.
fin-strategy:BacktestRunShape_hasEndDate a sh:PropertyShape;
    sh:path fin-strategy:hasEndDate;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_hasInitialCapital.
fin-strategy:BacktestRunShape_hasInitialCapital a sh:PropertyShape;
    sh:path fin-strategy:hasInitialCapital;
    sh:minCount 0;
    sh:maxCount 1.
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_backtestsStrategy.
fin-strategy:BacktestRunShape_backtestsStrategy a sh:PropertyShape;
    sh:path fin-strategy:backtestsStrategy;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class fin-strategy:StrategyDefinition.
fin-strategy:BacktestRunShape sh:property fin-strategy:BacktestRunShape_usedPortfolio.
fin-strategy:BacktestRunShape_usedPortfolio a sh:PropertyShape;
    sh:path fin-strategy:usedPortfolio;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/portfolio-positions/Portfolio>.
fin-strategy:PerformanceObservationShape a sh:NodeShape;
    sh:targetClass fin-strategy:PerformanceObservation;
    sh:name "Performance Observation";
    sh:description "point-in-time or period-aggregate performance metrics for a backtest run or live strategy including returns, drawdown, Sharpe ratio, and other statistics";
    sh:property fin-strategy:PerformanceObservationShape_hasCumulativeReturn.
fin-strategy:PerformanceObservationShape_hasCumulativeReturn a sh:PropertyShape;
    sh:path fin-strategy:hasCumulativeReturn;
    sh:minCount 0;
    sh:maxCount 1.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_hasMaxDrawdown.
fin-strategy:PerformanceObservationShape_hasMaxDrawdown a sh:PropertyShape;
    sh:path fin-strategy:hasMaxDrawdown;
    sh:minCount 0;
    sh:maxCount 1.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_hasSharpeRatio.
fin-strategy:PerformanceObservationShape_hasSharpeRatio a sh:PropertyShape;
    sh:path fin-strategy:hasSharpeRatio;
    sh:minCount 0;
    sh:maxCount 1.
fin-strategy:PerformanceObservationShape sh:property fin-strategy:PerformanceObservationShape_observedInBacktest.
fin-strategy:PerformanceObservationShape_observedInBacktest a sh:PropertyShape;
    sh:path fin-strategy:observedInBacktest;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class fin-strategy:BacktestRun.
fin-strategy:FactorObservationShape a sh:NodeShape;
    sh:targetClass fin-strategy:FactorObservation;
    sh:name "Factor Observation";
    sh:description "revision-aware observation of a factor value for an instrument and reporting period, with publication (knowledge) time distinct from period and availability time (Qlib PIT model)";
    sh:property fin-strategy:FactorObservationShape_hasFactorPeriod.
fin-strategy:FactorObservationShape_hasFactorPeriod a sh:PropertyShape;
    sh:path fin-strategy:hasFactorPeriod;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_hasFactorValue.
fin-strategy:FactorObservationShape_hasFactorValue a sh:PropertyShape;
    sh:path fin-strategy:hasFactorValue;
    sh:minCount 1;
    sh:maxCount 1.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_observesFactor.
fin-strategy:FactorObservationShape_observesFactor a sh:PropertyShape;
    sh:path fin-strategy:observesFactor;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class fin-strategy:FactorDefinition.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_observedInstrument.
fin-strategy:FactorObservationShape_observedInstrument a sh:PropertyShape;
    sh:path fin-strategy:observedInstrument;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-strategy:FactorObservationShape sh:property fin-strategy:FactorObservationShape_nextRevision.
fin-strategy:FactorObservationShape_nextRevision a sh:PropertyShape;
    sh:path fin-strategy:nextRevision;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-strategy:FactorObservation.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-foundation: <https://axiolune.ai/ontology/finance/foundation/>.

fin-foundation:MonetaryAmountShape a sh:NodeShape;
    sh:targetClass fin-foundation:MonetaryAmount;
    sh:name "Monetary Amount";
    sh:description "structured monetary amount with currency code and scale; financial amounts MUST NOT use bare decimal";
    sh:property fin-foundation:MonetaryAmountShape_hasCurrencyCode.
fin-foundation:MonetaryAmountShape_hasCurrencyCode a sh:PropertyShape;
    sh:path fin-foundation:hasCurrencyCode;
    sh:minCount 1;
    sh:maxCount 1.
fin-foundation:QuantityValueShape a sh:NodeShape;
    sh:targetClass fin-foundation:QuantityValue;
    sh:name "Quantity Value";
    sh:description "structured measurement with unit and precision; quantities MUST NOT use bare decimal".
fin-foundation:FinancialIdentifierAssignmentShape a sh:NodeShape;
    sh:targetClass fin-foundation:FinancialIdentifierAssignment;
    sh:name "Financial Identifier Assignment";
    sh:description "association binding an identifier value of a declared identifier type to a party or instrument under an issuing authority and effective interval";
    sh:property fin-foundation:FinancialIdentifierAssignmentShape_hasPrimaryIdentifier.
fin-foundation:FinancialIdentifierAssignmentShape_hasPrimaryIdentifier a sh:PropertyShape;
    sh:path fin-foundation:hasPrimaryIdentifier;
    sh:minCount 1;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_assignsIdentifier.
fin-foundation:FinancialIdentifierAssignmentShape_assignsIdentifier a sh:PropertyShape;
    sh:path fin-foundation:FinancialIdentifierAssignment_assignsIdentifier;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-foundation:Party.
fin-foundation:hasCurrencyCodeShape a sh:PropertyShape;
    sh:path fin-foundation:hasCurrencyCode;
    sh:pattern "^[A-Z]{3}$";
    sh:datatype xsd:string;
    sh:name "Has Currency Code".
fin-foundation:PartyShape a sh:NodeShape;
    sh:targetClass fin-foundation:Party;
    sh:name "Party";
    sh:description "autonomous agent that can participate in legal or financial relationships, including natural persons and legal entities".
fin-foundation:LegalEntityShape a sh:NodeShape;
    sh:targetClass fin-foundation:LegalEntity;
    sh:name "Legal Entity";
    sh:description "organization that is legally or financially responsible for the performance of financial transactions and is capable of accruing liability on its own part, excluding natural persons but including governments and supranational entities";
    sh:property fin-foundation:LegalEntityShape_hasLegalName.
fin-foundation:LegalEntityShape_hasLegalName a sh:PropertyShape;
    sh:path fin-foundation:hasLegalName;
    sh:minCount 0;
    sh:maxCount 1.
fin-foundation:CurrencyShape a sh:NodeShape;
    sh:targetClass fin-foundation:Currency;
    sh:name "Currency";
    sh:description "medium of exchange value defined by reference to the geographical location of the monetary authorities responsible for it, as specified in ISO 4217";
    sh:property fin-foundation:CurrencyShape_hasCurrencyCode.
fin-foundation:CurrencyShape_hasCurrencyCode a sh:PropertyShape;
    sh:path fin-foundation:hasCurrencyCode;
    sh:minCount 1;
    sh:maxCount 1.
fin-foundation:JurisdictionShape a sh:NodeShape;
    sh:targetClass fin-foundation:Jurisdiction;
    sh:name "Jurisdiction";
    sh:description "legal authority that has the power to make and enforce rules of conduct within a defined geographical or functional scope".
