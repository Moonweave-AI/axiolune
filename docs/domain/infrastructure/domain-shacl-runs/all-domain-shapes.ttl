fin-market-rules:RuleApplicabilityShape sh:property fin-market-rules:RuleApplicabilityShape_pat_validTo.
fin-market-rules:RuleApplicabilityShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-market-rules:RuleApplicabilityShape sh:property fin-market-rules:RuleApplicabilityShape_pat_knowledgeTo.
fin-market-rules:RuleApplicabilityShape_pat_knowledgeTo a sh:PropertyShape;
