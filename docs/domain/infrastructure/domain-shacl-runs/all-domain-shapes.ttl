fin-post-trade:IncompleteSourceCoverageAssertionShape a sh:NodeShape;
    sh:description "The incomplete source coverage assertion records that a reconciliation query returned no rows for a canonical comparison-key bucket on a specified side, but the source coverage is unknown so a business absence cannot be concluded. It prevents promoting a no-result query into a MissingSideAssertion of economic-fact absence and is used when the probe cannot prove universe completeness.";
    sh:name "Incomplete Source Coverage Assertion";
    sh:property <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/097485ef90b6c5a63ebac133>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/1ef81728d3804f62ab78f3aa>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/3e467f2f0bf4fa9b4ae46114>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/4543f03af65664a0923a00f6>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/52a79af2796acabd155d4f4b>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/79192a49b3d587287f8b8131>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/7f2b3868a0e7ad2fb245cb49>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/9fe8f155cfbf868915af2ed3>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/b0ecc1c441c8b60f39efec5b>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/c521982c857e9a260a115410>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/ddb6bb047248403138ca4927>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/attribute/f033fc3dbd2d731459b6ce90>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/post-trade-operations/IncompleteSourceCoverageAssertion/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/post-trade-o