fin-post-trade:SettlementFinalityEventShape a sh:NodeShape;
    sh:description "The settlement finality event is an immutable record of legal or system settlement finality for an instruction atomic group or exact leg, distinct from a source-reported settled status. It records the settlement system, the rule basis under which finality is achieved, the finality instant, and the finality kind (provisional, unconditional, or irrevocable), separating legal/system finality from the observed, reported, and knowledge pivots captured by the TemporalFact pattern.";
    sh:name "Settlement Finality Event";
