fin-post-trade:StrictTechnicalSettlementReconciliationProfileShape a sh:NodeShape;
    sh:description "The strict technical settlement reconciliation profile is an optional implementation profile that locks the reconciliation comparator to zero numeric tolerance, exact canonical Money and Quantity normalization, exact reference normalization, and forbids fuzzy reference matching and non-zero business tolerance. Reconciliation findings under this profile bucket by exact canonical key and treat any side count greater than one as a duplicate. It is the first concrete profile of the generic reconciliation comparator and is not a universal reconciliation invariant; one-to-many, many-to-one, and many-to-many match groups, timing differences, and expected breaks are admitted by the generic core under additional profiles.";
    sh:name "Strict Technical Settlement Reconciliation Profile";
    sh:property <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/attribute/39b70132a4d92ced040c0af6>, <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/post-trade-operations/StrictTechnicalSettlementReconciliationProfile/shape/temporal/f0f2f601393d100a35dc2429>;
