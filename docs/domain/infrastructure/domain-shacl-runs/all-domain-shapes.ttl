fin-post-trade:MissingSideAssertionShape a sh:NodeShape;
    sh:description "The missing side assertion is a probe-backed proof that, for one canonical comparison-key bucket, a specified side is absent from the case-selected complete internal projection set or the exact external statement-line set, while the opposite side is proven present by the finding's observable members. It is distinct from an IncompleteSourceCoverageAssertion, which states that a query returned no rows but coverage is unknown so absence cannot be concluded. Under the Strict Technical Settlement Reconciliation Profile the absence proof must be a deterministic side absence with a completed universe probe; the generic core admits weaker absence-proof kinds.";
    sh:name "Missing Side Assertion";
    sh:property <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/097485ef90b6c5a63ebac133>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/15a88053ecfcd188e7255ddb>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/1ef81728d3804f62ab78f3aa>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/23e0ebbf80b3dd2e01a281da>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/3e467f2f0bf4fa9b4ae46114>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/4543f03af65664a0923a00f6>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/4d2f50d3f4884c3ca9bca493>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/52a79af2796acabd155d4f4b>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/79192a49b3d587287f8b8131>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/7ce0e73e9db0b11b36461be7>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/7f2b3868a0e7ad2fb245cb49>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/939cb912f4cf6e8fe057697d>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/9fe8f155cfbf868915af2ed3>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/a67bd8b37634890711ac2365>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/b0ecc1c441c8b60f39efec5b>, <https://axiolune.ai/ontology/finance/post-trade-operations/MissingSideAssertion/shape/attribute/c521982c857e9a260a115410>, 