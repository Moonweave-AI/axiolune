fin-post-trade:SettlementInstructionShape a sh:NodeShape;
    sh:description "The settlement instruction is an authority-scoped instruction that fixes the distinct securities endpoint Parties, settlement method, date, system, and location, the exact calendar, and the leg set. The Simple DvP/FoP Settlement Profile locks the leg set to exactly one security leg (FOP) or one reciprocal security and cash leg (DVP); the generic core permits multi-leg, multi-currency, fee/tax-leg, and netted structures via additional profiles. Confirmation, affirmation, clearing, novation, and netting are out of scope and are exposed only as optional traceability hooks.";
    sh:name "Settlement Instruction";
    sh:property <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/083c6bc98672f3d31fa7e7a2>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/097485ef90b6c5a63ebac133>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/0b01bd6f93359a1f3a5b34d2>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/13fe0725ecc919f2dc6f79b8>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/1c894c0e803b7bd13aa5eb8e>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/1ef81728d3804f62ab78f3aa>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/34722e18a7e8b72bdc5ee7e5>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/4133dc3cf4ccf6549bcd04d4>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/6d7ee2c45f52fd4ae924cf4a>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/7f2b3868a0e7ad2fb245cb49>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/9417526e026974678c380a97>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/attribute/c45715d7a169e4ed898fa28a>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/post-trade-operations/SettlementInstruction/sh