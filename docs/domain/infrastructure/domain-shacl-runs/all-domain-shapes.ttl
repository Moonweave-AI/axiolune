fin-market-structure:TradingScheduleOverrideNoticeShape a sh:NodeShape;
    sh:description "Trading Schedule Override Notice, is a temporal provenance-bearing n-ary association that records one pre-announced schedule override applying to one or more exact TradingSessionOccurrence versions under one exact calendar and one exact facility, carrying an announcement order and a supersession order together with an optional replacement interval, used to separate the planned schedule from real-time status and to deterministically synthesize a single final effective interval or cancellation across multiple affected sessions.";
    sh:name "Trading Schedule Override Notice";
    sh:property <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/attribute/0b18b6afb4d1bd38561fcb1c>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/attribute/469669607d1a089584e7295b>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/attribute/60a045b662c4fd580e091fae>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/attribute/7336802c1c9cbc3711ff0465>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/attribute/c713b2b319822ebfad2f0ee2>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/attribute/d2b6d55b8362e21281d32e63>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/participant-role-overrideAppliesToOccurrence/f4ae1c3ab1f5021681fa3fae>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/participant-role-overrideForCalendar/329fa01e020c3d75ca8fc9f9>, <https://axiolune.ai/ontology/finance/market-structure/TradingScheduleOverrideNotice/shape/participant-role-overrideForFacility/2cb2636e6586b246c7f5c2c9>, <https://axiolune.ai/ontology/finance/market-structure/Tradi