fin-post-trade:DirectRightsDueBillCorporateActionProfileShape a sh:NodeShape;
    sh:description "The direct rights due-bill corporate action profile is an optional implementation profile that locks a corporate action event to the cash dividend, stock split, or non-transferable direct-rights issue kinds, with exactly one consideration per event and the due-bill entitlement transfer chain. It is the first concrete profile of the generic corporate action core and is not a universal corporate-action invariant; merger, redemption, conversion, tender, spin-off, exchange, transferable rights, interest, tax withholding, cash-in-lieu, and reversal/correction are admitted by the generic core under additional profiles and options.";
    sh:name "Direct Rights Due-Bill Corporate Action Profile";
    sh:property <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/attribute/39b70132a4d92ced040c0af6>, <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/post-trade-operations/DirectRightsDueBillCorporateActionProfile/shape/temporal/f0f2f601393d100a35dc2429>;
