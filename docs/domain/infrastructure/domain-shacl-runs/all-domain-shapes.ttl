fin-post-trade:ReconciliationFindingShape a sh:NodeShape;
    sh:description "The reconciliation finding is the exactly one deterministic matched, value-mismatch, duplicate, or missing-side result for a non-empty canonical comparison-key bucket, carrying all exact internal and external versions, used for characterizing the reconciliation conclusion for one comparison-key bucket. Under the Strict Technical Settlement Reconciliation Profile the finding is one-to-one per bucket; the generic core admits one-to-many, many-to-one, and many-to-many match groups via a ReconciliationMatchGroup, where duplicate means the same logical business fact recorded more than once rather than any bucket count greater than one.";
    sh:name "Reconciliation Finding";
    sh:property <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/15fea7b42e329aa02a41684e>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/1bccff015a988fa64584eba0>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/348a2cb8cd5dca90e593a84e>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/3e62ee8ddd058ac2ed3395e8>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/411e1c8a323009d13fea6047>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/4f71c43190d31d9d019053ce>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/5b037a0f248b507ad1e0b76d>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/5f1d3034deb8af72f15d5611>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/7659a960d2c20a266d980bd5>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/79192a49b3d587287f8b8131>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/902eb42b9f1617411059fe6b>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/9b31f3da1dc450a354ca1191>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/a74e231baaaa506c24d6e8f5>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/ad91d14d0c34de830bb363b7>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/c4762cfa4cb844e5c8c255c6>, <https://axiolune.ai/ontology/finance/post-trade-operations/ReconciliationFinding/shape/attribute/d5b861c74c3