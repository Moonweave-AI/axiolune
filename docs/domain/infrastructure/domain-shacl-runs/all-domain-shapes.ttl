@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-market-rules: <https://axiolune.ai/ontology/finance/market-rules/>.

fin-market-rules:RuleTypeShape a sh:NodeShape;
    sh:targetClass fin-market-rules:RuleType;
    sh:in ("PriceLimit" "TickSchedule" "LotSchedule" "SettlementCycle" "TradingHours" "MarginRequirement" "PositionLimit" "ShortSellingRestriction" "CircuitBreaker" "CloseTodayOffset" "TPlusTradingRestriction");
    sh:name "Rule Type".
fin-market-rules:RuleLifecycleStatusShape a sh:NodeShape;
    sh:targetClass fin-market-rules:RuleLifecycleStatus;
    sh:in ("active" "superseded" "expired" "proposed");
    sh:name "Rule Lifecycle Status".
fin-market-rules:InstrumentClassShape a sh:NodeShape;
    sh:targetClass fin-market-rules:InstrumentClass;
    sh:in ("Equity" "Bond" "Future" "Option" "Swap" "Fund" "Commodity");
    sh:name "Instrument Class".
fin-market-rules:MarketRuleShape a sh:NodeShape;
    sh:targetClass fin-market-rules:MarketRule;
    sh:name "Market Rule";
    sh:description "named trading or settlement rule that governs how instruments are traded, matched, or settled on a trading venue, with a rule type, parameter value, unit, source, and revision";
    sh:property fin-market-rules:MarketRuleShape_hasRuleType.
fin-market-rules:MarketRuleShape_hasRuleType a sh:PropertyShape;
    sh:path fin-market-rules:hasRuleType;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("PriceLimit" "TickSchedule" "LotSchedule" "SettlementCycle" "TradingHours" "MarginRequirement" "PositionLimit" "ShortSellingRestriction" "CircuitBreaker" "CloseTodayOffset" "TPlusTradingRestriction").
fin-market-rules:MarketRuleShape sh:property fin-market-rules:MarketRuleShape_hasRuleParameterValue.
fin-market-rules:MarketRuleShape_hasRuleParameterValue a sh:PropertyShape;
    sh:path fin-market-rules:hasRuleParameterValue;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-market-rules:MarketRuleShape sh:property fin-market-rules:MarketRuleShape_hasRuleParameterUnit.
fin-market-rules:MarketRuleShape_hasRuleParameterUnit a sh:PropertyShape;
    sh:path fin-market-rules:hasRuleParameterUnit;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-market-rules:MarketRuleShape sh:property fin-market-rules:MarketRuleShape_hasRuleSource.
fin-market-rules:MarketRuleShape_hasRuleSource a sh:PropertyShape;
    sh:path fin-market-rules:hasRuleSource;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-market-rules:MarketRuleShape sh:property fin-market-rules:MarketRuleShape_hasRuleRevision.
fin-market-rules:MarketRuleShape_hasRuleRevision a sh:PropertyShape;
    sh:path fin-market-rules:hasRuleRevision;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-market-rules:SettlementConventionShape a sh:NodeShape;
    sh:targetClass fin-market-rules:SettlementConvention;
    sh:name "Settlement Convention";
    sh:description "market rule that defines the standard settlement cycle (e.g. T+1, T+2) for trades executed on a venue".
fin-market-rules:RuleApplicabilityShape a sh:NodeShape;
    sh:targetClass fin-market-rules:RuleApplicability;
    sh:name "Rule Applicability";
    sh:description "association that binds a market rule to a specific scope defined by venue, market segment, instrument class, and/or investor category, with valid-time and knowledge-time intervals, source, revision, and lifecycle status";
    sh:property fin-market-rules:RuleApplicabilityShape_appliesToInstrumentClass.
fin-market-rules:RuleApplicabilityShape_appliesToInstrumentClass a sh:PropertyShape;
    sh:path fin-market-rules:appliesToInstrumentClass;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Equity" "Bond" "Future" "Option" "Swap" "Fund" "Commodity").
fin-market-rules:RuleApplicabilityShape sh:property fin-market-rules:RuleApplicabilityShape_hasLifecycleStatus.
fin-market-rules:RuleApplicabilityShape_hasLifecycleStatus a sh:PropertyShape;
    sh:path fin-market-rules:hasLifecycleStatus;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("active" "superseded" "expired" "proposed").
fin-market-rules:RuleApplicabilityShape sh:property fin-market-rules:RuleApplicabilityShape_appliesRule.
fin-market-rules:RuleApplicabilityShape_appliesRule a sh:PropertyShape;
    sh:path fin-market-rules:appliesRule;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class fin-market-rules:MarketRule.
fin-market-rules:RuleApplicabilityShape sh:property fin-market-rules:RuleApplicabilityShape_scopedToVenue.
fin-market-rules:RuleApplicabilityShape_scopedToVenue a sh:PropertyShape;
    sh:path fin-market-rules:scopedToVenue;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/market-structure/TradingVenue>.
fin-market-rules:RuleApplicabilityShape sh:property fin-market-rules:RuleApplicabilityShape_pat_validFrom.
fin-market-rules:RuleApplicabilityShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
