    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-risk:ExposureObservationShape sh:sparql _:sparql_valid_ExposureObservation.
_:sparql_valid_ExposureObservation sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-risk:ExposureObservationShape sh:sparql _:sparql_knowledge_ExposureObservation.
_:sparql_knowledge_ExposureObservation sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
