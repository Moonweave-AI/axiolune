@prefix fin-portfolio: <https://axiolune.ai/ontology/finance/portfolio-positions/>.

fin-portfolio:PositionSideShape a sh:NodeShape;
    sh:targetClass fin-portfolio:PositionSide;
    sh:in ("Long" "Short" "Flat");
    sh:name "Position Side".
fin-portfolio:ValuationMethodShape a sh:NodeShape;
    sh:targetClass fin-portfolio:ValuationMethod;
    sh:in ("MarkToMarket" "MarkToModel" "CostBasis" "LowerOfCostOrMarket");
