fin-strategy:StrategyDefinitionShape a sh:NodeShape;
    sh:description "Strategy Definition, is a signal generator specification that defines one trading or allocation strategy together with its objective, mandate, universe, portfolio construction, rebalance, risk, and execution intent, used for modeling the strategy as an investment decision rule rather than merely a factor consumer, and for modeling each factor dependency as an explicit exact-version relation rather than an implicit source-code import. The factor dependency is optional; a factor-strategy profile enforces at least one factor.";
    sh:name "Strategy Definition";
    sh:property <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/attribute/4cebb2a596d96fcefd9e3f6d>, <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/attribute/5ea30edd9911fd5847f9c7f5>, <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/attribute/fc715dc368934e8ec71c09d7>, <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/strategy-research/StrategyDefinition/shape/temporal/f0f2f601393d100a35dc2429>;
