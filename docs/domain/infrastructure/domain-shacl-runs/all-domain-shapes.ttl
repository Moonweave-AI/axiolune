fin-orders:ExecutionLegShape a sh:NodeShape;
    sh:description "An Execution Leg is an optional single-leg execution component corresponding to an OrderLeg, used as an extension point for multi-leg executions whose full semantics are completed via a cross-module follow-up gated on the instruments QuotationConvention (ADR-021). In v1.1.0 a single-instrument execution carries no ExecutionLeg and remains described directly on the Execution.";
    sh:name "Execution Leg";
    sh:property <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/attribute/35cbf5b57e685903fd3641d3>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/attribute/9353d78b3044b57f97e24ade>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/shape/temporal/f0f2f601393d100a35dc2429>;
