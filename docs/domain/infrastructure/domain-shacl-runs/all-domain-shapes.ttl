fin-post-trade:SimpleDvpFopSettlementProfileShape a sh:NodeShape;
    sh:description "The simple DvP/FoP settlement profile is an optional implementation profile that locks a settlement instruction to exactly one security leg for free-of-payment or one reciprocal security and cash leg for delivery-versus-payment, with distinct deliverer and receiver Parties and consistent date/system/location and calendar across legs. It is the first concrete profile of the generic settlement core and is not a universal post-trade invariant; multi-leg, multi-currency, fee/tax-leg, PvP, DvD, and netted structures are admitted by the generic core under additional profiles.";
    sh:name "Simple DvP/FoP Settlement Profile";
    sh:property <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/attribute/39b70132a4d92ced040c0af6>, <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/post-trade-operations/SimpleDvpFopSettlementProfile/shape/temporal/f0f2f601393d100a35dc2429>;
