@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix ext-fibo: <https://axiolune.ai/ontology/finance/ext-fibo-release-local/>.

ext-fibo:FiboEvidenceBundleShape a sh:NodeShape;
    sh:targetClass ext-fibo:FiboEvidenceBundle;
    sh:name "FIBO Evidence Bundle";
    sh:description "documentation object recording the locked local FIBO evidence files and import policy for Axiolune alignments".

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-foundation: <https://axiolune.ai/ontology/finance/foundation/>.

fin-foundation:MonetaryAmountShape a sh:NodeShape;
    sh:targetClass fin-foundation:MonetaryAmount;
    sh:name "Monetary Amount";
    sh:description "structured monetary amount with numeric magnitude, ISO 4217 currency code, and optional scale; financial amounts MUST NOT use bare decimal literals";
    sh:property fin-foundation:MonetaryAmountShape_hasNumericAmount.
fin-foundation:MonetaryAmountShape_hasNumericAmount a sh:PropertyShape;
    sh:path fin-foundation:hasNumericAmount;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:decimal.
fin-foundation:MonetaryAmountShape sh:property fin-foundation:MonetaryAmountShape_hasCurrencyCode.
fin-foundation:MonetaryAmountShape_hasCurrencyCode a sh:PropertyShape;
    sh:path fin-foundation:hasCurrencyCode;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{3}$".
fin-foundation:MonetaryAmountShape sh:property fin-foundation:MonetaryAmountShape_hasScale.
fin-foundation:MonetaryAmountShape_hasScale a sh:PropertyShape;
    sh:path fin-foundation:hasScale;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:integer.
fin-foundation:QuantityValueShape a sh:NodeShape;
    sh:targetClass fin-foundation:QuantityValue;
    sh:name "Quantity Value";
    sh:description "structured measurement with numeric magnitude and unit code; quantities MUST NOT use bare decimal";
    sh:property fin-foundation:QuantityValueShape_hasNumericAmount.
fin-foundation:QuantityValueShape_hasNumericAmount a sh:PropertyShape;
    sh:path fin-foundation:hasNumericAmount;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:decimal.
fin-foundation:QuantityValueShape sh:property fin-foundation:QuantityValueShape_hasUnitCode.
fin-foundation:QuantityValueShape_hasUnitCode a sh:PropertyShape;
    sh:path fin-foundation:hasUnitCode;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-foundation:QuantityValueShape sh:property fin-foundation:QuantityValueShape_hasScale.
fin-foundation:QuantityValueShape_hasScale a sh:PropertyShape;
    sh:path fin-foundation:hasScale;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:integer.
fin-foundation:FinancialIdentifierAssignmentShape a sh:NodeShape;
    sh:targetClass fin-foundation:FinancialIdentifierAssignment;
    sh:name "Financial Identifier Assignment";
    sh:description "association binding an identifier value of a declared identifier type to a party or instrument under an issuing authority and effective interval";
    sh:property fin-foundation:FinancialIdentifierAssignmentShape_hasPrimaryIdentifier.
fin-foundation:FinancialIdentifierAssignmentShape_hasPrimaryIdentifier a sh:PropertyShape;
    sh:path fin-foundation:hasPrimaryIdentifier;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_assignsIdentifier.
fin-foundation:FinancialIdentifierAssignmentShape_assignsIdentifier a sh:PropertyShape;
    sh:path fin-foundation:assignsIdentifier;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-foundation:Party.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_identifiesSubject.
fin-foundation:FinancialIdentifierAssignmentShape_identifiesSubject a sh:PropertyShape;
    sh:path fin-foundation:identifiesSubject;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class fin-foundation:Party.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_validFrom.
fin-foundation:FinancialIdentifierAssignmentShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_knowledgeFrom.
fin-foundation:FinancialIdentifierAssignmentShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_availableFrom.
fin-foundation:FinancialIdentifierAssignmentShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_validTo.
fin-foundation:FinancialIdentifierAssignmentShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_knowledgeTo.
fin-foundation:FinancialIdentifierAssignmentShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_availableTo.
fin-foundation:FinancialIdentifierAssignmentShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-foundation:FinancialIdentifierAssignmentShape sh:sparql _:sparql_valid_FinancialIdentifierAssignment.
_:sparql_valid_FinancialIdentifierAssignment sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-foundation:FinancialIdentifierAssignmentShape sh:sparql _:sparql_knowledge_FinancialIdentifierAssignment.
_:sparql_knowledge_FinancialIdentifierAssignment sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-foundation:FinancialIdentifierAssignmentShape sh:sparql _:sparql_available_FinancialIdentifierAssignment.
_:sparql_available_FinancialIdentifierAssignment sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-foundation:FinancialIdentifierAssignmentShape sh:property fin-foundation:FinancialIdentifierAssignmentShape_pat_source.
fin-foundation:FinancialIdentifierAssignmentShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
fin-foundation:hasCurrencyCodeShape a sh:PropertyShape;
    sh:path fin-foundation:hasCurrencyCode;
    sh:pattern "^[A-Z]{3}$";
    sh:datatype xsd:string;
    sh:name "Has Currency Code".
fin-foundation:PartyShape a sh:NodeShape;
    sh:targetClass fin-foundation:Party;
    sh:name "Party";
    sh:description "autonomous agent that can participate in legal or financial relationships, including natural persons and legal entities".
fin-foundation:LegalEntityShape a sh:NodeShape;
    sh:targetClass fin-foundation:LegalEntity;
    sh:name "Legal Entity";
    sh:description "organization that is legally or financially responsible for the performance of financial transactions and is capable of accruing liability on its own part, excluding natural persons but including governments and supranational entities";
    sh:property fin-foundation:LegalEntityShape_hasLegalName.
fin-foundation:LegalEntityShape_hasLegalName a sh:PropertyShape;
    sh:path fin-foundation:hasLegalName;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-foundation:CurrencyShape a sh:NodeShape;
    sh:targetClass fin-foundation:Currency;
    sh:name "Currency";
    sh:description "medium of exchange value defined by reference to the geographical location of the monetary authorities responsible for it, as specified in ISO 4217";
    sh:property fin-foundation:CurrencyShape_hasCurrencyCode.
fin-foundation:CurrencyShape_hasCurrencyCode a sh:PropertyShape;
    sh:path fin-foundation:hasCurrencyCode;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{3}$".
fin-foundation:JurisdictionShape a sh:NodeShape;
    sh:targetClass fin-foundation:Jurisdiction;
    sh:name "Jurisdiction";
    sh:description "legal authority that has the power to make and enforce rules of conduct within a defined geographical or functional scope".
fin-foundation:ISINPatternShape a sh:NodeShape;
    sh:targetClass fin-foundation:ISIN;
    sh:property fin-foundation:ISINPatternShape_value.
fin-foundation:ISINPatternShape_value a sh:PropertyShape;
    sh:path fin-foundation:ISIN;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{2}[A-Z0-9]{9}[0-9]$";
    sh:name "International Securities Identification Number".
fin-foundation:LEIPatternShape a sh:NodeShape;
    sh:targetClass fin-foundation:LEI;
    sh:property fin-foundation:LEIPatternShape_value.
fin-foundation:LEIPatternShape_value a sh:PropertyShape;
    sh:path fin-foundation:LEI;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z0-9]{18}[0-9]{2}$";
    sh:name "Legal Entity Identifier".
fin-foundation:MICPatternShape a sh:NodeShape;
    sh:targetClass fin-foundation:MIC;
    sh:property fin-foundation:MICPatternShape_value.
fin-foundation:MICPatternShape_value a sh:PropertyShape;
    sh:path fin-foundation:MIC;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{4}([A-Z]{4})?$";
    sh:name "Market Identifier Code".

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-instruments: <https://axiolune.ai/ontology/finance/instruments/>.

fin-instruments:FinancialInstrumentShape a sh:NodeShape;
    sh:targetClass fin-instruments:FinancialInstrument;
    sh:name "Financial Instrument";
    sh:description "written contract that gives rise to both a financial asset of one entity and a financial liability of another entity, as defined in IAS 32";
    sh:property fin-instruments:FinancialInstrumentShape_hasPrimaryIdentifier.
fin-instruments:FinancialInstrumentShape_hasPrimaryIdentifier a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/finance/foundation/hasPrimaryIdentifier>;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:string.
fin-instruments:FinancialInstrumentShape sh:property fin-instruments:FinancialInstrumentShape_hasDenominatedCurrency.
fin-instruments:FinancialInstrumentShape_hasDenominatedCurrency a sh:PropertyShape;
    sh:path fin-instruments:hasDenominatedCurrency;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/Currency>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-instruments:SecurityShape a sh:NodeShape;
    sh:targetClass fin-instruments:Security;
    sh:name "Security";
    sh:description "financial instrument that can be bought or sold, as defined in the Securities Exchange Act 1934".
fin-instruments:EquitySecurityShape a sh:NodeShape;
    sh:targetClass fin-instruments:EquitySecurity;
    sh:name "Equity Security";
    sh:description "security representing an ownership interest in an entity or pool of assets, as defined in ISO 10962".
fin-instruments:SecuritiesOfferingShape a sh:NodeShape;
    sh:targetClass fin-instruments:SecuritiesOffering;
    sh:name "Securities Offering";
    sh:description "offering of a security (or securities) for sale; distinct from the instrument contract and from an exchange listing".
fin-instruments:InstrumentListingShape a sh:NodeShape;
    sh:targetClass fin-instruments:InstrumentListing;
    sh:name "Instrument Listing";
    sh:description "catalog entry for a securities offering managed by an exchange that provides the terms under which that security is made available on that exchange";
    sh:property fin-instruments:InstrumentListingShape_hasTickSize.
fin-instruments:InstrumentListingShape_hasTickSize a sh:PropertyShape;
    sh:path fin-instruments:hasTickSize;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_hasLotSize.
fin-instruments:InstrumentListingShape_hasLotSize a sh:PropertyShape;
    sh:path fin-instruments:hasLotSize;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/QuantityValue>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_hasListingDate.
fin-instruments:InstrumentListingShape_hasListingDate a sh:PropertyShape;
    sh:path fin-instruments:hasListingDate;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:dateTime.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_hasDelistingDate.
fin-instruments:InstrumentListingShape_hasDelistingDate a sh:PropertyShape;
    sh:path fin-instruments:hasDelistingDate;
    sh:minCount 0;
    sh:maxCount 1;
    sh:datatype xsd:dateTime.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_hasDenominatedCurrency.
fin-instruments:InstrumentListingShape_hasDenominatedCurrency a sh:PropertyShape;
    sh:path fin-instruments:hasDenominatedCurrency;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/Currency>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_validFrom.
fin-instruments:InstrumentListingShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_knowledgeFrom.
fin-instruments:InstrumentListingShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_availableFrom.
fin-instruments:InstrumentListingShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_validTo.
fin-instruments:InstrumentListingShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_knowledgeTo.
fin-instruments:InstrumentListingShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:property fin-instruments:InstrumentListingShape_pat_availableTo.
fin-instruments:InstrumentListingShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-instruments:InstrumentListingShape sh:sparql _:sparql_valid_InstrumentListing.
_:sparql_valid_InstrumentListing sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-instruments:InstrumentListingShape sh:sparql _:sparql_knowledge_InstrumentListing.
_:sparql_knowledge_InstrumentListing sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-instruments:InstrumentListingShape sh:sparql _:sparql_available_InstrumentListing.
_:sparql_available_InstrumentListing sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-instruments:IssuerShape a sh:NodeShape;
    sh:targetClass fin-instruments:Issuer;
    sh:name "Issuer";
    sh:description "role of a party that issues or proposes to issue in a formal filing one or more financial instruments".

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

@prefix fin-market-data: <https://axiolune.ai/ontology/finance/market-data/>.

fin-market-data:PriceKindShape a sh:NodeShape;
    sh:targetClass fin-market-data:PriceKind;
    sh:in ("Last" "Bid" "Ask" "Mid" "Open" "High" "Low" "Close" "Settlement" "VWAP" "TWAP");
    sh:name "Price Kind".
fin-market-data:QuoteSideShape a sh:NodeShape;
    sh:targetClass fin-market-data:QuoteSide;
    sh:in ("Bid" "Ask");
    sh:name "Quote Side".
fin-market-data:BarAggregationShape a sh:NodeShape;
    sh:targetClass fin-market-data:BarAggregation;
    sh:in ("Time" "Tick" "Volume" "Dollar" "Range" "Renko");
    sh:name "Bar Aggregation".
fin-market-data:PriceObservationShape a sh:NodeShape;
    sh:targetClass fin-market-data:PriceObservation;
    sh:name "Price Observation";
    sh:description "time-stamped observation of a price for a financial instrument at a specific venue with a defined price kind, currency, source, and three-axis temporal semantics (valid-time = market event time, knowledge-time = when platform learned, availability-time = when queryable per ADR-012)";
    sh:property fin-market-data:PriceObservationShape_hasPriceValue.
fin-market-data:PriceObservationShape_hasPriceValue a sh:PropertyShape;
    sh:path fin-market-data:hasPriceValue;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/foundation/MonetaryAmount>;
    sh:nodeKind sh:BlankNodeOrIRI.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_hasPriceKind.
fin-market-data:PriceObservationShape_hasPriceKind a sh:PropertyShape;
    sh:path fin-market-data:hasPriceKind;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:in ("Last" "Bid" "Ask" "Mid" "Open" "High" "Low" "Close" "Settlement" "VWAP" "TWAP").
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_hasCurrencyCode.
fin-market-data:PriceObservationShape_hasCurrencyCode a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/finance/foundation/hasCurrencyCode>;
    sh:minCount 1;
    sh:maxCount 1;
    sh:datatype xsd:string;
    sh:pattern "^[A-Z]{3}$".
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_observedInstrument.
fin-market-data:PriceObservationShape_observedInstrument a sh:PropertyShape;
    sh:path fin-market-data:observedInstrument;
    sh:minCount 1;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/instruments/FinancialInstrument>.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_observedAtVenue.
fin-market-data:PriceObservationShape_observedAtVenue a sh:PropertyShape;
    sh:path fin-market-data:observedAtVenue;
    sh:minCount 0;
    sh:maxCount 1;
    sh:class <https://axiolune.ai/ontology/finance/market-structure/TradingVenue>.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_validFrom.
fin-market-data:PriceObservationShape_pat_validFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_knowledgeFrom.
fin-market-data:PriceObservationShape_pat_knowledgeFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_availableFrom.
fin-market-data:PriceObservationShape_pat_availableFrom a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom>;
    sh:datatype xsd:dateTime;
    sh:minCount 1;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_validTo.
fin-market-data:PriceObservationShape_pat_validTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/validTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_knowledgeTo.
fin-market-data:PriceObservationShape_pat_knowledgeTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_availableTo.
fin-market-data:PriceObservationShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-market-data:PriceObservationShape sh:sparql _:sparql_valid_PriceObservation.
_:sparql_valid_PriceObservation sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-market-data:PriceObservationShape sh:sparql _:sparql_knowledge_PriceObservation.
_:sparql_knowledge_PriceObservation sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-market-data:PriceObservationShape sh:sparql _:sparql_available_PriceObservation.
_:sparql_available_PriceObservation sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
fin-market-data:PriceObservationShape sh:property fin-market-data:PriceObservationShape_pat_source.
fin-market-data:PriceObservationShape_pat_source a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/source>;
    sh:maxCount 1.
fin-market-data:QuoteObservationShape a sh:NodeShape;
    sh:targetClass fin-market-data:QuoteObservation;
    sh:name "Quote Observation";
    sh:description "time-stamped observation of bid and/or ask prices with sizes for a financial instrument at a specific venue, with three-axis temporal semantics per ADR-012";
    sh:property fin-market-data:QuoteObservationShape_hasBidPrice.
