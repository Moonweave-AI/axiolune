fin-orders:AllocationLineShape a sh:NodeShape;
    sh:description "An Allocation Line is an immutable allocation target line expressing one account's share of a source execution, used to model post-execution allocation, average-price allocation, and bunched-order back-allocation together with an ExecutionAllocation, while detailed allocation and clearing semantics remain in post-trade-operations.";
    sh:name "Allocation Line";
    sh:property <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/attribute/259058d41b0c66ea9a029e81>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/attribute/991af5df2e8ad01c6913469f>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/immutable-version/1546f4be8593f8b2da423607>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/immutable-version/af9bccfcc999a1901c9cfbc3>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/imported-attribute/0538de9c85773c973901b113>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/imported-attribute/575f9555ce5ae904bf2243de>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/imported-attribute/b352dad7e378e98d6fbb940e>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/provenance/910a4941731155c4c7cafbfe>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/provenance/f31743343a8f991854642cfe>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/temporal/03727e96cec2b79c1d8f9f29>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/temporal/af6029d9b458f2ce4f75cff7>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/temporal/f05c2d086ac5a605305520ea>, <https://axiolune.ai/ontology/finance/orders-execution/AllocationLine/shape/temporal/f0f2f601393d100a35dc2429>;
