fin-market-rules:RuleApplicabilityShape_pat_availableTo a sh:PropertyShape;
    sh:path <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo>;
    sh:datatype xsd:dateTime;
    sh:maxCount 1.
fin-market-rules:RuleApplicabilityShape sh:sparql _:sparql_valid_RuleApplicability.
_:sparql_valid_RuleApplicability sh:message "valid interval inversion: validTo must be greater than validFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/validFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/validTo> ?to . FILTER (?to <= ?from) }".
fin-market-rules:RuleApplicabilityShape sh:sparql _:sparql_knowledge_RuleApplicability.
_:sparql_knowledge_RuleApplicability sh:message "knowledge interval inversion: knowledgeTo must be greater than knowledgeFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/knowledgeTo> ?to . FILTER (?to <= ?from) }".
fin-market-rules:RuleApplicabilityShape sh:sparql _:sparql_available_RuleApplicability.
_:sparql_available_RuleApplicability sh:message "available interval inversion: availableTo must be greater than availableFrom";
    sh:select "SELECT $this WHERE { $this <https://axiolune.ai/ontology/meta/patterns/attributes/availableFrom> ?from ; <https://axiolune.ai/ontology/meta/patterns/attributes/availableTo> ?to . FILTER (?to <= ?from) }".
