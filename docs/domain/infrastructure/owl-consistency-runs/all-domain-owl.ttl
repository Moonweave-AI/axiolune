fin-strategy:pitCoverageScope a owl:DatatypeProperty;
    rdfs:comment "PIT Coverage Scope, is an optional human-readable statement of the decision points covered by a PIT assessment, used for making the assessment coverage explicit.";
    rdfs:label "PIT coverage scope";
    rdfs:range xsd:string.
fin-strategy:pitRequestRecordDigest a owl:DatatypeProperty;
