    rdfs:range fin-strategy:Hypothesis.
fin-strategy:researchQuestionId a owl:DatatypeProperty;
    rdfs:comment "Research Question Identifier, is an authority-scoped stable identifier of a ResearchQuestion logical identity, used for uniquely referring to a research question within a single authority scope.";
    rdfs:label "research question identifier";
    rdfs:range xsd:string.
fin-strategy:researchQuestionProtocol a owl:FunctionalProperty, owl:ObjectProperty;
