fin-strategy:rollbackDecisionId a owl:DatatypeProperty;
    rdfs:comment "Rollback Decision Identifier, is a source-scoped stable identifier of one RollbackDecision, used for uniquely referring to a rollback decision within its scope.";
    rdfs:label "rollback decision identifier";
    rdfs:range xsd:string.
fin-strategy:rollbackReason a owl:DatatypeProperty;
