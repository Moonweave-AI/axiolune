<https://axiolune.ai/ontology/finance/market-structure/ScheduledTradingPhase/value/maintenance> a owl:NamedIndividual, skos:Concept, fin-market-structure:ScheduledTradingPhase;
    rdfs:comment "phase reserved for venue maintenance, not open for trading";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-structure/ScheduledTradingPhase/scheme>;
    skos:notation "maintenance";
