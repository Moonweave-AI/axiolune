<https://axiolune.ai/ontology/finance/risk> a owl:Ontology;
    rdfs:comment "versioned risk-measure specifications, completed measurements, compatible limits, explicit limit evaluations, bucketed results, and breach facts whose values, scopes, model inputs, and run provenance remain point-in-time reproducible";
    rdfs:label "Risk";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/market-data>, <https://axiolune.ai/ontology/finance/portfolio-positions>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/risk/1.0.0>.
fin-risk:LimitBreach a owl:Class;
    rdfs:comment "immutable breach fact that exists only for a breach evaluation and repeats that evaluation's exact measurement, exact limit, and generating context without introducing a second threshold or result truth";
    rdfs:label "Limit Breach";
    rdfs:subClassOf _:r_35b213e6fae208e1ff4a5d24, _:r_6c4eab0cf9c492d2f7d1a17b, _:r_7af2ea4ff90059940c1d8fec, _:r_7cbcf2cbd0bbe19225b5d0ed, _:r_8452c09e8755c9279eec4069, _:r_c0ab9c0bfe929e87486e2907, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/risk/LimitBreach/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Limit Breach versions.";
    rdfs:label "Limit Breach logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/risk/LimitBreach/role/breachEvaluation> a owl:ObjectProperty;
    rdfs:comment "exact RiskLimitEvaluation version whose result is breach";
    rdfs:domain fin-risk:LimitBreach;
    rdfs:label "breach evaluation";
    rdfs:range fin-risk:RiskLimitEvaluation.
<https://axiolune.ai/ontology/finance/risk/LimitBreach/role/breachLimit> a owl:ObjectProperty;
    rdfs:comment "exact RiskLimit version copied from the evaluation";
    rdfs:domain fin-risk:LimitBreach;
    rdfs:label "breach limit";
    rdfs:range fin-risk:RiskLimit.
<https://axiolune.ai/ontology/finance/risk/LimitBreach/role/breachMeasurement> a owl:ObjectProperty;
    rdfs:comment "exact RiskMeasurement version copied from the evaluation";
    rdfs:domain fin-risk:LimitBreach;
    rdfs:label "breach measurement";
    rdfs:range fin-risk:RiskMeasurement.
