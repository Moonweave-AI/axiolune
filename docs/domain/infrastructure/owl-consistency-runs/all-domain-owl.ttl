    rdfs:range xsd:string.
fin-strategy:calculationParameterSnapshotLocator a owl:ObjectProperty;
    rdfs:comment "Calculation Parameter Snapshot Locator, is a structured SourceLocator whose digest-locked extractor profile and selection digest authenticate the exact bytes used as the CalculationContext parameter snapshot, used for confirming the byte source of the calculation-context parameter snapshot.";
    rdfs:label "calculation parameter snapshot locator";
    rdfs:range <https://axiolune.ai/ontology/meta/data-binding/structures/SourceLocator>.
fin-strategy:calculationParameterSnapshotRef a owl:ObjectProperty;
