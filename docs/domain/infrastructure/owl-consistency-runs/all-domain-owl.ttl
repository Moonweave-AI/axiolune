    rdfs:label "calculation parameter snapshot reference";
    rdfs:range <https://axiolune.ai/ontology/meta/data-binding/structures/ArtifactRef>.
fin-strategy:calculationWindow a owl:ObjectProperty;
    rdfs:comment "Calculation Window, is a positive Quantity duration or count that defines the metric calculation window, used for bounding the historical sample range on which a metric is based.";
    rdfs:label "calculation window";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-strategy:calendarSnapshotDigest a owl:DatatypeProperty;
