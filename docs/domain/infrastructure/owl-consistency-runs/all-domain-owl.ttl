    rdfs:label "p-value";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-strategy:parameterSnapshotDigest a owl:DatatypeProperty;
    rdfs:comment "Parameter Snapshot Digest, is the SHA-256 digest of the immutable canonical parameter snapshot, used for byte-level verification of the parameter-snapshot content.";
    rdfs:label "parameter snapshot digest";
    rdfs:range xsd:string.
fin-strategy:parameterSnapshotRef a owl:DatatypeProperty;
