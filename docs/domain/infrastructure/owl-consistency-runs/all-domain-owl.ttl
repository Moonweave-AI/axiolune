    rdfs:label "attribution aggregation scope";
    rdfs:range fin-strategy:AttributionAggregationScope.
fin-strategy:attributionComponentType a owl:ObjectProperty;
    rdfs:comment "Attribution Component Type, is an optional reviewed member recording the component type of an attribution method, used for classifying attribution components.";
    rdfs:label "attribution component type";
    rdfs:range fin-strategy:AttributionComponentType.
fin-strategy:attributionMethodId a owl:DatatypeProperty;
    rdfs:comment "Attribution Method Identifier, is an authority-scoped stable identifier of an AttributionMethod logical identity, used for uniquely referring to an attribution method within a single authority scope.";
    rdfs:label "attribution method identifier";
    rdfs:range xsd:string.
fin-strategy:attributionMoneyValue a owl:ObjectProperty;
    rdfs:comment "Attribution Money Value, is an optional Money contribution selected exclusively for a monetary attribution metric, used for carrying the attribution contribution measured in monetary terms.";
    rdfs:label "attribution money value";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/MonetaryAmount>.
fin-strategy:attributionQuantityValue a owl:ObjectProperty;
    rdfs:comment "Attribution Quantity Value, is an optional Quantity contribution selected exclusively for a non-monetary attribution metric, used for carrying the attribution contribution measured in quantity terms.";
    rdfs:label "attribution quantity value";
    rdfs:range <https://axiolune.ai/ontology/meta/core/values/QuantityValue>.
fin-strategy:attributionReconciliationRule a owl:DatatypeProperty;
    rdfs:comment "Attribution Reconciliation Rule, is an optional human-readable statement of the reconciliation rule of an attribution method, used for expressing how attribution contributions reconcile against the explained result.";
    rdfs:label "attribution reconciliation rule";
    rdfs:range xsd:string.
fin-strategy:attributionReconciliationStatus a owl:ObjectProperty;
    rdfs:comment "Attribution Reconciliation Status, is a reviewed member recording whether the attribution contributions reconcile against the explained performance result, used for making the reconciliation outcome explicit.";
