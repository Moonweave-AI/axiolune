fin-strategy:conclusionType a owl:ObjectProperty;
    rdfs:comment "Conclusion Type, is an optional reviewed member recording the type of a research conclusion, used for classifying research conclusions.";
    rdfs:label "conclusion type";
    rdfs:range fin-strategy:ConclusionType.
fin-strategy:confidenceLevel a owl:ObjectProperty;
    rdfs:comment "Confidence Level, is a dimensionless Quantity in the closed interval from zero to one used by a statistical metric, used for setting the confidence level of statistical inference.";
