fin-orders:Fee a owl:Class;
    rdfs:comment "A Fee is an immutable charge or rebate fact recorded for one exact Execution version, used for expressing the economic or regulatory cost of a trade through a strictly positive amount together with a fee-effect direction, whose direction is never carried by a signed amount.";
    rdfs:label "Execution Fee";
