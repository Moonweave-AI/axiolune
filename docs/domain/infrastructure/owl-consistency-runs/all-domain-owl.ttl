    rdfs:label "metric definition identifier";
    rdfs:range xsd:string.
fin-strategy:metricDirectionality a owl:ObjectProperty;
    rdfs:comment "Metric Directionality, is an optional reviewed member recording whether a higher metric value is better, worse, or neutral, used for interpreting metric results consistently.";
    rdfs:label "metric directionality";
    rdfs:range fin-strategy:MetricDirectionality.
fin-strategy:metricKind a owl:ObjectProperty;
    rdfs:comment "Metric Kind, is an optional reviewed member recording the kind of a metric, used for classifying metrics such as return, risk-adjusted return, drawdown, volatility, or ratio.";
    rdfs:label "metric kind";
    rdfs:range fin-strategy:MetricKind.
fin-strategy:metricName a owl:DatatypeProperty;
