    rdfs:range xsd:string.
fin-strategy:runAttemptStatus a owl:ObjectProperty;
    rdfs:comment "Run Attempt Status, is a reviewed member recording the attempt status of a run, used for distinguishing preliminary, incomplete, revised, failed, estimated, streaming, and validated runs so the strict completed-and-PIT-passed requirement can be profile-scoped.";
