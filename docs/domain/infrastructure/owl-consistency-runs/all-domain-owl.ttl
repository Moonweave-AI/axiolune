    rdfs:label "transmitting firm";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party>.
fin-orders:ExecutionAllocation a owl:Class;
    rdfs:comment "An Execution Allocation is an immutable allocation fact that distributes one source Execution across one or more AllocationLine target accounts, used to express post-execution allocation, average-price allocation, and bunched-order back-allocation with quantity conservation, while detailed allocation and clearing semantics remain in post-trade-operations with a stable cross-module reference to the source Execution.";
    rdfs:label "Execution Allocation";
    rdfs:subClassOf _:r_4101e935d74344a52ab8e817, _:r_79a21d26f670595ef5453d7a, _:r_7d8eb441952de41849ebfbea, _:r_8dea489cd1f3a7c202dc35dc, _:r_a72e51e58b84128a9570a933, _:r_badf998df19a1557ad32cb9c, _:r_c0a485b863e44440587671e4, _:r_f0fc2ae9b5778573c22feac0, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/orders-execution/ExecutionAllocation/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Execution Allocation versions.";
    rdfs:label "Execution Allocation logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/orders-execution/ExecutionAllocation/role/allocationLine> a owl:ObjectProperty;
    rdfs:comment "one or more exact AllocationLine versions that partition the source execution quantity";
    rdfs:domain fin-orders:ExecutionAllocation;
    rdfs:label "allocation line";
    rdfs:range fin-orders:AllocationLine.
<https://axiolune.ai/ontology/finance/orders-execution/ExecutionAllocation/role/allocationSourceExecution> a owl:ObjectProperty;
    rdfs:comment "exact source Execution version being allocated";
    rdfs:domain fin-orders:ExecutionAllocation;
    rdfs:label "allocation source execution";
    rdfs:range fin-orders:Execution.
fin-orders:ExecutionLeg a owl:Class;
    rdfs:comment "An Execution Leg is an optional single-leg execution component corresponding to an OrderLeg, used as an extension point for multi-leg executions whose full semantics are completed via a cross-module follow-up gated on the instruments QuotationConvention (ADR-021). In v1.1.0 a single-instrument execution carries no ExecutionLeg and remains described directly on the Execution.";
    rdfs:label "Execution Leg";
    rdfs:subClassOf _:r_062cfd492c72f90c4b726d39, _:r_0973093fc813038cfbb9134b, _:r_38eb0790d9a6e2806016130f, _:r_91e833b068795f444177e19e, _:r_93ebbb64c142359208807b4f, _:r_95067b5784ea95bb9380bd02, _:r_98efbbd50015cf8f81530db4, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/orders-execution/ExecutionLeg/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Execution Leg versions.";
    rdfs:label "Execution Leg logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
fin-orders:ExternalOrder a owl:Class;
    rdfs:comment "An External Order is a provider-scoped order that has been accepted or submitted by a provider, used for binding one exact OrderIntent version to a specific provider interface and external order identifier as the order fact anchor of an external system.";
    rdfs:label "External Order";
    rdfs:subClassOf _:r_0db6f6bed7e1d76524581166, _:r_38a1a1a4c1b660813669934d, _:r_63e84f045ad8ce1e8c4468f4, _:r_6c4f22d703516d3dfb67f5f9, _:r_8e13b05338ea7be9fec003f4, _:r_9f77107bf93b0025d7f7b1ac, _:r_ad1bfa096ee4d827812fc3c2, _:r_bd20a1d98a8485620a091c79, _:r_e5e1c83514f70aca422c6c14, _:r_ef4de14bb134ab96d40db7e6, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
