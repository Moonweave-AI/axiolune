fin-post-trade:TradeSettlementAllocation a owl:Class;
    rdfs:comment "The trade settlement allocation is an exact allocation that allocates the execution quantity to the security leg, names both economic accounts, and independently selects direct equality or one PIT-eligible custody/omnibus bridge for each endpoint, used for placing an execution onto specific economic accounts.";
    rdfs:label "Trade Settlement Allocation";
    rdfs:subClassOf _:r_553b6609a6971a9f7faded50, _:r_5f1b4dbd6e8571a2301bd6b7, _:r_6cbbea01ef972b1c5c68968c, _:r_70e3310c89c418e00359093c, _:r_77ee9bc0716d33aa64b53911, _:r_8baec26069b3589f0d2a10e6, _:r_9364a16ece58dda81cc017d1, _:r_9e82125f893c98c11480570c, _:r_ba68373ff1589c0042e51d23, _:r_c22430c5048b792ec5cf4f70, _:r_c76dd346b5ea75fe5605c2ba, _:r_cc86931eb188cdb4191a8fa2, _:r_cf4016c2d77b43bcfb3b3ff9, _:r_e0868515e1a8245b55877c46, _:r_e900c4d2ed64557620da2374, _:r_ed696d21a92e8c7f79e9bfa4, _:r_eee7fdec1cbcb2a7461ba6f7, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
