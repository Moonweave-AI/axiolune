    rdfs:label "execution stream";
    rdfs:range fin-orders:OrderEventStream.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionVenue> a owl:ObjectProperty;
    rdfs:comment "optional logical TradingFacility where the execution occurred, distinct from the execution listing";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution venue";
    rdfs:range <https://axiolune.ai/ontology/finance/market-structure/TradingFacility>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/investmentDecisionMaker> a owl:ObjectProperty;
    rdfs:comment "optional logical party responsible for the investment decision";
