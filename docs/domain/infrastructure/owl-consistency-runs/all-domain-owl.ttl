<https://axiolune.ai/ontology/finance/strategy-research> a owl:Ontology;
    rdfs:comment "Strategy and Research, is a finance ontology module that defines versioned specifications for research questions, hypotheses, protocols, factors, signals, strategies, backtests, simulated trading, performance measurement, attribution, and live deployment governance, used for providing typed business semantics for quantitative research, strategy definition, simulation, and deployment together with an optional reproducibility-evidence profile that locks executable implementation, input and output contracts, runtime, tool lock, and source artifact evidence under a single authority.";
    rdfs:label "Strategy and Research";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/instruments>, <https://axiolune.ai/ontology/finance/market-data>, <https://axiolune.ai/ontology/finance/market-structure>, <https://axiolune.ai/ontology/finance/orders-execution>, <https://axiolune.ai/ontology/finance/portfolio-positions>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/strategy-research/1.1.0>.
fin-strategy:AnnualizationConvention a owl:Class;
    rdfs:comment "Annualization Convention, is a closed classification of the annualization convention of a Metric, used for interpreting annualized metrics consistently.";
    rdfs:label "Annualization Convention";
    owl:oneOf _:l_20c72dfa788bf363ab0f3003_0.
<https://axiolune.ai/ontology/finance/strategy-research/AnnualizationConvention/scheme> a skos:ConceptScheme;
    skos:prefLabel "Annualization Convention";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/strategy-research/AnnualizationConvention/value/compound> a owl:NamedIndividual, skos:Concept, fin-strategy:AnnualizationConvention;
    rdfs:comment "Annualization compounds returns over the period.";
    skos:inScheme <https://axiolune.ai/ontology/finance/strategy-research/AnnualizationConvention/scheme>;
    skos:notation "compound";
    skos:prefLabel "compound";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/strategy-research/AnnualizationConvention/value/simple> a owl:NamedIndividual, skos:Concept, fin-strategy:AnnualizationConvention;
    rdfs:comment "Annualization is a simple scaling by the annualization factor.";
    skos:inScheme <https://axiolune.ai/ontology/finance/strategy-research/AnnualizationConvention/scheme>;
    skos:notation "simple";
    skos:prefLabel "simple";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
fin-strategy:AttributionAggregationScope a owl:Class;
    rdfs:comment "Attribution Aggregation Scope, is a closed classification of the aggregation scope of an attribution method, used for expressing how attribution contributions are aggregated.";
    rdfs:label "Attribution Aggregation Scope";
    owl:oneOf _:l_90500f0d5bb01ba89c340632_0.
<https://axiolune.ai/ontology/finance/strategy-research/AttributionAggregationScope/scheme> a skos:ConceptScheme;
