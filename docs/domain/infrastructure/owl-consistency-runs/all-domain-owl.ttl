fin-strategy:RunContext a owl:Class;
    rdfs:comment "Run Context, is a versioned execution context that fixes the identity of one research, backtest, or live run together with its input snapshots, used for locking parameters, ontology, mappings, calendar, compiler, and PIT validation requests to ensure reproducibility. The strict prior-completed input context and passed PIT request are profile-scoped under ValidatedReproducibleRun; run timing is split into planned, started, scheduled, and completed instants so a planned run need not assert an actual start.";
    rdfs:label "Run Context";
    rdfs:subClassOf _:r_00e0b194d1690558d0845da7, _:r_120291d9c4e6f34d82a32fa3, _:r_1df4b975ca0a5455d6924016, _:r_31571a5cf4d4c1bee54b2f79, _:r_36550883d69edd2e2c96ac2e, _:r_3679efd3613fe3fb395fa8d9, _:r_3999835932d3ed9c16fe1796, _:r_48cb012f64f829af01798b6c, _:r_54e86c8d1ee482fcf3c6e029, _:r_55cc088d045e192dec49140c, _:r_637e811271ea504a3930728f, _:r_6de49b6259f2befb313cc2f1, _:r_6eeef9c3f424ebb2b6509247, _:r_7118c1fbdc29b10c4450e1d3, _:r_718a3a22822bab620ce0183d, _:r_726b9b70d8d378db97b289ae, _:r_7309d55af69d7ae191154650, _:r_7a003fe49520644b4a71bae2, _:r_7c207516f7d677d3c3e732b9, _:r_810240ad757d6f5c760ba212, _:r_97068b500e36c9ce840e041a, _:r_99493533fdf3dc370de0f390, _:r_9a1ffb1c0d5e01ffd6356d96, _:r_a09827ee94f0671283f5a31e, _:r_a384b50dc96a5e7fca981e05, _:r_a3a82c59742ff86366070e6a, _:r_ab424a2a05e870773d7d1912, _:r_ad8e468a43a74e05bbf1a443, _:r_b232eb3c76d553d36d5a9cce, _:r_b33d5971720bba819d0f454c, _:r_ba66964ed0a7f657d606cd24, _:r_c1a92050a903b9d12afa54c6, _:r_c318ab8ba6a68cdfaabb9af5, _:r_c46ceebf0d17da07afb3bc8b, _:r_d098c0de4cb1659136d71975, _:r_d8fcac48bf3492875217ef65, _:r_da654df0838953273077da14, _:r_e02c4fa30690636cb8980a93, _:r_eccfe27a7ee2baa386507069, _:r_ee59cb4d35309f824642f030, _:r_f4741451be60cdd2ec9da7c7, _:r_f47bcbaeea97d7aaf630007a, _:r_f7452935a1e60fad7a560a90, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
