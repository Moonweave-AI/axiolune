fin-strategy:PerformanceObservation a owl:Class;
    rdfs:comment "Performance Observation, is a temporal and provenanced observation that binds one MetricDefinition, RunContext, and CalculationContext and carries a single Money or Quantity value, used for preserving the logical identity through knowledge-time corrections and closing prior availability through separate immutable closure evidence. The observation optionally references a PerformanceMeasurementPeriod, ReturnSeriesSnapshot, ValuationConvention, PerformanceSubject, and BenchmarkSpecification so that the measurement period, subject, return series, valuation convention, and benchmark are explicit and queryable.";
    rdfs:label "Performance Observation";
    rdfs:subClassOf _:r_09470baf23883266366fa516, _:r_0c743dea38a212e1a293dd38, _:r_210e5ebcf1b8160ab17a2d41, _:r_2394dde5636cd9a65a4f4ce2, _:r_2fc2e77ff92a73d10eb5d755, _:r_3ad62d4520db600f80db9321, _:r_438e61f69b0fce25c64c7045, _:r_619a96904dc5c10c04a2b0d7, _:r_67e2e13bd2d21f27a4fa641e, _:r_7460102534b3d39977d672e6, _:r_77713b05f2cda84ac8ec144a, _:r_93949c74a8b201c08374280c, _:r_9d3127ec22293c5ee96fadf7, _:r_9e770fa9cda4c1ecc2512252, _:r_ab99bc7932d4a4d544e23c4e, _:r_b02474a344307a3d7e45d3db, _:r_bb365683dc376106b4cd17c2, _:r_c70069bdc588adb8abf6ed6c, _:r_cba093d29a9c929e15def8b9, _:r_dc4b2e2792b88cb75098955f, _:r_f30b055e3539576cb1c131b6, _:r_fa56d589d810cf7245fb23ca, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
