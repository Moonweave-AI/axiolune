    rdfs:domain fin-orders:Execution;
    rdfs:label "execution party";
    rdfs:range <https://axiolune.ai/ontology/finance/foundation/Party/LogicalIdentity>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionQuotationContract> a owl:ObjectProperty;
    rdfs:comment "exact direct-unit quotation contract matching context, instrument, currency, and quantity unit; v1.1.0 covers single-instrument direct-unit quotation only";
    rdfs:domain fin-orders:Execution;
    rdfs:label "execution quotation contract";
    rdfs:range <https://axiolune.ai/ontology/finance/instruments/DirectUnitPriceQuotationContract>.
<https://axiolune.ai/ontology/finance/orders-execution/Execution/role/executionStream> a owl:ObjectProperty;
    rdfs:comment "exact source-locked event stream version reporting the execution";
