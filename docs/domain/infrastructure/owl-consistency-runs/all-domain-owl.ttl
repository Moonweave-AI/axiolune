<https://axiolune.ai/ontology/finance/market-data> a owl:Ontology;
    rdfs:comment "Source-contract-bound price, quote, trade, bar, quality, and FX-rate facts with immutable version identity, exact observation context, and fail-closed valid, knowledge, and availability time semantics.";
    rdfs:label "Market Data";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/instruments>, <https://axiolune.ai/ontology/finance/market-rules>, <https://axiolune.ai/ontology/finance/market-structure>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/market-data/1.0.0>.
fin-market-data:BarAggregation a owl:Class;
    rdfs:comment "closed aggregation branch selected by a BarSpecification";
    rdfs:label "Bar Aggregation";
    owl:oneOf _:l_88e48f0371f216c3b0566fc1_0.
<https://axiolune.ai/ontology/finance/market-data/BarAggregation/scheme> a skos:ConceptScheme;
    skos:prefLabel "Bar Aggregation";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-data/BarAggregation/value/notional> a owl:NamedIndividual, skos:Concept, fin-market-data:BarAggregation;
    rdfs:comment "fixed positive quote-currency notional threshold aggregation";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-data/BarAggregation/scheme>;
    skos:notation "notional";
    skos:prefLabel "Notional";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-data/BarAggregation/value/range> a owl:NamedIndividual, skos:Concept, fin-market-data:BarAggregation;
    rdfs:comment "fixed positive price-range threshold aggregation";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-data/BarAggregation/scheme>;
    skos:notation "range";
    skos:prefLabel "Range";
    <https://axiolune.ai/ontology/meta/core/annotations/sourceEvidenceRef> <https://axiolune.ai/references/axiolune-m2-controlled-vocabularies>.
<https://axiolune.ai/ontology/finance/market-data/BarAggregation/value/renko> a owl:NamedIndividual, skos:Concept, fin-market-data:BarAggregation;
    rdfs:comment "fixed positive brick threshold aggregation";
    skos:inScheme <https://axiolune.ai/ontology/finance/market-data/BarAggregation/scheme>;
