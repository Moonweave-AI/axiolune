fin-orders:ExternalOrderStatusVocabulary a owl:Class;
    rdfs:comment "An External Order Status Vocabulary is a raw status-code vocabulary scoped by provider, API, and schema version, used for collecting each provider's raw status-code values before they are reviewed and mapped to the canonical lifecycle state vocabulary.";
    rdfs:label "External Order Status Vocabulary";
