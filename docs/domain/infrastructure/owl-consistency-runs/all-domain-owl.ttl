    rdfs:domain fin-risk:RiskInputSet;
    rdfs:label "input set market data stream";
    rdfs:range <https://axiolune.ai/ontology/finance/market-data/MarketDataStream>.
<https://axiolune.ai/ontology/finance/risk/RiskInputSet/role/inputSetPosition> a owl:ObjectProperty;
