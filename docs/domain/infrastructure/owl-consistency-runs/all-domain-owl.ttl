<https://axiolune.ai/ontology/finance/post-trade-operations> a owl:Ontology;
    rdfs:comment "RFC-001 v0.3 post-trade ontology covering corporate-action schedule and entitlement closure, due-bill/election/subscription processing, DVP/FOP settlement allocation, and deterministic reconciliation.";
    rdfs:label "Post-Trade Operations";
    owl:imports <https://axiolune.ai/ontology/finance/foundation>, <https://axiolune.ai/ontology/finance/instruments>, <https://axiolune.ai/ontology/finance/market-data>, <https://axiolune.ai/ontology/finance/market-rules>, <https://axiolune.ai/ontology/finance/market-structure>, <https://axiolune.ai/ontology/finance/orders-execution>, <https://axiolune.ai/ontology/finance/portfolio-positions>, <https://axiolune.ai/ontology/meta>;
    owl:versionIRI <https://axiolune.ai/ontology/finance/post-trade-operations/1.0.0>.
fin-post-trade:CorporateActionAdjustment a owl:Class;
    rdfs:comment "Normalized post-evidence cash and/or security adjustment summary for one Event and Entitlement; it cites completed movement closure but is never itself proof that assets moved.";
    rdfs:label "Corporate Action Adjustment";
    rdfs:subClassOf _:r_08aebd5b09c9702657cc85c4, _:r_09b26cc0ea702d00e8b2c529, _:r_12bddf21baa0334ee10c6420, _:r_13922354701862b13afe00bd, _:r_1963bc2a3478fc6286ddc087, _:r_312356516725e1ebb20fdadb, _:r_3270b771c341e553f9bcc3ad, _:r_381f58cbfda9728c7dd540f7, _:r_40c6bb504cc56cb8596e47c3, _:r_4908af5f79717887d03df78a, _:r_66b461077e367508ba0f303d, _:r_66b593255115f000591e4a38, _:r_6b9168b32c2a39c38e4750bb, _:r_6f26522f8caf3e0a8f4cf66a, _:r_75c73a0e735bfab1981b4eab, _:r_87b5329a243adf19564437fd, _:r_880978fc9416783cb8789a41, _:r_945ef172f01c6a738effaf49, _:r_9509def633313ee33153e992, _:r_9a722c8bd61c3bab060c5161, _:r_a8a1e24f571401ffe7f9572f, _:r_c1e764e6cdb75a2f0a0885f4, _:r_c96064e52337f74559fa0956, _:r_cc87f0f5d5d89bacb0819efc, _:r_dcb7ab9d750912970d871714, _:r_e03ccae8ad4e697082176a84, _:r_e1519a8eccd817901f16e379, _:r_e23fc2e8b28be6b7386187d5, _:r_f2cc39b16743dd1fa73b67fb, _:r_f74c788d7abe68bbcc8fcfe3, <https://axiolune.ai/ontology/meta/data-binding/FactVersion>, <https://axiolune.ai/ontology/meta/patterns/ProvenancedFact>, <https://axiolune.ai/ontology/meta/patterns/TemporalFact>.
<https://axiolune.ai/ontology/finance/post-trade-operations/CorporateActionAdjustment/LogicalIdentity> a owl:Class;
    rdfs:comment "Stable FactIdentity companion for immutable Corporate Action Adjustment versions.";
    rdfs:label "Corporate Action Adjustment logical identity";
    rdfs:subClassOf <https://axiolune.ai/ontology/meta/data-binding/FactIdentity>;
    owl:disjointWith <https://axiolune.ai/ontology/meta/data-binding/FactVersion>.
<https://axiolune.ai/ontology/finance/post-trade-operations/CorporateActionAdjustment/role/adjustmentElectionResolution> a owl:ObjectProperty;
    rdfs:comment "optional exact selected-exercise resolution required only by rights";
    rdfs:domain fin-post-trade:CorporateActionAdjustment;
    rdfs:label "adjustment election resolution";
    rdfs:range fin-post-trade:CorporateActionElectionResolution.
<https://axiolune.ai/ontology/finance/post-trade-operations/CorporateActionAdjustment/role/adjustmentEntitlement> a owl:ObjectProperty;
    rdfs:comment "exact entitlement version whose benefit is summarized";
    rdfs:domain fin-post-trade:CorporateActionAdjustment;
    rdfs:label "adjustment entitlement";
    rdfs:range fin-post-trade:CorporateActionEntitlement.
<https://axiolune.ai/ontology/finance/post-trade-operations/CorporateActionAdjustment/role/adjustmentEvent> a owl:ObjectProperty;
    rdfs:comment "exact corporate-action Event version";
    rdfs:domain fin-post-trade:CorporateActionAdjustment;
    rdfs:label "adjustment event";
    rdfs:range fin-post-trade:CorporateActionEvent.
<https://axiolune.ai/ontology/finance/post-trade-operations/CorporateActionAdjustment/role/adjustmentScheduleResolution> a owl:ObjectProperty;
    rdfs:comment "exact schedule resolution version";
    rdfs:domain fin-post-trade:CorporateActionAdjustment;
    rdfs:label "adjustment schedule resolution";
    rdfs:range fin-post-trade:CorporateActionScheduleResolution.
<https://axiolune.ai/ontology/finance/post-trade-operations/CorporateActionAdjustment/role/adjustmentSelectedElection> a owl:ObjectProperty;
